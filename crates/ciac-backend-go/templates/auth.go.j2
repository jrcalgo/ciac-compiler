// Package auth verifies bearer JWTs and enforces scopes. Generated by
// CIaC.
//
// `VerifyToken`/`RequireScope` are called inline at the top of each
// generated route handler (mirroring every other target's own inline-
// in-route-body placement, not a middleware chain) -- `AuthError`s
// (`httpx.Unauthorized`/`httpx.Forbidden`) flow through the same
// `httpx.WriteError` every other error already does, so no separate
// error-mapping layer is needed just for auth.
package auth

import (
{%- if c.auth_scheme == "oauth2" %}
	"context"
{%- endif %}
	"net/http"
	"strings"
{%- if c.auth_scheme == "oauth2" %}
	"sync"
{%- endif %}

{%- if c.auth_scheme == "oauth2" %}
	"github.com/MicahParks/keyfunc/v3"
{%- endif %}
	"github.com/golang-jwt/jwt/v5"

{%- if c.auth_scheme == "oauth2" %}
	"{{ c.package }}/internal/config"
{%- endif %}
	"{{ c.package }}/internal/httpx"
	"{{ c.package }}/internal/state"
)

// Claims is the verified token's own claim set -- an open bag of
// whatever it carries, matching every other target's own untyped
// claims dict/`serde_json::Value`/`Record<string, unknown>`.
type Claims = jwt.MapClaims

{%- if c.auth_scheme == "oauth2" %}

// Fetched lazily on first use and cached (with background refresh) by
// keyfunc itself -- mirroring every other lazy provider client (db
// pools, redis, the broker client): constructing AppState never makes
// a network call, so a route that never checks a token never needs
// the issuer reachable.
var (
	jwksOnce sync.Once
	jwksVal  keyfunc.Keyfunc
	jwksErr  error
)

func getJWKS(cfg config.Config) (keyfunc.Keyfunc, error) {
	jwksOnce.Do(func() {
		url := strings.TrimRight(cfg.OAuthIssuer, "/") + "/.well-known/jwks.json"
		jwksVal, jwksErr = keyfunc.NewDefaultCtx(context.Background(), []string{url})
	})
	return jwksVal, jwksErr
}
{%- endif %}

// VerifyToken checks the request's `Authorization: Bearer <token>`
// header and returns its verified claims.
//
// 27UpdatePlan.md M7: under simulation (`st.World` set), verification
// is a claims-lookup against `World.AuthVerify` -- not real JWT/JWKS
// crypto, matching Python's own `FakeAuth` -- checked first, falling
// through to the real JWT verification below when unset. Mirrors
// Rust's/TypeScript's own auth seam exactly.
func VerifyToken(r *http.Request, st *state.AppState) (Claims, error) {
	header := r.Header.Get("Authorization")
	if !strings.HasPrefix(header, "Bearer ") {
		return nil, httpx.Unauthorized()
	}
	tokenStr := strings.TrimPrefix(header, "Bearer ")
	if st.World != nil {
		var claims Claims
		if err := st.World.AuthVerify(tokenStr, &claims); err != nil {
			return nil, httpx.Unauthorized()
		}
		return claims, nil
	}
	cfg := st.Config
	var claims Claims
{%- if c.auth_scheme == "oauth2" %}
	kf, err := getJWKS(cfg)
	if err != nil {
		return nil, httpx.Unauthorized()
	}
	opts := []jwt.ParserOption{jwt.WithValidMethods([]string{"RS256"}), jwt.WithIssuer(cfg.OAuthIssuer)}
	if cfg.OAuthAudience != "" {
		opts = append(opts, jwt.WithAudience(cfg.OAuthAudience))
	}
	if _, err := jwt.ParseWithClaims(tokenStr, &claims, kf.Keyfunc, opts...); err != nil {
		return nil, httpx.Unauthorized()
	}
{%- else %}
	keyFunc := func(*jwt.Token) (any, error) { return []byte(cfg.JWTSecret), nil }
	if _, err := jwt.ParseWithClaims(tokenStr, &claims, keyFunc, jwt.WithValidMethods([]string{"HS256"})); err != nil {
		return nil, httpx.Unauthorized()
	}
{%- endif %}
	return claims, nil
}

// RequireScope checks the `scope` (space-joined string) or `scp`
// (array) claim -- mirroring every other target's own two-shape
// check, since both conventions appear across real issuers.
func RequireScope(claims Claims, scope string) error {
	if s, ok := claims["scope"].(string); ok {
		for _, sc := range strings.Fields(s) {
			if sc == scope {
				return nil
			}
		}
	}
	if arr, ok := claims["scp"].([]any); ok {
		for _, sc := range arr {
			if s, ok := sc.(string); ok && s == scope {
				return nil
			}
		}
	}
	return httpx.Forbidden()
}
