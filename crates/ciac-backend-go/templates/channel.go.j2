// stream{{ channel.snake | go_pascal }} delivers every message on the subject
// to send, until send returns false or ctx ends. Every connection
// gets its own consumer group (a fresh UUID) so it sees every
// message -- Kafka's own group semantics would otherwise load-balance
// connections like a worker.
func stream{{ channel.snake | go_pascal }}(ctx context.Context, st *state.AppState, send func([]byte) bool) {
	cl, err := st.Queue.Consumer({{ channel.snake | go_pascal }}Subject, "channel-{{ channel.snake }}-"+uuid.NewString())
	if err != nil {
		return
	}
	defer cl.Close()
	for {
		fetches := cl.PollFetches(ctx)
		if ctx.Err() != nil {
			return
		}
		stop := false
		fetches.EachRecord(func(record *kgo.Record) {
			if stop {
				return
			}
			data, ok := payloadText{{ channel.snake | go_pascal }}(record.Value)
			if !ok {
				return
			}
			if !send(data) {
				stop = true
			}
		})
		if stop {
			return
		}
	}
}
{%- else %}

// stream{{ channel.snake | go_pascal }} delivers every message on the subject
// to send, until send returns false or the subscription closes. NATS
// delivers a copy of every message to every plain subscriber -- that
// alone is the whole fan-out mechanism, no app-level broadcast
// bookkeeping needed.
func stream{{ channel.snake | go_pascal }}(_ context.Context, st *state.AppState, send func([]byte) bool) {
	ch, err := st.Queue.Subscribe({{ channel.snake | go_pascal }}Subject)
	if err != nil {
		return
	}
	for msg := range ch {
		data, ok := payloadText{{ channel.snake | go_pascal }}(msg.Data)
		if !ok {
			continue
		}
		if !send(data) {
			return
		}
	}
}
