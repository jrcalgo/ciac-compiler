// Package config holds runtime configuration for {{ c.service_name }}.
// Generated by CIaC.
//
// Every value can be overridden through the environment, e.g.
// DATABASE_URL; defaults target local development.
package config

import "os"

type Config struct {
{%- for inst in c.db_instances %}
	{{ inst.url_field | go_pascal }} string
{%- endfor %}
{%- for inst in c.cache_instances %}
	{{ inst.url_field | go_pascal }} string
{%- endfor %}
{%- for inst in c.object_store_instances %}
{%- for f in inst.cfg %}
	{{ f.field | go_pascal }} string
{%- endfor %}
{%- endfor %}
{%- for inst in c.email_instances %}
{%- for f in inst.cfg %}
	{{ f.field | go_pascal }} string
{%- endfor %}
{%- endfor %}
{%- for inst in c.search_instances %}
{%- for f in inst.cfg %}
	{{ f.field | go_pascal }} string
{%- endfor %}
{%- endfor %}
{%- for inst in c.external_http_instances %}
{%- for f in inst.cfg %}
	{{ f.field | go_pascal }} string
{%- endfor %}
{%- endfor %}
{%- for t in c.call_targets %}
	{{ t.url_field | go_pascal }} string
{%- endfor %}
{%- if c.has_queue %}
{%- if c.queue_engine == "kafka" %}
	KafkaURL string
{%- else %}
	NatsURL string
{%- endif %}
{%- endif %}
{%- if c.has_auth %}
{%- if c.auth_scheme == "oauth2" %}
	OAuthIssuer  string
	OAuthAudience string
{%- else %}
	JWTSecret string
{%- endif %}
{%- endif %}
{%- if c.has_tracing %}
	OTELExporterOTLPEndpoint string
{%- endif %}
}

func FromEnv() Config {
	return Config{
{%- for inst in c.db_instances %}
{%- if inst.db_engine == "mysql" %}
		{{ inst.url_field | go_pascal }}: envOr("{{ inst.env_var }}", "root:root@tcp(localhost:3306)/{{ inst.db_name }}"),
{%- elif inst.db_engine == "sqlite" %}
		{{ inst.url_field | go_pascal }}: envOr("{{ inst.env_var }}", "file:data/{{ inst.db_name }}.db"),
{%- else %}
		{{ inst.url_field | go_pascal }}: envOr("{{ inst.env_var }}", "postgres://postgres:postgres@localhost:5432/{{ inst.db_name }}"),
{%- endif %}
{%- endfor %}
{%- for inst in c.cache_instances %}
		{{ inst.url_field | go_pascal }}: envOr("{{ inst.env_var }}", "redis://localhost:6379/{{ inst.redis_db }}"),
{%- endfor %}
{%- for inst in c.object_store_instances %}
{%- for f in inst.cfg %}
		{{ f.field | go_pascal }}: envOr("{{ f.env }}", "{{ f.rust_default }}"),
{%- endfor %}
{%- endfor %}
{%- for inst in c.email_instances %}
{%- for f in inst.cfg %}
		{{ f.field | go_pascal }}: envOr("{{ f.env }}", "{{ f.rust_default }}"),
{%- endfor %}
{%- endfor %}
{%- for inst in c.search_instances %}
{%- for f in inst.cfg %}
		{{ f.field | go_pascal }}: envOr("{{ f.env }}", "{{ f.rust_default }}"),
{%- endfor %}
{%- endfor %}
{%- for inst in c.external_http_instances %}
{%- for f in inst.cfg %}
		{{ f.field | go_pascal }}: envOr("{{ f.env }}", "{{ f.rust_default }}"),
{%- endfor %}
{%- endfor %}
{%- for t in c.call_targets %}
		{{ t.url_field | go_pascal }}: envOr("{{ t.env_var }}", "{{ t.default_url }}"),
{%- endfor %}
{%- if c.has_queue %}
{%- if c.queue_engine == "kafka" %}
		KafkaURL: envOr("KAFKA_URL", "localhost:9092"),
{%- else %}
		NatsURL: envOr("NATS_URL", "nats://localhost:4222"),
{%- endif %}
{%- endif %}
{%- if c.has_auth %}
{%- if c.auth_scheme == "oauth2" %}
		OAuthIssuer:   envOr("OAUTH_ISSUER", "{{ c.auth_issuer }}"),
		OAuthAudience: envOr("OAUTH_AUDIENCE", "{{ c.auth_audience }}"),
{%- else %}
		JWTSecret: envOr("JWT_SECRET", "change-me"),
{%- endif %}
{%- endif %}
{%- if c.has_tracing %}
		OTELExporterOTLPEndpoint: envOr("OTEL_EXPORTER_OTLP_ENDPOINT", "http://localhost:4317"),
{%- endif %}
	}
}

// Go does not error on an unused top-level function (unlike an unused
// import or local variable), so this stays unconditional rather than
// gated behind the same capability check every call site above
// already has -- one fewer condition to keep in sync.
func envOr(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok {
		return v
	}
	return fallback
}
