// Migrate applies every *.sql file under migrations, in filename
// order, one transaction each, recording applied filenames in the
// _ciac_migrations ledger so re-running is a no-op. migrations is
// read from disk at runtime (os.DirFS("migrations"), called from
// cmd/api/main.go) rather than go:embed: the migrations/ directory
// lives at the project root, and go:embed patterns cannot cross a
// ".." to reach it from any nested package -- the same constraint
// cmd/api/main.go's own openapi.json copy works around, but here
// reading from disk (matching Python's own non-compiled-in choice,
// not Rust's compile-time sqlx::migrate!) is the simpler answer, and
// the Dockerfile already copies migrations/ into the runtime image.
func Migrate(db *sql.DB, engine string, migrations fs.FS) error {
	if _, err := db.Exec(`CREATE TABLE IF NOT EXISTS _ciac_migrations (filename VARCHAR(255) PRIMARY KEY)`); err != nil {
		return fmt.Errorf("ensure migrations ledger: %w", err)
	}
	entries, err := fs.ReadDir(migrations, ".")
	if err != nil {
		return fmt.Errorf("read migrations dir: %w", err)
	}
	names := make([]string, 0, len(entries))
	for _, e := range entries {
		if !e.IsDir() && strings.HasSuffix(e.Name(), ".sql") {
			names = append(names, e.Name())
		}
	}
	sort.Strings(names)
	ph := "?"
	if engine == "postgres" {
		ph = "$1"
	}
	for _, name := range names {
		var count int
		if err := db.QueryRow(fmt.Sprintf(`SELECT COUNT(*) FROM _ciac_migrations WHERE filename = %s`, ph), name).Scan(&count); err != nil {
			return fmt.Errorf("check migration %s: %w", name, err)
		}
		if count > 0 {
			continue
		}
		content, err := fs.ReadFile(migrations, name)
		if err != nil {
			return fmt.Errorf("read migration %s: %w", name, err)
		}
		tx, err := db.Begin()
		if err != nil {
			return fmt.Errorf("begin migration %s: %w", name, err)
		}
		if _, err := tx.Exec(string(content)); err != nil {
			_ = tx.Rollback()
			return fmt.Errorf("apply migration %s: %w", name, err)
		}
		if _, err := tx.Exec(fmt.Sprintf(`INSERT INTO _ciac_migrations (filename) VALUES (%s)`, ph), name); err != nil {
			_ = tx.Rollback()
			return fmt.Errorf("record migration %s: %w", name, err)
		}
		if err := tx.Commit(); err != nil {
			return fmt.Errorf("commit migration %s: %w", name, err)
		}
	}
	return nil
}
