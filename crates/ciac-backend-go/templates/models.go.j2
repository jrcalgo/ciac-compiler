// Package models holds persistence row shapes for CRUD resources and
// `table` declarations. Generated by CIaC.
//
// Typed resources (`crud X: Record;`) get real columns from their
// record; untyped ones keep a generic keyed-document model (a
// server-generated id + a JSON payload). `table <Name>: <Record>;`
// declarations get the same column treatment, named after the table
// so a record reused under several table names doesn't collide.
// Enums are stored as their text form and converted at the record
// boundary (see each type's own comment) -- database/sql has no
// FromRow-style mapper, so every store's Scan call lists columns in
// this struct's own declared order (Pillar 4's "explicit Scan column
// order").
//
// Typed `<Name>In` payloads decode through Decode<Name>In, applying
// the same absent/explicit-null/zero-value discipline
// internal/schemas' own decoders use (Pillar 2) -- a bare
// encoding/json.Decode would silently accept a create/update request
// missing a required field, exactly the trap this package exists to
// close for CRUD the same way schemas.go already closes it for
// typed apis.
package models

import (
{%- if needs_json %}
	"encoding/json"
{%- endif %}
{%- if resource_needs_decode %}
	"fmt"
	"io"
{%- endif %}
)
{%- if resource_needs_decode %}

func requireKeys(raw map[string]json.RawMessage, required ...string) error {
	for _, k := range required {
		v, ok := raw[k]
		if !ok {
			return fmt.Errorf("missing required field %q", k)
		}
		if string(v) == "null" {
			return fmt.Errorf("field %q must not be null", k)
		}
	}
	return nil
}
{%- endif %}
{%- for resource in c.resources %}
{%- if resource.record %}
// {{ resource.name }} is the {{ resource.plural }} row shape, in Scan order.
type {{ resource.name }} struct {
	ID string `json:"id"`
{%- for field in resource.record.fields %}
{%- if field.name != "id" %}
	{{ field.name | go_pascal }} {{ field | go_db_type }} `json:"{{ field.name }}"`
{%- endif %}
{%- endfor %}
}

// {{ resource.name }}In is the create/update payload; ID is server-generated.
type {{ resource.name }}In struct {
{%- for field in resource.record.fields %}
{%- if field.name != "id" %}
	{{ field.name | go_pascal }} {{ field | go_type }} `json:"{{ field.name }}"`
{%- endif %}
{%- endfor %}
}

// Decode{{ resource.name }}In decodes and presence-checks a {{ resource.name }}In from r.
func Decode{{ resource.name }}In(r io.Reader) ({{ resource.name }}In, error) {
	body, err := io.ReadAll(r)
	if err != nil {
		return {{ resource.name }}In{}, fmt.Errorf("malformed body: %w", err)
	}
	var raw map[string]json.RawMessage
	if err := json.Unmarshal(body, &raw); err != nil {
		return {{ resource.name }}In{}, fmt.Errorf("malformed body: %w", err)
	}
	if err := requireKeys(raw{% for field in resource.record.fields %}{% if field.name != "id" %}, "{{ field.name }}"{% endif %}{% endfor %}); err != nil {
		return {{ resource.name }}In{}, err
	}
	var out {{ resource.name }}In
	if err := json.Unmarshal(body, &out); err != nil {
		return {{ resource.name }}In{}, fmt.Errorf("malformed body: %w", err)
	}
	return out, nil
}
{%- else %}
// {{ resource.name }} is the generic keyed-document row shape.
type {{ resource.name }} struct {
	ID   string          `json:"id"`
	Data json.RawMessage `json:"data"`
}

// {{ resource.name }}In is the create/update payload.
type {{ resource.name }}In struct {
	Data json.RawMessage `json:"data"`
}
{%- endif %}
{% endfor -%}
{% for table in c.tables %}
// {{ table.class_name }} is the {{ table.snake }} row shape, in Scan order.
type {{ table.class_name }} struct {
{%- for field in table.record.fields %}
	{{ field.name | go_pascal }} {{ field | go_db_type }} `json:"{{ field.name }}"`
{%- endfor %}
{%- if not table.record.has_id %}
	ID string `json:"id"`
{%- endif %}
}
{% endfor %}
