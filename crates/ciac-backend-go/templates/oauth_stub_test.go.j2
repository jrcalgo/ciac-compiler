// internal/routes/oauth_stub_test.go -- Shared no-infra OAuth2 test rig
// helper. Generated by CIaC (`26UpdatePlan.md` M5). Real RS256 signing
// against a real (if tiny) in-process JWKS server, built on
// `github.com/golang-jwt/jwt/v5` -- the same dependency
// `internal/auth`'s own `VerifyToken` already uses to parse and
// verify -- so `oauth_rig_test.go` exercises production code, not a
// parallel implementation. Zero new dependencies: Go's stdlib
// `crypto/rsa` generates the keypair, `net/http/httptest` serves the
// JWKS.
//
// `internal/auth.getJWKS` caches its `keyfunc.Keyfunc` behind a
// package-level `sync.Once` -- correct for production (one issuer per
// process) but meaning only the *first* `OAUTH_ISSUER` this test
// binary ever sees actually takes effect. `TestMain` starts one stub
// for the whole package and sets the env var before any test runs,
// rather than one stub per test (a second stub's issuer would
// silently never be consulted).
package routes

import (
	"crypto/rand"
	"crypto/rsa"
	"encoding/base64"
	"encoding/json"
	"math/big"
	"net/http"
	"net/http/httptest"
	"os"
	"testing"
	"time"

	"github.com/golang-jwt/jwt/v5"

	"{{ c.package }}/internal/config"
)

const oauthTestKID = "test-key-1"

var oauthStubInstance *oauthStub

type oauthStub struct {
	issuer     string
	privateKey *rsa.PrivateKey
	wrongKey   *rsa.PrivateKey
}

func TestMain(m *testing.M) {
	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
	if err != nil {
		panic("generating oauth test key: " + err.Error())
	}
	wrongKey, err := rsa.GenerateKey(rand.Reader, 2048)
	if err != nil {
		panic("generating oauth wrong test key: " + err.Error())
	}
	jwk := map[string]string{
		"kty": "RSA",
		"kid": oauthTestKID,
		"use": "sig",
		"alg": "RS256",
		"n":   base64.RawURLEncoding.EncodeToString(privateKey.PublicKey.N.Bytes()),
		"e":   base64.RawURLEncoding.EncodeToString(big.NewInt(int64(privateKey.PublicKey.E)).Bytes()),
	}
	body, err := json.Marshal(map[string]any{"keys": []any{jwk}})
	if err != nil {
		panic("marshaling oauth test jwks: " + err.Error())
	}
	mux := http.NewServeMux()
	mux.HandleFunc("/.well-known/jwks.json", func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		_, _ = w.Write(body)
	})
	server := httptest.NewServer(mux)
	defer server.Close()

	oauthStubInstance = &oauthStub{issuer: server.URL, privateKey: privateKey, wrongKey: wrongKey}
	os.Setenv("OAUTH_ISSUER", server.URL)

	os.Exit(m.Run())
}

type mintOpts struct {
	scope    string
	key      *rsa.PrivateKey
	kid      string
	issuer   string
	expDelta time.Duration
}

func mint(t *testing.T, cfg config.Config, opts mintOpts) string {
	t.Helper()
	key := opts.key
	if key == nil {
		key = oauthStubInstance.privateKey
	}
	kid := opts.kid
	if kid == "" {
		kid = oauthTestKID
	}
	issuer := opts.issuer
	if issuer == "" {
		issuer = oauthStubInstance.issuer
	}
	expDelta := opts.expDelta
	if expDelta == 0 {
		expDelta = time.Hour
	}
	claims := jwt.MapClaims{
		"sub":   "test",
		"scope": opts.scope,
		"iss":   issuer,
		"exp":   time.Now().Add(expDelta).Unix(),
	}
	if cfg.OAuthAudience != "" {
		claims["aud"] = cfg.OAuthAudience
	}
	token := jwt.NewWithClaims(jwt.SigningMethodRS256, claims)
	token.Header["kid"] = kid
	signed, err := token.SignedString(key)
	if err != nil {
		t.Fatalf("signing test token: %v", err)
	}
	return "Bearer " + signed
}
