// Init installs the process-wide slog default handler{% if c.has_tracing %}, the OTel
// tracer provider{% endif %}{% if c.has_metrics %}, and the default Prometheus collectors{% endif %}. Called once
// from cmd/api/main.go and cmd/workers/main.go before anything else
// runs.
func Init() {
	level := slog.LevelInfo
	if v := os.Getenv("LOG_LEVEL"); v != "" {
		_ = level.UnmarshalText([]byte(v))
	}
{%- if c.has_logging %}
	handler := slog.NewJSONHandler(os.Stdout, &slog.HandlerOptions{Level: level})
{%- else %}
	handler := slog.NewTextHandler(os.Stdout, &slog.HandlerOptions{Level: level})
{%- endif %}
	slog.SetDefault(slog.New(handler))
{%- if c.has_tracing %}
	initTracing()
{%- endif %}
{%- if c.has_metrics %}
	prometheus.MustRegister(collectors.NewGoCollector())
	prometheus.MustRegister(collectors.NewProcessCollector(collectors.ProcessCollectorOpts{}))
{%- endif %}
}
{%- if c.has_tracing %}

// Tracer is the process-wide tracer every generated span-producing
// call site (route handlers via the OTel `net/http` semantics
// implicitly, plus every explicit `traced` call site below) uses.
var Tracer = otel.Tracer("{{ c.service_name }}")

func initTracing() {
	endpoint := os.Getenv("OTEL_EXPORTER_OTLP_ENDPOINT")
	if endpoint == "" {
		endpoint = "http://localhost:4317"
	}
	exporter, err := otlptracegrpc.New(context.Background(),
		otlptracegrpc.WithEndpointURL(endpoint),
	)
	if err != nil {
		slog.Error("building otlp span exporter", "error", err)
		return
	}
	res, err := resource.New(context.Background(),
		resource.WithAttributes(attribute.String("service.name", "{{ c.service_name }}")),
	)
	if err != nil {
		res = resource.Default()
	}
	provider := sdktrace.NewTracerProvider(
		sdktrace.WithBatcher(exporter),
		sdktrace.WithResource(res),
	)
	otel.SetTracerProvider(provider)
	otel.SetTextMapPropagator(propagation.TraceContext{})
}

// Traced wraps fn in a span named name, extracting an inbound W3C
// trace-context carrier first (the broker-hop half of propagation --
// a worker/consumer's own consume loop calls this around each
// message handler; a plain HTTP route gets its span from the
// standard library instrumentation instead, since `net/http` clients/
// servers propagate `traceparent` headers through `propagation.
// TraceContext` alone with no extra wrapper needed there). `carrier`
// is nil-safe: a message published before this service's own
// `tracing OpenTelemetry` landed (or from a non-participating system)
// starts a fresh root span instead of erroring.
func Traced(ctx context.Context, name string, carrier propagation.TextMapCarrier, fn func(context.Context)) {
	if carrier != nil {
		ctx = otel.GetTextMapPropagator().Extract(ctx, carrier)
	}
	ctx, span := Tracer.Start(ctx, name)
	defer span.End()
	fn(ctx)
}

// InjectCarrier returns a fresh W3C trace-context carrier holding the
// current span's `traceparent` -- called from every publish site
// regardless of broker engine, mirroring Rust's `inject_trace_carrier`/
// TS's `queue.ts`'s own `propagation.inject` call.
func InjectCarrier(ctx context.Context) propagation.MapCarrier {
	carrier := propagation.MapCarrier{}
	otel.GetTextMapPropagator().Inject(ctx, carrier)
	return carrier
}
