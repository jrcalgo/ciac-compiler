// 27UpdatePlan.md M7: synthesizes a bearer token from the step's own
// `as` principal exactly like `sim/pyrunner/auto_driver.py`'s
// `_request` (`f"sim:{sub}:{','.join(scopes)}"`, claims `{"sub": sub,
// "scope": " ".join(scopes)}`) -- matching Rust's/TypeScript's own
// `sim_runner`'s identical synthesis.
func doRequest(mux *http.ServeMux, w *world.World, spec requestStep, saved map[string]savedResponse) error {
	if spec.Service != serviceName {
		return fmt.Errorf(
			"sim_runner only drives service %q (single-service only); request named %q",
			serviceName, spec.Service,
		)
	}
	route, ok := apiRoutes[spec.Api]
	if !ok {
		return fmt.Errorf("sim_runner: no api registered named %q", spec.Api)
	}
	req := httptest.NewRequest(route.Method, route.Path, bytes.NewReader(spec.JSON))
	if len(spec.JSON) > 0 {
		req.Header.Set("Content-Type", "application/json")
	}
	if spec.As != nil {
		scopes := spec.As.Scopes
		token := fmt.Sprintf("sim:%s:%s", spec.As.Sub, strings.Join(scopes, ","))
		w.AuthIssue(token, map[string]any{"sub": spec.As.Sub, "scope": strings.Join(scopes, " ")}, nil)
		req.Header.Set("Authorization", "Bearer "+token)
	}
	rec := httptest.NewRecorder()
	mux.ServeHTTP(rec, req)
	var parsed any
	if rec.Body.Len() > 0 {
		if err := json.Unmarshal(rec.Body.Bytes(), &parsed); err != nil {
			return fmt.Errorf("sim_runner: decoding response for api %q: %w", spec.Api, err)
		}
	}
	if spec.SaveAs != "" {
		saved[spec.SaveAs] = savedResponse{Status: rec.Code, JSON: parsed}
	}
	return nil
}
