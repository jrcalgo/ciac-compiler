func consume{{ worker.snake | go_pascal }}(ctx context.Context, st *state.AppState, index int) {
	ch, err := st.Queue.QueueSubscribe({{ worker.snake | go_pascal }}Subject, {{ worker.snake | go_pascal }}QueueGroup)
	if err != nil {
		slog.Error("worker {{ worker.name }}: subscribing", "error", err, "index", index)
		return
	}
	slog.Info("worker {{ worker.name }} consuming", "subject", {{ worker.snake | go_pascal }}Subject, "index", index)
	for msg := range ch {
		var payload any
		if err := json.Unmarshal(msg.Data, &payload); err != nil {
			slog.Warn("discarding malformed message", "error", err)
			continue
		}
		if err := handleMessage{{ worker.snake | go_pascal }}(ctx, st, payload); err != nil {
			slog.Error("message processing failed after all retries", "error", err, "worker", "{{ worker.name }}", "index", index)
		}
	}
}
{%- endif %}

// Run{{ worker.snake | go_pascal }} starts {{ worker.snake | go_pascal }}Concurrency consuming goroutines and
// blocks until ctx is done.
func Run{{ worker.snake | go_pascal }}(ctx context.Context, st *state.AppState) {
	var wg sync.WaitGroup
	for i := 0; i < {{ worker.snake | go_pascal }}Concurrency; i++ {
		wg.Add(1)
		go func(index int) {
			defer wg.Done()
			consume{{ worker.snake | go_pascal }}(ctx, st, index)
		}(i)
	}
	wg.Wait()
}
