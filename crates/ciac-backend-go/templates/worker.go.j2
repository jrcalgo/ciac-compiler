func consume{{ worker.snake | go_pascal }}(ctx context.Context, st *state.AppState, index int) {
	cl, err := st.Queue.Consumer({{ worker.snake | go_pascal }}Subject, {{ worker.snake | go_pascal }}QueueGroup)
	if err != nil {
		slog.Error("worker {{ worker.name }}: connecting to kafka", "error", err, "index", index)
		return
	}
	defer cl.Close()
	slog.Info("worker {{ worker.name }} consuming", "subject", {{ worker.snake | go_pascal }}Subject, "index", index)
	for {
		fetches := cl.PollFetches(ctx)
		if ctx.Err() != nil {
			return
		}
		fetches.EachError(func(_ string, _ int32, err error) {
			slog.Warn("kafka fetch error", "error", err)
		})
		fetches.EachRecord(func(record *kgo.Record) {
			var payload any
			if err := json.Unmarshal(record.Value, &payload); err != nil {
				slog.Warn("discarding malformed message", "error", err)
				return
			}
			if err := handleMessage{{ worker.snake | go_pascal }}(ctx, st, payload); err != nil {
				slog.Error("message processing failed after all retries", "error", err, "worker", "{{ worker.name }}", "index", index)
			}
		})
	}
}
