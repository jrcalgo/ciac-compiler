// EmailSentCountAll is expect.email's own count query -- deliberately
// not scoped to one instance: the scenario schema's expect.email
// carries no instance field, matching Python's own _expect_email,
// which counts sends across every email instance the world has seen.
func (w *World) EmailSentCountAll(to, subjectContains *string) int {
	w.mu.Lock()
	defer w.mu.Unlock()
	count := 0
	for _, email := range w.emails {
		for _, m := range email.sent {
			if to != nil && m.to != *to {
				continue
			}
			if subjectContains != nil && !strings.Contains(m.subject, *subjectContains) {
				continue
			}
			count++
		}
	}
	return count
}

