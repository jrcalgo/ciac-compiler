func (w *World) QueueIsEmpty() bool {
	w.mu.Lock()
	defer w.mu.Unlock()
	return w.queue.isEmpty()
}

// NowMs is the current virtual time, in epoch milliseconds.
func (w *World) NowMs() int64 {
	w.mu.Lock()
	defer w.mu.Unlock()
	return w.nowMsVal
}

// AdvanceClockTo advances virtual time forward. Errors if toMs is
// before the current time -- virtual time never moves backward.
func (w *World) AdvanceClockTo(toMs int64) error {
	w.mu.Lock()
	defer w.mu.Unlock()
	if toMs < w.nowMsVal {
		return fmt.Errorf("virtual clock cannot move backward: at %d, asked for %d", w.nowMsVal, toMs)
	}
	w.nowMsVal = toMs
	return nil
}

