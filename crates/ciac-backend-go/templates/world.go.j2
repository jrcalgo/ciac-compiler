func (w *World) DrainBroker(subject, group string) [][]byte {
	w.mu.Lock()
	defer w.mu.Unlock()
	return w.broker.drain(subject, group)
}

// QueueIsEmpty is a non-destructive peek -- expect.quiescence needs
// to observe whether anything is still undelivered without consuming
