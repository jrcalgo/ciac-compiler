// AuthVerify is the generated auth guard's own verification call --
// claims-lookup, not real JWT/JWKS crypto, matching Python's
// FakeAuth. dest is a pointer to the concrete claims shape the auth
// package's own Claims type expects (JSON-round-tripped, matching
// every other read leaf in this package).
func (w *World) AuthVerify(token string, dest any) error {
	w.mu.Lock()
	claims, err := w.auth.verify(token, w.nowMsVal)
	w.mu.Unlock()
	if err != nil {
		return err
	}
	b, err := json.Marshal(claims)
	if err != nil {
		return err
	}
	return json.Unmarshal(b, dest)
}

// UnmatchedFailureRules returns the failure rules a scenario declared
// that never matched a real occurrence.
func (w *World) UnmatchedFailureRules() []string {
	return w.failures.unmatchedRules()
}

// RegisterAPI registers handler as service's api -- the target
// CallChecked resolves a routed call against. A system-runner (M7c+)
// calls this once per api, in service declaration order, before any
// scenario runs; re-registering the same (service, api) replaces the
// earlier handler rather than erroring, matching how a runner would
// simply rebuild the world (and re-register everything) between
// scenario runs rather than asking this registry to detect staleness
// itself.
func (w *World) RegisterAPI(service, api string, handler ApiHandler) {
	w.mu.Lock()
	defer w.mu.Unlock()
	w.apis[apiKey{service: service, api: api}] = handler
}

// CallChecked routes a `call <Service>.<Api>` step -- inline and
// synchronous on the caller's own logical call chain, exactly as
// production's typed call client behaves, just against the registered
// handler instead of real HTTP. Counts against the `call.request`
// failure vocabulary the same way `db.commit`/`broker.publish` do; an
// injected failure fires before the handler ever runs, and an
// unregistered (calleeService, api) is a clear error rather than a
// silent no-op -- the same "fail closed on a missing seam" discipline
// fakeHTTPClient already uses for an unmatched fixture. The handler's
// own return value/error passes through verbatim, matching production's
// own "the callee's real response or real error, not a synthesized
// one."
func (w *World) CallChecked(caller, calleeService, api string, req any) (any, error) {
	if w.shouldFail("call.request", api) {
		return nil, errors.New("simulated call.request failure (injected by FailureEngine)")
	}
	w.mu.Lock()
	handler, ok := w.apis[apiKey{service: calleeService, api: api}]
	if !ok {
		w.mu.Unlock()
		return nil, fmt.Errorf("no handler registered for %s.%s (called from %s)", calleeService, api, caller)
	}
	if w.callDepth >= maxCallDepth {
		w.mu.Unlock()
		return nil, fmt.Errorf("routed call depth exceeded %d calling %s.%s from %s", maxCallDepth, calleeService, api, caller)
	}
	w.callDepth++
	w.mu.Unlock()
	defer func() {
		w.mu.Lock()
		w.callDepth--
		w.mu.Unlock()
	}()
	// Deliberately invoked outside w.mu: the handler may itself call
	// back into World (a routed call, or a plain db/queue verb), and
	// this mutex is not reentrant -- holding it across the call would
	// deadlock the very first recursive or nested invocation.
	return handler(req)
}

// NamespacedTableKey composes the per-service namespaced database key
// every multi-service world-guarded db verb addresses through -- the Go
// counterpart to ciac-sim's `SimWorld::namespaced_table_key` (28's M2)/
// TypeScript's own `namespacedTableKey` (M7a). service is "" in
// single-service mode, degenerating to the bare table name. A system-
// runner's own `given.db` seeding (service/table only known at runtime,
// from the scenario JSON) is the only caller that needs this at
// runtime -- codegen-time world-guarded call sites bake the equivalent
// key in as a literal (GoSyntax::world_table_key), not through this
// function.
func NamespacedTableKey(service, table string) string {
	if service == "" {
		return table
	}
	return service + "::" + table
}
