// AppState.java -- Generated by CIaC.
//
// Every provider client bean this service holds lives here, growing
// one field per declared capability as later milestones land. Every
// field is `@Lazy` (or lazily constructed by the library itself, as
// HikariCP/Lettuce/`RedisConnectionFactory` are) -- constructing
// `AppState` never blocks on a network call, the same bar every other
// target's own state holder keeps (v0.17 M11's lazy-init discipline).
// `NoInfraBootTest` proves this for real on every `mvnw verify`, not
// just here in a comment.
package com.ciac.{{ java_package }}.state;

{%- set has_beans = c.has_db or c.has_cache or c.has_object_store or c.has_email or c.has_search or c.has_external_http %}
{% if has_beans -%}
{%- if c.has_db %}
import java.sql.Connection;
import java.sql.Statement;
import javax.sql.DataSource;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
{%- endif %}
{%- if c.has_cache %}
import org.springframework.data.redis.connection.RedisStandaloneConfiguration;
import org.springframework.data.redis.connection.lettuce.LettuceConnectionFactory;
import org.springframework.data.redis.core.StringRedisTemplate;
{%- endif %}
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.beans.factory.annotation.Value;
{%- if c.has_db %}
import org.springframework.boot.CommandLineRunner;
{%- endif %}
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Lazy;
import org.springframework.context.annotation.Configuration;
{%- if c.has_db %}
import org.springframework.jdbc.core.simple.JdbcClient;
import org.springframework.jdbc.datasource.DataSourceTransactionManager;
import org.springframework.transaction.support.TransactionTemplate;
{%- endif %}
{% else -%}
import org.springframework.stereotype.Component;
{% endif %}
{% if has_beans %}
@Configuration
public class AppState {
{%- if c.has_db %}
    private static final Logger log = LoggerFactory.getLogger(AppState.class);
{%- endif %}
{%- for inst in c.db_instances %}

    @Lazy
    @Bean("{{ inst.state_field | java_camel }}")
    public DataSource {{ inst.state_field | java_camel }}(
            @Value("${{ '{' }}{{ inst.env_var }}:{% if inst.db_engine == "sqlite" %}jdbc:sqlite:data/{{ inst.db_name }}.db{% elif inst.db_engine == "mysql" %}jdbc:mysql://{{ inst.db_user }}:{{ inst.db_user }}@localhost:3306/{{ inst.db_name }}{% else %}jdbc:postgresql://{{ inst.db_user }}:{{ inst.db_user }}@localhost:5432/{{ inst.db_name }}{% endif %}{{ '}' }}")
            String rawUrl)
            throws Exception {
        return DataSources.open(rawUrl);
    }

    @Lazy
    @Bean("{{ inst.state_field | java_camel }}Jdbc")
    public JdbcClient {{ inst.state_field | java_camel }}Jdbc(
            @Qualifier("{{ inst.state_field | java_camel }}") DataSource dataSource) {
        return JdbcClient.create(dataSource);
    }

    // Programmatic `TransactionTemplate`, not `@Transactional` (Pillar
    // 4 -- a same-class annotated call would skip the proxy's aspect
    // silently). A typed handler's `transaction {}` block executes its
    // body inside `{{ inst.state_field | java_camel }}Tx.executeWithoutResult(status
    // -> {..})` (`lower.rs`'s `transaction_stmt`); every db verb inside
    // still issues SQL through the same `JdbcClient` bean above, which
    // transparently participates via Spring's own connection binding.
    @Lazy
    @Bean("{{ inst.state_field | java_camel }}Tx")
    public TransactionTemplate {{ inst.state_field | java_camel }}Tx(
            @Qualifier("{{ inst.state_field | java_camel }}") DataSource dataSource) {
        return new TransactionTemplate(new DataSourceTransactionManager(dataSource));
    }
{%- endfor %}
{%- for inst in c.cache_instances %}

    // `LettuceConnectionFactory.afterPropertiesSet()` builds the
    // shared native connection lazily (Lettuce's own client only
    // dials on first actual command, mirroring `redis.NewClient`'s
    // own "parses the URL and returns immediately" contract Go's own
    // `state.go.j2` documents) -- `@Lazy` here is belt-and-suspenders
    // (a bean nothing injects is never constructed at all), verified
    // live by `NoInfraBootTest` with no local Redis reachable.
    @Lazy
    @Bean("{{ inst.state_field | java_camel }}")
    public StringRedisTemplate {{ inst.state_field | java_camel }}(
            @Value("${{ '{' }}{{ inst.env_var }}:redis://localhost:6379/{{ inst.redis_db }}{{ '}' }}") String rawUrl) {
        java.net.URI uri = java.net.URI.create(rawUrl);
        RedisStandaloneConfiguration config =
                new RedisStandaloneConfiguration(uri.getHost(), uri.getPort() < 0 ? 6379 : uri.getPort());
        if (uri.getPath() != null && uri.getPath().length() > 1) {
            config.setDatabase(Integer.parseInt(uri.getPath().substring(1)));
        }
        LettuceConnectionFactory factory = new LettuceConnectionFactory(config);
        factory.afterPropertiesSet();
        StringRedisTemplate template = new StringRedisTemplate(factory);
        template.afterPropertiesSet();
        return template;
    }
{%- endfor %}
{%- for inst in c.object_store_instances %}

    @Lazy
    @Bean("{{ inst.state_field | java_camel }}")
    public ObjectStore {{ inst.state_field | java_camel }}(
            @Value("${{ '{' }}{{ inst.cfg[0].env }}:{{ inst.cfg[0].rust_default }}{{ '}' }}") String endpoint,
            @Value("${{ '{' }}{{ inst.cfg[1].env }}:{{ inst.cfg[1].rust_default }}{{ '}' }}") String accessKey,
            @Value("${{ '{' }}{{ inst.cfg[2].env }}:{{ inst.cfg[2].rust_default }}{{ '}' }}") String secretKey,
            @Value("${{ '{' }}{{ inst.cfg[3].env }}:{{ inst.cfg[3].rust_default }}{{ '}' }}") String bucket,
            @Value("${{ '{' }}{{ inst.cfg[4].env }}:{{ inst.cfg[4].rust_default }}{{ '}' }}") String region) {
        return new ObjectStore(endpoint, accessKey, secretKey, bucket, region);
    }
{%- endfor %}
{%- for inst in c.email_instances %}

    @Lazy
    @Bean("{{ inst.state_field | java_camel }}")
    public Email {{ inst.state_field | java_camel }}(
            @Value("${{ '{' }}{{ inst.cfg[0].env }}:{{ inst.cfg[0].rust_default }}{{ '}' }}") String host,
            @Value("${{ '{' }}{{ inst.cfg[1].env }}:{{ inst.cfg[1].rust_default }}{{ '}' }}") int port,
            @Value("${{ '{' }}{{ inst.cfg[2].env }}:{{ inst.cfg[2].rust_default }}{{ '}' }}") String username,
            @Value("${{ '{' }}{{ inst.cfg[3].env }}:{{ inst.cfg[3].rust_default }}{{ '}' }}") String password,
            @Value("${{ '{' }}{{ inst.cfg[4].env }}:{{ inst.cfg[4].rust_default }}{{ '}' }}") String from,
            @Value("${{ '{' }}{{ inst.cfg[5].env }}:{{ inst.cfg[5].rust_default }}{{ '}' }}") boolean useTls) {
        return new Email(host, port, username, password, from, useTls);
    }
{%- endfor %}
{%- for inst in c.search_instances %}

    @Lazy
    @Bean("{{ inst.state_field | java_camel }}")
    public Search {{ inst.state_field | java_camel }}(
            @Value("${{ '{' }}{{ inst.cfg[0].env }}:{{ inst.cfg[0].rust_default }}{{ '}' }}") String url) {
        return new Search(url);
    }
{%- endfor %}
{%- for inst in c.external_http_instances %}

    @Lazy
    @Bean("{{ inst.state_field | java_camel }}")
    public ExternalHttp {{ inst.state_field | java_camel }}(
            @Value("${{ '{' }}{{ inst.cfg[0].env }}:{{ inst.cfg[0].rust_default }}{{ '}' }}") String baseUrl) {
        return new ExternalHttp(baseUrl);
    }
{%- endfor %}
{%- if c.has_db %}

    // "Applies on boot" (Pillar 5): every `table`-declaration migration
    // Flyway would otherwise auto-run via `FlywayAutoConfiguration` is
    // instead run from here, explicitly, against the same `@Lazy`
    // `DataSource` beans above (`spring.flyway.enabled: false` in
    // `application.yml` stops Spring's own auto-wiring from resolving
    // them first) -- Pillar 4's "compiler owns the wiring" rule applied
    // to Flyway itself, not only to the connection pool.
    //
    // Each instance's own migration/table-bootstrap is wrapped in its
    // own try/catch, logged and skipped on failure rather than left to
    // propagate (25UpdatePlan.md M8, found live): a `CommandLineRunner`
    // is *always* eagerly invoked by Spring Boot at startup, so this
    // is the one call site that unavoidably forces every `@Lazy`
    // `DataSource` bean above to actually construct (now non-dialing
    // itself, see `DataSources.open`'s own `initializationFailTimeout`
    // fix) and then genuinely try to connect -- an unreachable database
    // must not abort the whole context, the identical graceful-
    // degradation discipline `Worker.java.j2`'s own NATS/Kafka connect
    // failures already have.
    @Bean
    public CommandLineRunner migrateOnBoot(
            {%- for inst in c.db_instances %}
            @Qualifier("{{ inst.state_field | java_camel }}") DataSource {{ inst.state_field | java_camel }}{% if not loop.last %},{% endif %}
            {%- endfor %}) {
        return args -> {
        {%- for inst in c.db_instances %}
            try {
                DataSources.migrate({{ inst.state_field | java_camel }});
            } catch (Exception e) {
                log.warn("skipping migration for instance \"{{ inst.state_field | java_camel }}\": database unreachable", e);
            }
        {%- endfor %}
        {%- for resource in c.resources %}
            try (Connection conn = {{ resource.rust_db_field | java_camel }}.getConnection();
                    Statement stmt = conn.createStatement()) {
        {%- if resource.record %}
                stmt.execute(
                        "CREATE TABLE IF NOT EXISTS {{ resource.plural }} (id VARCHAR(36) PRIMARY KEY{% for f in resource.record.fields %}{% if f.name != "id" %}, {{ f.name }} {{ f.sql_type | java_ddl_type(resource.db_engine) }} NOT NULL{% endif %}{% endfor %})");
        {%- else %}
                stmt.execute(
                        "CREATE TABLE IF NOT EXISTS {{ resource.plural }} (id VARCHAR(36) PRIMARY KEY, data {{ "JSONB" | java_ddl_type(resource.db_engine) }} NOT NULL)");
        {%- endif %}
            } catch (Exception e) {
                log.warn("skipping table bootstrap for resource \"{{ resource.plural }}\": database unreachable", e);
            }
        {%- endfor %}
        };
    }
{%- endif %}
}
{% else %}
@Component
public class AppState {}
{% endif %}
