package com.ciac.{{ java_package }}.state;

{%- if multi %}
import com.ciac.simshared.World;
{%- else %}
import com.ciac.{{ java_package }}.sim.World;
{%- endif %}
import org.springframework.beans.factory.ObjectProvider;
import org.springframework.mail.SimpleMailMessage;
import org.springframework.mail.javamail.JavaMailSenderImpl;

public final class Email {
    private final String instanceName;
    private final String host;
    private final int port;
    private final String username;
    private final String password;
    private final String from;
    private final boolean useTls;
    private final World world;

    public Email(
            String instanceName,
            String host,
            int port,
            String username,
            String password,
            String from,
            boolean useTls,
            ObjectProvider<World> worldProvider) {
        this.instanceName = instanceName;
        this.host = host;
        this.port = port;
        this.username = username;
        this.password = password;
        this.from = from;
        this.useTls = useTls;
        this.world = worldProvider.getIfAvailable();
    }

    private JavaMailSenderImpl sender() {
        JavaMailSenderImpl sender = new JavaMailSenderImpl();
        sender.setHost(host);
        sender.setPort(port);
        if (!username.isEmpty()) {
            sender.setUsername(username);
            sender.setPassword(password);
        }
        if (useTls) {
            sender.getJavaMailProperties().setProperty("mail.smtp.starttls.enable", "true");
        }
        return sender;
    }

    public void send(String to, String subject, String body) {
        if (world != null) {
            world.emailSend(instanceName, to, subject, body);
            return;
        }
        SimpleMailMessage message = new SimpleMailMessage();
        message.setFrom(from);
        message.setTo(to);
        message.setSubject(subject);
        message.setText(body);
        sender().send(message);
    }
}
