// LogShapeTest.java -- Generated by CIaC (only when a program declares
// `use { logging Structured; }`, `26UpdatePlan.md` M3).
//
// Runs the exact `LogstashEncoder` configured in `logback-spring.xml`
// directly against a synthetic event and parses the encoded bytes back
// as JSON, asserting the field shape every other target's own
// structured-logging proof already covers (Python's structlog
// `JSONRenderer`, Rust's `.json()` fmt layer, Go's `slog.NewJSONHandler`,
// TypeScript's observability template). No Spring context needed --
// this is a property of the encoder configuration alone, not of the
// application wiring, so it stays fast and infrastructure-free.
package com.ciac.{{ java_package }};

import static org.assertj.core.api.Assertions.assertThat;

import ch.qos.logback.classic.Logger;
import ch.qos.logback.classic.spi.ILoggingEvent;
import ch.qos.logback.core.read.ListAppender;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import net.logstash.logback.encoder.LogstashEncoder;
import org.junit.jupiter.api.Test;
import org.slf4j.LoggerFactory;

class LogShapeTest {

    @Test
    void logstashEncoderProducesParseableStructuredJson() throws Exception {
        // Route a real SLF4J call through a `ListAppender` rather than
        // hand-building an `ILoggingEvent`: a synthetic event carries no
        // `LoggerContext` of its own, which the encoder needs (found
        // live -- the first draft NPE'd inside `LogstashEncoder.encode`
        // for exactly this reason).
        Logger logger = (Logger) LoggerFactory.getLogger(LogShapeTest.class);
        ListAppender<ILoggingEvent> appender = new ListAppender<>();
        appender.setContext(logger.getLoggerContext());
        appender.start();
        logger.addAppender(appender);

        logger.info("structured logging shape probe");
        logger.detachAppender(appender);

        assertThat(appender.list).hasSize(1);
        ILoggingEvent event = appender.list.get(0);

        LogstashEncoder encoder = new LogstashEncoder();
        encoder.setContext(logger.getLoggerContext());
        encoder.start();

        byte[] encoded = encoder.encode(event);
        JsonNode json = new ObjectMapper().readTree(encoded);

        assertThat(json.has("@timestamp")).isTrue();
        assertThat(json.get("message").asText()).isEqualTo("structured logging shape probe");
        assertThat(json.get("logger_name").asText()).isEqualTo(LogShapeTest.class.getName());
        assertThat(json.get("level").asText()).isEqualTo("INFO");
    }
}
