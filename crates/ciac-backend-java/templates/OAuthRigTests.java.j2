    @Test
    void {{ api.snake | java_camel }}RejectsWrongKey() throws Exception {
        // The crypto-boundary case the JWT suite cannot express as
        // sharply: a correctly-shaped, correctly-`kid`'d token signed
        // by a key the stub JWKS never served -- proof the signature
        // check itself gates the door, not just claim shape or `kid`
        // lookup.
        mvc.perform(
                        {{ api.method_lower }}("{{ api.route }}")
                                .contentType(MediaType.APPLICATION_JSON)
                                .header(
                                        "Authorization",
                                        mint("{{ api.scope }}", wrongSigningKey, KID, stubIssuer, 3600_000))
{%- if api.has_body %}
                                .content("""
{{ dummy_api_body(api) }}
""")
{%- endif %})
                .andExpect(status().isUnauthorized());
    }

    @Test
    void {{ api.snake | java_camel }}RejectsWrongIssuer() throws Exception {
        mvc.perform(
