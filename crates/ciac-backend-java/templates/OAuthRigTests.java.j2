                                        "Authorization",
                                        mint(
                                                "{{ api.scope }}",
                                                signingKey,
                                                KID,
                                                "http://wrong-issuer.example",
                                                3600_000))
{%- if api.has_body %}
                                .content("""
{{ dummy_api_body(api) }}
""")
{%- endif %})
                .andExpect(status().isUnauthorized());
    }
