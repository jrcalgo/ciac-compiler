// A standalone `@Component` (not one of `AppState`'s own `@Bean`
// factory methods, unlike `DataSource`/`JdbcClient`): a
// `@Configuration` class cannot inject a bean its own `@Bean` method
// produces, so `Queue` is constructor-injected directly into every
// `ApiController`/`Worker`/`Job`/`Channel` that needs it instead of
// being reached through `AppState`.
@Component
public final class Queue {
    private static final ObjectMapper MAPPER = new ObjectMapper();
    private final String url;
{%- if c.queue_engine == "kafka" %}
    private volatile KafkaProducer<String, byte[]> producer;
{%- else %}
    private volatile Connection connection;
{%- endif %}

    public Queue(@Value("${{ '{' }}{% if c.queue_engine == "kafka" %}KAFKA_URL:localhost:9092{% else %}NATS_URL:nats://localhost:4222{% endif %}{{ '}' }}") String url) {
        this.url = url;
    }

{%- if c.queue_engine == "kafka" %}

    private synchronized KafkaProducer<String, byte[]> producer() {
        if (producer == null) {
            Properties props = new Properties();
            props.put("bootstrap.servers", url);
            props.put("key.serializer", StringSerializer.class.getName());
            props.put("value.serializer", ByteArraySerializer.class.getName());
            producer = new KafkaProducer<>(props);
        }
        return producer;
    }

    /** Sends payload to subject (a Kafka topic). Bounded to 5s -- mirrors
     * Go's own rdkafka {@code message.timeout.ms=5000} finding: an
     * unbounded {@code get()} against an unreachable broker would
     * otherwise hang the calling request past any sane client timeout. */
    public void publish(String subject, byte[] payload, Map<String, String> headers) throws Exception {
        ProducerRecord<String, byte[]> record = new ProducerRecord<>(subject, payload);
        if (headers != null) {
            headers.forEach((k, v) -> record.headers().add(new RecordHeader(k, v.getBytes())));
        }
        producer().send(record).get(5, TimeUnit.SECONDS);
    }
{%- else %}

    private synchronized Connection connection() throws Exception {
        if (connection == null) {
            connection = Nats.connect(url);
        }
        return connection;
    }

    /** Sends payload to subject. */
    public void publish(String subject, byte[] payload, Map<String, String> headers) throws Exception {
        Connection conn = connection();
        if (headers == null || headers.isEmpty()) {
            conn.publish(subject, payload);
            return;
        }
        Headers h = new Headers();
        headers.forEach(h::add);
        conn.publish(NatsMessage.builder().subject(subject).headers(h).data(payload).build());
    }

    /** The underlying connection, for workers/channels to build their own
     * dispatchers/subscriptions against -- connects on first call, same
     * as {@link #publish}. */
    public Connection natsConnection() throws Exception {
        return connection();
    }
{%- endif %}

    /** Marshals v and publishes it -- the shared call site every
     * generated pipeline `publish` step goes through. */
    public void publishJson(String subject, Object v) {
        try {
            publish(subject, MAPPER.writeValueAsBytes(v), null);
        } catch (Exception e) {
            throw new RuntimeException("publishing to " + subject, e);
        }
    }
}
