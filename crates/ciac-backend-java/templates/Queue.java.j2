// A standalone `@Component` (not one of `AppState`'s own `@Bean`
// factory methods, unlike `DataSource`/`JdbcClient`): a
// `@Configuration` class cannot inject a bean its own `@Bean` method
// produces, so `Queue` is constructor-injected directly into every
// `ApiController`/`Worker`/`Job`/`Channel` that needs it instead of
// being reached through `AppState`.
@Component
public final class Queue {
    private static final ObjectMapper MAPPER = new ObjectMapper();
    private final String url;
    // `null` in production; a simulation-run `World` when SimRunner
    // manually registers one (v0.25 M9) -- `ObjectProvider<World>` is
    // Spring's own null-safe "this bean, or nothing" injection, so no
    // `World` bean ever needs to exist for production wiring to
    // resolve cleanly (`World.java` is a plain class, never a
    // `@Component`; nothing auto-registers it).
    private final World world;
{%- if c.queue_engine == "kafka" %}
    private volatile KafkaProducer<String, byte[]> producer;
{%- else %}
    private volatile Connection connection;
{%- endif %}
{%- if c.has_tracing %}
    private final Tracer tracer;
    private final Propagator propagator;
{%- endif %}

    public Queue(
            @Value("${{ '{' }}{% if c.queue_engine == "kafka" %}KAFKA_URL:localhost:9092{% else %}NATS_URL:nats://localhost:4222{% endif %}{{ '}' }}") String url,
            ObjectProvider<World> worldProvider{% if c.has_tracing %}, Tracer tracer, Propagator propagator{% endif %}) {
        this.url = url;
        this.world = worldProvider.getIfAvailable();
{%- if c.has_tracing %}
        this.tracer = tracer;
        this.propagator = propagator;
{%- endif %}
    }

{%- if c.queue_engine == "kafka" %}

    private synchronized KafkaProducer<String, byte[]> producer() {
        if (producer == null) {
            Properties props = new Properties();
            props.put("bootstrap.servers", url);
            props.put("key.serializer", StringSerializer.class.getName());
            props.put("value.serializer", ByteArraySerializer.class.getName());
            producer = new KafkaProducer<>(props);
        }
        return producer;
    }

    /** Sends payload to subject (a Kafka topic). Bounded to 5s -- mirrors
     * Go's own rdkafka {@code message.timeout.ms=5000} finding: an
     * unbounded {@code get()} against an unreachable broker would
     * otherwise hang the calling request past any sane client timeout. */
    public void publish(String subject, byte[] payload, Map<String, String> headers) throws Exception {
        ProducerRecord<String, byte[]> record = new ProducerRecord<>(subject, payload);
        if (headers != null) {
            headers.forEach((k, v) -> record.headers().add(new RecordHeader(k, v.getBytes())));
        }
        producer().send(record).get(5, TimeUnit.SECONDS);
    }
{%- else %}

    private synchronized Connection connection() throws Exception {
        if (connection == null) {
            connection = Nats.connect(url);
        }
        return connection;
    }

    /** Sends payload to subject. */
    public void publish(String subject, byte[] payload, Map<String, String> headers) throws Exception {
        Connection conn = connection();
        if (headers == null || headers.isEmpty()) {
            conn.publish(subject, payload);
            return;
        }
        Headers h = new Headers();
        headers.forEach(h::add);
        conn.publish(NatsMessage.builder().subject(subject).headers(h).data(payload).build());
    }

    /** The underlying connection, for workers/channels to build their own
     * dispatchers/subscriptions against -- connects on first call, same
     * as {@link #publish}. */
    public Connection natsConnection() throws Exception {
        return connection();
    }
{%- endif %}

    /** Marshals v and publishes it -- the shared call site every
     * generated pipeline `publish` step (and every `state.publish`
     * leaf) goes through, world-guarded (v0.25 M9): a simulation run
     * routes to the fake in-memory broker instead, skipping the real
     * connection/tracing path below entirely -- the sole choke point
     * every publish call site needs, so neither `_steps.java.j2` nor
     * `lower.rs`'s own `publish` leaf need any world-awareness of
     * their own.{% if c.has_tracing %} The
     * current span's trace context (if any) is injected as headers
     * (W3C `traceparent`, via Micrometer's own `Propagator`) so a
     * consuming worker/consumer can continue the same trace -- the
     * broker-hop half of propagation Pillar 6 requires, mirroring
     * Go's own `InjectCarrier`/`otel.GetTextMapPropagator().Inject`.{% endif %} */
    public void publishJson(String subject, Object v) {
        try {
            if (world != null) {
                world.publishChecked(subject, MAPPER.writeValueAsBytes(v));
                return;
            }
{%- if c.has_tracing %}
            Map<String, String> headers = new HashMap<>();
            Span current = tracer.currentSpan();
            if (current != null) {
                propagator.inject(current.context(), headers, Map::put);
            }
            publish(subject, MAPPER.writeValueAsBytes(v), headers);
{%- else %}
            publish(subject, MAPPER.writeValueAsBytes(v), null);
{%- endif %}
        } catch (Exception e) {
            throw new RuntimeException("publishing to " + subject, e);
        }
    }
{%- if c.has_tracing %}

    /** Runs work inside a span extracted from headers (nil-safe: a
     * message published before this service's own `tracing
     * OpenTelemetry` landed, or from a non-participating system,
     * starts a fresh root span instead of erroring) -- the consume-
     * side half of broker propagation, called from every generated
     * worker/consumer's own message-handling call site. Mirrors Go's
     * own `observability.Traced`. */
    public void traced(String name, Map<String, String> headers, Runnable work) {
        Map<String, String> safeHeaders = headers == null ? Map.<String, String>of() : headers;
        Span.Builder builder = propagator.extract(safeHeaders, (carrier, key) -> carrier.get(key));
        Span span = builder.name(name).start();
        try (Tracer.SpanInScope ignored = tracer.withSpan(span)) {
            work.run();
        } finally {
            span.end();
        }
    }
{%- endif %}
}
