    }

    @Test
    void {{ resource.name | java_camel }}ListRejectsMalformedToken() throws Exception {
        mvc.perform(get("/{{ resource.plural }}").header("Authorization", "Bearer not-a-jwt"))
                .andExpect(status().isUnauthorized());
    }
{%- endif %}
