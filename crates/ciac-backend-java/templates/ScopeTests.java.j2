{% for api in c.apis %}
{%- if api.scope %}

    @Test
    void {{ api.snake | java_camel }}RejectsMissingScope() throws Exception {
        mvc.perform(
                        {{ api.method_lower }}("{{ api.route }}")
                                .contentType(MediaType.APPLICATION_JSON)
                                .header("Authorization", bearer("not:{{ api.scope }}"))
{%- if api.has_body %}
                                .content("""
{{ dummy_api_body(api) }}
""")
{%- endif %})
                .andExpect(status().isForbidden());
    }

    @Test
    void {{ api.snake | java_camel }}AcceptsRequiredScope() throws Exception {
        mvc.perform(
                        {{ api.method_lower }}("{{ api.route }}")
                                .contentType(MediaType.APPLICATION_JSON)
                                .header("Authorization", bearer("{{ api.scope }}"))
{%- if api.has_body %}
                                .content("""
{{ dummy_api_body(api) }}
""")
{%- endif %})
                .andExpect((result) -> {
                    int code = result.getResponse().getStatus();
                    if (code == 401 || code == 403) {
                        throw new AssertionError(
                                "expected neither 401 nor 403 (mechanism proof only), got " + code);
                    }
                });
    }
{%- endif %}
{%- endfor %}
{% for resource in c.resources %}
{%- if resource.read_scope %}

    @Test
    void {{ resource.name | java_camel }}ListRejectsMissingReadScope() throws Exception {
        mvc.perform(get("/{{ resource.plural }}").header("Authorization", bearer("not:{{ resource.read_scope }}")))
                .andExpect(status().isForbidden());
    }

    @Test
    void {{ resource.name | java_camel }}ListAcceptsReadScope() throws Exception {
        mvc.perform(get("/{{ resource.plural }}").header("Authorization", bearer("{{ resource.read_scope }}")))
                .andExpect((result) -> {
                    int code = result.getResponse().getStatus();
                    if (code == 401 || code == 403) {
                        throw new AssertionError(
                                "expected neither 401 nor 403 (mechanism proof only), got " + code);
                    }
                });
    }
