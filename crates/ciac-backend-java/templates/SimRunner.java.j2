    private static void advance(AnnotationConfigApplicationContext ctx, long fromMs, long toMs, Map<String, Integer> jobRuns)
            throws Exception {
{%- for job in c.jobs %}
        {
            CronExpression schedule = CronExpression.parse("{{ job.schedule | spring_cron }}");
            for (long due : dueInstants(schedule, fromMs, toMs)) {
                ctx.getBean({{ job.name }}Job.class).handleTickOnce();
                jobRuns.merge("{{ job.name }}", 1, Integer::sum);
            }
        }
{%- endfor %}
    }

    private static void expect(
            ExpectStep spec,
            World world,
            Map<String, SavedResponse> saved,
            Map<String, Integer> workerAttempts,
            Map<String, Integer> jobRuns) {
        if (spec.response() != null) {
            SavedResponse got = saved.get(spec.response().of());
            if (got == null) {
                throw new RuntimeException("expect.response.of references unknown save_as \"" + spec.response().of() + "\"");
            }
            if (spec.response().status() != null && got.status() != spec.response().status()) {
                throw new RuntimeException(
                        "expect.response.of=\"" + spec.response().of() + "\": expected status " + spec.response().status()
                                + ", got " + got.status());
            }
            if (spec.response().json() != null && !spec.response().json().equals(got.json())) {
                throw new RuntimeException(
                        "expect.response.of=\"" + spec.response().of() + "\": expected json " + spec.response().json()
                                + ", got " + got.json());
            }
        } else if (spec.row() != null) {
            if (!SERVICE_NAME.equals(spec.row().service())) {
                throw new RuntimeException(
                        "sim_runner only drives service \"" + SERVICE_NAME + "\" (single-service only); expect.row named \""
                                + spec.row().service() + "\"");
            }
            Map<String, Object> where = spec.row().where() != null ? spec.row().where() : Map.of();
            boolean found = !world.findWhere(spec.row().table(), where).isEmpty();
            if (found != spec.row().present()) {
                throw new RuntimeException(
                        "expect.row: table=\"" + spec.row().table() + "\" where=" + where + " present=" + spec.row().present()
                                + ", found=" + found);
            }
        } else if (spec.workerAttempts() != null) {
            int actual = workerAttempts.getOrDefault(spec.workerAttempts().worker(), 0);
            if (actual != spec.workerAttempts().count()) {
                throw new RuntimeException(
                        "expect.worker_attempts: worker=\"" + spec.workerAttempts().worker() + "\" expected "
                                + spec.workerAttempts().count() + ", got " + actual);
            }
        } else if (spec.jobRuns() != null) {
            int actual = jobRuns.getOrDefault(spec.jobRuns().job(), 0);
            if (actual != spec.jobRuns().count()) {
                throw new RuntimeException(
                        "expect.job_runs: job=\"" + spec.jobRuns().job() + "\" expected " + spec.jobRuns().count() + ", got "
                                + actual);
            }
        } else if (spec.quiescence() != null) {
            if (!world.queueIsEmpty()) {
                throw new RuntimeException("expect.quiescence: undelivered message(s) remain in the simulated broker");
            }
        } else {
            throw new RuntimeException("sim_runner: unrecognized expect step");
        }
    }

    public static void main(String[] args) throws Exception {
        if (args.length < 1) {
            System.err.println("usage: SimRunner <scenario.json>");
            System.exit(1);
        }
        Scenario sc = MAPPER.readValue(Files.readString(Path.of(args[0])), Scenario.class);
        if (sc.simulationVersion() != 1) {
            System.err.println("scenario simulation_version " + sc.simulationVersion() + " is not supported (expected 1)");
            System.exit(1);
        }
        if (sc.steps() == null || sc.steps().isEmpty()) {
            System.err.println("scenario has no steps");
            System.exit(1);
        }

        Given given = sc.given() != null ? sc.given() : new Given(List.of(), List.of());
        List<World.FailureRule> failureRules =
                toFailureRules(given.failures() != null ? given.failures() : List.of());
        World world = new World(failureRules);
        for (GivenTableRows seed : given.db() != null ? given.db() : List.<GivenTableRows>of()) {
            if (!SERVICE_NAME.equals(seed.service())) {
                System.err.println(
                        "sim_runner only drives service \"" + SERVICE_NAME + "\" (single-service only); given.db named \""
                                + seed.service() + "\"");
                System.exit(1);
            }
            for (Map<String, Object> row : seed.rows()) {
                world.seedDb(seed.table(), row);
            }
        }

        long nowMs;
        try {
            nowMs = Instant.parse(sc.startAt()).toEpochMilli();
        } catch (Exception e) {
            System.err.println("scenario start_at \"" + sc.startAt() + "\": not a valid date");
            System.exit(1);
            return;
        }

        // Scans everything below the root package EXCEPT `Application`
        // itself (see the class doc) plus manually registers the one
        // `World` bean instance every `ObjectProvider<World>`
        // injection point (Queue, and every `needs_db` typed handler)
        // resolves against -- the only difference from production
        // wiring.
        AnnotationConfigApplicationContext ctx = new AnnotationConfigApplicationContext();
        ctx.scan(
                "com.ciac.{{ java_package }}.routes",
                "com.ciac.{{ java_package }}.services",
                "com.ciac.{{ java_package }}.logic",
                "com.ciac.{{ java_package }}.state",
                "com.ciac.{{ java_package }}.workers",
                "com.ciac.{{ java_package }}.clients");
        ctx.registerBean("world", World.class, () -> world);
        ctx.refresh();

        MockMvc mvc =
                MockMvcBuilders.standaloneSetup(ctx.getBeansWithAnnotation(RestController.class).values().toArray())
                        .setControllerAdvice(ctx.getBeansWithAnnotation(RestControllerAdvice.class).values().toArray())
                        .build();

        Map<String, SavedResponse> saved = new HashMap<>();
        Map<String, Integer> workerAttempts = new HashMap<>();
        Map<String, Integer> jobRuns = new HashMap<>();

        Exception runErr = null;
        for (ScenarioStep step : sc.steps()) {
            try {
                if (step.request() != null) {
                    SavedResponse resp = doRequest(mvc, step.request());
                    if (step.request().saveAs() != null) {
                        saved.put(step.request().saveAs(), resp);
                    }
                } else if (step.publish() != null) {
                    throw new RuntimeException("sim_runner does not support `publish` steps (disclosed scope)");
                } else if (step.advance() != null) {
                    long deltaMs = parseDurationMs(step.advance().by());
                    long toMs = nowMs + deltaMs;
                    advance(ctx, nowMs, toMs, jobRuns);
                    nowMs = toMs;
                } else if (step.drain() != null) {
                    drain(ctx, world, workerAttempts);
                } else if (step.expect() != null) {
                    expect(step.expect(), world, saved, workerAttempts, jobRuns);
                } else {
                    throw new RuntimeException("sim_runner: unrecognized step");
                }
            } catch (Exception e) {
                runErr = e;
            }
            if (runErr != null) {
                break;
            }
        }
        if (runErr == null) {
            List<String> unmatched = world.unmatchedFailureRules();
            if (!unmatched.isEmpty()) {
                runErr = new RuntimeException(
                        unmatched.size() + " failure rule(s) declared in `given.failures` never matched a real occurrence: "
                                + unmatched);
            }
        }

        SimScenarioOutcome outcome =
                new SimScenarioOutcome(sc.name(), runErr == null, runErr != null ? runErr.getMessage() : null, workerAttempts, jobRuns);
        ctx.close();
        System.out.println(MAPPER.writeValueAsString(outcome));
    }
