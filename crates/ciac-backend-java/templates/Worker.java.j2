import org.springframework.boot.context.event.ApplicationReadyEvent;
import org.springframework.context.event.EventListener;
{%- endif %}
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Component;

{% import "_steps.java.j2" as steps %}
{%- set payload_type = worker.payload.class_name if worker.payload else "" %}
@Component
public class {{ worker.name }}Worker {
    public static final String SUBJECT = "{{ worker.subject }}";
    public static final String QUEUE_GROUP = "{{ worker.queue_group }}";
    public static final int CONCURRENCY = {{ worker.concurrency }};
    public static final int MAX_RETRIES = {{ worker.max_retries }};

    private static final Logger log = LoggerFactory.getLogger({{ worker.name }}Worker.class);
    private static final ObjectMapper MAPPER = new ObjectMapper();

    private final Queue queue;
{%- for handler in worker.handlers %}
    private final {{ handler.class_name }} {{ handler.class_name | java_camel }};
{%- endfor %}
{%- for call in worker.call_imports %}
    private final {{ call.class_name }} {{ call.class_name | java_camel }};
{%- endfor %}

    public {{ worker.name }}Worker(
            Queue queue{% for handler in worker.handlers %}, {{ handler.class_name }} {{ handler.class_name | java_camel }}{% endfor %}{% for call in worker.call_imports %}, {{ call.class_name }} {{ call.class_name | java_camel }}{% endfor %}) {
        this.queue = queue;
{%- for handler in worker.handlers %}
        this.{{ handler.class_name | java_camel }} = {{ handler.class_name | java_camel }};
{%- endfor %}
{%- for call in worker.call_imports %}
        this.{{ call.class_name | java_camel }} = {{ call.class_name | java_camel }};
{%- endfor %}
    }

    /** Runs the pipeline exactly once, no retry/backoff wrapper -- the seam
     * a future simulation runner drives directly with its own attempt
     * counting, mirroring {@code handleMessageOnce} in every other
     * target's own worker. */
    public void handleMessageOnce(Object payload) throws Exception {
        Object result = payload;
{%- for step in worker.steps %}
{{ steps.emit_step(step, "        ", payload_type) }}
{%- endfor %}
        java.util.Objects.requireNonNull(result);
    }

    private void handleMessage(Object payload) {
        Exception last = null;
        for (int attempt = 0; attempt <= MAX_RETRIES; attempt++) {
            try {
                handleMessageOnce(payload);
                return;
            } catch (Exception e) {
                last = e;
                if (attempt < MAX_RETRIES) {
                    log.warn("message processing failed; retrying (attempt {})", attempt, e);
                }
            }
        }
        log.error("message processing failed after all retries", last);
    }

    private Object decode(byte[] raw) {
        try {
{%- if worker.payload %}
            return MAPPER.readValue(raw, {{ worker.payload.class_name }}.class);
{%- else %}
            return MAPPER.readValue(raw, Object.class);
{%- endif %}
        } catch (Exception e) {
            log.warn("discarding malformed message", e);
            return null;
        }
    }
{%- if c.queue_engine == "kafka" %}

    // `spring-kafka` listener container (Pillar 6): `groupId` = the
    // queue group, container `concurrency` = `worker.concurrency` --
    // manual-immediate ack after successful handling only, so a
    // failed message (after exhausting retries) is still acked rather
    // than redelivered forever (at-least-once with a bounded retry
    // budget, the v0.11 M3 contract every earlier target already
    // carries). The listener container auto-starts during context
    // refresh and polls the broker on its own background thread --
    // unlike `DataSource`/`Connection`, an unreachable broker blocks
    // that background poll loop rather than the boot sequence itself,
    // so this does not need the `@Lazy`/`ApplicationReadyEvent`
    // discipline M2's `DataSource` and NATS's `Connection` both need;
    // disclosed, unverified live -- no Kafka broker exists in this
    // sandbox to confirm, CI-delegated the same way broker-delivery
    // itself already is.
    @KafkaListener(topics = SUBJECT, groupId = QUEUE_GROUP, concurrency = "" + CONCURRENCY)
    public void onMessage({% if c.has_tracing %}org.apache.kafka.clients.consumer.ConsumerRecord<String, byte[]> record{% else %}byte[] raw{% endif %}) {
{%- if c.has_tracing %}
        byte[] raw = record.value();
{%- endif %}
        Object payload = decode(raw);
        if (payload == null) {
            return;
        }
{%- if c.has_tracing %}
        java.util.Map<String, String> headers = new java.util.HashMap<>();
        record.headers()
                .forEach(
                        h ->
                                headers.put(
                                        h.key(), new String(h.value(), java.nio.charset.StandardCharsets.UTF_8)));
        queue.traced("{{ worker.name }}.handle", headers, () -> handleMessage(payload));
{%- else %}
        handleMessage(payload);
{%- endif %}
    }
{%- else %}

    // jnats `Dispatcher` with a queue-group subscription (Pillar 6) --
    // direct parity with NATS's own load-balancing semantics: any
    // number of subscriptions (here, `CONCURRENCY` separate
    // dispatchers) sharing a queue-group name split incoming messages
    // between them at the server, no app-level coordination needed.
    // Started from `ApplicationReadyEvent` (after the context is fully
    // up) rather than eagerly at bean construction, matching every
    // provider client's own `@Lazy` discipline. Found live: an
    // unreachable broker's `IOException` propagating out of an
    // `@EventListener` method is fatal to Spring's own event
    // multicaster, which aborts context startup entirely -- unlike
    // Kafka's own listener containers (background thread, doesn't
    // block boot) and unlike Go's own goroutine-based consumer (the
    // dial failure is caught and logged inside the goroutine, never
    // propagated to `main`). Catching here restores that same
    // graceful-degradation behavior instead of taking the whole app
    // down over a broker outage.
    @EventListener(ApplicationReadyEvent.class)
    public void start() {
        try {
            for (int i = 0; i < CONCURRENCY; i++) {
                Dispatcher dispatcher =
                        queue.natsConnection()
                                .createDispatcher(
                                        msg -> {
                                            Object payload = decode(msg.getData());
                                            if (payload == null) {
                                                return;
                                            }
{%- if c.has_tracing %}
                                            java.util.Map<String, String> headers = new java.util.HashMap<>();
                                            io.nats.client.impl.Headers h = msg.getHeaders();
                                            if (h != null) {
                                                for (String key : h.keySet()) {
                                                    java.util.List<String> values = h.get(key);
                                                    if (values != null && !values.isEmpty()) {
                                                        headers.put(key, values.get(0));
                                                    }
                                                }
                                            }
                                            queue.traced("{{ worker.name }}.handle", headers, () -> handleMessage(payload));
{%- else %}
                                            handleMessage(payload);
{%- endif %}
                                        });
                dispatcher.subscribe(SUBJECT, QUEUE_GROUP);
            }
            log.info("worker {{ worker.name }} consuming subject={} group={}", SUBJECT, QUEUE_GROUP);
        } catch (Exception e) {
            log.error("worker {{ worker.name }}: failed to connect/subscribe", e);
        }
    }
{%- endif %}
}
