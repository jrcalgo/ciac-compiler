<?xml version="1.0" encoding="UTF-8"?>
<!-- logback-spring.xml, generated by CIaC (only when a program
     declares `use { logging Structured; }`). Spring Boot
     auto-discovers this exact filename; its mere presence is what
     switches the console appender's encoder from Boot's own default
     human-readable pattern to structured JSON, with no
     `application.yml` change needed, and none made. Without
     `logging Structured` declared, this file is not emitted at all
     and Boot's default console format stands, matching every other
     target's own declared-vs-default behavior (`has_logging`
     toggles Python's structlog `JSONRenderer`, Rust's
     `tracing_subscriber` `.json()` layer, Go's `slog.NewJSONHandler`,
     TypeScript's own observability template the identical way). -->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
  </appender>
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
