"""Realtime channel `{{ channel.name }}`. Generated by CIaC."""

{%- if channel.provider == "sse" or not channel.payload %}
import json
{%- endif %}

{%- if channel.provider == "sse" %}
from fastapi import APIRouter
from fastapi.responses import StreamingResponse
{%- else %}
from fastapi import APIRouter, WebSocket, WebSocketDisconnect
{%- endif %}

{%- if c.queue_engine == "kafka" %}
from aiokafka import AIOKafkaConsumer

from app.config import get_settings
{%- else %}
from app.queue import get_client
{%- endif %}
{%- if channel.payload %}
from app.schemas import {{ channel.payload.class_name }}
{%- endif %}

router = APIRouter()
SUBJECT = "{{ channel.subject }}"


def _decode(data: bytes) -> dict:
{%- if channel.payload %}
    return {{ channel.payload.class_name }}.model_validate_json(data).model_dump(mode="json")
{%- else %}
    return json.loads(data)
{%- endif %}


{%- if channel.provider == "sse" %}
@router.get("{{ channel.path }}")
async def {{ channel.snake }}() -> StreamingResponse:
    async def events():
{%- if c.queue_engine == "kafka" %}
        consumer = AIOKafkaConsumer(SUBJECT, bootstrap_servers=get_settings().kafka_url)
        await consumer.start()
        try:
            async for message in consumer:
                yield f"data: {json.dumps(_decode(message.value))}\n\n"
        finally:
            await consumer.stop()
{%- else %}
        client = await get_client()
        subscription = await client.subscribe(SUBJECT)
        async for message in subscription.messages:
            yield f"data: {json.dumps(_decode(message.data))}\n\n"
{%- endif %}

    return StreamingResponse(events(), media_type="text/event-stream")
{%- else %}
@router.websocket("{{ channel.path }}")
async def {{ channel.snake }}(socket: WebSocket) -> None:
    await socket.accept()
{%- if c.queue_engine == "kafka" %}
    consumer = AIOKafkaConsumer(SUBJECT, bootstrap_servers=get_settings().kafka_url)
    await consumer.start()
    try:
        async for message in consumer:
            await socket.send_json(_decode(message.value))
    except WebSocketDisconnect:
        pass
    finally:
        await consumer.stop()
{%- else %}
    client = await get_client()
    subscription = await client.subscribe(SUBJECT)
    try:
        async for message in subscription.messages:
            await socket.send_json(_decode(message.data))
    except WebSocketDisconnect:
        pass
    finally:
        await subscription.unsubscribe()
{%- endif %}
{%- endif %}
