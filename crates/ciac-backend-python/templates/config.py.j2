"""Runtime configuration for {{ c.service_name }}. Generated by CIaC.

Every value can be overridden through the environment (or an `.env`
file): field names map to upper-cased variables, e.g. `DATABASE_URL`.
"""

from functools import lru_cache

from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    """Environment-driven settings with development defaults."""

    model_config = SettingsConfigDict(env_file=".env", extra="ignore")
{%- if c.has_db %}
{% for inst in c.db_instances %}
    {{ inst.url_field }}: str = "postgresql+asyncpg://postgres:postgres@localhost:5432/{{ inst.db_name }}"
{%- endfor %}
{%- endif %}
{%- if c.has_cache %}
{% for inst in c.cache_instances %}
    {{ inst.url_field }}: str = "redis://localhost:6379/{{ inst.redis_db }}"
{%- endfor %}
{%- endif %}
{%- if c.has_queue %}

    nats_url: str = "nats://localhost:4222"
{%- endif %}
{%- if c.has_auth %}

    jwt_secret: str = "change-me"
    jwt_algorithm: str = "HS256"
{%- endif %}


@lru_cache
def get_settings() -> Settings:
    return Settings()
