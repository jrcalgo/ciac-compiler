"""Runtime configuration for {{ c.service_name }}. Generated by CIaC.

Every value can be overridden through the environment (or an `.env`
file): field names map to upper-cased variables, e.g. `DATABASE_URL`.
"""

from functools import lru_cache

from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    """Environment-driven settings with development defaults."""

    model_config = SettingsConfigDict(env_file=".env", extra="ignore")
{%- if c.has_db %}
{% for inst in c.db_instances %}
    {{ inst.url_field }}: str = "{% if inst.db_engine == "mysql" %}mysql+aiomysql://root:root@localhost:3306/{{ inst.db_name }}{% else %}postgresql+asyncpg://postgres:postgres@localhost:5432/{{ inst.db_name }}{% endif %}"
{%- endfor %}
{%- endif %}
{%- if c.has_cache %}
{% for inst in c.cache_instances %}
    {{ inst.url_field }}: str = "redis://localhost:6379/{{ inst.redis_db }}"
{%- endfor %}
{%- endif %}
{%- for inst in c.object_store_instances %}
{% for f in inst.cfg %}
    {{ f.field }}: {{ f.py_ann }} = {{ f.py_default }}
{%- endfor %}
{%- endfor %}
{%- for inst in c.email_instances %}
{% for f in inst.cfg %}
    {{ f.field }}: {{ f.py_ann }} = {{ f.py_default }}
{%- endfor %}
{%- endfor %}
{%- for inst in c.search_instances %}
{% for f in inst.cfg %}
    {{ f.field }}: {{ f.py_ann }} = {{ f.py_default }}
{%- endfor %}
{%- endfor %}
{%- for inst in c.external_http_instances %}
{% for f in inst.cfg %}
    {{ f.field }}: {{ f.py_ann }} = {{ f.py_default }}
{%- endfor %}
{%- endfor %}
{%- if c.call_targets %}
{% for t in c.call_targets %}
    {{ t.url_field }}: str = "{{ t.default_url }}"
{%- endfor %}
{%- endif %}
{%- if c.has_queue %}

    nats_url: str = "nats://localhost:4222"
{%- endif %}
{%- if c.auth_scheme == "oauth2" %}

    oauth_issuer: str = "{{ c.auth_issuer }}"
    oauth_audience: str = "{{ c.auth_audience }}"
{%- elif c.has_auth %}

    jwt_secret: str = "change-me"
    jwt_algorithm: str = "HS256"
{%- endif %}


@lru_cache
def get_settings() -> Settings:
    return Settings()
