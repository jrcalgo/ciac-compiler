"""Event consumer for `events {{ consumer.name }}`. Generated by CIaC.

Consumes `{{ consumer.subject }}` in queue group `{{ consumer.queue_group }}`.
"""

import json
from typing import Any

{%- if c.queue_engine == "kafka" %}
from aiokafka import AIOKafkaConsumer
{%- else %}
import nats
{%- endif %}

from app.config import get_settings
{%- if consumer.needs_db %}
from app.db import get_sessionmaker
{%- endif %}

SUBJECT = "{{ consumer.subject }}"
QUEUE_GROUP = "{{ consumer.queue_group }}"


async def handle_event(payload: dict[str, Any]) -> None:
{%- if consumer.needs_db %}
    async with get_sessionmaker()() as session:
        _ = session
        _ = payload  # TODO: persist or process the {{ consumer.name }} event.
{%- else %}
    _ = payload  # TODO: process the {{ consumer.name }} event.
{%- endif %}


async def run() -> None:
    """Subscribes and processes events forever."""
{%- if c.queue_engine == "kafka" %}
    consumer = AIOKafkaConsumer(
        SUBJECT,
        group_id=QUEUE_GROUP,
        bootstrap_servers=get_settings().kafka_url,
    )
    await consumer.start()
    try:
        async for message in consumer:
            await handle_event(json.loads(message.value))
    finally:
        await consumer.stop()
{%- else %}
    client = await nats.connect(get_settings().nats_url)
    subscription = await client.subscribe(SUBJECT, queue=QUEUE_GROUP)
    async for message in subscription.messages:
        await handle_event(json.loads(message.data))
{%- endif %}
