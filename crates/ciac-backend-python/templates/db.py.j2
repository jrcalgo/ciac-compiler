"""Async database access (SQLAlchemy + asyncpg). Generated by CIaC.

Engines are created lazily so importing the app never requires a running
database. Each named `db` instance from the `use {{ '{' }} .. {{ '}' }}` block gets its
own engine, sessionmaker, and FastAPI dependency.
"""

from collections.abc import AsyncIterator

from sqlalchemy.ext.asyncio import (
    AsyncEngine,
    AsyncSession,
    async_sessionmaker,
    create_async_engine,
)
from sqlalchemy.orm import DeclarativeBase

from app.config import get_settings


class Base(DeclarativeBase):
    """Declarative base for all models."""


def _urls() -> dict[str, str]:
    settings = get_settings()
    return {
{%- for inst in c.db_instances %}
        "{{ inst.snake }}": settings.{{ inst.url_field }},
{%- endfor %}
    }


_engines: dict[str, AsyncEngine] = {}
_sessionmakers: dict[str, async_sessionmaker[AsyncSession]] = {}


def get_engine(instance: str = "default") -> AsyncEngine:
    if instance not in _engines:
        url = _urls()[instance]{% if c.has_sqlite_db %}
        if url.startswith("sqlite"):
            # The database is a local file; aiosqlite creates the file
            # but not its directory.
            import pathlib

            pathlib.Path("data").mkdir(exist_ok=True)
{%- endif %}
        _engines[instance] = create_async_engine(url)
    return _engines[instance]


def get_sessionmaker(instance: str = "default") -> async_sessionmaker[AsyncSession]:
    if instance not in _sessionmakers:
        _sessionmakers[instance] = async_sessionmaker(
            get_engine(instance), expire_on_commit=False
        )
    return _sessionmakers[instance]

{% for inst in c.db_instances %}
async def {{ inst.session_dep }}() -> AsyncIterator[AsyncSession]:
    """FastAPI dependency yielding one `{{ inst.name }}` session per request."""
    async with get_sessionmaker("{{ inst.snake }}")() as session:
        yield session

{% endfor %}
async def create_schema(instance: str = "default") -> None:
    """Creates CRUD-resource tables on startup. `table` declarations
    (v0.7) are provisioned by `run_migrations` instead, since they carry
    real incremental migrations rather than a create-if-absent call.
    """
{%- if c.resources %}
    from app import models  # noqa: F401  (registers models on Base)

    names = [{% for resource in c.resources %}"{{ resource.plural }}"{% if not loop.last %}, {% endif %}{% endfor %}]
    async with get_engine(instance).begin() as conn:
        await conn.run_sync(
            lambda sync_conn: Base.metadata.create_all(
                sync_conn, tables=[Base.metadata.tables[name] for name in names]
            )
        )
{%- else %}
    return
{%- endif %}
{% if c.tables %}

async def run_migrations(instance: str = "default") -> None:
    """Applies `app/migrations/*.sql` files not yet recorded, in filename
    order. Each file is generated by `ciac build`'s additive-only schema
    differ for `table` declarations and applied at most once, tracked in
    `_ciac_migrations`.
    """
    import pathlib

    from sqlalchemy import text

    migrations_dir = pathlib.Path(__file__).parent / "migrations"
    engine = get_engine(instance)
    async with engine.begin() as conn:
        await conn.execute(
            text(
                "CREATE TABLE IF NOT EXISTS _ciac_migrations ("
                "name TEXT PRIMARY KEY, applied_at TIMESTAMPTZ NOT NULL DEFAULT now())"
            )
        )
        result = await conn.execute(text("SELECT name FROM _ciac_migrations"))
        applied = {row[0] for row in result}

    for path in sorted(migrations_dir.glob("*.sql")):
        if path.name in applied:
            continue
        statements = [s.strip() for s in path.read_text().split(";\n") if s.strip()]
        async with engine.begin() as conn:
            for statement in statements:
                await conn.execute(text(statement))
            await conn.execute(
                text("INSERT INTO _ciac_migrations (name) VALUES (:name)"),
                {"name": path.name},
            )
{%- endif %}
