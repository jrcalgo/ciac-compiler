async def _sleep_until_next() -> None:
    now = datetime.now(timezone.utc)
    next_fire = croniter(SCHEDULE, now).get_next(datetime)
    if next_fire.tzinfo is None:
        next_fire = next_fire.replace(tzinfo=timezone.utc)
    await asyncio.sleep(max(0.0, (next_fire - now).total_seconds()))


async def run() -> None:
    """Runs this scheduled job forever."""
    while True:
        await _sleep_until_next()
        try:
            await handle_tick_once()
        except Exception:
            logger.exception("scheduled job {{ job.name }} failed")
