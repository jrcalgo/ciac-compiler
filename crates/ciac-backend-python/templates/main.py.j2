{%- if c.schema_key_args %}
{%- for key in c.schema_key_args %}
    await create_schema({{ key }})
{%- endfor %}
{%- else %}
    await create_schema()
{%- endif %}
    yield


app = FastAPI(title="{{ c.service_name }}", lifespan=lifespan)
{%- else %}

app = FastAPI(title="{{ c.service_name }}")
{%- endif %}


@app.get("/health")
async def health() -> dict[str, str]:
    return {"status": "ok"}

