[project]
name = "{{ c.package }}"
version = "0.1.0"
description = "Generated by CIaC from `service {{ c.service_name }}`"
requires-python = ">=3.11"
dependencies = [
    "fastapi>=0.115",
    "uvicorn[standard]>=0.30",
    "pydantic-settings>=2.4",
{%- if c.has_db %}
    "sqlalchemy[asyncio]>=2.0",
{%- endif %}
{%- if c.has_postgres_db %}
    "asyncpg>=0.29",
{%- endif %}
{%- if c.has_mysql_db %}
    "aiomysql>=0.2",
    "cryptography>=41",
{%- endif %}
{%- if c.has_sqlite_db %}
    "aiosqlite>=0.20",
{%- endif %}
{%- if c.has_cache %}
    "redis>=5.0",
{%- endif %}
{%- if c.queue_engine == "kafka" %}
    "aiokafka>=0.11",
{%- elif c.has_queue %}
    "nats-py>=2.7",
{%- endif %}
{%- if c.jobs %}
    "croniter>=6.0",
{%- endif %}
{%- if c.has_object_store %}
    "aioboto3>=13.0",
{%- endif %}
{%- if c.has_email %}
    "aiosmtplib>=3.0",
{%- endif %}
{%- if c.has_search %}
    "opensearch-py>=2.6",
{%- endif %}
{%- if c.has_external_http or c.call_targets %}
    "httpx>=0.27",
{%- endif %}
{%- if c.auth_scheme == "oauth2" %}
    "pyjwt[crypto]>=2.8",
{%- elif c.has_auth %}
    "pyjwt>=2.8",
{%- endif %}
{%- if c.has_logging %}
    "structlog>=24.1",
{%- endif %}
{%- if c.has_metrics %}
    "prometheus-client>=0.20",
{%- endif %}
{%- if c.has_tracing %}
    "opentelemetry-sdk>=1.27",
    "opentelemetry-exporter-otlp-proto-grpc>=1.27",
    "opentelemetry-instrumentation-fastapi>=0.48b0",
    "opentelemetry-instrumentation-httpx>=0.48b0",
{%- if c.has_db %}
    "opentelemetry-instrumentation-sqlalchemy>=0.48b0",
{%- endif %}
{%- endif %}
]

[dependency-groups]
dev = [
    "pytest>=8.0",
    "anyio>=4.4",
    "httpx>=0.27",
    "ruff>=0.6",
]

[tool.uv]
package = false

[tool.pytest.ini_options]
# tests/system/ needs the compose stack up and is run only by
# `ciac verify --system` (from its own directory); plain `pytest`
# must never collect it.
norecursedirs = ["tests/system"]

[tool.ruff]
target-version = "py311"

[tool.ruff.lint]
# Pinned explicitly, not left to ruff's own default: `ruff>=0.6`
# above has no upper bound, and a newer ruff resolved at generation
# time silently expanded its defaults (bugbear, isort, pyupgrade
# style checks) past what these templates were written to satisfy,
# breaking `ciac verify` on every fresh project (v0.29 M1 finding
# F4). This is ruff's own long-documented default selection --
# pinning it here makes the templates immune to ruff's own default
# ever moving again.
select = ["E4", "E7", "E9", "F"]
