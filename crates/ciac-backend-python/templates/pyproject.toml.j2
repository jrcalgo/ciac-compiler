[project]
name = "{{ c.package }}"
version = "0.1.0"
description = "Generated by CIaC from `service {{ c.service_name }}`"
requires-python = ">=3.11"
dependencies = [
    "fastapi>=0.115",
    "uvicorn[standard]>=0.30",
    "pydantic-settings>=2.4",
{%- if c.has_db %}
    "sqlalchemy[asyncio]>=2.0",
    "asyncpg>=0.29",
{%- endif %}
{%- if c.has_cache %}
    "redis>=5.0",
{%- endif %}
{%- if c.has_queue %}
    "nats-py>=2.7",
{%- endif %}
{%- if c.has_object_store %}
    "aioboto3>=13.0",
{%- endif %}
{%- if c.has_email %}
    "aiosmtplib>=3.0",
{%- endif %}
{%- if c.has_search %}
    "opensearch-py>=2.6",
{%- endif %}
{%- if c.has_external_http or c.call_targets %}
    "httpx>=0.27",
{%- endif %}
{%- if c.has_auth %}
    "pyjwt>=2.8",
{%- endif %}
{%- if c.has_logging %}
    "structlog>=24.1",
{%- endif %}
{%- if c.has_metrics %}
    "prometheus-client>=0.20",
{%- endif %}
]

[dependency-groups]
dev = [
    "pytest>=8.0",
    "anyio>=4.4",
    "httpx>=0.27",
    "ruff>=0.6",
]

[tool.uv]
package = false

[tool.ruff]
target-version = "py311"
