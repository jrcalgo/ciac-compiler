{%- if c.queue_engine == "kafka" -%}
"""Kafka queue access. Generated by CIaC.

`publish` pipeline steps send JSON payloads to their stream's topic;
workers consume their bound topic in per-worker consumer groups (see
`app/workers/`). The producer is started lazily on first publish.
"""

import json
from typing import Any

from aiokafka import AIOKafkaProducer
{%- if c.has_tracing %}
from opentelemetry.propagate import inject
{%- endif %}

from app.config import get_settings
from app.state import current


async def get_producer() -> AIOKafkaProducer:
    state = current()
    if state.queue_client is None:
        state.queue_client = AIOKafkaProducer(bootstrap_servers=get_settings().kafka_url)
        await state.queue_client.start()
    return state.queue_client


async def publish(subject: str, payload: dict[str, Any]) -> None:
    if current().world is not None:
        # v0.17 M5: the checkpoint's minimal broker port.
        await current().world.publish(subject, payload)
        return
    producer = await get_producer()
{%- if c.has_tracing %}
    carrier: dict[str, str] = {}
    inject(carrier)
    headers = [(k, v.encode()) for k, v in carrier.items()]
    await producer.send_and_wait(subject, json.dumps(payload).encode(), headers=headers)
{%- else %}
    await producer.send_and_wait(subject, json.dumps(payload).encode())
{%- endif %}
{%- else -%}
"""NATS queue access. Generated by CIaC.

`publish` pipeline steps send JSON payloads to their stream's subject;
workers consume their bound stream in per-worker queue groups (see
`app/workers/`). The connection is established lazily on first publish.
"""

import json
from typing import Any

import nats
from nats.aio.client import Client
{%- if c.has_tracing %}
from opentelemetry.propagate import inject
{%- endif %}

from app.config import get_settings
from app.state import current


async def get_client() -> Client:
    state = current()
    if state.queue_client is None or state.queue_client.is_closed:
        state.queue_client = await nats.connect(get_settings().nats_url)
    return state.queue_client


async def publish(subject: str, payload: dict[str, Any]) -> None:
    if current().world is not None:
        # v0.17 M5: the checkpoint's minimal broker port.
        await current().world.publish(subject, payload)
        return
    client = await get_client()
{%- if c.has_tracing %}
    headers: dict[str, str] = {}
    inject(headers)
    await client.publish(subject, json.dumps(payload).encode(), headers=headers)
{%- else %}
    await client.publish(subject, json.dumps(payload).encode())
{%- endif %}

{%- endif %}
