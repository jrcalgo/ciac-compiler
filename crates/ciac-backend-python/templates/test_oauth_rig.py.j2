"""The no-infra OAuth2 scope rig. Generated by CIaC (`26UpdatePlan.md`
M4). Real RS256 signing against a real (if tiny) in-process JWKS
server -- `conftest.py` starts the stub and points `OAUTH_ISSUER` at
it before this module (or `app.main`) is ever imported, so the
`require_auth`/`require_scope` dependencies under test run their exact
production code path: fetch JWKS, match `kid`, verify a real
signature, check `iss`/`aud`/`exp`. No live identity provider is
involved; the crypto is real, not the issuer.
"""

import time

import httpx
import jwt
import pytest

from app.config import get_settings
from app.main import app
from conftest import OAUTH_KID, OAUTH_PRIVATE_KEY_PEM, OAUTH_WRONG_KEY_PEM


def _client(*, raise_app_exceptions: bool = True) -> httpx.AsyncClient:
    transport = httpx.ASGITransport(app=app, raise_app_exceptions=raise_app_exceptions)
    return httpx.AsyncClient(transport=transport, base_url="http://test")


def _mint(
    scope: str,
    *,
    key_pem: str = OAUTH_PRIVATE_KEY_PEM,
    kid: str = OAUTH_KID,
    issuer: str | None = None,
    exp_delta: int = 3600,
) -> dict[str, str]:
    settings = get_settings()
    claims: dict[str, object] = {
        "sub": "test",
        "scope": scope,
        "iss": issuer if issuer is not None else settings.oauth_issuer,
        "exp": int(time.time()) + exp_delta,
    }
    if settings.oauth_audience:
        claims["aud"] = settings.oauth_audience
    token = jwt.encode(claims, key_pem, algorithm="RS256", headers={"kid": kid})
    return {"Authorization": f"Bearer {token}"}
{% for api in c.apis %}
{%- if api.scope %}


@pytest.mark.anyio
async def test_{{ api.snake }}_wrong_scope() -> None:
    async with _client() as client:
{%- if api.has_body %}
        response = await client.{{ api.method_lower }}(
            "{{ api.route }}", json={}, headers=_mint("not:{{ api.scope }}")
        )
{%- else %}
        response = await client.{{ api.method_lower }}("{{ api.route }}", headers=_mint("not:{{ api.scope }}"))
{%- endif %}
    assert response.status_code == 403


@pytest.mark.anyio
async def test_{{ api.snake }}_correct_scope() -> None:
    async with _client(raise_app_exceptions=False) as client:
{%- if api.has_body %}
        response = await client.{{ api.method_lower }}(
            "{{ api.route }}", json={}, headers=_mint("{{ api.scope }}")
        )
{%- else %}
        response = await client.{{ api.method_lower }}("{{ api.route }}", headers=_mint("{{ api.scope }}"))
{%- endif %}
    assert response.status_code not in (401, 403)


@pytest.mark.anyio
async def test_{{ api.snake }}_expired_token() -> None:
    async with _client() as client:
{%- if api.has_body %}
        response = await client.{{ api.method_lower }}(
            "{{ api.route }}", json={}, headers=_mint("{{ api.scope }}", exp_delta=-3600)
        )
{%- else %}
        response = await client.{{ api.method_lower }}(
            "{{ api.route }}", headers=_mint("{{ api.scope }}", exp_delta=-3600)
        )
{%- endif %}
    assert response.status_code == 401


@pytest.mark.anyio
async def test_{{ api.snake }}_wrong_key() -> None:
    # The crypto-boundary case the JWT suite cannot express as sharply:
    # a correctly-shaped, correctly-`kid`'d token signed by a key the
    # stub JWKS never served -- proof the signature check itself gates
    # the door, not just claim shape or `kid` lookup.
    async with _client() as client:
{%- if api.has_body %}
        response = await client.{{ api.method_lower }}(
            "{{ api.route }}", json={}, headers=_mint("{{ api.scope }}", key_pem=OAUTH_WRONG_KEY_PEM)
        )
{%- else %}
        response = await client.{{ api.method_lower }}(
            "{{ api.route }}", headers=_mint("{{ api.scope }}", key_pem=OAUTH_WRONG_KEY_PEM)
        )
{%- endif %}
    assert response.status_code == 401


@pytest.mark.anyio
async def test_{{ api.snake }}_wrong_issuer() -> None:
    async with _client() as client:
{%- if api.has_body %}
        response = await client.{{ api.method_lower }}(
            "{{ api.route }}", json={}, headers=_mint("{{ api.scope }}", issuer="http://wrong-issuer.example")
        )
{%- else %}
        response = await client.{{ api.method_lower }}(
            "{{ api.route }}", headers=_mint("{{ api.scope }}", issuer="http://wrong-issuer.example")
        )
{%- endif %}
    assert response.status_code == 401
{%- endif %}
{%- endfor %}
