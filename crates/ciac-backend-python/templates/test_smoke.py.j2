{%- if api.has_auth_step %}

@pytest.mark.anyio
async def test_{{ api.snake }}_no_token() -> None:
    async with _client() as client:
{%- if api.has_body %}
        response = await client.{{ api.method_lower }}("{{ api.route }}", json={})
{%- else %}
        response = await client.{{ api.method_lower }}("{{ api.route }}")
{%- endif %}
    assert response.status_code in (401, 403)


@pytest.mark.anyio
async def test_{{ api.snake }}_malformed_token() -> None:
    # `26UpdatePlan.md` M4: a case matrix entry the JWT suite alone
    # never distinguished from `no_token` — both schemes' decoders
    # reject an unparseable bearer value the same way.
    async with _client() as client:
{%- if api.has_body %}
        response = await client.{{ api.method_lower }}(
            "{{ api.route }}", json={}, headers={"Authorization": "Bearer not-a-jwt"}
        )
{%- else %}
        response = await client.{{ api.method_lower }}(
            "{{ api.route }}", headers={"Authorization": "Bearer not-a-jwt"}
        )
{%- endif %}
    assert response.status_code == 401
{%- if api.scope and c.auth_scheme == "jwt" %}


@pytest.mark.anyio
async def test_{{ api.snake }}_wrong_scope() -> None:
    async with _client() as client:
{%- if api.has_body %}
        response = await client.{{ api.method_lower }}(
            "{{ api.route }}", json={}, headers=_bearer("not:{{ api.scope }}")
        )
{%- else %}
        response = await client.{{ api.method_lower }}("{{ api.route }}", headers=_bearer("not:{{ api.scope }}"))
{%- endif %}
    assert response.status_code == 403


@pytest.mark.anyio
async def test_{{ api.snake }}_correct_scope() -> None:
    # `raise_app_exceptions=False`: a granted-scope request clears the
    # auth dependency and reaches the route body, which may then fail
    # on a real dependency this no-infra suite doesn't have (a live
    # db/cache/queue) — that failure becomes a 5xx, still proof the
    # auth layer itself let the request through.
    async with _client(raise_app_exceptions=False) as client:
{%- if api.has_body %}
        response = await client.{{ api.method_lower }}(
            "{{ api.route }}", json={}, headers=_bearer("{{ api.scope }}")
        )
{%- else %}
        response = await client.{{ api.method_lower }}("{{ api.route }}", headers=_bearer("{{ api.scope }}"))
{%- endif %}
    assert response.status_code not in (401, 403)


@pytest.mark.anyio
async def test_{{ api.snake }}_expired_token() -> None:
    async with _client() as client:
{%- if api.has_body %}
        response = await client.{{ api.method_lower }}(
            "{{ api.route }}", json={}, headers=_bearer("{{ api.scope }}", exp_delta=-3600)
        )
{%- else %}
        response = await client.{{ api.method_lower }}(
            "{{ api.route }}", headers=_bearer("{{ api.scope }}", exp_delta=-3600)
        )
{%- endif %}
    assert response.status_code == 401
{%- endif %}
