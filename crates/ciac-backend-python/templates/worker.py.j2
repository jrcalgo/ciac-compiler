"""Worker pipeline for `worker {{ worker.name }}`. Generated by CIaC.

Consumes `{{ worker.subject }}` in queue group `{{ worker.queue_group }}`
so replicas of this worker load-balance messages between them.
"""
{%- macro emit_steps(steps, indent) -%}
{%- for step in steps %}
{%- if step.kind == "handler" %}
{{ indent }}result = await {{ step.handler.class_name }}({{ step.handler.py_args }}).handle(result)
{%- elif step.kind == "publish" %}
{%- if worker.payload %}
{{ indent }}await publish("{{ step.subject }}", result.model_dump(mode="json"))
{%- else %}
{{ indent }}await publish("{{ step.subject }}", result)
{%- endif %}
{%- elif step.kind == "call" %}
{{ indent }}result = await {{ step.call.class_name }}().{{ step.call.method }}(result)
{%- elif step.kind == "match" %}
{%- for arm in step.arms %}
{%- if loop.first and arm.label %}
{{ indent }}if result.{{ step.field }} == "{{ arm.label }}":
{%- elif arm.label %}
{{ indent }}elif result.{{ step.field }} == "{{ arm.label }}":
{%- else %}
{{ indent }}else:
{%- endif %}
{{ emit_steps(arm.steps, indent ~ "    ") }}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endmacro %}

import asyncio
import logging
{% if not worker.payload -%}
import json
from typing import Any

{% endif -%}
{%- if c.queue_engine == "kafka" %}
from aiokafka import AIOKafkaConsumer
{%- else %}
import nats
{%- endif %}

from app.config import get_settings
{%- if worker.needs_cache %}
from app.cache import get_cache
{%- endif %}
{%- for call in worker.call_imports %}
from app.clients.{{ call.module }} import {{ call.class_name }}
{%- endfor %}
{%- if worker.needs_db %}
from app.db import get_sessionmaker
{%- endif %}
{%- for imp in worker.extra_imports %}
from app.{{ imp.py_module }} import {{ imp.py_getter }}
{%- endfor %}
{%- if worker.has_publish_step %}
from app.queue import publish
{%- endif %}
{%- if worker.payload %}
from app.schemas import {{ worker.payload.class_name }}
{%- endif %}
{%- for handler in worker.handlers %}
from app.{{ handler.handler_package }}.{{ handler.module }} import {{ handler.class_name }}
{%- endfor %}

SUBJECT = "{{ worker.subject }}"
QUEUE_GROUP = "{{ worker.queue_group }}"
CONCURRENCY = {{ worker.concurrency }}
MAX_RETRIES = {{ worker.max_retries }}
logger = logging.getLogger(__name__)

{% set payload_type = worker.payload.class_name if worker.payload else "dict[str, Any]" %}

async def handle_message_once(payload: {{ payload_type }}) -> None:
{%- if not worker.steps %}
    _ = payload  # TODO: process messages consumed by {{ worker.name }}.
{%- else %}
{%- if worker.payload %}
    result = payload
{%- else %}
    result = dict(payload)
{%- endif %}
{%- if worker.needs_db %}
    async with {{ worker.session_with }}:
{{ emit_steps(worker.steps, "        ") }}
{%- else %}
{{ emit_steps(worker.steps, "    ") }}
{%- endif %}
{%- endif %}


async def handle_message(payload: {{ payload_type }}) -> None:
    for attempt in range(MAX_RETRIES + 1):
        try:
            await handle_message_once(payload)
            return
        except Exception:
            if attempt >= MAX_RETRIES:
                logger.exception("message processing failed after retries")
                return
            logger.warning("message processing failed; retrying", exc_info=True)


async def _consume(worker_index: int) -> None:
{%- if c.queue_engine == "kafka" %}
    consumer = AIOKafkaConsumer(
        SUBJECT,
        group_id=QUEUE_GROUP,
        bootstrap_servers=get_settings().kafka_url,
    )
    await consumer.start()
    logger.info("worker {{ worker.name }} consumer %s subscribed", worker_index)
    try:
        async for message in consumer:
{%- if worker.payload %}
            await handle_message({{ worker.payload.class_name }}.model_validate_json(message.value))
{%- else %}
            await handle_message(json.loads(message.value))
{%- endif %}
    finally:
        await consumer.stop()
{%- else %}
    client = await nats.connect(get_settings().nats_url)
    subscription = await client.subscribe(SUBJECT, queue=QUEUE_GROUP)
    logger.info("worker {{ worker.name }} consumer %s subscribed", worker_index)
    async for message in subscription.messages:
{%- if worker.payload %}
        await handle_message({{ worker.payload.class_name }}.model_validate_json(message.data))
{%- else %}
        await handle_message(json.loads(message.data))
{%- endif %}
{%- endif %}


async def run() -> None:
    """Subscribes and processes messages forever."""
    await asyncio.gather(*(_consume(idx) for idx in range(CONCURRENCY)))
