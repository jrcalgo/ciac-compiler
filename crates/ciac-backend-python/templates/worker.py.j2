"""Worker pipeline for `worker {{ worker.name }}`. Generated by CIaC.

Consumes `{{ worker.subject }}` in queue group `{{ worker.queue_group }}`
so replicas of this worker load-balance messages between them.
"""

{% if not worker.payload -%}
import json
from typing import Any

{% endif -%}
import nats

from app.config import get_settings
{%- if worker.needs_cache %}
from app.cache import get_cache
{%- endif %}
{%- if worker.needs_db %}
from app.db import get_sessionmaker
{%- endif %}
{%- if worker.has_publish_step %}
from app.queue import publish
{%- endif %}
{%- if worker.payload %}
from app.schemas import {{ worker.payload.class_name }}
{%- endif %}
{%- for handler in worker.handlers %}
from app.services.{{ handler.module }} import {{ handler.class_name }}
{%- endfor %}

SUBJECT = "{{ worker.subject }}"
QUEUE_GROUP = "{{ worker.queue_group }}"

{% set payload_type = worker.payload.class_name if worker.payload else "dict[str, Any]" %}

async def handle_message(payload: {{ payload_type }}) -> None:
{%- if not worker.steps %}
    _ = payload  # TODO: process messages consumed by {{ worker.name }}.
{%- else %}
{%- if worker.payload %}
    result = payload
{%- else %}
    result = dict(payload)
{%- endif %}
{%- if worker.needs_db %}
    async with get_sessionmaker()() as session:
{%- for step in worker.steps %}
{%- if step.kind == "handler" %}
        result = await {{ step.handler.class_name }}(
            {%- if step.handler.needs_db %}session=session{% endif %}
            {%- if step.handler.needs_db and step.handler.needs_cache %}, {% endif %}
            {%- if step.handler.needs_cache %}cache=get_cache(){% endif -%}
        ).handle(result)
{%- elif step.kind == "publish" %}
{%- if worker.payload %}
        await publish("{{ step.subject }}", result.model_dump(mode="json"))
{%- else %}
        await publish("{{ step.subject }}", result)
{%- endif %}
{%- endif %}
{%- endfor %}
{%- else %}
{%- for step in worker.steps %}
{%- if step.kind == "handler" %}
    result = await {{ step.handler.class_name }}(
        {%- if step.handler.needs_cache %}cache=get_cache(){% endif -%}
    ).handle(result)
{%- elif step.kind == "publish" %}
{%- if worker.payload %}
    await publish("{{ step.subject }}", result.model_dump(mode="json"))
{%- else %}
    await publish("{{ step.subject }}", result)
{%- endif %}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endif %}


async def run() -> None:
    """Subscribes and processes messages forever."""
    client = await nats.connect(get_settings().nats_url)
    subscription = await client.subscribe(SUBJECT, queue=QUEUE_GROUP)
    async for message in subscription.messages:
{%- if worker.payload %}
        await handle_message({{ worker.payload.class_name }}.model_validate_json(message.data))
{%- else %}
        await handle_message(json.loads(message.data))
{%- endif %}
