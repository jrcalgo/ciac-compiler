[package]
name = "{{ c.package }}"
version = "0.1.0"
edition = "2021"
description = "Generated by CIaC from `service {{ c.service_name }}`"

[dependencies]
anyhow = "1"
{%- if c.channels %}
axum = { version = "0.8", features = ["ws"] }
{%- else %}
axum = "0.8"
{%- endif %}
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["full"] }
tracing = "0.1"
{%- if c.has_logging %}
tracing-subscriber = { version = "0.3", features = ["env-filter", "json"] }
{%- else %}
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
{%- endif %}
{%- if c.records_use_datetime or c.jobs %}
chrono = { version = "0.4", features = ["serde"] }
{%- endif %}
{%- if c.jobs %}
cron = "0.12"
{%- endif %}
{%- if c.has_db %}
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "postgres", "json"] }
{%- endif %}
{%- if c.has_cache %}
redis = { version = "0.27", features = ["tokio-comp"] }
{%- endif %}
{%- if c.has_queue %}
async-nats = "0.38"
futures = "0.3"
{%- endif %}
{%- if c.channels %}
async-stream = "0.3"
{%- endif %}
{%- if c.has_auth %}
jsonwebtoken = "9"
{%- endif %}
{%- if c.has_object_store %}
rust-s3 = "0.35"
{%- endif %}
{%- if c.has_email %}
lettre = { version = "0.11", default-features = false, features = ["builder", "hostname", "pool", "smtp-transport", "tokio1", "tokio1-rustls-tls"] }
{%- endif %}
{%- if c.has_search %}
opensearch = "2"
{%- endif %}
{%- if c.has_external_http or c.call_targets %}
reqwest = { version = "0.12", features = ["json"] }
{%- endif %}
{%- if c.resources %}
uuid = { version = "1", features = ["v4"] }
{%- endif %}
{%- if c.has_metrics %}
metrics-exporter-prometheus = "0.16"
{%- endif %}
