[package]
name = "{{ c.package }}"
version = "0.1.0"
edition = "2021"
description = "Generated by CIaC from `service {{ c.service_name }}`"

[dependencies]
anyhow = "1"
{%- if c.channels %}
axum = { version = "0.8", features = ["ws"] }
{%- else %}
axum = "0.8"
{%- endif %}
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["full"] }
tracing = "0.1"
{%- if c.has_logging %}
tracing-subscriber = { version = "0.3", features = ["env-filter", "json"] }
{%- else %}
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
{%- endif %}
{%- if c.records_use_datetime or c.jobs or needs_chrono_crate or c.has_db or c.has_queue or c.has_cache or c.has_object_store or c.has_email or c.has_search or c.has_external_http or c.has_auth or c.call_targets %}
chrono = { version = "0.4", features = ["serde"] }
{%- endif %}
{%- if c.has_db or c.has_queue or c.has_cache or c.has_object_store or c.has_email or c.has_search or c.has_external_http or c.has_auth or c.call_targets %}
# 27UpdatePlan.md M4: `src/bin/sim_runner.rs` decodes `given.store`'s
# `value_base64` (the scenario schema's own binary-payload encoding)
# regardless of which capabilities this particular service declares --
# the runner is generic over the whole scenario schema.
base64 = "0.22"
{%- if multi %}
# 28UpdatePlan.md M6b: the vendored simulation modules (`clock`/
# `failure`/`scenario`/`world`/`cron`), shared with every other service
# in this system and the system-runner crate so `SimWorld` is one
# nominal type across all of them, not one private copy per crate.
sim-shared = { path = "../sim-shared" }
{%- endif %}
{%- endif %}
{%- if c.jobs %}
cron = "0.12"
{%- endif %}
{%- if c.has_db %}
sqlx = { version = "0.8", features = ["runtime-tokio-rustls"{% if c.has_postgres_db %}, "postgres"{% endif %}{% if c.has_mysql_db %}, "mysql"{% endif %}{% if c.has_sqlite_db %}, "sqlite"{% endif %}, "json"] }
{%- endif %}
{%- if c.has_cache %}
redis = { version = "0.27", features = ["tokio-comp"] }
{%- endif %}
{%- if c.has_queue %}
{%- if c.queue_engine == "kafka" %}
# Vendored librdkafka (cmake-build): full consumer-group semantics at
# the cost of a native build chain — cmake is required (the generated
# Dockerfile installs it; see its build stage). rdkafka-sys is pinned
# to =4.7.0 (librdkafka 2.3.0): newer vendored librdkafkas (2.12.x)
# demand libcurl dev headers even with WITH_CURL=0.
rdkafka = { version = "0.36", features = ["cmake-build", "tokio", "libz-static"] }
rdkafka-sys = { version = "=4.7.0", features = ["cmake-build", "libz-static"] }
{%- else %}
async-nats = "0.38"
{%- endif %}
futures = "0.3"
{%- endif %}
{%- if c.channels %}
async-stream = "0.3"
{%- endif %}
{%- if c.has_auth %}
jsonwebtoken = "9"
{%- endif %}
{%- if c.has_object_store %}
rust-s3 = "0.35"
{%- endif %}
{%- if c.has_email %}
lettre = { version = "0.11", default-features = false, features = ["builder", "hostname", "pool", "smtp-transport", "tokio1", "tokio1-rustls-tls"] }
{%- endif %}
{%- if c.has_search %}
opensearch = "2"
{%- endif %}
{%- if c.has_external_http or c.call_targets or c.auth_scheme == "oauth2" %}
reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls"] }
{%- endif %}
{%- if c.resources or needs_uuid_crate or (c.channels and c.queue_engine == "kafka") %}
uuid = { version = "1", features = ["v4"] }
{%- endif %}
{%- if c.has_metrics %}
metrics-exporter-prometheus = "0.16"
{%- endif %}
{%- if c.has_tracing %}
opentelemetry = "0.32"
opentelemetry_sdk = { version = "0.32", features = ["rt-tokio"] }
opentelemetry-otlp = { version = "0.32", features = ["grpc-tonic"] }
opentelemetry-http = "0.32"
tracing-opentelemetry = "0.33"
tower-http = { version = "0.6", features = ["trace"] }
{%- endif %}
{%- if needs_thiserror %}
thiserror = "2"
{%- endif %}
{%- if c.has_db or c.has_queue or c.has_cache or c.has_object_store or c.has_email or c.has_search or c.has_external_http or c.has_auth or c.call_targets %}
# v0.17 M11: `src/bin/sim_runner.rs` drives `routes::router()` through
# `tower::ServiceExt::oneshot` (no live listener), so this needs to be a
# real dependency, not the dev-only one below (which folds into this
# condition rather than duplicating the crate when both apply).
tower = { version = "0.5", features = ["util"] }
{%- endif %}
{%- if (c.auth_scheme == "jwt" or c.auth_scheme == "oauth2") and c.scopes and not (c.has_db or c.has_queue or c.has_cache or c.has_object_store or c.has_email or c.has_search or c.has_external_http or c.has_auth or c.call_targets) %}

[dev-dependencies]
tower = { version = "0.5", features = ["util"] }
{%- endif %}
