use axum::extract::State;
use axum::response::sse::{Event, Sse};
use axum::routing::get;
use axum::Router;
use std::convert::Infallible;

pub fn router() -> Router<AppState> {
    Router::new().route("{{ channel.path }}", get({{ channel.snake }}))
}

async fn {{ channel.snake }}(
    State(state): State<AppState>,
) -> Sse<impl futures::Stream<Item = Result<Event, Infallible>>> {
    let stream = async_stream::stream! {
{%- if c.queue_engine == "kafka" %}
        use rdkafka::Message as _;
        // Fan-out: every connection gets its own consumer group, so
        // each subscriber sees every message (Kafka's group semantics
        // would otherwise load-balance them like a worker).
        let group = format!("channel-{{ channel.snake }}-{}", uuid::Uuid::new_v4());
        if let Ok(consumer) = state.queue.consumer(&state.config.kafka_url, SUBJECT, &group) {
            while let Ok(message) = consumer.recv().await {
                if let Some(data) = message.payload().and_then(payload_text) {
                    yield Ok(Event::default().data(data));
                }
            }
        }
{%- else %}
        if let Ok(mut subscription) = state.queue.subscribe(SUBJECT).await {
            while let Some(message) = subscription.next().await {
                if let Some(data) = payload_text(&message.payload) {
                    yield Ok(Event::default().data(data));
                }
            }
        }
{%- endif %}
    };
    Sse::new(stream)
}
