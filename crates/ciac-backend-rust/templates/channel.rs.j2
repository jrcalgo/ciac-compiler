{% if c.queue_engine == "kafka" -%}
async fn stream(mut socket: WebSocket, state: AppState) {
    use rdkafka::Message as _;
    // Fan-out: a unique consumer group per connection (see the SSE
    // variant for why).
    let group = format!("channel-{{ channel.snake }}-{}", uuid::Uuid::new_v4());
    let Ok(consumer) = state.queue.consumer(&state.config.kafka_url, SUBJECT, &group) else {
        return;
    };
    while let Ok(message) = consumer.recv().await {
        let Some(data) = message.payload().and_then(payload_text) else {
            continue;
        };
        if socket.send(Message::Text(data.into())).await.is_err() {
            break;
        }
    }
}
{%- else -%}
