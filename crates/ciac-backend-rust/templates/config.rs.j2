//! Runtime configuration for {{ c.service_name }}. Generated by CIaC.
//!
//! Every value can be overridden through the environment, e.g.
//! `DATABASE_URL`; defaults target local development.

#[derive(Debug, Clone)]
pub struct Config {
{%- for inst in c.db_instances %}
    pub {{ inst.url_field }}: String,
{%- endfor %}
{%- for inst in c.cache_instances %}
    pub {{ inst.url_field }}: String,
{%- endfor %}
{%- for inst in c.object_store_instances %}
{%- for f in inst.cfg %}
    pub {{ f.field }}: String,
{%- endfor %}
{%- endfor %}
{%- for inst in c.email_instances %}
{%- for f in inst.cfg %}
    pub {{ f.field }}: String,
{%- endfor %}
{%- endfor %}
{%- for inst in c.search_instances %}
{%- for f in inst.cfg %}
    pub {{ f.field }}: String,
{%- endfor %}
{%- endfor %}
{%- for inst in c.external_http_instances %}
{%- for f in inst.cfg %}
    pub {{ f.field }}: String,
{%- endfor %}
{%- endfor %}
{%- for t in c.call_targets %}
    pub {{ t.url_field }}: String,
{%- endfor %}
{%- if c.has_queue %}
{%- if c.queue_engine == "kafka" %}
    pub kafka_url: String,
{%- else %}
    pub nats_url: String,
{%- endif %}
{%- endif %}
{%- if c.has_auth %}
{%- if c.auth_scheme == "oauth2" %}
    pub oauth_issuer: String,
    pub oauth_audience: String,
{%- else %}
    pub jwt_secret: String,
{%- endif %}
{%- endif %}
}

impl Config {
    pub fn from_env() -> Self {
        Self {
{%- for inst in c.db_instances %}
{%- if inst.db_engine == "mysql" %}
            {{ inst.url_field }}: env_or(
                "{{ inst.env_var }}",
                "mysql://root:root@localhost:3306/{{ inst.db_name }}",
            ),
{%- else %}
            {{ inst.url_field }}: env_or(
                "{{ inst.env_var }}",
                "postgres://postgres:postgres@localhost:5432/{{ inst.db_name }}",
            ),
{%- endif %}
{%- endfor %}
{%- for inst in c.cache_instances %}
            {{ inst.url_field }}: env_or("{{ inst.env_var }}", "redis://localhost:6379/{{ inst.redis_db }}"),
{%- endfor %}
{%- for inst in c.object_store_instances %}
{%- for f in inst.cfg %}
            {{ f.field }}: env_or("{{ f.env }}", "{{ f.rust_default }}"),
{%- endfor %}
{%- endfor %}
{%- for inst in c.email_instances %}
{%- for f in inst.cfg %}
            {{ f.field }}: env_or("{{ f.env }}", "{{ f.rust_default }}"),
{%- endfor %}
{%- endfor %}
{%- for inst in c.search_instances %}
{%- for f in inst.cfg %}
            {{ f.field }}: env_or("{{ f.env }}", "{{ f.rust_default }}"),
{%- endfor %}
{%- endfor %}
{%- for inst in c.external_http_instances %}
{%- for f in inst.cfg %}
            {{ f.field }}: env_or("{{ f.env }}", "{{ f.rust_default }}"),
{%- endfor %}
{%- endfor %}
{%- for t in c.call_targets %}
            {{ t.url_field }}: env_or("{{ t.env_var }}", "{{ t.default_url }}"),
{%- endfor %}
{%- if c.has_queue %}
{%- if c.queue_engine == "kafka" %}
            kafka_url: env_or("KAFKA_URL", "localhost:9092"),
{%- else %}
            nats_url: env_or("NATS_URL", "nats://localhost:4222"),
{%- endif %}
{%- endif %}
{%- if c.has_auth %}
{%- if c.auth_scheme == "oauth2" %}
            oauth_issuer: env_or("OAUTH_ISSUER", "{{ c.auth_issuer }}"),
            oauth_audience: env_or("OAUTH_AUDIENCE", "{{ c.auth_audience }}"),
{%- else %}
            jwt_secret: env_or("JWT_SECRET", "change-me"),
{%- endif %}
{%- endif %}
        }
    }
}

{% if c.has_db or c.has_cache or c.has_queue or c.has_auth or c.has_object_store or c.has_email or c.has_search or c.has_external_http or c.call_targets -%}
fn env_or(key: &str, default: &str) -> String {
    std::env::var(key).unwrap_or_else(|_| default.to_owned())
}
{%- endif %}
