//! Runtime configuration for {{ c.service_name }}. Generated by CIaC.
//!
//! Every value can be overridden through the environment, e.g.
//! `DATABASE_URL`; defaults target local development.

#[derive(Debug, Clone)]
pub struct Config {
{%- for inst in c.db_instances %}
    pub {{ inst.url_field }}: String,
{%- endfor %}
{%- for inst in c.cache_instances %}
    pub {{ inst.url_field }}: String,
{%- endfor %}
{%- if c.has_queue %}
    pub nats_url: String,
{%- endif %}
{%- if c.has_auth %}
    pub jwt_secret: String,
{%- endif %}
}

impl Config {
    pub fn from_env() -> Self {
        Self {
{%- for inst in c.db_instances %}
            {{ inst.url_field }}: env_or(
                "{{ inst.env_var }}",
                "postgres://postgres:postgres@localhost:5432/{{ inst.db_name }}",
            ),
{%- endfor %}
{%- for inst in c.cache_instances %}
            {{ inst.url_field }}: env_or("{{ inst.env_var }}", "redis://localhost:6379/{{ inst.redis_db }}"),
{%- endfor %}
{%- if c.has_queue %}
            nats_url: env_or("NATS_URL", "nats://localhost:4222"),
{%- endif %}
{%- if c.has_auth %}
            jwt_secret: env_or("JWT_SECRET", "change-me"),
{%- endif %}
        }
    }
}

{% if c.has_db or c.has_cache or c.has_queue or c.has_auth -%}
fn env_or(key: &str, default: &str) -> String {
    std::env::var(key).unwrap_or_else(|_| default.to_owned())
}
{%- endif %}
