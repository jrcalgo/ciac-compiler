use crate::state::AppState;

pub const SUBJECT: &str = "{{ consumer.subject }}";
pub const QUEUE_GROUP: &str = "{{ consumer.queue_group }}";

{% if c.queue_engine == "kafka" -%}
pub async fn run(state: AppState) -> anyhow::Result<()> {
    use rdkafka::Message;
    let consumer = state
        .queue
        .consumer(&state.config.kafka_url, SUBJECT, QUEUE_GROUP)?;
    tracing::info!(subject = SUBJECT, "consumer {{ consumer.name }} listening");
    loop {
        let message = match consumer.recv().await {
            Ok(message) => message,
            Err(err) => {
                tracing::warn!(?err, "kafka receive error");
                continue;
            }
        };
        let Some(bytes) = message.payload() else {
            continue;
        };
        let payload: serde_json::Value = match serde_json::from_slice(bytes) {
            Ok(payload) => payload,
            Err(err) => {
                tracing::warn!(?err, "discarding malformed event");
                continue;
            }
        };
        if let Err(err) = handle_event(&state, payload).await {
            tracing::error!(?err, "event processing failed");
        }
    }
}
{%- else -%}
pub async fn run(state: AppState) -> anyhow::Result<()> {
    let mut subscription = state.queue.queue_subscribe(SUBJECT, QUEUE_GROUP).await?;
    tracing::info!(subject = SUBJECT, "consumer {{ consumer.name }} listening");
    while let Some(message) = subscription.next().await {
        let payload: serde_json::Value = match serde_json::from_slice(&message.payload) {
            Ok(payload) => payload,
            Err(err) => {
                tracing::warn!(?err, "discarding malformed event");
                continue;
            }
        };
        if let Err(err) = handle_event(&state, payload).await {
            tracing::error!(?err, "event processing failed");
        }
    }
    Ok(())
}
{%- endif %}

