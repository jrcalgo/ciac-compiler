//! Event consumer for `events {{ consumer.name }}`. Generated by CIaC.
//!
//! Consumes `{{ consumer.subject }}` in queue group `{{ consumer.queue_group }}`.

use futures::StreamExt;

use crate::state::AppState;

pub const SUBJECT: &str = "{{ consumer.subject }}";
pub const QUEUE_GROUP: &str = "{{ consumer.queue_group }}";

pub async fn run(state: AppState) -> anyhow::Result<()> {
    let mut subscription = state
        .queue
        .queue_subscribe(SUBJECT, QUEUE_GROUP.to_owned())
        .await?;
    tracing::info!(subject = SUBJECT, "consumer {{ consumer.name }} listening");
    while let Some(message) = subscription.next().await {
        let payload: serde_json::Value = match serde_json::from_slice(&message.payload) {
            Ok(payload) => payload,
            Err(err) => {
                tracing::warn!(?err, "discarding malformed event");
                continue;
            }
        };
        if let Err(err) = handle_event(&state, payload).await {
            tracing::error!(?err, "event processing failed");
        }
    }
    Ok(())
}

async fn handle_event(_state: &AppState, payload: serde_json::Value) -> anyhow::Result<()> {
    // TODO: persist or process the {{ consumer.name }} event.
    let _ = payload;
    Ok(())
}
