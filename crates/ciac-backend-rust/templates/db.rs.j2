/// Creates CRUD-resource tables on startup ({{ engine }}). `table`
/// declarations (v0.7) are provisioned by the `migrations/` directory
/// instead, applied via `sqlx::migrate!` at startup (see `main.rs`).
/// The id key is `VARCHAR(36)` (a stringified UUID) rather than
/// `TEXT`: portable to engines that require sized index keys.
pub async fn ensure_schema_{{ engine }}(db: &{% if engine == "mysql" %}sqlx::MySqlPool{% elif engine == "sqlite" %}sqlx::SqlitePool{% else %}sqlx::PgPool{% endif %}) -> anyhow::Result<()> {
{%- for resource in c.resources %}
{%- if resource.db_engine == engine %}
{%- if resource.record %}
    sqlx::query(
        "CREATE TABLE IF NOT EXISTS {{ resource.plural }} (
            id VARCHAR(36) PRIMARY KEY{% for field in resource.record.fields %}{% if field.name != "id" %},
            {{ field.name }} {{ field.sql_type }} NOT NULL{% endif %}{% endfor %}
        )",
    )
    .execute(db)
    .await?;
{%- else %}
    sqlx::query(
        "CREATE TABLE IF NOT EXISTS {{ resource.plural }} (
            id VARCHAR(36) PRIMARY KEY,
{%- if engine == "mysql" %}
            data JSON NOT NULL
{%- elif engine == "sqlite" %}
            data TEXT NOT NULL
{%- else %}
            data JSONB NOT NULL DEFAULT '{}'::jsonb
{%- endif %}
        )",
    )
    .execute(db)
    .await?;
{%- endif %}
{%- endif %}
{%- endfor %}
    Ok(())
}
{%- endfor %}
{%- endif %}
