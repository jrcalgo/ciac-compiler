/// Creates CRUD-resource tables on startup. `table` declarations (v0.7)
/// are provisioned by the `migrations/` directory instead, applied via
/// `sqlx::migrate!` at startup (see `main.rs`).
pub async fn ensure_schema(db: &sqlx::PgPool) -> anyhow::Result<()> {
{%- for resource in c.resources %}
{%- if resource.record %}
    sqlx::query(
        "CREATE TABLE IF NOT EXISTS {{ resource.plural }} (
            id TEXT PRIMARY KEY{% for field in resource.record.fields %}{% if field.name != "id" %},
            {{ field.name }} {{ field.sql_type }} NOT NULL{% endif %}{% endfor %}
        )",
    )
    .execute(db)
    .await?;
{%- else %}
    sqlx::query(
        "CREATE TABLE IF NOT EXISTS {{ resource.plural }} (
            id TEXT PRIMARY KEY,
            data JSONB NOT NULL DEFAULT '{}'::jsonb
        )",
    )
    .execute(db)
    .await?;
{%- endif %}
{%- endfor %}
    Ok(())
}
{%- endif %}
