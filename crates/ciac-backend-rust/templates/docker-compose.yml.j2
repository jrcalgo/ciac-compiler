services:
  app:
    build: .
    ports:
      - "8000:8000"
{%- if c.has_db or c.has_cache or c.has_queue or c.has_auth %}
    environment:
{%- for inst in c.db_instances %}
      {{ inst.env_var }}: postgres://postgres:postgres@{{ inst.container }}:5432/{{ inst.db_name }}
{%- endfor %}
{%- for inst in c.cache_instances %}
      {{ inst.env_var }}: redis://{{ inst.container }}:6379/0
{%- endfor %}
{%- if c.has_queue %}
      NATS_URL: nats://queue:4222
{%- endif %}
{%- if c.has_auth %}
      JWT_SECRET: ${JWT_SECRET:-change-me}
{%- endif %}
{%- endif %}
{%- if c.has_db or c.has_cache or c.has_queue %}
    depends_on:
{%- for inst in c.db_instances %}
      - {{ inst.container }}
{%- endfor %}
{%- for inst in c.cache_instances %}
      - {{ inst.container }}
{%- endfor %}
{%- if c.has_queue %}
      - queue
{%- endif %}
{%- endif %}
{%- if c.workers or c.consumers %}

  workers:
    build: .
    command: ["workers"]
{%- if c.has_db or c.has_cache or c.has_queue %}
    environment:
{%- for inst in c.db_instances %}
      {{ inst.env_var }}: postgres://postgres:postgres@{{ inst.container }}:5432/{{ inst.db_name }}
{%- endfor %}
{%- for inst in c.cache_instances %}
      {{ inst.env_var }}: redis://{{ inst.container }}:6379/0
{%- endfor %}
{%- if c.has_queue %}
      NATS_URL: nats://queue:4222
{%- endif %}
    depends_on:
{%- for inst in c.db_instances %}
      - {{ inst.container }}
{%- endfor %}
{%- for inst in c.cache_instances %}
      - {{ inst.container }}
{%- endfor %}
{%- if c.has_queue %}
      - queue
{%- endif %}
{%- endif %}
{%- endif %}
{%- for inst in c.db_instances %}

  {{ inst.container }}:
    image: postgres:16
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ inst.db_name }}
    volumes:
      - {{ inst.container }}-data:/var/lib/postgresql/data
{%- endfor %}
{%- for inst in c.cache_instances %}

  {{ inst.container }}:
    image: redis:7
{%- endfor %}
{%- if c.has_queue %}

  queue:
    image: nats:2
{%- endif %}
{%- if c.has_db %}

volumes:
{%- for inst in c.db_instances %}
  {{ inst.container }}-data:
{%- endfor %}
{%- endif %}
