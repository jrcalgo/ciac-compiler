//! Scheduled job pipeline for `job {{ job.name }}`. Generated by CIaC.

use chrono::Utc;
use cron::Schedule;
use std::str::FromStr;
use std::time::Duration;

{% for handler in job.handlers -%}
use crate::services::{{ handler.module }}::{{ handler.class_name }};
{% endfor -%}
use crate::state::AppState;

pub const SCHEDULE: &str = "{{ job.schedule }}";
pub const CATCH_UP: bool = {{ "true" if job.catch_up else "false" }};

pub async fn run(state: AppState) -> anyhow::Result<()> {
    let schedule = Schedule::from_str(SCHEDULE)?;
    loop {
        sleep_until_next(&schedule).await?;
        if let Err(err) = handle_tick_once(&state).await {
            tracing::error!(?err, "scheduled job {{ job.name }} failed");
        }
    }
}

async fn sleep_until_next(schedule: &Schedule) -> anyhow::Result<()> {
    let next = schedule
        .upcoming(Utc)
        .next()
        .ok_or_else(|| anyhow::anyhow!("schedule produced no future instant"))?;
    let delay = (next - Utc::now()).to_std().unwrap_or(Duration::ZERO);
    tokio::time::sleep(delay).await;
    Ok(())
}

