//! Persistence models and API schemas for CRUD resources. Generated by CIaC.
//!
//! Typed resources (`crud X: Record;`) get real columns from their record;
//! untyped ones keep a generic keyed-document model (UUID key + JSON
//! payload). Enums are stored as text.

use serde::{Deserialize, Serialize};
{%- for resource in c.resources %}
{%- if resource.record %}
{%- for enum in resource.record.enums %}

use crate::schemas::{{ enum.name }};
{%- endfor %}
{%- endif %}
{%- endfor %}
{% for resource in c.resources %}
{%- if resource.record %}
#[derive(Debug, Clone, Serialize, Deserialize, sqlx::FromRow)]
pub struct {{ resource.name }} {
    pub id: String,
{%- for field in resource.record.fields %}
{%- if field.name != "id" %}
    pub {{ field.name }}: {{ field.db_rust_type }},
{%- endif %}
{%- endfor %}
}

/// Payload for creating or updating a {{ resource.name }}; the `id` is
/// server-generated.
#[derive(Debug, Clone, Deserialize)]
pub struct {{ resource.name }}In {
{%- for field in resource.record.fields %}
{%- if field.name != "id" %}
    pub {{ field.name }}: {{ field.rust_type }},
{%- endif %}
{%- endfor %}
}
{%- else %}
#[derive(Debug, Clone, Serialize, sqlx::FromRow)]
pub struct {{ resource.name }} {
    pub id: String,
    pub data: serde_json::Value,
}

/// Payload for creating or updating a {{ resource.name }}.
#[derive(Debug, Clone, Deserialize)]
pub struct {{ resource.name }}In {
    #[serde(default)]
    pub data: serde_json::Value,
}
{%- endif %}
{% endfor %}
