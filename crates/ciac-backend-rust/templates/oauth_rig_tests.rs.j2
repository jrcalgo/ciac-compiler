#[tokio::test]
async fn {{ api.snake }}_wrong_scope() {
    let (router, issuer) = app().await;
    let response = router
        .oneshot(
            Request::builder()
                .method("{{ api.method_upper }}")
                .uri("{{ api.route }}")
                .header("Authorization", bearer(&issuer, "not:{{ api.scope }}"))
{%- if api.has_body %}
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{{ dummy_api_body(api) }}"#))
{%- else %}
                .body(Body::empty())
{%- endif %}
                .unwrap(),
        )
        .await
        .unwrap();
    assert_eq!(response.status(), StatusCode::FORBIDDEN);
}

