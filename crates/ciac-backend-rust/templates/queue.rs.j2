//!
//! One `Queue` type per program, engine selected at generation time —
//! publish sites (api pipelines, workers, jobs, typed handlers) are
//! engine-agnostic; only the consume loops (workers, consumers,
//! channels) branch per engine.
{% if c.has_tracing -%}
/// A `HashMap`-backed W3C trace-context carrier: the same shape for
/// both broker engines, converted to/from NATS `HeaderMap` / Kafka
/// `OwnedHeaders` at the publish/consume boundary since neither
/// broker client's own header type is reusable across the other.
pub(crate) struct TraceCarrier(pub std::collections::HashMap<String, String>);

impl opentelemetry::propagation::Injector for TraceCarrier {
    fn set(&mut self, key: &str, value: String) {
        self.0.insert(key.to_owned(), value);
    }
}

impl opentelemetry::propagation::Extractor for TraceCarrier {
    fn get(&self, key: &str) -> Option<&str> {
        self.0.get(key).map(|s| s.as_str())
    }

    fn keys(&self) -> Vec<&str> {
        self.0.keys().map(|s| s.as_str()).collect()
    }
}

/// Injects the current span's `traceparent` into a fresh carrier —
/// called from every publish site regardless of engine.
pub(crate) fn inject_trace_carrier() -> TraceCarrier {
    use tracing_opentelemetry::OpenTelemetrySpanExt;
    let mut carrier = TraceCarrier(std::collections::HashMap::new());
    opentelemetry::global::get_text_map_propagator(|propagator| {
        propagator.inject_context(&tracing::Span::current().context(), &mut carrier)
    });
    carrier
}
{% endif -%}
{% if c.queue_engine == "kafka" %}
use rdkafka::config::ClientConfig;
use rdkafka::producer::{FutureProducer, FutureRecord};

/// Kafka producer. Topics reuse the `<service>.<stream>` subject
/// names NATS programs use; consumer groups reuse the per-worker
/// queue-group names.
#[derive(Clone)]
pub struct Queue {
    producer: FutureProducer,
}

impl std::fmt::Debug for Queue {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("Queue").finish_non_exhaustive()
    }
}

impl Queue {
    /// `librdkafka`'s client creation does not itself block on
    /// reaching a broker (connections/retries happen on background
    /// threads as messages are produced) — so, unlike the NATS branch
    /// below, no separate lazy-init wrapper is needed here for
    /// constructing `AppState` without live infrastructure (v0.17
    /// M11). Kept a plain, synchronous, fallible constructor (not
    /// `async`) so both engine branches present the same shape to
    /// `state.rs.j2`.
    pub fn new(url: &str) -> anyhow::Result<Self> {
        let producer = ClientConfig::new()
            .set("bootstrap.servers", url)
            .set("message.timeout.ms", "5000")
            .create()?;
        Ok(Self { producer })
    }

    pub async fn publish(&self, subject: &str, payload: Vec<u8>) -> anyhow::Result<()> {
{%- if c.has_tracing %}
        let carrier = inject_trace_carrier();
        let headers = carrier
            .0
            .iter()
            .fold(rdkafka::message::OwnedHeaders::new(), |acc, (k, v)| {
                acc.insert(rdkafka::message::Header {
                    key: k,
                    value: Some(v),
                })
            });
        self.producer
            .send(
                FutureRecord::<(), _>::to(subject)
                    .payload(&payload)
                    .headers(headers),
                std::time::Duration::from_secs(5),
            )
            .await
            .map_err(|(err, _)| anyhow::anyhow!("kafka publish failed: {err}"))?;
{%- else %}
        self.producer
            .send(
                FutureRecord::<(), _>::to(subject).payload(&payload),
                std::time::Duration::from_secs(5),
            )
            .await
            .map_err(|(err, _)| anyhow::anyhow!("kafka publish failed: {err}"))?;
{%- endif %}
        Ok(())
    }

    /// Builds a consumer in `group` subscribed to `subject`.
    /// `auto.offset.reset=earliest` so a consumer that starts after a
    /// publish still sees it — matching NATS-programs' effective
    /// semantics for the generated system tests.
    pub fn consumer(
        &self,
        url: &str,
        subject: &str,
        group: &str,
    ) -> anyhow::Result<rdkafka::consumer::StreamConsumer> {
        use rdkafka::consumer::Consumer;
        let consumer: rdkafka::consumer::StreamConsumer = ClientConfig::new()
            .set("bootstrap.servers", url)
            .set("group.id", group)
            .set("auto.offset.reset", "earliest")
            .create()?;
        consumer.subscribe(&[subject])?;
        Ok(consumer)
    }
}
{%- else %}
/// NATS client wrapper: uniform publish surface shared with the
/// Kafka variant of this module. The client itself is established
/// lazily, on first use, cached behind a `OnceCell` -- mirroring the
/// `connect_lazy` pools every db instance already uses, so
/// constructing `AppState` never requires a reachable broker (v0.17
/// M11: this was the one genuinely eager infrastructure dependency
/// left in generated Rust code; every db pool was already lazy).
#[derive(Clone)]
pub struct Queue {
    url: String,
    client: std::sync::Arc<tokio::sync::OnceCell<async_nats::Client>>,
}

impl std::fmt::Debug for Queue {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("Queue").field("url", &self.url).finish_non_exhaustive()
    }
}

impl Queue {
    pub fn new(url: impl Into<String>) -> Self {
        Self {
            url: url.into(),
            client: std::sync::Arc::new(tokio::sync::OnceCell::new()),
        }
    }

    async fn client(&self) -> anyhow::Result<&async_nats::Client> {
        self.client
            .get_or_try_init(|| async_nats::connect(&self.url))
            .await
            .map_err(|err| anyhow::anyhow!("connecting to NATS at {}: {err}", self.url))
    }

    pub async fn publish(&self, subject: &str, payload: Vec<u8>) -> anyhow::Result<()> {
        let client = self.client().await?;
{%- if c.has_tracing %}
        let carrier = inject_trace_carrier();
        let mut headers = async_nats::HeaderMap::new();
        for (k, v) in carrier.0 {
            headers.insert(k.as_str(), v.as_str());
        }
        client
            .publish_with_headers(subject.to_owned(), headers, payload.into())
            .await?;
{%- else %}
        client.publish(subject.to_owned(), payload.into()).await?;
{%- endif %}
        Ok(())
    }

    /// Subscribes to `subject`, connecting first if this is the first
    /// use of this `Queue`.
    pub async fn subscribe(&self, subject: &str) -> anyhow::Result<async_nats::Subscriber> {
        self.client()
            .await?
            .subscribe(subject.to_owned())
            .await
            .map_err(Into::into)
    }

    /// Queue-group subscribe (workers/consumers): connecting first if
    /// this is the first use of this `Queue`.
    pub async fn queue_subscribe(
        &self,
        subject: &str,
        group: &str,
    ) -> anyhow::Result<async_nats::Subscriber> {
        self.client()
            .await?
            .queue_subscribe(subject.to_owned(), group.to_owned())
            .await
            .map_err(Into::into)
    }
}
{%- endif %}
