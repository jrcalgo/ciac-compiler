/// NATS client wrapper: uniform publish surface shared with the
/// Kafka variant of this module.
#[derive(Debug, Clone)]
pub struct Queue {
    client: async_nats::Client,
}

impl Queue {
    pub async fn connect(url: &str) -> anyhow::Result<Self> {
        Ok(Self {
            client: async_nats::connect(url).await?,
        })
    }

    pub async fn publish(&self, subject: &str, payload: Vec<u8>) -> anyhow::Result<()> {
{%- if c.has_tracing %}
        let carrier = inject_trace_carrier();
        let mut headers = async_nats::HeaderMap::new();
        for (k, v) in carrier.0 {
            headers.insert(k.as_str(), v.as_str());
        }
        self.client
            .publish_with_headers(subject.to_owned(), headers, payload.into())
            .await?;
{%- else %}
        self.client.publish(subject.to_owned(), payload.into()).await?;
{%- endif %}
        Ok(())
    }

    /// The underlying client, for subscription paths.
    pub fn client(&self) -> &async_nats::Client {
        &self.client
    }
}
