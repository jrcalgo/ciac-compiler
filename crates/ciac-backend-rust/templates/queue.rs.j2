use rdkafka::config::ClientConfig;
use rdkafka::producer::{FutureProducer, FutureRecord};

/// Kafka producer. Topics reuse the `<service>.<stream>` subject
/// names NATS programs use; consumer groups reuse the per-worker
/// queue-group names.
#[derive(Clone)]
pub struct Queue {
    producer: FutureProducer,
}

impl std::fmt::Debug for Queue {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("Queue").finish_non_exhaustive()
    }
}

impl Queue {
    pub async fn connect(url: &str) -> anyhow::Result<Self> {
        let producer = ClientConfig::new()
            .set("bootstrap.servers", url)
            .set("message.timeout.ms", "5000")
            .create()?;
        Ok(Self { producer })
    }

    pub async fn publish(&self, subject: &str, payload: Vec<u8>) -> anyhow::Result<()> {
{%- if c.has_tracing %}
        let carrier = inject_trace_carrier();
        let headers = carrier
            .0
            .iter()
            .fold(rdkafka::message::OwnedHeaders::new(), |acc, (k, v)| {
                acc.insert(rdkafka::message::Header {
                    key: k,
                    value: Some(v),
                })
            });
        self.producer
            .send(
                FutureRecord::<(), _>::to(subject)
                    .payload(&payload)
                    .headers(headers),
                std::time::Duration::from_secs(5),
            )
            .await
            .map_err(|(err, _)| anyhow::anyhow!("kafka publish failed: {err}"))?;
{%- else %}
        self.producer
            .send(
                FutureRecord::<(), _>::to(subject).payload(&payload),
                std::time::Duration::from_secs(5),
            )
            .await
            .map_err(|(err, _)| anyhow::anyhow!("kafka publish failed: {err}"))?;
{%- endif %}
        Ok(())
    }

    /// Builds a consumer in `group` subscribed to `subject`.
    /// `auto.offset.reset=earliest` so a consumer that starts after a
    /// publish still sees it — matching NATS-programs' effective
    /// semantics for the generated system tests.
    pub fn consumer(
        &self,
        url: &str,
        subject: &str,
        group: &str,
    ) -> anyhow::Result<rdkafka::consumer::StreamConsumer> {
        use rdkafka::consumer::Consumer;
        let consumer: rdkafka::consumer::StreamConsumer = ClientConfig::new()
            .set("bootstrap.servers", url)
            .set("group.id", group)
            .set("auto.offset.reset", "earliest")
            .create()?;
        consumer.subscribe(&[subject])?;
        Ok(consumer)
    }
}
