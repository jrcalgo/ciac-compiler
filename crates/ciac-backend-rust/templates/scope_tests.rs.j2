{%- macro dummy_json(record, skip_id) -%}
{%- if record %}{
{%- for field in record.fields if not (skip_id and field.name == "id") %}
{%- if not loop.first %},{% endif %}
{#- `field.type_kind` is internally tagged (`#[serde(tag = "kind",
   rename_all = "snake_case")]` on `FieldTypeKind`): it serializes as a
   flat object like `{"kind": "float"}`, not a bare string and not
   `{"Float": {}}` -- so the tag itself is `field.type_kind.kind`
   (snake_case), and a struct variant's own fields (e.g. `Enum`'s
   `variants`) sit alongside it in the same flat object, not nested
   under the variant's name. This macro previously compared
   `field.type_kind` directly against `"Int"`/`"Float"`/.. (PascalCase,
   no tag), which never matched anything -- every non-enum field fell
   through to the `"x"` string fallback, silently producing malformed
   dummy bodies for any payload with an Int/Float/Bool/Uuid/Timestamp
   field. Found and fixed while wiring queue/OAuth2 scope tests: those
   were the first scope-tested examples on the Rust target to declare
   an Int/Float field wide of just String/Uuid (v0.17 M11). #}
"{{ field.name }}":{% if field.type_kind.kind == "enum" %}"{{ field.type_kind.variants[0] }}"{% elif field.type_kind.kind == "int" %}0{% elif field.type_kind.kind == "float" %}0.0{% elif field.type_kind.kind == "bool" %}false{% elif field.type_kind.kind == "uuid" or field.type_kind.kind == "reference" %}"00000000-0000-0000-0000-000000000000"{% elif field.type_kind.kind == "timestamp" %}"1970-01-01T00:00:00Z"{% elif field.type_kind.kind == "json" %}{}{% else %}"x"{% endif %}
{%- endfor %}
}{% else %}{}{% endif -%}
{%- endmacro -%}
{%- macro dummy_body(resource) -%}
{# `resource.record`'s `In` schema always drops `id` (server-generated) — see models.rs.j2. #}
{{ dummy_json(resource.record, true) }}
