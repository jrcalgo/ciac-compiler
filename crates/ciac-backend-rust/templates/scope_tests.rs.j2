{%- macro dummy_api_body(api) -%}
{# a plain api's payload is the record itself, `id` included — unlike crud's stripped `In` schema. #}
{%- if api.payload %}{{ dummy_json(c.records | selectattr("name", "equalto", api.payload.class_name) | first, false) }}{% else %}{}{% endif -%}
{%- endmacro -%}
{% for api in c.apis %}
{%- if api.has_auth_step %}

#[tokio::test]
async fn {{ api.snake }}_no_token() {
    let response = app()
        .await
        .oneshot(
            Request::builder()
                .method("{{ api.method_upper }}")
                .uri("{{ api.route }}")
{%- if api.has_body %}
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{{ dummy_api_body(api) }}"#))
{%- else %}
                .body(Body::empty())
{%- endif %}
                .unwrap(),
        )
        .await
        .unwrap();
    assert_eq!(response.status(), StatusCode::UNAUTHORIZED);
}

#[tokio::test]
async fn {{ api.snake }}_malformed_token() {
    let response = app()
        .await
        .oneshot(
            Request::builder()
                .method("{{ api.method_upper }}")
                .uri("{{ api.route }}")
                .header("Authorization", "Bearer not-a-jwt")
{%- if api.has_body %}
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{{ dummy_api_body(api) }}"#))
{%- else %}
                .body(Body::empty())
{%- endif %}
                .unwrap(),
        )
        .await
        .unwrap();
    assert_eq!(response.status(), StatusCode::UNAUTHORIZED);
}
{%- if api.scope and c.auth_scheme == "jwt" %}

#[tokio::test]
async fn {{ api.snake }}_wrong_scope() {
    // A well-formed body: axum extracts parameters in declaration
    // order, so `Json<..>` extraction (and its own validation) still
    // runs before the handler body's `require_scope` check — an
    // ill-formed body would 422 there first, masking the 403 this
    // test means to prove.
    let response = app()
        .await
        .oneshot(
            Request::builder()
                .method("{{ api.method_upper }}")
                .uri("{{ api.route }}")
                .header("Authorization", bearer("not:{{ api.scope }}"))
{%- if api.has_body %}
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{{ dummy_api_body(api) }}"#))
{%- else %}
                .body(Body::empty())
{%- endif %}
                .unwrap(),
        )
        .await
        .unwrap();
    assert_eq!(response.status(), StatusCode::FORBIDDEN);
}

#[tokio::test]
async fn {{ api.snake }}_correct_scope() {
    let response = app()
        .await
        .oneshot(
            Request::builder()
                .method("{{ api.method_upper }}")
                .uri("{{ api.route }}")
                .header("Authorization", bearer("{{ api.scope }}"))
{%- if api.has_body %}
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{{ dummy_api_body(api) }}"#))
{%- else %}
                .body(Body::empty())
{%- endif %}
                .unwrap(),
        )
        .await
        .unwrap();
    assert_ne!(response.status(), StatusCode::UNAUTHORIZED);
    assert_ne!(response.status(), StatusCode::FORBIDDEN);
}

#[tokio::test]
async fn {{ api.snake }}_expired_token() {
    let response = app()
        .await
        .oneshot(
            Request::builder()
                .method("{{ api.method_upper }}")
                .uri("{{ api.route }}")
                .header("Authorization", bearer_exp("{{ api.scope }}", -3600))
{%- if api.has_body %}
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{{ dummy_api_body(api) }}"#))
{%- else %}
                .body(Body::empty())
{%- endif %}
                .unwrap(),
        )
        .await
        .unwrap();
    assert_eq!(response.status(), StatusCode::UNAUTHORIZED);
}
