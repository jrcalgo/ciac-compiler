/// Matches `crate::json_out::SimScenarioOutcome` field-for-field
/// (`crates/ciac/src/json_out.rs`) -- the one-line JSON reply on stdout
/// `ciac sim`'s Rust path reads, same bounded child protocol as the
/// Python runner's `auto_driver.py`.
#[derive(Debug, serde::Serialize)]
struct SimScenarioOutcome {
    scenario: String,
    passed: bool,
    error: Option<String>,
    worker_attempts: BTreeMap<String, u32>,
    job_runs: BTreeMap<String, u32>,
}

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    let scenario_path = std::env::args().nth(1).ok_or_else(|| {
        anyhow::anyhow!("usage: sim_runner <scenario.json>")
    })?;
    let json = std::fs::read_to_string(&scenario_path)
        .map_err(|e| anyhow::anyhow!("reading {scenario_path}: {e}"))?;
    let scenario = Scenario::parse(&json).map_err(|e| anyhow::anyhow!("{e}"))?;
    scenario.validate().map_err(|e| anyhow::anyhow!("{e}"))?;
    let name = scenario.name.clone();

    let mut runner = Runner::new(&scenario).await?;
    let outcome = match runner.run(&scenario).await {
        Ok(()) => SimScenarioOutcome {
            scenario: name,
            passed: true,
            error: None,
            worker_attempts: runner.worker_attempts,
            job_runs: runner.job_runs,
        },
        Err(err) => SimScenarioOutcome {
            scenario: name,
            passed: false,
            error: Some(format!("{err:#}")),
            worker_attempts: runner.worker_attempts,
            job_runs: runner.job_runs,
        },
    };
    println!("{}", serde_json::to_string(&outcome)?);
    Ok(())
}

struct Runner {
    // Read only by `request`/`drain` -- unused when this service
    // declares neither `api` pipelines nor workers/jobs (there's
    // nothing left for a scenario to drive besides `given.db`/`expect`).
    #[allow(dead_code)]
    state: AppState,
    world: Arc<SimWorld>,
    now_ms: i64,
    saved: BTreeMap<String, (u16, serde_json::Value)>,
    worker_attempts: BTreeMap<String, u32>,
    job_runs: BTreeMap<String, u32>,
}

impl Runner {
    async fn new(scenario: &Scenario) -> anyhow::Result<Self> {
        let world = Arc::new(SimWorld::new(scenario.given.failures.clone()));
        for seed in &scenario.given.db {
            if seed.service != "{{ c.service_name }}" {
                anyhow::bail!(
                    "sim_runner only drives service {:?} (v0.17 M11, single-service only); \
                     given.db named {:?}",
                    "{{ c.service_name }}",
                    seed.service
                );
            }
            for row in &seed.rows {
                world.db.insert(&seed.table, row.clone());
            }
        }
        let now_ms = chrono::DateTime::parse_from_rfc3339(&scenario.start_at)
            .map_err(|e| anyhow::anyhow!("scenario start_at {:?}: {e}", scenario.start_at))?
            .timestamp_millis();
        let config = Config::from_env();
        let state = AppState::simulation(config, world.clone()).await?;
        Ok(Self {
            state,
            world,
            now_ms,
            saved: BTreeMap::new(),
            worker_attempts: BTreeMap::new(),
            job_runs: BTreeMap::new(),
        })
    }

    async fn run(&mut self, scenario: &Scenario) -> anyhow::Result<()> {
        for step in &scenario.steps {
            match step {
                ScenarioStep::Request(spec) => self.request(spec).await?,
                ScenarioStep::Publish(_) => anyhow::bail!(
                    "sim_runner does not yet support `publish` steps (v0.17 M11 disclosed scope)"
                ),
                ScenarioStep::Advance(spec) => self.advance(&spec.by).await?,
                ScenarioStep::Drain(_) => self.drain().await?,
                ScenarioStep::Expect(spec) => self.expect(spec)?,
            }
        }
        let unmatched = self.world.unmatched_failure_rules();
        if !unmatched.is_empty() {
            anyhow::bail!(
                "{} failure rule(s) declared in `given.failures` never matched a real \
                 occurrence: {unmatched:?}",
                unmatched.len()
            );
        }
        Ok(())
    }

{%- if not c.apis %}
    async fn request(&mut self, spec: &{{ c.module }}::scenario::RequestStep) -> anyhow::Result<()> {
        anyhow::bail!(
            "sim_runner: no api registered named {:?} (this service declares no `api` pipelines)",
            spec.api
        )
    }
{%- else %}
    async fn request(&mut self, spec: &{{ c.module }}::scenario::RequestStep) -> anyhow::Result<()> {
        if spec.service != "{{ c.service_name }}" {
            anyhow::bail!(
                "sim_runner only drives service {:?} (v0.17 M11, single-service only); \
                 request named {:?}",
                "{{ c.service_name }}",
                spec.service
            );
        }
        let app = routes::router().with_state(self.state.clone());
        let (method, path): (axum::http::Method, &str) = match spec.api.as_str() {
{%- for api in c.apis %}
            "{{ api.name }}" => (axum::http::Method::{{ api.method_upper }}, "{{ api.route }}"),
{%- endfor %}
            other => anyhow::bail!("sim_runner: no api registered named {other:?}"),
        };
        let request = Request::builder()
            .method(method)
            .uri(path)
            .header(axum::http::header::CONTENT_TYPE, "application/json")
            .body(Body::from(serde_json::to_vec(&spec.json)?))?;
        let response = app
            .oneshot(request)
            .await
            .map_err(|err| anyhow::anyhow!("{err}"))?;
        let status = response.status().as_u16();
        let body = axum::body::to_bytes(response.into_body(), usize::MAX).await?;
        let json = if body.is_empty() {
            serde_json::Value::Null
        } else {
            serde_json::from_slice(&body)?
        };
        if let Some(save_as) = &spec.save_as {
            self.saved.insert(save_as.clone(), (status, json));
        }
        Ok(())
    }
{%- endif %}

    async fn advance(&mut self, by: &str) -> anyhow::Result<()> {
        let delta_ms = parse_duration_ms(by)?;
        let from_ms = self.now_ms;
        let to_ms = from_ms + delta_ms;
{%- for job in c.jobs %}
        {
            let schedule = CronSchedule::parse(workers::{{ job.snake }}::SCHEDULE)
                .map_err(|e| anyhow::anyhow!("job {{ job.name }} schedule: {e}"))?;
            for _fire_ms in schedule.due_instants(from_ms, to_ms, 10_000) {
                workers::{{ job.snake }}::handle_tick_once(&self.state).await?;
                *self.job_runs.entry("{{ job.name }}".to_owned()).or_insert(0) += 1;
            }
        }
{%- endfor %}
        self.now_ms = to_ms;
        Ok(())
    }

    /// One pass: every message currently undelivered is handed to its
    /// worker's `handle_message_once` exactly once (with that worker's
    /// own retry budget) -- messages a handler publishes as a side
    /// effect of processing are left for the *next* `drain` step, same
    /// as `sim/pyrunner/scenario_runner.py`'s own `_drain` (one pass per
    /// worker per step, not a fixed-point loop).
    ///
    /// Dispatches by `if`/`else if` on the subject string, not `match`
    /// (a real `match` on each worker's `SUBJECT` constant is a
    /// compile-time "unreachable pattern" error whenever two workers
    /// share a subject, e.g. two independent consumer groups on one
    /// stream) -- but that also means this runner has no independent
    /// per-`(subject, group)` cursors (documented in `src/world.rs`):
    /// the *first* worker registered for a subject receives every
    /// drained message, any others sharing that subject receive none.
    async fn drain(&mut self) -> anyhow::Result<()> {
        for (subject, {% if has_drain_workers %}raw{% else %}_raw{% endif %}) in self.world.queue.take_all() {
{%- if not has_drain_workers %}
            anyhow::bail!(
                "sim_runner: no worker registered to consume subject {subject:?} \
                 (v0.17 M11 disclosed scope)"
            );
{%- else %}
{%- for worker in c.workers %}
{%- if worker.steps %}
            {% if not loop.first %}else {% endif %}if subject == workers::{{ worker.snake }}::SUBJECT {
                let payload: {% if worker.payload %}{{ c.module }}::schemas::{{ worker.payload.class_name }}{% else %}serde_json::Value{% endif %} =
                    serde_json::from_slice(&raw)?;
                let mut attempts = 0u32;
                for attempt in 0..=workers::{{ worker.snake }}::MAX_RETRIES {
                    attempts += 1;
                    match workers::{{ worker.snake }}::handle_message_once(&self.state, payload.clone()).await {
                        Ok(()) => break,
                        Err(err) if attempt < workers::{{ worker.snake }}::MAX_RETRIES => {
                            tracing::warn!(?err, attempt, "sim_runner: retrying {{ worker.name }}");
                        }
                        Err(err) => {
                            tracing::error!(?err, "sim_runner: {{ worker.name }} exhausted retries");
                        }
                    }
                }
                *self
                    .worker_attempts
                    .entry("{{ worker.name }}".to_owned())
                    .or_insert(0) += attempts;
            }
{%- endif %}
{%- endfor %}
            else {
                anyhow::bail!(
                    "sim_runner: no worker registered to consume subject {subject:?} \
                     (v0.17 M11 disclosed scope)"
                );
            }
{%- endif %}
        }
        Ok(())
    }

    fn expect(&self, spec: &ExpectStep) -> anyhow::Result<()> {
        match spec {
            ExpectStep::Response { of, status, json } => {
                let of = of
                    .as_deref()
                    .ok_or_else(|| anyhow::anyhow!("expect.response requires \"of\""))?;
                let (got_status, got_json) = self.saved.get(of).ok_or_else(|| {
                    anyhow::anyhow!("expect.response.of references unknown save_as {of:?}")
                })?;
                if let Some(want_status) = status {
                    if got_status != want_status {
                        anyhow::bail!(
                            "expect.response.of={of:?}: expected status {want_status}, got \
                             {got_status}"
                        );
                    }
                }
                if let Some(want_json) = json {
                    if got_json != want_json {
                        anyhow::bail!(
                            "expect.response.of={of:?}: expected json {want_json}, got {got_json}"
                        );
                    }
                }
                Ok(())
            }
            ExpectStep::Row {
                service,
                table,
                matches,
                present,
            } => {
                if service != "{{ c.service_name }}" {
                    anyhow::bail!(
                        "sim_runner only drives service {:?} (v0.17 M11, single-service only); \
                         expect.row named {service:?}",
                        "{{ c.service_name }}"
                    );
                }
                let found = !self.world.db.find_where(table, matches).is_empty();
                if found != *present {
                    anyhow::bail!(
                        "expect.row: table={table:?} where={matches:?} present={present}, found={found}"
                    );
                }
                Ok(())
            }
            ExpectStep::WorkerAttempts { worker, count } => {
                let actual = self.worker_attempts.get(worker).copied().unwrap_or(0);
                if actual != *count {
                    anyhow::bail!(
                        "expect.worker_attempts: worker={worker:?} expected {count}, got {actual}"
                    );
                }
                Ok(())
            }
            ExpectStep::JobRuns { job, count } => {
                let actual = self.job_runs.get(job).copied().unwrap_or(0);
                if actual != *count {
                    anyhow::bail!("expect.job_runs: job={job:?} expected {count}, got {actual}");
                }
                Ok(())
            }
            ExpectStep::Quiescence {} => {
                if !self.world.queue.is_empty() {
                    anyhow::bail!(
                        "expect.quiescence: undelivered message(s) remain in the simulated broker"
                    );
                }
                Ok(())
            }
            // 27UpdatePlan.md M1 added these `ExpectStep` kinds to the
            // shared scenario schema for the peripheral fakes (cache,
            // object store, email, search, external HTTP) M3 builds
            // into this world -- refused with the specific reason here
            // rather than silently no-op'd, matching this runner's own
            // "refused, not guessed" contract for anything it does not
            // yet fake (v0.17 M11).
            ExpectStep::Email { .. } => anyhow::bail!(
                "sim_runner: expect.email is not yet faked on this target (27UpdatePlan.md M3)"
            ),
            ExpectStep::Cache { .. } => anyhow::bail!(
                "sim_runner: expect.cache is not yet faked on this target (27UpdatePlan.md M3)"
            ),
            ExpectStep::Object { .. } => anyhow::bail!(
                "sim_runner: expect.object is not yet faked on this target (27UpdatePlan.md M3)"
            ),
            ExpectStep::SearchHits { .. } => anyhow::bail!(
                "sim_runner: expect.search_hits is not yet faked on this target (27UpdatePlan.md M3)"
            ),
            ExpectStep::HttpCalls { .. } => anyhow::bail!(
                "sim_runner: expect.http_calls is not yet faked on this target (27UpdatePlan.md M3)"
            ),
        }
    }
}

/// Parses `advance.by` strings (`"24h"`, `"7d"`, `"30m"`, ...) -- the
/// same small duration grammar the plan's own worked examples use,
/// matching `sim/pyrunner/cron.py`'s `parse_duration_ms` exactly.
fn parse_duration_ms(text: &str) -> anyhow::Result<i64> {
    let split_at = text
        .find(|c: char| !c.is_ascii_digit())
        .ok_or_else(|| anyhow::anyhow!("unrecognized duration: {text:?}"))?;
    let (value, unit) = text.split_at(split_at);
    let value: i64 = value
        .parse()
        .map_err(|_| anyhow::anyhow!("unrecognized duration: {text:?}"))?;
    let unit_ms: i64 = match unit {
        "ms" => 1,
        "s" => 1_000,
        "m" => 60_000,
        "h" => 3_600_000,
        "d" => 86_400_000,
        other => anyhow::bail!("unrecognized duration unit {other:?} in {text:?}"),
    };
    Ok(value * unit_ms)
}
