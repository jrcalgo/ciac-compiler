//! Multi-service scenario-driving simulation runner. Generated by CIaC
//! (28UpdatePlan.md M6c) -- the system-runner crate's own `main.rs`, one
//! per multi-service system, generalizing `sim_runner.rs.j2`'s
//! single-service interpreter across every service this system
//! declares.
//!
//! Depends on every service crate (and `sim-shared`) by path, builds
//! *one* shared `sim_shared::world::SimWorld` (the same nominal type
//! every service's own `crate::world::SimWorld` re-exports, per M6b), and
//! constructs each service's own `AppState::simulation(config, world.
//! clone())` against it -- mirroring `sim/pyrunner/multi_driver.py`'s
//! architecture, generated rather than hand-registered for the same
//! reason `sim_runner.rs.j2` already is: Rust needs concrete per-program
//! types at compile time, and unlike Python's `app`-named packages,
//! every generated Rust service crate already has its own distinct crate
//! name, so no `ServiceModules`-style aliasing seam is needed here at
//! all -- this file just names each service crate directly.
//!
//! `request` steps dispatch straight through the named service's own
//! `routes::router()` (`tower::ServiceExt::oneshot`, no live listener,
//! same as the single-service runner). A `call <Service>.<Api>` step
//! reachable only through another service's own routed call (never a
//! scenario `request` step in its own right) is registered on the
//! shared world's call router up front, in declaration order, exactly
//! like `multi_driver.py`'s own api-registration loop -- `world.
//! register_api`'s handler type is a *synchronous* closure
//! (`Fn(Value) -> anyhow::Result<Value>`), so [`block_on_ready`] drives
//! the same oneshot dispatch used for a direct `request` step from
//! inside one; that's sound specifically because full simulation
//! coverage (27UpdatePlan.md M4: "no longer refuses anything") means no
//! world-guarded call site ever really suspends on first poll -- see its
//! own doc comment.
//!
//! Deliberately narrow, matching the single-service runner's own
//! disclosed scope: `publish` steps are not wired; `expect.quiescence`/
//! `drain` see one global undelivered-message buffer, not independent
//! per-`(subject, group)` cursors. Any scenario step this runner cannot
//! honor is a hard error on stdout/exit code, never a silently-skipped
//! no-op.

use std::collections::BTreeMap;
use std::sync::Arc;

use axum::body::Body;
use axum::http::Request;
use tower::ServiceExt;

{%- if services | selectattr("jobs") | list %}
use sim_shared::cron::CronSchedule;
{%- endif %}
use sim_shared::scenario::{ExpectStep, Principal, Scenario, ScenarioStep};
use sim_shared::world::SimWorld;

/// Matches `crate::json_out::SimScenarioOutcome` field-for-field
/// (`crates/ciac/src/json_out.rs`), same bounded child protocol as the
/// single-service Rust runner and the Python drivers.
#[derive(Debug, serde::Serialize)]
struct SimScenarioOutcome {
    scenario: String,
    passed: bool,
    error: Option<String>,
    worker_attempts: BTreeMap<String, u32>,
    job_runs: BTreeMap<String, u32>,
}

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    let scenario_path = std::env::args()
        .nth(1)
        .ok_or_else(|| anyhow::anyhow!("usage: system-runner <scenario.json>"))?;
    let json = std::fs::read_to_string(&scenario_path)
        .map_err(|e| anyhow::anyhow!("reading {scenario_path}: {e}"))?;
    let scenario = Scenario::parse(&json).map_err(|e| anyhow::anyhow!("{e}"))?;
    scenario.validate().map_err(|e| anyhow::anyhow!("{e}"))?;
    let name = scenario.name.clone();

    let mut runner = Runner::new(&scenario).await?;
    let outcome = match runner.run(&scenario).await {
        Ok(()) => SimScenarioOutcome {
            scenario: name,
            passed: true,
            error: None,
            worker_attempts: runner.worker_attempts,
            job_runs: runner.job_runs,
        },
        Err(err) => SimScenarioOutcome {
            scenario: name,
            passed: false,
            error: Some(format!("{err:#}")),
            worker_attempts: runner.worker_attempts,
            job_runs: runner.job_runs,
        },
    };
    println!("{}", serde_json::to_string(&outcome)?);
    Ok(())
}

/// Polls `fut` exactly once with a no-op waker instead of parking a
/// thread -- sound here (and only here) because every world-guarded
/// call site this system-runner ever drives resolves on its first poll:
/// simulation mode routes every db/queue/cache/... verb through
/// `SimWorld`'s synchronous fakes, never a real awaited I/O call, so the
/// `async fn` chain a routed `call <Service>.<Api>` re-enters (however
/// many hops deep) never actually suspends. `world.register_api`'s
/// handler type is a plain synchronous `Fn(Value) -> anyhow::Result
/// <Value>` (it must be, to stay callable from `call_checked`'s own
/// synchronous body without making that a general-purpose executor), so
/// this is what makes an `async fn` dispatch usable as one of its
/// handlers at all -- a `Poll::Pending` here means a real await point
/// was reached, which full simulation coverage should never cause; that
/// case panics rather than silently blocking forever.
fn block_on_ready<F: std::future::Future>(fut: F) -> F::Output {
    use std::task::{Context, Poll, RawWaker, RawWakerVTable, Waker};
    fn no_op(_: *const ()) {}
    fn clone(_: *const ()) -> RawWaker {
        RawWaker::new(std::ptr::null(), &VTABLE)
    }
    static VTABLE: RawWakerVTable = RawWakerVTable::new(clone, no_op, no_op, no_op);
    let raw = RawWaker::new(std::ptr::null(), &VTABLE);
    let waker = unsafe { Waker::from_raw(raw) };
    let mut cx = Context::from_waker(&waker);
    let mut fut = Box::pin(fut);
    match fut.as_mut().poll(&mut cx) {
        Poll::Ready(value) => value,
        Poll::Pending => unreachable!(
            "system-runner: a routed call did not resolve synchronously under simulation \
             (a real await point was reached, which full SimWorld coverage should never cause)"
        ),
    }
}

struct Runner {
    world: Arc<SimWorld>,
{%- for svc in services %}
    // Not every service's own `_state` is necessarily read again after
    // `Runner::new` registers its apis on the shared world -- a service
    // reachable only via a routed `call <Service>.<Api>` from another
    // service (never a scenario `request` step or worker/job of its
    // own) has its state cloned into that registration closure and
    // never touched through `self` again, mirroring the single-service
    // runner's own `#[allow(dead_code)]` on its analogous `state` field.
    #[allow(dead_code)]
    {{ svc.module }}_state: {{ svc.module }}::state::AppState,
{%- endfor %}
    now_ms: i64,
    saved: BTreeMap<String, (u16, serde_json::Value)>,
    worker_attempts: BTreeMap<String, u32>,
    job_runs: BTreeMap<String, u32>,
}

impl Runner {
    async fn new(scenario: &Scenario) -> anyhow::Result<Self> {
        // 27UpdatePlan.md M4 / 28UpdatePlan.md M6c: schema facts computed
        // once at codegen time, table names namespaced `"{service}::
        // {table}"` exactly like `lower.rs`'s own `world_table_key`, so
        // reference/unique/cascade checks can never drift or collide
        // across two same-named tables in different services.
        let world = Arc::new(SimWorld::with_schema(
            scenario.given.failures.clone(),
            vec![
{%- for table in sim_world_tables %}
                sim_shared::world::WorldTable {
                    name: "{{ table.name }}".to_owned(),
                    references: vec![
{%- for reference in table.references %}
                        sim_shared::world::WorldReference {
                            field_name: "{{ reference.field_name }}".to_owned(),
                            target_table: {% if reference.target_table %}Some("{{ reference.target_table }}".to_owned()){% else %}None{% endif %},
                            on_delete: sim_shared::world::WorldRefAction::{{ reference.on_delete }},
                            unique: {{ reference.unique }},
                        },
{%- endfor %}
                    ],
                },
{%- endfor %}
            ],
        ));
        let now_ms = chrono::DateTime::parse_from_rfc3339(&scenario.start_at)
            .map_err(|e| anyhow::anyhow!("scenario start_at {:?}: {e}", scenario.start_at))?
            .timestamp_millis();
        world.advance_clock_to(now_ms);
        for seed in &scenario.given.db {
            let key = SimWorld::namespaced_table_key(Some(&seed.service), &seed.table);
            for row in &seed.rows {
                world.db.insert(&key, row.clone());
            }
        }
        for entry in &scenario.given.cache {
            let ttl_ms = entry.ttl.as_deref().map(parse_duration_ms).transpose()?;
            world.cache_set(
                &entry.instance,
                &entry.key,
                serde_json::to_string(&entry.value)?,
                ttl_ms,
            );
        }
        for obj in &scenario.given.store {
            use base64::Engine;
            let body = base64::engine::general_purpose::STANDARD
                .decode(&obj.value_base64)
                .map_err(|e| anyhow::anyhow!("given.store {:?}: {e}", obj.key))?;
            world.object_put(&obj.instance, &obj.key, body);
        }
        for doc in &scenario.given.search {
            world.search_index(&doc.instance, &doc.id, doc.doc.clone());
        }
        for fixture in &scenario.given.external_http {
            world.seed_http_fixtures(&fixture.instance, fixture.responses.clone());
        }

{%- for svc in services %}
        let {{ svc.module }}_config = {{ svc.module }}::config::Config::from_env();
{%- if svc.has_db or svc.has_queue or svc.has_cache or svc.has_object_store or svc.has_email or svc.has_search or svc.has_external_http or svc.has_auth or svc.call_targets %}
        let {{ svc.module }}_state =
            {{ svc.module }}::state::AppState::simulation({{ svc.module }}_config, world.clone()).await?;
{%- else %}
        let {{ svc.module }}_state = {{ svc.module }}::state::AppState::new({{ svc.module }}_config).await?;
{%- endif %}
{%- endfor %}

        // Registers every api in every service, in declaration order,
        // before any scenario step runs -- an api reachable only via a
        // routed `call <Service>.<Api>` from another service (never the
        // target of a scenario `request` step in its own right) still
        // needs an entry here or that call has no handler to route to
        // (mirrors `multi_driver.py`'s own api-registration loop and its
        // documented reason for covering every api, not just the ones a
        // scenario's own `request` steps name).
{%- for svc in services %}
{%- for api in svc.apis %}
        {
            let world = world.clone();
            let state = {{ svc.module }}_state.clone();
            world.register_api(
                "{{ svc.service_name }}",
                "{{ api.name }}",
                std::sync::Arc::new(move |req: serde_json::Value| -> anyhow::Result<serde_json::Value> {
                    let app = {{ svc.module }}::routes::router().with_state(state.clone());
                    block_on_ready(async move {
                        let request = Request::builder()
                            .method(axum::http::Method::{{ api.method_upper }})
                            .uri("{{ api.route }}")
                            .header(axum::http::header::CONTENT_TYPE, "application/json")
                            .body(Body::from(serde_json::to_vec(&req)?))?;
                        let response = app
                            .oneshot(request)
                            .await
                            .map_err(|err| anyhow::anyhow!("{err}"))?;
                        let status = response.status().as_u16();
                        let body = axum::body::to_bytes(response.into_body(), usize::MAX).await?;
                        let json: serde_json::Value = if body.is_empty() {
                            serde_json::Value::Null
                        } else {
                            serde_json::from_slice(&body).unwrap_or_else(|_| {
                                serde_json::Value::String(String::from_utf8_lossy(&body).into_owned())
                            })
                        };
                        if status >= 400 {
                            anyhow::bail!(
                                "routed call to {{ svc.service_name }}.{{ api.name }} failed with \
                                 status {status}: {json}"
                            );
                        }
                        Ok(json)
                    })
                }),
            );
            let _ = &world;
        }
{%- endfor %}
{%- endfor %}

        Ok(Self {
            world,
{%- for svc in services %}
            {{ svc.module }}_state,
{%- endfor %}
            now_ms,
            saved: BTreeMap::new(),
            worker_attempts: BTreeMap::new(),
            job_runs: BTreeMap::new(),
        })
    }

    async fn run(&mut self, scenario: &Scenario) -> anyhow::Result<()> {
        for step in &scenario.steps {
            match step {
                ScenarioStep::Request(spec) => self.request(spec).await?,
                ScenarioStep::Publish(_) => anyhow::bail!(
                    "system-runner does not yet support `publish` steps (matching the \
                     single-service Rust runner's own disclosed scope)"
                ),
                ScenarioStep::Advance(spec) => self.advance(&spec.by).await?,
                ScenarioStep::Drain(_) => self.drain().await?,
                ScenarioStep::Expect(spec) => self.expect(spec)?,
            }
        }
        let unmatched = self.world.unmatched_failure_rules();
        if !unmatched.is_empty() {
            anyhow::bail!(
                "{} failure rule(s) declared in `given.failures` never matched a real \
                 occurrence: {unmatched:?}",
                unmatched.len()
            );
        }
        Ok(())
    }

    /// A `request` step never carries a scenario-level `as` principal
    /// for a routed `call` (matching production: the real HTTP call a
    /// `call <Service>.<Api>` step issues carries no caller identity
    /// either) -- but it does for a direct `request` step, issued here
    /// exactly like the single-service runner's own `request` method.
    async fn request(&mut self, spec: &sim_shared::scenario::RequestStep) -> anyhow::Result<()> {
        let (status, json) = match (spec.service.as_str(), spec.api.as_str()) {
{%- for svc in services %}
{%- for api in svc.apis %}
            ("{{ svc.service_name }}", "{{ api.name }}") => {
                let app = {{ svc.module }}::routes::router().with_state(self.{{ svc.module }}_state.clone());
                self.dispatch(
                    app,
                    axum::http::Method::{{ api.method_upper }},
                    "{{ api.route }}",
                    spec.principal.as_ref(),
                    &spec.json,
                )
                .await?
            }
{%- endfor %}
{%- endfor %}
            (service, api) => anyhow::bail!(
                "system-runner: no api registered for {service}.{api}"
            ),
        };
        if let Some(save_as) = &spec.save_as {
            self.saved.insert(save_as.clone(), (status, json));
        }
        Ok(())
    }

    /// Shared HTTP-shaped dispatch every `request` match arm above
    /// funnels through -- factored out because `Router::with_state`
    /// always yields the same `Router` (state type erased once bound),
    /// so this needs no generic parameter despite each service having
    /// its own distinct `AppState` type.
    async fn dispatch(
        &self,
        app: axum::Router,
        method: axum::http::Method,
        path: &str,
        principal: Option<&Principal>,
        payload: &serde_json::Value,
    ) -> anyhow::Result<(u16, serde_json::Value)> {
        let mut request_builder = Request::builder()
            .method(method)
            .uri(path)
            .header(axum::http::header::CONTENT_TYPE, "application/json");
        if let Some(principal) = principal {
            let token = format!("sim:{}:{}", principal.sub, principal.scopes.join(","));
            self.world.auth_issue(
                &token,
                serde_json::json!({"sub": principal.sub, "scope": principal.scopes.join(" ")}),
                None,
            );
            request_builder = request_builder
                .header(axum::http::header::AUTHORIZATION, format!("Bearer {token}"));
        }
        let request = request_builder.body(Body::from(serde_json::to_vec(payload)?))?;
        let response = app
            .oneshot(request)
            .await
            .map_err(|err| anyhow::anyhow!("{err}"))?;
        let status = response.status().as_u16();
        let body = axum::body::to_bytes(response.into_body(), usize::MAX).await?;
        let json = if body.is_empty() {
            serde_json::Value::Null
        } else {
            serde_json::from_slice(&body)
                .unwrap_or_else(|_| serde_json::Value::String(String::from_utf8_lossy(&body).into_owned()))
        };
        Ok((status, json))
    }

    async fn advance(&mut self, by: &str) -> anyhow::Result<()> {
        let delta_ms = parse_duration_ms(by)?;
        let from_ms = self.now_ms;
        let to_ms = from_ms + delta_ms;
{%- for svc in services %}
{%- for job in svc.jobs %}
        {
            let schedule = CronSchedule::parse({{ svc.module }}::workers::{{ job.snake }}::SCHEDULE)
                .map_err(|e| anyhow::anyhow!("job {{ job.name }} schedule: {e}"))?;
            for _fire_ms in schedule.due_instants(from_ms, to_ms, 10_000) {
                {{ svc.module }}::workers::{{ job.snake }}::handle_tick_once(&self.{{ svc.module }}_state).await?;
                *self
                    .job_runs
                    .entry("{{ job.name }}".to_owned())
                    .or_insert(0) += 1;
            }
        }
{%- endfor %}
{%- endfor %}
        self.now_ms = to_ms;
        self.world.advance_clock_to(to_ms);
        Ok(())
    }

    /// One pass across every service's own workers, same per-`(subject,
    /// group)` cursor semantics as the single-service runner's own
    /// `drain` (see its doc comment) -- a subject no registered worker
    /// (in *any* service) drains is refused, not left to sit undelivered
    /// forever.
    async fn drain(&mut self) -> anyhow::Result<()> {
{%- for svc in services %}
{%- for worker in svc.workers %}
{%- if worker.steps %}
        for raw in self
            .world
            .broker
            .drain({{ svc.module }}::workers::{{ worker.snake }}::SUBJECT, {{ svc.module }}::workers::{{ worker.snake }}::QUEUE_GROUP)
        {
            let payload: {% if worker.payload %}{{ svc.module }}::schemas::{{ worker.payload.class_name }}{% else %}serde_json::Value{% endif %} =
                serde_json::from_slice(&raw)?;
            let mut attempts = 0u32;
            for attempt in 0..={{ svc.module }}::workers::{{ worker.snake }}::MAX_RETRIES {
                attempts += 1;
                match {{ svc.module }}::workers::{{ worker.snake }}::handle_message_once(&self.{{ svc.module }}_state, payload.clone()).await {
                    Ok(()) => break,
                    Err(err) if attempt < {{ svc.module }}::workers::{{ worker.snake }}::MAX_RETRIES => {
                        tracing::warn!(?err, attempt, "system-runner: retrying {{ svc.service_name }}.{{ worker.name }}");
                    }
                    Err(err) => {
                        tracing::error!(?err, "system-runner: {{ svc.service_name }}.{{ worker.name }} exhausted retries");
                    }
                }
            }
            *self
                .worker_attempts
                .entry("{{ worker.name }}".to_owned())
                .or_insert(0) += attempts;
        }
{%- endif %}
{%- endfor %}
{%- endfor %}
        for (subject, _raw) in self.world.queue.take_all() {
{%- if not has_drain_workers %}
            anyhow::bail!(
                "system-runner: no worker registered to consume subject {subject:?} \
                 (matching the single-service Rust runner's own disclosed scope)"
            );
{%- else %}
{%- set ns = namespace(any=false) %}
{%- for svc in services %}
{%- for worker in svc.workers %}
{%- if worker.steps %}
            {% if not ns.any %}if{% else %}else if{% endif %} subject == {{ svc.module }}::workers::{{ worker.snake }}::SUBJECT {
                // Already drained via `world.broker` above.
            }
            {%- set ns.any = true %}
{%- endif %}
{%- endfor %}
{%- endfor %}
            else {
                anyhow::bail!(
                    "system-runner: no worker registered to consume subject {subject:?} \
                     (matching the single-service Rust runner's own disclosed scope)"
                );
            }
{%- endif %}
        }
        Ok(())
    }

    fn expect(&self, spec: &ExpectStep) -> anyhow::Result<()> {
        match spec {
            ExpectStep::Response { of, status, json } => {
                let of = of
                    .as_deref()
                    .ok_or_else(|| anyhow::anyhow!("expect.response requires \"of\""))?;
                let (got_status, got_json) = self.saved.get(of).ok_or_else(|| {
                    anyhow::anyhow!("expect.response.of references unknown save_as {of:?}")
                })?;
                if let Some(want_status) = status {
                    if got_status != want_status {
                        anyhow::bail!(
                            "expect.response.of={of:?}: expected status {want_status}, got \
                             {got_status}"
                        );
                    }
                }
                if let Some(want_json) = json {
                    if got_json != want_json {
                        anyhow::bail!(
                            "expect.response.of={of:?}: expected json {want_json}, got {got_json}"
                        );
                    }
                }
                Ok(())
            }
            ExpectStep::Row {
                service,
                table,
                matches,
                present,
            } => {
                let key = SimWorld::namespaced_table_key(Some(service), table);
                let found = !self.world.db.find_where(&key, matches).is_empty();
                if found != *present {
                    anyhow::bail!(
                        "expect.row: service={service:?} table={table:?} where={matches:?} \
                         present={present}, found={found}"
                    );
                }
                Ok(())
            }
            ExpectStep::WorkerAttempts { worker, count } => {
                let actual = self.worker_attempts.get(worker).copied().unwrap_or(0);
                if actual != *count {
                    anyhow::bail!(
                        "expect.worker_attempts: worker={worker:?} expected {count}, got {actual}"
                    );
                }
                Ok(())
            }
            ExpectStep::JobRuns { job, count } => {
                let actual = self.job_runs.get(job).copied().unwrap_or(0);
                if actual != *count {
                    anyhow::bail!("expect.job_runs: job={job:?} expected {count}, got {actual}");
                }
                Ok(())
            }
            ExpectStep::Quiescence {} => {
                if !self.world.queue.is_empty() {
                    anyhow::bail!(
                        "expect.quiescence: undelivered message(s) remain in the simulated broker"
                    );
                }
                Ok(())
            }
            ExpectStep::Email {
                to,
                subject_contains,
                count,
            } => {
                let actual = self
                    .world
                    .email_sent_count_all(to.as_deref(), subject_contains.as_deref());
                if actual != *count as usize {
                    anyhow::bail!(
                        "expect.email: to={to:?} subject_contains={subject_contains:?} \
                         expected {count}, got {actual}"
                    );
                }
                Ok(())
            }
            ExpectStep::Cache {
                instance,
                key,
                present,
                value,
            } => {
                let cached = self.world.cache_get(instance, key);
                let found = cached.is_some();
                if found != *present {
                    anyhow::bail!(
                        "expect.cache: instance={instance:?} key={key:?} expected \
                         present={present}, found present={found}"
                    );
                }
                if let Some(want) = value {
                    let actual: Option<serde_json::Value> =
                        cached.map(|s| serde_json::from_str(&s)).transpose()?;
                    if actual.as_ref() != Some(want) {
                        anyhow::bail!(
                            "expect.cache: instance={instance:?} key={key:?} expected \
                             value={want:?}, got {actual:?}"
                        );
                    }
                }
                Ok(())
            }
            ExpectStep::Object {
                store,
                key,
                present,
            } => {
                let found = self.world.object_exists(store, key);
                if found != *present {
                    anyhow::bail!(
                        "expect.object: store={store:?} key={key:?} expected \
                         present={present}, found present={found}"
                    );
                }
                Ok(())
            }
            ExpectStep::SearchHits {
                instance,
                query,
                count,
            } => {
                let actual = self.world.search_query(instance, query).len();
                if actual != *count as usize {
                    anyhow::bail!(
                        "expect.search_hits: instance={instance:?} query={query:?} \
                         expected {count}, got {actual}"
                    );
                }
                Ok(())
            }
            ExpectStep::HttpCalls { instance, count } => {
                let actual = self.world.http_request_count(instance);
                if actual != *count as usize {
                    anyhow::bail!(
                        "expect.http_calls: instance={instance:?} expected {count}, got {actual}"
                    );
                }
                Ok(())
            }
        }
    }
}

/// Parses `advance.by` strings (`"24h"`, `"7d"`, `"30m"`, ...) -- same
/// small duration grammar as the single-service runner and `sim/pyrunner/
/// cron.py`'s `parse_duration_ms`.
fn parse_duration_ms(text: &str) -> anyhow::Result<i64> {
    let split_at = text
        .find(|c: char| !c.is_ascii_digit())
        .ok_or_else(|| anyhow::anyhow!("unrecognized duration: {text:?}"))?;
    let (value, unit) = text.split_at(split_at);
    let value: i64 = value
        .parse()
        .map_err(|_| anyhow::anyhow!("unrecognized duration: {text:?}"))?;
    let unit_ms: i64 = match unit {
        "ms" => 1,
        "s" => 1_000,
        "m" => 60_000,
        "h" => 3_600_000,
        "d" => 86_400_000,
        other => anyhow::bail!("unrecognized duration unit {other:?} in {text:?}"),
    };
    Ok(value * unit_ms)
}
