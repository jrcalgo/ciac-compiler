//! Worker pipeline for `worker {{ worker.name }}`. Generated by CIaC.
//!
//! Consumes `{{ worker.subject }}` in queue group `{{ worker.queue_group }}`
//! so replicas of this worker load-balance messages between them.

{% if c.queue_engine != "kafka" -%}
use futures::StreamExt;
{% endif -%}
use futures::future::try_join_all;
{%- if c.has_tracing %}
use tracing::Instrument;
use tracing_opentelemetry::OpenTelemetrySpanExt;
{%- endif %}

{% if worker.payload -%}
use crate::schemas::{{ worker.payload.class_name }};
{% endif -%}
{% for handler in worker.handlers -%}
use crate::{{ handler.handler_package }}::{{ handler.module }}::{{ handler.class_name }};
{% endfor -%}
use crate::state::AppState;

pub const SUBJECT: &str = "{{ worker.subject }}";
pub const QUEUE_GROUP: &str = "{{ worker.queue_group }}";
pub const CONCURRENCY: usize = {{ worker.concurrency }};
pub const MAX_RETRIES: u32 = {{ worker.max_retries }};
{% set payload_type = worker.payload.class_name if worker.payload else "serde_json::Value" %}
pub async fn run(state: AppState) -> anyhow::Result<()> {
    let tasks = (0..CONCURRENCY).map(|worker_index| {
        let state = state.clone();
        tokio::spawn(async move { consume(state, worker_index).await })
    });
    for result in try_join_all(tasks).await? {
        result?;
    }
    Ok(())
}

{% if c.queue_engine == "kafka" -%}
async fn consume(state: AppState, worker_index: usize) -> anyhow::Result<()> {
{%- if c.has_tracing %}
    use rdkafka::message::Headers as _;
{%- endif %}
    use rdkafka::Message;
    let consumer = state
        .queue
        .consumer(&state.config.kafka_url, SUBJECT, QUEUE_GROUP)?;
    tracing::info!(subject = SUBJECT, worker_index, "worker {{ worker.name }} consuming");
    loop {
        let message = match consumer.recv().await {
            Ok(message) => message,
            Err(err) => {
                tracing::warn!(?err, "kafka receive error");
                continue;
            }
        };
{%- if c.has_tracing %}
        let mut carrier = crate::queue::TraceCarrier(std::collections::HashMap::new());
        if let Some(headers) = message.headers() {
            for header in headers.iter() {
                if let Some(Ok(value)) = header.value.map(std::str::from_utf8) {
                    carrier.0.insert(header.key.to_owned(), value.to_owned());
                }
            }
        }
{%- endif %}
        let Some(bytes) = message.payload() else {
            continue;
        };
        let payload: {{ payload_type }} = match serde_json::from_slice(bytes) {
            Ok(payload) => payload,
            Err(err) => {
                tracing::warn!(?err, "discarding malformed message");
                continue;
            }
        };
{%- if c.has_tracing %}
        let parent_ctx =
            opentelemetry::global::get_text_map_propagator(|propagator| propagator.extract(&carrier));
        let span = tracing::info_span!("worker.{{ worker.name }}");
        let _ = span.set_parent(parent_ctx);
        if let Err(err) = handle_message(&state, payload).instrument(span).await {
            tracing::error!(?err, "message processing failed after retries");
        }
{%- else %}
        if let Err(err) = handle_message(&state, payload).await {
            tracing::error!(?err, "message processing failed after retries");
        }
{%- endif %}
    }
}
{%- else -%}
async fn consume(state: AppState, worker_index: usize) -> anyhow::Result<()> {
    let mut subscription = state.queue.queue_subscribe(SUBJECT, QUEUE_GROUP).await?;
    tracing::info!(subject = SUBJECT, worker_index, "worker {{ worker.name }} consuming");
    while let Some(message) = subscription.next().await {
        let payload: {{ payload_type }} = match serde_json::from_slice(&message.payload) {
            Ok(payload) => payload,
            Err(err) => {
                tracing::warn!(?err, "discarding malformed message");
                continue;
            }
        };
{%- if c.has_tracing %}
        let mut carrier = crate::queue::TraceCarrier(std::collections::HashMap::new());
        if let Some(headers) = &message.headers {
            for (key, values) in headers.iter() {
                if let Some(value) = values.first() {
                    carrier.0.insert(key.to_string(), value.to_string());
                }
            }
        }
        let parent_ctx =
            opentelemetry::global::get_text_map_propagator(|propagator| propagator.extract(&carrier));
        let span = tracing::info_span!("worker.{{ worker.name }}");
        let _ = span.set_parent(parent_ctx);
        if let Err(err) = handle_message(&state, payload).instrument(span).await {
            tracing::error!(?err, "message processing failed after retries");
        }
{%- else %}
        if let Err(err) = handle_message(&state, payload).await {
            tracing::error!(?err, "message processing failed after retries");
        }
{%- endif %}
    }
    Ok(())
}
{%- endif %}

{% macro emit_steps(steps, indent) -%}
{%- for step in steps %}
{%- if step.kind == "handler" %}
{{ indent }}let result = {{ step.handler.class_name }}::new(state).handle(result).await?;
{%- elif step.kind == "publish" %}
{{ indent }}state
{{ indent }}    .publish("{{ step.subject }}", serde_json::to_vec(&result)?)
{{ indent }}    .await?;
{%- elif step.kind == "call" %}
{{ indent }}let result = crate::clients::{{ step.call.module }}::{{ step.call.class_name }}::new(state)
{{ indent }}    .{{ step.call.method }}(result)
{{ indent }}    .await?;
{%- elif step.kind == "match" %}
{{ indent }}let result = match result.{{ step.field }} {
{%- for arm in step.arms %}
{%- if arm.rust_variant %}
{{ indent }}    {{ arm.rust_variant }} => {
{%- else %}
{{ indent }}    _ => {
{%- endif %}
{{ emit_steps(arm.steps, indent ~ "        ") }}
{{ indent }}        result
{{ indent }}    }
{%- endfor %}
{{ indent }}};
{%- endif %}
{%- endfor %}
{%- endmacro %}

{% if worker.steps -%}
async fn handle_message(state: &AppState, payload: {{ payload_type }}) -> anyhow::Result<()> {
    for attempt in 0..=MAX_RETRIES {
        match handle_message_once(state, payload.clone()).await {
            Ok(()) => return Ok(()),
            Err(err) if attempt < MAX_RETRIES => {
                tracing::warn!(?err, attempt, "message processing failed; retrying");
            }
            Err(err) => return Err(err),
        }
    }
    Ok(())
}

async fn handle_message_once(state: &AppState, payload: {{ payload_type }}) -> anyhow::Result<()> {
    let result = payload;
{{ emit_steps(worker.steps, "    ") }}
    let _ = result;
    Ok(())
}
{%- else -%}
async fn handle_message(_state: &AppState, payload: {{ payload_type }}) -> anyhow::Result<()> {
    // TODO: process messages consumed by {{ worker.name }}.
    let _ = payload;
    Ok(())
}
{%- endif %}
