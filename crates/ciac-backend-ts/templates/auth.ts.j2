// Authentication and scope enforcement. Generated by CIaC.
//
// `Auth` pipeline steps call `verifyToken` before the rest of the
// pipeline runs; an `api`/`crud` scope calls `requireScope` right
// after. `AuthError` carries a real `statusCode` (401/403) — Fastify
// natively respects a thrown error's own `statusCode` property (live-
// verified), so no `setErrorHandler` is needed just for this: the
// same disclosed gap Python's/Rust's own domain-error-to-HTTP-status
// mapping has (a *scope* check is mechanism, not a business-error
// mapping) doesn't apply here.

{%- if c.auth_scheme == "oauth2" %}
import { createRemoteJWKSet, jwtVerify } from "jose";
{%- else %}
import { jwtVerify } from "jose";
{%- endif %}
import type { FastifyRequest } from "fastify";
import type { Config } from "./config.js";

export class AuthError extends Error {
  constructor(
    readonly statusCode: number,
    message: string,
  ) {
    super(message);
  }
}

/** Verified JWT claims of the current request — an open bag of
    whatever the token carries, same as Python's/Rust's own untyped
    claims dict/`serde_json::Value`. */
export type Claims = Record<string, unknown>;

{%- if c.auth_scheme == "oauth2" %}
// Fetched lazily on first use and cached by `jose` itself — mirroring
// every other lazy provider client (db pools, redis, the broker
// client): constructing `AppState` never makes a network call, so a
// route that never checks a token never needs the issuer reachable.
let jwks: ReturnType<typeof createRemoteJWKSet> | undefined;
function getJwks(config: Config): ReturnType<typeof createRemoteJWKSet> {
  jwks ??= createRemoteJWKSet(
    new URL(`${config.oauth_issuer.replace(/\/$/, "")}/.well-known/jwks.json`),
  );
  return jwks;
}
{%- endif %}

export async function verifyToken(request: FastifyRequest, config: Config): Promise<Claims> {
  const header = request.headers.authorization;
  if (!header?.startsWith("Bearer ")) {
    throw new AuthError(401, "missing bearer token");
  }
  const token = header.slice("Bearer ".length);
  try {
{%- if c.auth_scheme == "oauth2" %}
    const { payload } = await jwtVerify(token, getJwks(config), {
      algorithms: ["RS256"],
      issuer: config.oauth_issuer,
      audience: config.oauth_audience || undefined,
    });
{%- else %}
    const { payload } = await jwtVerify(token, new TextEncoder().encode(config.jwt_secret), {
      algorithms: ["HS256"],
    });
{%- endif %}
    return payload;
  } catch {
    throw new AuthError(401, "invalid or expired token");
  }
}

/** `scope`/`scp` (space-joined string or array — both conventions
    appear across real issuers), mirroring Python's/Rust's own
    two-shape check exactly. */
export function requireScope(claims: Claims, scope: string): void {
  const scopeClaim = claims.scope;
  const scopes =
    typeof scopeClaim === "string"
      ? scopeClaim.split(/\s+/)
      : Array.isArray(claims.scp)
        ? claims.scp.filter((s): s is string => typeof s === "string")
        : [];
  if (!scopes.includes(scope)) {
    throw new AuthError(403, "missing required scope");
  }
}
