// Realtime channel for `channel {{ channel.name }}`. Generated by CIaC.
//
// No app-level broadcast bookkeeping: on NATS, every connection opens
// its own plain (non-queue-group) subscription, and NATS delivers a
// copy of every message to every plain subscriber — that alone is the
// whole fan-out mechanism. On Kafka, every connection is instead given
// its own unique, ephemeral consumer group (Kafka's own group
// semantics would otherwise load-balance connections like a worker).

{%- if c.queue_engine == "kafka" %}
import { randomUUID } from "node:crypto";
{%- endif %}
import type { FastifyPluginAsync } from "fastify";
{%- if channel.provider == "websocket" %}
import websocketPlugin from "@fastify/websocket";
{%- endif %}
import type { AppState } from "../state.js";

export const {{ channel.snake }}Route: FastifyPluginAsync<{ state: AppState }> = async (
  app,
  { state },
) => {
{%- if channel.provider == "websocket" %}
  await app.register(websocketPlugin);
  app.get("{{ channel.path }}", { websocket: true }, (socket) => {
    void (async () => {
{%- if c.queue_engine == "kafka" %}
      const consumer = await state.queue.consumer(
        "{{ channel.subject }}",
        `channel-{{ channel.snake }}-${randomUUID()}`,
      );
      await consumer.run({
        eachMessage: async ({ message }) => {
          if (message.value === null) return;
          socket.send(message.value.toString("utf8"));
        },
      });
{%- else %}
      const sub = await state.queue.subscribe("{{ channel.subject }}");
      for await (const msg of sub) {
        if (socket.readyState !== socket.OPEN) break;
        socket.send(Buffer.from(msg.data).toString("utf8"));
      }
{%- endif %}
    })();
  });
{%- else %}
  app.get("{{ channel.path }}", async (request, reply) => {
    reply.raw.writeHead(200, {
      "content-type": "text/event-stream",
      "cache-control": "no-cache",
      connection: "keep-alive",
    });
{%- if c.queue_engine == "kafka" %}
    const consumer = await state.queue.consumer(
      "{{ channel.subject }}",
      `channel-{{ channel.snake }}-${randomUUID()}`,
    );
    await consumer.run({
      eachMessage: async ({ message }) => {
        if (message.value === null) return;
        reply.raw.write(`data: ${message.value.toString("utf8")}\n\n`);
      },
    });
{%- else %}
    const sub = await state.queue.subscribe("{{ channel.subject }}");
    for await (const msg of sub) {
      if (reply.raw.destroyed) break;
      reply.raw.write(`data: ${Buffer.from(msg.data).toString("utf8")}\n\n`);
    }
{%- endif %}
  });
{%- endif %}
};
