// Runtime configuration for {{ c.service_name }}. Generated by CIaC.
//
// Every value can be overridden through the environment; defaults
// target local development. No I/O happens at import time (env vars
// are read once, at `loadConfig()` call time, not at module load).

export interface Config {
{%- for inst in c.db_instances %}
  {{ inst.url_field }}: string;
{%- endfor %}
{%- for inst in c.cache_instances %}
  {{ inst.url_field }}: string;
{%- endfor %}
{%- if c.queue_engine == "kafka" %}
  kafkaUrl: string;
{%- elif c.queue_engine == "nats" %}
  natsUrl: string;
{%- endif %}
{%- for t in c.call_targets %}
  {{ t.url_field }}: string;
{%- endfor %}
{%- if not c.db_instances and not c.cache_instances and not c.queue_engine and not c.call_targets %}
  placeholder?: never;
{%- endif %}
}

export function loadConfig(): Config {
  return {
{%- for inst in c.db_instances %}
    {{ inst.url_field }}: envOr(
      "{{ inst.env_var }}",
      "{% if inst.db_engine == "mysql" %}mysql://{{ inst.db_user }}:{{ inst.db_user }}@localhost:3306/{{ inst.db_name }}{% elif inst.db_engine == "sqlite" %}file:data/{{ inst.db_name }}.db{% else %}postgres://{{ inst.db_user }}:{{ inst.db_user }}@localhost:5432/{{ inst.db_name }}{% endif %}",
    ),
{%- endfor %}
{%- for inst in c.cache_instances %}
    {{ inst.url_field }}: envOr("{{ inst.env_var }}", "redis://localhost:6379/{{ inst.redis_db }}"),
{%- endfor %}
{%- if c.queue_engine == "kafka" %}
    kafkaUrl: envOr("KAFKA_URL", "localhost:9092"),
{%- elif c.queue_engine == "nats" %}
    natsUrl: envOr("NATS_URL", "nats://localhost:4222"),
{%- endif %}
{%- for t in c.call_targets %}
    {{ t.url_field }}: envOr("{{ t.env_var }}", "{{ t.default_url }}"),
{%- endfor %}
  };
}

function envOr(key: string, fallback: string): string {
  return process.env[key] ?? fallback;
}
{%- if not c.db_instances and not c.cache_instances and not c.queue_engine and not c.call_targets %}

// `envOr` is unused until a capability instance needs an
// environment-driven field — kept here, not deleted-then-reintroduced,
// since every later milestone's config fields read through it.
void envOr;
{%- endif %}
