// Database schema management. Generated by CIaC.
//
// CRUD-resource tables are created (IF NOT EXISTS) on startup from
// hand-written per-engine DDL — Drizzle has no declarative-sync API
// outside drizzle-kit, so this is the TS analog of Python's
// `Base.metadata.create_all`/Rust's `ensure_schema_<engine>`. `table`
// declarations are provisioned by `runMigrations` instead, applying
// `migrations/*.sql` files generated by `ciac build`'s additive-only
// schema differ, each at most once, tracked in `_ciac_migrations` —
// the same runner shape Python generates.

{%- if c.tables %}
import { readdirSync, readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
{%- endif %}
import type { AppState } from "./state.js";

{% macro data_ddl(engine) -%}
{%- if engine == "postgres" -%}
JSONB
{%- elif engine == "mysql" -%}
JSON
{%- else -%}
TEXT
{%- endif -%}
{%- endmacro %}

{% if c.resources %}
export async function ensureSchema(state: AppState): Promise<void> {
{%- for resource in c.resources %}
  {
    const ddl = `CREATE TABLE IF NOT EXISTS {{ resource.plural }} (
  id {{ id_ddl_type(resource.db_engine) }} PRIMARY KEY{% if resource.record %}{% for field in resource.record.fields %}{% if field.name != "id" %},
  {{ field.name }} {{ (field | sql_ddl_type(resource.db_engine)) }} NOT NULL{% endif %}{% endfor %}{% else %},
  data {{ data_ddl(resource.db_engine) }} NOT NULL{% endif %}
)`;
{%- if resource.db_engine == "sqlite" %}
    state.{{ resource.rust_db_field }}.$client.exec(ddl);
{%- else %}
    await state.{{ resource.rust_db_field }}.$client.query(ddl);
{%- endif %}
  }
{%- endfor %}
}
{% endif %}
{% if c.tables %}
{%- set engine = c.table_db_engine %}
export async function runMigrations(state: AppState): Promise<void> {
  const client = state.{{ c.table_db_field }}.$client;
  const migrationsDir = fileURLToPath(new URL("../migrations", import.meta.url));

{%- if engine == "sqlite" %}
  client.exec(
    "CREATE TABLE IF NOT EXISTS _ciac_migrations (" +
      "name TEXT PRIMARY KEY, applied_at TEXT NOT NULL DEFAULT (datetime('now')))",
  );
  const applied = new Set(
    client
      .prepare("SELECT name FROM _ciac_migrations")
      .all()
      .map((row) => (row as { name: string }).name),
  );
{%- elif engine == "mysql" %}
  await client.query(
    "CREATE TABLE IF NOT EXISTS _ciac_migrations (" +
      "name VARCHAR(255) PRIMARY KEY, applied_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)",
  );
  const [appliedRows] = await client.query("SELECT name FROM _ciac_migrations");
  const applied = new Set((appliedRows as { name: string }[]).map((row) => row.name));
{%- else %}
  await client.query(
    "CREATE TABLE IF NOT EXISTS _ciac_migrations (" +
      "name TEXT PRIMARY KEY, applied_at TIMESTAMPTZ NOT NULL DEFAULT now())",
  );
  const appliedResult = await client.query("SELECT name FROM _ciac_migrations");
  const applied = new Set((appliedResult.rows as { name: string }[]).map((row) => row.name));
{%- endif %}

  const filenames = readdirSync(migrationsDir)
    .filter((name) => name.endsWith(".sql"))
    .sort();
  for (const filename of filenames) {
    if (applied.has(filename)) continue;
    const statements = readFileSync(`${migrationsDir}/${filename}`, "utf8")
      .split(";\n")
      .map((s) => s.trim())
      .filter((s) => s.length > 0);
{%- if engine == "sqlite" %}
    for (const statement of statements) {
      client.exec(statement);
    }
    client
      .prepare("INSERT INTO _ciac_migrations (name) VALUES (?)")
      .run(filename);
{%- elif engine == "mysql" %}
    for (const statement of statements) {
      await client.query(statement);
    }
    await client.query("INSERT INTO _ciac_migrations (name) VALUES (?)", [filename]);
{%- else %}
    for (const statement of statements) {
      await client.query(statement);
    }
    await client.query("INSERT INTO _ciac_migrations (name) VALUES ($1)", [filename]);
{%- endif %}
  }
}
{% endif %}
