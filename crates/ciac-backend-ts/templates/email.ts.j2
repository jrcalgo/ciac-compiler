// SMTP email sender. Generated by CIaC.
//
// Both `SMTP` and `SES` providers send over SMTP; for SES, point the
// `SMTP_*` variables at your SES SMTP endpoint and credentials.
// Defaults target the Mailpit container from the generated
// docker-compose, so sent mail is inspectable at
// http://localhost:8025. Holds configuration only; the transport is
// built per send, so the server starts (and compiles) without a
// running mail server.

import nodemailer from "nodemailer";

export class Email {
  constructor(
    private readonly host: string,
    private readonly port: string,
    private readonly username: string,
    private readonly password: string,
    private readonly sender: string,
    private readonly useTls: string,
  ) {}

  private transport() {
    return nodemailer.createTransport({
      host: this.host,
      port: Number(this.port),
      secure: this.useTls === "true",
      auth: this.username ? { user: this.username, pass: this.password } : undefined,
    });
  }

  async send(to: string, subject: string, body: string): Promise<void> {
    await this.transport().sendMail({ from: this.sender, to, subject, text: body });
  }
}
