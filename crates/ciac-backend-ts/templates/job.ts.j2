// Scheduled job for `job {{ job.name }}`. Generated by CIaC.
//
// `croner` parses the source 5-field cron expression directly and
// owns its own scheduling loop — no translation and no hand-rolled
// sleep-until-next code needed (unlike Rust's `cron` crate, which
// needs a leading seconds field and 1-7 weekdays).

{%- import "_steps.ts.j2" as steps %}
{%- if job.has_publish_step %}
import { publish } from "../queue.js";
{%- endif %}
{%- for h in job.handlers %}
import { {{ h.class_name }} } from "../services/{{ h.module }}.js";
{%- endfor %}
{%- for t in job.call_imports %}
import { {{ t.class_name }} } from "../clients/{{ t.module }}.js";
{%- endfor %}
import { Cron } from "croner";
import { logger } from "../observability.js";
import type { AppState } from "../state.js";

export const SCHEDULE = "{{ job.schedule }}";

const log = logger();

/**
 * Runs the pipeline exactly once for the current tick — the seam a
 * future simulation runner (v0.23 M9) drives directly on each
 * cron-due instant an `advance` step covers, mirroring
 * `handle_tick_once` in the Python/Rust backends.
 */
export async function handleTickOnce(state: AppState): Promise<void> {
{%- set mutable = job.steps | reassigns_result %}
  {% if mutable %}let{% else %}const{% endif %} result: unknown = {};
{%- for step in job.steps %}
{{ steps.emit_step(step, "  ") }}
{%- endfor %}
  // A job has no envelope to return `result` into (unlike an api
  // route) — this keeps the last step's reassignment a genuine use
  // rather than dead code; see worker.ts.j2's identical comment.
  void result;
}

export function run(state: AppState): Cron {
  return new Cron(SCHEDULE, async () => {
    try {
      await handleTickOnce(state);
    } catch (err) {
      log.error({ err, job: "{{ job.name }}" }, "job tick failed");
    }
  });
}
