// Application assembly for {{ c.service_name }}. Generated by CIaC.

import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import Fastify from "fastify";
import { loadConfig } from "./config.js";
{%- if c.resources or c.tables %}
import { {% if c.resources %}ensureSchema{% endif %}{% if c.resources and c.tables %}, {% endif %}{% if c.tables %}runMigrations{% endif %} } from "./db.js";
{%- endif %}
import {
  loggerOptions,
{%- if c.has_metrics %}
  metricsRegistry,
{%- endif %}
{%- if c.has_tracing %}
  configureTracing,
  fastifyOtelInstrumentation,
{%- endif %}
} from "./observability.js";
import { createState, type AppState } from "./state.js";
{%- for api in c.apis %}
import { {{ api.snake }}Route } from "./routes/{{ api.snake }}.js";
{%- endfor %}
{%- for resource in c.resources %}
import { {{ resource.snake }}Route } from "./routes/{{ resource.snake }}.js";
{%- endfor %}
{%- for channel in c.channels %}
import { {{ channel.snake }}Route } from "./routes/channel_{{ channel.snake }}.js";
{%- endfor %}

// Emitted by `ciac build` alongside this file (openapi.json, derived
// straight from the IR) — the single source of truth for the API
// spec, not a hand-maintained second opinion on the same routes.
const openapiPath = fileURLToPath(new URL("../openapi.json", import.meta.url));
const openapiDocument: unknown = JSON.parse(readFileSync(openapiPath, "utf8"));

export function buildApp(state: AppState) {
{%- if not c.apis and not c.resources and not c.channels %}
  // Unused when this service exposes no HTTP routes at all (e.g. a
  // pure worker/job service); kept in the signature so callers don't
  // change shape once one is added.
  void state;
{%- endif %}
  const app = Fastify({ logger: loggerOptions() });
{%- if c.has_tracing %}
  app.register(fastifyOtelInstrumentation.plugin());
{%- endif %}

  app.get("/health", async () => ({ status: "ok" }));
  app.get("/openapi.json", async () => openapiDocument);
{%- if c.has_metrics %}
  app.get("/metrics", async (request, reply) => {
    reply.header("content-type", metricsRegistry.contentType);
    return metricsRegistry.metrics();
  });
{%- endif %}
{%- for api in c.apis %}
  app.register({{ api.snake }}Route, { state });
{%- endfor %}
{%- for resource in c.resources %}
  app.register({{ resource.snake }}Route, { state });
{%- endfor %}
{%- for channel in c.channels %}
  app.register({{ channel.snake }}Route, { state });
{%- endfor %}

  return app;
}

if (import.meta.url === `file://${process.argv[1]}`) {
{%- if c.has_tracing %}
  configureTracing();
{%- endif %}
  const config = loadConfig();
  const state = createState(config);
{%- if c.resources %}
  await ensureSchema(state);
{%- endif %}
{%- if c.tables %}
  await runMigrations(state);
{%- endif %}
  const app = buildApp(state);
  app.listen({ host: "0.0.0.0", port: 8000 }).catch((err: unknown) => {
    app.log.error(err);
    process.exit(1);
  });
}
