// Persistence models for CRUD resources and `table` declarations.
// Generated by CIaC.
//
// Typed resources (`crud X: Record;`) get real columns from their
// record; untyped ones (`crud X;`) keep a generic keyed-document model
// (TEXT id + JSON payload). `table <Name>: <Record>;` declarations get
// the same column treatment, named after the table. Every table's `id`
// column is TEXT everywhere (matching Python's/Rust's own convention:
// server-generated ids are stringified UUIDs, never a native uuid
// column type) so it's portable across all three engines without a
// per-engine id type branch. Column builders are called through a
// namespace import (`pgCore`/`mysqlCore`/`sqliteCore`) rather than
// individually aliased imports so a table that doesn't use every
// column kind never trips `no-unused-vars` on an unused builder.

{%- if c.has_postgres_db %}
import * as pgCore from "drizzle-orm/pg-core";
{%- endif %}
{%- if c.has_mysql_db %}
import * as mysqlCore from "drizzle-orm/mysql-core";
{%- endif %}
{%- if c.has_sqlite_db %}
import * as sqliteCore from "drizzle-orm/sqlite-core";
{%- endif %}

{% macro id_column(engine) -%}
{%- if engine == "postgres" -%}
pgCore.text("id").primaryKey()
{%- elif engine == "mysql" -%}
mysqlCore.varchar("id", { length: 36 }).primaryKey()
{%- else -%}
sqliteCore.text("id").primaryKey()
{%- endif -%}
{%- endmacro %}

{% macro json_column(engine, name) -%}
{%- if engine == "postgres" -%}
pgCore.jsonb("{{ name }}")
{%- elif engine == "mysql" -%}
mysqlCore.json("{{ name }}")
{%- else -%}
sqliteCore.text("{{ name }}", { mode: "json" })
{%- endif -%}
{%- endmacro %}

{% macro table_fn(engine) -%}
{%- if engine == "postgres" -%}
pgCore.pgTable
{%- elif engine == "mysql" -%}
mysqlCore.mysqlTable
{%- else -%}
sqliteCore.sqliteTable
{%- endif -%}
{%- endmacro %}

{% for resource in c.resources %}
export const {{ resource.snake }}Table = {{ table_fn(resource.db_engine) }}("{{ resource.plural }}", {
  id: {{ id_column(resource.db_engine) }},
{%- if resource.record %}
{%- for field in resource.record.fields %}
{%- if field.name != "id" %}
  {{ field.name }}: {{ (field | drizzle_column(field.name, resource.db_engine)) }}.notNull(),
{%- endif %}
{%- endfor %}
{%- else %}
  data: {{ json_column(resource.db_engine, "data") }}.notNull(),
{%- endif %}
});
{% endfor %}
{% for table in c.tables %}
{#- Named after the table's own declared name (matching Python's
    `class {{ table.class_name }}(Base):`/Rust's `struct {{ table.class_name }}`)
    rather than the `<snake>Table` convention CRUD resources use above:
    conformance's C4b asserts every declared topology fact (a `table`
    declaration's own name included) appears verbatim somewhere in
    every supporting target's output, and raw SQL — this backend's
    typed-handler `db.*` verb lowering, unlike CRUD's Drizzle-query-
    builder path — never spells it anywhere else. #}
export const {{ table.class_name }} = {{ table_fn(c.table_db_engine) }}("{{ table.snake }}", {
{%- for field in table.record.fields %}
  {{ field.name }}: {% if field.name == "id" %}{{ id_column(c.table_db_engine) }}{% else %}{{ (field | drizzle_column(field.name, c.table_db_engine)) }}.notNull(){% endif %},
{%- endfor %}
{%- if not table.record.has_id %}
  id: {{ id_column(c.table_db_engine) }},
{%- endif %}
});
{% endfor %}
