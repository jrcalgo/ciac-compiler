describe("{{ resource.snake }} read oauth2 scope rig", () => {
  it("rejects a token missing the read scope", async () => {
    const response = await (await app()).inject({
      method: "GET",
      url: "/{{ resource.plural }}",
      headers: { authorization: await mint({ scope: "not:{{ resource.read_scope }}" }) },
    });
    expect(response.statusCode).toBe(403);
  });

  it("accepts a token carrying the read scope", async () => {
    const response = await (await app()).inject({
      method: "GET",
      url: "/{{ resource.plural }}",
      headers: { authorization: await mint({ scope: "{{ resource.read_scope }}" }) },
    });
    expect(response.statusCode).not.toBe(401);
    expect(response.statusCode).not.toBe(403);
  });

  it("rejects an expired token", async () => {
    const response = await (await app()).inject({
      method: "GET",
      url: "/{{ resource.plural }}",
      headers: { authorization: await mint({ scope: "{{ resource.read_scope }}", expDelta: -3600 }) },
    });
    expect(response.statusCode).toBe(401);
  });

  it("rejects a token signed by a key the stub JWKS never served", async () => {
    const stub = await getOAuthStub();
    const response = await (await app()).inject({
      method: "GET",
      url: "/{{ resource.plural }}",
      headers: { authorization: await mint({ scope: "{{ resource.read_scope }}", key: stub.wrongKey }) },
    });
    expect(response.statusCode).toBe(401);
  });

  it("rejects a token from the wrong issuer", async () => {
    const response = await (await app()).inject({
      method: "GET",
      url: "/{{ resource.plural }}",
      headers: {
        authorization: await mint({
          scope: "{{ resource.read_scope }}",
          issuer: "http://wrong-issuer.example",
        }),
      },
    });
    expect(response.statusCode).toBe(401);
  });
});
