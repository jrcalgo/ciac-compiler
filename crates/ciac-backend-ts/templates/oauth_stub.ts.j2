// Shared no-infra OAuth2 test rig helper. Generated by CIaC
// (`26UpdatePlan.md` M5). Real RS256 signing against a real (if tiny)
// in-process JWKS server, built on `jose` -- the same dependency
// `src/auth.ts`'s own `verifyToken` already uses to fetch and verify
// against a JWKS, so `oauth-rig.test.ts` exercises production code,
// not a parallel implementation. Zero new dependencies: `jose` already
// generates RSA keypairs and signs RS256 (unlike Rust's `ring`, which
// doesn't expose RSA keygen -- Rust embeds a fixed test key instead,
// disclosed in `26UpdatePlan.md`).
//
// Memoized rather than started at module load: Node's `node:http`
// listener and `jose`'s keypair generation are both real I/O/CPU work
// that only a test actually touching auth should pay for.

import { createServer } from "node:http";
import type { AddressInfo } from "node:net";
// `CryptoKey` lives under `node:crypto`'s `webcrypto` namespace, not as
// a DOM global -- this project's `tsconfig.json` has no `"dom"` lib.
import type { webcrypto } from "node:crypto";
import { SignJWT, exportJWK, generateKeyPair } from "jose";
import { loadConfig } from "../src/config.js";

type CryptoKey = webcrypto.CryptoKey;

export interface OAuthStub {
  issuer: string;
  kid: string;
  privateKey: CryptoKey;
  wrongKey: CryptoKey;
}

let stub: Promise<OAuthStub> | undefined;

export function getOAuthStub(): Promise<OAuthStub> {
  stub ??= startOAuthStub();
  return stub;
}

async function startOAuthStub(): Promise<OAuthStub> {
  const kid = "test-key-1";
  const { publicKey, privateKey } = await generateKeyPair("RS256", { extractable: true });
  const { privateKey: wrongKey } = await generateKeyPair("RS256", { extractable: true });
  const jwk = { ...(await exportJWK(publicKey)), kid, use: "sig", alg: "RS256" };
  const body = JSON.stringify({ keys: [jwk] });

  const server = createServer((req, res) => {
    if (req.url === "/.well-known/jwks.json") {
      res.writeHead(200, {
        "Content-Type": "application/json",
        "Content-Length": Buffer.byteLength(body),
      });
      res.end(body);
    } else {
      res.writeHead(404);
      res.end();
    }
  });
  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
  const { port } = server.address() as AddressInfo;
  const issuer = `http://127.0.0.1:${port}`;
  process.env.OAUTH_ISSUER = issuer;
  return { issuer, kid, privateKey, wrongKey };
}

export async function mint(opts: {
  scope: string;
  key?: CryptoKey;
  kid?: string;
  issuer?: string;
  expDelta?: number;
}): Promise<string> {
  const s = await getOAuthStub();
  const config = loadConfig();
  const now = Math.floor(Date.now() / 1000);
  let builder = new SignJWT({ sub: "test", scope: opts.scope })
    .setProtectedHeader({ alg: "RS256", kid: opts.kid ?? s.kid })
    .setIssuer(opts.issuer ?? s.issuer)
    .setExpirationTime(now + (opts.expDelta ?? 3600));
  if (config.oauth_audience) {
    builder = builder.setAudience(config.oauth_audience);
  }
  const token = await builder.sign(opts.key ?? s.privateKey);
  return `Bearer ${token}`;
}
