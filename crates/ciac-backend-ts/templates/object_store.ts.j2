// S3 object storage client. Generated by CIaC.
//
// Each named `object_store` instance gets a client on `AppState`.
// Defaults target a local MinIO from the generated docker-compose;
// point the `S3_*` environment variables at real S3 in production.
// Holds configuration only; the underlying `S3Client` is constructed
// per call, so the server starts (and compiles) without a running
// object store -- the same lazy bar every other capability client
// holds itself to.

import {
  DeleteObjectCommand,
  GetObjectCommand,
  ListObjectsV2Command,
  PutObjectCommand,
  S3Client,
} from "@aws-sdk/client-s3";

export class ObjectStore {
  constructor(
    private readonly endpoint: string,
    private readonly accessKey: string,
    private readonly secretKey: string,
    private readonly bucket: string,
    private readonly region: string,
  ) {}

  private client(): S3Client {
    return new S3Client({
      endpoint: this.endpoint,
      region: this.region,
      credentials: { accessKeyId: this.accessKey, secretAccessKey: this.secretKey },
      forcePathStyle: true,
    });
  }

  async put(key: string, body: string): Promise<void> {
    await this.client().send(
      new PutObjectCommand({ Bucket: this.bucket, Key: key, Body: body }),
    );
  }

  async get(key: string): Promise<string> {
    const response = await this.client().send(
      new GetObjectCommand({ Bucket: this.bucket, Key: key }),
    );
    return (await response.Body?.transformToString()) ?? "";
  }

  async delete(key: string): Promise<void> {
    await this.client().send(
      new DeleteObjectCommand({ Bucket: this.bucket, Key: key }),
    );
  }

  async list(prefix: string): Promise<string[]> {
    const response = await this.client().send(
      new ListObjectsV2Command({ Bucket: this.bucket, Prefix: prefix }),
    );
    return (response.Contents ?? []).flatMap((obj) => (obj.Key ? [obj.Key] : []));
  }
}
