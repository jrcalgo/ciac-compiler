{%- if c.has_tracing %}

/** The Fastify plugin `main.ts` registers -- server-side request spans. */
export const fastifyOtelInstrumentation = new FastifyOtelInstrumentation();

/**
 * OTLP export to the otel-collector (+ Jaeger in dev compose), plus
 * auto-instrumentation for inbound Fastify requests and outbound
 * calls: typed `call` clients and `external_http` instances both use
 * the Node-global `fetch` (backed by undici), so `UndiciInstrumentation`
 * gets them client spans with `traceparent` propagated to the callee
 * for free -- the same "for free" outbound propagation Python's
 * `HTTPXClientInstrumentor`/Rust's `opentelemetry_http` give their own
 * outgoing clients.
 */
export function configureTracing(): void {
  const endpoint = process.env.OTEL_EXPORTER_OTLP_ENDPOINT ?? "http://localhost:4317";
  const provider = new NodeTracerProvider({
    resource: resourceFromAttributes({ [ATTR_SERVICE_NAME]: "{{ c.service_name }}" }),
    spanProcessors: [
      new BatchSpanProcessor(
        new OTLPTraceExporter({ url: endpoint, credentials: credentials.createInsecure() }),
      ),
    ],
  });
  provider.register();
  registerInstrumentations({
    instrumentations: [
      fastifyOtelInstrumentation,
      new HttpInstrumentation(),
{%- if c.has_postgres_db %}
      new PgInstrumentation(),
{%- endif %}
      new UndiciInstrumentation(),
    ],
  });
}

export const tracer = trace.getTracer("{{ c.service_name }}");

/**
 * Runs `fn` under the span context carried by `headers` (a plain
 * string-keyed record, the same shape both broker engines' publish
 * sites inject into and consume sites extract from -- see
 * `queue.ts`), wrapped in a fresh child span named `name`. The
 * broker-hop half of the W3C trace-context propagation Pillar 5
 * describes; `main.ts`'s `fastifyOtelInstrumentation` plugin and
 * `UndiciInstrumentation` above cover the HTTP hops for free.
 */
export async function traced<T>(
  name: string,
  headers: Record<string, string> | undefined,
  fn: () => Promise<T>,
): Promise<T> {
  const parent = headers ? propagation.extract(context.active(), headers) : context.active();
  return context.with(parent, async () => {
    const span = tracer.startSpan(name);
    try {
      return await context.with(trace.setSpan(context.active(), span), fn);
    } finally {
      span.end();
    }
  });
}
