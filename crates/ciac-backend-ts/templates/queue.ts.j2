// Broker access ({{ c.queue_engine }}). Generated by CIaC.
//
// Construction never touches the network: kafkajs's `Kafka` client
// object doesn't connect until a producer/consumer explicitly does,
// and the NATS connection below is a memoized promise created lazily
// on first publish/subscribe — the same "AppState touches zero
// infrastructure" bar every other capability instance holds to.

{%- if c.has_tracing %}
import { context, propagation } from "@opentelemetry/api";
{%- endif %}
{%- if c.queue_engine == "kafka" %}
import { Kafka, logLevel, type Consumer, type Producer } from "kafkajs";

export class Queue {
  private readonly kafka: Kafka;
  private producer: Producer | undefined;

  constructor(brokers: string) {
    this.kafka = new Kafka({
      brokers: brokers.split(","),
      logLevel: logLevel.NOTHING,
    });
  }

  private async getProducer(): Promise<Producer> {
    if (!this.producer) {
      const producer = this.kafka.producer();
      await producer.connect();
      this.producer = producer;
    }
    return this.producer;
  }

  /** Topic = subject, matching the `<service>.<stream>` naming v0.11 M3 settled. */
  async publish(subject: string, payload: Buffer, headers?: Record<string, string>): Promise<void> {
    const producer = await this.getProducer();
    await producer.send({ topic: subject, messages: [{ value: payload, headers }] });
  }

  /**
   * A fresh, connected, subscribed consumer for `subject`. `group`
   * load-balances competing consumers the way NATS queue groups do;
   * passing a fresh UUID as `group` (as `channel.ts.j2` does) instead
   * gives every caller its own ephemeral group, achieving fan-out —
   * Kafka's own group semantics would otherwise load-balance them
   * like a worker.
   */
  async consumer(subject: string, group: string): Promise<Consumer> {
    const consumer = this.kafka.consumer({ groupId: group });
    await consumer.connect();
    await consumer.subscribe({ topic: subject, fromBeginning: false });
    return consumer;
  }
}
{%- else %}
import { connect, headers as natsHeaders, type NatsConnection, type Subscription } from "@nats-io/transport-node";

export class Queue {
  private connection: Promise<NatsConnection> | undefined;

  constructor(private readonly url: string) {}

  private connect(): Promise<NatsConnection> {
    if (!this.connection) {
      this.connection = connect({ servers: this.url });
    }
    return this.connection;
  }

  async publish(subject: string, payload: Buffer, headers?: Record<string, string>): Promise<void> {
    const nc = await this.connect();
    if (headers) {
      const h = natsHeaders();
      for (const [k, v] of Object.entries(headers)) {
        h.set(k, v);
      }
      nc.publish(subject, payload, { headers: h });
    } else {
      nc.publish(subject, payload);
    }
  }

  /** A queue-group subscription: competing consumers load-balance. */
  async queueSubscribe(subject: string, queue: string): Promise<Subscription> {
    const nc = await this.connect();
    return nc.subscribe(subject, { queue });
  }

  /**
   * A plain subscription: NATS delivers a copy of every message to
   * every plain subscriber, so this alone is `channel.ts.j2`'s whole
   * fan-out mechanism — no app-level broadcast bookkeeping needed.
   */
  async subscribe(subject: string): Promise<Subscription> {
    const nc = await this.connect();
    return nc.subscribe(subject);
  }
}
{%- endif %}

/**
 * The publish path every generated call site (`api`/`worker`/`job`
 * pipeline `publish` steps) goes through, mirroring Rust's centralized
 * `AppState::publish` — a single seam a future simulation runner (M9)
 * can intercept without touching every call site.
{%- if c.has_tracing %}
 * Also where the current span's W3C `traceparent` gets injected into
 * a fresh header carrier -- the publish half of the broker-hop
 * propagation `observability.ts`'s `traced` helper extracts on the
 * consume side (byte-for-byte the same header contract v0.15 M3/M4
 * established).
{%- endif %}
 */
export async function publish(
  state: { queue: Queue },
  subject: string,
  payload: Buffer,
): Promise<void> {
{%- if c.has_tracing %}
  const carrier: Record<string, string> = {};
  propagation.inject(context.active(), carrier);
  await state.queue.publish(subject, payload, carrier);
{%- else %}
  await state.queue.publish(subject, payload);
{%- endif %}
}
