// Request pipeline for `api {{ api.name }}`. Generated by CIaC.

{%- import "_steps.ts.j2" as steps %}
import type { FastifyPluginAsync } from "fastify";
{%- if api.has_auth_step and api.scope %}
import { requireScope, verifyToken } from "../auth.js";
{%- elif api.has_auth_step %}
import { verifyToken } from "../auth.js";
{%- endif %}
{%- if api.has_publish_step %}
import { publish } from "../queue.js";
{%- endif %}
{%- for h in api.handlers %}
import { {{ h.class_name }} } from "../{{ h.handler_package }}/{{ h.module }}.js";
{%- endfor %}
{%- for t in api.call_imports %}
import { {{ t.class_name }} } from "../clients/{{ t.module }}.js";
{%- endfor %}
import type { AppState } from "../state.js";

export const {{ api.snake }}Route: FastifyPluginAsync<{ state: AppState }> = async (
  app,
  { state },
) => {
  // A no-op read: `state` may go unused (a pipeline with no db/cache/
  // handler/publish/call step, e.g. `Return`-only) or genuinely used
  // below, depending on the pipeline's steps — computing which
  // per-route isn't worth it when a harmless `void` covers both, kept
  // in the plugin signature so route registration doesn't change shape
  // as this api's pipeline grows.
  void state;
  app.{{ api.method_lower }}("{{ api.route }}", async (request) => {
{%- if api.has_auth_step %}
    const claims = await verifyToken(request, state);
{%- if api.scope %}
    requireScope(claims, "{{ api.scope }}");
{%- else %}
    void claims;
{%- endif %}
{%- endif %}
{%- set mutable = api.steps | reassigns_result %}
{%- if api.has_body %}
    {% if mutable %}let{% else %}const{% endif %} result: unknown = request.body;
{%- else %}
    {% if mutable %}let{% else %}const{% endif %} result: unknown = {};
{%- endif %}
{%- for step in api.steps %}
{{ steps.emit_step(step, "    ") }}
{%- endfor %}
    return { status: "accepted", data: result };
  });
};
