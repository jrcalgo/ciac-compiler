// REST endpoints for the `{{ resource.name }}` resource. Generated by CIaC.

import type { FastifyPluginAsync } from "fastify";
{%- if resource.record %}
import { {{ resource.name }}Schema } from "../schemas.js";
{%- else %}
import { z } from "zod";
{%- endif %}
import { {{ resource.store_class }} } from "../stores/{{ resource.store_module }}.js";
import type { AppState } from "../state.js";

{%- if resource.record %}
const createSchema = {{ resource.name }}Schema.omit({ id: true });
{%- else %}
const createSchema = z.unknown();
{%- endif %}

export const {{ resource.snake }}Route: FastifyPluginAsync<{ state: AppState }> = async (
  app,
  { state },
) => {
  const store = new {{ resource.store_class }}(state);

  app.post("/{{ resource.plural }}", async (request, reply) => {
    const payload = createSchema.parse(request.body);
    const row = await store.create(payload);
    reply.code(201);
    return row;
  });

  app.get("/{{ resource.plural }}", async (request) => {
    const query = request.query as { limit?: string; offset?: string };
    const limit = query.limit ? Number(query.limit) : {{ resource.page_size }};
    const offset = query.offset ? Number(query.offset) : 0;
    return store.list(limit, offset);
  });

  app.get("/{{ resource.plural }}/:id", async (request, reply) => {
    const { id } = request.params as { id: string };
    const row = await store.get(id);
    if (row === null) {
      reply.code(404);
      return { error: "not found" };
    }
    return row;
  });

  app.put("/{{ resource.plural }}/:id", async (request, reply) => {
    const { id } = request.params as { id: string };
    const payload = createSchema.parse(request.body);
    const row = await store.update(id, payload);
    if (row === null) {
      reply.code(404);
      return { error: "not found" };
    }
    return row;
  });

  app.delete("/{{ resource.plural }}/:id", async (request, reply) => {
    const { id } = request.params as { id: string };
    const deleted = await store.delete(id);
    if (!deleted) {
      reply.code(404);
      return { error: "not found" };
    }
    reply.code(204);
  });
};
