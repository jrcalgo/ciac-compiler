// Data schemas from the program's `record` declarations. Generated by CIaC.

import { z } from "zod";
{% for record in c.records %}
{%- for enum in record.enums %}

export const {{ enum.name }}Schema = z.enum([{% for v in enum.variants %}"{{ v }}"{% if not loop.last %}, {% endif %}{% endfor %}]);
export type {{ enum.name }} = z.infer<typeof {{ enum.name }}Schema>;
{%- endfor %}
{%- if record.is_error %}

/** Thrown by `fail {{ record.name }}(..)` in a handler body. */
export class {{ record.name }} extends Error {
  constructor(
{%- for field in record.fields %}
    readonly {{ field.name }}: {{ (field | ts_type) }},
{%- endfor %}
  ) {
    super(
      `{{ record.name }}(` +
{%- for field in record.fields %}
        `{{ field.name }}=${ {{- "" -}} JSON.stringify({{ field.name }})}` {%- if not loop.last %} + ", " +{% endif %}
{%- endfor %}
        `)`,
    );
  }
}
{%- else %}

export const {{ record.name }}Schema = z.object({
{%- for field in record.fields %}
{%- if field.is_enum %}
  {{ field.name }}: {{ field.type_kind.name }}Schema,
{%- else %}
  {{ field.name }}: {{ (field | zod_schema) }},
{%- endif %}
{%- endfor %}
});
export type {{ record.name }} = z.infer<typeof {{ record.name }}Schema>;
{%- endif %}
{% endfor %}
