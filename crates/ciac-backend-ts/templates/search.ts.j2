// OpenSearch client. Generated by CIaC.
//
// Each named `search` instance gets a client on `AppState`. Defaults
// target the single-node OpenSearch container from the generated
// docker-compose. Holds configuration only; the underlying client is
// constructed per call, so the server starts (and compiles) without a
// running search cluster.

import { Client } from "@opensearch-project/opensearch";

export class Search {
  constructor(private readonly url: string) {}

  private client(): Client {
    return new Client({ node: this.url });
  }

  async index(index: string, docId: string, document: unknown): Promise<void> {
    await this.client().index({ index, id: docId, body: document as Record<string, unknown> });
  }

  async search(index: string, query: unknown): Promise<unknown[]> {
    const response = await this.client().search({
      index,
      body: query as Record<string, unknown>,
    });
    return response.body.hits.hits.map((hit) => hit._source);
  }

  async delete(index: string, docId: string): Promise<void> {
    await this.client().delete({ index, id: docId });
  }
}
