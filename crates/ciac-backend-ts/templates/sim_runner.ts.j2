// Scenario-driving simulation runner. Generated by CIaC (v0.23 M9,
// full parity 27UpdatePlan.md M6).
//
// Interprets the same closed `request`/`publish`/`advance`/`drain`/
// `expect` scenario vocabulary `ciac-sim`'s `Scenario` JSON schema
// defines, against this service's own generated routes (through
// Fastify's `app.inject`, no live listener) and its worker
// `handleMessageOnce`/job `handleTickOnce` entry points -- the same
// architecture as `sim_runner.rs.j2`, generated (not a shared library)
// because this needs concrete per-program types, exactly like the
// Rust backend's own generated runner.
//
// Single-service only; `publish` steps (publishing directly to a
// stream, bypassing an API) are not wired -- the same disclosed scope
// Rust's own `sim_runner.rs.j2` still carries. Any scenario step this
// runner cannot honor is a hard error, never a silently-skipped no-op.
// Structural scenario parsing only (`simulation_version`/non-empty
// `steps`) -- this is a hand-written restatement of
// `ciac_sim::scenario::Scenario`, not that vendored Rust source, the
// same position Python's own hand-written scenario drivers occupy.

import { readFileSync } from "node:fs";
{%- if c.jobs %}
import { Cron } from "croner";
{%- endif %}
{%- if c.apis %}
import type { InjectOptions } from "fastify";
import { buildApp } from "./main.js";
{%- endif %}
import { loadConfig } from "./config.js";
import { createSimulationState, type AppState } from "./state.js";
import { SimWorld, type FailureRule, type GivenHttpResponse, type WorldTable } from "{% if multi %}sim-shared{% else %}./world.js{% endif %}";
{%- for worker in c.workers %}
import * as {{ worker.snake | pascal_case }}Worker from "./workers/{{ worker.snake }}.js";
{%- endfor %}
{%- for job in c.jobs %}
import * as {{ job.snake | pascal_case }}Job from "./workers/{{ job.snake }}.js";
{%- endfor %}

const SERVICE_NAME = "{{ c.service_name }}";

// 27UpdatePlan.md M6: schema facts computed once at codegen time from
// the same source the migration DDL itself is built from, so
// reference/unique/cascade checking under simulation can never drift
// from what the real schema enforces -- mirroring Rust's own
// `sim_world_tables` exactly.
const WORLD_TABLES: WorldTable[] = [
{%- for table in sim_world_tables %}
  {
    name: "{{ table.name }}",
    references: [
{%- for reference in table.references %}
      {
        fieldName: "{{ reference.field_name }}",
        targetTable: {% if reference.target_table %}"{{ reference.target_table }}"{% else %}null{% endif %},
        onDelete: "{{ reference.on_delete }}",
        unique: {{ reference.unique }},
      },
{%- endfor %}
    ],
  },
{%- endfor %}
];

{%- if c.apis %}

const API_ROUTES: Record<string, { method: InjectOptions["method"]; path: string }> = {
{%- for api in c.apis %}
  "{{ api.name }}": { method: "{{ api.method_upper }}", path: "{{ api.route }}" },
{%- endfor %}
};
{%- endif %}

// -- Scenario JSON shape (structural restatement of `ciac_sim::scenario`) --

interface Principal {
  sub: string;
  scopes?: string[];
}

interface RequestStep {
  service: string;
  api: string;
  json?: unknown;
  as?: Principal;
  save_as?: string;
}

interface AdvanceStep {
  by: string;
}

type ExpectStep =
  | { response: { of?: string; status?: number; json?: unknown } }
  | { row: { service: string; table: string; where: Record<string, unknown>; present: boolean } }
  | { worker_attempts: { worker: string; count: number } }
  | { job_runs: { job: string; count: number } }
  | { quiescence: Record<string, never> }
  | { email: { to?: string; subject_contains?: string; count: number } }
  | { cache: { instance: string; key: string; present: boolean; value?: unknown } }
  | { object: { store: string; key: string; present: boolean } }
  | { search_hits: { instance: string; query: string; count: number } }
  | { http_calls: { instance: string; count: number } };

type ScenarioStep =
  | { request: RequestStep }
  | { publish: { stream: string; json?: unknown } }
  | { advance: AdvanceStep }
  | { drain: Record<string, never> }
  | { expect: ExpectStep };

interface GivenTableRows {
  service: string;
  table: string;
  rows: Record<string, unknown>[];
}

interface GivenCacheEntry {
  instance: string;
  key: string;
  value: unknown;
  ttl?: string;
}

interface GivenStoreObject {
  instance: string;
  key: string;
  value_base64: string;
}

interface GivenSearchDoc {
  instance: string;
  id: string;
  doc: unknown;
}

interface GivenHttpFixture {
  instance: string;
  responses: GivenHttpResponse[];
}

interface RawFailureRule {
  at: { effect: string; subject: string | null; occurrence: number; phase: string };
  action: { kind: string };
}

interface Given {
  db?: GivenTableRows[];
  cache?: GivenCacheEntry[];
  store?: GivenStoreObject[];
  search?: GivenSearchDoc[];
  external_http?: GivenHttpFixture[];
  failures?: RawFailureRule[];
}

interface Scenario {
  simulation_version: number;
  name: string;
  start_at: string;
  given: Given;
  steps: ScenarioStep[];
}

interface SimScenarioOutcome {
  scenario: string;
  passed: boolean;
  error: string | null;
  worker_attempts: Record<string, number>;
  job_runs: Record<string, number>;
}

function parseScenario(raw: unknown): Scenario {
  const obj = raw as Record<string, unknown>;
  if (obj.simulation_version !== 1) {
    throw new Error(
      `scenario simulation_version ${JSON.stringify(obj.simulation_version)} is not supported (expected 1)`,
    );
  }
  const steps = obj.steps as ScenarioStep[] | undefined;
  if (!steps || steps.length === 0) {
    throw new Error("scenario has no steps");
  }
  return {
    simulation_version: 1,
    name: obj.name as string,
    start_at: obj.start_at as string,
    given: (obj.given as Given | undefined) ?? {},
    steps,
  };
}

/** Only the `error` action / `after` phase is implemented -- the same
 * disclosed subset of the full failure vocabulary Rust's own
 * `SimWorld::should_fail` supports, for the same reason (it's the one
 * action this checkpoint's scenarios need). Refused up front rather
 * than silently ignored if a scenario asks for anything else. */
function toFailureRules(raw: RawFailureRule[]): FailureRule[] {
  return raw.map((r) => {
    if (r.action.kind !== "error") {
      throw new Error(
        `failure rule for effect ${JSON.stringify(r.at.effect)} uses action ${JSON.stringify(r.action.kind)}, which this TypeScript world's FailureEngine integration does not support yet (only \`error\` is implemented)`,
      );
    }
    if (r.at.phase !== "after") {
      throw new Error(
        `failure rule for effect ${JSON.stringify(r.at.effect)} uses phase ${JSON.stringify(r.at.phase)}, which this TypeScript world's FailureEngine integration does not support yet (only \`after\` is implemented)`,
      );
    }
    return { effect: r.at.effect, subject: r.at.subject ?? null, occurrence: r.at.occurrence };
  });
}

/** Parses `advance.by` strings (`"24h"`, `"7d"`, `"30m"`, ...) --
 * matches `sim/pyrunner/cron.py`'s `parse_duration_ms` and
 * `sim_runner.rs.j2`'s own `parse_duration_ms` exactly. */
function parseDurationMs(text: string): number {
  const match = /^(\d+)(ms|s|m|h|d)$/.exec(text);
  if (!match) {
    throw new Error(`unrecognized duration: ${JSON.stringify(text)}`);
  }
  const value = Number(match[1]);
  const unitMs: Record<string, number> = { ms: 1, s: 1_000, m: 60_000, h: 3_600_000, d: 86_400_000 };
  return value * unitMs[match[2]];
}

{%- if c.jobs %}

/** Every cron-due instant in `(fromMs, toMs]` for `schedule` -- croner
 * parses the same 5-field source expression the real job scheduler
 * uses, so (unlike Rust's `cron` crate) no seconds-field/weekday
 * translation is needed here either (docs/language.md's schedule
 * translation row). `{ paused: true }` means this `Cron` instance
 * never actually schedules a real timer; only `.nextRun` (a pure
 * computation) is used. */
function dueInstants(schedule: string, fromMs: number, toMs: number): number[] {
  const cron = new Cron(schedule, { paused: true });
  const out: number[] = [];
  let cursor: Date | null = new Date(fromMs);
  for (let i = 0; i < 100_000 && cursor; i++) {
    const next: Date | null = cron.nextRun(cursor);
    if (!next || next.getTime() > toMs) break;
    out.push(next.getTime());
    cursor = next;
  }
  return out;
}
{%- endif %}

/** Canonical (key-sorted) JSON string, so `expect.response.json`
 * compares by value, not by the saved response's own key order. */
function canonicalJson(value: unknown): string {
  if (Array.isArray(value)) {
    return `[${value.map(canonicalJson).join(",")}]`;
  }
  if (value !== null && typeof value === "object") {
    const entries = Object.entries(value as Record<string, unknown>).sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0));
    return `{${entries.map(([k, v]) => `${JSON.stringify(k)}:${canonicalJson(v)}`).join(",")}}`;
  }
  return JSON.stringify(value);
}

{%- if c.apis %}

async function request(
  app: ReturnType<typeof buildApp>,
  world: SimWorld,
  spec: RequestStep,
  saved: Map<string, { status: number; json: unknown }>,
): Promise<void> {
  if (spec.service !== SERVICE_NAME) {
    throw new Error(
      `sim_runner only drives service ${JSON.stringify(SERVICE_NAME)} (single-service only); request named ${JSON.stringify(spec.service)}`,
    );
  }
  const route = API_ROUTES[spec.api];
  if (!route) {
    throw new Error(`sim_runner: no api registered named ${JSON.stringify(spec.api)}`);
  }
  const headers: Record<string, string> = {};
  // 27UpdatePlan.md M6: synthesizes a bearer token from the step's own
  // `as` principal exactly like `sim/pyrunner/auto_driver.py`'s
  // `_request` (`f"sim:{sub}:{','.join(scopes)}"`, claims `{"sub": sub,
  // "scope": " ".join(scopes)}`) -- matching Rust's own
  // `sim_runner.rs.j2`'s identical synthesis.
  if (spec.as) {
    const scopes = spec.as.scopes ?? [];
    const token = `sim:${spec.as.sub}:${scopes.join(",")}`;
    world.authIssue(token, { sub: spec.as.sub, scope: scopes.join(" ") }, null);
    headers.authorization = `Bearer ${token}`;
  }
  const response = await app.inject({
    method: route.method,
    url: route.path,
    headers,
    payload: spec.json === undefined ? undefined : (spec.json as object),
  });
  // A non-2xx response's body is plain text, not JSON (Fastify's
  // default error/`AppError` reply) -- parsed as a JSON string rather
  // than treated as a hard parse error, so `expect.response`'s
  // `status`-only checks (the common case for an error path) never
  // fail on the body shape they never asked about. Mirrors Rust's own
  // `sim_runner.rs.j2` fallback exactly.
  let json: unknown = null;
  if (response.body.length > 0) {
    try {
      json = response.json();
    } catch {
      json = response.body;
    }
  }
  if (spec.save_as) {
    saved.set(spec.save_as, { status: response.statusCode, json });
  }
}
{%- endif %}

/**
 * One pass: every worker drains its *own* `(subject, group)` cursor on
 * `world.broker` into its `handleMessageOnce` (with that worker's own
 * retry budget) -- messages a handler publishes as a side effect of
 * processing are left for the *next* `drain` step. Two independent
 * workers on the same subject now each see every message (true
 * fan-out), where the old shared-queue dispatch delivered only to
 * whichever worker's `if`/`else if` branch matched first -- matching
 * Rust's own 27UpdatePlan.md M4 `drain()` rewrite.
 */
async function drain(
  state: AppState,
  world: SimWorld,
  workerAttempts: Record<string, number>,
): Promise<void> {
{%- for worker in c.workers %}
{%- if worker.steps %}
  for (const raw of world.broker.drain({{ worker.snake | pascal_case }}Worker.SUBJECT, {{ worker.snake | pascal_case }}Worker.QUEUE_GROUP)) {
    const payload: unknown = JSON.parse(raw.toString("utf8"));
    let attempts = 0;
    for (let attempt = 0; attempt <= {{ worker.snake | pascal_case }}Worker.MAX_RETRIES; attempt++) {
      attempts++;
      try {
        await {{ worker.snake | pascal_case }}Worker.handleMessageOnce(state, payload);
        break;
      } catch (err) {
        if (attempt >= {{ worker.snake | pascal_case }}Worker.MAX_RETRIES) {
          console.error(`sim_runner: {{ worker.name }} exhausted retries: ${String(err)}`);
        }
      }
    }
    workerAttempts["{{ worker.name }}"] = (workerAttempts["{{ worker.name }}"] ?? 0) + attempts;
  }
{%- endif %}
{%- endfor %}
  void workerAttempts;
  // `world.queue` is dual-written alongside `world.broker`
  // (`publishChecked`'s own doc comment) for exactly this sweep: a
  // message published to a subject no registered worker drains above
  // is refused here, not left to sit undelivered forever -- the same
  // "refused, not guessed" contract this runner has always held for
  // capabilities it doesn't cover.
  for (const [subject] of world.queue.takeAll()) {
{%- for worker in c.workers %}
{%- if worker.steps %}
    if (subject === {{ worker.snake | pascal_case }}Worker.SUBJECT) {
      // Already drained via `world.broker` above.
      continue;
    }
{%- endif %}
{%- endfor %}
    throw new Error(
      `sim_runner: no worker registered to consume subject ${JSON.stringify(subject)} (disclosed scope)`,
    );
  }
}

async function advance(
  state: AppState,
  world: SimWorld,
  fromMs: number,
  toMs: number,
  jobRuns: Record<string, number>,
): Promise<void> {
{%- for job in c.jobs %}
  for (let __i = dueInstants({{ job.snake | pascal_case }}Job.SCHEDULE, fromMs, toMs).length; __i > 0; __i--) {
    await {{ job.snake | pascal_case }}Job.handleTickOnce(state);
    jobRuns["{{ job.name }}"] = (jobRuns["{{ job.name }}"] ?? 0) + 1;
  }
{%- endfor %}
  world.advanceClockTo(toMs);
  void state;
  void fromMs;
  void jobRuns;
}

function expect(
  spec: ExpectStep,
  world: SimWorld,
  saved: Map<string, { status: number; json: unknown }>,
  workerAttempts: Record<string, number>,
  jobRuns: Record<string, number>,
): void {
  if ("response" in spec) {
    const { of, status, json } = spec.response;
    if (!of) {
      throw new Error('expect.response requires "of"');
    }
    const got = saved.get(of);
    if (!got) {
      throw new Error(`expect.response.of references unknown save_as ${JSON.stringify(of)}`);
    }
    if (status !== undefined && got.status !== status) {
      throw new Error(
        `expect.response.of=${JSON.stringify(of)}: expected status ${status}, got ${got.status}`,
      );
    }
    if (json !== undefined && canonicalJson(got.json) !== canonicalJson(json)) {
      throw new Error(
        `expect.response.of=${JSON.stringify(of)}: expected json ${JSON.stringify(json)}, got ${JSON.stringify(got.json)}`,
      );
    }
  } else if ("row" in spec) {
    const { service, table, where, present } = spec.row;
    if (service !== SERVICE_NAME) {
      throw new Error(
        `sim_runner only drives service ${JSON.stringify(SERVICE_NAME)} (single-service only); expect.row named ${JSON.stringify(service)}`,
      );
    }
    const found = world.db.findWhere(table, where).length > 0;
    if (found !== present) {
      throw new Error(
        `expect.row: table=${JSON.stringify(table)} where=${JSON.stringify(where)} present=${present}, found=${found}`,
      );
    }
  } else if ("worker_attempts" in spec) {
    const { worker, count } = spec.worker_attempts;
    const actual = workerAttempts[worker] ?? 0;
    if (actual !== count) {
      throw new Error(`expect.worker_attempts: worker=${JSON.stringify(worker)} expected ${count}, got ${actual}`);
    }
  } else if ("job_runs" in spec) {
    const { job, count } = spec.job_runs;
    const actual = jobRuns[job] ?? 0;
    if (actual !== count) {
      throw new Error(`expect.job_runs: job=${JSON.stringify(job)} expected ${count}, got ${actual}`);
    }
  } else if ("quiescence" in spec) {
    if (!world.queue.isEmpty()) {
      throw new Error("expect.quiescence: undelivered message(s) remain in the simulated broker");
    }
  } else if ("email" in spec) {
    const { to, subject_contains, count } = spec.email;
    const actual = world.emailSentCountAll(to ?? null, subject_contains ?? null);
    if (actual !== count) {
      throw new Error(
        `expect.email: to=${JSON.stringify(to)} subject_contains=${JSON.stringify(subject_contains)} expected ${count}, got ${actual}`,
      );
    }
  } else if ("cache" in spec) {
    const { instance, key, present, value } = spec.cache;
    const cached = world.cacheGet(instance, key);
    const found = cached !== null;
    if (found !== present) {
      throw new Error(
        `expect.cache: instance=${JSON.stringify(instance)} key=${JSON.stringify(key)} expected present=${present}, found present=${found}`,
      );
    }
    if (value !== undefined) {
      const actual = cached === null ? null : JSON.parse(cached);
      if (canonicalJson(actual) !== canonicalJson(value)) {
        throw new Error(
          `expect.cache: instance=${JSON.stringify(instance)} key=${JSON.stringify(key)} expected value=${JSON.stringify(value)}, got ${JSON.stringify(actual)}`,
        );
      }
    }
  } else if ("object" in spec) {
    const { store, key, present } = spec.object;
    const found = world.objectExists(store, key);
    if (found !== present) {
      throw new Error(
        `expect.object: store=${JSON.stringify(store)} key=${JSON.stringify(key)} expected present=${present}, found present=${found}`,
      );
    }
  } else if ("search_hits" in spec) {
    const { instance, query, count } = spec.search_hits;
    const actual = world.searchQuery(instance, query).length;
    if (actual !== count) {
      throw new Error(
        `expect.search_hits: instance=${JSON.stringify(instance)} query=${JSON.stringify(query)} expected ${count}, got ${actual}`,
      );
    }
  } else if ("http_calls" in spec) {
    const { instance, count } = spec.http_calls;
    const actual = world.httpRequestCount(instance);
    if (actual !== count) {
      throw new Error(
        `expect.http_calls: instance=${JSON.stringify(instance)} expected ${count}, got ${actual}`,
      );
    }
  } else {
    throw new Error(`sim_runner: unrecognized expect step ${JSON.stringify(spec)}`);
  }
}

async function main(): Promise<void> {
  const scenarioPath = process.argv[2];
  if (!scenarioPath) {
    throw new Error("usage: sim_runner <scenario.json>");
  }
  const raw: unknown = JSON.parse(readFileSync(scenarioPath, "utf8"));
  const scenario = parseScenario(raw);

  const failureRules = toFailureRules(scenario.given.failures ?? []);
  const world = new SimWorld(failureRules, WORLD_TABLES);

  const startMs = new Date(scenario.start_at).getTime();
  if (Number.isNaN(startMs)) {
    throw new Error(`scenario start_at ${JSON.stringify(scenario.start_at)}: not a valid date`);
  }
  // `SimWorld`'s constructor always starts its own virtual clock at
  // epoch 0 (disclosed in `world.ts`'s own doc comment -- not yet
  // scenario-customizable); synced to `start_at` here, before any
  // TTL-bearing seed below reads `world.nowMs()`, and kept in lockstep
  // by every `advance()` step thereafter -- mirroring Rust's own
  // `sim_runner.rs.j2` ordering exactly.
  world.advanceClockTo(startMs);
  let nowMs = startMs;

  for (const seed of scenario.given.db ?? []) {
    if (seed.service !== SERVICE_NAME) {
      throw new Error(
        `sim_runner only drives service ${JSON.stringify(SERVICE_NAME)} (single-service only); given.db named ${JSON.stringify(seed.service)}`,
      );
    }
    for (const row of seed.rows) {
      world.db.insert(seed.table, row);
    }
  }
  // 27UpdatePlan.md M6: `given.cache`/`given.store`/`given.search`/
  // `given.external_http` -- mirrors `sim/pyrunner/auto_driver.py`'s
  // `apply_given` and Rust's own `sim_runner.rs.j2` (M4) exactly.
  for (const entry of scenario.given.cache ?? []) {
    const ttlMs = entry.ttl !== undefined ? parseDurationMs(entry.ttl) : null;
    world.cacheSet(entry.instance, entry.key, JSON.stringify(entry.value), ttlMs);
  }
  for (const obj of scenario.given.store ?? []) {
    world.objectPut(obj.instance, obj.key, Buffer.from(obj.value_base64, "base64"));
  }
  for (const doc of scenario.given.search ?? []) {
    world.searchIndex(doc.instance, doc.id, doc.doc);
  }
  for (const fixture of scenario.given.external_http ?? []) {
    world.seedHttpFixtures(fixture.instance, fixture.responses);
  }

  const config = loadConfig();
  const state = createSimulationState(config, world);
{%- if c.apis %}
  // `{ logger: false }`: pino's request-completion logs share stdout
  // with this runner's own one-line JSON protocol and flush
  // asynchronously, so a stray log line could otherwise land after
  // the final `console.log` below (see `main.ts`'s own doc on this).
  const app = buildApp(state, { logger: false });
{%- endif %}

  const saved = new Map<string, { status: number; json: unknown }>();
  const workerAttempts: Record<string, number> = {};
  const jobRuns: Record<string, number> = {};

  let passed = true;
  let error: string | null = null;
  try {
    for (const step of scenario.steps) {
      if ("request" in step) {
{%- if c.apis %}
        await request(app, world, step.request, saved);
{%- else %}
        throw new Error(
          `sim_runner: no api registered named ${JSON.stringify(step.request.api)} (this service declares no \`api\` pipelines)`,
        );
{%- endif %}
      } else if ("publish" in step) {
        throw new Error("sim_runner does not support `publish` steps (disclosed scope)");
      } else if ("advance" in step) {
        const deltaMs = parseDurationMs(step.advance.by);
        const toMs = nowMs + deltaMs;
        await advance(state, world, nowMs, toMs, jobRuns);
        nowMs = toMs;
      } else if ("drain" in step) {
        await drain(state, world, workerAttempts);
      } else if ("expect" in step) {
        expect(step.expect, world, saved, workerAttempts, jobRuns);
      } else {
        throw new Error(`sim_runner: unrecognized step ${JSON.stringify(step)}`);
      }
    }
    const unmatched = world.unmatchedFailureRules();
    if (unmatched.length > 0) {
      throw new Error(
        `${unmatched.length} failure rule(s) declared in \`given.failures\` never matched a real occurrence: ${JSON.stringify(unmatched)}`,
      );
    }
  } catch (err) {
    passed = false;
    error = err instanceof Error ? err.message : String(err);
  }

  const outcome: SimScenarioOutcome = {
    scenario: scenario.name,
    passed,
    error,
    worker_attempts: workerAttempts,
    job_runs: jobRuns,
  };
  console.log(JSON.stringify(outcome));
}

main().catch((err: unknown) => {
  console.error(err);
  process.exit(1);
});
