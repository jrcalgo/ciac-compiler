// Shared application state. Generated by CIaC.
//
// Constructing `AppState` never touches the network — every provider
// client this service holds (db pools, redis, the broker client,
// JWKS) is built lazily: `pg.Pool`/`mysql2`'s pool don't connect until
// a query runs, `ioredis` is constructed with `lazyConnect: true`, and
// `better-sqlite3` only ever touches a local file, never the network —
// the same bar the Python/Rust backends hold themselves to.

{%- if c.has_postgres_db %}
import pg from "pg";
import { drizzle as drizzlePg, type NodePgDatabase } from "drizzle-orm/node-postgres";
{%- endif %}
{%- if c.has_mysql_db %}
import mysql from "mysql2/promise";
import { drizzle as drizzleMysql, type MySql2Database } from "drizzle-orm/mysql2";
{%- endif %}
{%- if c.has_sqlite_db %}
import SqliteDatabase, { type Database } from "better-sqlite3";
import { drizzle as drizzleSqlite, type BetterSQLite3Database } from "drizzle-orm/better-sqlite3";
import { mkdirSync } from "node:fs";
{%- endif %}
{%- if c.has_cache %}
import { Redis } from "ioredis";
{%- endif %}
import type { Config } from "./config.js";

// Each field spells out the exact client type passed to `drizzle()`
// (not `ReturnType<typeof drizzleX>`, which resolves an overloaded
// generic function's *default* type parameter rather than the one the
// real call site below narrows to — for `drizzle-orm/mysql2` in
// particular, whose `TClient` defaults to the callback-style
// `mysql2` `Pool` instead of the `mysql2/promise` `Pool` actually
// constructed here, that default is simply the wrong type) so the
// AppState field keeps the `$client` member `drizzle()` adds to its
// return type — `db.ts.j2`'s schema/migration DDL reaches through
// `$client` for the one thing Drizzle has no declarative-sync API for.
export interface AppState {
  config: Config;
{%- for inst in c.db_instances %}
{%- if inst.db_engine == "mysql" %}
  {{ inst.state_field }}: MySql2Database & { $client: mysql.Pool };
{%- elif inst.db_engine == "sqlite" %}
  {{ inst.state_field }}: BetterSQLite3Database & { $client: Database };
{%- else %}
  {{ inst.state_field }}: NodePgDatabase & { $client: pg.Pool };
{%- endif %}
{%- endfor %}
{%- for inst in c.cache_instances %}
  {{ inst.state_field }}: Redis;
{%- endfor %}
}

export function createState(config: Config): AppState {
{%- if c.has_sqlite_db %}
  // The database is a local file; better-sqlite3 creates the file but
  // not its directory.
  mkdirSync("data", { recursive: true });
{%- endif %}
  return {
    config,
{%- for inst in c.db_instances %}
{%- if inst.db_engine == "mysql" %}
    {{ inst.state_field }}: drizzleMysql(mysql.createPool(config.{{ inst.url_field }})),
{%- elif inst.db_engine == "sqlite" %}
    {{ inst.state_field }}: drizzleSqlite(new SqliteDatabase(config.{{ inst.url_field }}.replace(/^file:/, ""))),
{%- else %}
    {{ inst.state_field }}: drizzlePg(new pg.Pool({ connectionString: config.{{ inst.url_field }} })),
{%- endif %}
{%- endfor %}
{%- for inst in c.cache_instances %}
    {{ inst.state_field }}: new Redis(config.{{ inst.url_field }}, { lazyConnect: true }),
{%- endfor %}
  };
}
