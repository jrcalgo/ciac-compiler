// Shared application state. Generated by CIaC.
//
// Constructing `AppState` never touches the network — every provider
// client this service will eventually hold (db pools, redis, the
// broker client, JWKS) is built lazily, on first use, the same bar
// the Python/Rust backends hold themselves to. For now (no capability
// instances declared yet) there is nothing to hold at all.

import type { Config } from "./config.js";

export interface AppState {
  config: Config;
}

export function createState(config: Config): AppState {
  return { config };
}
