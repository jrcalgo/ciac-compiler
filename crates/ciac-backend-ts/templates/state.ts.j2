// Shared application state. Generated by CIaC.
//
// Constructing `AppState` never touches the network — every provider
// client this service holds (db pools, redis, the broker client,
// JWKS) is built lazily: `pg.Pool`/`mysql2`'s pool don't connect until
// a query runs, `ioredis` is constructed with `lazyConnect: true`, and
// `better-sqlite3` only ever touches a local file, never the network —
// the same bar the Python/Rust backends hold themselves to.

{%- if c.has_postgres_db %}
import pg from "pg";
import { drizzle as drizzlePg, type NodePgDatabase } from "drizzle-orm/node-postgres";
{%- endif %}
{%- if c.has_mysql_db %}
import mysql from "mysql2/promise";
import { drizzle as drizzleMysql, type MySql2Database } from "drizzle-orm/mysql2";
{%- endif %}
{%- if c.has_sqlite_db %}
import SqliteDatabase, { type Database } from "better-sqlite3";
import { drizzle as drizzleSqlite, type BetterSQLite3Database } from "drizzle-orm/better-sqlite3";
import { mkdirSync } from "node:fs";
{%- endif %}
{%- if c.has_cache %}
import { Redis } from "ioredis";
{%- endif %}
{%- if c.has_object_store %}
import { ObjectStore } from "./object_store.js";
{%- endif %}
{%- if c.has_email %}
import { Email } from "./email.js";
{%- endif %}
{%- if c.has_search %}
import { Search } from "./search.js";
{%- endif %}
{%- if c.has_external_http %}
import { ExternalHttp } from "./http_clients.js";
{%- endif %}
{%- if c.queue_engine %}
import { Queue } from "./queue.js";
{%- endif %}
{%- if c.has_db or c.queue_engine %}
import type { SimWorld } from "./world.js";
{%- endif %}
import type { Config } from "./config.js";

// Each field spells out the exact client type passed to `drizzle()`
// (not `ReturnType<typeof drizzleX>`, which resolves an overloaded
// generic function's *default* type parameter rather than the one the
// real call site below narrows to — for `drizzle-orm/mysql2` in
// particular, whose `TClient` defaults to the callback-style
// `mysql2` `Pool` instead of the `mysql2/promise` `Pool` actually
// constructed here, that default is simply the wrong type) so the
// AppState field keeps the `$client` member `drizzle()` adds to its
// return type — `db.ts.j2`'s schema/migration DDL reaches through
// `$client` for the one thing Drizzle has no declarative-sync API for.
export interface AppState {
  config: Config;
{%- for inst in c.db_instances %}
{%- if inst.db_engine == "mysql" %}
  {{ inst.state_field }}: MySql2Database & { $client: mysql.Pool };
{%- elif inst.db_engine == "sqlite" %}
  {{ inst.state_field }}: BetterSQLite3Database & { $client: Database };
{%- else %}
  {{ inst.state_field }}: NodePgDatabase & { $client: pg.Pool };
{%- endif %}
{%- endfor %}
{%- for inst in c.cache_instances %}
  {{ inst.state_field }}: Redis;
{%- endfor %}
{%- for inst in c.object_store_instances %}
  {{ inst.state_field }}: ObjectStore;
{%- endfor %}
{%- for inst in c.email_instances %}
  {{ inst.state_field }}: Email;
{%- endfor %}
{%- for inst in c.search_instances %}
  {{ inst.state_field }}: Search;
{%- endfor %}
{%- for inst in c.external_http_instances %}
  {{ inst.state_field }}: ExternalHttp;
{%- endfor %}
{%- if c.queue_engine %}
  queue: Queue;
{%- endif %}
{%- if c.has_db or c.queue_engine %}
  /** `undefined` in production; set only by [`createSimulationState`]
   * (v0.23 M9) -- every world-guarded call site (`db.insert`, broker
   * `publish`) checks this first, reading/writing the in-memory
   * `SimWorld` instead of the real pool/broker client fields above,
   * which still exist (so this interface's shape doesn't fork between
   * production and simulation) but are never touched while `world` is
   * set. */
  world?: SimWorld;
{%- endif %}
}

export function createState(config: Config): AppState {
{%- if c.has_sqlite_db %}
  // The database is a local file; better-sqlite3 creates the file but
  // not its directory.
  mkdirSync("data", { recursive: true });
{%- endif %}
  return {
    config,
{%- for inst in c.db_instances %}
{%- if inst.db_engine == "mysql" %}
    {{ inst.state_field }}: drizzleMysql(mysql.createPool(config.{{ inst.url_field }})),
{%- elif inst.db_engine == "sqlite" %}
    {{ inst.state_field }}: drizzleSqlite(new SqliteDatabase(config.{{ inst.url_field }}.replace(/^file:/, ""))),
{%- else %}
    {{ inst.state_field }}: drizzlePg(new pg.Pool({ connectionString: config.{{ inst.url_field }} })),
{%- endif %}
{%- endfor %}
{%- for inst in c.cache_instances %}
    {{ inst.state_field }}: new Redis(config.{{ inst.url_field }}, { lazyConnect: true }),
{%- endfor %}
{%- for inst in c.object_store_instances %}
    {{ inst.state_field }}: new ObjectStore(
      config.{{ inst.cfg[0].field }},
      config.{{ inst.cfg[1].field }},
      config.{{ inst.cfg[2].field }},
      config.{{ inst.cfg[3].field }},
      config.{{ inst.cfg[4].field }},
    ),
{%- endfor %}
{%- for inst in c.email_instances %}
    {{ inst.state_field }}: new Email(
      config.{{ inst.cfg[0].field }},
      config.{{ inst.cfg[1].field }},
      config.{{ inst.cfg[2].field }},
      config.{{ inst.cfg[3].field }},
      config.{{ inst.cfg[4].field }},
      config.{{ inst.cfg[5].field }},
    ),
{%- endfor %}
{%- for inst in c.search_instances %}
    {{ inst.state_field }}: new Search(config.{{ inst.cfg[0].field }}),
{%- endfor %}
{%- for inst in c.external_http_instances %}
    {{ inst.state_field }}: new ExternalHttp(config.{{ inst.cfg[0].field }}),
{%- endfor %}
{%- if c.queue_engine == "kafka" %}
    queue: new Queue(config.kafkaUrl),
{%- elif c.queue_engine == "nats" %}
    queue: new Queue(config.natsUrl),
{%- endif %}
{%- if c.has_db or c.queue_engine %}
    world: undefined,
{%- endif %}
  };
}
{%- if c.has_db or c.queue_engine %}

/**
 * Constructs `AppState` against an in-memory [`SimWorld`] instead of
 * real infrastructure (v0.23 M9). Delegates to [`createState`] for
 * every other field -- safe because every one of them is already lazy
 * (`connect_lazy`-equivalent pools, `ioredis`'s `lazyConnect`, the
 * broker client's lazy connection promise): constructing them never
 * touches the network, and the world-guarded call sites never fall
 * through to them once `world` is set. `config` is still required,
 * not defaulted: a still-unguarded field (e.g. an OAuth2 issuer) may
 * be read even under simulation, a gap this constructor discloses by
 * requiring real config rather than inventing placeholder values.
 */
export function createSimulationState(config: Config, world: SimWorld): AppState {
  return { ...createState(config), world };
}
{%- endif %}
