// Broker consumer for `worker {{ worker.name }}`. Generated by CIaC.

{%- import "_steps.ts.j2" as steps %}
{%- if worker.has_publish_step %}
import { publish } from "../queue.js";
{%- endif %}
{%- for h in worker.handlers %}
import { {{ h.class_name }} } from "../{{ h.handler_package }}/{{ h.module }}.js";
{%- endfor %}
{%- for t in worker.call_imports %}
import { {{ t.class_name }} } from "../clients/{{ t.module }}.js";
{%- endfor %}
{%- if c.has_tracing %}
import { traced } from "../observability.js";
{%- endif %}
import { logger } from "../observability.js";
import type { AppState } from "../state.js";

export const SUBJECT = "{{ worker.subject }}";
export const QUEUE_GROUP = "{{ worker.queue_group }}";
export const MAX_RETRIES = {{ worker.max_retries }};
export const CONCURRENCY = {{ worker.concurrency }};

const log = logger();

/**
 * Runs the pipeline exactly once, no retry/backoff wrapper — the seam
 * a future simulation runner (v0.23 M9) drives directly with its own
 * attempt counting, mirroring `handle_message_once` in the Python/
 * Rust backends.
 */
export async function handleMessageOnce(state: AppState, payload: unknown): Promise<void> {
{%- set mutable = worker.steps | reassigns_result %}
  {% if mutable %}let{% else %}const{% endif %} result: unknown = payload;
{%- for step in worker.steps %}
{{ steps.emit_step(step, "  ") }}
{%- endfor %}
  // A worker has no envelope to return `result` into (unlike an api
  // route) — this keeps the last step's reassignment a genuine use
  // (`no-useless-assignment`) rather than dead code, without
  // restructuring the shared step-emission macro around "is this the
  // last step" (which nested `match` arms make awkward to compute).
  void result;
}

export async function handleMessage(state: AppState, payload: unknown): Promise<void> {
  for (let attempt = 0; attempt <= MAX_RETRIES; attempt++) {
    try {
      await handleMessageOnce(state, payload);
      return;
    } catch (err) {
      if (attempt >= MAX_RETRIES) {
        throw err;
      }
      log.warn({ err, attempt }, "message processing failed; retrying");
    }
  }
}

{%- if c.queue_engine == "kafka" %}

async function consume(index: number, state: AppState): Promise<void> {
  const consumer = await state.queue.consumer(SUBJECT, QUEUE_GROUP);
  await consumer.run({
    eachMessage: async ({ message }) => {
      if (message.value === null) return;
      const payload: unknown = JSON.parse(message.value.toString("utf8"));
{%- if c.has_tracing %}
      const traceHeaders: Record<string, string> = {};
      for (const [k, v] of Object.entries(message.headers ?? {})) {
        if (v !== undefined) traceHeaders[k] = v.toString();
      }
      try {
        await traced("worker.{{ worker.name }}", traceHeaders, () => handleMessage(state, payload));
      } catch (err) {
        log.error({ err, worker: "{{ worker.name }}", index }, "message processing failed after all retries");
      }
{%- else %}
      try {
        await handleMessage(state, payload);
      } catch (err) {
        log.error({ err, worker: "{{ worker.name }}", index }, "message processing failed after all retries");
      }
{%- endif %}
    },
  });
}
{%- else %}

async function consume(index: number, state: AppState): Promise<void> {
  const sub = await state.queue.queueSubscribe(SUBJECT, QUEUE_GROUP);
  for await (const msg of sub) {
    const payload: unknown = JSON.parse(Buffer.from(msg.data).toString("utf8"));
{%- if c.has_tracing %}
    const traceHeaders: Record<string, string> = {};
    if (msg.headers) {
      for (const [k, v] of msg.headers) {
        traceHeaders[k] = v[0];
      }
    }
    try {
      await traced("worker.{{ worker.name }}", traceHeaders, () => handleMessage(state, payload));
    } catch (err) {
      log.error({ err, worker: "{{ worker.name }}", index }, "message processing failed after all retries");
    }
{%- else %}
    try {
      await handleMessage(state, payload);
    } catch (err) {
      log.error({ err, worker: "{{ worker.name }}", index }, "message processing failed after all retries");
    }
{%- endif %}
  }
}
{%- endif %}

export async function run(state: AppState): Promise<void> {
  await Promise.all(
    Array.from({ length: CONCURRENCY }, (_, index) => consume(index, state)),
  );
}
