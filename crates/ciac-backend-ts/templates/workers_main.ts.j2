import { loadConfig } from "./config.js";
import { createState } from "./state.js";
{%- if c.resources %}
import { ensureSchema } from "./db.js";
{%- endif %}
{%- if c.tables %}
import { runMigrations } from "./db.js";
{%- endif %}
{%- for worker in c.workers %}
import { run as run{{ worker.snake | pascal_case }} } from "./workers/{{ worker.snake }}.js";
{%- endfor %}
{%- for job in c.jobs %}
import { run as run{{ job.snake | pascal_case }} } from "./workers/{{ job.snake }}.js";
{%- endfor %}
{%- for consumer in c.consumers %}
import { run as run{{ consumer.snake | pascal_case }} } from "./workers/{{ consumer.snake }}.js";
{%- endfor %}

async function main(): Promise<void> {
  const config = loadConfig();
  const state = createState(config);
{%- if c.resources %}
  await ensureSchema(state);
{%- endif %}
{%- if c.tables %}
  await runMigrations(state);
{%- endif %}
{%- for job in c.jobs %}
  run{{ job.snake | pascal_case }}(state);
{%- endfor %}
  await Promise.all([
{%- for worker in c.workers %}
    run{{ worker.snake | pascal_case }}(state),
{%- endfor %}
{%- for consumer in c.consumers %}
    run{{ consumer.snake | pascal_case }}(state),
{%- endfor %}
  ]);
}

main().catch((err: unknown) => {
  console.error(err);
  process.exit(1);
});
