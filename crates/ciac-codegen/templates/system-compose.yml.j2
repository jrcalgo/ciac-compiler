services:
{%- for c in m.services %}

  {{ c.dir }}:
    build: ./{{ c.dir }}
    ports:
      - "{{ c.host_port }}:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
{%- if c.has_db or c.has_cache or c.has_queue or c.has_auth or c.has_object_store or c.has_email or c.has_search or c.call_targets %}
    environment:
{%- for inst in c.db_instances %}
      {{ inst.env_var }}: {% if inst.db_engine == "sqlite" %}{{ backend.sqlite_url_prefix }}{{ inst.db_name }}.db{{ backend.sqlite_url_suffix }}{% elif inst.db_engine == "mysql" %}{{ backend.mysql_scheme }}://{{ inst.db_user }}:{{ inst.db_user }}@{{ inst.container }}:{{ inst.db_container_port }}/{{ inst.db_name }}{% else %}{{ backend.db_scheme }}://{{ inst.db_user }}:{{ inst.db_user }}@{{ inst.container }}:{{ inst.db_container_port }}/{{ inst.db_name }}{% endif %}
{%- endfor %}
{%- for inst in c.cache_instances %}
      {{ inst.env_var }}: redis://{{ inst.container }}:6379/0
{%- endfor %}
{%- for inst in c.object_store_instances %}{% for f in inst.cfg %}{% if f.compose_value %}
      {{ f.env }}: {{ f.compose_value }}
{%- endif %}{% endfor %}{% endfor %}
{%- for inst in c.email_instances %}{% for f in inst.cfg %}{% if f.compose_value %}
      {{ f.env }}: {{ f.compose_value }}
{%- endif %}{% endfor %}{% endfor %}
{%- for inst in c.search_instances %}{% for f in inst.cfg %}{% if f.compose_value %}
      {{ f.env }}: {{ f.compose_value }}
{%- endif %}{% endfor %}{% endfor %}
{%- for t in c.call_targets %}
      {{ t.env_var }}: http://{{ t.kebab }}:8000
{%- endfor %}
{%- if c.has_queue %}
{%- if c.queue_engine == "kafka" %}
      KAFKA_URL: queue:9092
{%- else %}
      NATS_URL: nats://queue:4222
{%- endif %}
{%- endif %}
{%- if c.auth_scheme == "oauth2" %}
      OAUTH_ISSUER: {{ c.auth_issuer }}
{%- if c.auth_audience %}
      OAUTH_AUDIENCE: {{ c.auth_audience }}
{%- endif %}
{%- elif c.has_auth %}
      JWT_SECRET: ${JWT_SECRET:-change-me}
{%- endif %}
{%- endif %}
{%- if c.has_db or c.has_cache or c.has_queue or c.has_object_store or c.has_email or c.has_search %}
    depends_on:
{%- for inst in c.db_instances %}
{%- if inst.db_engine != "sqlite" %}
      {{ inst.container }}:
        condition: service_healthy
{%- endif %}
{%- endfor %}
{%- for inst in c.cache_instances %}
      {{ inst.container }}:
        condition: service_healthy
{%- endfor %}
{%- for inst in c.object_store_instances %}
      {{ inst.container }}:
        condition: service_started
{%- endfor %}
{%- for inst in c.email_instances %}
      {{ inst.container }}:
        condition: service_started
{%- endfor %}
{%- for inst in c.search_instances %}
      {{ inst.container }}:
        condition: service_started
{%- endfor %}
{%- if c.has_queue %}
      queue:
        condition: service_started
{%- endif %}
{%- endif %}
{%- if c.has_sqlite_db %}
    volumes:
      - {{ c.dir }}-app-data:{{ backend.data_mount }}
{%- endif %}
{%- if c.workers or c.jobs or c.consumers %}

  {{ c.dir }}-workers:
    build: ./{{ c.dir }}
    command: {{ backend.workers_command }}
{%- if c.has_db or c.has_cache or c.has_queue or c.has_object_store or c.has_email or c.has_search or c.call_targets %}
    environment:
{%- for inst in c.db_instances %}
      {{ inst.env_var }}: {% if inst.db_engine == "sqlite" %}{{ backend.sqlite_url_prefix }}{{ inst.db_name }}.db{{ backend.sqlite_url_suffix }}{% elif inst.db_engine == "mysql" %}{{ backend.mysql_scheme }}://{{ inst.db_user }}:{{ inst.db_user }}@{{ inst.container }}:{{ inst.db_container_port }}/{{ inst.db_name }}{% else %}{{ backend.db_scheme }}://{{ inst.db_user }}:{{ inst.db_user }}@{{ inst.container }}:{{ inst.db_container_port }}/{{ inst.db_name }}{% endif %}
{%- endfor %}
{%- for inst in c.cache_instances %}
      {{ inst.env_var }}: redis://{{ inst.container }}:6379/0
{%- endfor %}
{%- for inst in c.object_store_instances %}{% for f in inst.cfg %}{% if f.compose_value %}
      {{ f.env }}: {{ f.compose_value }}
{%- endif %}{% endfor %}{% endfor %}
{%- for inst in c.email_instances %}{% for f in inst.cfg %}{% if f.compose_value %}
      {{ f.env }}: {{ f.compose_value }}
{%- endif %}{% endfor %}{% endfor %}
{%- for inst in c.search_instances %}{% for f in inst.cfg %}{% if f.compose_value %}
      {{ f.env }}: {{ f.compose_value }}
{%- endif %}{% endfor %}{% endfor %}
{%- for t in c.call_targets %}
      {{ t.env_var }}: http://{{ t.kebab }}:8000
{%- endfor %}
{%- if c.has_queue %}
{%- if c.queue_engine == "kafka" %}
      KAFKA_URL: queue:9092
{%- else %}
      NATS_URL: nats://queue:4222
{%- endif %}
{%- endif %}
    depends_on:
{%- for inst in c.db_instances %}
{%- if inst.db_engine != "sqlite" %}
      {{ inst.container }}:
        condition: service_healthy
{%- endif %}
{%- endfor %}
{%- for inst in c.cache_instances %}
      {{ inst.container }}:
        condition: service_healthy
{%- endfor %}
{%- for inst in c.object_store_instances %}
      {{ inst.container }}:
        condition: service_started
{%- endfor %}
{%- for inst in c.email_instances %}
      {{ inst.container }}:
        condition: service_started
{%- endfor %}
{%- for inst in c.search_instances %}
      {{ inst.container }}:
        condition: service_started
{%- endfor %}
{%- if c.has_queue %}
      queue:
        condition: service_started
{%- endif %}
{%- endif %}
{%- if c.has_sqlite_db %}
    volumes:
      - {{ c.dir }}-app-data:{{ backend.data_mount }}
{%- endif %}
{%- endif %}
{%- endfor %}
{%- for c in m.services %}
{%- for inst in c.db_instances %}
{%- if inst.db_engine != "sqlite" %}

  {{ inst.container }}:
{%- endif %}
{%- if inst.db_engine == "sqlite" %}
{#- no container: the database is a file inside the app (v0.13 M3) #}
{%- elif inst.db_engine == "mysql" %}
    image: mysql:8
    ports:
      - "{{ inst.host_port }}:3306"
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: {{ inst.db_name }}
    volumes:
      - {{ inst.container }}-data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-uroot", "-proot"]
      interval: 2s
      timeout: 3s
      retries: 20
{%- else %}
    image: postgres:16
    ports:
      - "{{ inst.host_port }}:5432"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ inst.db_name }}
    volumes:
      - {{ inst.container }}-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 2s
      timeout: 3s
      retries: 20
{%- endif %}
{%- endfor %}
{%- for inst in c.cache_instances %}

  {{ inst.container }}:
    image: redis:7
    ports:
      - "{{ inst.host_port }}:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 2s
      timeout: 3s
      retries: 20
{%- endfor %}
{%- for inst in c.object_store_instances %}

  {{ inst.container }}:
    image: minio/minio
    command: ["server", "/data"]
    environment:
      MINIO_ROOT_USER: minioadmin
      MINIO_ROOT_PASSWORD: minioadmin
    volumes:
      - {{ inst.container }}-data:/data
{%- endfor %}
{%- for inst in c.email_instances %}

  {{ inst.container }}:
    image: axllent/mailpit
    ports:
      - "{{ inst.host_port }}:8025"
{%- endfor %}
{%- for inst in c.search_instances %}

  {{ inst.container }}:
    image: opensearchproject/opensearch:2
    environment:
      discovery.type: single-node
      DISABLE_SECURITY_PLUGIN: "true"
{%- endfor %}
{%- endfor %}
{%- if m.has_queue %}

  queue:
{%- if m.queue_engine == "kafka" %}
    image: apache/kafka:3.8.0
    # Dual listeners (v0.13 M2): in-network clients use queue:9092;
    # host clients (the generated tests/system suite) use
    # localhost:29092 -- a host client on 9092 would be redirected to
    # the unresolvable advertised name `queue`.
    ports:
      - "29092:29092"
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@queue:9093
      KAFKA_LISTENERS: PLAINTEXT://:9092,CONTROLLER://:9093,EXTERNAL://:29092
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://queue:9092,EXTERNAL://localhost:29092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,EXTERNAL:PLAINTEXT
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "true"
{%- else %}
    image: nats:2
    # Host mapping (v0.13 M2): the generated tests/system delivery and
    # channel tests connect from the host at localhost:4222.
    ports:
      - "4222:4222"
{%- endif %}
{%- endif %}
{%- if m.has_db or m.has_object_store %}

volumes:
{%- for c in m.services %}
{%- if c.has_sqlite_db %}
  {{ c.dir }}-app-data:
{%- endif %}
{%- for inst in c.db_instances %}
{%- if inst.db_engine != "sqlite" %}
  {{ inst.container }}-data:
{%- endif %}
{%- endfor %}
{%- for inst in c.object_store_instances %}
  {{ inst.container }}-data:
{%- endfor %}
{%- endfor %}
{%- endif %}
