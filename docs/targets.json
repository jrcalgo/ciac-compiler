{
  "targets_version": 1,
  "ciac_version": "0.33.0",
  "language_version": "1.0.0",
  "targets": [
    {
      "id": "python",
      "description": "Python 3.11+ project using FastAPI, SQLAlchemy, redis-py, and nats-py",
      "kind": "internal",
      "project_marker": "pyproject.toml",
      "validate": [
        {
          "program": "uv",
          "purpose": "dependencies installed"
        },
        {
          "program": "uv",
          "purpose": "lints"
        },
        {
          "program": "uv",
          "purpose": "unit tests pass"
        }
      ],
      "sim": {
        "level": "full"
      },
      "capabilities": {
        "auth": [
          "JWT",
          "OAuth2"
        ],
        "cache": [
          "Redis"
        ],
        "db": [
          "Postgres",
          "MySQL",
          "SQLite"
        ],
        "email": [
          "SES",
          "SMTP"
        ],
        "logging": [
          "Structured"
        ],
        "metrics": [
          "Prometheus"
        ],
        "object_store": [
          "S3"
        ],
        "queue": [
          "NATS",
          "Kafka"
        ],
        "realtime": [
          "WebSocket",
          "SSE"
        ],
        "scheduler": [
          "Cron"
        ],
        "search": [
          "OpenSearch"
        ],
        "tracing": [
          "OpenTelemetry"
        ],
        "users": [
          "Keycloak"
        ]
      }
    },
