// 27UpdatePlan.md M3: a purpose-built example for the peripheral-fakes
// corpus scenarios (cache-ttl, peripherals, http-fixtures, auth-scopes).
// `extras-verbs.ciac` (v0.14 M3/M4) was the natural first choice to
// reuse, but every one of its handlers returns a bare `Bool`/`[String]`
// -- and `api.py.j2`'s route wrapper unconditionally calls
// `result.model_dump(mode="json")` whenever the api has a typed
// payload, regardless of the pipeline's actual final return type
// (`crates/ciac-backend-python/templates/api.py.j2:103`). That crashes
// on any non-record return with `AttributeError: 'bool' object has no
// attribute 'model_dump'` -- a real, previously undiscovered codegen
// bug (nothing had driven these routes through a live call before this
// arc's simulation work), disclosed in 27UpdatePlan.md's M3 Shipped
// note and left unfixed here: fixing it means threading a "does this
// pipeline's result carry `.model_dump()`" flag through `ApiCtx`/
// `StepCtx` in `ciac-codegen`, a general codegen change out of this
// milestone's peripheral-fakes scope. Every handler below returns the
// `Ack` record for exactly this reason -- not because a real ack
// payload is meaningful here.
service SimPeripherals;

use {
    cache Redis;
    object_store S3;
    email SMTP;
    search OpenSearch;
    external_http upstream { base_url: "https://example.internal"; }
    auth JWT;
}

record KeyOnly {
    key: String;
}

record Notification {
    to: String;
    subject: String;
    body: String;
}

record IndexRequest {
    id: String;
    title: String;
}

record SearchRequest {
    query: String;
}

record HttpRequest {
    path: String;
    payload: String;
}

record Ack {
    ok: Bool;
}

handler EvictCache(payload: KeyOnly) -> Ack {
    cache.delete(payload.key);
    return Ack { ok: true };
}

handler RemoveDoc(payload: KeyOnly) -> Ack {
    object_store.delete(payload.key);
    return Ack { ok: true };
}

handler NotifyUser(payload: Notification) -> Ack {
    email.send(payload.to, payload.subject, payload.body);
    return Ack { ok: true };
}

handler IndexDoc(payload: IndexRequest) -> Ack {
    search.index(payload.id, payload.title);
    return Ack { ok: true };
}

handler SearchDocs(payload: SearchRequest) -> Ack {
    search.query(payload.query);
    return Ack { ok: true };
}

handler CallUpstream(payload: HttpRequest) -> Ack {
    external_http.request(payload.path, payload.payload);
    return Ack { ok: true };
}

// Auth-gated leaf with no db/cache/store dependency of its own -- the
// `auth-scopes` corpus family only needs a route real enough for
// `require_scope` to guard, not one that does anything.
handler Echo(payload: KeyOnly) -> Ack {
    return Ack { ok: true };
}

api EvictCacheApi: KeyOnly;
pipeline EvictCacheApi: EvictCache -> Return;

api RemoveDocApi: KeyOnly;
pipeline RemoveDocApi: RemoveDoc -> Return;

api NotifyUserApi: Notification;
pipeline NotifyUserApi: NotifyUser -> Return;

api IndexDocApi: IndexRequest;
pipeline IndexDocApi: IndexDoc -> Return;

api SearchDocsApi: SearchRequest;
pipeline SearchDocsApi: SearchDocs -> Return;

api CallUpstreamApi: HttpRequest;
pipeline CallUpstreamApi: CallUpstream -> Return;

api EchoApi: KeyOnly {
    scope: "peripherals:admin";
}
pipeline EchoApi: Auth -> Echo -> Return;
