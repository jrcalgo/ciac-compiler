digraph InventorySystem {
    rankdir=LR;
    n0 [label="database default Postgres", shape=cylinder];
    n1 [label="cache default Redis", shape=cylinder];
    n2 [label="api Item", shape=rarrow];
    n3 [label="service ItemStore", shape=box];
    n4 [label="api Price", shape=rarrow];
    n5 [label="api Quote", shape=rarrow];
    n6 [label="service ComputePrice", shape=box];
    n2 -> n3 [label="RequestFlow", style=solid];
    n3 -> n0 [label="DataFlow", style=bold];
    n3 -> n1 [label="DataFlow", style=bold];
    n6 -> n0 [label="DataFlow", style=bold];
    n6 -> n1 [label="DataFlow", style=bold];
    n4 -> n6 [label="RequestFlow", style=solid];
    n5 -> n4 [label="ServiceCall", style=solid];
}
