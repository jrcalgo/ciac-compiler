    n6 -> n2 [label="DataFlow", style=bold];
    n0 -> n6 [label="RequestFlow", style=solid];
    n6 -> n3 [label="AsyncMessage", style=dashed];
    n3 -> n5 [label="AsyncMessage", style=dashed];
    n7 -> n1 [label="DataFlow", style=bold];
