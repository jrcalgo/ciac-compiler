// internal/services/resource_video_store.go -- Generated by CIaC.
// Persistence for the ResourceVideo resource.
package services

import (
	"context"
	"database/sql"
	"errors"

	"github.com/google/uuid"

	"catalog/internal/models"
	"catalog/internal/state"
)

type ResourceVideoStore struct {
	db *sql.DB
}

func NewResourceVideoStore(st *state.AppState) *ResourceVideoStore {
	return &ResourceVideoStore{db: st.DBMain}
}

func (s *ResourceVideoStore) Create(ctx context.Context, payload models.ResourceVideoIn) (models.ResourceVideo, error) {
	entity := models.ResourceVideo{
		ID:    uuid.NewString(),
		Title: payload.Title,
	}
	_, err := s.db.ExecContext(ctx,
		`INSERT INTO resource_videos (id, title) VALUES ($1, $2)`,
		entity.ID,
		entity.Title,
	)
	if err != nil {
		return models.ResourceVideo{}, err
	}
	return entity, nil
}

func (s *ResourceVideoStore) Get(ctx context.Context, id string) (models.ResourceVideo, bool, error) {
	row := s.db.QueryRowContext(ctx,
		`SELECT id, title FROM resource_videos WHERE id = $1`, id)
	var entity models.ResourceVideo
	if err := row.Scan(&entity.ID, &entity.Title); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return models.ResourceVideo{}, false, nil
		}
		return models.ResourceVideo{}, false, err
	}
	return entity, true, nil
}

func (s *ResourceVideoStore) List(ctx context.Context, limit, offset int64) ([]models.ResourceVideo, error) {
	rows, err := s.db.QueryContext(ctx,
		`SELECT id, title FROM resource_videos ORDER BY id LIMIT $1 OFFSET $2`,
		limit, offset)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	out := []models.ResourceVideo{}
	for rows.Next() {
		var entity models.ResourceVideo
		if err := rows.Scan(&entity.ID, &entity.Title); err != nil {
			return nil, err
		}
		out = append(out, entity)
	}
	return out, rows.Err()
}

func (s *ResourceVideoStore) Update(ctx context.Context, id string, payload models.ResourceVideoIn) (models.ResourceVideo, bool, error) {
	entity := models.ResourceVideo{
		ID:    id,
		Title: payload.Title,
	}
	res, err := s.db.ExecContext(ctx,
		`UPDATE resource_videos SET title = $1 WHERE id = $2`,
		entity.Title,
		id,
	)
	if err != nil {
		return models.ResourceVideo{}, false, err
	}
	n, err := res.RowsAffected()
	if err != nil {
		return models.ResourceVideo{}, false, err
	}
	if n == 0 {
		return models.ResourceVideo{}, false, nil
	}
	return entity, true, nil
}

func (s *ResourceVideoStore) Delete(ctx context.Context, id string) (bool, error) {
	res, err := s.db.ExecContext(ctx,
		`DELETE FROM resource_videos WHERE id = $1`, id)
	if err != nil {
		return false, err
	}
	n, err := res.RowsAffected()
	if err != nil {
		return false, err
	}
	return n > 0, nil
}
