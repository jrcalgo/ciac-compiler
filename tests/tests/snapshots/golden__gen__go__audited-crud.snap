// internal/routes/resource_users_api.go -- Generated by CIaC.
// REST endpoints for the ResourceUser resource. Scope checks
// (has_auth/read_scope/write_scope) are not wired yet -- Auth stays
// gated until 24UpdatePlan.md M6, and no reachable example combines
// db with auth before then.
package routes

import (
	"net/http"
	"strconv"

	"accounts/internal/httpx"
	"accounts/internal/models"
	"accounts/internal/services"
	"accounts/internal/state"
)

func RegisterResourceUserRoutes(mux *http.ServeMux, st *state.AppState) {
	store := services.NewResourceUserStore(st)
	mux.HandleFunc("POST /resource_users", createResourceUser(store))
	mux.HandleFunc("GET /resource_users", listResourceUser(store))
	mux.HandleFunc("GET /resource_users/{id}", getResourceUser(store))
	mux.HandleFunc("PUT /resource_users/{id}", updateResourceUser(store))
	mux.HandleFunc("DELETE /resource_users/{id}", deleteResourceUser(store))
}

func createResourceUser(store *services.ResourceUserStore) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		payload, err := models.DecodeResourceUserIn(r.Body)
		if err != nil {
			httpx.WriteError(w, httpx.BadRequest(err))
			return
		}
		entity, err := store.Create(r.Context(), payload)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		httpx.WriteJSON(w, http.StatusCreated, entity)
	}
}

func listResourceUser(store *services.ResourceUserStore) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		limit := int64(100)
		if v := r.URL.Query().Get("limit"); v != "" {
			if parsed, err := strconv.ParseInt(v, 10, 64); err == nil {
				limit = parsed
			}
		}
		offset := int64(0)
		if v := r.URL.Query().Get("offset"); v != "" {
			if parsed, err := strconv.ParseInt(v, 10, 64); err == nil {
				offset = parsed
			}
		}
		entities, err := store.List(r.Context(), limit, offset)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		httpx.WriteJSON(w, http.StatusOK, entities)
	}
}

func getResourceUser(store *services.ResourceUserStore) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		entity, ok, err := store.Get(r.Context(), r.PathValue("id"))
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if !ok {
			httpx.WriteError(w, httpx.NotFound())
			return
		}
		httpx.WriteJSON(w, http.StatusOK, entity)
	}
}

func updateResourceUser(store *services.ResourceUserStore) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		payload, err := models.DecodeResourceUserIn(r.Body)
		if err != nil {
			httpx.WriteError(w, httpx.BadRequest(err))
			return
		}
		entity, ok, err := store.Update(r.Context(), r.PathValue("id"), payload)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if !ok {
			httpx.WriteError(w, httpx.NotFound())
			return
		}
		httpx.WriteJSON(w, http.StatusOK, entity)
	}
}

func deleteResourceUser(store *services.ResourceUserStore) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		ok, err := store.Delete(r.Context(), r.PathValue("id"))
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if !ok {
			httpx.WriteError(w, httpx.NotFound())
			return
		}
		w.WriteHeader(http.StatusNoContent)
	}
}
