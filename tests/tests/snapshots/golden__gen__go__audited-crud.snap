// internal/routes/resource_videos_api.go -- Generated by CIaC.
// REST endpoints for the ResourceVideo resource. Scope checks
// (has_auth/read_scope/write_scope) are not wired yet -- Auth stays
// gated until 24UpdatePlan.md M6, and no reachable example combines
// db with auth before then.
package routes

import (
	"net/http"
	"strconv"

	"catalog/internal/httpx"
	"catalog/internal/models"
	"catalog/internal/services"
	"catalog/internal/state"
)

func RegisterResourceVideoRoutes(mux *http.ServeMux, st *state.AppState) {
	store := services.NewResourceVideoStore(st)
	mux.HandleFunc("POST /resource_videos", createResourceVideo(store))
	mux.HandleFunc("GET /resource_videos", listResourceVideo(store))
	mux.HandleFunc("GET /resource_videos/{id}", getResourceVideo(store))
	mux.HandleFunc("PUT /resource_videos/{id}", updateResourceVideo(store))
	mux.HandleFunc("DELETE /resource_videos/{id}", deleteResourceVideo(store))
}

func createResourceVideo(store *services.ResourceVideoStore) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		payload, err := models.DecodeResourceVideoIn(r.Body)
		if err != nil {
			httpx.WriteError(w, httpx.BadRequest(err))
			return
		}
		entity, err := store.Create(r.Context(), payload)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		httpx.WriteJSON(w, http.StatusCreated, entity)
	}
}

func listResourceVideo(store *services.ResourceVideoStore) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		limit := int64(100)
		if v := r.URL.Query().Get("limit"); v != "" {
			if parsed, err := strconv.ParseInt(v, 10, 64); err == nil {
				limit = parsed
			}
		}
		offset := int64(0)
		if v := r.URL.Query().Get("offset"); v != "" {
			if parsed, err := strconv.ParseInt(v, 10, 64); err == nil {
				offset = parsed
			}
		}
		entities, err := store.List(r.Context(), limit, offset)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		httpx.WriteJSON(w, http.StatusOK, entities)
	}
}

func getResourceVideo(store *services.ResourceVideoStore) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		entity, ok, err := store.Get(r.Context(), r.PathValue("id"))
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if !ok {
			httpx.WriteError(w, httpx.NotFound())
			return
		}
		httpx.WriteJSON(w, http.StatusOK, entity)
	}
}

func updateResourceVideo(store *services.ResourceVideoStore) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		payload, err := models.DecodeResourceVideoIn(r.Body)
		if err != nil {
			httpx.WriteError(w, httpx.BadRequest(err))
			return
		}
		entity, ok, err := store.Update(r.Context(), r.PathValue("id"), payload)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if !ok {
			httpx.WriteError(w, httpx.NotFound())
			return
		}
		httpx.WriteJSON(w, http.StatusOK, entity)
	}
}

func deleteResourceVideo(store *services.ResourceVideoStore) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		ok, err := store.Delete(r.Context(), r.PathValue("id"))
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if !ok {
			httpx.WriteError(w, httpx.NotFound())
			return
		}
		w.WriteHeader(http.StatusNoContent)
	}
}
