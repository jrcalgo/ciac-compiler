// internal/services/resource_user_store.go -- Generated by CIaC.
// Persistence for the ResourceUser resource.
package services

import (
	"context"
	"database/sql"
	"errors"

	"github.com/google/uuid"

	"accounts/internal/models"
	"accounts/internal/state"
)

type ResourceUserStore struct {
	db *sql.DB
}

func NewResourceUserStore(st *state.AppState) *ResourceUserStore {
	return &ResourceUserStore{db: st.DBMain}
}

func (s *ResourceUserStore) Create(ctx context.Context, payload models.ResourceUserIn) (models.ResourceUser, error) {
	entity := models.ResourceUser{
		ID:    uuid.NewString(),
		Title: payload.Title,
	}
	_, err := s.db.ExecContext(ctx,
		`INSERT INTO resource_users (id, title) VALUES ($1, $2)`,
		entity.ID,
		entity.Title,
	)
	if err != nil {
		return models.ResourceUser{}, err
	}
	return entity, nil
}

func (s *ResourceUserStore) Get(ctx context.Context, id string) (models.ResourceUser, bool, error) {
	row := s.db.QueryRowContext(ctx,
		`SELECT id, title FROM resource_users WHERE id = $1`, id)
	var entity models.ResourceUser
	if err := row.Scan(&entity.ID, &entity.Title); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return models.ResourceUser{}, false, nil
		}
		return models.ResourceUser{}, false, err
	}
	return entity, true, nil
}

func (s *ResourceUserStore) List(ctx context.Context, limit, offset int64) ([]models.ResourceUser, error) {
	rows, err := s.db.QueryContext(ctx,
		`SELECT id, title FROM resource_users ORDER BY id LIMIT $1 OFFSET $2`,
		limit, offset)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	out := []models.ResourceUser{}
	for rows.Next() {
		var entity models.ResourceUser
		if err := rows.Scan(&entity.ID, &entity.Title); err != nil {
			return nil, err
		}
		out = append(out, entity)
	}
	return out, rows.Err()
}

func (s *ResourceUserStore) Update(ctx context.Context, id string, payload models.ResourceUserIn) (models.ResourceUser, bool, error) {
	entity := models.ResourceUser{
		ID:    id,
		Title: payload.Title,
	}
	res, err := s.db.ExecContext(ctx,
		`UPDATE resource_users SET title = $1 WHERE id = $2`,
		entity.Title,
		id,
	)
	if err != nil {
		return models.ResourceUser{}, false, err
	}
	n, err := res.RowsAffected()
	if err != nil {
		return models.ResourceUser{}, false, err
	}
	if n == 0 {
		return models.ResourceUser{}, false, nil
	}
	return entity, true, nil
}

func (s *ResourceUserStore) Delete(ctx context.Context, id string) (bool, error) {
	res, err := s.db.ExecContext(ctx,
		`DELETE FROM resource_users WHERE id = $1`, id)
	if err != nil {
		return false, err
	}
	n, err := res.RowsAffected()
	if err != nil {
		return false, err
	}
	return n > 0, nil
}
