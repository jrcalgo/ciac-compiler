// Package state holds shared application state. Generated by CIaC.
package state

import (
	"accounts/internal/config"
	"accounts/internal/db"
	"database/sql"
)

// AppState is every provider client this service's generated code can
// access. Fields are added by later milestones as each capability
// lands (cache clients, the broker client, JWKS) — every one of them
// is constructed lazily, so building an AppState never opens a
// connection (proven by state_test.go's no-infra construction test).
// `database/sql`'s own `sql.Open` is already lazy by construction --
// it never dials, the first query does -- so db pools need no extra
// lazy-init wrapper the way a hand-rolled client would.
type AppState struct {
	Config config.Config
	DBMain *sql.DB
}

// New builds AppState. Construction is infrastructure-free by
// construction: nothing in here (or in any field this struct will
// grow) may block on a network call.
func New(cfg config.Config) (*AppState, error) {
	st := &AppState{Config: cfg}
	db_main, err := db.Open("postgres", cfg.DatabaseURLMain)
	if err != nil {
		return nil, err
	}
	st.DBMain = db_main
	return st, nil
}
