// internal/routes/notes_api.go -- Generated by CIaC.
// REST endpoints for the Note resource.
package routes

import (
	"encoding/json"
	"net/http"
	"notes/internal/auth"
	"notes/internal/config"
	"notes/internal/httpx"
	"notes/internal/models"
	"notes/internal/services"
	"notes/internal/state"
	"strconv"
)

func RegisterNoteRoutes(mux *http.ServeMux, st *state.AppState) {
	store := services.NewNoteStore(st)
	cfg := st.Config
	mux.HandleFunc("POST /notes", createNote(store, cfg))
	mux.HandleFunc("GET /notes", listNote(store, cfg))
	mux.HandleFunc("GET /notes/{id}", getNote(store, cfg))
	mux.HandleFunc("PUT /notes/{id}", updateNote(store, cfg))
	mux.HandleFunc("DELETE /notes/{id}", deleteNote(store, cfg))
}

func createNote(store *services.NoteStore, cfg config.Config) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		claims, err := auth.VerifyToken(r, cfg)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		_ = claims
		var payload models.NoteIn
		if err := json.NewDecoder(r.Body).Decode(&payload); err != nil {
			httpx.WriteError(w, httpx.BadRequest(err))
			return
		}
		entity, err := store.Create(r.Context(), payload)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		httpx.WriteJSON(w, http.StatusCreated, entity)
	}
}

func listNote(store *services.NoteStore, cfg config.Config) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		claims, err := auth.VerifyToken(r, cfg)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		_ = claims
		limit := int64(100)
		if v := r.URL.Query().Get("limit"); v != "" {
			if parsed, err := strconv.ParseInt(v, 10, 64); err == nil {
				limit = parsed
			}
		}
		offset := int64(0)
		if v := r.URL.Query().Get("offset"); v != "" {
			if parsed, err := strconv.ParseInt(v, 10, 64); err == nil {
				offset = parsed
			}
		}
		entities, err := store.List(r.Context(), limit, offset)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		httpx.WriteJSON(w, http.StatusOK, entities)
	}
}

func getNote(store *services.NoteStore, cfg config.Config) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		claims, err := auth.VerifyToken(r, cfg)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		_ = claims
		entity, ok, err := store.Get(r.Context(), r.PathValue("id"))
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if !ok {
			httpx.WriteError(w, httpx.NotFound())
			return
		}
		httpx.WriteJSON(w, http.StatusOK, entity)
	}
}

func updateNote(store *services.NoteStore, cfg config.Config) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		claims, err := auth.VerifyToken(r, cfg)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		_ = claims
		var payload models.NoteIn
		if err := json.NewDecoder(r.Body).Decode(&payload); err != nil {
			httpx.WriteError(w, httpx.BadRequest(err))
			return
		}
		entity, ok, err := store.Update(r.Context(), r.PathValue("id"), payload)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if !ok {
			httpx.WriteError(w, httpx.NotFound())
			return
		}
		httpx.WriteJSON(w, http.StatusOK, entity)
	}
}

func deleteNote(store *services.NoteStore, cfg config.Config) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		claims, err := auth.VerifyToken(r, cfg)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		_ = claims
		ok, err := store.Delete(r.Context(), r.PathValue("id"))
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if !ok {
			httpx.WriteError(w, httpx.NotFound())
			return
		}
		w.WriteHeader(http.StatusNoContent)
	}
}
