// Package db manages database connections, CRUD-resource schema
// bootstrap, and `table`-declaration migrations. Generated by CIaC.
package db

import (
	"database/sql"
	"fmt"
	"os"

	_ "github.com/go-sql-driver/mysql"
	_ "github.com/jackc/pgx/v5/stdlib"
	_ "modernc.org/sqlite"
)

// Open returns a lazy *sql.DB for engine (postgres | mysql | sqlite).
// sql.Open never dials -- the first query does, so constructing state
// never requires a running database. sqlite is a local file rather
// than a server, so its data/ directory must exist before the driver
// can create the file itself (mirroring the other backends' own
// std::fs::create_dir_all("data")-equivalent).
func Open(engine, dsn string) (*sql.DB, error) {
	driver, ok := map[string]string{"postgres": "pgx", "mysql": "mysql", "sqlite": "sqlite"}[engine]
	if !ok {
		return nil, fmt.Errorf("unknown db engine %q", engine)
	}
	if engine == "sqlite" {
		if err := os.MkdirAll("data", 0o755); err != nil {
			return nil, fmt.Errorf("create data directory: %w", err)
		}
	}
	return sql.Open(driver, dsn)
}

// EnsureSchemaPostgres creates CRUD-resource tables on
// startup (postgres). `table` declarations are provisioned by
// Migrate instead.
func EnsureSchemaPostgres(db *sql.DB) error {
	if _, err := db.Exec(`CREATE TABLE IF NOT EXISTS notes (
		id VARCHAR(36) PRIMARY KEY,
		data JSONB NOT NULL DEFAULT '{}'::jsonb

	)`); err != nil {
		return fmt.Errorf("ensure schema notes: %w", err)
	}
	return nil
}
