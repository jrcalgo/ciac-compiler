// Package httpx carries the request envelope and error-to-status
// mapping every generated route uses -- the `AppError`/`error.rs`
// analog (Pillar 3). Generated by CIaC.
package httpx

import (
	"encoding/json"
	"errors"
	"log/slog"
	"net/http"
)

// AppError is a route-level error carrying the HTTP status to report.
// Any error that isn't already an *AppError becomes a 500 with the
// cause logged -- the `?`-propagation analog every other target's
// error middleware gives for free, done explicitly here since Go has
// no propagation operator.
type AppError struct {
	Status  int
	Message string
	cause   error
}

func (e *AppError) Error() string {
	if e.cause != nil {
		return e.cause.Error()
	}
	return e.Message
}

func (e *AppError) Unwrap() error { return e.cause }

func NotFound() *AppError {
	return &AppError{Status: http.StatusNotFound, Message: "not found"}
}

func Forbidden() *AppError {
	return &AppError{Status: http.StatusForbidden, Message: "forbidden"}
}

func Unauthorized() *AppError {
	return &AppError{Status: http.StatusUnauthorized, Message: "unauthorized"}
}

// BadRequest wraps a decode/validation failure as a 400 -- the
// generated route layer's first error-mapping step (decode, then
// presence check, then validator, in that order per Pillar 3).
func BadRequest(err error) *AppError {
	return &AppError{Status: http.StatusBadRequest, Message: err.Error(), cause: err}
}

// Wrap turns any error into an *AppError, passing an existing one
// through unchanged and mapping everything else to a 500.
func Wrap(err error) *AppError {
	var appErr *AppError
	if errors.As(err, &appErr) {
		return appErr
	}
	return &AppError{Status: http.StatusInternalServerError, Message: "internal server error", cause: err}
}

// WriteJSON writes v as the JSON body with status.
func WriteJSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(v)
}

// WriteError writes err's status/body, logging the underlying cause
// for 500s only -- an intentional 400/403/404 is not a server fault
// and does not pollute the error log.
func WriteError(w http.ResponseWriter, err error) {
	appErr := Wrap(err)
	if appErr.Status == http.StatusInternalServerError {
		slog.Error("request failed", "error", appErr.Unwrap())
	}
	WriteJSON(w, appErr.Status, map[string]string{"error": appErr.Message})
}

// Accepted writes the standard success envelope every generated api
// route returns: {"status": "accepted", "data": <result>}. The HTTP
// status is always 200 -- "accepted" names the envelope shape, not
// the transport status, matching every other target's convention.
func Accepted(w http.ResponseWriter, data any) {
	WriteJSON(w, http.StatusOK, map[string]any{"status": "accepted", "data": data})
}
