// Package models holds persistence row shapes for CRUD resources and
// `table` declarations. Generated by CIaC.
//
// Typed resources (`crud X: Record;`) get real columns from their
// record; untyped ones keep a generic keyed-document model (a
// server-generated id + a JSON payload). `table <Name>: <Record>;`
// declarations get the same column treatment, named after the table
// so a record reused under several table names doesn't collide.
// Enums are stored as their text form and converted at the record
// boundary (see each type's own comment) -- database/sql has no
// FromRow-style mapper, so every store's Scan call lists columns in
// this struct's own declared order (Pillar 4's "explicit Scan column
// order").
//
// Typed `<Name>In` payloads decode through Decode<Name>In, applying
// the same absent/explicit-null/zero-value discipline
// internal/schemas' own decoders use (Pillar 2) -- a bare
// encoding/json.Decode would silently accept a create/update request
// missing a required field, exactly the trap this package exists to
// close for CRUD the same way schemas.go already closes it for
// typed apis.
package models

import (
	"encoding/json"
)

// Note is the generic keyed-document row shape.
type Note struct {
	ID   string          `json:"id"`
	Data json.RawMessage `json:"data"`
}

// NoteIn is the create/update payload.
type NoteIn struct {
	Data json.RawMessage `json:"data"`
}
