// internal/services/note_store.go -- Generated by CIaC.
// Persistence for the Note resource with read-through caching.
package services

import (
	"context"
	"database/sql"
	"encoding/json"
	"errors"
	"fmt"
	"time"

	"github.com/redis/go-redis/v9"

	"github.com/google/uuid"

	"notes/internal/models"
	"notes/internal/state"
)

type NoteStore struct {
	db    *sql.DB
	cache *redis.Client
}

func NewNoteStore(st *state.AppState) *NoteStore {
	return &NoteStore{
		db:    st.DB,
		cache: st.Cache,
	}
}

func notestoreCacheKey(id string) string {
	return fmt.Sprintf("notes:%s", id)
}

func (s *NoteStore) Create(ctx context.Context, payload models.NoteIn) (models.Note, error) {
	entity := models.Note{ID: uuid.NewString(), Data: payload.Data}
	_, err := s.db.ExecContext(ctx,
		`INSERT INTO notes (id, data) VALUES ($1, $2)`,
		entity.ID, []byte(entity.Data))
	if err != nil {
		return models.Note{}, err
	}
	return entity, nil
}

func (s *NoteStore) Get(ctx context.Context, id string) (models.Note, bool, error) {
	if cached, err := s.cache.Get(ctx, notestoreCacheKey(id)).Result(); err == nil {
		var entity models.Note
		if err := json.Unmarshal([]byte(cached), &entity); err != nil {
			return models.Note{}, false, err
		}
		return entity, true, nil
	} else if !errors.Is(err, redis.Nil) {
		return models.Note{}, false, err
	}
	row := s.db.QueryRowContext(ctx,
		`SELECT id, data FROM notes WHERE id = $1`, id)
	var entity models.Note
	var raw []byte
	if err := row.Scan(&entity.ID, &raw); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return models.Note{}, false, nil
		}
		return models.Note{}, false, err
	}
	entity.Data = raw
	if encoded, err := json.Marshal(entity); err == nil {
		if err := s.cache.Set(ctx, notestoreCacheKey(id), encoded, 300*time.Second).Err(); err != nil {
			return models.Note{}, false, err
		}
	} else {
		return models.Note{}, false, err
	}
	return entity, true, nil
}

func (s *NoteStore) List(ctx context.Context, limit, offset int64) ([]models.Note, error) {
	rows, err := s.db.QueryContext(ctx,
		`SELECT id, data FROM notes ORDER BY id LIMIT $1 OFFSET $2`,
		limit, offset)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	out := []models.Note{}
	for rows.Next() {
		var entity models.Note
		var raw []byte
		if err := rows.Scan(&entity.ID, &raw); err != nil {
			return nil, err
		}
		entity.Data = raw
		out = append(out, entity)
	}
	return out, rows.Err()
}

func (s *NoteStore) Update(ctx context.Context, id string, payload models.NoteIn) (models.Note, bool, error) {
	res, err := s.db.ExecContext(ctx,
		`UPDATE notes SET data = $1 WHERE id = $2`,
		[]byte(payload.Data), id)
	if err != nil {
		return models.Note{}, false, err
	}
	n, err := res.RowsAffected()
	if err != nil {
		return models.Note{}, false, err
	}
	if n == 0 {
		return models.Note{}, false, nil
	}
	entity := models.Note{ID: id, Data: payload.Data}
	if encoded, err := json.Marshal(entity); err == nil {
		if err := s.cache.Set(ctx, notestoreCacheKey(id), encoded, 300*time.Second).Err(); err != nil {
			return models.Note{}, false, err
		}
	} else {
		return models.Note{}, false, err
	}
	return entity, true, nil
}

func (s *NoteStore) Delete(ctx context.Context, id string) (bool, error) {
	res, err := s.db.ExecContext(ctx,
		`DELETE FROM notes WHERE id = $1`, id)
	if err != nil {
		return false, err
	}
	n, err := res.RowsAffected()
	if err != nil {
		return false, err
	}
	if n > 0 {
		if err := s.cache.Del(ctx, notestoreCacheKey(id)).Err(); err != nil {
			return false, err
		}
	}
	return n > 0, nil
}
