// internal/workers/processor.go -- Generated by CIaC.
// Broker consumer for `worker Processor`.
//
// Consumes ingest.events in queue group processor so
// replicas of this worker load-balance messages between them.
package workers

import (
	"context"
	"encoding/json"
	"log/slog"
	"sync"

	"ingest/internal/services"
	"ingest/internal/state"
)

const (
	ProcessorSubject     = "ingest.events"
	ProcessorQueueGroup  = "processor"
	ProcessorConcurrency = 1
	ProcessorMaxRetries  = 0
)

// HandleMessageOnce runs the pipeline exactly once, no retry/backoff
// wrapper -- the seam a future simulation runner (24UpdatePlan.md M9)
// drives directly with its own attempt counting, mirroring
// `handle_message_once` in the Python/Rust backends.
func HandleMessageOnceProcessor(ctx context.Context, st *state.AppState, payload any) error {
	result := payload

	if v, err := services.NewEnrich(st).Handle(ctx, result); err != nil {
		return err
	} else {
		result = v
	}

	if v, err := services.NewStore(st).Handle(ctx, result); err != nil {
		return err
	} else {
		result = v
	}
	_ = result
	return nil
}

func handleMessageProcessor(ctx context.Context, st *state.AppState, payload any) error {
	var err error
	for attempt := 0; attempt <= ProcessorMaxRetries; attempt++ {
		if err = HandleMessageOnceProcessor(ctx, st, payload); err == nil {
			return nil
		}
		if attempt < ProcessorMaxRetries {
			slog.Warn("message processing failed; retrying", "error", err, "attempt", attempt)
		}
	}
	return err
}

func consumeProcessor(ctx context.Context, st *state.AppState, index int) {
	ch, err := st.Queue.QueueSubscribe(ProcessorSubject, ProcessorQueueGroup)
	if err != nil {
		slog.Error("worker Processor: subscribing", "error", err, "index", index)
		return
	}
	slog.Info("worker Processor consuming", "subject", ProcessorSubject, "index", index)
	for msg := range ch {
		var payload any
		if err := json.Unmarshal(msg.Data, &payload); err != nil {
			slog.Warn("discarding malformed message", "error", err)
			continue
		}
		if err := handleMessageProcessor(ctx, st, payload); err != nil {
			slog.Error("message processing failed after all retries", "error", err, "worker", "Processor", "index", index)
		}
	}
}

// RunProcessor starts ProcessorConcurrency consuming goroutines and
// blocks until ctx is done.
func RunProcessor(ctx context.Context, st *state.AppState) {
	var wg sync.WaitGroup
	for i := 0; i < ProcessorConcurrency; i++ {
		wg.Add(1)
		go func(index int) {
			defer wg.Done()
			consumeProcessor(ctx, st, index)
		}(i)
	}
	wg.Wait()
}
