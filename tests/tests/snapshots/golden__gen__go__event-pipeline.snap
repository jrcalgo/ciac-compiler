// internal/routes/submit_api.go -- Generated by CIaC.
//
// Pipeline: Submit. Scope checks (has_auth_step) are not wired
// yet -- Auth stays gated until 24UpdatePlan.md M6, and no reachable
// example combines a scoped api with this shape before then.
package routes

import (
	"ingest/internal/httpx"
	"ingest/internal/queue"
	"ingest/internal/services"
	"ingest/internal/state"
	"net/http"
)

func SubmitHandler(st *state.AppState) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		// ctx may go unused (a pipeline with no handler/publish/call
		// step, e.g. plain `Return`) or genuinely used below,
		// depending on this api's steps -- always declaring it keeps
		// this handler's shape stable as the pipeline grows.
		ctx := r.Context()
		_ = ctx
		var result any = map[string]any{}

		if v, err := services.NewValidate(st).Handle(ctx, result); err != nil {
			httpx.WriteError(w, err)
			return
		} else {
			result = v
		}

		if err := queue.PublishJSON(st.Queue, "ingest.events", result); err != nil {
			httpx.WriteError(w, err)
			return
		}

		httpx.Accepted(w, result)
	}
}
