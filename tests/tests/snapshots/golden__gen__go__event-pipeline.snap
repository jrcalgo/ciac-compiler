// A bare `events <Name>;` declaration has no pipeline -- business
// logic goes directly in handleEventPageViewConsumer below (this
// file is compiler-owned, not seeded: v0.1 established this shape as
// a pure stub with no generated call sites to preserve).
package workers

import (
	"context"
	"encoding/json"
	"log/slog"

	"ingest/internal/state"
)

const (
	PageViewConsumerSubject    = "ingest.page_view"
	PageViewConsumerQueueGroup = "page_view_consumer"
)

func handleEventPageViewConsumer(_ *state.AppState, payload any) error {
	// TODO: implement PageViewConsumer.
	_ = payload
	return nil
}

func consumePageViewConsumer(_ context.Context, st *state.AppState) {
	ch, err := st.Queue.QueueSubscribe(PageViewConsumerSubject, PageViewConsumerQueueGroup)
	if err != nil {
		slog.Error("consumer PageViewConsumer: subscribing", "error", err)
		return
	}
	slog.Info("consumer PageViewConsumer listening", "subject", PageViewConsumerSubject)
	for msg := range ch {
		var payload any
		if err := json.Unmarshal(msg.Data, &payload); err != nil {
			slog.Warn("discarding malformed event", "error", err)
			continue
		}
		if err := handleEventPageViewConsumer(st, payload); err != nil {
			slog.Error("event processing failed", "error", err)
		}
	}
}

// RunPageViewConsumer starts the consumer and blocks until ctx is done.
func RunPageViewConsumer(ctx context.Context, st *state.AppState) {
	consumePageViewConsumer(ctx, st)
}
