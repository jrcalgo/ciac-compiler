// Package observability wires structured logging. Generated by CIaC.
// Metrics/tracing wiring is added by the milestone that first declares
// them (`use { metrics Prometheus; }` / `use { tracing OpenTelemetry; }`).
package observability

import (
	"log/slog"
	"os"
)

// Init installs the process-wide slog default handler. Called once
// from cmd/api/main.go and cmd/workers/main.go before anything else
// runs.
func Init() {
	level := slog.LevelInfo
	if v := os.Getenv("LOG_LEVEL"); v != "" {
		_ = level.UnmarshalText([]byte(v))
	}
	handler := slog.NewTextHandler(os.Stdout, &slog.HandlerOptions{Level: level})
	slog.SetDefault(slog.New(handler))
}
