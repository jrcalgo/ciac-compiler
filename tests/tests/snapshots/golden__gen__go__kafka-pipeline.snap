// internal/routes/ingest_api.go -- Generated by CIaC.
//
// Pipeline: Ingest. Scope checks (has_auth_step) are not wired
// yet -- Auth stays gated until 24UpdatePlan.md M6, and no reachable
// example combines a scoped api with this shape before then.
package routes

import (
	"clickstream/internal/httpx"
	"clickstream/internal/queue"
	"clickstream/internal/schemas"
	"clickstream/internal/state"
	"net/http"
)

func IngestHandler(st *state.AppState) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		// ctx may go unused (a pipeline with no handler/publish/call
		// step, e.g. plain `Return`) or genuinely used below,
		// depending on this api's steps -- always declaring it keeps
		// this handler's shape stable as the pipeline grows.
		ctx := r.Context()
		_ = ctx
		decoded, err := schemas.DecodeClick(r.Body)
		if err != nil {
			httpx.WriteError(w, httpx.BadRequest(err))
			return
		}
		var result any = decoded

		if err := queue.PublishJSON(st.Queue, "clickstream.clicks", result); err != nil {
			httpx.WriteError(w, err)
			return
		}

		httpx.Accepted(w, result)
	}
}
