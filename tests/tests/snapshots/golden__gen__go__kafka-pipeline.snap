internal/workers/enrich.go
============================================================
// internal/workers/enrich.go -- Generated by CIaC.
// Broker consumer for `worker Enrich`.
//
// Consumes clickstream.clicks in queue group enrich so
// replicas of this worker load-balance messages between them.
package workers

import (
	"context"
	"encoding/json"
	"github.com/twmb/franz-go/pkg/kgo"
	"log/slog"
	"sync"

	"clickstream/internal/services"
	"clickstream/internal/state"
)

const (
	EnrichSubject     = "clickstream.clicks"
	EnrichQueueGroup  = "enrich"
	EnrichConcurrency = 1
	EnrichMaxRetries  = 0
)

// HandleMessageOnce runs the pipeline exactly once, no retry/backoff
// wrapper -- the seam a future simulation runner (24UpdatePlan.md M9)
// drives directly with its own attempt counting, mirroring
// `handle_message_once` in the Python/Rust backends.
func HandleMessageOnceEnrich(ctx context.Context, st *state.AppState, payload any) error {
	result := payload

	if v, err := services.NewEnrichClick(st).Handle(ctx, result); err != nil {
		return err
	} else {
		result = v
	}
	_ = result
	return nil
}

func handleMessageEnrich(ctx context.Context, st *state.AppState, payload any) error {
	var err error
	for attempt := 0; attempt <= EnrichMaxRetries; attempt++ {
		if err = HandleMessageOnceEnrich(ctx, st, payload); err == nil {
			return nil
		}
		if attempt < EnrichMaxRetries {
			slog.Warn("message processing failed; retrying", "error", err, "attempt", attempt)
		}
	}
	return err
}

func consumeEnrich(ctx context.Context, st *state.AppState, index int) {
	cl, err := st.Queue.Consumer(EnrichSubject, EnrichQueueGroup)
	if err != nil {
		slog.Error("worker Enrich: connecting to kafka", "error", err, "index", index)
		return
	}
	defer cl.Close()
	slog.Info("worker Enrich consuming", "subject", EnrichSubject, "index", index)
	for {
		fetches := cl.PollFetches(ctx)
		if ctx.Err() != nil {
			return
		}
		fetches.EachError(func(_ string, _ int32, err error) {
			slog.Warn("kafka fetch error", "error", err)
		})
		fetches.EachRecord(func(record *kgo.Record) {
			var payload any
			if err := json.Unmarshal(record.Value, &payload); err != nil {
				slog.Warn("discarding malformed message", "error", err)
				return
			}
			if err := handleMessageEnrich(ctx, st, payload); err != nil {
				slog.Error("message processing failed after all retries", "error", err, "worker", "Enrich", "index", index)
			}
		})
	}
}

// RunEnrich starts EnrichConcurrency consuming goroutines and
// blocks until ctx is done.
func RunEnrich(ctx context.Context, st *state.AppState) {
	var wg sync.WaitGroup
	for i := 0; i < EnrichConcurrency; i++ {
		wg.Add(1)
		go func(index int) {
			defer wg.Done()
			consumeEnrich(ctx, st, index)
		}(i)
	}
	wg.Wait()
}
