cmd/workers/main.go
============================================================
// cmd/workers/main.go -- Generated by CIaC.
package main

import (
	"context"
	"log"

	"golang.org/x/sync/errgroup"

	"clickstream/internal/config"
	"clickstream/internal/observability"
	"clickstream/internal/state"
	"clickstream/internal/workers"
)

func main() {
	observability.Init()
	cfg := config.FromEnv()
	st, err := state.New(cfg)
	if err != nil {
		log.Fatalf("state.New: %v", err)
	}

	ctx := context.Background()
	g, ctx := errgroup.WithContext(ctx)
	g.Go(func() error {
		workers.RunEnrich(ctx, st)
		return nil
	})
	if err := g.Wait(); err != nil {
		log.Fatal(err)
	}
}
