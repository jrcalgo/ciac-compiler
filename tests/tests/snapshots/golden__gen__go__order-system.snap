// internal/workers/order_event_sink.go -- Generated by CIaC.
// Broker consumer for `worker OrderEventSink`.
//
// Consumes order_system.received_order_event in queue group order_event_sink so
// replicas of this worker load-balance messages between them.
package workers

import (
	"context"
	"encoding/json"
	"log/slog"
	"sync"

	"order-system/internal/schemas"
	"order-system/internal/services"
	"order-system/internal/state"
)

const (
	OrderEventSinkSubject     = "order_system.received_order_event"
	OrderEventSinkQueueGroup  = "order_event_sink"
	OrderEventSinkConcurrency = 1
	OrderEventSinkMaxRetries  = 0
)

// HandleMessageOnce runs the pipeline exactly once, no retry/backoff
// wrapper -- the seam a future simulation runner (24UpdatePlan.md M9)
// drives directly with its own attempt counting, mirroring
// `handle_message_once` in the Python/Rust backends.
func HandleMessageOnceOrderEventSink(ctx context.Context, st *state.AppState, payload any) error {
	result := payload

	if v, err := services.NewRecordEvent(st).Handle(ctx, result); err != nil {
		return err
	} else {
		result = v
	}
	_ = result
	return nil
}

func handleMessageOrderEventSink(ctx context.Context, st *state.AppState, payload any) error {
	var err error
	for attempt := 0; attempt <= OrderEventSinkMaxRetries; attempt++ {
		if err = HandleMessageOnceOrderEventSink(ctx, st, payload); err == nil {
			return nil
		}
		if attempt < OrderEventSinkMaxRetries {
			slog.Warn("message processing failed; retrying", "error", err, "attempt", attempt)
		}
	}
	return err
}

func consumeOrderEventSink(ctx context.Context, st *state.AppState, index int) {
	ch, err := st.Queue.QueueSubscribe(OrderEventSinkSubject, OrderEventSinkQueueGroup)
	if err != nil {
		slog.Error("worker OrderEventSink: subscribing", "error", err, "index", index)
		return
	}
	slog.Info("worker OrderEventSink consuming", "subject", OrderEventSinkSubject, "index", index)
	for msg := range ch {
		var typed schemas.OrderEvent
		if err := json.Unmarshal(msg.Data, &typed); err != nil {
			slog.Warn("discarding malformed message", "error", err)
			continue
		}
		var payload any = typed
		if err := handleMessageOrderEventSink(ctx, st, payload); err != nil {
			slog.Error("message processing failed after all retries", "error", err, "worker", "OrderEventSink", "index", index)
		}
	}
}

// RunOrderEventSink starts OrderEventSinkConcurrency consuming goroutines and
// blocks until ctx is done.
func RunOrderEventSink(ctx context.Context, st *state.AppState) {
	var wg sync.WaitGroup
	for i := 0; i < OrderEventSinkConcurrency; i++ {
		wg.Add(1)
		go func(index int) {
			defer wg.Done()
			consumeOrderEventSink(ctx, st, index)
		}(i)
	}
	wg.Wait()
}
