// Package state holds shared application state. Generated by CIaC.
package state

import (
	"database/sql"
	"order-system/internal/config"
	"order-system/internal/db"
	"order-system/internal/queue"

	"github.com/redis/go-redis/v9"
	"github.com/redis/go-redis/v9/maintnotifications"
)

// AppState is every provider client this service's generated code can
// access. Every one of them is constructed lazily, so building an
// AppState never opens a connection (proven by state_test.go's
// no-infra construction test). `database/sql`'s own `sql.Open` is
// already lazy by construction -- it never dials, the first query
// does -- so db pools need no extra lazy-init wrapper the way a
// hand-rolled client would; `redis.NewClient` is the same (it parses
// the URL and returns immediately, no dial). `object_store`/`email`/
// `search`/`external_http` wrapper clients hold configuration only
// (their own underlying client is built per call — see each
// package's own doc), so there is nothing to lazily construct there
// either.
type AppState struct {
	Config config.Config
	DB     *sql.DB
	Cache  *redis.Client
	Queue  *queue.Queue
}

// New builds AppState. Construction is infrastructure-free by
// construction: nothing in here (or in any field this struct will
// grow) may block on a network call.
func New(cfg config.Config) (*AppState, error) {
	st := &AppState{Config: cfg}
	db, err := db.Open("postgres", cfg.DatabaseURL)
	if err != nil {
		return nil, err
	}
	st.DB = db
	cacheOpts, err := redis.ParseURL(cfg.RedisURL)
	if err != nil {
		return nil, err
	}
	// go-redis v9's "maintenance notifications" feature (Redis Cloud/
	// Enterprise cluster-maintenance push events) defaults to
	// `ModeAuto` and spawns a background `CircuitBreakerManager`
	// goroutine at `NewClient` time regardless of target -- found live
	// (`TestNewLeaksNoGoroutines`, the same no-infra-at-construction
	// discipline that caught franz-go's own construction-time
	// goroutines at v0.24 M3): a plain local/dev Redis never sends
	// these notifications, so there is nothing for this backend to
	// react to. Disabled explicitly rather than left to "auto-detects
	// and turns itself off on error", which only happens after a
	// first failed attempt, not before the goroutine is spawned.
	cacheOpts.MaintNotificationsConfig = &maintnotifications.Config{Mode: maintnotifications.ModeDisabled}
	st.Cache = redis.NewClient(cacheOpts)
	st.Queue = queue.New(cfg.NatsURL)
	return st, nil
}
