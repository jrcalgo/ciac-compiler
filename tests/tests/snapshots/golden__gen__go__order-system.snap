func RegisterCustomerRoutes(mux *http.ServeMux, st *state.AppState) {
	store := services.NewCustomerStore(st)
	cfg := st.Config
	mux.HandleFunc("POST /customers", createCustomer(store, cfg))
	mux.HandleFunc("GET /customers", listCustomer(store, cfg))
	mux.HandleFunc("GET /customers/{id}", getCustomer(store, cfg))
	mux.HandleFunc("PUT /customers/{id}", updateCustomer(store, cfg))
	mux.HandleFunc("DELETE /customers/{id}", deleteCustomer(store, cfg))
}

func createCustomer(store *services.CustomerStore, cfg config.Config) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		claims, err := auth.VerifyToken(r, cfg)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if err := auth.RequireScope(claims, "customers:write"); err != nil {
			httpx.WriteError(w, err)
			return
		}
		payload, err := models.DecodeCustomerIn(r.Body)
		if err != nil {
			httpx.WriteError(w, httpx.BadRequest(err))
			return
		}
		entity, err := store.Create(r.Context(), payload)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		httpx.WriteJSON(w, http.StatusCreated, entity)
	}
}

func listCustomer(store *services.CustomerStore, cfg config.Config) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		claims, err := auth.VerifyToken(r, cfg)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if err := auth.RequireScope(claims, "customers:read"); err != nil {
			httpx.WriteError(w, err)
			return
		}
		limit := int64(50)
		if v := r.URL.Query().Get("limit"); v != "" {
			if parsed, err := strconv.ParseInt(v, 10, 64); err == nil {
				limit = parsed
			}
		}
		offset := int64(0)
		if v := r.URL.Query().Get("offset"); v != "" {
			if parsed, err := strconv.ParseInt(v, 10, 64); err == nil {
				offset = parsed
			}
		}
		entities, err := store.List(r.Context(), limit, offset)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		httpx.WriteJSON(w, http.StatusOK, entities)
	}
}

func getCustomer(store *services.CustomerStore, cfg config.Config) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		claims, err := auth.VerifyToken(r, cfg)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if err := auth.RequireScope(claims, "customers:read"); err != nil {
			httpx.WriteError(w, err)
			return
		}
		entity, ok, err := store.Get(r.Context(), r.PathValue("id"))
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if !ok {
			httpx.WriteError(w, httpx.NotFound())
			return
		}
		httpx.WriteJSON(w, http.StatusOK, entity)
	}
}

func updateCustomer(store *services.CustomerStore, cfg config.Config) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		claims, err := auth.VerifyToken(r, cfg)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if err := auth.RequireScope(claims, "customers:write"); err != nil {
			httpx.WriteError(w, err)
			return
		}
		payload, err := models.DecodeCustomerIn(r.Body)
		if err != nil {
			httpx.WriteError(w, httpx.BadRequest(err))
			return
		}
		entity, ok, err := store.Update(r.Context(), r.PathValue("id"), payload)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if !ok {
			httpx.WriteError(w, httpx.NotFound())
			return
		}
		httpx.WriteJSON(w, http.StatusOK, entity)
	}
}

func deleteCustomer(store *services.CustomerStore, cfg config.Config) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		claims, err := auth.VerifyToken(r, cfg)
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if err := auth.RequireScope(claims, "customers:write"); err != nil {
			httpx.WriteError(w, err)
			return
		}
		ok, err := store.Delete(r.Context(), r.PathValue("id"))
		if err != nil {
			httpx.WriteError(w, err)
			return
		}
		if !ok {
			httpx.WriteError(w, httpx.NotFound())
			return
		}
		w.WriteHeader(http.StatusNoContent)
	}
}
