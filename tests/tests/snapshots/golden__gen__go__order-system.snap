// internal/services/customer_store.go -- Generated by CIaC.
// Persistence for the Customer resource with read-through caching.
package services

import (
	"context"
	"database/sql"
	"encoding/json"
	"errors"
	"fmt"
	"time"

	"github.com/redis/go-redis/v9"

	"github.com/google/uuid"

	"order-system/internal/models"
	"order-system/internal/state"
)

type CustomerStore struct {
	db    *sql.DB
	cache *redis.Client
}

func NewCustomerStore(st *state.AppState) *CustomerStore {
	return &CustomerStore{
		db:    st.DB,
		cache: st.Cache,
	}
}

func customerstoreCacheKey(id string) string {
	return fmt.Sprintf("customers:%s", id)
}

func (s *CustomerStore) Create(ctx context.Context, payload models.CustomerIn) (models.Customer, error) {
	entity := models.Customer{
		ID:    uuid.NewString(),
		Name:  payload.Name,
		Email: payload.Email,
	}
	_, err := s.db.ExecContext(ctx,
		`INSERT INTO customers (id, name, email) VALUES ($1, $2, $3)`,
		entity.ID,
		entity.Name,
		entity.Email,
	)
	if err != nil {
		return models.Customer{}, err
	}
	return entity, nil
}

func (s *CustomerStore) Get(ctx context.Context, id string) (models.Customer, bool, error) {
	if cached, err := s.cache.Get(ctx, customerstoreCacheKey(id)).Result(); err == nil {
		var entity models.Customer
		if err := json.Unmarshal([]byte(cached), &entity); err != nil {
			return models.Customer{}, false, err
		}
		return entity, true, nil
	} else if !errors.Is(err, redis.Nil) {
		return models.Customer{}, false, err
	}
	row := s.db.QueryRowContext(ctx,
		`SELECT id, name, email FROM customers WHERE id = $1`, id)
	var entity models.Customer
	if err := row.Scan(&entity.ID, &entity.Name, &entity.Email); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return models.Customer{}, false, nil
		}
		return models.Customer{}, false, err
	}
	if encoded, err := json.Marshal(entity); err == nil {
		if err := s.cache.Set(ctx, customerstoreCacheKey(id), encoded, 30*time.Second).Err(); err != nil {
			return models.Customer{}, false, err
		}
	} else {
		return models.Customer{}, false, err
	}
	return entity, true, nil
}

func (s *CustomerStore) List(ctx context.Context, limit, offset int64) ([]models.Customer, error) {
	rows, err := s.db.QueryContext(ctx,
		`SELECT id, name, email FROM customers ORDER BY id LIMIT $1 OFFSET $2`,
		limit, offset)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	out := []models.Customer{}
	for rows.Next() {
		var entity models.Customer
		if err := rows.Scan(&entity.ID, &entity.Name, &entity.Email); err != nil {
			return nil, err
		}
		out = append(out, entity)
	}
	return out, rows.Err()
}

func (s *CustomerStore) Update(ctx context.Context, id string, payload models.CustomerIn) (models.Customer, bool, error) {
	entity := models.Customer{
		ID:    id,
		Name:  payload.Name,
		Email: payload.Email,
	}
	res, err := s.db.ExecContext(ctx,
		`UPDATE customers SET name = $1, email = $2 WHERE id = $3`,
		entity.Name,
		entity.Email,
		id,
	)
	if err != nil {
		return models.Customer{}, false, err
	}
	n, err := res.RowsAffected()
	if err != nil {
		return models.Customer{}, false, err
	}
	if n == 0 {
		return models.Customer{}, false, nil
	}
	if encoded, err := json.Marshal(entity); err == nil {
		if err := s.cache.Set(ctx, customerstoreCacheKey(id), encoded, 30*time.Second).Err(); err != nil {
			return models.Customer{}, false, err
		}
	} else {
		return models.Customer{}, false, err
	}
	return entity, true, nil
}

func (s *CustomerStore) Delete(ctx context.Context, id string) (bool, error) {
	res, err := s.db.ExecContext(ctx,
		`DELETE FROM customers WHERE id = $1`, id)
	if err != nil {
		return false, err
	}
	n, err := res.RowsAffected()
	if err != nil {
		return false, err
	}
	if n > 0 {
		if err := s.cache.Del(ctx, customerstoreCacheKey(id)).Err(); err != nil {
			return false, err
		}
	}
	return n > 0, nil
}
