// Package queue provides broker access (nats). Generated
// by CIaC.
//
// Publish/subscribe go through a client connected lazily on first use
// for both engines. That is NATS's usual shape (`nats.Connect` dials
// synchronously), but it is a deliberate, live-verified choice for
// Kafka too: unlike Rust's rdkafka producer (whose `create()` neither
// dials nor spawns background goroutines), franz-go's `kgo.NewClient`
// starts two supervisory goroutines
// (`updateMetadataLoop`/`reapConnectionsLoop`) immediately on
// construction, confirmed with `goleak` against a real, unreachable
// broker address -- so a Kafka `Queue` needs the same connect-on-
// first-use guard NATS needs to keep `state.New` infrastructure-free
// (the M1 no-infra construction test).
package queue

import (
	"context"
	"encoding/json"
	"fmt"
	"github.com/nats-io/nats.go"
	"sync"
)

// Queue wraps a lazily-connected NATS client.
type Queue struct {
	url  string
	mu   sync.Mutex
	conn *nats.Conn
}

// New builds a Queue. Construction never touches the network -- the
// underlying client connects on first publish/subscribe.
func New(url string) *Queue {
	return &Queue{url: url}
}

func (q *Queue) client() (*nats.Conn, error) {
	q.mu.Lock()
	defer q.mu.Unlock()
	if q.conn == nil {
		nc, err := nats.Connect(q.url)
		if err != nil {
			return nil, fmt.Errorf("connecting to NATS at %s: %w", q.url, err)
		}
		q.conn = nc
	}
	return q.conn, nil
}

// Publish sends payload to subject.
func (q *Queue) Publish(subject string, payload []byte, headers map[string]string) error {
	nc, err := q.client()
	if err != nil {
		return err
	}
	if len(headers) == 0 {
		return nc.Publish(subject, payload)
	}
	msg := &nats.Msg{Subject: subject, Data: payload, Header: nats.Header{}}
	for k, v := range headers {
		msg.Header.Set(k, v)
	}
	return nc.PublishMsg(msg)
}

// QueueSubscribe delivers subject's messages onto a fresh channel,
// load-balanced across every subscriber sharing group.
func (q *Queue) QueueSubscribe(subject, group string) (chan *nats.Msg, error) {
	nc, err := q.client()
	if err != nil {
		return nil, err
	}
	ch := make(chan *nats.Msg, 64)
	if _, err := nc.ChanQueueSubscribe(subject, group, ch); err != nil {
		return nil, err
	}
	return ch, nil
}

// Subscribe delivers a copy of every message on subject onto a fresh
// channel -- NATS's own fan-out semantics are this backend's whole
// broadcast mechanism (no app-level bookkeeping needed), the same
// design Rust/TS's own NATS branches rely on.
func (q *Queue) Subscribe(subject string) (chan *nats.Msg, error) {
	nc, err := q.client()
	if err != nil {
		return nil, err
	}
	ch := make(chan *nats.Msg, 64)
	if _, err := nc.ChanSubscribe(subject, ch); err != nil {
		return nil, err
	}
	return ch, nil
}

// PublishJSON marshals v and publishes it -- the shared call site
// every generated pipeline `publish` step (and every typed handler's
// own `publish` statement) goes through, mirroring Rust's centralized
// `AppState::publish`.
func PublishJSON(ctx context.Context, q *Queue, subject string, v any) error {
	payload, err := json.Marshal(v)
	if err != nil {
		return err
	}
	_ = ctx
	return q.Publish(subject, payload, nil)
}
