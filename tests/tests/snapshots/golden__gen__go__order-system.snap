func ShippedSummaryAPIHandler(st *state.AppState) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		// ctx may go unused (a pipeline with no handler/publish/call
		// step, e.g. plain `Return`) or genuinely used below,
		// depending on this api's steps -- always declaring it keeps
