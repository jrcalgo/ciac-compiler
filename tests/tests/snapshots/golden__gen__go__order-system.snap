cmd/workers/main.go
============================================================
// cmd/workers/main.go -- Generated by CIaC.
package main

import (
	"context"
	"log"
	"os"

	"golang.org/x/sync/errgroup"

	"order-system/internal/config"
	"order-system/internal/db"
	"order-system/internal/observability"
	"order-system/internal/state"
	"order-system/internal/workers"
)

func main() {
	observability.Init()
	cfg := config.FromEnv()
	st, err := state.New(cfg)
	if err != nil {
		log.Fatalf("state.New: %v", err)
	}
	if err := db.EnsureSchemaPostgres(st.DB); err != nil {
		log.Fatalf("ensure schema (postgres): %v", err)
	}
	if err := db.Migrate(st.DB, "postgres", os.DirFS("migrations")); err != nil {
		log.Fatalf("migrate: %v", err)
	}

	ctx := context.Background()
	g, ctx := errgroup.WithContext(ctx)
	g.Go(func() error {
		workers.RunOrderEventSink(ctx, st)
		return nil
	})
	if err := g.Wait(); err != nil {
		log.Fatal(err)
	}
}
