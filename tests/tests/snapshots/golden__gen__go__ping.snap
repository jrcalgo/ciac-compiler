// internal/routes/echo_api.go — Generated by CIaC.
//
// Pipeline: Echo. M1 slice: plain request/response passthrough
// only (no handler/publish/call/match steps, no scope check yet --
// those are M3/M4/M6's own milestones; `supports()` stays narrow
// enough that no example can reach an unimplemented step shape here).
package routes

import (
	"net/http"
	"ping/internal/httpx"
	"ping/internal/schemas"
	"ping/internal/state"
)

func EchoHandler(st *state.AppState) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		_ = st
		result, err := schemas.DecodeMessage(r.Body)
		if err != nil {
			httpx.WriteError(w, httpx.BadRequest(err))
			return
		}
		httpx.Accepted(w, result)
	}
}
