// Package schemas holds record structs, decode helpers, and (from the
// milestone that first declares one) enum/error types. Generated by
// CIaC.
//
// Decode<Record> distinguishes absent, explicit null, and zero exactly
// as every other target's decoder does (Pillar 2's zero-value trap):
// Go's own `encoding/json` collapses a missing key and an explicit
// `null` into the same silent zero value for a non-pointer field, so
// requireKeys checks the raw key set for both cases before the typed
// unmarshal ever runs. Validator `validate` tags carry format
// constraints only (e.g. `uuid4`) -- never `required`: presence is
// already this file's own job, and re-asserting "required" through
// validator would reject a legitimate zero value (`""`, `0`) the wire
// contract explicitly allows.
package schemas

import (
	"encoding/json"
	"fmt"
	"io"

	"github.com/go-playground/validator/v10"
)

var validate = validator.New(validator.WithRequiredStructEnabled())

// requireKeys reports the first of required missing from raw, or
// present but explicitly null -- the two cases `encoding/json` alone
// cannot distinguish from a legitimate zero value on a non-pointer
// field.
func requireKeys(raw map[string]json.RawMessage, required ...string) error {
	for _, k := range required {
		v, ok := raw[k]
		if !ok {
			return fmt.Errorf("missing required field %q", k)
		}
		if string(v) == "null" {
			return fmt.Errorf("field %q must not be null", k)
		}
	}
	return nil
}

type Note struct {
	ID     string `json:"id" validate:"uuid4"`
	Title  string `json:"title"`
	Active bool   `json:"active"`
}

// DecodeNote decodes and validates a Note from r.
func DecodeNote(r io.Reader) (Note, error) {
	body, err := io.ReadAll(r)
	if err != nil {
		return Note{}, fmt.Errorf("malformed body: %w", err)
	}
	var raw map[string]json.RawMessage
	if err := json.Unmarshal(body, &raw); err != nil {
		return Note{}, fmt.Errorf("malformed body: %w", err)
	}
	if err := requireKeys(raw, "id", "title", "active"); err != nil {
		return Note{}, err
	}
	var out Note
	if err := json.Unmarshal(body, &out); err != nil {
		return Note{}, fmt.Errorf("malformed body: %w", err)
	}
	if err := validate.Struct(out); err != nil {
		return Note{}, err
	}
	return out, nil
}

type ActiveFilter struct {
	Active bool `json:"active"`
}

// DecodeActiveFilter decodes and validates a ActiveFilter from r.
func DecodeActiveFilter(r io.Reader) (ActiveFilter, error) {
	body, err := io.ReadAll(r)
	if err != nil {
		return ActiveFilter{}, fmt.Errorf("malformed body: %w", err)
	}
	var raw map[string]json.RawMessage
	if err := json.Unmarshal(body, &raw); err != nil {
		return ActiveFilter{}, fmt.Errorf("malformed body: %w", err)
	}
	if err := requireKeys(raw, "active"); err != nil {
		return ActiveFilter{}, err
	}
	var out ActiveFilter
	if err := json.Unmarshal(body, &out); err != nil {
