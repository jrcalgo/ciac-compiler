// Package config holds runtime configuration for ProgressFeed.
// Generated by CIaC.
//
// Every value can be overridden through the environment, e.g.
// DATABASE_URL; defaults target local development.
package config

import "os"

type Config struct {
	NatsURL string
}

func FromEnv() Config {
	return Config{
		NatsURL: envOr("NATS_URL", "nats://localhost:4222"),
	}
}

// Go does not error on an unused top-level function (unlike an unused
// import or local variable), so this stays unconditional rather than
// gated behind the same capability check every call site above
// already has -- one fewer condition to keep in sync.
func envOr(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok {
		return v
	}
	return fallback
}
