internal/routes/complete_api.go
============================================================
// internal/routes/complete_api.go -- Generated by CIaC.
//
// Pipeline: Complete.
package routes

import (
	"net/http"
	"progress-feed/internal/httpx"
	"progress-feed/internal/queue"
	"progress-feed/internal/schemas"
	"progress-feed/internal/state"
)

func CompleteHandler(st *state.AppState) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		// ctx may go unused (a pipeline with no handler/publish/call
		// step, e.g. plain `Return`) or genuinely used below,
		// depending on this api's steps -- always declaring it keeps
		// this handler's shape stable as the pipeline grows.
		ctx := r.Context()
		_ = ctx
		decoded, err := schemas.DecodeVideo(r.Body)
		if err != nil {
			httpx.WriteError(w, httpx.BadRequest(err))
			return
		}
		var result any = decoded

		if err := queue.PublishJSON(st.Queue, "progress_feed.transcoded", result); err != nil {
			httpx.WriteError(w, err)
			return
		}

		httpx.Accepted(w, result)
	}
}
