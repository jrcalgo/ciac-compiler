internal/routes/channel_progress.go
============================================================
// internal/routes/channel_progress.go -- Generated by CIaC.
// Realtime channel `Progress`.
package routes

import (
	"bytes"
	"context"
	"encoding/json"
	"github.com/gorilla/websocket"
	"net/http"
	"progress-feed/internal/schemas"
	"progress-feed/internal/state"
)

const ProgressSubject = "progress_feed.transcoded"

// payloadTextProgress validates raw as this channel's
// payload shape and re-marshals it, dropping (returning false for)
// anything malformed rather than forwarding it to connected clients --
// the same validate-then-forward discipline Rust/TS's own channel
// templates apply.
func payloadTextProgress(raw []byte) ([]byte, bool) {
	payload, err := schemas.DecodeVideo(bytes.NewReader(raw))
	if err != nil {
		return nil, false
	}
	out, err := json.Marshal(payload)
	if err != nil {
		return nil, false
	}
	return out, true
}

var progressUpgrader = websocket.Upgrader{
	ReadBufferSize:  1024,
	WriteBufferSize: 1024,
	CheckOrigin:     func(r *http.Request) bool { return true },
}

func ProgressHandler(st *state.AppState) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		conn, err := progressUpgrader.Upgrade(w, r, nil)
		if err != nil {
			return
		}
		defer conn.Close()
		streamProgress(r.Context(), st, func(data []byte) bool {
			return conn.WriteMessage(websocket.TextMessage, data) == nil
		})
	}
}

// streamProgress delivers every message on the subject
// to send, until send returns false or the subscription closes. NATS
// delivers a copy of every message to every plain subscriber -- that
// alone is the whole fan-out mechanism, no app-level broadcast
// bookkeeping needed.
func streamProgress(_ context.Context, st *state.AppState, send func([]byte) bool) {
	ch, err := st.Queue.Subscribe(ProgressSubject)
	if err != nil {
		return
	}
	for msg := range ch {
		data, ok := payloadTextProgress(msg.Data)
		if !ok {
			continue
		}
		if !send(data) {
			return
		}
	}
}
