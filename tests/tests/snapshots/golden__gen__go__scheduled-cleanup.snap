internal/workers/cleanup.go
============================================================
// internal/workers/cleanup.go -- Generated by CIaC.
// Scheduled job pipeline for `job Cleanup`.
package workers

import (
	"context"
	"log/slog"

	"github.com/robfig/cron/v3"
	"maintenance/internal/services"
	"maintenance/internal/state"
)

// CleanupSchedule is the source-level five-field cron
// expression (minute hour day month weekday), as written in the
// .ciac file -- the `robfig/cron` parser (unlike Rust's `cron` crate)
// accepts this shape directly: no leading-seconds-field or 0-7-vs-
// 1-7-weekday translation needed.
const CleanupSchedule = "0 3 * * *"

// HandleTickCleanupOnce runs the pipeline exactly once for
// the current tick -- the seam a future simulation runner
// (24UpdatePlan.md M9) drives directly on each cron-due instant an
// `advance` step covers, mirroring `handle_tick_once` in the Python/
// Rust backends.
func HandleTickCleanupOnce(ctx context.Context, st *state.AppState) error {
	var result any = map[string]any{}

	if v, err := services.NewPruneExpired(st).Handle(ctx, result); err != nil {
		return err
	} else {
		result = v
	}
	_ = result
	return nil
}

// RunCleanup registers Cleanup with a cron scheduler and
// starts it; call Stop on the returned scheduler to stop it.
func RunCleanup(ctx context.Context, st *state.AppState) *cron.Cron {
	c := cron.New()
	_, err := c.AddFunc(CleanupSchedule, func() {
		if err := HandleTickCleanupOnce(ctx, st); err != nil {
			slog.Error("scheduled job Cleanup failed", "error", err)
		}
	})
	if err != nil {
		slog.Error("job Cleanup: invalid schedule", "error", err, "schedule", CleanupSchedule)
		return c
	}
	c.Start()
	return c
}
