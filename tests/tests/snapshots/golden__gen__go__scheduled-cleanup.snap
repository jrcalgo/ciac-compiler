// cmd/sim_runner/main.go — Generated by CIaC (v0.24 M9).
//
// Minimal scenario-driving simulation runner. Interprets the same
// closed request/publish/advance/drain/expect scenario vocabulary
// ciac-sim's Scenario JSON schema defines, against this service's own
// generated routes.Router (through net/http/httptest, no live
// listener) and its worker HandleMessageOnce.../job HandleTickOnce...
// entry points -- line-for-line the same architecture as
// sim_runner.rs.j2/sim_runner.ts.j2, generated (not a shared library)
// because this needs concrete per-program types, exactly like the
// Rust/TypeScript backends' own generated runners. Included in `go
// build ./...`/`go vet ./...`/`go test ./...` automatically (a second
// `main` package under its own directory, the same way Cargo
// auto-discovers `src/bin/sim_runner.rs`), so no `TargetInfo.validate`
// change was needed to pick it up.
//
// Deliberately narrow, matching world.go's own disclosed scope:
// single-service only; `publish` steps (publishing directly to a
// stream, bypassing an API) are not wired; expect.quiescence and
// drain see one global undelivered-message buffer, not independent
// per-(subject, group) cursors. Any scenario step this runner cannot
// honor is a hard error, never a silently-skipped no-op. Structural
// scenario parsing only (simulation_version/non-empty steps) -- this
// is a hand-written restatement of ciac_sim::scenario::Scenario, not
// that vendored Rust source, the same position Python's/TypeScript's
// own hand-written scenario drivers occupy.
package main

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"regexp"
	"sort"
	"strconv"
	"strings"
	"time"

	"github.com/robfig/cron/v3"

	"maintenance/internal/config"
	"maintenance/internal/state"
	"maintenance/internal/workers"
	"maintenance/internal/world"
)

const serviceName = "Maintenance"

// -- Scenario JSON shape (structural restatement of ciac_sim::scenario) --

type principal struct {
	Sub    string   `json:"sub"`
	Scopes []string `json:"scopes,omitempty"`
}

type requestStep struct {
	Service string          `json:"service"`
	Api     string          `json:"api"`
	JSON    json.RawMessage `json:"json,omitempty"`
	As      *principal      `json:"as,omitempty"`
	SaveAs  string          `json:"save_as,omitempty"`
}

type publishStep struct {
	Stream string          `json:"stream"`
	JSON   json.RawMessage `json:"json,omitempty"`
}

type advanceStep struct {
	By string `json:"by"`
}

type responseExpect struct {
	Of     string          `json:"of"`
	Status *int            `json:"status,omitempty"`
	JSON   json.RawMessage `json:"json,omitempty"`
}

type rowExpect struct {
	Service string         `json:"service"`
	Table   string         `json:"table"`
	Where   map[string]any `json:"where"`
	Present bool           `json:"present"`
}

type workerAttemptsExpect struct {
	Worker string `json:"worker"`
	Count  int    `json:"count"`
}

type jobRunsExpect struct {
	Job   string `json:"job"`
	Count int    `json:"count"`
}

type expectStep struct {
	Response       *responseExpect       `json:"response,omitempty"`
	Row            *rowExpect            `json:"row,omitempty"`
	WorkerAttempts *workerAttemptsExpect `json:"worker_attempts,omitempty"`
	JobRuns        *jobRunsExpect        `json:"job_runs,omitempty"`
	Quiescence     *struct{}             `json:"quiescence,omitempty"`
}

type scenarioStep struct {
	Request *requestStep `json:"request,omitempty"`
	Publish *publishStep `json:"publish,omitempty"`
	Advance *advanceStep `json:"advance,omitempty"`
	Drain   *struct{}    `json:"drain,omitempty"`
	Expect  *expectStep  `json:"expect,omitempty"`
}

type givenTableRows struct {
	Service string            `json:"service"`
	Table   string            `json:"table"`
	Rows    []json.RawMessage `json:"rows"`
}

type failureSelector struct {
	Effect     string  `json:"effect"`
	Subject    *string `json:"subject"`
	Occurrence int     `json:"occurrence"`
	Phase      string  `json:"phase"`
}

type failureAction struct {
	Kind string `json:"kind"`
}

type rawFailureRule struct {
	At     failureSelector `json:"at"`
	Action failureAction   `json:"action"`
}

type given struct {
	DB       []givenTableRows `json:"db,omitempty"`
	Failures []rawFailureRule `json:"failures,omitempty"`
}

type scenario struct {
	SimulationVersion int            `json:"simulation_version"`
	Name              string         `json:"name"`
	StartAt           string         `json:"start_at"`
	Given             given          `json:"given"`
	Steps             []scenarioStep `json:"steps"`
}

type simScenarioOutcome struct {
	Scenario       string         `json:"scenario"`
	Passed         bool           `json:"passed"`
	Error          *string        `json:"error"`
	WorkerAttempts map[string]int `json:"worker_attempts"`
	JobRuns        map[string]int `json:"job_runs"`
}

type savedResponse struct {
	Status int
	JSON   any
}

// toFailureRules: only the `error` action / `after` phase is
// implemented -- the same disclosed subset of the full failure
// vocabulary Rust's own SimWorld::should_fail supports, for the same
// reason (it's the one action this checkpoint's scenarios need).
// Refused up front rather than silently ignored if a scenario asks for
// anything else.
func toFailureRules(raw []rawFailureRule) ([]world.FailureRule, error) {
	out := make([]world.FailureRule, 0, len(raw))
	for _, r := range raw {
		if r.Action.Kind != "error" {
			return nil, fmt.Errorf(
				"failure rule for effect %q uses action %q, which this Go world's FailureEngine "+
					"integration does not support yet (only `error` is implemented)",
				r.At.Effect, r.Action.Kind,
			)
		}
		if r.At.Phase != "after" {
			return nil, fmt.Errorf(
				"failure rule for effect %q uses phase %q, which this Go world's FailureEngine "+
					"integration does not support yet (only `after` is implemented)",
				r.At.Effect, r.At.Phase,
			)
		}
		subject := ""
		if r.At.Subject != nil {
			subject = *r.At.Subject
		}
		out = append(out, world.FailureRule{Effect: r.At.Effect, Subject: subject, Occurrence: r.At.Occurrence})
	}
	return out, nil
}

var durationRe = regexp.MustCompile(`^(\d+)(ms|s|m|h|d)$`)

// parseDurationMs parses `advance.by` strings ("24h", "7d", "30m", ...)
// -- matches sim/pyrunner/cron.py's parse_duration_ms and
// sim_runner.rs.j2/sim_runner.ts.j2's own parseDurationMs exactly.
func parseDurationMs(text string) (int64, error) {
	m := durationRe.FindStringSubmatch(text)
	if m == nil {
		return 0, fmt.Errorf("unrecognized duration: %q", text)
	}
	value, err := strconv.ParseInt(m[1], 10, 64)
	if err != nil {
		return 0, err
	}
	unitMs := map[string]int64{"ms": 1, "s": 1_000, "m": 60_000, "h": 3_600_000, "d": 86_400_000}
	return value * unitMs[m[2]], nil
}

// dueInstants returns every cron-due instant in (fromMs, toMs] for
// schedule -- robfig/cron's standard parser accepts the same 5-field
// source expression the real job scheduler uses (job.go.j2's own doc:
// no seconds-field/weekday translation needed, unlike Rust's `cron`
// crate).
func dueInstants(schedule string, fromMs, toMs int64) ([]int64, error) {
	sched, err := cron.ParseStandard(schedule)
	if err != nil {
		return nil, err
	}
	var out []int64
	cursor := time.UnixMilli(fromMs).UTC()
	for i := 0; i < 100_000; i++ {
		next := sched.Next(cursor)
		nextMs := next.UnixMilli()
		if nextMs > toMs {
			break
		}
		out = append(out, nextMs)
		cursor = next
	}
	return out, nil
}

// canonicalJSON is a canonical (key-sorted) JSON string, so
// expect.response.json compares by value, not by the saved response's
// own key order.
func canonicalJSON(v any) string {
	switch val := v.(type) {
	case map[string]any:
		keys := make([]string, 0, len(val))
		for k := range val {
			keys = append(keys, k)
		}
		sort.Strings(keys)
		parts := make([]string, len(keys))
		for i, k := range keys {
			kb, _ := json.Marshal(k)
			parts[i] = string(kb) + ":" + canonicalJSON(val[k])
		}
		return "{" + strings.Join(parts, ",") + "}"
	case []any:
		parts := make([]string, len(val))
		for i, e := range val {
			parts[i] = canonicalJSON(e)
		}
		return "[" + strings.Join(parts, ",") + "]"
	default:
		b, _ := json.Marshal(val)
		return string(b)
	}
}

// drain hands every message currently undelivered to its worker's
// HandleMessageOnce exactly once (with that worker's own retry
// budget) -- messages a handler publishes as a side effect of
// processing are left for the *next* drain step. Dispatches by
// switch on the subject string (see world.go's own doc for why this
// runner has no independent per-(subject, group) cursors): the
// *first* worker registered for a subject receives every drained
// message, any others sharing that subject receive none.
func drain(st *state.AppState, w *world.World, workerAttempts map[string]int) error {
	for _, msg := range w.DrainQueue() {
		delivered := false
		if !delivered {
			return fmt.Errorf("sim_runner: no worker registered to consume subject %q (disclosed scope)", msg.Subject)
		}
	}
	return nil
}

func advance(st *state.AppState, fromMs, toMs int64, jobRuns map[string]int) error {
	cleanupDue, err := dueInstants(workers.CleanupSchedule, fromMs, toMs)
	if err != nil {
		return err
	}
	for range cleanupDue {
		if err := workers.HandleTickCleanupOnce(context.Background(), st); err != nil {
			return fmt.Errorf("sim_runner: job Cleanup failed: %w", err)
		}
		jobRuns["Cleanup"]++
	}
	return nil
}

func expect(spec expectStep, w *world.World, saved map[string]savedResponse, workerAttempts, jobRuns map[string]int) error {
	switch {
	case spec.Response != nil:
		got, ok := saved[spec.Response.Of]
		if !ok {
			return fmt.Errorf("expect.response.of references unknown save_as %q", spec.Response.Of)
		}
		if spec.Response.Status != nil && got.Status != *spec.Response.Status {
			return fmt.Errorf(
				"expect.response.of=%q: expected status %d, got %d",
				spec.Response.Of, *spec.Response.Status, got.Status,
			)
		}
		if len(spec.Response.JSON) > 0 {
			var want any
			if err := json.Unmarshal(spec.Response.JSON, &want); err != nil {
				return err
			}
			if canonicalJSON(got.JSON) != canonicalJSON(want) {
				return fmt.Errorf(
					"expect.response.of=%q: expected json %s, got %s",
					spec.Response.Of, canonicalJSON(want), canonicalJSON(got.JSON),
				)
			}
		}
	case spec.Row != nil:
		if spec.Row.Service != serviceName {
			return fmt.Errorf(
				"sim_runner only drives service %q (single-service only); expect.row named %q",
				serviceName, spec.Row.Service,
			)
		}
		found := len(w.FindWhere(spec.Row.Table, spec.Row.Where)) > 0
		if found != spec.Row.Present {
			return fmt.Errorf(
				"expect.row: table=%q where=%v present=%v, found=%v",
				spec.Row.Table, spec.Row.Where, spec.Row.Present, found,
			)
		}
	case spec.WorkerAttempts != nil:
		actual := workerAttempts[spec.WorkerAttempts.Worker]
		if actual != spec.WorkerAttempts.Count {
			return fmt.Errorf(
				"expect.worker_attempts: worker=%q expected %d, got %d",
				spec.WorkerAttempts.Worker, spec.WorkerAttempts.Count, actual,
			)
		}
	case spec.JobRuns != nil:
		actual := jobRuns[spec.JobRuns.Job]
		if actual != spec.JobRuns.Count {
			return fmt.Errorf(
				"expect.job_runs: job=%q expected %d, got %d",
				spec.JobRuns.Job, spec.JobRuns.Count, actual,
			)
		}
	case spec.Quiescence != nil:
		if !w.QueueIsEmpty() {
			return errors.New("expect.quiescence: undelivered message(s) remain in the simulated broker")
		}
	default:
		return errors.New("sim_runner: unrecognized expect step")
	}
	return nil
}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: sim_runner <scenario.json>")
		os.Exit(1)
	}
	raw, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	var sc scenario
	if err := json.Unmarshal(raw, &sc); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	if sc.SimulationVersion != 1 {
		fmt.Fprintf(os.Stderr, "scenario simulation_version %d is not supported (expected 1)\n", sc.SimulationVersion)
		os.Exit(1)
	}
	if len(sc.Steps) == 0 {
		fmt.Fprintln(os.Stderr, "scenario has no steps")
		os.Exit(1)
	}

	failureRules, err := toFailureRules(sc.Given.Failures)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	w := world.New(failureRules)
	for _, seed := range sc.Given.DB {
		if seed.Service != serviceName {
			fmt.Fprintf(
				os.Stderr,
				"sim_runner only drives service %q (single-service only); given.db named %q\n",
				serviceName, seed.Service,
			)
			os.Exit(1)
		}
		for _, row := range seed.Rows {
			w.SeedDB(seed.Table, row)
		}
	}

	startAt, err := time.Parse(time.RFC3339, sc.StartAt)
	if err != nil {
		fmt.Fprintf(os.Stderr, "scenario start_at %q: not a valid date\n", sc.StartAt)
		os.Exit(1)
	}
	nowMs := startAt.UnixMilli()

	cfg := config.FromEnv()
	st := state.NewSimulation(cfg, w)

	saved := map[string]savedResponse{}
	workerAttempts := map[string]int{}
	jobRuns := map[string]int{}

	var runErr error
	for _, step := range sc.Steps {
		switch {
		case step.Request != nil:
			runErr = fmt.Errorf(
				"sim_runner: no api registered named %q (this service declares no `api` pipelines)",
				step.Request.Api,
			)
		case step.Publish != nil:
			runErr = errors.New("sim_runner does not support `publish` steps (disclosed scope)")
		case step.Advance != nil:
			deltaMs, derr := parseDurationMs(step.Advance.By)
			if derr != nil {
				runErr = derr
			} else {
				toMs := nowMs + deltaMs
				runErr = advance(st, nowMs, toMs, jobRuns)
				nowMs = toMs
			}
		case step.Drain != nil:
			runErr = drain(st, w, workerAttempts)
		case step.Expect != nil:
			runErr = expect(*step.Expect, w, saved, workerAttempts, jobRuns)
		default:
			runErr = errors.New("sim_runner: unrecognized step")
		}
		if runErr != nil {
			break
		}
	}
	if runErr == nil {
		unmatched := w.UnmatchedFailureRules()
		if len(unmatched) > 0 {
			runErr = fmt.Errorf(
				"%d failure rule(s) declared in `given.failures` never matched a real occurrence: %v",
				len(unmatched), unmatched,
			)
		}
	}

	outcome := simScenarioOutcome{
		Scenario:       sc.Name,
		Passed:         runErr == nil,
		WorkerAttempts: workerAttempts,
		JobRuns:        jobRuns,
	}
	if runErr != nil {
		msg := runErr.Error()
		outcome.Error = &msg
	}
	out, err := json.Marshal(outcome)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	fmt.Println(string(out))
}
