internal/world/world.go
============================================================
// Package world -- Generated by CIaC (sim builds only).
//
// A narrow Go restatement of ciac-sim's SimWorld
// (crates/ciac-sim/src/world.rs): Go cannot vendor the Rust crate's
// source the way the Rust backend does via include_str!, so this
// occupies the same position Python's sim/pyrunner/world.py and
// TypeScript's world.ts already do (v0.17 M11 / v0.23 M9), with the
// same disclosure -- only db.insert and broker publish are faked (the
// same disclosed, narrow scope unsupportedSimCapabilities gates on
// before `ciac sim --target go` ever reaches this code): get/update/
// delete/query/count, cache, object_store, email, search,
// external_http, and auth all fall straight through to real
// infrastructure, which is exactly why programs using them are refused
// before this package is ever built into a sim binary. Generated only
// for programs with a `db` or `queue` instance, mirroring the Rust/TS
// backends' own emission gate.
package world

import (
	"encoding/json"
	"errors"
	"fmt"
	"reflect"
	"sort"
	"sync"
)

// FailureRule is the `error`-action-only, occurrence-counted subset of
// ciac_sim::failure's full vocabulary this restatement implements --
// the same disclosed scope Rust's/TS's own restatements hold to (this
// checkpoint's scenarios need nothing more).
type FailureRule struct {
	Effect     string
	Subject    string // "" stands for an absent/nil subject.
	Occurrence int
}

// failureEngine tracks occurrence-counted (effect, subject) failure
// rules against a live run's real occurrences -- mirroring
// ciac_sim::failure::FailureEngine's record_occurrence, narrowed the
// same way TS's own restatement narrows it (occurrence always
// required, first-match-only via a set rather than an ordered rule
// list, since this checkpoint's scenarios need nothing more general).
type failureEngine struct {
	mu      sync.Mutex
	rules   map[string]struct{}
	matched map[string]struct{}
	counts  map[string]int
}

func newFailureEngine(rules []FailureRule) *failureEngine {
	fe := &failureEngine{
		rules:   make(map[string]struct{}, len(rules)),
		matched: make(map[string]struct{}, len(rules)),
		counts:  make(map[string]int),
	}
	for _, r := range rules {
		fe.rules[ruleKey(r.Effect, r.Subject, r.Occurrence)] = struct{}{}
	}
	return fe
}

func countKey(effect, subject string) string {
	return effect + " " + subject
}

func ruleKey(effect, subject string, occurrence int) string {
	return fmt.Sprintf("%s %d", countKey(effect, subject), occurrence)
}

func (fe *failureEngine) shouldFail(effect, subject string) bool {
	fe.mu.Lock()
	defer fe.mu.Unlock()
	ck := countKey(effect, subject)
	fe.counts[ck]++
	key := ruleKey(effect, subject, fe.counts[ck])
	if _, ok := fe.rules[key]; ok {
		fe.matched[key] = struct{}{}
		return true
	}
	return false
}

// unmatchedRules returns the failure rules a scenario declared that
// never matched a real occurrence -- surfaced to the runner rather
// than silently ignored, matching SIM0007's disclosure discipline.
func (fe *failureEngine) unmatchedRules() []string {
	fe.mu.Lock()
	defer fe.mu.Unlock()
	out := make([]string, 0, len(fe.rules)-len(fe.matched))
	for k := range fe.rules {
		if _, ok := fe.matched[k]; !ok {
			out = append(out, k)
		}
	}
	sort.Strings(out)
	return out
}

// QueuedMessage is one publish, in arrival order.
type QueuedMessage struct {
	Subject string
	Payload []byte
}

// World is the simulation adapter state.AppState's World field holds
// (v0.24 M9) -- one instance per running scenario. state.go.j2's
// AppState.World field and queue.go.j2's PublishJSON are the only two
// places generated code reaches into this; every other db verb falls
// straight through to real infrastructure. No constraints, no
// cascades, no indexes, and no independent per-(subject, group)
// cursors (every registered worker/job in this milestone's vertical
// slice has exactly one consumer) -- see the package doc for what
// Python's fuller fake already covers that this one does not.
type World struct {
	mu       sync.Mutex
	tables   map[string][]json.RawMessage
	queue    []QueuedMessage
	failures *failureEngine
}

// New builds a World seeded with failureRules.
func New(failureRules []FailureRule) *World {
	return &World{
		tables:   make(map[string][]json.RawMessage),
		failures: newFailureEngine(failureRules),
	}
}

// DBInsertChecked is db.commit's failure check plus the actual (fake)
// write, mirroring SimWorld::db_insert_checked/dbInsertChecked: a
// matched rule errors before the row is stored, same as a real
// transaction rolling back. row is marshaled internally (the same
// accept-any-marshal-inside choice object_store.Put makes) rather than
// requiring every call site to build its own json.Marshal closure.
func (w *World) DBInsertChecked(table string, row any) error {
	if w.failures.shouldFail("db.commit", table) {
		return errors.New("simulated db.commit failure (injected by FailureEngine)")
	}
	raw, err := json.Marshal(row)
	if err != nil {
		return fmt.Errorf("world: marshaling %s row for the simulated database: %w", table, err)
	}
	w.mu.Lock()
	w.tables[table] = append(w.tables[table], raw)
	w.mu.Unlock()
	return nil
}

// SeedDB inserts row into table with no failure check -- a scenario's
// `given.db` seeding, not a simulated db.insert call.
func (w *World) SeedDB(table string, row json.RawMessage) {
	w.mu.Lock()
	w.tables[table] = append(w.tables[table], row)
	w.mu.Unlock()
}

// FindWhere returns table's rows matching every key/value pair in
// filter (an empty filter matches every row) -- sim_runner's own
// expect.row check, not something generated handler code calls.
func (w *World) FindWhere(table string, filter map[string]any) []map[string]any {
	w.mu.Lock()
	rows := append([]json.RawMessage(nil), w.tables[table]...)
	w.mu.Unlock()
	out := make([]map[string]any, 0, len(rows))
	for _, raw := range rows {
		var row map[string]any
		if err := json.Unmarshal(raw, &row); err != nil {
			continue
		}
		matches := true
		for k, v := range filter {
			if rv, ok := row[k]; !ok || !reflect.DeepEqual(rv, v) {
				matches = false
				break
			}
		}
		if matches {
			out = append(out, row)
		}
	}
	return out
}

// PublishChecked is broker.publish's failure check plus the actual
// (fake) publish.
func (w *World) PublishChecked(subject string, payload []byte) error {
	if w.failures.shouldFail("broker.publish", subject) {
		return errors.New("simulated broker.publish failure (injected by FailureEngine)")
	}
	w.mu.Lock()
	w.queue = append(w.queue, QueuedMessage{Subject: subject, Payload: payload})
	w.mu.Unlock()
	return nil
}

// DrainQueue returns every message published since the last drain,
// removing them -- sim_runner's own `drain` step calls this once per
// subject it knows how to deliver.
func (w *World) DrainQueue() []QueuedMessage {
	w.mu.Lock()
	defer w.mu.Unlock()
	out := w.queue
	w.queue = nil
	return out
}

// QueueIsEmpty is a non-destructive peek -- expect.quiescence needs to
// observe whether anything is still undelivered without consuming it.
func (w *World) QueueIsEmpty() bool {
	w.mu.Lock()
	defer w.mu.Unlock()
	return len(w.queue) == 0
}

// UnmatchedFailureRules returns the failure rules a scenario declared
// that never matched a real occurrence.
func (w *World) UnmatchedFailureRules() []string {
	return w.failures.unmatchedRules()
}
