// cmd/workers/main.go -- Generated by CIaC.
package main

import (
	"context"
	"log"

	"golang.org/x/sync/errgroup"

	"maintenance/internal/config"
	"maintenance/internal/observability"
	"maintenance/internal/state"
	"maintenance/internal/workers"
)

func main() {
	observability.Init()
	cfg := config.FromEnv()
	st, err := state.New(cfg)
	if err != nil {
		log.Fatalf("state.New: %v", err)
	}

	ctx := context.Background()
	g, ctx := errgroup.WithContext(ctx)
	cleanupCron := workers.RunCleanup(ctx, st)
	defer cleanupCron.Stop()
	if err := g.Wait(); err != nil {
		log.Fatal(err)
	}
	// Every worker/consumer goroutine above runs forever, so g.Wait()
	// above already blocks for good on any program that has one --
	// this only matters for a jobs-only program (e.g.
	// scheduled-cleanup.ciac), where g.Wait() returns immediately
	// (nothing was added to the group) and the process would
	// otherwise exit right after starting the cron scheduler.
	select {}
}
