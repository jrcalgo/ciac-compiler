// internal/services/prune_expired.go -- Generated by CIaC.
// Business logic for the `PruneExpired` pipeline step.
//
// This file is yours: the compiler wires PruneExpired into
// its pipelines, and you implement the business logic in Handle.
// Regeneration never overwrites your edits here (a seeded file, like
// every other target's own handler stub).
package services

import (
	"context"
	"database/sql"

	"maintenance/internal/state"
)

// PruneExpired handles the `PruneExpired` pipeline step.
//
// Capability bindings:
// - db: default
type PruneExpired struct {
	db *sql.DB
}

func NewPruneExpired(st *state.AppState) *PruneExpired {
	return &PruneExpired{
		db: st.DB,
	}
}

func (s *PruneExpired) Handle(ctx context.Context, payload any) (any, error) {
	// TODO: implement PruneExpired.
	return payload, nil
}
