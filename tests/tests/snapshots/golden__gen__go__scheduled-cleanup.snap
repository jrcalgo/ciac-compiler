Dockerfile
============================================================
FROM golang:1.24 AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/workers ./cmd/workers

FROM gcr.io/distroless/static-debian12

COPY --from=build /out/api /app/api
COPY --from=build /out/workers /app/workers

WORKDIR /
EXPOSE 8000
ENTRYPOINT ["/app/api"]
