internal/httpclients/http_clients.go
============================================================
// Package httpclients wraps outbound calls to third-party HTTP APIs.
// Generated by CIaC.
//
// Each `external_http` instance gets a client bound to its configured
// base URL, so handlers call third-party APIs through a single
// managed client per upstream. Dependency-free (`net/http`), matching
// the M5-era typed call clients' own choice of no HTTP client
// dependency.
package httpclients

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"strings"
)

// ExternalHttp is one upstream HTTP API, addressed relative to its
// base URL.
//
// Holds configuration only; the underlying `*http.Client` is built
// per call, so `state.New` never opens a connection.
type ExternalHttp struct {
	BaseURL string
}

// Post sends a JSON-encoded body to path (relative to BaseURL) and
// returns the decoded response body.
func (h *ExternalHttp) Post(ctx context.Context, path string, body any) (json.RawMessage, error) {
	encoded, err := json.Marshal(body)
	if err != nil {
		return nil, err
	}
	url := strings.TrimRight(h.BaseURL, "/") + "/" + strings.TrimLeft(path, "/")
	req, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(encoded))
	if err != nil {
		return nil, err
	}
	req.Header.Set("Content-Type", "application/json")
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()
	out, err := io.ReadAll(resp.Body)
	if err != nil {
		return nil, err
	}
	if resp.StatusCode >= 300 {
		return nil, fmt.Errorf("POST %s: status %d: %s", url, resp.StatusCode, out)
	}
	return out, nil
}
