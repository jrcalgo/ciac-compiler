internal/objectstore/objectstore.go
============================================================
// Package objectstore is an S3-compatible object storage client.
// Generated by CIaC.
//
// Each named `object_store` instance gets one on AppState. Defaults
// target a local MinIO from the generated docker-compose (path-style
// addressing, so MinIO works with no extra configuration); point the
// `S3_*` environment variables at real S3 in production.
package objectstore

import (
	"bytes"
	"context"
	"encoding/json"
	"io"

	"github.com/aws/aws-sdk-go-v2/aws"
	"github.com/aws/aws-sdk-go-v2/credentials"
	"github.com/aws/aws-sdk-go-v2/service/s3"
)

// ObjectStore is one S3 bucket.
//
// Holds configuration only; the client is built per call, so
// `state.New` never opens a connection (the same lazy discipline
// every other provider client on AppState already follows).
type ObjectStore struct {
	Endpoint  string
	AccessKey string
	SecretKey string
	Bucket    string
	Region    string
}

func (o *ObjectStore) client() *s3.Client {
	cfg := aws.Config{
		Region:      o.Region,
		Credentials: credentials.NewStaticCredentialsProvider(o.AccessKey, o.SecretKey, ""),
	}
	return s3.NewFromConfig(cfg, func(opts *s3.Options) {
		opts.BaseEndpoint = aws.String(o.Endpoint)
		opts.UsePathStyle = true
	})
}

// Put JSON-encodes value and stores it under key.
func (o *ObjectStore) Put(ctx context.Context, key string, value any) (struct{}, error) {
	body, err := json.Marshal(value)
	if err != nil {
		return struct{}{}, err
	}
	_, err = o.client().PutObject(ctx, &s3.PutObjectInput{
		Bucket: aws.String(o.Bucket),
		Key:    aws.String(key),
		Body:   bytes.NewReader(body),
	})
	return struct{}{}, err
}

// Get returns key's raw stored bytes.
func (o *ObjectStore) Get(ctx context.Context, key string) ([]byte, error) {
	out, err := o.client().GetObject(ctx, &s3.GetObjectInput{
		Bucket: aws.String(o.Bucket),
		Key:    aws.String(key),
	})
	if err != nil {
		return nil, err
	}
	defer out.Body.Close()
	return io.ReadAll(out.Body)
}

func (o *ObjectStore) Delete(ctx context.Context, key string) (struct{}, error) {
	_, err := o.client().DeleteObject(ctx, &s3.DeleteObjectInput{
		Bucket: aws.String(o.Bucket),
		Key:    aws.String(key),
	})
	return struct{}{}, err
}

// List returns every key under prefix.
func (o *ObjectStore) List(ctx context.Context, prefix string) ([]string, error) {
	out, err := o.client().ListObjectsV2(ctx, &s3.ListObjectsV2Input{
		Bucket: aws.String(o.Bucket),
		Prefix: aws.String(prefix),
	})
	if err != nil {
		return nil, err
	}
	keys := make([]string, 0, len(out.Contents))
	for _, obj := range out.Contents {
		keys = append(keys, aws.ToString(obj.Key))
	}
	return keys, nil
}
