	}
	if err := validate.Struct(out); err != nil {
		return SearchRequest{}, err
	}
	return out, nil
}

type HttpRequest struct {
	Path    string `json:"path"`
	Payload string `json:"payload"`
}

// DecodeHttpRequest decodes and validates a HttpRequest from r.
func DecodeHttpRequest(r io.Reader) (HttpRequest, error) {
	body, err := io.ReadAll(r)
	if err != nil {
		return HttpRequest{}, fmt.Errorf("malformed body: %w", err)
	}
	var raw map[string]json.RawMessage
	if err := json.Unmarshal(body, &raw); err != nil {
		return HttpRequest{}, fmt.Errorf("malformed body: %w", err)
	}
	if err := requireKeys(raw, "path", "payload"); err != nil {
		return HttpRequest{}, err
	}
	var out HttpRequest
	if err := json.Unmarshal(body, &out); err != nil {
		return HttpRequest{}, fmt.Errorf("malformed body: %w", err)
	}
	if err := validate.Struct(out); err != nil {
		return HttpRequest{}, err
	}
	return out, nil
}

type Ack struct {
	Ok bool `json:"ok"`
}

// DecodeAck decodes and validates a Ack from r.
func DecodeAck(r io.Reader) (Ack, error) {
	body, err := io.ReadAll(r)
	if err != nil {
		return Ack{}, fmt.Errorf("malformed body: %w", err)
	}
	var raw map[string]json.RawMessage
	if err := json.Unmarshal(body, &raw); err != nil {
		return Ack{}, fmt.Errorf("malformed body: %w", err)
	}
	if err := requireKeys(raw, "ok"); err != nil {
		return Ack{}, err
	}
	var out Ack
	if err := json.Unmarshal(body, &out); err != nil {
		return Ack{}, fmt.Errorf("malformed body: %w", err)
	}
	if err := validate.Struct(out); err != nil {
		return Ack{}, err
	}
	return out, nil
}
