// Package search is an OpenSearch client. Generated by CIaC.
//
// Each named `search` instance gets one on AppState. Defaults target
// the single-node OpenSearch container from the generated
// docker-compose. Dependency-free (`net/http` against OpenSearch's
// own REST API), matching `http_clients.go.j2`'s own choice — no
// official `opensearch-go` client is needed for three verbs.
package search

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
)

// Search is bound to one OpenSearch endpoint.
//
// Holds configuration only; the underlying `*http.Client` is built
// per call, so `state.New` never opens a connection.
type Search struct {
	URL string
}

func (s *Search) do(ctx context.Context, method, path string, body any) ([]byte, error) {
	var reader io.Reader
	if body != nil {
		encoded, err := json.Marshal(body)
		if err != nil {
			return nil, err
		}
		reader = bytes.NewReader(encoded)
	}
	req, err := http.NewRequestWithContext(ctx, method, s.URL+path, reader)
	if err != nil {
		return nil, err
	}
	req.Header.Set("Content-Type", "application/json")
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()
	out, err := io.ReadAll(resp.Body)
	if err != nil {
		return nil, err
	}
	if resp.StatusCode >= 300 {
		return nil, fmt.Errorf("opensearch %s %s: status %d: %s", method, path, resp.StatusCode, out)
	}
	return out, nil
}

// Index upserts document under index/docID.
func (s *Search) Index(ctx context.Context, index, docID string, document any) (struct{}, error) {
	_, err := s.do(ctx, http.MethodPut, fmt.Sprintf("/%s/_doc/%s", index, docID), document)
	return struct{}{}, err
}

// Search runs a `query_string` search over index and returns each
// hit's `_source`.
func (s *Search) Search(ctx context.Context, index, query string) ([]json.RawMessage, error) {
	body := map[string]any{
		"query": map[string]any{
			"query_string": map[string]any{"query": query},
		},
	}
	raw, err := s.do(ctx, http.MethodPost, fmt.Sprintf("/%s/_search", index), body)
	if err != nil {
		return nil, err
	}
	var parsed struct {
		Hits struct {
			Hits []struct {
				Source json.RawMessage `json:"_source"`
			} `json:"hits"`
		} `json:"hits"`
	}
	if err := json.Unmarshal(raw, &parsed); err != nil {
		return nil, err
	}
	hits := make([]json.RawMessage, 0, len(parsed.Hits.Hits))
	for _, hit := range parsed.Hits.Hits {
		hits = append(hits, hit.Source)
	}
	return hits, nil
}

func (s *Search) Delete(ctx context.Context, index, docID string) (struct{}, error) {
	_, err := s.do(ctx, http.MethodDelete, fmt.Sprintf("/%s/_doc/%s", index, docID), nil)
	return struct{}{}, err
}
