// Package routes wires every generated api handler onto a
// net/http.ServeMux (Go 1.22+ method+pattern matching -- the M1
// routing decision recorded in lib.rs's own doc comment: every route
// shape this compiler emits is covered without a third-party router).
// Generated by CIaC.
package routes

import (
	"net/http"

	"sim-peripherals/internal/httpx"
	"sim-peripherals/internal/state"
)

// Router builds the full ServeMux: one route per declared api, one
// REST route group per CRUD resource, plus the standard /health route
// every target exposes.
func Router(st *state.AppState) *http.ServeMux {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /health", healthHandler)
	mux.Handle("POST /evict-cache-api", EvictCacheAPIHandler(st))
	mux.Handle("POST /remove-doc-api", RemoveDocAPIHandler(st))
	mux.Handle("POST /notify-user-api", NotifyUserAPIHandler(st))
	mux.Handle("POST /index-doc-api", IndexDocAPIHandler(st))
	mux.Handle("POST /search-docs-api", SearchDocsAPIHandler(st))
	mux.Handle("POST /call-upstream-api", CallUpstreamAPIHandler(st))
	mux.Handle("POST /echo-api", EchoAPIHandler(st))
	return mux
}

func healthHandler(w http.ResponseWriter, r *http.Request) {
	httpx.WriteJSON(w, http.StatusOK, map[string]string{"status": "ok"})
}
