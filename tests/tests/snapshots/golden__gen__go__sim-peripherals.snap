internal/email/email.go
============================================================
// Package email is an SMTP sender. Generated by CIaC.
//
// Both `SMTP` and `SES` providers send over SMTP; for SES, point the
// `SMTP_*` variables at your SES SMTP endpoint and credentials.
// Defaults target the Mailpit container from the generated
// docker-compose, so sent mail is inspectable at
// http://localhost:8025. Dependency-free (`net/smtp`), matching
// `http_clients.go.j2`'s own "no extra client library needed" choice.
package email

import (
	"context"
	"fmt"
	"net/smtp"
)

// Email is bound to one SMTP endpoint.
//
// Holds configuration only; the connection is made per send, so
// `state.New` never opens a connection.
type Email struct {
	Host     string
	Port     string
	Username string
	Password string
	Sender   string
	UseTLS   string
}

// Send delivers a plain-text message. `ctx` is accepted for call-site
// consistency with every other provider client's own leaf
// (`net/smtp` has no context-aware send), unused otherwise.
func (e *Email) Send(ctx context.Context, to, subject, body string) (struct{}, error) {
	_ = ctx
	var auth smtp.Auth
	if e.Username != "" {
		auth = smtp.PlainAuth("", e.Username, e.Password, e.Host)
	}
	msg := fmt.Sprintf("From: %s\r\nTo: %s\r\nSubject: %s\r\n\r\n%s\r\n", e.Sender, to, subject, body)
	addr := fmt.Sprintf("%s:%s", e.Host, e.Port)
	err := smtp.SendMail(addr, auth, e.Sender, []string{to}, []byte(msg))
	return struct{}{}, err
}
