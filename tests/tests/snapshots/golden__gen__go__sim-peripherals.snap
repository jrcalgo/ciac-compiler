// internal/routes/scope_test.go -- Generated behavioral test for scope
// enforcement. Regenerated on every build. Drives the real router
// directly via `httptest` -- no live listener needed (db/cache/queue
// pools stay lazy; a request that clears the auth layer but then
// touches unreachable infrastructure may still come back as a 5xx,
// which is still proof the auth layer itself let it through -- the
// same claim boundary every other target's own scope test documents).
//
// `no_token`/`malformed_token` are scheme-agnostic (gated below on
// `HasAuthStep`/`HasAuth`, not on scheme) -- an oauth2 project gets
// them here too; `oauth_rig_test.go` covers the oauth2-only cases
// (`26UpdatePlan.md` M5).
package routes

import (
	"bytes"
	"net/http"
	"net/http/httptest"
	"testing"
	"time"

	"github.com/golang-jwt/jwt/v5"

	"sim-peripherals/internal/config"
	"sim-peripherals/internal/state"
)

func bearer(t *testing.T, cfg config.Config, scope string) string {
	t.Helper()
	claims := jwt.MapClaims{
		"sub":   "test",
		"scope": scope,
		"exp":   time.Now().Add(time.Hour).Unix(),
	}
	token, err := jwt.NewWithClaims(jwt.SigningMethodHS256, claims).SignedString([]byte(cfg.JWTSecret))
	if err != nil {
		t.Fatalf("signing test token: %v", err)
	}
	return "Bearer " + token
}

// bearerExp mints an already-expired token (exp in the past) --
// `26UpdatePlan.md` M4's `expired_token` case.
func bearerExp(t *testing.T, cfg config.Config, scope string, expDelta time.Duration) string {
	t.Helper()
	claims := jwt.MapClaims{
		"sub":   "test",
		"scope": scope,
		"exp":   time.Now().Add(expDelta).Unix(),
	}
	token, err := jwt.NewWithClaims(jwt.SigningMethodHS256, claims).SignedString([]byte(cfg.JWTSecret))
	if err != nil {
		t.Fatalf("signing test token: %v", err)
	}
	return "Bearer " + token
}

func testRouter(t *testing.T) (*http.ServeMux, config.Config) {
	t.Helper()
	cfg := config.FromEnv()
	st, err := state.New(cfg)
	if err != nil {
		t.Fatalf("building state: %v", err)
	}
	return Router(st), cfg
}

func TestEchoAPIAuthEnforced(t *testing.T) {
	mux, _ := testRouter(t)

	t.Run("rejects a request with no token", func(t *testing.T) {
		req := httptest.NewRequest("POST", "/echo-api", bytes.NewBufferString(`{"key": "x"}`))
		req.Header.Set("Content-Type", "application/json")
		rec := httptest.NewRecorder()
		mux.ServeHTTP(rec, req)
		if rec.Code != http.StatusUnauthorized {
			t.Fatalf("expected 401, got %d: %s", rec.Code, rec.Body.String())
		}
	})

	t.Run("rejects a malformed bearer token", func(t *testing.T) {
		req := httptest.NewRequest("POST", "/echo-api", bytes.NewBufferString(`{"key": "x"}`))
		req.Header.Set("Content-Type", "application/json")
		req.Header.Set("Authorization", "Bearer not-a-jwt")
		rec := httptest.NewRecorder()
		mux.ServeHTTP(rec, req)
		if rec.Code != http.StatusUnauthorized {
			t.Fatalf("expected 401, got %d: %s", rec.Code, rec.Body.String())
		}
	})
}

func TestEchoAPIScopeEnforced(t *testing.T) {
	mux, cfg := testRouter(t)

	t.Run("rejects a token missing the required scope", func(t *testing.T) {
		req := httptest.NewRequest("POST", "/echo-api", bytes.NewBufferString(`{"key": "x"}`))
		req.Header.Set("Content-Type", "application/json")
		req.Header.Set("Authorization", bearer(t, cfg, "not:peripherals:admin"))
		rec := httptest.NewRecorder()
		mux.ServeHTTP(rec, req)
		if rec.Code != http.StatusForbidden {
			t.Fatalf("expected 403, got %d: %s", rec.Code, rec.Body.String())
		}
	})

	t.Run("accepts a token carrying the required scope", func(t *testing.T) {
		req := httptest.NewRequest("POST", "/echo-api", bytes.NewBufferString(`{"key": "x"}`))
		req.Header.Set("Content-Type", "application/json")
		req.Header.Set("Authorization", bearer(t, cfg, "peripherals:admin"))
		rec := httptest.NewRecorder()
		mux.ServeHTTP(rec, req)
		if rec.Code == http.StatusUnauthorized || rec.Code == http.StatusForbidden {
			t.Fatalf("expected neither 401 nor 403 (mechanism proof only), got %d: %s", rec.Code, rec.Body.String())
		}
	})

	t.Run("rejects an expired token", func(t *testing.T) {
		req := httptest.NewRequest("POST", "/echo-api", bytes.NewBufferString(`{"key": "x"}`))
		req.Header.Set("Content-Type", "application/json")
		req.Header.Set("Authorization", bearerExp(t, cfg, "peripherals:admin", -time.Hour))
		rec := httptest.NewRecorder()
		mux.ServeHTTP(rec, req)
		if rec.Code != http.StatusUnauthorized {
			t.Fatalf("expected 401, got %d: %s", rec.Code, rec.Body.String())
		}
	})
}
