intake/internal/clients/billing.go
============================================================
// internal/clients/billing.go -- Typed HTTP client for the
// `Billing` service. Generated by CIaC.
//
// `call Billing.<Api>` pipeline steps invoke these methods
// (see `_steps.go.j2`'s own `call` arm). The base URL comes from
// `BILLING_URL`; the system docker-compose points it at the
// `billing` container.
//
// 28UpdatePlan.md M7c: under simulation, routes through
// `World.CallChecked` instead of a real HTTP call -- the same
// `{"status": ..., "data": ...}` envelope every route function's own
// response body already carries (`route_api.go.j2`), so this unwraps
// `["data"]` from it exactly the way the real-HTTP branch unwraps
// `envelope.Data` -- same post-processing, different transport. No
// synchronous bridge is needed here, unlike Rust's `block_on_ready`:
// Go's handler chain is already synchronous, so a registered handler
// can just be called directly.
package clients

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"io"
	"net/http"

	"intake/internal/state"
	"sim-shared/world"
)

// BillingClient calls `Billing` over HTTP and unwraps
// its response envelope.
type BillingClient struct {
	baseURL string
	world   *world.World
}

func NewBillingClient(st *state.AppState) *BillingClient {
	return &BillingClient{baseURL: st.Config.BillingURL, world: st.World}
}

func (c *BillingClient) Charge(ctx context.Context, payload any) (any, error) {
	if c.world != nil {
		result, err := c.world.CallChecked("Intake", "Billing", "Charge", payload)
		if err != nil {
			return nil, err
		}
		if envelope, ok := result.(map[string]any); ok {
			return envelope["data"], nil
		}
		return result, nil
	}
	encoded, err := json.Marshal(payload)
	if err != nil {
		return nil, err
	}
	req, err := http.NewRequestWithContext(ctx, "POST", c.baseURL+"/charge", bytes.NewReader(encoded))
	if err != nil {
		return nil, err
	}
	req.Header.Set("Content-Type", "application/json")
	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()
	body, err := io.ReadAll(resp.Body)
	if err != nil {
		return nil, err
	}
	if resp.StatusCode >= 300 {
		return nil, fmt.Errorf("charge: status %d: %s", resp.StatusCode, body)
	}
	var envelope struct {
		Data any `json:"data"`
	}
	if err := json.Unmarshal(body, &envelope); err != nil {
		return nil, err
	}
	return envelope.Data, nil
}
