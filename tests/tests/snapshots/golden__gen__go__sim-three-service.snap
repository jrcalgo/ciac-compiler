fulfillment/internal/workers/ship.go
============================================================
// internal/workers/ship.go -- Generated by CIaC.
// Broker consumer for `worker Ship`.
//
// Consumes three_service.order_accepted in queue group ship so
// replicas of this worker load-balance messages between them.
package workers

import (
	"context"
	"encoding/json"
	"fulfillment/internal/logic"
	"fulfillment/internal/schemas"
	"fulfillment/internal/state"
	"log/slog"
	"sync"
)

const (
	ShipSubject     = "three_service.order_accepted"
	ShipQueueGroup  = "ship"
	ShipConcurrency = 1
	ShipMaxRetries  = 0
)

// HandleMessageOnce runs the pipeline exactly once, no retry/backoff
// wrapper -- the seam a future simulation runner (24UpdatePlan.md M9)
// drives directly with its own attempt counting, mirroring
// `handle_message_once` in the Python/Rust backends.
func HandleMessageOnceShip(ctx context.Context, st *state.AppState, payload any) error {
	result := payload

	if v, err := logic.RecordShipment(ctx, st, result.(schemas.Order)); err != nil {
		return err
	} else {
		result = v
	}
	_ = result
	return nil
}

func handleMessageShip(ctx context.Context, st *state.AppState, payload any) error {
	var err error
	for attempt := 0; attempt <= ShipMaxRetries; attempt++ {
		if err = HandleMessageOnceShip(ctx, st, payload); err == nil {
			return nil
		}
		if attempt < ShipMaxRetries {
			slog.Warn("message processing failed; retrying", "error", err, "attempt", attempt)
		}
	}
	return err
}

func consumeShip(ctx context.Context, st *state.AppState, index int) {
	ch, err := st.Queue.QueueSubscribe(ShipSubject, ShipQueueGroup)
	if err != nil {
		slog.Error("worker Ship: subscribing", "error", err, "index", index)
		return
	}
	slog.Info("worker Ship consuming", "subject", ShipSubject, "index", index)
	for msg := range ch {
		var typed schemas.Order
		if err := json.Unmarshal(msg.Data, &typed); err != nil {
			slog.Warn("discarding malformed message", "error", err)
			continue
		}
		var payload any = typed
		if err := handleMessageShip(ctx, st, payload); err != nil {
			slog.Error("message processing failed after all retries", "error", err, "worker", "Ship", "index", index)
		}
	}
}

// RunShip starts ShipConcurrency consuming goroutines and
// blocks until ctx is done.
func RunShip(ctx context.Context, st *state.AppState) {
	var wg sync.WaitGroup
	for i := 0; i < ShipConcurrency; i++ {
		wg.Add(1)
		go func(index int) {
			defer wg.Done()
			consumeShip(ctx, st, index)
		}(i)
	}
	wg.Wait()
}
