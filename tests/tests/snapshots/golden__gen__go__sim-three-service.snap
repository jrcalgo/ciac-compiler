// internal/logic/record_shipment.go -- Generated by CIaC.
// Compiler-owned typed handler `RecordShipment`, lowered
// straight from the `.ciac` source. Regenerated on every build;
// business logic lives in the `.ciac` source, not here.
package logic

import (
	"context"
	"fulfillment/internal/schemas"
	"fulfillment/internal/state"
	"github.com/google/uuid"
)

// RecordShipment implements the `RecordShipment` typed handler.
func RecordShipment(ctx context.Context, st *state.AppState, order schemas.Order) (schemas.Order, error) {
	__row0 := schemas.Shipment{ID: uuid.NewString(), OrderID: order.ID}
	if st.World != nil {
		if __err1 := st.World.DBInsertChecked("Fulfillment::shipments", __row0); __err1 != nil {
			return schemas.Order{}, __err1
		}
	} else {
		if _, __err1 := st.DB.ExecContext(ctx, "INSERT INTO shipments (id, order_id) VALUES ($1, $2)", __row0.ID, __row0.OrderID); __err1 != nil {
			return schemas.Order{}, __err1
		}
	}
	_ = __row0
	return order, nil
}
