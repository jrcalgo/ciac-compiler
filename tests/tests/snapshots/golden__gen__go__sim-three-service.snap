// cmd/sim_runner/main.go — Generated by CIaC (v0.24 M9, full parity
// 27UpdatePlan.md M7).
//
// Scenario-driving simulation runner. Interprets the same closed
// request/publish/advance/drain/expect scenario vocabulary ciac-sim's
// Scenario JSON schema defines, against this service's own generated
// routes.Router (through net/http/httptest, no live listener) and its
// worker HandleMessageOnce.../job HandleTickOnce... entry points --
// line-for-line the same architecture as sim_runner.rs.j2/
// sim_runner.ts.j2, generated (not a shared library) because this
// needs concrete per-program types, exactly like the Rust/TypeScript
// backends' own generated runners. Included in `go build ./...`/
// `go vet ./...`/`go test ./...` automatically (a second `main`
// package under its own directory, the same way Cargo auto-discovers
// `src/bin/sim_runner.rs`), so no `TargetInfo.validate` change was
// needed to pick it up.
//
// Single-service only; `publish` steps (publishing directly to a
// stream, bypassing an API) are not wired -- the same disclosed scope
// Rust's/TypeScript's own runners still carry. Any scenario step this
// runner cannot honor is a hard error, never a silently-skipped no-op.
// Structural scenario parsing only (simulation_version/non-empty
// steps) -- this is a hand-written restatement of
// ciac_sim::scenario::Scenario, not that vendored Rust source, the
// same position Python's/TypeScript's own hand-written scenario
// drivers occupy.
package main

import (
	"context"
	"encoding/base64"
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"regexp"
	"sort"
	"strconv"
	"strings"
	"time"

	"fulfillment/internal/config"
	"fulfillment/internal/schemas"
	"fulfillment/internal/state"
	"fulfillment/internal/workers"
	"sim-shared/world"
)

const serviceName = "Fulfillment"

// 27UpdatePlan.md M7: schema facts computed once at codegen time from
// the same source the migration DDL itself is built from, so
// reference/unique/cascade checking under simulation can never drift
// from what the real schema enforces -- mirroring Rust's/TypeScript's
// own `sim_world_tables` exactly.
var worldTables = []world.WorldTable{
	{
		Name:       "charges",
		References: []world.WorldReference{},
	},
	{
		Name:       "shipments",
		References: []world.WorldReference{},
	},
}

// -- Scenario JSON shape (structural restatement of ciac_sim::scenario) --

type principal struct {
	Sub    string   `json:"sub"`
	Scopes []string `json:"scopes,omitempty"`
}

type requestStep struct {
	Service string          `json:"service"`
	Api     string          `json:"api"`
	JSON    json.RawMessage `json:"json,omitempty"`
	As      *principal      `json:"as,omitempty"`
	SaveAs  string          `json:"save_as,omitempty"`
}

type publishStep struct {
	Stream string          `json:"stream"`
	JSON   json.RawMessage `json:"json,omitempty"`
}

type advanceStep struct {
	By string `json:"by"`
}

type responseExpect struct {
	Of     string          `json:"of"`
	Status *int            `json:"status,omitempty"`
	JSON   json.RawMessage `json:"json,omitempty"`
}

type rowExpect struct {
	Service string         `json:"service"`
	Table   string         `json:"table"`
	Where   map[string]any `json:"where"`
	Present bool           `json:"present"`
}

type workerAttemptsExpect struct {
	Worker string `json:"worker"`
	Count  int    `json:"count"`
}

type jobRunsExpect struct {
	Job   string `json:"job"`
	Count int    `json:"count"`
}

type emailExpect struct {
	To              *string `json:"to,omitempty"`
	SubjectContains *string `json:"subject_contains,omitempty"`
	Count           int     `json:"count"`
}

type cacheExpect struct {
	Instance string          `json:"instance"`
	Key      string          `json:"key"`
	Present  bool            `json:"present"`
	Value    json.RawMessage `json:"value,omitempty"`
}

type objectExpect struct {
	Store   string `json:"store"`
	Key     string `json:"key"`
	Present bool   `json:"present"`
}

type searchHitsExpect struct {
	Instance string `json:"instance"`
	Query    string `json:"query"`
	Count    int    `json:"count"`
}

type httpCallsExpect struct {
	Instance string `json:"instance"`
	Count    int    `json:"count"`
}

type expectStep struct {
	Response       *responseExpect       `json:"response,omitempty"`
	Row            *rowExpect            `json:"row,omitempty"`
	WorkerAttempts *workerAttemptsExpect `json:"worker_attempts,omitempty"`
	JobRuns        *jobRunsExpect        `json:"job_runs,omitempty"`
	Quiescence     *struct{}             `json:"quiescence,omitempty"`
	Email          *emailExpect          `json:"email,omitempty"`
	Cache          *cacheExpect          `json:"cache,omitempty"`
	Object         *objectExpect         `json:"object,omitempty"`
	SearchHits     *searchHitsExpect     `json:"search_hits,omitempty"`
	HTTPCalls      *httpCallsExpect      `json:"http_calls,omitempty"`
}

type scenarioStep struct {
	Request *requestStep `json:"request,omitempty"`
	Publish *publishStep `json:"publish,omitempty"`
	Advance *advanceStep `json:"advance,omitempty"`
	Drain   *struct{}    `json:"drain,omitempty"`
	Expect  *expectStep  `json:"expect,omitempty"`
}

type givenTableRows struct {
	Service string            `json:"service"`
	Table   string            `json:"table"`
	Rows    []json.RawMessage `json:"rows"`
}

type givenCacheEntry struct {
	Instance string          `json:"instance"`
	Key      string          `json:"key"`
	Value    json.RawMessage `json:"value"`
	TTL      *string         `json:"ttl,omitempty"`
}

type givenStoreObject struct {
	Instance    string `json:"instance"`
	Key         string `json:"key"`
	ValueBase64 string `json:"value_base64"`
}

type givenSearchDoc struct {
	Instance string          `json:"instance"`
	ID       string          `json:"id"`
	Doc      json.RawMessage `json:"doc"`
}

type givenHTTPFixture struct {
	Instance  string                    `json:"instance"`
	Responses []world.GivenHTTPResponse `json:"responses"`
}

type failureSelector struct {
	Effect     string  `json:"effect"`
	Subject    *string `json:"subject"`
	Occurrence int     `json:"occurrence"`
	Phase      string  `json:"phase"`
}

type failureAction struct {
	Kind string `json:"kind"`
}

type rawFailureRule struct {
	At     failureSelector `json:"at"`
	Action failureAction   `json:"action"`
}

type given struct {
	DB           []givenTableRows   `json:"db,omitempty"`
	Cache        []givenCacheEntry  `json:"cache,omitempty"`
	Store        []givenStoreObject `json:"store,omitempty"`
	Search       []givenSearchDoc   `json:"search,omitempty"`
	ExternalHTTP []givenHTTPFixture `json:"external_http,omitempty"`
	Failures     []rawFailureRule   `json:"failures,omitempty"`
}

type scenario struct {
	SimulationVersion int            `json:"simulation_version"`
	Name              string         `json:"name"`
	StartAt           string         `json:"start_at"`
	Given             given          `json:"given"`
	Steps             []scenarioStep `json:"steps"`
}

type simScenarioOutcome struct {
	Scenario       string         `json:"scenario"`
	Passed         bool           `json:"passed"`
	Error          *string        `json:"error"`
	WorkerAttempts map[string]int `json:"worker_attempts"`
	JobRuns        map[string]int `json:"job_runs"`
}

type savedResponse struct {
	Status int
	JSON   any
}

// toFailureRules: only the `error` action / `after` phase is
// implemented -- the same disclosed subset of the full failure
// vocabulary Rust's own SimWorld::should_fail supports, for the same
// reason (it's the one action this checkpoint's scenarios need).
// Refused up front rather than silently ignored if a scenario asks for
// anything else.
func toFailureRules(raw []rawFailureRule) ([]world.FailureRule, error) {
	out := make([]world.FailureRule, 0, len(raw))
	for _, r := range raw {
		if r.Action.Kind != "error" {
			return nil, fmt.Errorf(
				"failure rule for effect %q uses action %q, which this Go world's FailureEngine "+
					"integration does not support yet (only `error` is implemented)",
				r.At.Effect, r.Action.Kind,
			)
		}
		if r.At.Phase != "after" {
			return nil, fmt.Errorf(
				"failure rule for effect %q uses phase %q, which this Go world's FailureEngine "+
					"integration does not support yet (only `after` is implemented)",
				r.At.Effect, r.At.Phase,
			)
		}
		subject := ""
		if r.At.Subject != nil {
			subject = *r.At.Subject
		}
		out = append(out, world.FailureRule{Effect: r.At.Effect, Subject: subject, Occurrence: r.At.Occurrence})
	}
	return out, nil
}

var durationRe = regexp.MustCompile(`^(\d+)(ms|s|m|h|d)$`)

// parseDurationMs parses `advance.by` strings ("24h", "7d", "30m", ...)
// -- matches sim/pyrunner/cron.py's parse_duration_ms and
// sim_runner.rs.j2/sim_runner.ts.j2's own parseDurationMs exactly.
func parseDurationMs(text string) (int64, error) {
	m := durationRe.FindStringSubmatch(text)
	if m == nil {
		return 0, fmt.Errorf("unrecognized duration: %q", text)
	}
	value, err := strconv.ParseInt(m[1], 10, 64)
	if err != nil {
		return 0, err
	}
	unitMs := map[string]int64{"ms": 1, "s": 1_000, "m": 60_000, "h": 3_600_000, "d": 86_400_000}
	return value * unitMs[m[2]], nil
}

// canonicalJSON is a canonical (key-sorted) JSON string, so
// expect.response.json compares by value, not by the saved response's
// own key order.
func canonicalJSON(v any) string {
	switch val := v.(type) {
	case map[string]any:
		keys := make([]string, 0, len(val))
		for k := range val {
			keys = append(keys, k)
		}
		sort.Strings(keys)
		parts := make([]string, len(keys))
		for i, k := range keys {
			kb, _ := json.Marshal(k)
			parts[i] = string(kb) + ":" + canonicalJSON(val[k])
		}
		return "{" + strings.Join(parts, ",") + "}"
	case []any:
		parts := make([]string, len(val))
		for i, e := range val {
			parts[i] = canonicalJSON(e)
		}
		return "[" + strings.Join(parts, ",") + "]"
	default:
		b, _ := json.Marshal(val)
		return string(b)
	}
}

// drain hands every message currently undelivered to its worker's own
// (subject, group) cursor on `world`'s broker log into
// HandleMessageOnce exactly once (with that worker's own retry
// budget) -- messages a handler publishes as a side effect of
// processing are left for the *next* drain step. Two independent
// workers on the same subject now each see every message (true
// fan-out), where the old shared-queue dispatch delivered only to
// whichever worker's `if`/`else if` branch matched first -- matching
// Rust's/TypeScript's own 27UpdatePlan.md M4/M6 `drain()` rewrite.
func drain(st *state.AppState, w *world.World, workerAttempts map[string]int) error {
	for _, msg := range w.DrainBroker(workers.ShipSubject, workers.ShipQueueGroup) {
		var typed schemas.Order
		if err := json.Unmarshal(msg, &typed); err != nil {
			return fmt.Errorf("sim_runner: decoding Ship payload: %w", err)
		}
		var payload any = typed
		attempts := 0
		var attemptErr error
		for attempt := 0; attempt <= workers.ShipMaxRetries; attempt++ {
			attempts++
			if attemptErr = workers.HandleMessageOnceShip(context.Background(), st, payload); attemptErr == nil {
				break
			}
		}
		if attemptErr != nil {
			fmt.Fprintf(os.Stderr, "sim_runner: Ship exhausted retries: %v\n", attemptErr)
		}
		workerAttempts["Ship"] += attempts
	}
	_ = workerAttempts
	// `w.DrainQueue()` is dual-written alongside the group-aware
	// broker log (`World.PublishChecked`'s own doc) for exactly this
	// sweep: a message published to a subject no registered worker
	// drains above is refused here, not left to sit undelivered
	// forever -- the same "refused, not guessed" contract this runner
	// has always held for capabilities it doesn't cover.
	for _, msg := range w.DrainQueue() {
		delivered := false
		if msg.Subject == workers.ShipSubject {
			// Already drained via `w.DrainBroker` above.
			delivered = true
		}
		if !delivered {
			return fmt.Errorf("sim_runner: no worker registered to consume subject %q (disclosed scope)", msg.Subject)
		}
	}
	return nil
}

func advance(st *state.AppState, w *world.World, fromMs, toMs int64, jobRuns map[string]int) error {
	if err := w.AdvanceClockTo(toMs); err != nil {
		return err
	}
	_ = st
	_ = fromMs
	_ = jobRuns
	return nil
}

func expect(spec expectStep, w *world.World, saved map[string]savedResponse, workerAttempts, jobRuns map[string]int) error {
	switch {
	case spec.Response != nil:
		got, ok := saved[spec.Response.Of]
		if !ok {
			return fmt.Errorf("expect.response.of references unknown save_as %q", spec.Response.Of)
		}
		if spec.Response.Status != nil && got.Status != *spec.Response.Status {
			return fmt.Errorf(
				"expect.response.of=%q: expected status %d, got %d",
				spec.Response.Of, *spec.Response.Status, got.Status,
			)
		}
		if len(spec.Response.JSON) > 0 {
			var want any
			if err := json.Unmarshal(spec.Response.JSON, &want); err != nil {
				return err
			}
			if canonicalJSON(got.JSON) != canonicalJSON(want) {
				return fmt.Errorf(
					"expect.response.of=%q: expected json %s, got %s",
					spec.Response.Of, canonicalJSON(want), canonicalJSON(got.JSON),
				)
			}
		}
	case spec.Row != nil:
		if spec.Row.Service != serviceName {
			return fmt.Errorf(
				"sim_runner only drives service %q (single-service only); expect.row named %q",
				serviceName, spec.Row.Service,
			)
		}
		found := len(w.FindWhere(spec.Row.Table, spec.Row.Where)) > 0
		if found != spec.Row.Present {
			return fmt.Errorf(
				"expect.row: table=%q where=%v present=%v, found=%v",
				spec.Row.Table, spec.Row.Where, spec.Row.Present, found,
			)
		}
	case spec.WorkerAttempts != nil:
		actual := workerAttempts[spec.WorkerAttempts.Worker]
		if actual != spec.WorkerAttempts.Count {
			return fmt.Errorf(
				"expect.worker_attempts: worker=%q expected %d, got %d",
				spec.WorkerAttempts.Worker, spec.WorkerAttempts.Count, actual,
			)
		}
	case spec.JobRuns != nil:
		actual := jobRuns[spec.JobRuns.Job]
		if actual != spec.JobRuns.Count {
			return fmt.Errorf(
				"expect.job_runs: job=%q expected %d, got %d",
				spec.JobRuns.Job, spec.JobRuns.Count, actual,
			)
		}
	case spec.Quiescence != nil:
		if !w.QueueIsEmpty() {
			return errors.New("expect.quiescence: undelivered message(s) remain in the simulated broker")
		}
	case spec.Email != nil:
		actual := w.EmailSentCountAll(spec.Email.To, spec.Email.SubjectContains)
		if actual != spec.Email.Count {
			return fmt.Errorf(
				"expect.email: to=%v subject_contains=%v expected %d, got %d",
				spec.Email.To, spec.Email.SubjectContains, spec.Email.Count, actual,
			)
		}
	case spec.Cache != nil:
		cached, found := w.CacheGet(spec.Cache.Instance, spec.Cache.Key)
		if found != spec.Cache.Present {
			return fmt.Errorf(
				"expect.cache: instance=%q key=%q expected present=%v, found present=%v",
				spec.Cache.Instance, spec.Cache.Key, spec.Cache.Present, found,
			)
		}
		if len(spec.Cache.Value) > 0 {
			var want any
			if err := json.Unmarshal(spec.Cache.Value, &want); err != nil {
				return err
			}
			var actual any
			if found {
				if err := json.Unmarshal([]byte(cached), &actual); err != nil {
					return err
				}
			}
			if canonicalJSON(actual) != canonicalJSON(want) {
				return fmt.Errorf(
					"expect.cache: instance=%q key=%q expected value=%s, got %s",
					spec.Cache.Instance, spec.Cache.Key, canonicalJSON(want), canonicalJSON(actual),
				)
			}
		}
	case spec.Object != nil:
		found := w.ObjectExists(spec.Object.Store, spec.Object.Key)
		if found != spec.Object.Present {
			return fmt.Errorf(
				"expect.object: store=%q key=%q expected present=%v, found present=%v",
				spec.Object.Store, spec.Object.Key, spec.Object.Present, found,
			)
		}
	case spec.SearchHits != nil:
		actual := len(w.SearchQuery(spec.SearchHits.Instance, spec.SearchHits.Query))
		if actual != spec.SearchHits.Count {
			return fmt.Errorf(
				"expect.search_hits: instance=%q query=%q expected %d, got %d",
				spec.SearchHits.Instance, spec.SearchHits.Query, spec.SearchHits.Count, actual,
			)
		}
	case spec.HTTPCalls != nil:
		actual := w.HTTPRequestCount(spec.HTTPCalls.Instance)
		if actual != spec.HTTPCalls.Count {
			return fmt.Errorf(
				"expect.http_calls: instance=%q expected %d, got %d",
				spec.HTTPCalls.Instance, spec.HTTPCalls.Count, actual,
			)
		}
	default:
		return errors.New("sim_runner: unrecognized expect step")
	}
	return nil
}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: sim_runner <scenario.json>")
		os.Exit(1)
	}
	raw, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	var sc scenario
	if err := json.Unmarshal(raw, &sc); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	if sc.SimulationVersion != 1 {
		fmt.Fprintf(os.Stderr, "scenario simulation_version %d is not supported (expected 1)\n", sc.SimulationVersion)
		os.Exit(1)
	}
	if len(sc.Steps) == 0 {
		fmt.Fprintln(os.Stderr, "scenario has no steps")
		os.Exit(1)
	}

	failureRules, err := toFailureRules(sc.Given.Failures)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	w := world.New(failureRules, worldTables)
	for _, seed := range sc.Given.DB {
		if seed.Service != serviceName {
			fmt.Fprintf(
				os.Stderr,
				"sim_runner only drives service %q (single-service only); given.db named %q\n",
				serviceName, seed.Service,
			)
			os.Exit(1)
		}
		for _, row := range seed.Rows {
			if err := w.SeedDB(seed.Table, row); err != nil {
				fmt.Fprintln(os.Stderr, err)
				os.Exit(1)
			}
		}
	}

	startAt, err := time.Parse(time.RFC3339, sc.StartAt)
	if err != nil {
		fmt.Fprintf(os.Stderr, "scenario start_at %q: not a valid date\n", sc.StartAt)
		os.Exit(1)
	}
	nowMs := startAt.UnixMilli()
	// `World.New` always starts its own virtual clock at epoch 0
	// (disclosed in `world.go`'s own doc comment); synced to
	// `start_at` here, before any TTL-bearing seed below reads
	// `World.NowMs()`, and kept in lockstep by every `advance()` step
	// thereafter -- mirroring Rust's/TypeScript's own ordering
	// exactly.
	if err := w.AdvanceClockTo(nowMs); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	// 27UpdatePlan.md M7: `given.cache`/`given.store`/`given.search`/
	// `given.external_http` -- mirrors `sim/pyrunner/auto_driver.py`'s
	// `apply_given` and Rust's/TypeScript's own `sim_runner` (M4/M6)
	// exactly.
	for _, entry := range sc.Given.Cache {
		var ttlMs *int64
		if entry.TTL != nil {
			ms, err := parseDurationMs(*entry.TTL)
			if err != nil {
				fmt.Fprintln(os.Stderr, err)
				os.Exit(1)
			}
			ttlMs = &ms
		}
		w.CacheSet(entry.Instance, entry.Key, string(entry.Value), ttlMs)
	}
	for _, obj := range sc.Given.Store {
		body, err := base64.StdEncoding.DecodeString(obj.ValueBase64)
		if err != nil {
			fmt.Fprintln(os.Stderr, err)
			os.Exit(1)
		}
		w.ObjectPut(obj.Instance, obj.Key, body)
	}
	for _, doc := range sc.Given.Search {
		var decoded any
		if err := json.Unmarshal(doc.Doc, &decoded); err != nil {
			fmt.Fprintln(os.Stderr, err)
			os.Exit(1)
		}
		w.SearchIndex(doc.Instance, doc.ID, decoded)
	}
	for _, fixture := range sc.Given.ExternalHTTP {
		w.SeedHTTPFixtures(fixture.Instance, fixture.Responses)
	}

	cfg := config.FromEnv()
	st := state.NewSimulation(cfg, w)

	saved := map[string]savedResponse{}
	workerAttempts := map[string]int{}
	jobRuns := map[string]int{}

	var runErr error
	for _, step := range sc.Steps {
		switch {
		case step.Request != nil:
			runErr = fmt.Errorf(
				"sim_runner: no api registered named %q (this service declares no `api` pipelines)",
				step.Request.Api,
			)
		case step.Publish != nil:
			runErr = errors.New("sim_runner does not support `publish` steps (disclosed scope)")
		case step.Advance != nil:
			deltaMs, derr := parseDurationMs(step.Advance.By)
			if derr != nil {
				runErr = derr
			} else {
				toMs := nowMs + deltaMs
				runErr = advance(st, w, nowMs, toMs, jobRuns)
				nowMs = toMs
			}
		case step.Drain != nil:
			runErr = drain(st, w, workerAttempts)
		case step.Expect != nil:
			runErr = expect(*step.Expect, w, saved, workerAttempts, jobRuns)
		default:
			runErr = errors.New("sim_runner: unrecognized step")
		}
		if runErr != nil {
			break
		}
	}
	if runErr == nil {
		unmatched := w.UnmatchedFailureRules()
		if len(unmatched) > 0 {
			runErr = fmt.Errorf(
				"%d failure rule(s) declared in `given.failures` never matched a real occurrence: %v",
				len(unmatched), unmatched,
			)
		}
	}

	outcome := simScenarioOutcome{
		Scenario:       sc.Name,
		Passed:         runErr == nil,
		WorkerAttempts: workerAttempts,
		JobRuns:        jobRuns,
	}
	if runErr != nil {
		msg := runErr.Error()
		outcome.Error = &msg
	}
	out, err := json.Marshal(outcome)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	fmt.Println(string(out))
}
