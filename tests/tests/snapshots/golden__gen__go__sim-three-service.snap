// internal/routes/submit_order_api.go -- Generated by CIaC.
//
// Pipeline: SubmitOrder.
package routes

import (
	"intake/internal/clients"
	"intake/internal/httpx"
	"intake/internal/queue"
	"intake/internal/schemas"
	"intake/internal/state"
	"net/http"
)

func SubmitOrderHandler(st *state.AppState) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		// ctx may go unused (a pipeline with no handler/publish/call
		// step, e.g. plain `Return`) or genuinely used below,
		// depending on this api's steps -- always declaring it keeps
		// this handler's shape stable as the pipeline grows.
		ctx := r.Context()
		_ = ctx
		decoded, err := schemas.DecodeOrder(r.Body)
		if err != nil {
			httpx.WriteError(w, httpx.BadRequest(err))
			return
		}
		var result any = decoded

		if v, err := clients.NewBillingClient(st).Charge(ctx, result); err != nil {
			httpx.WriteError(w, err)
			return
		} else {
			result = v
		}

		if err := queue.PublishJSON(ctx, st.Queue, st.World, "three_service.order_accepted", result); err != nil {
			httpx.WriteError(w, err)
			return
		}

		httpx.Accepted(w, result)
	}
}
