============================================================
system-runner/main.go
============================================================
// Multi-service scenario-driving simulation runner. Generated by CIaC
// (28UpdatePlan.md M7c) -- the `system-runner` module's own
// `main.go`, one per multi-service system, generalizing
// `sim_runner.go.j2`'s single-service interpreter across every
// service this system declares.
//
// Depends on `sim-shared` and every service's own Go module (all
// resolved through `go.mod` `replace` directives pointing at `../
// <dir>`), importing each service's `simbridge` package -- found live
// (`go build`'s own "use of internal package ... not allowed"
// refusal): Go's directory-based `internal/` visibility rule blocks a
// *separate* module from importing anything under a service's own
// `internal/` tree at all (config, state, routes, workers, schemas
// included, not only `world`), regardless of the `replace` directive
// that makes the module itself resolvable. `simbridge` is each
// service's own thin, non-`internal` re-export of exactly what this
// runner needs (see `templates/simbridge.go.j2`'s own doc comment);
// every service's own package is imported under one alias (its
// PascalCase module suffix) since `simbridge` is otherwise the same
// base name for every service. One shared `sim-shared/world.World`
// (the same nominal type every service's own `state.go` imports, per
// M7c's `sim-shared` module) is constructed once and threaded into
// every service's own `NewSimulation`.
//
// Unlike TypeScript's system-runner (which inlines one `app.inject()`
// call per (service, api) pair to sidestep Fastify's own per-app
// generic-variance friction) or Rust's (which needs a synchronous
// `block_on_ready` bridge), Go's `*http.ServeMux` is a plain, non-
// generic concrete type -- every service's own router has the exact
// same static type, so one shared `doInject` helper drives every
// (service, api) pair uniformly, and `world.RegisterAPI`'s handler
// type (`func(req any) (any, error)`) is already synchronous, needing
// no bridge at all.
//
// Deliberately narrow, matching every other generated runner's own
// disclosed scope: `publish` steps are not wired; `drain`/`expect.
// quiescence` see one global undelivered-message buffer, not
// independent per-`(subject, group)` cursors across services. Any
// scenario step this runner cannot honor is a hard error, never a
// silently-skipped no-op.
package main

import (
	"bytes"
	"context"
	"encoding/base64"
	"encoding/json"
	"errors"
	"fmt"
	"net/http"
	"net/http/httptest"
	"os"
	"regexp"
	"sort"
	"strconv"
	"strings"
	"time"

	Billing "billing/simbridge"
	Fulfillment "fulfillment/simbridge"
	Intake "intake/simbridge"
	"sim-shared/world"
)

// 28UpdatePlan.md M7c: schema facts computed once at codegen time,
// table names namespaced `"{service}::{table}"` exactly like
// `lower.rs`'s own `world_table_key` (and `ciac-backend-rust`'s M6c/
// `ciac-backend-ts`'s M7a system-runners), so reference/unique/cascade
// checks can never drift or collide across two same-named tables in
// different services.
var worldTables = []world.WorldTable{
	{
		Name:       "Billing::charges",
		References: []world.WorldReference{},
	},
	{
		Name:       "Fulfillment::shipments",
		References: []world.WorldReference{},
	},
}

type apiKey struct {
	Service string
	Api     string
}

type apiRoute struct {
	Method string
	Path   string
}

var apiRoutes = map[apiKey]apiRoute{
	{"Intake", "SubmitOrder"}: {Method: "POST", Path: "/orders"},
	{"Billing", "Charge"}:     {Method: "POST", Path: "/charge"},
}

// -- Scenario JSON shape (structural restatement of ciac_sim::scenario) --

type principal struct {
	Sub    string   `json:"sub"`
	Scopes []string `json:"scopes,omitempty"`
}

type requestStep struct {
	Service string          `json:"service"`
	Api     string          `json:"api"`
	JSON    json.RawMessage `json:"json,omitempty"`
	As      *principal      `json:"as,omitempty"`
	SaveAs  string          `json:"save_as,omitempty"`
}

type publishStep struct {
	Stream string          `json:"stream"`
	JSON   json.RawMessage `json:"json,omitempty"`
}

type advanceStep struct {
	By string `json:"by"`
}

type responseExpect struct {
	Of     string          `json:"of"`
	Status *int            `json:"status,omitempty"`
	JSON   json.RawMessage `json:"json,omitempty"`
}

type rowExpect struct {
	Service string         `json:"service"`
	Table   string         `json:"table"`
	Where   map[string]any `json:"where"`
	Present bool           `json:"present"`
}

type workerAttemptsExpect struct {
	Worker string `json:"worker"`
	Count  int    `json:"count"`
}

type jobRunsExpect struct {
	Job   string `json:"job"`
	Count int    `json:"count"`
}

type emailExpect struct {
	To              *string `json:"to,omitempty"`
	SubjectContains *string `json:"subject_contains,omitempty"`
	Count           int     `json:"count"`
}

type cacheExpect struct {
	Instance string          `json:"instance"`
	Key      string          `json:"key"`
	Present  bool            `json:"present"`
	Value    json.RawMessage `json:"value,omitempty"`
}

type objectExpect struct {
	Store   string `json:"store"`
	Key     string `json:"key"`
	Present bool   `json:"present"`
}

type searchHitsExpect struct {
	Instance string `json:"instance"`
	Query    string `json:"query"`
	Count    int    `json:"count"`
}

type httpCallsExpect struct {
	Instance string `json:"instance"`
	Count    int    `json:"count"`
}

type expectStep struct {
	Response       *responseExpect       `json:"response,omitempty"`
	Row            *rowExpect            `json:"row,omitempty"`
	WorkerAttempts *workerAttemptsExpect `json:"worker_attempts,omitempty"`
	JobRuns        *jobRunsExpect        `json:"job_runs,omitempty"`
	Quiescence     *struct{}             `json:"quiescence,omitempty"`
	Email          *emailExpect          `json:"email,omitempty"`
	Cache          *cacheExpect          `json:"cache,omitempty"`
	Object         *objectExpect         `json:"object,omitempty"`
	SearchHits     *searchHitsExpect     `json:"search_hits,omitempty"`
	HTTPCalls      *httpCallsExpect      `json:"http_calls,omitempty"`
}

type scenarioStep struct {
	Request *requestStep `json:"request,omitempty"`
	Publish *publishStep `json:"publish,omitempty"`
	Advance *advanceStep `json:"advance,omitempty"`
	Drain   *struct{}    `json:"drain,omitempty"`
	Expect  *expectStep  `json:"expect,omitempty"`
}

type givenTableRows struct {
	Service string            `json:"service"`
	Table   string            `json:"table"`
	Rows    []json.RawMessage `json:"rows"`
}

type givenCacheEntry struct {
	Instance string          `json:"instance"`
	Key      string          `json:"key"`
	Value    json.RawMessage `json:"value"`
	TTL      *string         `json:"ttl,omitempty"`
}

type givenStoreObject struct {
	Instance    string `json:"instance"`
	Key         string `json:"key"`
	ValueBase64 string `json:"value_base64"`
}

type givenSearchDoc struct {
	Instance string          `json:"instance"`
	ID       string          `json:"id"`
	Doc      json.RawMessage `json:"doc"`
}

type givenHTTPFixture struct {
	Instance  string                    `json:"instance"`
	Responses []world.GivenHTTPResponse `json:"responses"`
}

type failureSelector struct {
	Effect     string  `json:"effect"`
	Subject    *string `json:"subject"`
	Occurrence int     `json:"occurrence"`
	Phase      string  `json:"phase"`
}

type failureAction struct {
	Kind string `json:"kind"`
}

type rawFailureRule struct {
	At     failureSelector `json:"at"`
	Action failureAction   `json:"action"`
}

type given struct {
	DB           []givenTableRows   `json:"db,omitempty"`
	Cache        []givenCacheEntry  `json:"cache,omitempty"`
	Store        []givenStoreObject `json:"store,omitempty"`
	Search       []givenSearchDoc   `json:"search,omitempty"`
	ExternalHTTP []givenHTTPFixture `json:"external_http,omitempty"`
	Failures     []rawFailureRule   `json:"failures,omitempty"`
}

type scenario struct {
	SimulationVersion int            `json:"simulation_version"`
	Name              string         `json:"name"`
	StartAt           string         `json:"start_at"`
	Given             given          `json:"given"`
	Steps             []scenarioStep `json:"steps"`
}

type simScenarioOutcome struct {
	Scenario       string         `json:"scenario"`
	Passed         bool           `json:"passed"`
	Error          *string        `json:"error"`
	WorkerAttempts map[string]int `json:"worker_attempts"`
	JobRuns        map[string]int `json:"job_runs"`
}

type savedResponse struct {
	Status int
	JSON   any
}

// toFailureRules: only the `error` action / `after` phase is
// implemented -- the same disclosed subset every other generated
// runner's own FailureEngine integration carries. Refused up front
// rather than silently ignored if a scenario asks for anything else.
func toFailureRules(raw []rawFailureRule) ([]world.FailureRule, error) {
	out := make([]world.FailureRule, 0, len(raw))
	for _, r := range raw {
		if r.Action.Kind != "error" {
			return nil, fmt.Errorf(
				"failure rule for effect %q uses action %q, which this system-runner's FailureEngine "+
					"integration does not support yet (only `error` is implemented)",
				r.At.Effect, r.Action.Kind,
			)
		}
		if r.At.Phase != "after" {
			return nil, fmt.Errorf(
				"failure rule for effect %q uses phase %q, which this system-runner's FailureEngine "+
					"integration does not support yet (only `after` is implemented)",
				r.At.Effect, r.At.Phase,
			)
		}
		subject := ""
		if r.At.Subject != nil {
			subject = *r.At.Subject
		}
		out = append(out, world.FailureRule{Effect: r.At.Effect, Subject: subject, Occurrence: r.At.Occurrence})
	}
	return out, nil
}

var durationRe = regexp.MustCompile(`^(\d+)(ms|s|m|h|d)$`)

// parseDurationMs parses `advance.by` strings ("24h", "7d", "30m", ...)
// -- matches every other generated runner's own parseDurationMs
// exactly.
func parseDurationMs(text string) (int64, error) {
	m := durationRe.FindStringSubmatch(text)
	if m == nil {
		return 0, fmt.Errorf("unrecognized duration: %q", text)
	}
	value, err := strconv.ParseInt(m[1], 10, 64)
	if err != nil {
		return 0, err
	}
	unitMs := map[string]int64{"ms": 1, "s": 1_000, "m": 60_000, "h": 3_600_000, "d": 86_400_000}
	return value * unitMs[m[2]], nil
}

// canonicalJSON is a canonical (key-sorted) JSON string, so
// expect.response.json compares by value, not by the saved response's
// own key order.
func canonicalJSON(v any) string {
	switch val := v.(type) {
	case map[string]any:
		keys := make([]string, 0, len(val))
		for k := range val {
			keys = append(keys, k)
		}
		sort.Strings(keys)
		parts := make([]string, len(keys))
		for i, k := range keys {
			kb, _ := json.Marshal(k)
			parts[i] = string(kb) + ":" + canonicalJSON(val[k])
		}
		return "{" + strings.Join(parts, ",") + "}"
	case []any:
		parts := make([]string, len(val))
		for i, e := range val {
			parts[i] = canonicalJSON(e)
		}
		return "[" + strings.Join(parts, ",") + "]"
	default:
		b, _ := json.Marshal(val)
		return string(b)
	}
}

// doInject performs one net/http/httptest round-trip against mux --
// the one low-level primitive both a scenario's own direct `request`
// step and a routed `call <Service>.<Api>` step (via
// `world.RegisterAPI`) funnel through, since every service's own
// `*http.ServeMux` is the exact same concrete, non-generic type (no
// per-app generic-variance friction the way Fastify's TypeScript types
// carry).
func doInject(mux *http.ServeMux, method, path string, body []byte, headers map[string]string) (int, any, error) {
	req := httptest.NewRequest(method, path, bytes.NewReader(body))
	for k, v := range headers {
		req.Header.Set(k, v)
	}
	rec := httptest.NewRecorder()
	mux.ServeHTTP(rec, req)
	var parsed any
	if rec.Body.Len() > 0 {
		if err := json.Unmarshal(rec.Body.Bytes(), &parsed); err != nil {
			return rec.Code, nil, err
		}
	}
	return rec.Code, parsed, nil
}

// 28UpdatePlan.md M7c: synthesizes a bearer token from the step's own
// `as` principal exactly like every other generated runner's identical
// synthesis. A direct `request` step never treats a non-2xx status as
// an error -- a scenario may deliberately expect one (`expect.response.
// status`); that check happens later, in `expect`.
func doRequest(muxes map[string]*http.ServeMux, w *world.World, spec requestStep, saved map[string]savedResponse) error {
	mux, ok := muxes[spec.Service]
	if !ok {
		return fmt.Errorf("sim_runner: no api registered for service %q", spec.Service)
	}
	route, ok := apiRoutes[apiKey{spec.Service, spec.Api}]
	if !ok {
		return fmt.Errorf("sim_runner: no api registered named %q on service %q", spec.Api, spec.Service)
	}
	headers := map[string]string{}
	if spec.As != nil {
		scopes := spec.As.Scopes
		token := fmt.Sprintf("sim:%s:%s", spec.As.Sub, strings.Join(scopes, ","))
		w.AuthIssue(token, map[string]any{"sub": spec.As.Sub, "scope": strings.Join(scopes, " ")}, nil)
		headers["Authorization"] = "Bearer " + token
	}
	if len(spec.JSON) > 0 {
		headers["Content-Type"] = "application/json"
	}
	status, parsed, err := doInject(mux, route.Method, route.Path, spec.JSON, headers)
	if err != nil {
		return fmt.Errorf("sim_runner: decoding response for %s.%s: %w", spec.Service, spec.Api, err)
	}
	if spec.SaveAs != "" {
		saved[spec.SaveAs] = savedResponse{Status: status, JSON: parsed}
	}
	return nil
}

func expect(spec expectStep, w *world.World, saved map[string]savedResponse, workerAttempts, jobRuns map[string]int) error {
	switch {
	case spec.Response != nil:
		got, ok := saved[spec.Response.Of]
		if !ok {
			return fmt.Errorf("expect.response.of references unknown save_as %q", spec.Response.Of)
		}
		if spec.Response.Status != nil && got.Status != *spec.Response.Status {
			return fmt.Errorf(
				"expect.response.of=%q: expected status %d, got %d",
				spec.Response.Of, *spec.Response.Status, got.Status,
			)
		}
		if len(spec.Response.JSON) > 0 {
			var want any
			if err := json.Unmarshal(spec.Response.JSON, &want); err != nil {
				return err
			}
			if canonicalJSON(got.JSON) != canonicalJSON(want) {
				return fmt.Errorf(
					"expect.response.of=%q: expected json %s, got %s",
					spec.Response.Of, canonicalJSON(want), canonicalJSON(got.JSON),
				)
			}
		}
	case spec.Row != nil:
		key := world.NamespacedTableKey(spec.Row.Service, spec.Row.Table)
		found := len(w.FindWhere(key, spec.Row.Where)) > 0
		if found != spec.Row.Present {
			return fmt.Errorf(
				"expect.row: service=%q table=%q where=%v present=%v, found=%v",
				spec.Row.Service, spec.Row.Table, spec.Row.Where, spec.Row.Present, found,
			)
		}
	case spec.WorkerAttempts != nil:
		actual := workerAttempts[spec.WorkerAttempts.Worker]
		if actual != spec.WorkerAttempts.Count {
			return fmt.Errorf(
				"expect.worker_attempts: worker=%q expected %d, got %d",
				spec.WorkerAttempts.Worker, spec.WorkerAttempts.Count, actual,
			)
		}
	case spec.JobRuns != nil:
		actual := jobRuns[spec.JobRuns.Job]
		if actual != spec.JobRuns.Count {
			return fmt.Errorf(
				"expect.job_runs: job=%q expected %d, got %d",
				spec.JobRuns.Job, spec.JobRuns.Count, actual,
			)
		}
	case spec.Quiescence != nil:
		if !w.QueueIsEmpty() {
			return errors.New("expect.quiescence: undelivered message(s) remain in the simulated broker")
		}
	case spec.Email != nil:
		actual := w.EmailSentCountAll(spec.Email.To, spec.Email.SubjectContains)
		if actual != spec.Email.Count {
			return fmt.Errorf(
				"expect.email: to=%v subject_contains=%v expected %d, got %d",
				spec.Email.To, spec.Email.SubjectContains, spec.Email.Count, actual,
			)
		}
	case spec.Cache != nil:
		cached, found := w.CacheGet(spec.Cache.Instance, spec.Cache.Key)
		if found != spec.Cache.Present {
			return fmt.Errorf(
				"expect.cache: instance=%q key=%q expected present=%v, found present=%v",
				spec.Cache.Instance, spec.Cache.Key, spec.Cache.Present, found,
			)
		}
		if len(spec.Cache.Value) > 0 {
			var want any
			if err := json.Unmarshal(spec.Cache.Value, &want); err != nil {
				return err
			}
			var actual any
			if found {
				if err := json.Unmarshal([]byte(cached), &actual); err != nil {
					return err
				}
			}
			if canonicalJSON(actual) != canonicalJSON(want) {
				return fmt.Errorf(
					"expect.cache: instance=%q key=%q expected value=%s, got %s",
					spec.Cache.Instance, spec.Cache.Key, canonicalJSON(want), canonicalJSON(actual),
				)
			}
		}
	case spec.Object != nil:
		found := w.ObjectExists(spec.Object.Store, spec.Object.Key)
		if found != spec.Object.Present {
			return fmt.Errorf(
				"expect.object: store=%q key=%q expected present=%v, found present=%v",
				spec.Object.Store, spec.Object.Key, spec.Object.Present, found,
			)
		}
	case spec.SearchHits != nil:
		actual := len(w.SearchQuery(spec.SearchHits.Instance, spec.SearchHits.Query))
		if actual != spec.SearchHits.Count {
			return fmt.Errorf(
				"expect.search_hits: instance=%q query=%q expected %d, got %d",
				spec.SearchHits.Instance, spec.SearchHits.Query, spec.SearchHits.Count, actual,
			)
		}
	case spec.HTTPCalls != nil:
		actual := w.HTTPRequestCount(spec.HTTPCalls.Instance)
		if actual != spec.HTTPCalls.Count {
			return fmt.Errorf(
				"expect.http_calls: instance=%q expected %d, got %d",
				spec.HTTPCalls.Instance, spec.HTTPCalls.Count, actual,
			)
		}
	default:
		return errors.New("sim_runner: unrecognized expect step")
	}
	return nil
}

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: sim_runner <scenario.json>")
		os.Exit(1)
	}
	raw, err := os.ReadFile(os.Args[1])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	var sc scenario
	if err := json.Unmarshal(raw, &sc); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	if sc.SimulationVersion != 1 {
		fmt.Fprintf(os.Stderr, "scenario simulation_version %d is not supported (expected 1)\n", sc.SimulationVersion)
		os.Exit(1)
	}
	if len(sc.Steps) == 0 {
		fmt.Fprintln(os.Stderr, "scenario has no steps")
		os.Exit(1)
	}

	failureRules, err := toFailureRules(sc.Given.Failures)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	w := world.New(failureRules, worldTables)

	startAt, err := time.Parse(time.RFC3339, sc.StartAt)
	if err != nil {
		fmt.Fprintf(os.Stderr, "scenario start_at %q: not a valid date\n", sc.StartAt)
		os.Exit(1)
	}
	nowMs := startAt.UnixMilli()
	if err := w.AdvanceClockTo(nowMs); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	for _, seed := range sc.Given.DB {
		key := world.NamespacedTableKey(seed.Service, seed.Table)
		for _, row := range seed.Rows {
			if err := w.SeedDB(key, row); err != nil {
				fmt.Fprintln(os.Stderr, err)
				os.Exit(1)
			}
		}
	}
	// Cache/store/search/external_http instances are not namespaced by
	// service (matching `ciac-backend-rust`'s own M6c system-runner
	// exactly): unlike a database table's physical name, which several
	// services may legitimately share, an instance name is assumed
	// distinct across the whole system already.
	for _, entry := range sc.Given.Cache {
		var ttlMs *int64
		if entry.TTL != nil {
			ms, err := parseDurationMs(*entry.TTL)
			if err != nil {
				fmt.Fprintln(os.Stderr, err)
				os.Exit(1)
			}
			ttlMs = &ms
		}
		w.CacheSet(entry.Instance, entry.Key, string(entry.Value), ttlMs)
	}
	for _, obj := range sc.Given.Store {
		body, err := base64.StdEncoding.DecodeString(obj.ValueBase64)
		if err != nil {
			fmt.Fprintln(os.Stderr, err)
			os.Exit(1)
		}
		w.ObjectPut(obj.Instance, obj.Key, body)
	}
	for _, doc := range sc.Given.Search {
		var decoded any
		if err := json.Unmarshal(doc.Doc, &decoded); err != nil {
			fmt.Fprintln(os.Stderr, err)
			os.Exit(1)
		}
		w.SearchIndex(doc.Instance, doc.ID, decoded)
	}
	for _, fixture := range sc.Given.ExternalHTTP {
		w.SeedHTTPFixtures(fixture.Instance, fixture.Responses)
	}

	// Constructs every service's own state/router *before* any scenario
	// step runs, and registers every api of every service on the shared
	// world's call router, in declaration order -- an api reachable
	// only via a routed `call <Service>.<Api>` from another service
	// (never the target of a scenario `request` step in its own right)
	// still needs an entry here or that call has no handler to route
	// to (mirrors the Python/Rust/TypeScript system-runners' own api-
	// registration loop).
	muxes := map[string]*http.ServeMux{}
	configIntake := Intake.FromEnv()
	stIntake := Intake.NewSimulation(configIntake, w)
	// stIntake may otherwise go unused (a service with no apis,
	// workers, or jobs of its own -- reachable only as a routed-call
	// target through another service's own client, or not reachable by
	// this scenario at all) -- keeping construction unconditional above
	// (matching every other service) is simpler than a second gate here.
	_ = stIntake
	muxIntake := Intake.Router(stIntake)
	muxes["Intake"] = muxIntake
	w.RegisterAPI("Intake", "SubmitOrder", func(req any) (any, error) {
		body, err := json.Marshal(req)
		if err != nil {
			return nil, err
		}
		status, parsed, err := doInject(muxIntake, "POST", "/orders", body, map[string]string{"Content-Type": "application/json"})
		if err != nil {
			return nil, err
		}
		if status >= 400 {
			return nil, fmt.Errorf("routed call to Intake.SubmitOrder failed with status %d: %v", status, parsed)
		}
		return parsed, nil
	})
	configBilling := Billing.FromEnv()
	stBilling := Billing.NewSimulation(configBilling, w)
	// stBilling may otherwise go unused (a service with no apis,
	// workers, or jobs of its own -- reachable only as a routed-call
	// target through another service's own client, or not reachable by
	// this scenario at all) -- keeping construction unconditional above
	// (matching every other service) is simpler than a second gate here.
	_ = stBilling
	muxBilling := Billing.Router(stBilling)
	muxes["Billing"] = muxBilling
	w.RegisterAPI("Billing", "Charge", func(req any) (any, error) {
		body, err := json.Marshal(req)
		if err != nil {
			return nil, err
		}
		status, parsed, err := doInject(muxBilling, "POST", "/charge", body, map[string]string{"Content-Type": "application/json"})
		if err != nil {
			return nil, err
		}
		if status >= 400 {
			return nil, fmt.Errorf("routed call to Billing.Charge failed with status %d: %v", status, parsed)
		}
		return parsed, nil
	})
	configFulfillment := Fulfillment.FromEnv()
	stFulfillment := Fulfillment.NewSimulation(configFulfillment, w)
	// stFulfillment may otherwise go unused (a service with no apis,
	// workers, or jobs of its own -- reachable only as a routed-call
	// target through another service's own client, or not reachable by
	// this scenario at all) -- keeping construction unconditional above
	// (matching every other service) is simpler than a second gate here.
	_ = stFulfillment

	// drain/advance are closures, not top-level functions, so they can
	// reach every service's own st<Suffix> built just above (and w)
	// directly -- Go has no way for a top-level function to see a
	// caller's local variables, unlike TypeScript's own system-runner,
	// which nests these same two functions inside main() for the
	// identical reason.
	//
	// drain hands every message currently undelivered to its worker's
	// own (subject, group) cursor on w's broker log into
	// HandleMessageOnce exactly once (with that worker's own retry
	// budget) -- same per-(subject, group) cursor semantics as every
	// other generated runner's own drain; a subject no registered
	// worker (in *any* service) drains is refused, not left to sit
	// undelivered forever.
	drain := func(workerAttempts map[string]int) error {
		for _, msg := range w.DrainBroker(Fulfillment.ShipSubject, Fulfillment.ShipQueueGroup) {
			var typedFulfillmentShip Fulfillment.Order
			if err := json.Unmarshal(msg, &typedFulfillmentShip); err != nil {
				return fmt.Errorf("sim_runner: decoding Fulfillment.Ship payload: %w", err)
			}
			var payloadFulfillmentShip any = typedFulfillmentShip
			attempts := 0
			var attemptErr error
			for attempt := 0; attempt <= Fulfillment.ShipMaxRetries; attempt++ {
				attempts++
				if attemptErr = Fulfillment.HandleMessageOnceShip(context.Background(), stFulfillment, payloadFulfillmentShip); attemptErr == nil {
					break
				}
			}
			if attemptErr != nil {
				fmt.Fprintf(os.Stderr, "sim_runner: Fulfillment.Ship exhausted retries: %v\n", attemptErr)
			}
			workerAttempts["Ship"] += attempts
		}
		_ = workerAttempts
		for _, msg := range w.DrainQueue() {
			delivered := false
			if msg.Subject == Fulfillment.ShipSubject {
				// Already drained via `w.DrainBroker` above.
				delivered = true
			}
			if !delivered {
				return fmt.Errorf("sim_runner: no worker registered to consume subject %q (disclosed scope)", msg.Subject)
			}
		}
		return nil
	}

	advance := func(fromMs, toMs int64, jobRuns map[string]int) error {
		if err := w.AdvanceClockTo(toMs); err != nil {
			return err
		}
		_ = fromMs
		_ = jobRuns
		return nil
	}

	saved := map[string]savedResponse{}
	workerAttempts := map[string]int{}
	jobRuns := map[string]int{}

	var runErr error
	for _, step := range sc.Steps {
		switch {
		case step.Request != nil:
			runErr = doRequest(muxes, w, *step.Request, saved)
		case step.Publish != nil:
			runErr = errors.New("sim_runner does not support `publish` steps (disclosed scope)")
		case step.Advance != nil:
			deltaMs, derr := parseDurationMs(step.Advance.By)
			if derr != nil {
				runErr = derr
			} else {
				toMs := nowMs + deltaMs
				runErr = advance(nowMs, toMs, jobRuns)
				nowMs = toMs
			}
		case step.Drain != nil:
			runErr = drain(workerAttempts)
		case step.Expect != nil:
			runErr = expect(*step.Expect, w, saved, workerAttempts, jobRuns)
		default:
			runErr = errors.New("sim_runner: unrecognized step")
		}
		if runErr != nil {
			break
		}
	}
	if runErr == nil {
		unmatched := w.UnmatchedFailureRules()
		if len(unmatched) > 0 {
			runErr = fmt.Errorf(
				"%d failure rule(s) declared in `given.failures` never matched a real occurrence: %v",
				len(unmatched), unmatched,
			)
		}
	}

	outcome := simScenarioOutcome{
		Scenario:       sc.Name,
		Passed:         runErr == nil,
		WorkerAttempts: workerAttempts,
		JobRuns:        jobRuns,
	}
	if runErr != nil {
		msg := runErr.Error()
		outcome.Error = &msg
	}
	out, err := json.Marshal(outcome)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	fmt.Println(string(out))
}
