services:

  intake:
    build: ./intake
    ports:
      - "8000:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      BILLING_URL: http://billing:8000
      NATS_URL: nats://queue:4222
    depends_on:
      queue:
        condition: service_started

  billing:
    build: ./billing
    ports:
      - "8001:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      DATABASE_URL: postgres://postgres:postgres@billing-db:5432/billing
    depends_on:
      billing-db:
        condition: service_healthy

  fulfillment:
    build: ./fulfillment
    ports:
      - "8002:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      DATABASE_URL: postgres://postgres:postgres@fulfillment-db:5432/fulfillment
      NATS_URL: nats://queue:4222
    depends_on:
      fulfillment-db:
        condition: service_healthy
      queue:
        condition: service_started

  fulfillment-workers:
    build: ./fulfillment
    command: ["/app/workers"]
    environment:
      DATABASE_URL: postgres://postgres:postgres@fulfillment-db:5432/fulfillment
      NATS_URL: nats://queue:4222
    depends_on:
      fulfillment-db:
        condition: service_healthy
      queue:
        condition: service_started

  billing-db:
    image: postgres:16
    ports:
      - "5432:5432"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: billing
    volumes:
      - billing-db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 2s
      timeout: 3s
      retries: 20

  fulfillment-db:
    image: postgres:16
    ports:
      - "5433:5432"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: fulfillment
    volumes:
      - fulfillment-db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 2s
      timeout: 3s
      retries: 20

  queue:
    image: nats:2
    # Host mapping (v0.13 M2): the generated tests/system delivery and
    # channel tests connect from the host at localhost:4222.
    ports:
      - "4222:4222"

volumes:
  billing-db-data:
  fulfillment-db-data:
