// Package world -- Generated by CIaC (sim builds only).
//
// 27UpdatePlan.md M7: a full Go restatement of ciac-sim's simulation
// world (crates/ciac-sim/src/world.rs) -- Go cannot vendor the Rust
// crate's source the way the Rust backend does via include_str!, so
// this is a from-scratch, self-contained port (Pillar 4's rule: a
// world template may depend on its language's standard library and
// the target's already-present runtime deps, and nothing else),
// following the same closure TypeScript's own restatement reached at
// v0.27 M6. Unlike Node/Python (single-threaded), a generated Go
// service's handlers can genuinely run on concurrent goroutines, so
// every mutable field below is guarded by one package-level mutex on
// World itself -- the same single-lock choice the v0.24 M9 narrow
// version already made, just now guarding a much larger surface.
//
// v0.24 M9's narrow scope (only db.insert and broker publish) is
// retired here: schema-aware relational writes (reference/unique/
// cascade checking), a group-aware broker log, a virtual clock, and
// every peripheral fake (cache/object store/email/search/http/auth)
// are ported, matching Python's/Rust's/TypeScript's own coverage.
// Generated by CIaC for any program with something this world can
// fake (db, queue, cache, object_store, email, search, external_http,
// or auth), mirroring the Rust/TypeScript backends' own world
// emission gate.
package world

import (
	"encoding/json"
	"errors"
	"fmt"
	"sort"
	"strings"
	"sync"
)

// -- Failure engine (unchanged in shape from the v0.24 M9 narrow
// version): the `error`-action-only, occurrence-counted subset of
// ciac_sim::failure's full vocabulary this restatement implements --
// the same disclosed scope Python's/Rust's/TypeScript's own
// restatements hold to (the checked-in corpus needs nothing more). --

type FailureRule struct {
	Effect     string
	Subject    string // "" stands for an absent/nil subject.
	Occurrence int
}

type failureEngine struct {
	mu      sync.Mutex
	rules   map[string]struct{}
	matched map[string]struct{}
	counts  map[string]int
}

func newFailureEngine(rules []FailureRule) *failureEngine {
	fe := &failureEngine{
		rules:   make(map[string]struct{}, len(rules)),
		matched: make(map[string]struct{}, len(rules)),
		counts:  make(map[string]int),
	}
	for _, r := range rules {
		fe.rules[ruleKey(r.Effect, r.Subject, r.Occurrence)] = struct{}{}
	}
	return fe
}

func countKey(effect, subject string) string {
	return effect + " " + subject
}

func ruleKey(effect, subject string, occurrence int) string {
	return fmt.Sprintf("%s %d", countKey(effect, subject), occurrence)
}

func (fe *failureEngine) shouldFail(effect, subject string) bool {
	fe.mu.Lock()
	defer fe.mu.Unlock()
	ck := countKey(effect, subject)
	fe.counts[ck]++
	key := ruleKey(effect, subject, fe.counts[ck])
	if _, ok := fe.rules[key]; ok {
		fe.matched[key] = struct{}{}
		return true
	}
	return false
}

// unmatchedRules returns the failure rules a scenario declared that
// never matched a real occurrence -- surfaced to the runner rather
// than silently ignored, matching SIM0007's disclosure discipline.
func (fe *failureEngine) unmatchedRules() []string {
	fe.mu.Lock()
	defer fe.mu.Unlock()
	out := make([]string, 0, len(fe.rules)-len(fe.matched))
	for k := range fe.rules {
		if _, ok := fe.matched[k]; !ok {
			out = append(out, k)
		}
	}
	sort.Strings(out)
	return out
}

// -- Relational schema: schema-aware reference/uniqueness/cascade
// checking, the TypeScript/Rust counterpart to
// ciac_sim::world::RelationalSchema. --

// WorldRefAction is `on_delete`'s two shapes.
type WorldRefAction string

const (
	RestrictOnDelete WorldRefAction = "restrict"
	CascadeOnDelete  WorldRefAction = "cascade"
)

// WorldReference is one outgoing reference field, as a schema-aware
// store needs it. sim_runner.go's own main() builds these as literal
// slice/struct literals at codegen time, since this package has no
// SimPlan JSON to load at runtime.
type WorldReference struct {
	FieldName   string
	TargetTable string // "" stands for no target table.
	OnDelete    WorldRefAction
	Unique      bool
}

// WorldTable is one table's worth of schema facts a schema-aware
// store needs -- just its own outgoing references.
type WorldTable struct {
	Name       string
	References []WorldReference
}

type incomingRef struct {
	table string
	ref   WorldReference
}

// relationalSchema is table name -> its own outgoing reference
// fields, plus the reverse index dbDeleteChecked's plan-then-apply
// needs to find restrict/cascade candidates.
type relationalSchema struct {
	outgoing map[string][]WorldReference
}

func newRelationalSchema(tables []WorldTable) *relationalSchema {
	m := make(map[string][]WorldReference, len(tables))
	for _, t := range tables {
		m[t.Name] = t.References
	}
	return &relationalSchema{outgoing: m}
}

func (s *relationalSchema) outgoingOf(table string) []WorldReference {
	return s.outgoing[table]
}

// incomingOf returns every [referencingTable, reference] whose
// reference targets targetTable, sorted by referencing table name so
// cascade order stays deterministic across runs -- Go map iteration
// order is randomized, unlike a Rust `Vec` scan or a TS `Map`'s
// insertion-order iteration, so this needs an explicit sort where
// those targets don't.
func (s *relationalSchema) incomingOf(targetTable string) []incomingRef {
	var out []incomingRef
	for table, refs := range s.outgoing {
		for _, ref := range refs {
			if ref.TargetTable == targetTable {
				out = append(out, incomingRef{table: table, ref: ref})
			}
		}
	}
	sort.Slice(out, func(i, j int) bool {
		if out[i].table != out[j].table {
			return out[i].table < out[j].table
		}
		return out[i].ref.FieldName < out[j].ref.FieldName
	})
	return out
}

// Row is an in-memory record, decoded from JSON -- every world-guarded
// db verb's row shape, the Go counterpart to Rust's serde_json::Value/
// TypeScript's plain Row object. Every field value is whatever
// encoding/json produced (float64 for numbers, string, bool, nil, a
// nested map/slice), which is why comparisons below (Eq/Lt/...) work
// generically across the concrete Go types production code passes in
// (int64, float64, a named enum string type, time.Time, ...) without
// this package needing to know any of them by name: everything is
// compared after a JSON round-trip, not by Go static type.
type Row = map[string]any

func rowID(row Row) (string, bool) {
	v, ok := row["id"]
	if !ok {
		return "", false
	}
	s, ok := v.(string)
	return s, ok
}

// toRow converts any value production code passes to a world-guarded
// write leaf (a concrete schemas.<Record> struct, or already a Row
// from a scenario's own `given.db` seed) into a Row via a JSON round-
// trip -- the one conversion every write path uses, so every row this
// package stores has the exact same representation regardless of
// where it came from.
func toRow(v any) (Row, error) {
	b, err := json.Marshal(v)
	if err != nil {
		return nil, fmt.Errorf("world: marshaling value into a row: %w", err)
	}
	var row Row
	if err := json.Unmarshal(b, &row); err != nil {
		return nil, fmt.Errorf("world: unmarshaling row: %w", err)
	}
	return row, nil
}

// intoValue JSON-round-trips row into dest (a pointer to a concrete
// schemas.<Record> struct) -- the inverse of toRow, used by every
// world-guarded read leaf to hand production code the exact struct
// type it expects instead of a bare Row.
func intoValue(row Row, dest any) error {
	b, err := json.Marshal(row)
	if err != nil {
		return fmt.Errorf("world: marshaling row: %w", err)
	}
	if err := json.Unmarshal(b, dest); err != nil {
		return fmt.Errorf("world: unmarshaling row into destination: %w", err)
	}
	return nil
}

// -- Predicate comparison helpers: `db.query`/`count`/`delete_where`'s
// `where` clause compiles (at codegen time, in lower.rs) into a Go
// closure over these functions, mirroring Rust's own
// world_predicate_term_expr, which compiles into a Rust boolean
// expression over serde_json::Value comparisons for the identical
// reason -- SimWorld's own find-by-filter only ever supported
// equality. JSONEq compares by marshaled JSON text rather than Go
// `==`/reflect.DeepEqual, so an int64 production value and the
// float64 JSON unmarshal produced for the same row compare equal
// without this package needing to know which numeric Go type it
// started as. --

// JSONEq reports whether a and b marshal to the same JSON text.
func JSONEq(a, b any) bool {
	ab, aerr := json.Marshal(a)
	bb, berr := json.Marshal(b)
	return aerr == nil && berr == nil && string(ab) == string(bb)
}

// Contains reports whether a and b are both strings and a contains b.
func Contains(a, b any) bool {
	as, aok := a.(string)
	bs, bok := b.(string)
	return aok && bok && strings.Contains(as, bs)
}

// compare orders a and b when both are float64 or both are string
// (the two JSON-comparable ordered types a predicate's Lt/LtEq/Gt/
// GtEq ever compares -- Int/Float fields decode to float64, Str/Uuid/
// Timestamp fields to string, the latter ordering correctly as plain
// strings since RFC3339 timestamps are lexicographically sortable).
// ok is false for any other pairing (a genuinely incomparable
// predicate term, e.g. against a missing field), matching Rust's own
// `.unwrap_or(false)` fallback.
func compare(a, b any) (cmp int, ok bool) {
	switch av := a.(type) {
	case float64:
		bv, isFloat := b.(float64)
		if !isFloat {
			return 0, false
		}
		switch {
		case av < bv:
			return -1, true
		case av > bv:
			return 1, true
		default:
			return 0, true
		}
	case string:
		bv, isStr := b.(string)
		if !isStr {
			return 0, false
		}
		switch {
		case av < bv:
			return -1, true
		case av > bv:
			return 1, true
		default:
			return 0, true
		}
	default:
		return 0, false
	}
}

func Lt(a, b any) bool   { c, ok := compare(a, b); return ok && c < 0 }
func LtEq(a, b any) bool { c, ok := compare(a, b); return ok && c <= 0 }
func Gt(a, b any) bool   { c, ok := compare(a, b); return ok && c > 0 }
func GtEq(a, b any) bool { c, ok := compare(a, b); return ok && c >= 0 }

// -- FakeDatabase: an in-memory table store keyed by table name, rows
// as Row. No constraints, no cascades, no indexes on its own -- World
// layers those on top via relationalSchema, the same split
// ciac_sim::world::FakeDatabase/SimWorld hold. --

type fakeDatabase struct {
	tables map[string][]Row
}

func newFakeDatabase() *fakeDatabase {
	return &fakeDatabase{tables: make(map[string][]Row)}
}

func (d *fakeDatabase) insert(table string, row Row) {
	d.tables[table] = append(d.tables[table], row)
}

// findWhere returns rows in table matching every key/value pair in
// filter (an empty filter matches every row) -- sim_runner's own
// expect.row check, not something generated handler code calls
// directly (query/count/delete_where's own world branches build their
// own predicate closure instead -- see queryWhere).
func (d *fakeDatabase) findWhere(table string, filter map[string]any) []Row {
	out := make([]Row, 0)
	for _, row := range d.tables[table] {
		matches := true
		for k, v := range filter {
			if !JSONEq(row[k], v) {
				matches = false
				break
			}
		}
		if matches {
			out = append(out, row)
		}
	}
	return out
}

// queryWhere returns rows in table for which pred returns true (a nil
// pred matches every row) -- the world-guarded counterpart to a real
// `SELECT ... WHERE ...`.
func (d *fakeDatabase) queryWhere(table string, pred func(Row) bool) []Row {
	out := make([]Row, 0)
	for _, row := range d.tables[table] {
		if pred == nil || pred(row) {
			out = append(out, row)
		}
	}
	return out
}

// get is a by-id lookup -- (nil, false) if no row has that key,
// matching production db.get's own "found or absent" shape.
func (d *fakeDatabase) get(table, pk string) (Row, bool) {
	for _, row := range d.tables[table] {
		if id, ok := rowID(row); ok && id == pk {
			return row, true
		}
	}
	return nil, false
}

// delete is unconditional removal by id -- true if a row was actually
// removed. No reference/cascade checking here; that is World's own
// dbDeleteChecked's job, one layer up, since it needs the schema this
// plain store doesn't carry.
func (d *fakeDatabase) delete(table, pk string) bool {
	rows := d.tables[table]
	kept := make([]Row, 0, len(rows))
	removed := false
	for _, row := range rows {
		if id, ok := rowID(row); ok && id == pk {
			removed = true
			continue
		}
		kept = append(kept, row)
	}
	d.tables[table] = kept
	return removed
}

// replace is a full-record replace by id -- matching production
// db.update's real shape (UPDATE <table> SET <every column> WHERE id
// = <pk>, not an attribute patch). true if a row with that id existed
// to replace.
func (d *fakeDatabase) replace(table, pk string, record Row) bool {
	rows := d.tables[table]
	for i, row := range rows {
		if id, ok := rowID(row); ok && id == pk {
			rows[i] = record
			return true
		}
	}
	return false
}

// snapshot is a full clone of every table -- the scratch overlay
// World's schema-aware checked operations validate a prospective
// write against before touching the real store, mirroring Python's
// own commit_batch's overlay-of-tables approach.
func (d *fakeDatabase) snapshot() map[string][]Row {
	out := make(map[string][]Row, len(d.tables))
	for table, rows := range d.tables {
		cp := make([]Row, len(rows))
		copy(cp, rows)
		out[table] = cp
	}
	return out
}

// validateWrite is a prospective write's reference/uniqueness check
// against overlay (the live store, or a batch's in-progress scratch
// copy) rather than the real store directly, so a multi-op batch sees
// its own earlier ops' effects. selfPK is the row's own id for an
// update (excluded from both the primary-key collision check and the
// unique-reference check), "" for an insert. Returns the first
// violation found as an error, nil otherwise -- the Go counterpart to
// SimWorld::validate_write.
func validateWrite(schema *relationalSchema, overlay map[string][]Row, table string, row Row, selfPK string) error {
	if selfPK == "" {
		if pk, ok := rowID(row); ok {
			for _, r := range overlay[table] {
				if id, ok := rowID(r); ok && id == pk {
					return fmt.Errorf("%s.id = %q is not unique", table, pk)
				}
			}
		}
	}
	for _, field := range schema.outgoingOf(table) {
		targetID, ok := row[field.FieldName].(string)
		if !ok || field.TargetTable == "" {
			continue
		}
		targetExists := false
		for _, r := range overlay[field.TargetTable] {
			if id, ok := rowID(r); ok && id == targetID {
				targetExists = true
				break
			}
		}
		if !targetExists {
			return fmt.Errorf("%s.%s references %s/%s, which does not exist", table, field.FieldName, field.TargetTable, targetID)
		}
		if field.Unique {
			for _, r := range overlay[table] {
				id, hasID := rowID(r)
				if v, ok := r[field.FieldName].(string); ok && v == targetID && (!hasID || id != selfPK) {
					return fmt.Errorf("%s.%s = %q is not unique", table, field.FieldName, targetID)
				}
			}
		}
	}
	return nil
}

type deletePlanStep struct {
	table string
	pk    string
}

// planDelete returns every [referencingTable, pk] a delete of
// table/pk would cascade into, recursively -- errors if a restrict
// reference blocks it. Read-only against overlay; the caller applies
// the result. The Go counterpart to SimWorld::plan_delete.
func planDelete(schema *relationalSchema, overlay map[string][]Row, table, pk string) ([]deletePlanStep, error) {
	var planned []deletePlanStep
	for _, in := range schema.incomingOf(table) {
		var dependents []string
		for _, row := range overlay[in.table] {
			if v, ok := row[in.ref.FieldName].(string); ok && v == pk {
				if id, ok := rowID(row); ok {
					dependents = append(dependents, id)
				}
			}
		}
		if len(dependents) == 0 {
			continue
		}
		if in.ref.OnDelete == RestrictOnDelete {
			return nil, fmt.Errorf("cannot delete %s/%s: restricted by %s.%s", table, pk, in.table, in.ref.FieldName)
		}
		for _, depPK := range dependents {
			planned = append(planned, deletePlanStep{table: in.table, pk: depPK})
			cascaded, err := planDelete(schema, overlay, in.table, depPK)
			if err != nil {
				return nil, err
			}
			planned = append(planned, cascaded...)
		}
	}
	return planned, nil
}

// -- BatchOp: one operation in an atomic CommitBatchChecked call --
// the transaction leaf's own accumulation shape: inner db verbs
// inside a `transaction {}` block accumulate into a batch rather than
// hitting their own World calls individually. Deliberately does not
// auto-expand cascades on delete -- that is DBDeleteChecked's own job
// as a single, immediate, plan-then-apply call. --

type BatchOp struct {
	Kind  string // "insert" | "update" | "delete"
	Table string
	PK    string // update/delete only.
	Row   Row    // insert/update only.
}

// -- FakeQueue: every publish, in arrival order -- the runner drains
// these directly for the orphan-subject detection sweep; there is no
// running subscription loop. Transitional alongside brokerLog
// (PublishChecked writes into both). --

type QueuedMessage struct {
	Subject string
	Payload []byte
}

type fakeQueue struct {
	published []QueuedMessage
}

func (q *fakeQueue) publish(subject string, payload []byte) {
	q.published = append(q.published, QueuedMessage{Subject: subject, Payload: payload})
}

func (q *fakeQueue) takeAll() []QueuedMessage {
	out := q.published
	q.published = nil
	return out
}

func (q *fakeQueue) isEmpty() bool {
	return len(q.published) == 0
}

// -- brokerLog: 27UpdatePlan.md M7 (Pillar 2): one ordered log per
// subject; every consumer *group* holds its own independent cursor
// into that log -- two groups on one subject each see every message
// (fan-out), two workers sharing one group share its cursor (queue-
// group semantics). Only Ack advances a cursor; Nack is an explicit
// no-op -- the message is redelivered on the next Drain of that same
// (subject, group) iff it was never acked. Mirrors
// ciac_sim::world::BrokerLog/TypeScript's own BrokerLog exactly. --

type brokerLog struct {
	logs    map[string][][]byte
	cursors map[string]int
}

func newBrokerLog() *brokerLog {
	return &brokerLog{logs: make(map[string][][]byte), cursors: make(map[string]int)}
}

func cursorKey(subject, group string) string {
	return subject + " " + group
}

func (b *brokerLog) publish(subject string, payload []byte) {
	b.logs[subject] = append(b.logs[subject], payload)
}

// Drain returns every unconsumed message for (subject, group), in log
// order, each individually acked as it is collected.
func (b *brokerLog) drain(subject, group string) [][]byte {
	var out [][]byte
	key := cursorKey(subject, group)
	pos := b.cursors[key]
	log := b.logs[subject]
	for pos < len(log) {
		out = append(out, log[pos])
		pos++
	}
	b.cursors[key] = pos
	return out
}

// queuesEmpty is true iff every cursor this broker has ever been
// asked about is caught up to its subject's current log head.
func (b *brokerLog) queuesEmpty() bool {
	for key, pos := range b.cursors {
		subject := key[:strings.IndexByte(key, ' ')]
		if pos < len(b.logs[subject]) {
			return false
		}
	}
	return true
}

// -- Cache-aside fake, TTL measured against World's own virtual
// clock (never wall time). One per declared `cache <Provider>`
// instance name, lazily created on first access. --

type fakeCache struct {
	values   map[string]string
	expireAt map[string]int64
}

func newFakeCache() *fakeCache {
	return &fakeCache{values: make(map[string]string), expireAt: make(map[string]int64)}
}

func (c *fakeCache) get(key string, nowMs int64) (string, bool) {
	if expireAt, ok := c.expireAt[key]; ok && nowMs >= expireAt {
		delete(c.values, key)
		delete(c.expireAt, key)
		return "", false
	}
	v, ok := c.values[key]
	return v, ok
}

func (c *fakeCache) set(key, value string, ttlMs *int64, nowMs int64) {
	c.values[key] = value
	if ttlMs != nil {
		c.expireAt[key] = nowMs + *ttlMs
	} else {
		delete(c.expireAt, key)
	}
}

func (c *fakeCache) delete(key string) {
	delete(c.values, key)
	delete(c.expireAt, key)
}

// -- Enough of an S3/MinIO-shaped object store's interface
// (put/get/delete/list) for object_store.* verbs -- an in-memory
// key/bytes map. --

type fakeObjectStore struct {
	objects map[string][]byte
}

func newFakeObjectStore() *fakeObjectStore {
	return &fakeObjectStore{objects: make(map[string][]byte)}
}

func (s *fakeObjectStore) put(key string, body []byte) {
	s.objects[key] = body
}

func (s *fakeObjectStore) get(key string) ([]byte, bool) {
	v, ok := s.objects[key]
	return v, ok
}

func (s *fakeObjectStore) delete(key string) {
	delete(s.objects, key)
}

func (s *fakeObjectStore) list(prefix string) []string {
	out := make([]string, 0)
	for k := range s.objects {
		if strings.HasPrefix(k, prefix) {
			out = append(out, k)
		}
	}
	sort.Strings(out)
	return out
}

// -- email.send, recording sent messages instead of talking SMTP. --

type sentEmail struct {
	to      string
	subject string
	body    string
}

type fakeEmail struct {
	sent []sentEmail
}

func (e *fakeEmail) send(to, subject, body string) {
	e.sent = append(e.sent, sentEmail{to: to, subject: subject, body: body})
}

// -- search.index/search.query/search.delete -- an in-memory
// index/docId/document map with the same narrow, disclosed query
// evaluator Python's FakeSearch uses: case-insensitive substring
// match over each document's JSON, matching the shape search.query
// actually lowers to, not a real query language. --

type fakeSearch struct {
	docs map[string]any
	// order preserves insertion order for a deterministic query()
	// result -- a plain Go map has no iteration order guarantee.
	order []string
}

func newFakeSearch() *fakeSearch {
	return &fakeSearch{docs: make(map[string]any)}
}

func (s *fakeSearch) index(docID string, document any) {
	if _, exists := s.docs[docID]; !exists {
		s.order = append(s.order, docID)
	}
	s.docs[docID] = document
}

func (s *fakeSearch) query(text string) []any {
	needle := strings.ToLower(text)
	out := make([]any, 0)
	for _, id := range s.order {
		doc, ok := s.docs[id]
		if !ok {
			continue
		}
		if needle == "" {
			out = append(out, doc)
			continue
		}
		b, err := json.Marshal(doc)
		if err == nil && strings.Contains(strings.ToLower(string(b)), needle) {
			out = append(out, doc)
		}
	}
	return out
}

func (s *fakeSearch) delete(docID string) {
	if _, exists := s.docs[docID]; exists {
		delete(s.docs, docID)
		for i, id := range s.order {
			if id == docID {
				s.order = append(s.order[:i], s.order[i+1:]...)
				break
			}
		}
	}
}

// -- A fixture-driven stand-in for an external HTTP client, consuming
// `given.external_http` fixtures in order -- the same portable-
// scenario fixtures a scenario already carries drive this fake
// directly, not a second ad hoc format. --

// GivenHTTPResponse is one configured fixture response -- either an
// injected failure (Error set) or a real status/json response,
// matching the scenario JSON's own `{"error": ..}` vs.
// `{"status": .., "json": ..}` shape (the Go counterpart to
// TypeScript's `GivenHttpResponse` union).
type GivenHTTPResponse struct {
	Error  *string `json:"error,omitempty"`
	Status int     `json:"status,omitempty"`
	JSON   any     `json:"json,omitempty"`
}

type fakeHTTPClient struct {
	responses []GivenHTTPResponse
	next      int
	requests  []struct {
		url  string
		json any
	}
}

func (c *fakeHTTPClient) setFixtures(responses []GivenHTTPResponse) {
	c.responses = responses
	c.next = 0
}

func (c *fakeHTTPClient) post(url string, jsonBody any) (any, error) {
	c.requests = append(c.requests, struct {
		url  string
		json any
	}{url: url, json: jsonBody})
	if c.next >= len(c.responses) {
		return nil, fmt.Errorf("no fixture response configured for external_http call #%d to %q", c.next+1, url)
	}
	resp := c.responses[c.next]
	c.next++
	if resp.Error != nil {
		return nil, fmt.Errorf("simulated external_http failure: %s", *resp.Error)
	}
	return resp.JSON, nil
}

// -- Verifies a bearer token by direct lookup against claims the
// runner configured ahead of time, instead of real JWT/JWKS crypto --
// the disclosed simplification Python's own FakeAuth already uses:
// rather than faking the JWKS HTTP round-trip, this bypasses JWT/JWKS
// verification entirely while keeping scope enforcement real.
// Singular (unlike cache/store/email/search/http): one identity
// provider per world, not per-instance. --

type authEntry struct {
	claims   any
	expireAt *int64
}

type fakeAuth struct {
	tokens map[string]authEntry
}

func newFakeAuth() *fakeAuth {
	return &fakeAuth{tokens: make(map[string]authEntry)}
}

func (a *fakeAuth) issue(token string, claims any, expireAtMs *int64) {
	a.tokens[token] = authEntry{claims: claims, expireAt: expireAtMs}
}

func (a *fakeAuth) verify(token string, nowMs int64) (any, error) {
	entry, ok := a.tokens[token]
	if !ok {
		return nil, fmt.Errorf("no configured claims for bearer token %q", token)
	}
	if entry.expireAt != nil && nowMs >= *entry.expireAt {
		return nil, fmt.Errorf("bearer token %q has expired", token)
	}
	return entry.claims, nil
}

// -- Call router: 28UpdatePlan.md M7c -- routes a `call <Service>.<Api>`
// step to a registered handler instead of real HTTP, the Go
// counterpart to ciac-sim's world.rs `register_api`/`call_checked`
// (28's M2) and TypeScript's own M7a `registerApi`/`callChecked`. Go's
// handler chain is naturally synchronous (unlike Rust, which needs a
// `block_on_ready` bridge because a registered handler there must stay
// callable from sync code while production handlers are async), so a
// registered handler here is just a plain function -- no bridge of any
// kind is needed. --

// ApiHandler is one registered api's logic, at the same JSON boundary
// every other fake (fakeHTTPClient.post, most directly) already
// crosses: this package has no knowledge of any particular `.ciac`
// program's typed request/response shapes, so a handler is exactly the
// bridge a world-guarded call-client method builds around the real
// (fake-world-routed) handler logic.
type ApiHandler func(req any) (any, error)

type apiKey struct {
	service string
	api     string
}

// maxCallDepth is the routed-call recursion depth CallChecked refuses
// past -- generous relative to any real `.ciac` call chain (`ciac-sema`'s
// own cycle detection already refuses a call cycle at compile time), tight
// enough to fail long before it would risk a real stack overflow.
const maxCallDepth = 64

// getOrCreate is the shared per-instance lazy-construction pattern
// every peripheral fake's map (caches/objectStores/emails/searches/
// httpClients) below uses -- Go generics' counterpart to TypeScript's
// own `mapOf` helper.
func getOrCreate[T any](store map[string]*T, instance string, factory func() *T) *T {
	entry, ok := store[instance]
	if !ok {
		entry = factory()
		store[instance] = entry
	}
	return entry
}

// World is the simulation adapter state.AppState's World field holds
// (v0.24 M9, full parity 27UpdatePlan.md M7) -- one instance per
// running scenario. state.go.j2's AppState.World field and every
// world-guarded HostSyntax leaf are the only places generated code
// reaches into this.
type World struct {
	mu sync.Mutex

	db       *fakeDatabase
	queue    *fakeQueue
	broker   *brokerLog
	schema   *relationalSchema
	failures *failureEngine
	nowMsVal int64

	caches       map[string]*fakeCache
	objectStores map[string]*fakeObjectStore
	emails       map[string]*fakeEmail
	searches     map[string]*fakeSearch
	httpClients  map[string]*fakeHTTPClient
	auth         *fakeAuth

	// 28UpdatePlan.md M7c: the call-router's own bookkeeping -- see
	// RegisterAPI/CallChecked below.
	apis      map[apiKey]ApiHandler
	callDepth int

	// 27UpdatePlan.md M7: the `transaction {}` leaf's own atomicity
	// seam, the same ambient-batch-mode design TypeScript's own M6
	// restatement introduced for the identical reason: Go, like
	// TypeScript, renders a handler body's statements once
	// (Orientation::Statement) -- there is no second, world-only
	// render pass the way Rust's Orientation::Expression gives
	// `transaction {}` to switch codegen-time between "call World
	// directly" and "push onto an explicit BatchOp accumulator" (see
	// Rust's own `self.batching: Cell<bool>`). While pendingBatch is
	// non-nil, DBInsertChecked/DBUpdateChecked/DBDeleteChecked queue
	// an op instead of validating and applying immediately;
	// CommitWorldBatch (called by the generated transaction wrapper's
	// own `st.World.CommitWorldBatch()`) validates and applies the
	// whole queue atomically via CommitBatchChecked, same as Rust's
	// explicit accumulator. Unlike TypeScript, a Go transaction block
	// under *production* already uses a real `*sql.Tx` (26UpdatePlan.md
	// M1) -- this field only ever matters on the simulation branch.
	pendingBatch []BatchOp
}

// New builds a World seeded with failureRules and tables (the schema
// facts sim_runner.go's own main() computes at codegen time from the
// same source the migration DDL itself is built from).
func New(failureRules []FailureRule, tables []WorldTable) *World {
	return &World{
		db:           newFakeDatabase(),
		queue:        &fakeQueue{},
		broker:       newBrokerLog(),
		schema:       newRelationalSchema(tables),
		failures:     newFailureEngine(failureRules),
		caches:       make(map[string]*fakeCache),
		objectStores: make(map[string]*fakeObjectStore),
		emails:       make(map[string]*fakeEmail),
		searches:     make(map[string]*fakeSearch),
		httpClients:  make(map[string]*fakeHTTPClient),
		auth:         newFakeAuth(),
		apis:         make(map[apiKey]ApiHandler),
		// Start-at-zero clock: sim_runner.go's own main() immediately
		// syncs this to `scenario.start_at` before any TTL-bearing
		// seed reads NowMs() -- mirroring Rust's/TypeScript's own
		// ordering exactly.
		nowMsVal: 0,
	}
}

func (w *World) shouldFail(effect, subject string) bool {
	return w.failures.shouldFail(effect, subject)
}

// DBInsertChecked is db.commit's failure check, schema-aware
// reference/uniqueness validation, then the actual (fake) write --
// mirroring Python's `_FakeSession.commit()`. row is JSON-round-
// tripped internally (toRow) rather than requiring every call site to
// build its own Row.
func (w *World) DBInsertChecked(table string, row any) error {
	w.mu.Lock()
	defer w.mu.Unlock()
	r, err := toRow(row)
	if err != nil {
		return err
	}
	if w.pendingBatch != nil {
		w.pendingBatch = append(w.pendingBatch, BatchOp{Kind: "insert", Table: table, Row: r})
		return nil
	}
	if w.shouldFail("db.commit", table) {
		return errors.New("simulated db.commit failure (injected by FailureEngine)")
	}
	overlay := w.db.snapshot()
	if err := validateWrite(w.schema, overlay, table, r, ""); err != nil {
		return err
	}
	w.db.insert(table, r)
	return nil
}

// SeedDB inserts row into table with no failure check -- a scenario's
// `given.db` seeding, not a simulated db.insert call.
func (w *World) SeedDB(table string, row json.RawMessage) error {
	w.mu.Lock()
	defer w.mu.Unlock()
	var r Row
	if err := json.Unmarshal(row, &r); err != nil {
		return err
	}
	w.db.insert(table, r)
	return nil
}

// FindWhere returns table's rows matching every key/value pair in
// filter (an empty filter matches every row) -- sim_runner's own
// expect.row check, not something generated handler code calls.
func (w *World) FindWhere(table string, filter map[string]any) []Row {
	w.mu.Lock()
	defer w.mu.Unlock()
	return w.db.findWhere(table, filter)
}

// DBGet is a by-id lookup, JSON-round-tripped into dest (a pointer to
// a concrete schemas.<Record> struct) -- false if no row with that id
// exists, matching production db.get's own "found or absent" shape.
func (w *World) DBGet(table, pk string, dest any) (bool, error) {
	w.mu.Lock()
	row, ok := w.db.get(table, pk)
	w.mu.Unlock()
	if !ok {
		return false, nil
	}
	if err := intoValue(row, dest); err != nil {
		return false, err
	}
	return true, nil
}

// DBQuery returns every row in table for which pred returns true
// (nil pred matches every row), JSON-round-tripped into a newly
// allocated slice of the concrete element type dest points at (a
// pointer to a `[]schemas.<Record>`).
func (w *World) DBQuery(table string, pred func(Row) bool, dest any) error {
	w.mu.Lock()
	rows := w.db.queryWhere(table, pred)
	w.mu.Unlock()
	b, err := json.Marshal(rows)
	if err != nil {
		return err
	}
	return json.Unmarshal(b, dest)
}

// DBCount is DBQuery's own row count, without paying for the JSON
// round-trip into concrete structs a full DBQuery needs.
func (w *World) DBCount(table string, pred func(Row) bool) int64 {
	w.mu.Lock()
	defer w.mu.Unlock()
	return int64(len(w.db.queryWhere(table, pred)))
}

// DBMatchingIDs returns the `id` field of every row in table for
// which pred returns true -- db.delete_where's own world branch
// resolves matching rows this way before deleting each individually
// through DBDeleteChecked (real cascade/restrict handling, real
// failure-injection), a disclosed divergence from production's single
// bulk DELETE, mirroring Rust's/TypeScript's own query_tail world
// branch exactly.
func (w *World) DBMatchingIDs(table string, pred func(Row) bool) []string {
	w.mu.Lock()
	defer w.mu.Unlock()
	rows := w.db.queryWhere(table, pred)
	ids := make([]string, 0, len(rows))
	for _, row := range rows {
		if id, ok := rowID(row); ok {
			ids = append(ids, id)
		}
	}
	return ids
}

// DBUpdateChecked is a full-record replace by id, matching production
// db.update's own shape -- (nil, false, nil) if no row with that id
// exists, exactly like production's "0 rows affected" case, not an
// error. record is JSON-round-tripped into dest (a pointer to a
// concrete schemas.<Record> struct) on success.
func (w *World) DBUpdateChecked(table, pk string, record any, dest any) (bool, error) {
	w.mu.Lock()
	defer w.mu.Unlock()
	r, err := toRow(record)
	if err != nil {
		return false, err
	}
	if w.pendingBatch != nil {
		w.pendingBatch = append(w.pendingBatch, BatchOp{Kind: "update", Table: table, PK: pk, Row: r})
		// Optimistic, matching Rust's/TypeScript's own batching
		// branch: the actual "did a row with this id exist" outcome
		// isn't known until the batch commits.
		if err := intoValue(r, dest); err != nil {
			return false, err
		}
		return true, nil
	}
	if w.shouldFail("db.commit", table) {
		return false, errors.New("simulated db.commit failure (injected by FailureEngine)")
	}
	if _, ok := w.db.get(table, pk); !ok {
		return false, nil
	}
	overlay := w.db.snapshot()
	if err := validateWrite(w.schema, overlay, table, r, pk); err != nil {
		return false, err
	}
	w.db.replace(table, pk, r)
	if err := intoValue(r, dest); err != nil {
		return false, err
	}
	return true, nil
}

// DBDeleteChecked deletes by id, resolving cascade/restrict
// references first via a plan-then-apply pass -- false if no row
// with that id exists; a restricted delete errors, since a real
// database would refuse the same delete with a foreign-key
// violation.
func (w *World) DBDeleteChecked(table, pk string) (bool, error) {
	w.mu.Lock()
	defer w.mu.Unlock()
	if w.pendingBatch != nil {
		w.pendingBatch = append(w.pendingBatch, BatchOp{Kind: "delete", Table: table, PK: pk})
		// Optimistic, matching Rust's/TypeScript's own batching branch.
		return true, nil
	}
	if w.shouldFail("db.commit", table) {
		return false, errors.New("simulated db.commit failure (injected by FailureEngine)")
	}
	if _, ok := w.db.get(table, pk); !ok {
		return false, nil
	}
	overlay := w.db.snapshot()
	cascaded, err := planDelete(w.schema, overlay, table, pk)
	if err != nil {
		return false, err
	}
	w.db.delete(table, pk)
	for _, step := range cascaded {
		w.db.delete(step.table, step.pk)
	}
	return true, nil
}

// BeginWorldBatch starts ambient batch mode -- every
// DBInsertChecked/DBUpdateChecked/DBDeleteChecked call until the
// matching CommitWorldBatch/RollbackWorldBatch queues instead of
// applying. Called by a generated `transaction {}` block's world
// branch.
func (w *World) BeginWorldBatch() {
	w.mu.Lock()
	defer w.mu.Unlock()
	w.pendingBatch = []BatchOp{}
}

// CommitWorldBatch validates and applies every op queued since
// BeginWorldBatch atomically, via CommitBatchChecked -- same overlay-
// then-apply discipline, just gathered ambiently instead of passed as
// an explicit list. Returns an error (leaving the real store
// untouched) on the first violation found, exactly like
// CommitBatchChecked itself.
func (w *World) CommitWorldBatch() error {
	w.mu.Lock()
	ops := w.pendingBatch
	w.pendingBatch = nil
	w.mu.Unlock()
	_, err := w.CommitBatchChecked(ops)
	return err
}

// RollbackWorldBatch discards every op queued since BeginWorldBatch
// without applying them -- called on a generated transaction block's
// error path, mirroring a real ROLLBACK: nothing was ever written to
// the real store while batching, so discarding the queue *is* the
// rollback.
func (w *World) RollbackWorldBatch() {
	w.mu.Lock()
	defer w.mu.Unlock()
	w.pendingBatch = nil
}

type deletedRef struct {
	table string
	pk    string
}

// CommitBatchChecked is the `transaction {}` leaf's own accumulation
// point -- every insert/update/delete in ops validates against one
// scratch overlay of the live store before any of it is applied for
// real, so a violation partway through a batch leaves the store
// exactly as it was before the call. Returns every [table, pk]
// actually deleted, including cascades.
func (w *World) CommitBatchChecked(ops []BatchOp) ([][2]string, error) {
	w.mu.Lock()
	defer w.mu.Unlock()
	if len(ops) > 0 && w.shouldFail("db.commit", ops[0].Table) {
		return nil, errors.New("simulated db.commit failure (injected by FailureEngine)")
	}

	overlay := w.db.snapshot()
	var allDeletes []deletedRef

	for _, op := range ops {
		switch op.Kind {
		case "insert":
			if err := validateWrite(w.schema, overlay, op.Table, op.Row, ""); err != nil {
				return nil, err
			}
			overlay[op.Table] = append(overlay[op.Table], op.Row)
		case "update":
			if err := validateWrite(w.schema, overlay, op.Table, op.Row, op.PK); err != nil {
				return nil, err
			}
			rows := overlay[op.Table]
			for i, r := range rows {
				if id, ok := rowID(r); ok && id == op.PK {
					rows[i] = op.Row
					break
				}
			}
		default: // "delete"
			cascaded, err := planDelete(w.schema, overlay, op.Table, op.PK)
			if err != nil {
				return nil, err
			}
			steps := append([]deletePlanStep{{table: op.Table, pk: op.PK}}, cascaded...)
			for _, step := range steps {
				rows := overlay[step.table]
				kept := make([]Row, 0, len(rows))
				for _, r := range rows {
					if id, ok := rowID(r); ok && id == step.pk {
						continue
					}
					kept = append(kept, r)
				}
				overlay[step.table] = kept
			}
			for _, step := range steps {
				allDeletes = append(allDeletes, deletedRef{table: step.table, pk: step.pk})
			}
		}
	}

	// Every op above validated against the overlay without ever
	// touching the real store -- reaching here means the whole batch
	// is safe to apply for real, all at once.
	for _, op := range ops {
		switch op.Kind {
		case "insert":
			w.db.insert(op.Table, op.Row)
		case "update":
			w.db.replace(op.Table, op.PK, op.Row)
		}
	}
	out := make([][2]string, 0, len(allDeletes))
	for _, d := range allDeletes {
		w.db.delete(d.table, d.pk)
		out = append(out, [2]string{d.table, d.pk})
	}
	return out, nil
}

// PublishChecked is broker.publish's failure check plus the actual
// (fake) publish -- into both queue (the orphan-subject detection
// sweep still reads it) and broker (the group-aware log every worker
// drains from).
func (w *World) PublishChecked(subject string, payload []byte) error {
	w.mu.Lock()
	defer w.mu.Unlock()
	if w.shouldFail("broker.publish", subject) {
		return errors.New("simulated broker.publish failure (injected by FailureEngine)")
	}
	w.queue.publish(subject, payload)
	w.broker.publish(subject, payload)
	return nil
}

// DrainQueue returns every message published since the last drain,
// removing them -- sim_runner's own orphan-subject detection sweep.
func (w *World) DrainQueue() []QueuedMessage {
	w.mu.Lock()
	defer w.mu.Unlock()
	return w.queue.takeAll()
}

// DrainBroker returns every unconsumed message for (subject, group),
// acking each as it is collected -- sim_runner's own per-worker drain
// step.
func (w *World) DrainBroker(subject, group string) [][]byte {
	w.mu.Lock()
	defer w.mu.Unlock()
	return w.broker.drain(subject, group)
}

// QueueIsEmpty is a non-destructive peek -- expect.quiescence needs
// to observe whether anything is still undelivered without consuming
// it.
func (w *World) QueueIsEmpty() bool {
	w.mu.Lock()
	defer w.mu.Unlock()
	return w.queue.isEmpty()
}

// NowMs is the current virtual time, in epoch milliseconds.
func (w *World) NowMs() int64 {
	w.mu.Lock()
	defer w.mu.Unlock()
	return w.nowMsVal
}

// AdvanceClockTo advances virtual time forward. Errors if toMs is
// before the current time -- virtual time never moves backward.
func (w *World) AdvanceClockTo(toMs int64) error {
	w.mu.Lock()
	defer w.mu.Unlock()
	if toMs < w.nowMsVal {
		return fmt.Errorf("virtual clock cannot move backward: at %d, asked for %d", w.nowMsVal, toMs)
	}
	w.nowMsVal = toMs
	return nil
}

// CacheGet is cache.get -- false if absent or expired (against
// World's own virtual clock, never wall time). No failure-injection
// check, matching Python's own FakeCache.
func (w *World) CacheGet(instance, key string) (string, bool) {
	w.mu.Lock()
	defer w.mu.Unlock()
	return getOrCreate(w.caches, instance, newFakeCache).get(key, w.nowMsVal)
}

// CacheSet is cache.set. ttlMs is nil for no expiry.
func (w *World) CacheSet(instance, key, value string, ttlMs *int64) {
	w.mu.Lock()
	defer w.mu.Unlock()
	getOrCreate(w.caches, instance, newFakeCache).set(key, value, ttlMs, w.nowMsVal)
}

// CacheDelete is cache.delete.
func (w *World) CacheDelete(instance, key string) {
	w.mu.Lock()
	defer w.mu.Unlock()
	getOrCreate(w.caches, instance, newFakeCache).delete(key)
}

// ObjectPut is object_store.put.
func (w *World) ObjectPut(instance, key string, body []byte) {
	w.mu.Lock()
	defer w.mu.Unlock()
	getOrCreate(w.objectStores, instance, newFakeObjectStore).put(key, body)
}

// ObjectGet is object_store.get -- errors if no object exists at key,
// matching Python's FakeObjectStore.get (a KeyError on a miss rather
// than returning None).
func (w *World) ObjectGet(instance, key string) ([]byte, error) {
	w.mu.Lock()
	defer w.mu.Unlock()
	body, ok := getOrCreate(w.objectStores, instance, newFakeObjectStore).get(key)
	if !ok {
		return nil, fmt.Errorf("object_store: no object at key %q in instance %q", key, instance)
	}
	return body, nil
}

// ObjectDelete is object_store.delete.
func (w *World) ObjectDelete(instance, key string) {
	w.mu.Lock()
	defer w.mu.Unlock()
	getOrCreate(w.objectStores, instance, newFakeObjectStore).delete(key)
}

// ObjectList is object_store.list -- every key with the given prefix,
// sorted.
func (w *World) ObjectList(instance, prefix string) []string {
	w.mu.Lock()
	defer w.mu.Unlock()
	return getOrCreate(w.objectStores, instance, newFakeObjectStore).list(prefix)
}

// ObjectExists is expect.object's own presence check -- distinct from
// ObjectGet's "found or error" shape, since a presence assertion
// should never itself be treated as a scenario error.
func (w *World) ObjectExists(instance, key string) bool {
	w.mu.Lock()
	defer w.mu.Unlock()
	store, ok := w.objectStores[instance]
	if !ok {
		return false
	}
	_, ok = store.get(key)
	return ok
}

// EmailSend is email.send.
func (w *World) EmailSend(instance, to, subject, body string) {
	w.mu.Lock()
	defer w.mu.Unlock()
	getOrCreate(w.emails, instance, func() *fakeEmail { return &fakeEmail{} }).send(to, subject, body)
}

// EmailSentCountAll is expect.email's own count query -- deliberately
// not scoped to one instance: the scenario schema's expect.email
// carries no instance field, matching Python's own _expect_email,
// which counts sends across every email instance the world has seen.
func (w *World) EmailSentCountAll(to, subjectContains *string) int {
	w.mu.Lock()
	defer w.mu.Unlock()
	count := 0
	for _, email := range w.emails {
		for _, m := range email.sent {
			if to != nil && m.to != *to {
				continue
			}
			if subjectContains != nil && !strings.Contains(m.subject, *subjectContains) {
				continue
			}
			count++
		}
	}
	return count
}

// SearchIndex is search.index.
func (w *World) SearchIndex(instance, docID string, document any) {
	w.mu.Lock()
	defer w.mu.Unlock()
	getOrCreate(w.searches, instance, newFakeSearch).index(docID, document)
}

// SearchQuery is search.query -- case-insensitive substring match
// over each document's JSON, matching Python's own disclosed
// evaluator (not a real query language).
func (w *World) SearchQuery(instance, text string) []any {
	w.mu.Lock()
	defer w.mu.Unlock()
	return getOrCreate(w.searches, instance, newFakeSearch).query(text)
}

// SearchDelete is search.delete.
func (w *World) SearchDelete(instance, docID string) {
	w.mu.Lock()
	defer w.mu.Unlock()
	getOrCreate(w.searches, instance, newFakeSearch).delete(docID)
}

// SeedHTTPFixtures seeds instance's fixture queue from a scenario's
// own `given.external_http` block -- the exact fixture shape a
// checked-in scenario already carries, consumed directly rather than
// translated into a second ad hoc format.
func (w *World) SeedHTTPFixtures(instance string, responses []GivenHTTPResponse) {
	w.mu.Lock()
	defer w.mu.Unlock()
	getOrCreate(w.httpClients, instance, func() *fakeHTTPClient { return &fakeHTTPClient{} }).setFixtures(responses)
}

// HTTPPost is external_http.request's POST call -- consumes the next
// unconsumed fixture in order, erroring if none remain or the fixture
// itself declares an error.
func (w *World) HTTPPost(instance, url string, jsonBody any) (any, error) {
	w.mu.Lock()
	defer w.mu.Unlock()
	return getOrCreate(w.httpClients, instance, func() *fakeHTTPClient { return &fakeHTTPClient{} }).post(url, jsonBody)
}

// HTTPRequestCount is expect.http_calls's own count query.
func (w *World) HTTPRequestCount(instance string) int {
	w.mu.Lock()
	defer w.mu.Unlock()
	client, ok := w.httpClients[instance]
	if !ok {
		return 0
	}
	return len(client.requests)
}

// AuthIssue configures the claims (and optional expiry, against
// World's own virtual clock) a bearer token verifies to -- the
// runner's own equivalent of Python's FakeAuth.issue, called from a
// scenario's own auth setup, not from generated production code.
func (w *World) AuthIssue(token string, claims any, expireAtMs *int64) {
	w.mu.Lock()
	defer w.mu.Unlock()
	w.auth.issue(token, claims, expireAtMs)
}

// AuthVerify is the generated auth guard's own verification call --
// claims-lookup, not real JWT/JWKS crypto, matching Python's
// FakeAuth. dest is a pointer to the concrete claims shape the auth
// package's own Claims type expects (JSON-round-tripped, matching
// every other read leaf in this package).
func (w *World) AuthVerify(token string, dest any) error {
	w.mu.Lock()
	claims, err := w.auth.verify(token, w.nowMsVal)
	w.mu.Unlock()
	if err != nil {
		return err
	}
	b, err := json.Marshal(claims)
	if err != nil {
		return err
	}
	return json.Unmarshal(b, dest)
}

// UnmatchedFailureRules returns the failure rules a scenario declared
// that never matched a real occurrence.
func (w *World) UnmatchedFailureRules() []string {
	return w.failures.unmatchedRules()
}

// RegisterAPI registers handler as service's api -- the target
// CallChecked resolves a routed call against. A system-runner (M7c+)
// calls this once per api, in service declaration order, before any
// scenario runs; re-registering the same (service, api) replaces the
// earlier handler rather than erroring, matching how a runner would
// simply rebuild the world (and re-register everything) between
// scenario runs rather than asking this registry to detect staleness
// itself.
func (w *World) RegisterAPI(service, api string, handler ApiHandler) {
	w.mu.Lock()
	defer w.mu.Unlock()
	w.apis[apiKey{service: service, api: api}] = handler
}

// CallChecked routes a `call <Service>.<Api>` step -- inline and
// synchronous on the caller's own logical call chain, exactly as
// production's typed call client behaves, just against the registered
// handler instead of real HTTP. Counts against the `call.request`
// failure vocabulary the same way `db.commit`/`broker.publish` do; an
// injected failure fires before the handler ever runs, and an
// unregistered (calleeService, api) is a clear error rather than a
// silent no-op -- the same "fail closed on a missing seam" discipline
// fakeHTTPClient already uses for an unmatched fixture. The handler's
// own return value/error passes through verbatim, matching production's
// own "the callee's real response or real error, not a synthesized
// one."
func (w *World) CallChecked(caller, calleeService, api string, req any) (any, error) {
	if w.shouldFail("call.request", api) {
		return nil, errors.New("simulated call.request failure (injected by FailureEngine)")
	}
	w.mu.Lock()
	handler, ok := w.apis[apiKey{service: calleeService, api: api}]
	if !ok {
		w.mu.Unlock()
		return nil, fmt.Errorf("no handler registered for %s.%s (called from %s)", calleeService, api, caller)
	}
	if w.callDepth >= maxCallDepth {
		w.mu.Unlock()
		return nil, fmt.Errorf("routed call depth exceeded %d calling %s.%s from %s", maxCallDepth, calleeService, api, caller)
	}
	w.callDepth++
	w.mu.Unlock()
	defer func() {
		w.mu.Lock()
		w.callDepth--
		w.mu.Unlock()
	}()
	// Deliberately invoked outside w.mu: the handler may itself call
	// back into World (a routed call, or a plain db/queue verb), and
	// this mutex is not reentrant -- holding it across the call would
	// deadlock the very first recursive or nested invocation.
	return handler(req)
}

// NamespacedTableKey composes the per-service namespaced database key
// every multi-service world-guarded db verb addresses through -- the Go
// counterpart to ciac-sim's `SimWorld::namespaced_table_key` (28's M2)/
// TypeScript's own `namespacedTableKey` (M7a). service is "" in
// single-service mode, degenerating to the bare table name. A system-
// runner's own `given.db` seeding (service/table only known at runtime,
// from the scenario JSON) is the only caller that needs this at
// runtime -- codegen-time world-guarded call sites bake the equivalent
// key in as a literal (GoSyntax::world_table_key), not through this
// function.
func NamespacedTableKey(service, table string) string {
	if service == "" {
		return table
	}
	return service + "::" + table
}
