// simbridge/simbridge.go -- Generated by CIaC (28UpdatePlan.md M7c,
// multi-service systems only).
//
// The one non-`internal` package this service exposes to the system's
// own system-runner module. Found live, before this file existed:
// `go build` refuses "use of internal package billing/internal/config
// not allowed" the moment a *separate* module (system-runner, reached
// only through a `go.mod` `replace` directive) tries to import
// anything under this service's own `internal/` tree -- Go's
// directory-based visibility rule scopes an `internal` package to the
// import-path prefix rooted at its own parent directory, which a
// different module's own import path never shares, regardless of
// `replace`. This is a second, independent instance of the same
// nominal-type-sharing problem `world.go` solved by moving to the
// `sim-shared` module (28's M7c doc comment) -- here the fix is a
// thin, non-`internal` facade instead, since (unlike `world.World`)
// these symbols must stay each service's own distinct types, not one
// shared type.
//
// Every symbol below is a bare re-export of an already-`internal` one
// -- this package adds no logic of its own, mirroring how a Rust
// crate's `pub use` re-export or a TypeScript package's named export
// already cross an equivalent boundary for free. Single-service
// projects never emit this file; production code never imports it
// either (only `system-runner/main.go` does).
package simbridge

import (
	"billing/internal/config"
	"billing/internal/routes"
	"billing/internal/state"
)

type Config = config.Config
type AppState = state.AppState

var FromEnv = config.FromEnv
var New = state.New
var NewSimulation = state.NewSimulation
var Router = routes.Router
