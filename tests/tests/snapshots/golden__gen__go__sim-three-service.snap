// cmd/workers/main.go -- Generated by CIaC.
package main

import (
	"context"
	"log"
	"os"

	"golang.org/x/sync/errgroup"

	"fulfillment/internal/config"
	"fulfillment/internal/db"
	"fulfillment/internal/observability"
	"fulfillment/internal/state"
	"fulfillment/internal/workers"
)

func main() {
	observability.Init()
	cfg := config.FromEnv()
	st, err := state.New(cfg)
	if err != nil {
		log.Fatalf("state.New: %v", err)
	}
	if err := db.Migrate(st.DB, "postgres", os.DirFS("migrations")); err != nil {
		log.Fatalf("migrate: %v", err)
	}

	ctx := context.Background()
	g, ctx := errgroup.WithContext(ctx)
	g.Go(func() error {
		workers.RunShip(ctx, st)
		return nil
	})
	if err := g.Wait(); err != nil {
		log.Fatal(err)
	}
}
