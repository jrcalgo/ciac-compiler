// Package state holds shared application state. Generated by CIaC.
package state

import (
	"billing/internal/config"
	"billing/internal/db"
	"database/sql"
	"sim-shared/world"
)

// AppState is every provider client this service's generated code can
// access. Every one of them is constructed lazily, so building an
// AppState never opens a connection (proven by state_test.go's
// no-infra construction test). `database/sql`'s own `sql.Open` is
// already lazy by construction -- it never dials, the first query
// does -- so db pools need no extra lazy-init wrapper the way a
// hand-rolled client would; `redis.NewClient` is the same (it parses
// the URL and returns immediately, no dial). `object_store`/`email`/
// `search`/`external_http` wrapper clients hold configuration only
// (their own underlying client is built per call — see each
// package's own doc), so there is nothing to lazily construct there
// either.
type AppState struct {
	Config config.Config
	DB     *sql.DB
	// World is `nil` in production; set only by [NewSimulation]
	// (v0.24 M9) -- every world-guarded call site (`db.insert`,
	// broker `publish`) checks it first and falls through to the
	// real fields above when it's unset. Every other db/cache/
	// ontology field above is still built normally in simulation
	// (harmless -- lazy construction never touches the network in
	// production *or* simulation) but is never touched while World
	// is set.
	World *world.World
}

// New builds AppState. Construction is infrastructure-free by
// construction: nothing in here (or in any field this struct will
// grow) may block on a network call.
func New(cfg config.Config) (*AppState, error) {
	st := &AppState{Config: cfg}
	db, err := db.Open("postgres", cfg.DatabaseURL)
	if err != nil {
		return nil, err
	}
	st.DB = db
	return st, nil
}

// NewSimulation builds an AppState against an in-memory [world.World]
// instead of real infrastructure (v0.24 M9) -- every provider client
// field above is still constructed normally (the same lazy, network-
// free construction [New] itself guarantees), but the world-guarded
// call sites never fall through to them once World is set. cfg is
// still required (config-driven fields like table/queue subject names
// aren't faked), but its connection URLs are never dialed.
func NewSimulation(cfg config.Config, w *world.World) *AppState {
	st, err := New(cfg)
	if err != nil {
		// New's only failure modes are malformed provider URLs, which
		// simulation still parses from the same cfg -- a scenario run
		// against a program with an invalid config is a setup bug, not
		// a scenario outcome, so this panics rather than threading a
		// second error return through every caller.
		panic(err)
	}
	st.World = w
	return st
}
