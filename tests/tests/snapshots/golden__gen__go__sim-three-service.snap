// cmd/api/main.go — Generated by CIaC.
package main

import (
	_ "embed"
	"log"
	"log/slog"
	"net/http"
	"os"

	"fulfillment/internal/config"
	"fulfillment/internal/db"
	"fulfillment/internal/httpx"
	"fulfillment/internal/observability"
	"fulfillment/internal/state"
)

// A colocated copy of the project-root openapi.json -- see lib.rs's
// comment at its emission site for why `go:embed` needs one here, and
// why this copy isn't itself named openapi.json.
//
//go:embed apidoc.json
var openapiJSON []byte

func main() {
	observability.Init()
	cfg := config.FromEnv()
	st, err := state.New(cfg)
	if err != nil {
		log.Fatalf("state.New: %v", err)
	}
	if err := db.Migrate(st.DB, "postgres", os.DirFS("migrations")); err != nil {
		log.Fatalf("migrate: %v", err)
	}
	// No api/resource/channel declares an HTTP route -- e.g. a
	// jobs-only program like scheduled-cleanup.ciac -- so there is no
	// internal/routes package to import; /health and /openapi.json
	// are still served, the same "always-present" bar every other
	// target's own health/openapi route keeps regardless of what else
	// the program declares.
	_ = st
	mux := http.NewServeMux()
	mux.HandleFunc("GET /health", func(w http.ResponseWriter, r *http.Request) {
		httpx.WriteJSON(w, http.StatusOK, map[string]string{"status": "ok"})
	})
	mux.HandleFunc("GET /openapi.json", func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		_, _ = w.Write(openapiJSON)
	})
	var handler http.Handler = mux

	slog.Info("listening", "addr", "0.0.0.0:8000")
	if err := http.ListenAndServe("0.0.0.0:8000", handler); err != nil {
		log.Fatal(err)
	}
}
