// ResourceVideoController.java -- Generated by CIaC.
//
// REST endpoints for the ResourceVideo resource. Responses are
// the raw entity JSON (no `Envelope` wrapper) -- CRUD resources carry
// their own response contract, separate from pipeline `api`s (see
// `ApiController`), matching every other target's own resource routes.
package com.ciac.catalog.routes;

import com.ciac.catalog.schemas.ResourceVideoIn;
import com.ciac.catalog.schemas.Video;
import com.ciac.catalog.services.ResourceVideoStore;
import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class ResourceVideoController {
  private final ResourceVideoStore store;

  public ResourceVideoController(ResourceVideoStore store) {
    this.store = store;
  }

  @PostMapping("/resource_videos")
  public ResponseEntity<Video> create(@RequestBody JsonNode body) {
    ResourceVideoIn payload = ResourceVideoIn.decode(body);
    return ResponseEntity.status(HttpStatus.CREATED).body(store.create(payload));
  }

  @GetMapping("/resource_videos")
  public java.util.List<Video> list(
      @RequestParam(defaultValue = "100") int limit, @RequestParam(defaultValue = "0") int offset) {
    return store.list(limit, offset);
  }

  @GetMapping("/resource_videos/{id}")
  public Video get(@PathVariable String id) {
    return store.get(id).orElseThrow(() -> new NotFoundException("ResourceVideo not found"));
  }

  @PutMapping("/resource_videos/{id}")
  public Video update(@PathVariable String id, @RequestBody JsonNode body) {
    ResourceVideoIn payload = ResourceVideoIn.decode(body);
    return store
        .update(id, payload)
        .orElseThrow(() -> new NotFoundException("ResourceVideo not found"));
  }

  @DeleteMapping("/resource_videos/{id}")
  public ResponseEntity<Void> delete(@PathVariable String id) {
    if (!store.delete(id)) {
      throw new NotFoundException("ResourceVideo not found");
    }
    return ResponseEntity.noContent().build();
  }
}
