# application.yml -- Generated by CIaC.
server:
  port: 8000

spring:
  main:
    banner-mode: "off"
  flyway:
    # Disabled deliberately (Pillar 4): `FlywayAutoConfiguration`
    # would otherwise resolve `AppState`'s own `@Lazy` `DataSource`
    # beans eagerly at context startup the moment it sees one in the
    # context, defeating the whole point of marking them lazy.
    # `AppState`'s own `CommandLineRunner` runs migrations explicitly
    # instead, against the same beans, once something actually needs
    # them.
    enabled: false
  threads:
    virtual:
      # Loom virtual threads (standard since Java 21): generated
      # handlers stay plain blocking imperative Java -- no Reactor
      # types leaking into seeded user stubs -- while still scaling
      # I/O-bound workloads (25UpdatePlan.md Pillar 1's framework
      # decision).
      enabled: true

management:
  endpoints:
    web:
      exposure:
        include: []

logging:
  level:
    root: INFO
