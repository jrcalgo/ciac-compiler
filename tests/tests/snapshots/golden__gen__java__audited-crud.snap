// ResourceUserStore.java -- Generated by CIaC.
//
// Persistence for the ResourceUser resource.
package com.ciac.accounts.services;

import com.ciac.accounts.schemas.ResourceUserIn;
import com.ciac.accounts.schemas.RowMappers;
import com.ciac.accounts.schemas.User;
import java.util.List;
import java.util.Optional;
import java.util.UUID;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.jdbc.core.simple.JdbcClient;
import org.springframework.stereotype.Component;

@Component
public class ResourceUserStore {
  private final JdbcClient jdbc;

  public ResourceUserStore(@Qualifier("dbMainJdbc") JdbcClient jdbc) {
    this.jdbc = jdbc;
  }

  public User create(ResourceUserIn payload) {
    String id = UUID.randomUUID().toString();
    jdbc.sql("INSERT INTO resource_users (id, title) VALUES (?, ?)")
        .param(id)
        .param(payload.title())
        .update();
    return new User(id, payload.title());
  }

  public Optional<User> get(String id) {
    return jdbc.sql("SELECT id, title FROM resource_users WHERE id = ?")
        .param(id)
        .query(RowMappers.USER)
        .optional();
  }

  public List<User> list(int limit, int offset) {
    return jdbc.sql("SELECT id, title FROM resource_users ORDER BY id LIMIT ? OFFSET ?")
        .param(limit)
        .param(offset)
        .query(RowMappers.USER)
        .list();
  }

  public Optional<User> update(String id, ResourceUserIn payload) {
    int n =
        jdbc.sql("UPDATE resource_users SET title = ? WHERE id = ?")
            .param(payload.title())
            .param(id)
            .update();
    if (n == 0) {
      return Optional.empty();
    }
    return Optional.of(new User(id, payload.title()));
  }

  public boolean delete(String id) {
    int n = jdbc.sql("DELETE FROM resource_users WHERE id = ?").param(id).update();
    return n > 0;
  }
}
