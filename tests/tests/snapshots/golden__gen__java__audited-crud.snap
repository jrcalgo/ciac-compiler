// ResourceVideoStore.java -- Generated by CIaC.
//
// Persistence for the ResourceVideo resource.
package com.ciac.catalog.services;

import com.ciac.catalog.schemas.ResourceVideoIn;
import com.ciac.catalog.schemas.RowMappers;
import com.ciac.catalog.schemas.Video;
import java.util.List;
import java.util.Optional;
import java.util.UUID;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.jdbc.core.simple.JdbcClient;
import org.springframework.stereotype.Component;

@Component
public class ResourceVideoStore {
  private final JdbcClient jdbc;

  public ResourceVideoStore(@Qualifier("dbMainJdbc") JdbcClient jdbc) {
    this.jdbc = jdbc;
  }

  public Video create(ResourceVideoIn payload) {
    String id = UUID.randomUUID().toString();
    jdbc.sql("INSERT INTO resource_videos (id, title) VALUES (?, ?)")
        .param(id)
        .param(payload.title())
        .update();
    return new Video(id, payload.title());
  }

  public Optional<Video> get(String id) {
    return jdbc.sql("SELECT id, title FROM resource_videos WHERE id = ?")
        .param(id)
        .query(RowMappers.VIDEO)
        .optional();
  }

  public List<Video> list(int limit, int offset) {
    return jdbc.sql("SELECT id, title FROM resource_videos ORDER BY id LIMIT ? OFFSET ?")
        .param(limit)
        .param(offset)
        .query(RowMappers.VIDEO)
        .list();
  }

  public Optional<Video> update(String id, ResourceVideoIn payload) {
    int n =
        jdbc.sql("UPDATE resource_videos SET title = ? WHERE id = ?")
            .param(payload.title())
            .param(id)
            .update();
    if (n == 0) {
      return Optional.empty();
    }
    return Optional.of(new Video(id, payload.title()));
  }

  public boolean delete(String id) {
    int n = jdbc.sql("DELETE FROM resource_videos WHERE id = ?").param(id).update();
    return n > 0;
  }
}
