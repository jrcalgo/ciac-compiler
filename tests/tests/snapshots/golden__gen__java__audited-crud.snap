// NoInfraBootTest.java -- Generated by CIaC.
//
// Pillar 4's magic detector: boots the full application context with
// no reachable infrastructure and asserts clean startup. If ANY bean
// eagerly connects to a database/cache/broker (a classic Spring
// failure mode when a starter sneaks in), this test fails -- lazy
// init as a permanently TESTED property on every `mvnw verify`
// forever, the same bar v0.17 M11 retrofitted onto Rust and every
// later target has built in from milestone one.
package com.ciac.catalog;

import static org.assertj.core.api.Assertions.assertThat;

import org.junit.jupiter.api.Test;
import org.springframework.boot.test.context.SpringBootTest;

@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
class NoInfraBootTest {
  @Test
  void contextLoadsWithNoInfrastructureReachable() {
    // The context loading successfully (no exception thrown before
    // this method body even runs) IS the proof -- an eagerly
    // connecting bean would fail application startup, not this
    // assertion. Kept non-empty so a future refactor can't
    // silently turn this into a no-op test.
    assertThat(true).isTrue();
  }
}
============================================================
docker-compose.yml
============================================================
services:

  catalog:
    build: ./catalog
    ports:
      - "8000:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      DATABASE_URL_MAIN: jdbc:postgresql://postgres:postgres@catalog-db-main:5432/catalog_main
    depends_on:
      catalog-db-main:
        condition: service_healthy

  accounts:
    build: ./accounts
    ports:
      - "8001:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      DATABASE_URL_MAIN: jdbc:postgresql://postgres:postgres@accounts-db-main:5432/accounts_main
    depends_on:
      accounts-db-main:
        condition: service_healthy

  catalog-db-main:
    image: postgres:16
    ports:
      - "5432:5432"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: catalog_main
    volumes:
      - catalog-db-main-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 2s
      timeout: 3s
      retries: 20

  accounts-db-main:
    image: postgres:16
    ports:
      - "5433:5432"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: accounts_main
    volumes:
      - accounts-db-main-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 2s
      timeout: 3s
      retries: 20

volumes:
  catalog-db-main-data:
  accounts-db-main-data:
