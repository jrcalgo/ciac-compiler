accounts/src/main/java/com/ciac/accounts/state/DataSources.java
============================================================
// DataSources.java -- Generated by CIaC.
//
// JDBC accepts a `jdbc:<engine>://` URL directly, but the same
// combined-credential URL docker-compose sets (`jdbc:postgresql://
// user:pass@host:port/db`, the userinfo form every other target's own
// native driver already accepts) is NOT one the postgres/mysql JDBC
// drivers parse -- userinfo-style credentials in the authority
// component aren't part of the JDBC URL grammar either driver
// implements. `open` strips and re-attaches them as discrete
// `username`/`password` DataSource properties instead of guessing at
// a URL shape the driver would accept; sqlite (`jdbc:sqlite:<path>`)
// carries no credentials at all and is never rewritten.
//
// `initializationFailTimeout(-1)` (25UpdatePlan.md M8, found live):
// HikariCP's own default `checkFailFast` behavior dials the database
// synchronously *inside* `new HikariDataSource(config)` and throws if
// it can't connect -- the `@Lazy` annotation on `AppState`'s own
// `db()` bean method only defers *when* that constructor runs, not
// what it does once triggered, so a genuinely unreachable database
// still crashed the whole Spring context the moment anything (here,
// `migrateOnBoot`'s own `CommandLineRunner`) forced the bean's
// construction. `-1` is HikariCP's own documented way to make pool
// construction never attempt a connection, restoring the same
// "constructing this never dials" contract every other provider
// client bean already keeps.
package com.ciac.accounts.state;

import com.zaxxer.hikari.HikariConfig;
import com.zaxxer.hikari.HikariDataSource;
import java.net.URI;
import java.nio.file.Files;
import java.nio.file.Path;
import javax.sql.DataSource;
import org.flywaydb.core.Flyway;

final class DataSources {
  private DataSources() {}

  static DataSource open(String rawUrl) throws Exception {
    HikariConfig config = new HikariConfig();
    config.setInitializationFailTimeout(-1);
    if (rawUrl.startsWith("jdbc:sqlite:")) {
      // The sqlite driver creates the database *file* itself but
      // not missing parent directories (mirrors every other
      // target's own `create_dir_all("data")`-equivalent).
      Files.createDirectories(Path.of("data"));
      config.setJdbcUrl(rawUrl);
      return new HikariDataSource(config);
    }
    URI inner = new URI(rawUrl.substring("jdbc:".length()));
    String userInfo = inner.getUserInfo();
    if (userInfo != null) {
      String[] parts = userInfo.split(":", 2);
      config.setUsername(parts[0]);
      if (parts.length > 1) {
        config.setPassword(parts[1]);
      }
    }
    config.setJdbcUrl(
        "jdbc:"
            + inner.getScheme()
            + "://"
            + inner.getHost()
            + ":"
            + inner.getPort()
            + inner.getPath());
    return new HikariDataSource(config);
  }

  // `table`-declaration migrations only (Pillar 5): CRUD-resource
  // schema is bootstrapped separately (see `AppState`'s own
  // `CommandLineRunner`) since `crud <Name>;` synthesizes no `Table`
  // IR node for the shared differ to see.
  static void migrate(DataSource dataSource) {
    Flyway.configure().dataSource(dataSource).locations("classpath:db/migration").load().migrate();
  }
}
