// RowMappers.java -- Generated by CIaC.
//
// Explicit, per-model `RowMapper` constants with explicit column order
// (Pillar 5) -- deterministic, reflection-free, the `FromRow`/`Scan`
// analog. Column order always matches `select_cols`'s own `id, ..`
// ordering, so a mapper and the query it backs never drift. One entry
// per distinct record backing either a CRUD resource or a `table`
// declaration a typed handler's `db.get`/`db.query` reads (M4) --
// `row_mapper_records` is already deduplicated by record name in
// `lib.rs`, so a record backing both a `crud` resource and a plain
// `table` (unreachable today, disclosed rather than assumed
// impossible) still gets exactly one constant.
package com.ciac.catalog.schemas;

import org.springframework.jdbc.core.RowMapper;

public final class RowMappers {
  private RowMappers() {}

  public static final RowMapper<Video> VIDEO =
      (rs, rowNum) -> new Video(rs.getString("id"), rs.getString("title"));
}
