// ResourceUserController.java -- Generated by CIaC.
//
// REST endpoints for the ResourceUser resource. Responses are
// the raw entity JSON (no `Envelope` wrapper) -- CRUD resources carry
// their own response contract, separate from pipeline `api`s (see
// `ApiController`), matching every other target's own resource routes.
package com.ciac.accounts.routes;

import com.ciac.accounts.schemas.ResourceUserIn;
import com.ciac.accounts.schemas.User;
import com.ciac.accounts.services.ResourceUserStore;
import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class ResourceUserController {
  private final ResourceUserStore store;

  public ResourceUserController(ResourceUserStore store) {
    this.store = store;
  }

  @PostMapping("/resource_users")
  public ResponseEntity<User> create(@RequestBody JsonNode body) {
    ResourceUserIn payload = ResourceUserIn.decode(body);
    return ResponseEntity.status(HttpStatus.CREATED).body(store.create(payload));
  }

  @GetMapping("/resource_users")
  public java.util.List<User> list(
      @RequestParam(defaultValue = "100") int limit, @RequestParam(defaultValue = "0") int offset) {
    return store.list(limit, offset);
  }

  @GetMapping("/resource_users/{id}")
  public User get(@PathVariable String id) {
    return store.get(id).orElseThrow(() -> new NotFoundException("ResourceUser not found"));
  }

  @PutMapping("/resource_users/{id}")
  public User update(@PathVariable String id, @RequestBody JsonNode body) {
    ResourceUserIn payload = ResourceUserIn.decode(body);
    return store
        .update(id, payload)
        .orElseThrow(() -> new NotFoundException("ResourceUser not found"));
  }

  @DeleteMapping("/resource_users/{id}")
  public ResponseEntity<Void> delete(@PathVariable String id) {
    if (!store.delete(id)) {
      throw new NotFoundException("ResourceUser not found");
    }
    return ResponseEntity.noContent().build();
  }
}
