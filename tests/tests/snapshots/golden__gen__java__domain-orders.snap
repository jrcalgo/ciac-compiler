// RowMappers.java -- Generated by CIaC.
//
// Explicit, per-model `RowMapper` constants with explicit column order
// (Pillar 5) -- deterministic, reflection-free, the `FromRow`/`Scan`
// analog. Column order always matches `select_cols`'s own `id, ..`
// ordering, so a mapper and the query it backs never drift. One entry
// per distinct record backing either a CRUD resource or a `table`
// declaration a typed handler's `db.get`/`db.query` reads (M4) --
// `row_mapper_records` is already deduplicated by record name in
// `lib.rs`, so a record backing both a `crud` resource and a plain
// `table` (unreachable today, disclosed rather than assumed
// impossible) still gets exactly one constant.
package com.ciac.domainorders.schemas;

import org.springframework.jdbc.core.RowMapper;

public final class RowMappers {
  private RowMappers() {}

  // Customers is the `table Customers: Customer;`
  // declaration's own row shape, in column order.
  public static final RowMapper<Customer> CUSTOMER =
      (rs, rowNum) -> new Customer(rs.getString("id"), rs.getString("name"), rs.getString("email"));

  // Orders is the `table Orders: Order;`
  // declaration's own row shape, in column order.
  public static final RowMapper<Order> ORDER =
      (rs, rowNum) ->
          new Order(rs.getString("id"), rs.getString("customer_id"), rs.getDouble("total"));

  // OrderAudits is the `table OrderAudits: OrderAudit;`
  // declaration's own row shape, in column order.
  public static final RowMapper<OrderAudit> ORDER_AUDIT =
      (rs, rowNum) ->
          new OrderAudit(rs.getString("id"), rs.getString("note"), rs.getDouble("total"));

  // LineItems is the `table LineItems: LineItem;`
  // declaration's own row shape, in column order.
  public static final RowMapper<LineItem> LINE_ITEM =
      (rs, rowNum) ->
          new LineItem(
              rs.getString("id"),
              rs.getString("order_id"),
              rs.getString("sku"),
              rs.getLong("quantity"));
}
