// the raw key set for both cases before any typed conversion ever
// runs, giving every decode site the same three-way absent/null/zero
// distinction Go's/TypeScript's own decoders enforce. `requireUuid`
// is this milestone's manual stand-in for `jakarta.validation`'s
// `@Pattern`-style format constraint (M1's own disclosed scope
// reduction -- see this crate's own module doc comment).
package com.ciac.domainorders.schemas;

import com.ciac.domainorders.routes.BadRequestException;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.PropertyNamingStrategies;
import com.fasterxml.jackson.datatype.jsr310.JavaTimeModule;
import java.util.UUID;

public final class Schemas {
  // `SNAKE_CASE` (Pillar 1's own table row): every generated record
  // component is a Java `camelCase` identifier
  // (`java_camel`-filtered from the source's snake_case field name);
  // this strategy maps it to/from the wire's snake_case JSON key
  // transparently, so no `@JsonProperty` annotation is needed on any
  // field whose name actually changes case.
  public static final ObjectMapper MAPPER =
      new ObjectMapper()
          .registerModule(new JavaTimeModule())
          .setPropertyNamingStrategy(PropertyNamingStrategies.SNAKE_CASE);

  private Schemas() {}

  public static void requireKeys(JsonNode body, String... required) {
    for (String key : required) {
      if (!body.has(key)) {
        throw new BadRequestException("missing required field \"" + key + "\"");
      }
      if (body.get(key).isNull()) {
        throw new BadRequestException("field \"" + key + "\" must not be null");
      }
    }
  }

  public static void requireUuid(String field, String value) {
    try {
      UUID.fromString(value);
    } catch (IllegalArgumentException e) {
      throw new BadRequestException("field \"" + field + "\": invalid uuid4 value");
    }
  }

  /**
   * `JsonNode.path(..)` is null-safe by design (never throws, returns a `MissingNode` on a miss) --
   * typed-handler `Json` indexing (M4) needs the KeyError/IndexError parity every other target's
   * own decoder enforces, so this restores it explicitly instead of silently returning a
   * missing-node sentinel.
   */
  public static JsonNode indexOrThrow(JsonNode base, String key) {
    JsonNode v = base.path(key);
    if (v.isMissingNode()) {
      throw new BadRequestException("KeyError: '" + key + "'");
    }
    return v;
  }

  /**
   * Marshals v to a JSON string -- the shared call site every typed handler's
   * `cache.set`/`object_store.put`/`search.index`/ `http.call` payload goes through (M4). Wraps
   * Jackson's checked `JsonProcessingException` as unchecked, matching Pillar 2's own "unchecked
   * exceptions throughout" decision for handler bodies.
   */
  public static String toJson(Object v) {
    try {
      return MAPPER.writeValueAsString(v);
    } catch (Exception e) {
      throw new RuntimeException("serializing to JSON", e);
    }
  }

  /** `null` in, `null` out; otherwise parses `s` as a `JsonNode`. */
  public static JsonNode fromJsonOrNull(String s) {
    if (s == null) {
      return null;
    }
    try {
      return MAPPER.readTree(s);
    } catch (Exception e) {
      throw new RuntimeException("parsing JSON", e);
    }
  }
}
