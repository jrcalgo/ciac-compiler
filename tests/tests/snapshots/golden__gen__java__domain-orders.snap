        __status -> {
          var __row0 = order;
          jdbc.sql("INSERT INTO orders (id, customer_id, total) VALUES (?, ?, ?)")
              .param(__row0.id())
              .param(__row0.customerId())
              .param(__row0.total())
              .update();
          if (order.total() < 0.0) {
            throw new InvalidOrder("order total must not be negative");
          }
