// PageViewConsumerConsumer.java -- Generated by CIaC.
// Broker consumer for `events PageViewConsumer`.
//
// A bare `events <Name>;` declaration has no pipeline -- business
// logic goes directly in handleEvent below (this file is
// compiler-owned, not seeded: v0.1's own shape established this as a
// pure stub with no generated call sites to preserve).
package com.ciac.ingest.workers;

import com.ciac.ingest.state.Queue;
import com.fasterxml.jackson.databind.ObjectMapper;
import io.nats.client.Dispatcher;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.boot.context.event.ApplicationReadyEvent;
import org.springframework.context.event.EventListener;
import org.springframework.stereotype.Component;

@Component
public class PageViewConsumerConsumer {
  public static final String SUBJECT = "ingest.page_view";
  public static final String QUEUE_GROUP = "page_view_consumer";

  private static final Logger log = LoggerFactory.getLogger(PageViewConsumerConsumer.class);
  private static final ObjectMapper MAPPER = new ObjectMapper();

  private final Queue queue;

  public PageViewConsumerConsumer(Queue queue) {
    this.queue = queue;
  }

  private void handleEvent(Object payload) {
    // TODO: implement PageViewConsumer.
  }

  private Object decode(byte[] raw) {
    try {
      return MAPPER.readValue(raw, Object.class);
    } catch (Exception e) {
      log.warn("discarding malformed event", e);
      return null;
    }
  }

  // See `Worker.java.j2`'s identical `start()`: an unreachable
  // broker's exception must not escape this `@EventListener` method,
  // or Spring aborts context startup entirely over a broker outage.
  @EventListener(ApplicationReadyEvent.class)
  public void start() {
    try {
      Dispatcher dispatcher =
          queue
              .natsConnection()
              .createDispatcher(
                  msg -> {
                    Object payload = decode(msg.getData());
                    if (payload != null) {
                      handleEvent(payload);
                    }
                  });
      dispatcher.subscribe(SUBJECT, QUEUE_GROUP);
      log.info("consumer PageViewConsumer listening subject={}", SUBJECT);
    } catch (Exception e) {
      log.error("consumer PageViewConsumer: failed to connect/subscribe", e);
    }
  }
}
