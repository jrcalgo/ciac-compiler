{
  "components": {
    "schemas": {}
  },
  "info": {
    "title": "Ingest",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
