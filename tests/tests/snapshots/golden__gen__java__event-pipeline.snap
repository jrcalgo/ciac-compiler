// SubmitController.java -- Generated by CIaC.
//
// Pipeline: Submit.
package com.ciac.ingest.routes;

import com.ciac.ingest.services.Validate;
import com.ciac.ingest.state.AppState;
import com.ciac.ingest.state.Queue;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class SubmitController {
  private final AppState state;
  private final Queue queue;
  private final Validate validate;

  public SubmitController(AppState state, Queue queue, Validate validate) {
    this.state = state;
    this.queue = queue;
    this.validate = validate;
  }

  @RequestMapping(method = RequestMethod.POST, path = "/submit")
  public Envelope submit() throws Exception {
    Object result = java.util.Map.of();

    result = validate.handle(result);

    queue.publishJson("ingest.events", result);

    return Envelope.accepted(result);
  }
}
