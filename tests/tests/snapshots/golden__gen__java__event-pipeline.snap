// AppState.java -- Generated by CIaC.
//
// Every provider client bean this service holds lives here, growing
// one field per declared capability as later milestones land. Every
// field is `@Lazy` (or lazily constructed by the library itself, as
// HikariCP/Lettuce/`RedisConnectionFactory` are) -- constructing
// `AppState` never blocks on a network call, the same bar every other
// target's own state holder keeps (v0.17 M11's lazy-init discipline).
// `NoInfraBootTest` proves this for real on every `mvnw verify`, not
// just here in a comment.
package com.ciac.ingest.state;

import javax.sql.DataSource;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.boot.CommandLineRunner;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.context.annotation.Lazy;
import org.springframework.jdbc.core.simple.JdbcClient;
import org.springframework.jdbc.datasource.DataSourceTransactionManager;
import org.springframework.transaction.support.TransactionTemplate;

@Configuration
public class AppState {

  @Lazy
  @Bean("db")
  public DataSource db(
      @Value("${DATABASE_URL:jdbc:postgresql://postgres:postgres@localhost:5432/ingest}")
          String rawUrl)
      throws Exception {
    return DataSources.open(rawUrl);
  }

  @Lazy
  @Bean("dbJdbc")
  public JdbcClient dbJdbc(@Qualifier("db") DataSource dataSource) {
    return JdbcClient.create(dataSource);
  }

  // Programmatic `TransactionTemplate`, not `@Transactional` (Pillar
  // 4 -- a same-class annotated call would skip the proxy's aspect
  // silently). A typed handler's `transaction {}` block executes its
  // body inside `dbTx.executeWithoutResult(status
  // -> {..})` (`lower.rs`'s `transaction_stmt`); every db verb inside
  // still issues SQL through the same `JdbcClient` bean above, which
  // transparently participates via Spring's own connection binding.
  @Lazy
  @Bean("dbTx")
  public TransactionTemplate dbTx(@Qualifier("db") DataSource dataSource) {
    return new TransactionTemplate(new DataSourceTransactionManager(dataSource));
  }

  // "Applies on boot" (Pillar 5): every `table`-declaration migration
  // Flyway would otherwise auto-run via `FlywayAutoConfiguration` is
  // instead run from here, explicitly, against the same `@Lazy`
  // `DataSource` beans above (`spring.flyway.enabled: false` in
  // `application.yml` stops Spring's own auto-wiring from resolving
  // them first) -- Pillar 4's "compiler owns the wiring" rule applied
  // to Flyway itself, not only to the connection pool.
  @Bean
  public CommandLineRunner migrateOnBoot(@Qualifier("db") DataSource db) {
    return args -> {
      DataSources.migrate(db);
    };
  }
}
