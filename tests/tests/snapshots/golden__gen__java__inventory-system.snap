system-runner/SystemSimRunner.java
============================================================
// SystemSimRunner.java -- Generated by CIaC (28UpdatePlan.md M8c).
//
// Multi-service scenario-driving simulation runner, generalizing
// SimRunner.java.j2's single-service interpreter across every service
// this system declares -- line-for-line the same architecture as
// system_sim_runner.ts.j2/system_sim_runner.go.j2 (one shared world, one
// process, N per-service application contexts built and torn down
// together). Lives at the system root (`system-runner/SystemSimRunner.
// java`, no package of its own) rather than inside any one service's
// own Maven module: there is no Maven reactor/aggregator pom joining N
// independently-built services (28UpdatePlan.md M8c's own packaging
// decision, "Option B" -- disclosed in `commands.rs`'s own `sim_drive_
// java_multi` doc comment), so this file is compiled directly with
// `javac` against a classpath the driver assembles by concatenating
// every service's own `target/classes`+`target/test-classes` plus each
// service's own Maven dependency jars (`mvn dependency:build-
// classpath`) -- no Maven at all for the *run* phase, matching Python's
// own `PYTHONPATH`-union approach in `multi_driver.py` more closely
// than any of the other four targets' own system-runner needed to.
//
// Every per-service class is referenced by its fully-qualified name,
// never imported -- two services may legitimately declare a worker (or
// job, or handler) with the same simple class name (e.g. two unrelated
// `ProcessWorker`s), and Java's `import` has no `as`-rename escape hatch
// the way TypeScript's `import { X as Y }` gives `system_sim_runner.ts.
// j2` for the identical problem; qualifying every reference by its full
// `com.ciac.<pkg>....` path sidesteps the collision entirely rather
// than risking one.
//
// One shared `com.ciac.simshared.World` (physically duplicated,
// byte-identical, into every service's own source tree -- see World.
// java.j2's own doc comment) is constructed once and registered into
// every service's own per-service `AnnotationConfigApplicationContext`
// under the bean name `"world"`, the same manual-registration `World`
// gets in the single-service `SimRunner`. A `MockMvc` instance is built
// per service from that service's own `@RestController`s; `call
// <Service>.<Api>` steps route through `World.callChecked`, which
// dispatches to a handler this runner registers per (service, api) pair
// against that service's own `MockMvc` -- an api reachable only via a
// routed call from another service (never a scenario `request` step's
// own direct target) still needs an entry here, or that call has no
// handler to route to (mirrors `multi_driver.py`'s and every other
// target's own system-runner api-registration loop).
//
// Deliberately narrow, matching every other generated system-runner's
// own disclosed scope: `publish` steps are not wired; `drain`/`expect.
// quiescence` see one global undelivered-message buffer, not
// independent per-`(subject, group)` cursors across services beyond
// what `World.drainBroker`'s own cursor already gives per subject.
// Structural scenario parsing only (`simulation_version`/non-empty
// `steps`) -- a hand-written restatement of `ciac_sim::scenario::
// Scenario`, the same position every other target's own hand-written
// scenario driver occupies. Any scenario step this runner cannot honor
// is a hard error, never a silently-skipped no-op.

import com.ciac.simshared.World;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.PropertyNamingStrategies;
import com.fasterxml.jackson.datatype.jsr310.JavaTimeModule;
import java.nio.file.Files;
import java.nio.file.Path;
import java.time.Instant;
import java.time.ZoneOffset;
import java.time.ZonedDateTime;
import java.util.ArrayList;
import java.util.Base64;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import org.springframework.context.annotation.AnnotationConfigApplicationContext;
import org.springframework.http.HttpMethod;
import org.springframework.http.MediaType;
import org.springframework.scheduling.support.CronExpression;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.MvcResult;
import org.springframework.test.web.servlet.request.MockMvcRequestBuilders;
import org.springframework.test.web.servlet.setup.MockMvcBuilders;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.bind.annotation.RestControllerAdvice;

public final class SystemSimRunner {
  private SystemSimRunner() {}

  private static final ObjectMapper MAPPER =
      new ObjectMapper()
          .registerModule(new JavaTimeModule())
          .setPropertyNamingStrategy(PropertyNamingStrategies.SNAKE_CASE);

  // 28UpdatePlan.md M8c: table names namespaced `"{service}::{table}"`
  // exactly like `lower.rs`'s own `world_table_key` (and every other
  // target's own multi-service system-runner), so reference/unique/
  // cascade checks can never drift or collide across two same-named
  // tables in different services.
  private static final List<World.WorldTable> WORLD_TABLES = List.of();

  // -- Scenario JSON shape (structural restatement of ciac_sim::scenario) --

  private record Principal(String sub, List<String> scopes) {}

  private record RequestStep(
      String service, String api, JsonNode json, Principal as, String saveAs) {}

  private record PublishStep(String stream, JsonNode json) {}

  private record AdvanceStep(String by) {}

  private record ResponseExpect(String of, Integer status, JsonNode json) {}

  private record RowExpect(
      String service, String table, Map<String, Object> where, boolean present) {}

  private record WorkerAttemptsExpect(String worker, int count) {}

  private record JobRunsExpect(String job, int count) {}

  private record EmailExpect(String to, String subjectContains, int count) {}

  private record CacheExpect(String instance, String key, boolean present, JsonNode value) {}

  private record ObjectExpect(String store, String key, boolean present) {}

  private record SearchHitsExpect(String instance, String query, int count) {}

  private record HttpCallsExpect(String instance, int count) {}

  private record ExpectStep(
      ResponseExpect response,
      RowExpect row,
      WorkerAttemptsExpect workerAttempts,
      JobRunsExpect jobRuns,
      JsonNode quiescence,
      EmailExpect email,
      CacheExpect cache,
      ObjectExpect object,
      SearchHitsExpect searchHits,
      HttpCallsExpect httpCalls) {}

  private record ScenarioStep(
      RequestStep request,
      PublishStep publish,
      AdvanceStep advance,
      JsonNode drain,
      ExpectStep expect) {}

  private record GivenTableRows(String service, String table, List<Map<String, Object>> rows) {}

  private record GivenCacheEntry(String instance, String key, JsonNode value, String ttl) {}

  private record GivenStoreObject(String instance, String key, String valueBase64) {}

  private record GivenSearchDoc(String instance, String id, JsonNode doc) {}

  private record GivenHttpFixture(String instance, List<World.GivenHttpResponse> responses) {}

  private record FailureSelector(String effect, String subject, int occurrence, String phase) {}

  private record FailureAction(String kind) {}

  private record RawFailureRule(FailureSelector at, FailureAction action) {}

  private record Given(
      List<GivenTableRows> db,
      List<GivenCacheEntry> cache,
      List<GivenStoreObject> store,
      List<GivenSearchDoc> search,
      List<GivenHttpFixture> externalHttp,
      List<RawFailureRule> failures) {}

  private record Scenario(
      int simulationVersion, String name, String startAt, Given given, List<ScenarioStep> steps) {}

  private record SimScenarioOutcome(
      String scenario,
      boolean passed,
      String error,
      Map<String, Integer> workerAttempts,
      Map<String, Integer> jobRuns) {}

  private record SavedResponse(int status, JsonNode json) {}

  private record ApiRoute(String method, String path) {}

  private static final Map<String, ApiRoute> API_ROUTES = new HashMap<>();

  static {
    API_ROUTES.put("Catalog.Price", new ApiRoute("POST", "/price"));
    API_ROUTES.put("Catalog.Restock", new ApiRoute("POST", "/restock"));
    API_ROUTES.put("Gateway.Quote", new ApiRoute("POST", "/quote"));
  }

  /**
   * Only the `error` action / `after` phase is implemented -- the same disclosed subset every other
   * generated runner's own `FailureEngine` integration carries. Refused up front rather than
   * silently ignored if a scenario asks for anything else.
   */
  private static List<World.FailureRule> toFailureRules(List<RawFailureRule> raw) {
    List<World.FailureRule> out = new ArrayList<>();
    for (RawFailureRule r : raw) {
      if (!"error".equals(r.action().kind())) {
        throw new RuntimeException(
            "failure rule for effect \""
                + r.at().effect()
                + "\" uses action \""
                + r.action().kind()
                + "\", which this system-runner's FailureEngine integration does not support yet"
                + " (only `error` is implemented)");
      }
      if (!"after".equals(r.at().phase())) {
        throw new RuntimeException(
            "failure rule for effect \""
                + r.at().effect()
                + "\" uses phase \""
                + r.at().phase()
                + "\", which this system-runner's FailureEngine integration does not support yet"
                + " (only `after` is implemented)");
      }
      String subject = r.at().subject() != null ? r.at().subject() : "";
      out.add(new World.FailureRule(r.at().effect(), subject, r.at().occurrence()));
    }
    return out;
  }

  private static final Pattern DURATION_RE = Pattern.compile("^(\\d+)(ms|s|m|h|d)$");
  private static final Map<String, Long> UNIT_MS =
      Map.of("ms", 1L, "s", 1_000L, "m", 60_000L, "h", 3_600_000L, "d", 86_400_000L);

  /**
   * Parses `advance.by` strings ("24h", "7d", "30m", ...) -- matches every other generated runner's
   * own `parseDurationMs`/ `parse_duration_ms` exactly.
   */
  private static long parseDurationMs(String text) {
    Matcher m = DURATION_RE.matcher(text);
    if (!m.matches()) {
      throw new RuntimeException("unrecognized duration: \"" + text + "\"");
    }
    return Long.parseLong(m.group(1)) * UNIT_MS.get(m.group(2));
  }

  /** Every cron-due instant in (fromMs, toMs] for schedule. */
  private static List<Long> dueInstants(CronExpression schedule, long fromMs, long toMs) {
    List<Long> out = new ArrayList<>();
    ZonedDateTime cursor = Instant.ofEpochMilli(fromMs).atZone(ZoneOffset.UTC);
    for (int i = 0; i < 100_000; i++) {
      ZonedDateTime next = schedule.next(cursor);
      if (next == null) {
        break;
      }
      long nextMs = next.toInstant().toEpochMilli();
      if (nextMs > toMs) {
        break;
      }
      out.add(nextMs);
      cursor = next;
    }
    return out;
  }

  /**
   * Synthesizes a bearer token from the step's own `as` principal -- matches every other target's
   * own `sim_runner` identically.
   */
  private static SavedResponse request(Map<String, MockMvc> mvcs, World world, RequestStep spec)
      throws Exception {
    ApiRoute route = API_ROUTES.get(spec.service() + "." + spec.api());
    if (route == null) {
      throw new RuntimeException(
          "sim_runner: no api registered for " + spec.service() + "." + spec.api());
    }
    MockMvc mvc = mvcs.get(spec.service());
    var reqBuilder =
        MockMvcRequestBuilders.request(HttpMethod.valueOf(route.method()), route.path());
    if (spec.json() != null) {
      reqBuilder =
          reqBuilder
              .contentType(MediaType.APPLICATION_JSON)
              .content(MAPPER.writeValueAsBytes(spec.json()));
    }
    if (spec.as() != null) {
      List<String> scopes = spec.as().scopes() != null ? spec.as().scopes() : List.of();
      String token = "sim:" + spec.as().sub() + ":" + String.join(",", scopes);
      world.authIssue(
          token, Map.of("sub", spec.as().sub(), "scope", String.join(" ", scopes)), null);
      reqBuilder = reqBuilder.header("Authorization", "Bearer " + token);
    }
    MvcResult result = mvc.perform(reqBuilder).andReturn();
    String content = result.getResponse().getContentAsString();
    JsonNode json = content.isEmpty() ? null : MAPPER.readTree(content);
    return new SavedResponse(result.getResponse().getStatus(), json);
  }

  /**
   * One pass across every service's own workers -- same per-`(subject, group)` cursor semantics as
   * the single-service runner's own `drain`. A subject no registered worker (in *any* service)
   * drains is refused, not left to sit undelivered forever.
   */
  private static void drain(
      Map<String, AnnotationConfigApplicationContext> ctxs,
      World world,
      Map<String, Integer> workerAttempts)
      throws Exception {
    for (World.QueuedMessage msg : world.drainQueue()) {
      boolean delivered = false;
      if (!delivered) {
        throw new RuntimeException(
            "sim_runner: no worker registered to consume subject \""
                + msg.subject()
                + "\" (disclosed scope)");
      }
    }
  }

  private static void advance(
      Map<String, AnnotationConfigApplicationContext> ctxs,
      World world,
      long fromMs,
      long toMs,
      Map<String, Integer> jobRuns)
      throws Exception {
    world.advanceClockTo(toMs);
  }

  private static void expect(
      ExpectStep spec,
      World world,
      Map<String, SavedResponse> saved,
      Map<String, Integer> workerAttempts,
      Map<String, Integer> jobRuns)
      throws Exception {
    if (spec.response() != null) {
      SavedResponse got = saved.get(spec.response().of());
      if (got == null) {
        throw new RuntimeException(
            "expect.response.of references unknown save_as \"" + spec.response().of() + "\"");
      }
      if (spec.response().status() != null && got.status() != spec.response().status()) {
        throw new RuntimeException(
            "expect.response.of=\""
                + spec.response().of()
                + "\": expected status "
                + spec.response().status()
                + ", got "
                + got.status());
      }
      if (spec.response().json() != null && !spec.response().json().equals(got.json())) {
        throw new RuntimeException(
            "expect.response.of=\""
                + spec.response().of()
                + "\": expected json "
                + spec.response().json()
                + ", got "
                + got.json());
      }
    } else if (spec.row() != null) {
      Map<String, Object> where = spec.row().where() != null ? spec.row().where() : Map.of();
      String key = World.namespacedTableKey(spec.row().service(), spec.row().table());
      boolean found = !world.findWhere(key, where).isEmpty();
      if (found != spec.row().present()) {
        throw new RuntimeException(
            "expect.row: service=\""
                + spec.row().service()
                + "\" table=\""
                + spec.row().table()
                + "\" where="
                + where
                + " present="
                + spec.row().present()
                + ", found="
                + found);
      }
    } else if (spec.workerAttempts() != null) {
      int actual = workerAttempts.getOrDefault(spec.workerAttempts().worker(), 0);
      if (actual != spec.workerAttempts().count()) {
        throw new RuntimeException(
            "expect.worker_attempts: worker=\""
                + spec.workerAttempts().worker()
                + "\" expected "
                + spec.workerAttempts().count()
                + ", got "
                + actual);
      }
    } else if (spec.jobRuns() != null) {
      int actual = jobRuns.getOrDefault(spec.jobRuns().job(), 0);
      if (actual != spec.jobRuns().count()) {
        throw new RuntimeException(
            "expect.job_runs: job=\""
                + spec.jobRuns().job()
                + "\" expected "
                + spec.jobRuns().count()
                + ", got "
                + actual);
      }
    } else if (spec.quiescence() != null) {
      if (!world.queueIsEmpty()) {
        throw new RuntimeException(
            "expect.quiescence: undelivered message(s) remain in the simulated broker");
      }
    } else if (spec.email() != null) {
      int actual = world.emailSentCountAll(spec.email().to(), spec.email().subjectContains());
      if (actual != spec.email().count()) {
        throw new RuntimeException(
            "expect.email: to="
                + spec.email().to()
                + " subject_contains="
                + spec.email().subjectContains()
                + " expected "
                + spec.email().count()
                + ", got "
                + actual);
      }
    } else if (spec.cache() != null) {
      String cached = world.cacheGet(spec.cache().instance(), spec.cache().key());
      boolean found = cached != null;
      if (found != spec.cache().present()) {
        throw new RuntimeException(
            "expect.cache: instance=\""
                + spec.cache().instance()
                + "\" key=\""
                + spec.cache().key()
                + "\" expected present="
                + spec.cache().present()
                + ", found present="
                + found);
      }
      if (spec.cache().value() != null) {
        JsonNode actual = found ? MAPPER.readTree(cached) : null;
        if (!spec.cache().value().equals(actual)) {
          throw new RuntimeException(
              "expect.cache: instance=\""
                  + spec.cache().instance()
                  + "\" key=\""
                  + spec.cache().key()
                  + "\" expected value="
                  + spec.cache().value()
                  + ", got "
                  + actual);
        }
      }
    } else if (spec.object() != null) {
      boolean found = world.objectExists(spec.object().store(), spec.object().key());
      if (found != spec.object().present()) {
        throw new RuntimeException(
            "expect.object: store=\""
                + spec.object().store()
                + "\" key=\""
                + spec.object().key()
                + "\" expected present="
                + spec.object().present()
                + ", found present="
                + found);
      }
    } else if (spec.searchHits() != null) {
      int actual =
          world.searchQuery(spec.searchHits().instance(), spec.searchHits().query()).size();
      if (actual != spec.searchHits().count()) {
        throw new RuntimeException(
            "expect.search_hits: instance=\""
                + spec.searchHits().instance()
                + "\" query=\""
                + spec.searchHits().query()
                + "\" expected "
                + spec.searchHits().count()
                + ", got "
                + actual);
      }
    } else if (spec.httpCalls() != null) {
      int actual = world.httpRequestCount(spec.httpCalls().instance());
      if (actual != spec.httpCalls().count()) {
        throw new RuntimeException(
            "expect.http_calls: instance=\""
                + spec.httpCalls().instance()
                + "\" expected "
                + spec.httpCalls().count()
                + ", got "
                + actual);
      }
    } else {
      throw new RuntimeException("sim_runner: unrecognized expect step");
    }
  }

  public static void main(String[] args) throws Exception {
    if (args.length < 1) {
      System.err.println("usage: SystemSimRunner <scenario.json>");
      System.exit(1);
    }
    Scenario sc = MAPPER.readValue(Files.readString(Path.of(args[0])), Scenario.class);
    if (sc.simulationVersion() != 1) {
      System.err.println(
          "scenario simulation_version "
              + sc.simulationVersion()
              + " is not supported (expected 1)");
      System.exit(1);
    }
    if (sc.steps() == null || sc.steps().isEmpty()) {
      System.err.println("scenario has no steps");
      System.exit(1);
    }

    Given given =
        sc.given() != null
            ? sc.given()
            : new Given(List.of(), List.of(), List.of(), List.of(), List.of(), List.of());
    List<World.FailureRule> failureRules =
        toFailureRules(given.failures() != null ? given.failures() : List.of());
    World world = new World(failureRules, WORLD_TABLES);
    for (GivenTableRows seed : given.db() != null ? given.db() : List.<GivenTableRows>of()) {
      String key = World.namespacedTableKey(seed.service(), seed.table());
      for (Map<String, Object> row : seed.rows()) {
        world.seedDb(key, row);
      }
    }

    long nowMs;
    try {
      nowMs = Instant.parse(sc.startAt()).toEpochMilli();
    } catch (Exception e) {
      System.err.println("scenario start_at \"" + sc.startAt() + "\": not a valid date");
      System.exit(1);
      return;
    }
    world.advanceClockTo(nowMs);

    for (GivenCacheEntry entry :
        given.cache() != null ? given.cache() : List.<GivenCacheEntry>of()) {
      Long ttlMs = entry.ttl() != null ? parseDurationMs(entry.ttl()) : null;
      world.cacheSet(
          entry.instance(), entry.key(), MAPPER.writeValueAsString(entry.value()), ttlMs);
    }
    for (GivenStoreObject obj :
        given.store() != null ? given.store() : List.<GivenStoreObject>of()) {
      world.objectPut(obj.instance(), obj.key(), Base64.getDecoder().decode(obj.valueBase64()));
    }
    for (GivenSearchDoc doc : given.search() != null ? given.search() : List.<GivenSearchDoc>of()) {
      world.searchIndex(doc.instance(), doc.id(), MAPPER.writeValueAsString(doc.doc()));
    }
    for (GivenHttpFixture fixture :
        given.externalHttp() != null ? given.externalHttp() : List.<GivenHttpFixture>of()) {
      world.seedHttpFixtures(fixture.instance(), fixture.responses());
    }

    // Constructs every service's own context/MockMvc *before* any
    // scenario step runs, and registers every api of every service
    // on the shared world's call router, in declaration order -- an
    // api reachable only via a routed `call <Service>.<Api>` from
    // another service (never the target of a scenario `request`
    // step in its own right) still needs an entry here or that call
    // has no handler to route to.
    Map<String, AnnotationConfigApplicationContext> ctxs = new HashMap<>();
    Map<String, MockMvc> mvcs = new HashMap<>();
    {
      AnnotationConfigApplicationContext ctx = new AnnotationConfigApplicationContext();
      ctx.scan(
          "com.ciac.catalog.routes",
          "com.ciac.catalog.services",
          "com.ciac.catalog.logic",
          "com.ciac.catalog.state",
          "com.ciac.catalog.workers",
          "com.ciac.catalog.clients");
      if (ctx.containsBeanDefinition("securityConfig")) {
        ctx.removeBeanDefinition("securityConfig");
      }
      ctx.registerBean("world", World.class, () -> world);
      ctx.refresh();
      MockMvc mvc =
          MockMvcBuilders.standaloneSetup(
                  ctx.getBeansWithAnnotation(RestController.class).values().toArray())
              .setControllerAdvice(
                  ctx.getBeansWithAnnotation(RestControllerAdvice.class).values().toArray())
              .build();
      ctxs.put("Catalog", ctx);
      mvcs.put("Catalog", mvc);
      world.registerApi(
          "Catalog",
          "Price",
          req -> {
            try {
              JsonNode body = req == null ? null : MAPPER.valueToTree(req);
              var reqBuilder = MockMvcRequestBuilders.request(HttpMethod.POST, "/price");
              if (body != null) {
                reqBuilder =
                    reqBuilder
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(MAPPER.writeValueAsBytes(body));
              }
              // `mvc` (this per-service block's own local, never
              // reassigned) is effectively final, so the lambda
              // can capture it directly -- no intermediate
              // variable needed (and one would collide across a
              // service's own multiple apis, since every
              // `registerApi` call for this service shares this
              // same enclosing `{ }` block's scope).
              MvcResult result = mvc.perform(reqBuilder).andReturn();
              String content = result.getResponse().getContentAsString();
              if (result.getResponse().getStatus() >= 400) {
                throw new RuntimeException(
                    "routed call to Catalog.Price failed with status "
                        + result.getResponse().getStatus()
                        + ": "
                        + content);
              }
              return content.isEmpty() ? null : MAPPER.readValue(content, Map.class);
            } catch (RuntimeException e) {
              throw e;
            } catch (Exception e) {
              throw new RuntimeException(e);
            }
          });
      world.registerApi(
          "Catalog",
          "Restock",
          req -> {
            try {
              JsonNode body = req == null ? null : MAPPER.valueToTree(req);
              var reqBuilder = MockMvcRequestBuilders.request(HttpMethod.POST, "/restock");
              if (body != null) {
                reqBuilder =
                    reqBuilder
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(MAPPER.writeValueAsBytes(body));
              }
              // `mvc` (this per-service block's own local, never
              // reassigned) is effectively final, so the lambda
              // can capture it directly -- no intermediate
              // variable needed (and one would collide across a
              // service's own multiple apis, since every
              // `registerApi` call for this service shares this
              // same enclosing `{ }` block's scope).
              MvcResult result = mvc.perform(reqBuilder).andReturn();
              String content = result.getResponse().getContentAsString();
              if (result.getResponse().getStatus() >= 400) {
                throw new RuntimeException(
                    "routed call to Catalog.Restock failed with status "
                        + result.getResponse().getStatus()
                        + ": "
                        + content);
              }
              return content.isEmpty() ? null : MAPPER.readValue(content, Map.class);
            } catch (RuntimeException e) {
              throw e;
            } catch (Exception e) {
              throw new RuntimeException(e);
            }
          });
    }
    {
      AnnotationConfigApplicationContext ctx = new AnnotationConfigApplicationContext();
      ctx.scan(
          "com.ciac.gateway.routes",
          "com.ciac.gateway.services",
          "com.ciac.gateway.logic",
          "com.ciac.gateway.state",
          "com.ciac.gateway.workers",
          "com.ciac.gateway.clients");
      if (ctx.containsBeanDefinition("securityConfig")) {
        ctx.removeBeanDefinition("securityConfig");
      }
      ctx.registerBean("world", World.class, () -> world);
      ctx.refresh();
      MockMvc mvc =
          MockMvcBuilders.standaloneSetup(
                  ctx.getBeansWithAnnotation(RestController.class).values().toArray())
              .setControllerAdvice(
                  ctx.getBeansWithAnnotation(RestControllerAdvice.class).values().toArray())
              .build();
      ctxs.put("Gateway", ctx);
      mvcs.put("Gateway", mvc);
      world.registerApi(
          "Gateway",
          "Quote",
          req -> {
            try {
              JsonNode body = req == null ? null : MAPPER.valueToTree(req);
              var reqBuilder = MockMvcRequestBuilders.request(HttpMethod.POST, "/quote");
              if (body != null) {
                reqBuilder =
                    reqBuilder
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(MAPPER.writeValueAsBytes(body));
              }
              // `mvc` (this per-service block's own local, never
              // reassigned) is effectively final, so the lambda
              // can capture it directly -- no intermediate
              // variable needed (and one would collide across a
              // service's own multiple apis, since every
              // `registerApi` call for this service shares this
              // same enclosing `{ }` block's scope).
              MvcResult result = mvc.perform(reqBuilder).andReturn();
              String content = result.getResponse().getContentAsString();
              if (result.getResponse().getStatus() >= 400) {
                throw new RuntimeException(
                    "routed call to Gateway.Quote failed with status "
                        + result.getResponse().getStatus()
                        + ": "
                        + content);
              }
              return content.isEmpty() ? null : MAPPER.readValue(content, Map.class);
            } catch (RuntimeException e) {
              throw e;
            } catch (Exception e) {
              throw new RuntimeException(e);
            }
          });
    }

    Map<String, SavedResponse> saved = new HashMap<>();
    Map<String, Integer> workerAttempts = new HashMap<>();
    Map<String, Integer> jobRuns = new HashMap<>();

    Exception runErr = null;
    for (ScenarioStep step : sc.steps()) {
      try {
        if (step.request() != null) {
          SavedResponse resp = request(mvcs, world, step.request());
          if (step.request().saveAs() != null) {
            saved.put(step.request().saveAs(), resp);
          }
        } else if (step.publish() != null) {
          throw new RuntimeException(
              "sim_runner does not support `publish` steps (disclosed scope)");
        } else if (step.advance() != null) {
          long deltaMs = parseDurationMs(step.advance().by());
          long toMs = nowMs + deltaMs;
          advance(ctxs, world, nowMs, toMs, jobRuns);
          nowMs = toMs;
        } else if (step.drain() != null) {
          drain(ctxs, world, workerAttempts);
        } else if (step.expect() != null) {
          expect(step.expect(), world, saved, workerAttempts, jobRuns);
        } else {
          throw new RuntimeException("sim_runner: unrecognized step");
        }
      } catch (Exception e) {
        runErr = e;
      }
      if (runErr != null) {
        break;
      }
    }
    if (runErr == null) {
      List<String> unmatched = world.unmatchedFailureRules();
      if (!unmatched.isEmpty()) {
        runErr =
            new RuntimeException(
                unmatched.size()
                    + " failure rule(s) declared in `given.failures` never matched a real"
                    + " occurrence: "
                    + unmatched);
      }
    }

    SimScenarioOutcome outcome =
        new SimScenarioOutcome(
            sc.name(),
            runErr == null,
            runErr != null ? runErr.getMessage() : null,
            workerAttempts,
            jobRuns);
    for (AnnotationConfigApplicationContext ctx : ctxs.values()) {
      ctx.close();
    }
    System.out.println(MAPPER.writeValueAsString(outcome));
  }
}
