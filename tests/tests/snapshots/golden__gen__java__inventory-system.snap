// ItemController.java -- Generated by CIaC.
//
// REST endpoints for the Item resource. Responses are
// the raw entity JSON (no `Envelope` wrapper) -- CRUD resources carry
// their own response contract, separate from pipeline `api`s (see
// `ApiController`), matching every other target's own resource routes.
package com.ciac.catalog.routes;

import com.ciac.catalog.schemas.Item;
import com.ciac.catalog.schemas.ItemIn;
import com.ciac.catalog.services.ItemStore;
import com.ciac.simshared.World;
import com.fasterxml.jackson.databind.JsonNode;
import jakarta.servlet.http.HttpServletRequest;
import org.springframework.beans.factory.ObjectProvider;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.security.oauth2.jwt.JwtDecoder;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class ItemController {
  private final ItemStore store;
  // Real in production; `null` under simulation (SimRunner never
  // registers `SecurityConfig`'s own `JwtDecoder` bean at all) --
  // an `ObjectProvider` here, not a hard constructor dependency, is
  // what keeps this controller constructible under `ciac sim`
  // (27UpdatePlan.md M8).
  private final JwtDecoder jwtDecoder;
  // `null` in production; a simulation-run `World` when SimRunner
  // manually registers one -- see `Auth.verifyToken`'s own
  // `if (world != null)` branch (27UpdatePlan.md M8).
  private final World world;

  public ItemController(
      ItemStore store,
      ObjectProvider<JwtDecoder> jwtDecoderProvider,
      ObjectProvider<World> worldProvider) {
    this.store = store;
    this.jwtDecoder = jwtDecoderProvider.getIfAvailable();
    this.world = worldProvider.getIfAvailable();
  }

  @PostMapping("/items")
  public ResponseEntity<Item> create(HttpServletRequest request, @RequestBody JsonNode body) {
    Jwt jwt = Auth.verifyToken(request, jwtDecoder, world);
    ItemIn payload = ItemIn.decode(body);
    return ResponseEntity.status(HttpStatus.CREATED).body(store.create(payload));
  }

  @GetMapping("/items")
  public java.util.List<Item> list(
      HttpServletRequest request,
      @RequestParam(defaultValue = "100") int limit,
      @RequestParam(defaultValue = "0") int offset) {
    Jwt jwt = Auth.verifyToken(request, jwtDecoder, world);
    return store.list(limit, offset);
  }

  @GetMapping("/items/{id}")
  public Item get(HttpServletRequest request, @PathVariable String id) {
    Jwt jwt = Auth.verifyToken(request, jwtDecoder, world);
    return store.get(id).orElseThrow(() -> new NotFoundException("Item not found"));
  }

  @PutMapping("/items/{id}")
  public Item update(
      HttpServletRequest request, @PathVariable String id, @RequestBody JsonNode body) {
    Jwt jwt = Auth.verifyToken(request, jwtDecoder, world);
    ItemIn payload = ItemIn.decode(body);
    return store.update(id, payload).orElseThrow(() -> new NotFoundException("Item not found"));
  }

  @DeleteMapping("/items/{id}")
  public ResponseEntity<Void> delete(HttpServletRequest request, @PathVariable String id) {
    Jwt jwt = Auth.verifyToken(request, jwtDecoder, world);
    if (!store.delete(id)) {
      throw new NotFoundException("Item not found");
    }
    return ResponseEntity.noContent().build();
  }
}
