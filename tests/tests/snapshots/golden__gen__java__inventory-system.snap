// CatalogClient.java -- Generated by CIaC.
//
// Typed HTTP client for the `Catalog` service. `call
// Catalog.<Api>` pipeline steps invoke these methods (see
// `_steps.java.j2`'s own `call` arm). The base URL comes from
// `CATALOG_URL`; the system docker-compose points it at the
// `catalog` container. Unlike Go's own client (manual
// `otel.GetTextMapPropagator().Inject`), `RestClient` requests are
// auto-instrumented by Micrometer Observation the moment the tracing
// starter is on the classpath -- no explicit header propagation code
// needed here.
//
// 28UpdatePlan.md M8b: under simulation, routes through
// `World.callChecked` instead of a real HTTP call -- the same
// `{"status": ..., "data": ...}` envelope every route's own response
// body already carries, so this unwraps `["data"]` from it exactly the
// way the real-HTTP branch unwraps `envelope.get("data")` -- same
// post-processing, different transport (mirrors Go's own
// `client.go.j2` M7c precedent).
package com.ciac.gateway.clients;

import com.ciac.simshared.World;
import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.beans.factory.ObjectProvider;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;
import org.springframework.web.client.RestClient;

@Component
public class CatalogClient {
  private final RestClient client;
  // `null` in production; a simulation-run `World` when SimRunner
  // manually registers one -- see `callChecked`'s own
  // `if (world != null)` branch below.
  private final World world;

  public CatalogClient(
      @Value("${CATALOG_URL:http://localhost:8000}") String baseUrl,
      ObjectProvider<World> worldProvider) {
    this.client = RestClient.create(baseUrl);
    this.world = worldProvider.getIfAvailable();
  }

  public Object price(Object payload) {
    if (world != null) {
      Object result = world.callChecked("Gateway", "Catalog", "Price", payload);
      if (result instanceof java.util.Map<?, ?> envelope) {
        return envelope.get("data");
      }
      return result;
    }
    JsonNode envelope =
        client
            .method(org.springframework.http.HttpMethod.POST)
            .uri("/price")
            .header("Content-Type", "application/json")
            .body(payload)
            .retrieve()
            .body(JsonNode.class);
    return envelope.get("data");
  }
}
