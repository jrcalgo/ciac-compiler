// Item.java -- Generated by CIaC.
package com.ciac.catalog.schemas;

import com.fasterxml.jackson.databind.JsonNode;

public record Item(String id, String name) {
  /** Decode with absent/null/zero distinction (shared wire contract). */
  public static Item decode(JsonNode body) {
    Schemas.requireKeys(body, "id", "name");
    Item out = Schemas.MAPPER.convertValue(body, Item.class);
    Schemas.requireUuid("id", out.id());
    return out;
  }
