  // `if (world != null)` branch (27UpdatePlan.md M8).
  private final World world;
  private final ComputeRestock computeRestock;

  public RestockController(
      AppState state,
      ObjectProvider<JwtDecoder> jwtDecoderProvider,
      ObjectProvider<World> worldProvider,
      ComputeRestock computeRestock) {
    this.state = state;
    this.jwtDecoder = jwtDecoderProvider.getIfAvailable();
    this.world = worldProvider.getIfAvailable();
    this.computeRestock = computeRestock;
  }

  @RequestMapping(method = RequestMethod.POST, path = "/restock")
  public Envelope restock(HttpServletRequest request, @RequestBody JsonNode body) throws Exception {
    Jwt jwt = Auth.verifyToken(request, jwtDecoder, world);
    Auth.requireScope(jwt, "catalog:restock");
    Object result = Item.decode(body);

    result = computeRestock.handle(result);

    return Envelope.accepted(result);
  }
}
