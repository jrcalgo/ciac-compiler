// Auth.java -- Generated by CIaC.
//
// `verifyToken`/`requireScope` are called inline at the top of each
// generated route handler body (mirroring every other target's own
// inline-in-route-body placement, not a middleware/security-filter-
// chain check) -- `UnauthorizedException`/`ForbiddenException` flow
// through the same `ErrorAdvice` every other error already does, so
// no separate auth error-mapping layer is needed. `JwtDecoder`
// (Spring's own resource-server starter) does the actual signature/
// issuer/audience verification; this class only extracts the bearer
// token and checks the verified claims' scope.
//
// World-guarded (27UpdatePlan.md M8): under simulation, the real
// `JwtDecoder` is never called at all -- its own `@Lazy` construction
// never dials the issuer/JWKS endpoint, but `decode(token)` itself
// would, and a `SimRunner`-synthesized token (`World.authIssue`) is
// never really signed anyway. `World.authVerify`'s claims-lookup
// (Python's own FakeAuth: claims-lookup, not real JWT/JWKS crypto)
// feeds a real Spring Security `Jwt` instance built directly via its
// own builder, so `requireScope`'s own `getClaimAsString`/
// `getClaimAsStringList` calls work identically regardless of path.
package com.ciac.gateway.routes;

import com.ciac.simshared.World;
import jakarta.servlet.http.HttpServletRequest;
import java.util.List;
import java.util.Map;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.security.oauth2.jwt.JwtDecoder;
import org.springframework.security.oauth2.jwt.JwtException;

public final class Auth {
  private Auth() {}

  public static Jwt verifyToken(HttpServletRequest request, JwtDecoder decoder, World world) {
    String header = request.getHeader("Authorization");
    if (header == null || !header.startsWith("Bearer ")) {
      throw new UnauthorizedException("missing bearer token");
    }
    String token = header.substring("Bearer ".length());
    if (world != null) {
      try {
        Map<String, Object> claims = world.authVerify(token);
        return Jwt.withTokenValue(token)
            .header("alg", "none")
            .claims(c -> c.putAll(claims))
            .build();
      } catch (RuntimeException e) {
        throw new UnauthorizedException("invalid or expired token");
      }
    }
    try {
      return decoder.decode(token);
    } catch (JwtException e) {
      throw new UnauthorizedException("invalid or expired token");
    }
  }

  // Checks the `scope` (space-joined string) or `scp` (array) claim
  // -- mirroring every other target's own two-shape check, since
  // both conventions appear across real issuers.
  public static void requireScope(Jwt jwt, String scope) {
    String spaceJoined = jwt.getClaimAsString("scope");
    if (spaceJoined != null) {
      for (String s : spaceJoined.split("\\s+")) {
        if (s.equals(scope)) {
          return;
        }
      }
    }
    List<String> array = jwt.getClaimAsStringList("scp");
    if (array != null && array.contains(scope)) {
      return;
    }
    throw new ForbiddenException("missing required scope: " + scope);
  }
}
