// PriceController.java -- Generated by CIaC.
//
// Pipeline: Price.
package com.ciac.catalog.routes;

import com.ciac.catalog.schemas.Item;
import com.ciac.catalog.services.ComputePrice;
import com.ciac.catalog.state.AppState;
import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class PriceController {
  private final AppState state;
  private final ComputePrice computePrice;

  public PriceController(AppState state, ComputePrice computePrice) {
    this.state = state;
    this.computePrice = computePrice;
  }

  @RequestMapping(method = RequestMethod.POST, path = "/price")
  public Envelope price(@RequestBody JsonNode body) throws Exception {
    Object result = Item.decode(body);

    result = computePrice.handle(result);

    return Envelope.accepted(result);
  }
}
