// QuoteController.java -- Generated by CIaC.
//
// Pipeline: Quote.
package com.ciac.gateway.routes;

import com.ciac.gateway.clients.CatalogClient;
import com.ciac.gateway.schemas.Item;
import com.ciac.gateway.state.AppState;
import com.ciac.simshared.World;
import com.fasterxml.jackson.databind.JsonNode;
import jakarta.servlet.http.HttpServletRequest;
import org.springframework.beans.factory.ObjectProvider;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.security.oauth2.jwt.JwtDecoder;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class QuoteController {
  private final AppState state;
  // Real in production; `null` under simulation (SimRunner never
  // registers `SecurityConfig`'s own `JwtDecoder` bean at all --
  // `Auth.verifyToken`'s own `world != null` branch never reaches
  // it, so an `ObjectProvider` here, not a hard constructor
  // dependency, is what keeps this controller constructible at all
  // (27UpdatePlan.md M8).
  private final JwtDecoder jwtDecoder;
  // `null` in production; a simulation-run `World` when SimRunner
  // manually registers one -- see `Auth.verifyToken`'s own
  // `if (world != null)` branch (27UpdatePlan.md M8).
  private final World world;
  private final CatalogClient catalogClient;

  public QuoteController(
      AppState state,
      ObjectProvider<JwtDecoder> jwtDecoderProvider,
      ObjectProvider<World> worldProvider,
      CatalogClient catalogClient) {
    this.state = state;
    this.jwtDecoder = jwtDecoderProvider.getIfAvailable();
    this.world = worldProvider.getIfAvailable();
    this.catalogClient = catalogClient;
  }

  @RequestMapping(method = RequestMethod.POST, path = "/quote")
  public Envelope quote(HttpServletRequest request, @RequestBody JsonNode body) throws Exception {
    Jwt jwt = Auth.verifyToken(request, jwtDecoder, world);
    Auth.requireScope(jwt, "gateway:quote");
    Object result = Item.decode(body);

    result = catalogClient.price(result);

    return Envelope.accepted(result);
  }
}
