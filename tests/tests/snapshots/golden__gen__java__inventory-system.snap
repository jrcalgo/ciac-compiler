// ItemStore.java -- Generated by CIaC.
//
// Persistence for the Item resource.
package com.ciac.catalog.services;

import com.ciac.catalog.schemas.Item;
import com.ciac.catalog.schemas.ItemIn;
import com.ciac.catalog.schemas.RowMappers;
import java.util.List;
import java.util.Optional;
import java.util.UUID;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.jdbc.core.simple.JdbcClient;
import org.springframework.stereotype.Component;

@Component
public class ItemStore {
  private final JdbcClient jdbc;

  public ItemStore(@Qualifier("dbJdbc") JdbcClient jdbc) {
    this.jdbc = jdbc;
  }

  public Item create(ItemIn payload) {
    String id = UUID.randomUUID().toString();
    jdbc.sql("INSERT INTO items (id, name) VALUES (?, ?)").param(id).param(payload.name()).update();
    return new Item(id, payload.name());
  }

  public Optional<Item> get(String id) {
    return jdbc.sql("SELECT id, name FROM items WHERE id = ?")
        .param(id)
        .query(RowMappers.ITEM)
        .optional();
  }

  public List<Item> list(int limit, int offset) {
    return jdbc.sql("SELECT id, name FROM items ORDER BY id LIMIT ? OFFSET ?")
        .param(limit)
        .param(offset)
        .query(RowMappers.ITEM)
        .list();
  }

  public Optional<Item> update(String id, ItemIn payload) {
    int n =
        jdbc.sql("UPDATE items SET name = ? WHERE id = ?").param(payload.name()).param(id).update();
    if (n == 0) {
      return Optional.empty();
    }
    return Optional.of(new Item(id, payload.name()));
  }

  public boolean delete(String id) {
    int n = jdbc.sql("DELETE FROM items WHERE id = ?").param(id).update();
    return n > 0;
  }
}
