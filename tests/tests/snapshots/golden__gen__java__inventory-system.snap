<?xml version="1.0" encoding="UTF-8"?>
<!-- pom.xml — Generated by CIaC. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.ciac</groupId>
  <artifactId>catalog</artifactId>
  <version>0.0.1</version>
  <packaging>jar</packaging>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <spotless.version>2.43.0</spotless.version>
    <!-- Not managed by spring-boot-dependencies' own BOM, so pinned
         explicitly here (SimRunner's own `test-compile exec:java`
         driver, 25UpdatePlan.md M9, gate broadened to the full
         8-condition check at 27UpdatePlan.md M8). -->
    <exec-maven-plugin.version>3.4.1</exec-maven-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Flyway 10 split per-database support out of `flyway-core`
         (only H2/SQLite still detect with core alone): found live,
         `flyway-core` alone throws "Unsupported Database: PostgreSQL"
         at `migrateOnBoot`, the first M3 example to actually run
         Flyway against a real local Postgres (M2's own live proof
         only ever exercised SQLite). -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Drives `SimRunner` (25UpdatePlan.md M9, broadened to the
           full 8-condition check at 27UpdatePlan.md M8, matching
           `World.java`'s/`SimRunner.java`'s own emission gate in
           `lib.rs`): a test-scoped
           `main`, not the packaged application, since `MockMvc`/
           `spring-test` only ever sit on the `test` classpath.
           Running it via `test-compile exec:java` (build once, then
           one `exec:java` invocation per scenario) mirrors every
           other target's own "compile once, run the driver once per
           scenario" shape (Go's `go build` then `go run`; Rust's
           `cargo build` then a scoped `cargo run`; TypeScript's
           `npm run build` then `node dist/sim_runner.js`) without
           packaging a second artifact of its own. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <configuration>
          <mainClass>com.ciac.catalog.sim.SimRunner</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
