docker-compose.yml
============================================================
services:

  catalog:
    build: ./catalog
    ports:
      - "8000:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      DATABASE_URL: jdbc:postgresql://postgres:postgres@catalog-db:5432/catalog
      REDIS_URL: redis://catalog-cache:6379/0
      JWT_SECRET: ${JWT_SECRET:-change-me}
    depends_on:
      catalog-db:
        condition: service_healthy
      catalog-cache:
        condition: service_healthy

  gateway:
    build: ./gateway
    ports:
      - "8001:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      CATALOG_URL: http://catalog:8000
      JWT_SECRET: ${JWT_SECRET:-change-me}

  catalog-db:
    image: postgres:16
    ports:
      - "5432:5432"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: catalog
    volumes:
      - catalog-db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 2s
      timeout: 3s
      retries: 20

  catalog-cache:
    image: redis:7
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 2s
      timeout: 3s
      retries: 20

volumes:
  catalog-db-data:
