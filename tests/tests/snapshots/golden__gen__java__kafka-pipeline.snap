# application.yml -- Generated by CIaC.
server:
  port: 8000

spring:
  main:
    banner-mode: "off"
  kafka:
    # Unlike `flyway.enabled`/the `DataSource` beans above,
    # `@KafkaListener` containers poll the broker on their own
    # background threads -- an unreachable broker blocks that
    # thread's consumer loop, not the context refresh itself, so
    # boot with no local broker still succeeds (disclosed forward
    # risk, unverified live here: no local broker in this sandbox).
    bootstrap-servers: ${KAFKA_URL:localhost:9092}
  threads:
    virtual:
      # Loom virtual threads (standard since Java 21): generated
      # handlers stay plain blocking imperative Java -- no Reactor
      # types leaking into seeded user stubs -- while still scaling
      # I/O-bound workloads (25UpdatePlan.md Pillar 1's framework
      # decision).
      enabled: true

management:
  endpoints:
    web:
      exposure:
        include: []

logging:
  level:
    root: INFO
