// Click.java -- Generated by CIaC.
package com.ciac.clickstream.schemas;

import com.fasterxml.jackson.databind.JsonNode;

public record Click(String id, String page) {
  /** Decode with absent/null/zero distinction (shared wire contract). */
  public static Click decode(JsonNode body) {
    Schemas.requireKeys(body, "id", "page");
    Click out = Schemas.MAPPER.convertValue(body, Click.class);
    Schemas.requireUuid("id", out.id());
    return out;
  }
}
