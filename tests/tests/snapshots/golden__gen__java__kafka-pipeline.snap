# Dockerfile -- Generated by CIaC.
#
# Builds through the committed wrapper (./mvnw), not the base image's
# own `mvn` -- the wrapper is what a developer's machine and CI both
# run too (Pillar 8), so the image build exercises the exact same
# pinned-Maven-version path they do, not a second, divergent one.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
COPY mvnw .
COPY .mvn .mvn
RUN chmod +x mvnw && ./mvnw -q -B dependency:go-offline
COPY src src
RUN ./mvnw -q -B -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/target/app.jar /app/app.jar
EXPOSE 8000
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
