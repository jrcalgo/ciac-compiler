// IngestController.java -- Generated by CIaC.
//
// Pipeline: Ingest.
package com.ciac.clickstream.routes;

import com.ciac.clickstream.schemas.Click;
import com.ciac.clickstream.state.AppState;
import com.ciac.clickstream.state.Queue;
import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class IngestController {
  private final AppState state;
  private final Queue queue;

  public IngestController(AppState state, Queue queue) {
    this.state = state;
    this.queue = queue;
  }

  @RequestMapping(method = RequestMethod.POST, path = "/clicks")
  public Envelope ingest(@RequestBody JsonNode body) throws Exception {
    Object result = Click.decode(body);

    queue.publishJson("clickstream.clicks", result);

    return Envelope.accepted(result);
  }
}
