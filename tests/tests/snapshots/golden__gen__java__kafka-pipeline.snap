src/main/java/com/ciac/clickstream/state/Queue.java
============================================================
// Queue.java -- Generated by CIaC.
//
// Broker access (kafka). Publish goes through a client
// connected lazily on first use for both engines -- NATS's usual
// shape (`Nats.connect` dials synchronously), but a deliberate choice
// for Kafka too, applied proactively rather than rediscovered: Go's
// own 24UpdatePlan.md M3 found (via `goleak` against a real,
// unreachable broker) that franz-go's client starts supervisory
// goroutines immediately on construction despite never dialing --
// the official Java Kafka producer client carries the analogous risk
// (a background sender thread starts at construction), so this
// Queue's Kafka producer is guarded the identical way NATS's
// connection already has to be, keeping `AppState` construction
// infrastructure-free regardless of engine.
package com.ciac.clickstream.state;

import com.fasterxml.jackson.databind.ObjectMapper;
import java.util.Map;
import java.util.Properties;
import java.util.concurrent.TimeUnit;
import org.apache.kafka.clients.producer.KafkaProducer;
import org.apache.kafka.clients.producer.ProducerRecord;
import org.apache.kafka.common.header.internals.RecordHeader;
import org.apache.kafka.common.serialization.ByteArraySerializer;
import org.apache.kafka.common.serialization.StringSerializer;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;

// A standalone `@Component` (not one of `AppState`'s own `@Bean`
// factory methods, unlike `DataSource`/`JdbcClient`): a
// `@Configuration` class cannot inject a bean its own `@Bean` method
// produces, so `Queue` is constructor-injected directly into every
// `ApiController`/`Worker`/`Job`/`Channel` that needs it instead of
// being reached through `AppState`.
@Component
public final class Queue {
  private static final ObjectMapper MAPPER = new ObjectMapper();
  private final String url;
  private volatile KafkaProducer<String, byte[]> producer;

  public Queue(@Value("${KAFKA_URL:localhost:9092}") String url) {
    this.url = url;
  }

  private synchronized KafkaProducer<String, byte[]> producer() {
    if (producer == null) {
      Properties props = new Properties();
      props.put("bootstrap.servers", url);
      props.put("key.serializer", StringSerializer.class.getName());
      props.put("value.serializer", ByteArraySerializer.class.getName());
      producer = new KafkaProducer<>(props);
    }
    return producer;
  }

  /**
   * Sends payload to subject (a Kafka topic). Bounded to 5s -- mirrors Go's own rdkafka {@code
   * message.timeout.ms=5000} finding: an unbounded {@code get()} against an unreachable broker
   * would otherwise hang the calling request past any sane client timeout.
   */
  public void publish(String subject, byte[] payload, Map<String, String> headers)
      throws Exception {
    ProducerRecord<String, byte[]> record = new ProducerRecord<>(subject, payload);
    if (headers != null) {
      headers.forEach((k, v) -> record.headers().add(new RecordHeader(k, v.getBytes())));
    }
    producer().send(record).get(5, TimeUnit.SECONDS);
  }

  /**
   * Marshals v and publishes it -- the shared call site every generated pipeline `publish` step
   * goes through.
   */
  public void publishJson(String subject, Object v) {
    try {
      publish(subject, MAPPER.writeValueAsBytes(v), null);
    } catch (Exception e) {
      throw new RuntimeException("publishing to " + subject, e);
    }
  }
}
