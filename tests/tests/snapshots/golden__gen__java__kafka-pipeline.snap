// EnrichWorker.java -- Generated by CIaC.
// Broker consumer for `worker Enrich`.
//
// Consumes clickstream.clicks in queue group enrich
// so replicas of this worker load-balance messages between them.
package com.ciac.clickstream.workers;

import com.ciac.clickstream.schemas.Click;
import com.ciac.clickstream.services.EnrichClick;
import com.ciac.clickstream.state.Queue;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.kafka.annotation.KafkaListener;
import org.springframework.stereotype.Component;

@Component
public class EnrichWorker {
  public static final String SUBJECT = "clickstream.clicks";
  public static final String QUEUE_GROUP = "enrich";
  public static final int CONCURRENCY = 1;
  public static final int MAX_RETRIES = 0;

  private static final Logger log = LoggerFactory.getLogger(EnrichWorker.class);
  private static final ObjectMapper MAPPER = new ObjectMapper();

  private final Queue queue;
  private final EnrichClick enrichClick;

  public EnrichWorker(Queue queue, EnrichClick enrichClick) {
    this.queue = queue;
    this.enrichClick = enrichClick;
  }

  /**
   * Runs the pipeline exactly once, no retry/backoff wrapper -- the seam a future simulation runner
   * drives directly with its own attempt counting, mirroring {@code handleMessageOnce} in every
   * other target's own worker.
   */
  public void handleMessageOnce(Object payload) throws Exception {
    Object result = payload;

    result = enrichClick.handle(result);
    java.util.Objects.requireNonNull(result);
  }

  private void handleMessage(Object payload) {
    Exception last = null;
    for (int attempt = 0; attempt <= MAX_RETRIES; attempt++) {
      try {
        handleMessageOnce(payload);
        return;
      } catch (Exception e) {
        last = e;
        if (attempt < MAX_RETRIES) {
          log.warn("message processing failed; retrying (attempt {})", attempt, e);
        }
      }
    }
    log.error("message processing failed after all retries", last);
  }

  private Object decode(byte[] raw) {
    try {
      return MAPPER.readValue(raw, Click.class);
    } catch (Exception e) {
      log.warn("discarding malformed message", e);
      return null;
    }
  }

  // `spring-kafka` listener container (Pillar 6): `groupId` = the
  // queue group, container `concurrency` = `worker.concurrency` --
  // manual-immediate ack after successful handling only, so a
  // failed message (after exhausting retries) is still acked rather
  // than redelivered forever (at-least-once with a bounded retry
  // budget, the v0.11 M3 contract every earlier target already
  // carries). The listener container auto-starts during context
  // refresh and polls the broker on its own background thread --
  // unlike `DataSource`/`Connection`, an unreachable broker blocks
  // that background poll loop rather than the boot sequence itself,
  // so this does not need the `@Lazy`/`ApplicationReadyEvent`
  // discipline M2's `DataSource` and NATS's `Connection` both need;
  // disclosed, unverified live -- no Kafka broker exists in this
  // sandbox to confirm, CI-delegated the same way broker-delivery
  // itself already is.
  @KafkaListener(topics = SUBJECT, groupId = QUEUE_GROUP, concurrency = "" + CONCURRENCY)
  public void onMessage(byte[] raw) {
    Object payload = decode(raw);
    if (payload == null) {
      return;
    }
    handleMessage(payload);
  }
}
