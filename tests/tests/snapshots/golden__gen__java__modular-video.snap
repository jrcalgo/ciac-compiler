// UploadController.java -- Generated by CIaC.
//
// Pipeline: Upload.
package com.ciac.modularvideo.routes;

import com.ciac.modularvideo.logic.StoreVideo;
import com.ciac.modularvideo.schemas.Video;
import com.ciac.modularvideo.state.AppState;
import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class UploadController {
  private final AppState state;
  private final StoreVideo storeVideo;

  public UploadController(AppState state, StoreVideo storeVideo) {
    this.state = state;
    this.storeVideo = storeVideo;
  }

  @RequestMapping(method = RequestMethod.POST, path = "/videos")
  public Envelope upload(@RequestBody JsonNode body) throws Exception {
    Object result = Video.decode(body);

    result = storeVideo.handle((Video) result);

    return Envelope.accepted(result);
  }
}
