// BillingClient.java -- Generated by CIaC.
//
// Typed HTTP client for the `Billing` service. `call
// Billing.<Api>` pipeline steps invoke these methods (see
// `_steps.java.j2`'s own `call` arm). The base URL comes from
// `BILLING_URL`; the system docker-compose points it at the
// `billing` container. Unlike Go's own client (manual
// `otel.GetTextMapPropagator().Inject`), `RestClient` requests are
// auto-instrumented by Micrometer Observation the moment the tracing
// starter is on the classpath -- no explicit header propagation code
// needed here.
package com.ciac.uploadapi.clients;

import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;
import org.springframework.web.client.RestClient;

@Component
public class BillingClient {
  private final RestClient client;

  public BillingClient(@Value("${BILLING_URL:http://localhost:8000}") String baseUrl) {
    this.client = RestClient.create(baseUrl);
  }

  public Object charge(Object payload) {
    JsonNode envelope =
        client
            .method(org.springframework.http.HttpMethod.POST)
            .uri("/charge")
            .header("Content-Type", "application/json")
            .body(payload)
            .retrieve()
            .body(JsonNode.class);
    return envelope.get("data");
  }
}
