// UploadController.java -- Generated by CIaC.
//
// Pipeline: Upload.
package com.ciac.uploadapi.routes;

import com.ciac.uploadapi.clients.BillingClient;
import com.ciac.uploadapi.schemas.Video;
import com.ciac.uploadapi.services.StoreVideo;
import com.ciac.uploadapi.state.AppState;
import com.ciac.uploadapi.state.Queue;
import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class UploadController {
  private final AppState state;
  private final Queue queue;
  private final StoreVideo storeVideo;
  private final BillingClient billingClient;

  public UploadController(
      AppState state, Queue queue, StoreVideo storeVideo, BillingClient billingClient) {
    this.state = state;
    this.queue = queue;
    this.storeVideo = storeVideo;
    this.billingClient = billingClient;
  }

  @RequestMapping(method = RequestMethod.PUT, path = "/videos")
  public Envelope upload(@RequestBody JsonNode body) throws Exception {
    Object result = Video.decode(body);

    result = billingClient.charge(result);

    result = storeVideo.handle(result);

    queue.publishJson("media_system.uploaded", result);

    return Envelope.accepted(result);
  }
}
