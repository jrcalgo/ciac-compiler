      },
      "VideoStatus": {
        "enum": [
          "Ready",
          "Failed"
        ],
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Notifier",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Liveness check."
          }
        }
      }
    }
  }
}
