// Email.java -- Generated by CIaC.
//
// SMTP sender (Spring's `JavaMailSenderImpl`), one instance per
// declared `email` (mirrors Go's own `email.Email` shape -- both
// `SMTP` and `SES` providers send over SMTP; for SES, point the
// `SMTP_*` variables at your SES SMTP endpoint and credentials).
// Holds configuration only -- `JavaMailSenderImpl` opens no
// connection until `send` is called, so an `Email` bean never blocks
// `AppState` construction. Defaults target the Mailpit container from
// the generated docker-compose, so sent mail is inspectable at
// http://localhost:8025.
package com.ciac.notifier.state;

import org.springframework.mail.SimpleMailMessage;
import org.springframework.mail.javamail.JavaMailSenderImpl;

public final class Email {
  private final String host;
  private final int port;
  private final String username;
  private final String password;
  private final String from;
  private final boolean useTls;

  public Email(
      String host, int port, String username, String password, String from, boolean useTls) {
    this.host = host;
    this.port = port;
    this.username = username;
    this.password = password;
    this.from = from;
    this.useTls = useTls;
  }

  private JavaMailSenderImpl sender() {
    JavaMailSenderImpl sender = new JavaMailSenderImpl();
    sender.setHost(host);
    sender.setPort(port);
    if (!username.isEmpty()) {
      sender.setUsername(username);
      sender.setPassword(password);
    }
    if (useTls) {
      sender.getJavaMailProperties().setProperty("mail.smtp.starttls.enable", "true");
    }
    return sender;
  }

  public void send(String to, String subject, String body) {
    SimpleMailMessage message = new SimpleMailMessage();
    message.setFrom(from);
    message.setTo(to);
    message.setSubject(subject);
    message.setText(body);
    sender().send(message);
  }
}
