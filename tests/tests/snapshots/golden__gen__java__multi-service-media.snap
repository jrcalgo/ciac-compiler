// NoInfraBootTest.java -- Generated by CIaC.
//
// Pillar 4's magic detector: boots the full application context with
// no reachable infrastructure and asserts clean startup. If ANY bean
// eagerly connects to a database/cache/broker (a classic Spring
// failure mode when a starter sneaks in), this test fails -- lazy
// init as a permanently TESTED property on every `mvnw verify`
// forever, the same bar v0.17 M11 retrofitted onto Rust and every
// later target has built in from milestone one.
package com.ciac.notifier;

import static org.assertj.core.api.Assertions.assertThat;

import org.junit.jupiter.api.Test;
import org.springframework.boot.test.context.SpringBootTest;

@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
class NoInfraBootTest {
  @Test
  void contextLoadsWithNoInfrastructureReachable() {
    // The context loading successfully (no exception thrown before
    // this method body even runs) IS the proof -- an eagerly
    // connecting bean would fail application startup, not this
    // assertion. Kept non-empty so a future refactor can't
    // silently turn this into a no-op test.
    assertThat(true).isTrue();
  }
}
