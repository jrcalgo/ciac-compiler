// ProgressChannel.java -- Generated by CIaC.
// Realtime channel `Progress`.
package com.ciac.progressfeed.routes;

import com.ciac.progressfeed.schemas.Video;
import com.ciac.progressfeed.state.Queue;
import com.fasterxml.jackson.databind.ObjectMapper;
import io.nats.client.Dispatcher;
import java.io.IOException;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Component;
import org.springframework.web.socket.CloseStatus;
import org.springframework.web.socket.TextMessage;
import org.springframework.web.socket.WebSocketSession;
import org.springframework.web.socket.config.annotation.WebSocketConfigurer;
import org.springframework.web.socket.config.annotation.WebSocketHandlerRegistry;
import org.springframework.web.socket.handler.TextWebSocketHandler;

// payloadText validates raw as this channel's payload shape and
// re-marshals it, dropping (returning null for) anything malformed
// rather than forwarding it to connected clients -- the same
// validate-then-forward discipline every other target's own channel
// template applies.
//
// NATS-only this milestone: a Kafka channel needs a fresh consumer
// group per connection (Go's own precedent for the identical reason),
// which spring-kafka's declarative `@KafkaListener` can't express --
// no 25UpdatePlan.md M3 example combines `queue Kafka` with a
// `channel`, so this is deferred rather than built against nothing
// reachable; `supports()` does not yet gate this combination out
// explicitly, disclosed here as the reason it would fail to compile
// if it ever became reachable before this gap is closed.

@Component
public class ProgressChannel extends TextWebSocketHandler implements WebSocketConfigurer {
  public static final String SUBJECT = "media_system.transcoded";
  public static final String PATH = "/channels/progress";

  private static final Logger log = LoggerFactory.getLogger(ProgressChannel.class);
  private static final ObjectMapper MAPPER = new ObjectMapper();

  private final Queue queue;
  private final Map<String, Dispatcher> dispatchers = new ConcurrentHashMap<>();

  public ProgressChannel(Queue queue) {
    this.queue = queue;
  }

  @Override
  public void registerWebSocketHandlers(WebSocketHandlerRegistry registry) {
    registry.addHandler(this, PATH).setAllowedOrigins("*");
  }

  @Override
  public void afterConnectionEstablished(WebSocketSession session) throws Exception {
    // NATS delivers a copy of every message on a plain (non-group)
    // subscription to every subscriber -- that alone is this
    // channel's whole fan-out mechanism, no app-level broadcast
    // bookkeeping needed, matching every other target's own choice.
    Dispatcher dispatcher =
        queue
            .natsConnection()
            .createDispatcher(
                msg -> {
                  byte[] data = payloadText(msg.getData());
                  if (data == null) {
                    return;
                  }
                  try {
                    session.sendMessage(
                        new TextMessage(new String(data, java.nio.charset.StandardCharsets.UTF_8)));
                  } catch (IOException e) {
                    log.debug("channel Progress: send failed, dropping", e);
                  }
                });
    dispatcher.subscribe(SUBJECT);
    dispatchers.put(session.getId(), dispatcher);
  }

  @Override
  public void afterConnectionClosed(WebSocketSession session, CloseStatus status) {
    Dispatcher dispatcher = dispatchers.remove(session.getId());
    if (dispatcher != null) {
      dispatcher.unsubscribe(SUBJECT);
    }
  }

  private byte[] payloadText(byte[] raw) {
    try {
      Video payload = MAPPER.readValue(raw, Video.class);
      return MAPPER.writeValueAsBytes(payload);
    } catch (Exception e) {
      return null;
    }
  }
}
