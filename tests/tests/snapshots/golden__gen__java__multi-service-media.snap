// ChargeController.java -- Generated by CIaC.
//
// Pipeline: Charge.
package com.ciac.billing.routes;

import com.ciac.billing.schemas.Video;
import com.ciac.billing.services.CapturePayment;
import com.ciac.billing.state.AppState;
import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class ChargeController {
  private final AppState state;
  private final CapturePayment capturePayment;

  public ChargeController(AppState state, CapturePayment capturePayment) {
    this.state = state;
    this.capturePayment = capturePayment;
  }

  @RequestMapping(method = RequestMethod.POST, path = "/charge")
  public Envelope charge(@RequestBody JsonNode body) throws Exception {
    Object result = Video.decode(body);

    result = capturePayment.handle(result);

    return Envelope.accepted(result);
  }
}
