src/test/java/com/ciac/oauthecho/routes/OAuthRigTests.java
============================================================
// OAuthRigTests.java -- Generated behavioral test for the no-infra
// OAuth2 scope rig. Real RS256 signing against a real (if tiny)
// in-process JWKS server, built on `com.nimbusds` -- the same
// dependency `SecurityConfig`'s own `NimbusJwtDecoder` already uses
// to fetch and verify against a JWKS -- so this suite exercises
// production code, not a parallel implementation. `ScopeTests`'s own
// no-token/malformed-token cases already cover this service; this
// file covers the scheme-specific cases only (`26UpdatePlan.md` M5).
//
// `@DynamicPropertySource` starts the stub and registers `OAUTH_ISSUER`
// before the Spring context is created -- the same "issuer override
// before first read" constraint every other target's own rig
// discloses, met here through Spring's own purpose-built mechanism
// (normally used to point tests at a Testcontainers-allocated port)
// rather than an import-ordering trick.
package com.ciac.oauthecho.routes;

import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

import com.nimbusds.jose.JWSAlgorithm;
import com.nimbusds.jose.JWSHeader;
import com.nimbusds.jose.crypto.RSASSASigner;
import com.nimbusds.jose.jwk.JWKSet;
import com.nimbusds.jose.jwk.RSAKey;
import com.nimbusds.jwt.JWTClaimsSet;
import com.nimbusds.jwt.SignedJWT;
import com.sun.net.httpserver.HttpServer;
import java.net.InetSocketAddress;
import java.nio.charset.StandardCharsets;
import java.security.KeyPair;
import java.security.KeyPairGenerator;
import java.security.interfaces.RSAPublicKey;
import java.util.Date;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.test.context.DynamicPropertyRegistry;
import org.springframework.test.context.DynamicPropertySource;
import org.springframework.test.web.servlet.MockMvc;

@SpringBootTest
@AutoConfigureMockMvc
class OAuthRigTests {
  @Autowired MockMvc mvc;

  @Value("${OAUTH_AUDIENCE:ciac-demo}")
  String configuredAudience;

  private static final String KID = "test-key-1";
  private static String stubIssuer;
  private static RSAKey signingKey;
  private static RSAKey wrongSigningKey;

  @DynamicPropertySource
  static void oauthStub(DynamicPropertyRegistry registry) throws Exception {
    KeyPairGenerator generator = KeyPairGenerator.getInstance("RSA");
    generator.initialize(2048);
    KeyPair pair = generator.generateKeyPair();
    KeyPair wrongPair = generator.generateKeyPair();
    signingKey =
        new RSAKey.Builder((RSAPublicKey) pair.getPublic())
            .privateKey(pair.getPrivate())
            .keyID(KID)
            .build();
    wrongSigningKey =
        new RSAKey.Builder((RSAPublicKey) wrongPair.getPublic())
            .privateKey(wrongPair.getPrivate())
            .keyID(KID)
            .build();

    byte[] body = new JWKSet(signingKey.toPublicJWK()).toString().getBytes(StandardCharsets.UTF_8);
    HttpServer server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
    server.createContext(
        "/.well-known/jwks.json",
        exchange -> {
          exchange.getResponseHeaders().add("Content-Type", "application/json");
          exchange.sendResponseHeaders(200, body.length);
          try (var os = exchange.getResponseBody()) {
            os.write(body);
          }
        });
    server.setExecutor(null);
    server.start();

    stubIssuer = "http://127.0.0.1:" + server.getAddress().getPort();
    registry.add("OAUTH_ISSUER", () -> stubIssuer);
  }

  private String mint(String scope) throws Exception {
    return mint(scope, signingKey, KID, stubIssuer, 3600_000);
  }

  private String mint(String scope, RSAKey key, String kid, String iss, long expDeltaMillis)
      throws Exception {
    JWTClaimsSet.Builder claims =
        new JWTClaimsSet.Builder()
            .subject("test")
            .claim("scope", scope)
            .issuer(iss)
            .expirationTime(new Date(System.currentTimeMillis() + expDeltaMillis));
    if (!configuredAudience.isBlank()) {
      claims.audience(configuredAudience);
    }
    SignedJWT jwt =
        new SignedJWT(new JWSHeader.Builder(JWSAlgorithm.RS256).keyID(kid).build(), claims.build());
    jwt.sign(new RSASSASigner(key));
    return "Bearer " + jwt.serialize();
  }

  @Test
  void echoRejectsMissingScope() throws Exception {
    mvc.perform(
            post("/echo")
                .contentType(MediaType.APPLICATION_JSON)
                .header("Authorization", mint("not:echo:write"))
                .content("""
{"id": "00000000-0000-0000-0000-000000000000", "text": "x"}
"""))
        .andExpect(status().isForbidden());
  }

  @Test
  void echoAcceptsRequiredScope() throws Exception {
    mvc.perform(
            post("/echo")
                .contentType(MediaType.APPLICATION_JSON)
                .header("Authorization", mint("echo:write"))
                .content("""
{"id": "00000000-0000-0000-0000-000000000000", "text": "x"}
"""))
        .andExpect(
            (result) -> {
              int code = result.getResponse().getStatus();
              if (code == 401 || code == 403) {
                throw new AssertionError(
                    "expected neither 401 nor 403 (mechanism proof only), got " + code);
              }
            });
  }

  @Test
  void echoRejectsExpiredToken() throws Exception {
    mvc.perform(
            post("/echo")
                .contentType(MediaType.APPLICATION_JSON)
                .header("Authorization", mint("echo:write", signingKey, KID, stubIssuer, -3600_000))
                .content("""
{"id": "00000000-0000-0000-0000-000000000000", "text": "x"}
"""))
        .andExpect(status().isUnauthorized());
  }

  @Test
  void echoRejectsWrongKey() throws Exception {
    // The crypto-boundary case the JWT suite cannot express as
    // sharply: a correctly-shaped, correctly-`kid`'d token signed
    // by a key the stub JWKS never served -- proof the signature
    // check itself gates the door, not just claim shape or `kid`
    // lookup.
    mvc.perform(
            post("/echo")
                .contentType(MediaType.APPLICATION_JSON)
                .header(
                    "Authorization", mint("echo:write", wrongSigningKey, KID, stubIssuer, 3600_000))
                .content("""
{"id": "00000000-0000-0000-0000-000000000000", "text": "x"}
"""))
        .andExpect(status().isUnauthorized());
  }

  @Test
  void echoRejectsWrongIssuer() throws Exception {
    mvc.perform(
            post("/echo")
                .contentType(MediaType.APPLICATION_JSON)
                .header(
                    "Authorization",
                    mint("echo:write", signingKey, KID, "http://wrong-issuer.example", 3600_000))
                .content("""
{"id": "00000000-0000-0000-0000-000000000000", "text": "x"}
"""))
        .andExpect(status().isUnauthorized());
  }
}
