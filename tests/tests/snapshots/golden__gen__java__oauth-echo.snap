// Message.java -- Generated by CIaC.
package com.ciac.oauthecho.schemas;

import com.fasterxml.jackson.databind.JsonNode;

public record Message(String id, String text) {
  /** Decode with absent/null/zero distinction (shared wire contract). */
  public static Message decode(JsonNode body) {
    Schemas.requireKeys(body, "id", "text");
    Message out = Schemas.MAPPER.convertValue(body, Message.class);
    Schemas.requireUuid("id", out.id());
    return out;
  }
}
