============================================================
// SecurityConfig.java -- Generated by CIaC.
//
// Pillar 4's "compiler owns the wiring" rule applied to Spring
// Security itself: adding the resource-server starter would
// otherwise let Spring Boot's own autoconfiguration install a
// default security filter chain that authenticates every request --
// exactly the framework-magic tension this whole target's own design
// note names. The permissive filter chain below neutralizes that
// autoconfiguration entirely; `Auth.verifyToken`/`requireScope`
// (called explicitly, inline, at the top of each generated route
// that declares `scope`/`has_auth`) are the *only* enforcement that
// exists, matching every other target's own inline-check discipline
// rather than a middleware chain.
package com.ciac.oauthecho.state;

import java.util.List;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.context.annotation.Lazy;
import org.springframework.security.config.annotation.web.builders.HttpSecurity;
import org.springframework.security.oauth2.core.DelegatingOAuth2TokenValidator;
import org.springframework.security.oauth2.core.OAuth2TokenValidator;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.security.oauth2.jwt.JwtClaimNames;
import org.springframework.security.oauth2.jwt.JwtClaimValidator;
import org.springframework.security.oauth2.jwt.JwtDecoder;
import org.springframework.security.oauth2.jwt.JwtIssuerValidator;
import org.springframework.security.oauth2.jwt.JwtValidators;
import org.springframework.security.oauth2.jwt.NimbusJwtDecoder;
import org.springframework.security.web.SecurityFilterChain;

@Configuration
public class SecurityConfig {

  @Bean
  public SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {
    return http.csrf(csrf -> csrf.disable())
        .authorizeHttpRequests(auth -> auth.anyRequest().permitAll())
        .build();
  }

  // `NimbusJwtDecoder.withJwkSetUri` fetches (and caches) the
  // issuer's JWKS lazily, on first `decode()` call -- constructing
  // this bean never makes a network call, the same laziness bar
  // every other provider client (db pools, the broker client) already
  // meets.
  //
  // `OAUTH_ISSUER`/`OAUTH_AUDIENCE` overridable via `@Value`, the
  // same env-driven pattern every other target's own config already
  // uses (`26UpdatePlan.md` M5) -- the previous literal-interpolated
  // issuer string had no runtime override at all, which the no-infra
  // OAuth2 test rig (a real in-process JWKS stub) needs to point the
  // decoder at itself. `NimbusJwtDecoder.withJwkSetUri(...).build()`
  // installs only `JwtValidators.createDefault()` (timestamp checks)
  // -- it does *not* validate `iss`/`aud` on its own, unlike
  // `JwtDecoders.fromIssuerLocation`. `JwtIssuerValidator` (and, if
  // an audience is declared, a `JwtClaimValidator` on `aud`) close
  // that gap, matching every other target's own issuer/audience
  // checks -- found live while wiring `wrong_issuer`'s own rig case,
  // which a validator-less decoder let through as 200.
  @Lazy
  @Bean
  public JwtDecoder jwtDecoder(
      @Value("${OAUTH_ISSUER:http://localhost:9099}") String issuer,
      @Value("${OAUTH_AUDIENCE:ciac-demo}") String audience) {
    NimbusJwtDecoder decoder =
        NimbusJwtDecoder.withJwkSetUri(issuer + "/.well-known/jwks.json").build();
    List<OAuth2TokenValidator<Jwt>> validators =
        new java.util.ArrayList<>(
            List.of(JwtValidators.createDefault(), new JwtIssuerValidator(issuer)));
    if (!audience.isBlank()) {
      validators.add(
          new JwtClaimValidator<List<String>>(
              JwtClaimNames.AUD, aud -> aud != null && aud.contains(audience)));
    }
    decoder.setJwtValidator(new DelegatingOAuth2TokenValidator<>(validators));
    return decoder;
  }
}
