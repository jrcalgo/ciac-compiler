// Search.java -- Generated by CIaC.
//
// OpenSearch client, one instance per declared `search`. Dependency-
// free (`java.net.http.HttpClient` against OpenSearch's own REST
// API), mirroring Go's own `search.Search` choice: no official client
// library is needed for three verbs. Every document lives under one
// hardcoded index (`INDEX`, mirroring Go's own `SEARCH_INDEX_NAME`
// constant) since the `search.index`/`search.query` verb signatures
// carry no index-name parameter of their own. Holds configuration
// only -- the underlying `HttpClient` opens no connection until a
// request is actually sent, so a `Search` bean never blocks
// `AppState` construction.
package com.ciac.mediaops.state;

import com.ciac.mediaops.schemas.Schemas;
import com.fasterxml.jackson.databind.JsonNode;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.util.ArrayList;
import java.util.List;

public final class Search {
  private static final String INDEX = "documents";
  private static final HttpClient HTTP = HttpClient.newHttpClient();

  private final String url;

  public Search(String url) {
    this.url = url;
  }

  private byte[] doRequest(String method, String path, String body) {
    try {
      HttpRequest.Builder builder =
          HttpRequest.newBuilder(URI.create(url + path)).header("Content-Type", "application/json");
      builder =
          switch (method) {
            case "PUT" -> builder.PUT(HttpRequest.BodyPublishers.ofString(body));
            case "POST" -> builder.POST(HttpRequest.BodyPublishers.ofString(body));
            default -> builder.DELETE();
          };
      HttpResponse<byte[]> resp =
          HTTP.send(builder.build(), HttpResponse.BodyHandlers.ofByteArray());
      if (resp.statusCode() >= 300) {
        throw new RuntimeException(
            "opensearch "
                + method
                + " "
                + path
                + ": status "
                + resp.statusCode()
                + ": "
                + new String(resp.body(), java.nio.charset.StandardCharsets.UTF_8));
      }
      return resp.body();
    } catch (java.io.IOException | InterruptedException e) {
      throw new RuntimeException("opensearch " + method + " " + path, e);
    }
  }

  /** Upserts document under {@code INDEX}/docId. */
  public void index(String docId, String document) {
    doRequest("PUT", "/" + INDEX + "/_doc/" + docId, document);
  }

  /** Runs a `query_string` search over {@code INDEX} and returns each hit's `_source`. */
  public List<JsonNode> search(String query) {
    String body = "{\"query\":{\"query_string\":{\"query\":" + Schemas.toJson(query) + "}}}";
    byte[] raw = doRequest("POST", "/" + INDEX + "/_search", body);
    JsonNode parsed;
    try {
      parsed = Schemas.MAPPER.readTree(raw);
    } catch (java.io.IOException e) {
      throw new RuntimeException("parsing opensearch response", e);
    }
    List<JsonNode> hits = new ArrayList<>();
    for (JsonNode hit : parsed.path("hits").path("hits")) {
      hits.add(hit.path("_source"));
    }
    return hits;
  }

  public void delete(String docId) {
    doRequest("DELETE", "/" + INDEX + "/_doc/" + docId, "");
  }
}
