// UploadController.java -- Generated by CIaC.
//
// Pipeline: Upload.
package com.ciac.mediaops.routes;

import com.ciac.mediaops.schemas.Video;
import com.ciac.mediaops.services.RecordAnalytics;
import com.ciac.mediaops.services.StoreVideo;
import com.ciac.mediaops.state.AppState;
import com.ciac.mediaops.state.Queue;
import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class UploadController {
  private final AppState state;
  private final Queue queue;
  private final StoreVideo storeVideo;
  private final RecordAnalytics recordAnalytics;

  public UploadController(
      AppState state, Queue queue, StoreVideo storeVideo, RecordAnalytics recordAnalytics) {
    this.state = state;
    this.queue = queue;
    this.storeVideo = storeVideo;
    this.recordAnalytics = recordAnalytics;
  }

  @RequestMapping(method = RequestMethod.PUT, path = "/videos")
  public Envelope upload(@RequestBody JsonNode body) throws Exception {
    Object result = Video.decode(body);

    result = storeVideo.handle(result);

    result = recordAnalytics.handle(result);

    queue.publishJson("media_ops.uploaded", result);

    return Envelope.accepted(result);
  }
}
