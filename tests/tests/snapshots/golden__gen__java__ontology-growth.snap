// ObjectStore.java -- Generated by CIaC.
//
// S3-compatible object storage client (AWS SDK v2), one instance per
// declared `object_store` (mirrors Go's own `objectstore.ObjectStore`
// shape). Holds configuration only -- the `S3Client` is built lazily
// on first call, so an `ObjectStore` bean never opens a connection at
// `AppState` construction time (`NoInfraBootTest`'s own bar). Defaults
// target a local MinIO from the generated docker-compose (path-style
// addressing, so MinIO works with no extra configuration); point the
// `S3_*` environment variables at real S3 in production.
package com.ciac.mediaops.state;

import java.net.URI;
import java.util.List;
import java.util.stream.Collectors;
import software.amazon.awssdk.auth.credentials.AwsBasicCredentials;
import software.amazon.awssdk.auth.credentials.StaticCredentialsProvider;
import software.amazon.awssdk.core.sync.RequestBody;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.s3.S3Client;
import software.amazon.awssdk.services.s3.model.DeleteObjectRequest;
import software.amazon.awssdk.services.s3.model.GetObjectRequest;
import software.amazon.awssdk.services.s3.model.ListObjectsV2Request;
import software.amazon.awssdk.services.s3.model.NoSuchKeyException;
import software.amazon.awssdk.services.s3.model.PutObjectRequest;

public final class ObjectStore {
  private final String endpoint;
  private final String accessKey;
  private final String secretKey;
  private final String bucket;
  private final String region;
  private volatile S3Client client;

  public ObjectStore(
      String endpoint, String accessKey, String secretKey, String bucket, String region) {
    this.endpoint = endpoint;
    this.accessKey = accessKey;
    this.secretKey = secretKey;
    this.bucket = bucket;
    this.region = region;
  }

  private synchronized S3Client client() {
    if (client == null) {
      client =
          S3Client.builder()
              .endpointOverride(URI.create(endpoint))
              .region(Region.of(region))
              .credentialsProvider(
                  StaticCredentialsProvider.create(
                      AwsBasicCredentials.create(accessKey, secretKey)))
              .forcePathStyle(true)
              .build();
    }
    return client;
  }

  public void put(String key, byte[] data) {
    client()
        .putObject(
            PutObjectRequest.builder().bucket(bucket).key(key).build(),
            RequestBody.fromBytes(data));
  }

  /**
   * Returns {@code null} on a missing key (leaf-side `Schemas.fromJsonOrNull` expects that, not an
   * exception) -- Java's own analog of Go's own `errors.Is(err, &types.NoSuchKey{})` miss-handling,
   * folded into this single call rather than a two-value return.
   */
  public byte[] get(String key) {
    try {
      return client()
          .getObject(GetObjectRequest.builder().bucket(bucket).key(key).build())
          .readAllBytes();
    } catch (NoSuchKeyException e) {
      return null;
    } catch (java.io.IOException e) {
      throw new RuntimeException("reading object " + key, e);
    }
  }

  public void delete(String key) {
    client().deleteObject(DeleteObjectRequest.builder().bucket(bucket).key(key).build());
  }

  public List<String> list(String prefix) {
    return client()
        .listObjectsV2(ListObjectsV2Request.builder().bucket(bucket).prefix(prefix).build())
        .contents()
        .stream()
        .map(o -> o.key())
        .collect(Collectors.toList());
  }
}
