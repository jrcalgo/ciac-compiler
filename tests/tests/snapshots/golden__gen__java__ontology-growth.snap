// ExternalHttp.java -- Generated by CIaC.
//
// Outbound calls to a third-party HTTP API via Spring's `RestClient`,
// one instance per declared `external_http`, bound to its configured
// base URL. Holds configuration only -- `RestClient.create` opens no
// connection, so an `ExternalHttp` bean never blocks `AppState`
// construction.
package com.ciac.mediaops.state;

import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.web.client.RestClient;

public final class ExternalHttp {
  private final RestClient client;

  public ExternalHttp(String baseUrl) {
    this.client = RestClient.create(baseUrl);
  }

  /**
   * Posts jsonBody (already-serialized JSON text) to path and returns the decoded JSON response.
   */
  public JsonNode post(String path, String jsonBody) {
    return client
        .post()
        .uri(path)
        .header("Content-Type", "application/json")
        .body(jsonBody)
        .retrieve()
        .body(JsonNode.class);
  }
}
