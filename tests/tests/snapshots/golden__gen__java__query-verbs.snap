// ErrorAdvice.java -- Generated by CIaC.
//
// The `AppError`/Go `httpx.WriteError` analog: decode failures -> 400;
// unknown -> 500 with the cause logged, canonical-reason body. A
// `fail`-able error record (M4) has no handler of its own here --
// each one is user-declared and arbitrarily named, so it falls
// through to the generic `Exception.class` handler below (500),
// exactly as live-verified against `domain-orders.ciac`'s own
// `InvalidOrder`. The two scoped-auth handlers (M6) are conditional:
// `UnauthorizedException`/`ForbiddenException` (and their own source
// files) only exist when this service declares `auth`.
package com.ciac.queryverbs.routes;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;

@RestControllerAdvice
public class ErrorAdvice {
  private static final Logger log = LoggerFactory.getLogger(ErrorAdvice.class);

  @ExceptionHandler(BadRequestException.class)
  public ResponseEntity<Envelope> handleBadRequest(BadRequestException e) {
    return ResponseEntity.status(HttpStatus.BAD_REQUEST)
        .body(new Envelope("error", e.getMessage()));
  }

  @ExceptionHandler(NotFoundException.class)
  public ResponseEntity<Envelope> handleNotFound(NotFoundException e) {
    return ResponseEntity.status(HttpStatus.NOT_FOUND).body(new Envelope("error", e.getMessage()));
  }

  @ExceptionHandler(Exception.class)
  public ResponseEntity<Envelope> handleUnexpected(Exception e) {
    log.error("unhandled exception", e);
    return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
        .body(new Envelope("error", "internal server error"));
  }
}
