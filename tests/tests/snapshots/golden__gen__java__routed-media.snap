// every other target's own `{"status":"accepted","data":...}` shape
// (the Python `AppError`/Go `httpx` analog).
package com.ciac.routedmedia.routes;

public record Envelope(String status, Object data) {
  public static Envelope accepted(Object data) {
    return new Envelope("accepted", data);
  }
}
