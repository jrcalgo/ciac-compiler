// ScopeTests.java -- Generated behavioral test for scope enforcement.
// Regenerated on every build. Drives the real Spring context via
// MockMvc -- no live listener needed (db/cache/queue pools stay lazy;
// a request that clears the auth layer but then touches unreachable
// infrastructure may still come back as a 5xx, which is still proof
// the auth layer itself let it through -- the same claim boundary
// every other target's own scope test documents). JWT-only: a true
// no-infrastructure OAuth2 scope proof needs a fake auth adapter
// (real RS256 verification needs a real issuer's JWKS regardless of
// how lazily it's fetched) -- future work, the same disclosed
// exclusion Rust's/Go's own scope tests already carry.
package com.ciac.routedmedia.routes;

import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

import com.nimbusds.jose.JWSAlgorithm;
import com.nimbusds.jose.JWSHeader;
import com.nimbusds.jose.crypto.MACSigner;
import com.nimbusds.jwt.JWTClaimsSet;
import com.nimbusds.jwt.SignedJWT;
import java.nio.charset.StandardCharsets;
import java.util.Date;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.test.web.servlet.MockMvc;

@SpringBootTest
@AutoConfigureMockMvc
class ScopeTests {
  @Autowired MockMvc mvc;

  @Value("${JWT_SECRET:change-me-please-use-a-real-32-byte-secret-key}")
  String jwtSecret;

  private String bearer(String scope) throws Exception {
    JWTClaimsSet claims =
        new JWTClaimsSet.Builder()
            .subject("test")
            .claim("scope", scope)
            .expirationTime(new Date(System.currentTimeMillis() + 3600_000))
            .build();
    SignedJWT jwt = new SignedJWT(new JWSHeader(JWSAlgorithm.HS256), claims);
    jwt.sign(new MACSigner(jwtSecret.getBytes(StandardCharsets.UTF_8)));
    return "Bearer " + jwt.serialize();
  }

  @Test
  void uploadRejectsMissingScope() throws Exception {
    mvc.perform(
            put("/videos")
                .contentType(MediaType.APPLICATION_JSON)
                .header("Authorization", bearer("not:videos:write"))
                .content(
                    """
{"id": "00000000-0000-0000-0000-000000000000", "title": "x", "status": "Ready"}
"""))
        .andExpect(status().isForbidden());
  }

  @Test
  void uploadAcceptsRequiredScope() throws Exception {
    mvc.perform(
            put("/videos")
                .contentType(MediaType.APPLICATION_JSON)
                .header("Authorization", bearer("videos:write"))
                .content(
                    """
{"id": "00000000-0000-0000-0000-000000000000", "title": "x", "status": "Ready"}
"""))
        .andExpect(
            (result) -> {
              int code = result.getResponse().getStatus();
              if (code == 401 || code == 403) {
                throw new AssertionError(
                    "expected neither 401 nor 403 (mechanism proof only), got " + code);
              }
            });
  }
}
