// Queue.java -- Generated by CIaC.
//
// Broker access (nats). Publish goes through a client
// connected lazily on first use for both engines -- NATS's usual
// shape (`Nats.connect` dials synchronously), but a deliberate choice
// for Kafka too, applied proactively rather than rediscovered: Go's
// own 24UpdatePlan.md M3 found (via `goleak` against a real,
// unreachable broker) that franz-go's client starts supervisory
// goroutines immediately on construction despite never dialing --
// the official Java Kafka producer client carries the analogous risk
// (a background sender thread starts at construction), so this
// Queue's Kafka producer is guarded the identical way NATS's
// connection already has to be, keeping `AppState` construction
// infrastructure-free regardless of engine.
package com.ciac.routedmedia.state;

import com.ciac.routedmedia.sim.World;
import com.fasterxml.jackson.databind.ObjectMapper;
import io.nats.client.Connection;
import io.nats.client.Nats;
import io.nats.client.impl.Headers;
import io.nats.client.impl.NatsMessage;
import java.util.Map;
import org.springframework.beans.factory.ObjectProvider;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;

// A standalone `@Component` (not one of `AppState`'s own `@Bean`
// factory methods, unlike `DataSource`/`JdbcClient`): a
// `@Configuration` class cannot inject a bean its own `@Bean` method
// produces, so `Queue` is constructor-injected directly into every
// `ApiController`/`Worker`/`Job`/`Channel` that needs it instead of
// being reached through `AppState`.
@Component
public final class Queue {
  private static final ObjectMapper MAPPER = new ObjectMapper();
  private final String url;
  // `null` in production; a simulation-run `World` when SimRunner
  // manually registers one (v0.25 M9) -- `ObjectProvider<World>` is
  // Spring's own null-safe "this bean, or nothing" injection, so no
  // `World` bean ever needs to exist for production wiring to
  // resolve cleanly (`World.java` is a plain class, never a
  // `@Component`; nothing auto-registers it).
  private final World world;
  private volatile Connection connection;

  public Queue(
      @Value("${NATS_URL:nats://localhost:4222}") String url, ObjectProvider<World> worldProvider) {
    this.url = url;
    this.world = worldProvider.getIfAvailable();
  }

  private synchronized Connection connection() throws Exception {
    if (connection == null) {
      connection = Nats.connect(url);
    }
    return connection;
  }

  /** Sends payload to subject. */
  public void publish(String subject, byte[] payload, Map<String, String> headers)
      throws Exception {
    Connection conn = connection();
    if (headers == null || headers.isEmpty()) {
      conn.publish(subject, payload);
      return;
    }
    Headers h = new Headers();
    headers.forEach(h::add);
    conn.publish(NatsMessage.builder().subject(subject).headers(h).data(payload).build());
  }

  /**
   * The underlying connection, for workers/channels to build their own dispatchers/subscriptions
   * against -- connects on first call, same as {@link #publish}.
   */
  public Connection natsConnection() throws Exception {
    return connection();
  }

  /**
   * Marshals v and publishes it -- the shared call site every generated pipeline `publish` step
   * (and every `state.publish` leaf) goes through, world-guarded (v0.25 M9): a simulation run
   * routes to the fake in-memory broker instead, skipping the real connection/tracing path below
   * entirely -- the sole choke point every publish call site needs, so neither `_steps.java.j2` nor
   * `lower.rs`'s own `publish` leaf need any world-awareness of their own.
   */
  public void publishJson(String subject, Object v) {
    try {
      if (world != null) {
        world.publishChecked(subject, MAPPER.writeValueAsBytes(v));
        return;
      }
      publish(subject, MAPPER.writeValueAsBytes(v), null);
    } catch (Exception e) {
      throw new RuntimeException("publishing to " + subject, e);
    }
  }
}
