// ClipController.java -- Generated by CIaC.
//
// REST endpoints for the Clip resource. Responses are
// the raw entity JSON (no `Envelope` wrapper) -- CRUD resources carry
// their own response contract, separate from pipeline `api`s (see
// `ApiController`), matching every other target's own resource routes.
package com.ciac.routedmedia.routes;

import com.ciac.routedmedia.schemas.ClipIn;
import com.ciac.routedmedia.schemas.Video;
import com.ciac.routedmedia.services.ClipStore;
import com.fasterxml.jackson.databind.JsonNode;
import jakarta.servlet.http.HttpServletRequest;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.security.oauth2.jwt.JwtDecoder;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class ClipController {
  private final ClipStore store;
  private final JwtDecoder jwtDecoder;

  public ClipController(ClipStore store, JwtDecoder jwtDecoder) {
    this.store = store;
    this.jwtDecoder = jwtDecoder;
  }

  @PostMapping("/clips")
  public ResponseEntity<Video> create(HttpServletRequest request, @RequestBody JsonNode body) {
    Jwt jwt = Auth.verifyToken(request, jwtDecoder);
    ClipIn payload = ClipIn.decode(body);
    return ResponseEntity.status(HttpStatus.CREATED).body(store.create(payload));
  }

  @GetMapping("/clips")
  public java.util.List<Video> list(
      HttpServletRequest request,
      @RequestParam(defaultValue = "50") int limit,
      @RequestParam(defaultValue = "0") int offset) {
    Jwt jwt = Auth.verifyToken(request, jwtDecoder);
    return store.list(limit, offset);
  }

  @GetMapping("/clips/{id}")
  public Video get(HttpServletRequest request, @PathVariable String id) {
    Jwt jwt = Auth.verifyToken(request, jwtDecoder);
    return store.get(id).orElseThrow(() -> new NotFoundException("Clip not found"));
  }

  @PutMapping("/clips/{id}")
  public Video update(
      HttpServletRequest request, @PathVariable String id, @RequestBody JsonNode body) {
    Jwt jwt = Auth.verifyToken(request, jwtDecoder);
    ClipIn payload = ClipIn.decode(body);
    return store.update(id, payload).orElseThrow(() -> new NotFoundException("Clip not found"));
  }

  @DeleteMapping("/clips/{id}")
  public ResponseEntity<Void> delete(HttpServletRequest request, @PathVariable String id) {
    Jwt jwt = Auth.verifyToken(request, jwtDecoder);
    if (!store.delete(id)) {
      throw new NotFoundException("Clip not found");
    }
    return ResponseEntity.noContent().build();
  }
}
