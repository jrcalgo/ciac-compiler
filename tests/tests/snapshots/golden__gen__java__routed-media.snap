// ClipStore.java -- Generated by CIaC.
//
// Persistence for the Clip resource.
package com.ciac.routedmedia.services;

import com.ciac.routedmedia.schemas.ClipIn;
import com.ciac.routedmedia.schemas.RowMappers;
import com.ciac.routedmedia.schemas.Video;
import java.util.List;
import java.util.Optional;
import java.util.UUID;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.jdbc.core.simple.JdbcClient;
import org.springframework.stereotype.Component;

@Component
public class ClipStore {
  private final JdbcClient jdbc;

  public ClipStore(@Qualifier("dbJdbc") JdbcClient jdbc) {
    this.jdbc = jdbc;
  }

  public Video create(ClipIn payload) {
    String id = UUID.randomUUID().toString();
    jdbc.sql("INSERT INTO clips (id, title, status) VALUES (?, ?, ?)")
        .param(id)
        .param(payload.title())
        .param(payload.status())
        .update();
    return new Video(id, payload.title(), payload.status());
  }

  public Optional<Video> get(String id) {
    return jdbc.sql("SELECT id, title, status FROM clips WHERE id = ?")
        .param(id)
        .query(RowMappers.VIDEO)
        .optional();
  }

  public List<Video> list(int limit, int offset) {
    return jdbc.sql("SELECT id, title, status FROM clips ORDER BY id LIMIT ? OFFSET ?")
        .param(limit)
        .param(offset)
        .query(RowMappers.VIDEO)
        .list();
  }

  public Optional<Video> update(String id, ClipIn payload) {
    int n =
        jdbc.sql("UPDATE clips SET title = ?, status = ? WHERE id = ?")
            .param(payload.title())
            .param(payload.status())
            .param(id)
            .update();
    if (n == 0) {
      return Optional.empty();
    }
    return Optional.of(new Video(id, payload.title(), payload.status()));
  }

  public boolean delete(String id) {
    int n = jdbc.sql("DELETE FROM clips WHERE id = ?").param(id).update();
    return n > 0;
  }
}
