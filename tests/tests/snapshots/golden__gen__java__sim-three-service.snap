fulfillment/src/test/java/com/ciac/fulfillment/sim/SimRunner.java
============================================================
// SimRunner.java -- Generated by CIaC.
//
// Scenario-driving simulation runner. Interprets the same closed
// request/publish/advance/drain/expect scenario vocabulary ciac-sim's
// Scenario JSON schema defines, against this service's own generated
// `@RestController`s (through Spring's standalone MockMvc, no live
// listener) and its worker `handleMessageOnce`/job `handleTickOnce`
// entry points -- line-for-line the same architecture as
// sim_runner.rs.j2/sim_runner.ts.j2/sim_runner.go.j2, generated (not a
// shared library) because this needs concrete per-program types,
// exactly like every other backend's own generated runner. Lives under
// `src/test/java` (not the packaged application) since `MockMvc`/
// `spring-test` only ever sit on the `test` classpath; run via `mvn -q
// test-compile exec:java` (see pom.xml's own `exec-maven-plugin` --
// compile once, then one `exec:java` invocation per scenario, the same
// "compile once, run the driver once per scenario" shape every other
// target's own toolchain gives for free).
//
// 27UpdatePlan.md M8 widens this from the v0.25 M9 narrow vocabulary
// (single-service, db/broker only) to the full given/expect surface
// `World.java`'s own M8 restatement fakes: `given.cache`/`store`/
// `search`/`external_http`, `expect.email`/`cache`/`object`/
// `search_hits`/`http_calls`, group-aware broker drain
// (`World.drainBroker`, true fan-out across two workers sharing one
// subject, replacing the old shared-queue "first `if` branch wins"
// dispatch), and a synthesized bearer token per `request.as` principal
// (`World.authIssue`, matching Rust's/TypeScript's/Go's own M4/M6/M7
// `sim_runner`). Still single-service only; `publish` steps (publishing
// directly to a stream, bypassing an API) are not wired -- the same
// disclosed scope every other target's own runner still carries. Any
// scenario step this runner cannot honor is a hard error, never a
// silently-skipped no-op. Structural scenario parsing only
// (simulation_version/non-empty steps) -- this is a hand-written
// restatement of ciac_sim::scenario::Scenario, not that vendored Rust
// source, the same position Python's/TypeScript's/Go's own hand-written
// scenario drivers occupy.
//
// A raw `AnnotationConfigApplicationContext` scanning only the
// non-`Application`-root packages below `com.ciac.fulfillment`
// is used deliberately instead of `SpringApplication`/
// `@SpringBootTest`: scanning the root package would sweep in
// `Application.class` itself, whose conditional `@EnableScheduling`/
// `@EnableWebSocket` would activate Spring's own background
// `@Scheduled` timer and WebSocket machinery -- exactly the real
// wall-clock/network side effects this runner exists to replace with
// explicit, scenario-driven calls. Skipping `SpringApplication`
// entirely also means no embedded servlet container ever binds a
// port, and no Spring Boot startup banner/logging ever reaches
// stdout -- the single JSON outcome line this process prints is
// always the last line of output, the same "parse the last stdout
// line" contract every other target's own driver already relies on.
package com.ciac.fulfillment.sim;

import com.ciac.fulfillment.schemas.Order;
import com.ciac.fulfillment.workers.ShipWorker;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.PropertyNamingStrategies;
import com.fasterxml.jackson.datatype.jsr310.JavaTimeModule;
import java.nio.file.Files;
import java.nio.file.Path;
import java.time.Instant;
import java.time.ZoneOffset;
import java.time.ZonedDateTime;
import java.util.ArrayList;
import java.util.Base64;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import org.springframework.context.annotation.AnnotationConfigApplicationContext;
import org.springframework.http.HttpMethod;
import org.springframework.http.MediaType;
import org.springframework.scheduling.support.CronExpression;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.MvcResult;
import org.springframework.test.web.servlet.request.MockMvcRequestBuilders;
import org.springframework.test.web.servlet.setup.MockMvcBuilders;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.bind.annotation.RestControllerAdvice;

public final class SimRunner {
  private SimRunner() {}

  private static final String SERVICE_NAME = "Fulfillment";

  // Own mapper, not `Schemas.MAPPER` -- this file is emitted
  // whenever this world can fake something the program declares, but
  // `Schemas.java` only when the program declares at least one
  // record/resource; a `db`/`queue`/peripheral-capable program with
  // only classic (untyped) handlers has no `Schemas` class to import
  // (`World.java`'s own doc explains the same finding). Configured
  // identically regardless (`SNAKE_CASE` + `JavaTimeModule`), so a
  // typed worker payload class decodes exactly as it would through
  // `Schemas.MAPPER`.
  private static final ObjectMapper MAPPER =
      new ObjectMapper()
          .registerModule(new JavaTimeModule())
          .setPropertyNamingStrategy(PropertyNamingStrategies.SNAKE_CASE);

  // 27UpdatePlan.md M8: schema facts computed once at codegen time
  // from the same source the migration DDL itself is built from, so
  // reference/unique/cascade checking under simulation can never
  // drift from what the real schema enforces -- mirroring Rust's/
  // TypeScript's/Go's own `sim_world_tables`/`worldTables` exactly.
  private static final List<World.WorldTable> WORLD_TABLES =
      List.of(
          new World.WorldTable("charges", List.of()), new World.WorldTable("shipments", List.of()));

  // -- Scenario JSON shape (structural restatement of ciac_sim::scenario) --
  // `MAPPER`'s `SNAKE_CASE` naming strategy maps every camelCase
  // component below to/from its wire snake_case key with no
  // `@JsonProperty` needed, the same discipline every generated
  // record already relies on.

  private record Principal(String sub, List<String> scopes) {}

  private record RequestStep(
      String service, String api, JsonNode json, Principal as, String saveAs) {}

  private record PublishStep(String stream, JsonNode json) {}

  private record AdvanceStep(String by) {}

  private record ResponseExpect(String of, Integer status, JsonNode json) {}

  private record RowExpect(
      String service, String table, Map<String, Object> where, boolean present) {}

  private record WorkerAttemptsExpect(String worker, int count) {}

  private record JobRunsExpect(String job, int count) {}

  private record EmailExpect(String to, String subjectContains, int count) {}

  private record CacheExpect(String instance, String key, boolean present, JsonNode value) {}

  private record ObjectExpect(String store, String key, boolean present) {}

  private record SearchHitsExpect(String instance, String query, int count) {}

  private record HttpCallsExpect(String instance, int count) {}

  private record ExpectStep(
      ResponseExpect response,
      RowExpect row,
      WorkerAttemptsExpect workerAttempts,
      JobRunsExpect jobRuns,
      JsonNode quiescence,
      EmailExpect email,
      CacheExpect cache,
      ObjectExpect object,
      SearchHitsExpect searchHits,
      HttpCallsExpect httpCalls) {}

  private record ScenarioStep(
      RequestStep request,
      PublishStep publish,
      AdvanceStep advance,
      JsonNode drain,
      ExpectStep expect) {}

  private record GivenTableRows(String service, String table, List<Map<String, Object>> rows) {}

  private record GivenCacheEntry(String instance, String key, JsonNode value, String ttl) {}

  private record GivenStoreObject(String instance, String key, String valueBase64) {}

  private record GivenSearchDoc(String instance, String id, JsonNode doc) {}

  private record GivenHttpFixture(String instance, List<World.GivenHttpResponse> responses) {}

  private record FailureSelector(String effect, String subject, int occurrence, String phase) {}

  private record FailureAction(String kind) {}

  private record RawFailureRule(FailureSelector at, FailureAction action) {}

  private record Given(
      List<GivenTableRows> db,
      List<GivenCacheEntry> cache,
      List<GivenStoreObject> store,
      List<GivenSearchDoc> search,
      List<GivenHttpFixture> externalHttp,
      List<RawFailureRule> failures) {}

  private record Scenario(
      int simulationVersion, String name, String startAt, Given given, List<ScenarioStep> steps) {}

  private record SimScenarioOutcome(
      String scenario,
      boolean passed,
      String error,
      Map<String, Integer> workerAttempts,
      Map<String, Integer> jobRuns) {}

  private record SavedResponse(int status, JsonNode json) {}

  private record ApiRoute(String method, String path) {}

  private static final Map<String, ApiRoute> API_ROUTES = new HashMap<>();

  static {
  }

  /**
   * Only the `error` action / `after` phase is implemented -- the same disclosed subset of the full
   * failure vocabulary Rust's own SimWorld::should_fail supports, for the same reason (it's the one
   * action this checkpoint's scenarios need). Refused up front rather than silently ignored if a
   * scenario asks for anything else.
   */
  private static List<World.FailureRule> toFailureRules(List<RawFailureRule> raw) {
    List<World.FailureRule> out = new ArrayList<>();
    for (RawFailureRule r : raw) {
      if (!"error".equals(r.action().kind())) {
        throw new RuntimeException(
            "failure rule for effect \""
                + r.at().effect()
                + "\" uses action \""
                + r.action().kind()
                + "\", which this Java world's FailureEngine integration does not support yet"
                + " (only `error` is implemented)");
      }
      if (!"after".equals(r.at().phase())) {
        throw new RuntimeException(
            "failure rule for effect \""
                + r.at().effect()
                + "\" uses phase \""
                + r.at().phase()
                + "\", which this Java world's FailureEngine integration does not support yet"
                + " (only `after` is implemented)");
      }
      String subject = r.at().subject() != null ? r.at().subject() : "";
      out.add(new World.FailureRule(r.at().effect(), subject, r.at().occurrence()));
    }
    return out;
  }

  private static final Pattern DURATION_RE = Pattern.compile("^(\\d+)(ms|s|m|h|d)$");
  private static final Map<String, Long> UNIT_MS =
      Map.of("ms", 1L, "s", 1_000L, "m", 60_000L, "h", 3_600_000L, "d", 86_400_000L);

  /**
   * Parses `advance.by` strings ("24h", "7d", "30m", ...) -- matches sim/pyrunner/cron.py's
   * parse_duration_ms and every other target's own generated `parseDurationMs`/`parse_duration_ms`
   * exactly.
   */
  private static long parseDurationMs(String text) {
    Matcher m = DURATION_RE.matcher(text);
    if (!m.matches()) {
      throw new RuntimeException("unrecognized duration: \"" + text + "\"");
    }
    return Long.parseLong(m.group(1)) * UNIT_MS.get(m.group(2));
  }

  /**
   * Every cron-due instant in (fromMs, toMs] for schedule -- Spring's own `CronExpression.next`
   * accepts the identical `spring_cron`- translated 6-field seconds-first expression
   * `@Scheduled(cron=..)` itself parses, so this needs no separate cron dialect of its own.
   */
  private static List<Long> dueInstants(CronExpression schedule, long fromMs, long toMs) {
    List<Long> out = new ArrayList<>();
    ZonedDateTime cursor = Instant.ofEpochMilli(fromMs).atZone(ZoneOffset.UTC);
    for (int i = 0; i < 100_000; i++) {
      ZonedDateTime next = schedule.next(cursor);
      if (next == null) {
        break;
      }
      long nextMs = next.toInstant().toEpochMilli();
      if (nextMs > toMs) {
        break;
      }
      out.add(nextMs);
      cursor = next;
    }
    return out;
  }

  /**
   * 27UpdatePlan.md M8: synthesizes a bearer token from the step's own `as` principal exactly like
   * `sim/pyrunner/auto_driver.py`'s `_request` (`f"sim:{sub}:{','.join(scopes)}"`, claims `{"sub":
   * sub, "scope": " ".join(scopes)}`) -- matching Rust's/ TypeScript's/Go's own `sim_runner`'s
   * identical synthesis.
   */
  private static SavedResponse doRequest(MockMvc mvc, World world, RequestStep spec)
      throws Exception {
    if (!SERVICE_NAME.equals(spec.service())) {
      throw new RuntimeException(
          "sim_runner only drives service \""
              + SERVICE_NAME
              + "\" (single-service only); request named \""
              + spec.service()
              + "\"");
    }
    ApiRoute route = API_ROUTES.get(spec.api());
    if (route == null) {
      throw new RuntimeException("sim_runner: no api registered named \"" + spec.api() + "\"");
    }
    var reqBuilder =
        MockMvcRequestBuilders.request(HttpMethod.valueOf(route.method()), route.path());
    if (spec.json() != null) {
      reqBuilder =
          reqBuilder
              .contentType(MediaType.APPLICATION_JSON)
              .content(MAPPER.writeValueAsBytes(spec.json()));
    }
    if (spec.as() != null) {
      List<String> scopes = spec.as().scopes() != null ? spec.as().scopes() : List.of();
      String token = "sim:" + spec.as().sub() + ":" + String.join(",", scopes);
      world.authIssue(
          token, Map.of("sub", spec.as().sub(), "scope", String.join(" ", scopes)), null);
      reqBuilder = reqBuilder.header("Authorization", "Bearer " + token);
    }
    MvcResult result = mvc.perform(reqBuilder).andReturn();
    String content = result.getResponse().getContentAsString();
    JsonNode json = content.isEmpty() ? null : MAPPER.readTree(content);
    return new SavedResponse(result.getResponse().getStatus(), json);
  }

  /**
   * Hands every message currently undelivered on `(subject, group)`'s own broker-log cursor to its
   * worker's `handleMessageOnce` exactly once (with that worker's own retry budget) -- messages a
   * handler publishes as a side effect of processing are left for the *next* drain step. Two
   * independent workers sharing one subject now each see every message (true fan-out via
   * `World.drainBroker`'s own per-(subject, group) cursor), where the old shared-queue dispatch
   * delivered only to whichever worker's own `if` branch matched first -- matching
   * Rust's/TypeScript's/Go's own 27UpdatePlan.md M4/M6/M7 `drain()` rewrite. The trailing sweep
   * over `world.drainQueue()` (dual-written alongside the group-aware broker log --
   * `World.publishChecked`'s own doc) still refuses a message published to a subject no registered
   * worker drains above, rather than leaving it to sit undelivered forever; it dispatches by an
   * if/else-if chain over the subject string (never a `switch`, which would hard-error at compile
   * time the moment two workers share one subject, e.g. `sim-broker-slice.ciac`'s
   * `ConsumerA`/`ConsumerB` -- Go's own M7 found this the hard way with its own `switch`; this
   * runner never risks it).
   */
  private static void drain(
      AnnotationConfigApplicationContext ctx, World world, Map<String, Integer> workerAttempts)
      throws Exception {
    for (byte[] msg : world.drainBroker(ShipWorker.SUBJECT, ShipWorker.QUEUE_GROUP)) {
      Object payload = MAPPER.readValue(msg, Order.class);
      ShipWorker worker = ctx.getBean(ShipWorker.class);
      int attempts = 0;
      Exception lastError = null;
      for (int attempt = 0; attempt <= ShipWorker.MAX_RETRIES; attempt++) {
        attempts++;
        try {
          worker.handleMessageOnce(payload);
          lastError = null;
          break;
        } catch (Exception e) {
          lastError = e;
        }
      }
      if (lastError != null) {
        System.err.println("sim_runner: Ship exhausted retries: " + lastError);
      }
      workerAttempts.merge("Ship", attempts, Integer::sum);
    }
    for (World.QueuedMessage msg : world.drainQueue()) {
      boolean delivered = false;
      if (!delivered && ShipWorker.SUBJECT.equals(msg.subject())) {
        delivered = true;
      }
      if (!delivered) {
        throw new RuntimeException(
            "sim_runner: no worker registered to consume subject \""
                + msg.subject()
                + "\" (disclosed scope)");
      }
    }
  }

  private static void advance(
      AnnotationConfigApplicationContext ctx,
      World world,
      long fromMs,
      long toMs,
      Map<String, Integer> jobRuns)
      throws Exception {
    world.advanceClockTo(toMs);
  }

  private static void expect(
      ExpectStep spec,
      World world,
      Map<String, SavedResponse> saved,
      Map<String, Integer> workerAttempts,
      Map<String, Integer> jobRuns)
      throws Exception {
    if (spec.response() != null) {
      SavedResponse got = saved.get(spec.response().of());
      if (got == null) {
        throw new RuntimeException(
            "expect.response.of references unknown save_as \"" + spec.response().of() + "\"");
      }
      if (spec.response().status() != null && got.status() != spec.response().status()) {
        throw new RuntimeException(
            "expect.response.of=\""
                + spec.response().of()
                + "\": expected status "
                + spec.response().status()
                + ", got "
                + got.status());
      }
      if (spec.response().json() != null && !spec.response().json().equals(got.json())) {
        throw new RuntimeException(
            "expect.response.of=\""
                + spec.response().of()
                + "\": expected json "
                + spec.response().json()
                + ", got "
                + got.json());
      }
    } else if (spec.row() != null) {
      if (!SERVICE_NAME.equals(spec.row().service())) {
        throw new RuntimeException(
            "sim_runner only drives service \""
                + SERVICE_NAME
                + "\" (single-service only); expect.row named \""
                + spec.row().service()
                + "\"");
      }
      Map<String, Object> where = spec.row().where() != null ? spec.row().where() : Map.of();
      boolean found = !world.findWhere(spec.row().table(), where).isEmpty();
      if (found != spec.row().present()) {
        throw new RuntimeException(
            "expect.row: table=\""
                + spec.row().table()
                + "\" where="
                + where
                + " present="
                + spec.row().present()
                + ", found="
                + found);
      }
    } else if (spec.workerAttempts() != null) {
      int actual = workerAttempts.getOrDefault(spec.workerAttempts().worker(), 0);
      if (actual != spec.workerAttempts().count()) {
        throw new RuntimeException(
            "expect.worker_attempts: worker=\""
                + spec.workerAttempts().worker()
                + "\" expected "
                + spec.workerAttempts().count()
                + ", got "
                + actual);
      }
    } else if (spec.jobRuns() != null) {
      int actual = jobRuns.getOrDefault(spec.jobRuns().job(), 0);
      if (actual != spec.jobRuns().count()) {
        throw new RuntimeException(
            "expect.job_runs: job=\""
                + spec.jobRuns().job()
                + "\" expected "
                + spec.jobRuns().count()
                + ", got "
                + actual);
      }
    } else if (spec.quiescence() != null) {
      if (!world.queueIsEmpty()) {
        throw new RuntimeException(
            "expect.quiescence: undelivered message(s) remain in the simulated broker");
      }
    } else if (spec.email() != null) {
      int actual = world.emailSentCountAll(spec.email().to(), spec.email().subjectContains());
      if (actual != spec.email().count()) {
        throw new RuntimeException(
            "expect.email: to="
                + spec.email().to()
                + " subject_contains="
                + spec.email().subjectContains()
                + " expected "
                + spec.email().count()
                + ", got "
                + actual);
      }
    } else if (spec.cache() != null) {
      String cached = world.cacheGet(spec.cache().instance(), spec.cache().key());
      boolean found = cached != null;
      if (found != spec.cache().present()) {
        throw new RuntimeException(
            "expect.cache: instance=\""
                + spec.cache().instance()
                + "\" key=\""
                + spec.cache().key()
                + "\" expected present="
                + spec.cache().present()
                + ", found present="
                + found);
      }
      if (spec.cache().value() != null) {
        JsonNode actual = found ? MAPPER.readTree(cached) : null;
        if (!spec.cache().value().equals(actual)) {
          throw new RuntimeException(
              "expect.cache: instance=\""
                  + spec.cache().instance()
                  + "\" key=\""
                  + spec.cache().key()
                  + "\" expected value="
                  + spec.cache().value()
                  + ", got "
                  + actual);
        }
      }
    } else if (spec.object() != null) {
      boolean found = world.objectExists(spec.object().store(), spec.object().key());
      if (found != spec.object().present()) {
        throw new RuntimeException(
            "expect.object: store=\""
                + spec.object().store()
                + "\" key=\""
                + spec.object().key()
                + "\" expected present="
                + spec.object().present()
                + ", found present="
                + found);
      }
    } else if (spec.searchHits() != null) {
      int actual =
          world.searchQuery(spec.searchHits().instance(), spec.searchHits().query()).size();
      if (actual != spec.searchHits().count()) {
        throw new RuntimeException(
            "expect.search_hits: instance=\""
                + spec.searchHits().instance()
                + "\" query=\""
                + spec.searchHits().query()
                + "\" expected "
                + spec.searchHits().count()
                + ", got "
                + actual);
      }
    } else if (spec.httpCalls() != null) {
      int actual = world.httpRequestCount(spec.httpCalls().instance());
      if (actual != spec.httpCalls().count()) {
        throw new RuntimeException(
            "expect.http_calls: instance=\""
                + spec.httpCalls().instance()
                + "\" expected "
                + spec.httpCalls().count()
                + ", got "
                + actual);
      }
    } else {
      throw new RuntimeException("sim_runner: unrecognized expect step");
    }
  }

  public static void main(String[] args) throws Exception {
    if (args.length < 1) {
      System.err.println("usage: SimRunner <scenario.json>");
      System.exit(1);
    }
    Scenario sc = MAPPER.readValue(Files.readString(Path.of(args[0])), Scenario.class);
    if (sc.simulationVersion() != 1) {
      System.err.println(
          "scenario simulation_version "
              + sc.simulationVersion()
              + " is not supported (expected 1)");
      System.exit(1);
    }
    if (sc.steps() == null || sc.steps().isEmpty()) {
      System.err.println("scenario has no steps");
      System.exit(1);
    }

    Given given =
        sc.given() != null
            ? sc.given()
            : new Given(List.of(), List.of(), List.of(), List.of(), List.of(), List.of());
    List<World.FailureRule> failureRules =
        toFailureRules(given.failures() != null ? given.failures() : List.of());
    World world = new World(failureRules, WORLD_TABLES);
    for (GivenTableRows seed : given.db() != null ? given.db() : List.<GivenTableRows>of()) {
      if (!SERVICE_NAME.equals(seed.service())) {
        System.err.println(
            "sim_runner only drives service \""
                + SERVICE_NAME
                + "\" (single-service only); given.db named \""
                + seed.service()
                + "\"");
        System.exit(1);
      }
      for (Map<String, Object> row : seed.rows()) {
        world.seedDb(seed.table(), row);
      }
    }

    long nowMs;
    try {
      nowMs = Instant.parse(sc.startAt()).toEpochMilli();
    } catch (Exception e) {
      System.err.println("scenario start_at \"" + sc.startAt() + "\": not a valid date");
      System.exit(1);
      return;
    }
    // `World`'s own constructor always starts its virtual clock at
    // epoch 0 (disclosed in `World.java`'s own doc comment); synced
    // to `start_at` here, before any TTL-bearing seed below reads
    // `World.nowMs()`, and kept in lockstep by every `advance()`
    // step thereafter -- mirroring Rust's/TypeScript's/Go's own
    // ordering exactly.
    world.advanceClockTo(nowMs);

    // 27UpdatePlan.md M8: `given.cache`/`store`/`search`/
    // `external_http` -- mirrors `sim/pyrunner/auto_driver.py`'s
    // `apply_given` and Rust's/TypeScript's/Go's own `sim_runner`
    // (M4/M6/M7) exactly.
    for (GivenCacheEntry entry :
        given.cache() != null ? given.cache() : List.<GivenCacheEntry>of()) {
      Long ttlMs = entry.ttl() != null ? parseDurationMs(entry.ttl()) : null;
      world.cacheSet(
          entry.instance(), entry.key(), MAPPER.writeValueAsString(entry.value()), ttlMs);
    }
    for (GivenStoreObject obj :
        given.store() != null ? given.store() : List.<GivenStoreObject>of()) {
      world.objectPut(obj.instance(), obj.key(), Base64.getDecoder().decode(obj.valueBase64()));
    }
    for (GivenSearchDoc doc : given.search() != null ? given.search() : List.<GivenSearchDoc>of()) {
      world.searchIndex(doc.instance(), doc.id(), MAPPER.writeValueAsString(doc.doc()));
    }
    for (GivenHttpFixture fixture :
        given.externalHttp() != null ? given.externalHttp() : List.<GivenHttpFixture>of()) {
      world.seedHttpFixtures(fixture.instance(), fixture.responses());
    }

    // Scans everything below the root package EXCEPT `Application`
    // itself (see the class doc) plus manually registers the one
    // `World` bean instance every `ObjectProvider<World>`
    // injection point (Queue, and every `needs_db`/`needs_cache`
    // typed handler, and each ontology wrapper class) resolves
    // against -- the only difference from production wiring.
    AnnotationConfigApplicationContext ctx = new AnnotationConfigApplicationContext();
    ctx.scan(
        "com.ciac.fulfillment.routes",
        "com.ciac.fulfillment.services",
        "com.ciac.fulfillment.logic",
        "com.ciac.fulfillment.state",
        "com.ciac.fulfillment.workers",
        "com.ciac.fulfillment.clients");
    // 27UpdatePlan.md M8: `SecurityConfig`'s own `securityFilterChain`
    // `@Bean` factory needs a real `HttpSecurity` bean, which only
    // exists once Spring Boot's own security autoconfiguration runs
    // under a real `SpringApplication` -- never true here (see the
    // class doc: `Application` itself is deliberately never scanned
    // for the identical reason). Found live the moment an auth-
    // declaring program first became sim-reachable this milestone
    // (`unsupported_sim_capabilities`'s own standalone-refusal is
    // gone): removed by bean name (Spring's own default -- the
    // decapitalized simple class name) rather than skipped by
    // package, since `SecurityConfig` lives in the same `state`
    // package this runner still needs scanned for `AppState`/
    // `Queue`/the ontology wrapper classes. A no-op on a program
    // with no `auth` at all, since the bean is never registered
    // there.
    if (ctx.containsBeanDefinition("securityConfig")) {
      ctx.removeBeanDefinition("securityConfig");
    }
    ctx.registerBean("world", World.class, () -> world);
    ctx.refresh();

    MockMvc mvc =
        MockMvcBuilders.standaloneSetup(
                ctx.getBeansWithAnnotation(RestController.class).values().toArray())
            .setControllerAdvice(
                ctx.getBeansWithAnnotation(RestControllerAdvice.class).values().toArray())
            .build();

    Map<String, SavedResponse> saved = new HashMap<>();
    Map<String, Integer> workerAttempts = new HashMap<>();
    Map<String, Integer> jobRuns = new HashMap<>();

    Exception runErr = null;
    for (ScenarioStep step : sc.steps()) {
      try {
        if (step.request() != null) {
          SavedResponse resp = doRequest(mvc, world, step.request());
          if (step.request().saveAs() != null) {
            saved.put(step.request().saveAs(), resp);
          }
        } else if (step.publish() != null) {
          throw new RuntimeException(
              "sim_runner does not support `publish` steps (disclosed scope)");
        } else if (step.advance() != null) {
          long deltaMs = parseDurationMs(step.advance().by());
          long toMs = nowMs + deltaMs;
          advance(ctx, world, nowMs, toMs, jobRuns);
          nowMs = toMs;
        } else if (step.drain() != null) {
          drain(ctx, world, workerAttempts);
        } else if (step.expect() != null) {
          expect(step.expect(), world, saved, workerAttempts, jobRuns);
        } else {
          throw new RuntimeException("sim_runner: unrecognized step");
        }
      } catch (Exception e) {
        runErr = e;
      }
      if (runErr != null) {
        break;
      }
    }
    if (runErr == null) {
      List<String> unmatched = world.unmatchedFailureRules();
      if (!unmatched.isEmpty()) {
        runErr =
            new RuntimeException(
                unmatched.size()
                    + " failure rule(s) declared in `given.failures` never matched a real"
                    + " occurrence: "
                    + unmatched);
      }
    }

    SimScenarioOutcome outcome =
        new SimScenarioOutcome(
            sc.name(),
            runErr == null,
            runErr != null ? runErr.getMessage() : null,
            workerAttempts,
            jobRuns);
    ctx.close();
    System.out.println(MAPPER.writeValueAsString(outcome));
  }
}
