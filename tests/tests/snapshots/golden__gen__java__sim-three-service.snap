// SubmitOrderController.java -- Generated by CIaC.
//
// Pipeline: SubmitOrder.
package com.ciac.intake.routes;

import com.ciac.intake.clients.BillingClient;
import com.ciac.intake.schemas.Order;
import com.ciac.intake.state.AppState;
import com.ciac.intake.state.Queue;
import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class SubmitOrderController {
  private final AppState state;
  private final Queue queue;
  private final BillingClient billingClient;

  public SubmitOrderController(AppState state, Queue queue, BillingClient billingClient) {
    this.state = state;
    this.queue = queue;
    this.billingClient = billingClient;
  }

  @RequestMapping(method = RequestMethod.POST, path = "/orders")
  public Envelope submitOrder(@RequestBody JsonNode body) throws Exception {
    Object result = Order.decode(body);

    result = billingClient.charge(result);

    queue.publishJson("three_service.order_accepted", result);

    return Envelope.accepted(result);
  }
}
