// ChargeController.java -- Generated by CIaC.
//
// Pipeline: Charge.
package com.ciac.billing.routes;

import com.ciac.billing.logic.RecordCharge;
import com.ciac.billing.schemas.Order;
import com.ciac.billing.state.AppState;
import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class ChargeController {
  private final AppState state;
  private final RecordCharge recordCharge;

  public ChargeController(AppState state, RecordCharge recordCharge) {
    this.state = state;
    this.recordCharge = recordCharge;
  }

  @RequestMapping(method = RequestMethod.POST, path = "/charge")
  public Envelope charge(@RequestBody JsonNode body) throws Exception {
    Object result = Order.decode(body);

    result = recordCharge.handle((Order) result);

    return Envelope.accepted(result);
  }
}
