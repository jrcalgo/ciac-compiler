// World.java -- Generated by CIaC (sim builds only).
//
// 27UpdatePlan.md M8: a full Java restatement of ciac-sim's simulation
// world (crates/ciac-sim/src/world.rs) -- Java cannot vendor the Rust
// crate's source the way the Rust backend does via include_str!, so
// this is a from-scratch, self-contained port (Pillar 4's rule: a
// world template may depend on its language's standard library and
// the target's already-present runtime deps, and nothing else),
// following the same closure TypeScript's own M6 and Go's own M7
// restatements reached. Every public method is `synchronized` (the
// same choice the v0.25 M9 narrow version already made): a generated
// Java service's handlers can run on concurrent Servlet container
// threads, unlike Node's/Python's single-threaded runtimes.
//
// v0.25 M9's narrow scope (only db.insert and broker publish) is
// retired here: schema-aware relational writes (reference/unique/
// cascade checking), a group-aware broker log, a virtual clock, and
// the db/auth peripheral fakes are ported, matching Python's/Rust's/
// TypeScript's/Go's own coverage. cache/object_store/email/search/
// external_http instead embed their own world-awareness directly in
// their own wrapper classes (StringRedisTemplate.java.j2's own
// `cache.*` leaves being the one exception -- see lower.rs's own
// doc) -- a Java-specific structural choice (Pillar 4: "structure may
// diverge; answers may not"), not a narrower fake: `ObjectStore`/
// `Email`/`Search`/`ExternalHttp` each hold their own
// `ObjectProvider<World>` (mirroring `Queue.java`'s own pre-existing
// `publishChecked` pattern, v0.25 M9) and delegate to this same
// `World` instance's own object/email/search/http methods when set,
// so `SimRunner`'s own `expect.*` checks still have exactly one
// source of truth to query. Generated by CIaC for any program with
// something this world can fake (`db`, `queue`, `cache`,
// `object_store`, `email`, `search`, `external_http`, or `auth`),
// mirroring the Rust/TypeScript/Go backends' own `world` emission
// gate.
package com.ciac.intake.sim;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.PropertyNamingStrategies;
import com.fasterxml.jackson.datatype.jsr310.JavaTimeModule;
import java.util.ArrayList;
import java.util.Collections;
import java.util.HashMap;
import java.util.HashSet;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.Objects;
import java.util.Set;
import java.util.function.Predicate;

public final class World {
  // Own mapper, not `Schemas.MAPPER` -- `World.java` is emitted
  // whenever any capability this world can fake is declared, but
  // `Schemas.java` only when the program declares at least one
  // record/resource; a program with only classic (untyped) handlers
  // and no `table`/`crud`/`record` declaration at all (e.g.
  // `event-pipeline.ciac`) has no `Schemas` class to import, found
  // live the moment this backend's own full-example sweep reached
  // it. Configured identically to `Schemas.MAPPER` regardless
  // (`SNAKE_CASE`, so a stored row's map keys agree with a
  // scenario's own `expect.row.where` filter keys, both parsed
  // through a `SNAKE_CASE` mapper) -- two independently-declared
  // mappers are fine as long as neither drifts from the other.
  private static final ObjectMapper MAPPER =
      new ObjectMapper()
          .registerModule(new JavaTimeModule())
          .setPropertyNamingStrategy(PropertyNamingStrategies.SNAKE_CASE);

  /**
   * The `error`-action-only, occurrence-counted subset of ciac_sim::failure's full vocabulary this
   * restatement implements -- the same disclosed scope Rust's/TS's/Go's own restatements hold to
   * (this checkpoint's scenarios need nothing more).
   */
  public record FailureRule(String effect, String subject, int occurrence) {}

  /** One publish, in arrival order. */
  public record QueuedMessage(String subject, byte[] payload) {}

  /** `on_delete`'s two shapes -- the Java counterpart to `ciac_sim::world::WorldRefAction`. */
  public enum RefAction {
    RESTRICT,
    CASCADE
  }

  /**
   * One outgoing reference field, as a schema-aware store needs it -- the Java counterpart to
   * `ciac_sim::world::WorldReference`.
   */
  public record WorldReference(
      String fieldName, String targetTable, RefAction onDelete, boolean unique) {}

  /**
   * One table's worth of schema facts a schema-aware store needs -- just its own outgoing
   * references.
   */
  public record WorldTable(String name, List<WorldReference> references) {}

  /**
   * One configured fixture response -- either an injected failure (`error` set) or a real
   * status/json response, matching the scenario JSON's own `{"error": ..}` vs. `{"status": ..,
   * "json": ..}` shape (the Java counterpart to TypeScript's/Go's own `GivenHttpResponse`).
   */
  public record GivenHttpResponse(String error, Integer status, JsonNode json) {}

  private final Map<String, List<Map<String, Object>>> tables = new HashMap<>();
  private final RelationalSchema schema;
  private final List<QueuedMessage> queue = new ArrayList<>();
  private final BrokerLog broker = new BrokerLog();
  private final FailureEngine failures;
  private long nowMsValue = 0;

  private final Map<String, FakeCache> caches = new HashMap<>();
  private final Map<String, List<byte[]>> objectStoreOrder = new HashMap<>();
  private final Map<String, Map<String, byte[]>> objectStores = new HashMap<>();
  private final Map<String, List<SentEmail>> emails = new HashMap<>();
  private final Map<String, FakeSearch> searches = new HashMap<>();
  private final Map<String, FakeHttpClient> httpClients = new HashMap<>();
  private final FakeAuth auth = new FakeAuth();

  /**
   * 27UpdatePlan.md M8: the `transaction {}` leaf's own atomicity seam, the same ambient-batch-mode
   * design TypeScript's/Go's own M6/M7 restatements introduced for the identical structural reason:
   * this world's own db verbs are checked one statement at a time (mirroring Rust's/TS's/Go's own
   * db_insert_checked/ dbInsertChecked/DBInsertChecked), and production's own `TransactionTemplate`
   * (real, unconditional atomicity already -- see `lower.rs`'s `transaction_stmt` doc) has no
   * equivalent concept to switch into under simulation. While `pendingBatch` is non-null,
   * `dbInsertChecked`/`dbUpdateChecked`/ `dbDeleteChecked` queue an op instead of validating and
   * applying immediately; `commitWorldBatch` validates and applies the whole queue atomically via
   * `commitBatchChecked`.
   */
  private List<BatchOp> pendingBatch;

  public World(List<FailureRule> failureRules) {
    this(failureRules, List.of());
  }

  public World(List<FailureRule> failureRules, List<WorldTable> tables) {
    this.failures = new FailureEngine(failureRules);
    this.schema = new RelationalSchema(tables);
  }

  // -- Predicate-comparison helpers for `db.query`/`db.count`/
  // `db.delete_where`'s own world-guard leaf
  // (`lower.rs`'s `world_predicate_term_expr`) -- the Java
  // counterpart to Go's own `JSONEq`/`Contains`/`Lt`/`LtEq`/`Gt`/
  // `GtEq` free functions. A raw stored row's value and a typed
  // production value can carry different boxed numeric types for
  // what is semantically the same value (Jackson's own untyped
  // `Map<String, Object>` deserialization prefers `Integer` where a
  // production `long` field autoboxes to `Long`), so `Eq`/`NotEq`
  // compare through each side's own JSON text rather than
  // `Objects.equals` directly, exactly like Go's own `JSONEq`
  // sidesteps `int64` vs `float64`. `Lt`/`LtEq`/`Gt`/`GtEq` compare
  // numerically via `Number.doubleValue()` when both sides are
  // numbers, else lexically via `String.valueOf(..).compareTo(..)` --
  // this checkpoint's own corpus only ever orders a numeric field
  // (`domain-orders.ciac`'s own `total >= filter.min_total`), so a
  // `Timestamp` field's own epoch-vs-ISO-text representation gap
  // (disclosed, not fixed: `db.insert`'s stored row holds a JSON-
  // numeric epoch value via Jackson's default `Instant`
  // serialization, while a rendered comparison value is a real
  // `java.time.Instant` object) is a known, narrow corner this
  // milestone's scope does not reach. --

  /**
   * `Eq`/`NotEq`: JSON-text equality, not `Objects.equals` -- see this section's own doc for why.
   */
  public static boolean jsonEq(Object a, Object b) {
    try {
      return Objects.equals(MAPPER.writeValueAsString(a), MAPPER.writeValueAsString(b));
    } catch (com.fasterxml.jackson.core.JsonProcessingException e) {
      throw new RuntimeException("comparing predicate values", e);
    }
  }

  /**
   * `Contains` (the `PredOp::Contains` -> SQL `LIKE` counterpart): a plain case-sensitive substring
   * check over both sides' `String.valueOf`.
   */
  public static boolean contains(Object haystack, Object needle) {
    return String.valueOf(haystack).contains(String.valueOf(needle));
  }

  private static int compare(Object a, Object b) {
    if (a instanceof Number na && b instanceof Number nb) {
      return Double.compare(na.doubleValue(), nb.doubleValue());
    }
    return String.valueOf(a).compareTo(String.valueOf(b));
  }

  public static boolean lt(Object a, Object b) {
    return compare(a, b) < 0;
  }

  public static boolean ltEq(Object a, Object b) {
    return compare(a, b) <= 0;
  }

  public static boolean gt(Object a, Object b) {
    return compare(a, b) > 0;
  }

  public static boolean gtEq(Object a, Object b) {
    return compare(a, b) >= 0;
  }

  private static String rowId(Map<String, Object> row) {
    Object id = row.get("id");
    return id instanceof String s ? s : null;
  }

  @SuppressWarnings("unchecked")
  private static Map<String, Object> toRow(Object value) {
    return MAPPER.convertValue(value, Map.class);
  }

  // -- Relational schema: schema-aware reference/uniqueness/cascade
  // checking, the Java counterpart to ciac_sim::world::
  // RelationalSchema. --

  private record IncomingRef(String table, WorldReference reference) {}

  private static final class RelationalSchema {
    private final Map<String, List<WorldReference>> outgoing = new HashMap<>();

    RelationalSchema(List<WorldTable> tables) {
      for (WorldTable t : tables) {
        outgoing.put(t.name(), t.references());
      }
    }

    List<WorldReference> outgoingOf(String table) {
      return outgoing.getOrDefault(table, List.of());
    }

    /** Every `[referencingTable, reference]` whose reference targets `targetTable`. */
    List<IncomingRef> incomingOf(String targetTable) {
      List<IncomingRef> out = new ArrayList<>();
      for (Map.Entry<String, List<WorldReference>> e : outgoing.entrySet()) {
        for (WorldReference ref : e.getValue()) {
          if (Objects.equals(ref.targetTable(), targetTable)) {
            out.add(new IncomingRef(e.getKey(), ref));
          }
        }
      }
      return out;
    }
  }

  /**
   * A prospective write's reference/uniqueness check against `overlay` (the live store, or a
   * batch's in-progress scratch copy) rather than the real store directly, so a multi-op batch sees
   * its own earlier ops' effects. `selfPk` is the row's own `id` for an update (excluded from both
   * the primary-key collision check and the unique-reference check), `null` for an insert. Throws
   * on the first violation found -- the Java counterpart to `SimWorld::validate_write`.
   */
  private void validateWrite(
      Map<String, List<Map<String, Object>>> overlay,
      String table,
      Map<String, Object> row,
      String selfPk) {
    if (selfPk == null) {
      Object pk = row.get("id");
      if (pk != null) {
        boolean collides =
            overlay.getOrDefault(table, List.of()).stream()
                .anyMatch(r -> Objects.equals(rowId(r), pk));
        if (collides) {
          throw new RuntimeException(table + ".id = \"" + pk + "\" is not unique");
        }
      }
    }
    for (WorldReference field : schema.outgoingOf(table)) {
      Object targetIdObj = row.get(field.fieldName());
      if (!(targetIdObj instanceof String targetId) || field.targetTable() == null) {
        continue;
      }
      String targetTable = field.targetTable();
      boolean targetExists =
          overlay.getOrDefault(targetTable, List.of()).stream()
              .anyMatch(r -> Objects.equals(rowId(r), targetId));
      if (!targetExists) {
        throw new RuntimeException(
            table
                + "."
                + field.fieldName()
                + " references "
                + targetTable
                + "/"
                + targetId
                + ", which does not exist");
      }
      if (field.unique()) {
        boolean conflict =
            overlay.getOrDefault(table, List.of()).stream()
                .anyMatch(
                    r ->
                        Objects.equals(r.get(field.fieldName()), targetId)
                            && !Objects.equals(rowId(r), selfPk));
        if (conflict) {
          throw new RuntimeException(
              table + "." + field.fieldName() + " = \"" + targetId + "\" is not unique");
        }
      }
    }
  }

  private record DeletePlanStep(String table, String pk) {}

  /**
   * Every `[referencingTable, pk]` a delete of `table`/`pk` would cascade into, recursively --
   * throws if a `restrict` reference blocks it. Read-only against `overlay`; the caller applies the
   * result. The Java counterpart to `SimWorld::plan_delete`.
   */
  private List<DeletePlanStep> planDelete(
      Map<String, List<Map<String, Object>>> overlay, String table, String pk) {
    List<DeletePlanStep> planned = new ArrayList<>();
    for (IncomingRef in : schema.incomingOf(table)) {
      List<String> dependents = new ArrayList<>();
      for (Map<String, Object> row : overlay.getOrDefault(in.table(), List.of())) {
        if (Objects.equals(row.get(in.reference().fieldName()), pk)) {
          String id = rowId(row);
          if (id != null) {
            dependents.add(id);
          }
        }
      }
      if (dependents.isEmpty()) {
        continue;
      }
      if (in.reference().onDelete() == RefAction.RESTRICT) {
        throw new RuntimeException(
            "cannot delete "
                + table
                + "/"
                + pk
                + ": restricted by "
                + in.table()
                + "."
                + in.reference().fieldName());
      }
      for (String depPk : dependents) {
        planned.add(new DeletePlanStep(in.table(), depPk));
        planned.addAll(planDelete(overlay, in.table(), depPk));
      }
    }
    return planned;
  }

  private static Map<String, List<Map<String, Object>>> snapshot(
      Map<String, List<Map<String, Object>>> tables) {
    Map<String, List<Map<String, Object>>> out = new HashMap<>();
    for (Map.Entry<String, List<Map<String, Object>>> e : tables.entrySet()) {
      out.put(e.getKey(), new ArrayList<>(e.getValue()));
    }
    return out;
  }

  /**
   * One operation in an atomic `commitBatchChecked` call -- the transaction leaf's own accumulation
   * shape. Deliberately does not auto-expand cascades on delete -- that is `dbDeleteChecked`'s own
   * job as a single, immediate, plan-then-apply call.
   */
  private record BatchOp(String kind, String table, String pk, Map<String, Object> row) {}

  /**
   * db.commit's failure check, schema-aware reference/uniqueness validation, then the actual (fake)
   * write -- mirroring Python's `_FakeSession.commit()`. row is converted internally (Jackson's
   * `convertValue`) rather than requiring every call site to build its own map.
   */
  public synchronized void dbInsertChecked(String table, Object row) {
    Map<String, Object> r = toRow(row);
    if (pendingBatch != null) {
      pendingBatch.add(new BatchOp("insert", table, null, r));
      return;
    }
    if (failures.shouldFail("db.commit", table)) {
      throw new RuntimeException("simulated db.commit failure (injected by FailureEngine)");
    }
    var overlay = snapshot(tables);
    validateWrite(overlay, table, r, null);
    tables.computeIfAbsent(table, k -> new ArrayList<>()).add(r);
  }

  /**
   * Inserts row into table with no failure check -- a scenario's `given.db` seeding, not a
   * simulated db.insert call.
   */
  public synchronized void seedDb(String table, Map<String, Object> row) {
    tables.computeIfAbsent(table, k -> new ArrayList<>()).add(row);
  }

  /**
   * Returns table's rows matching every key/value pair in filter (an empty filter matches every
   * row) -- SimRunner's own expect.row check, not something generated handler code calls.
   */
  public synchronized List<Map<String, Object>> findWhere(
      String table, Map<String, Object> filter) {
    List<Map<String, Object>> out = new ArrayList<>();
    for (Map<String, Object> row : tables.getOrDefault(table, List.of())) {
      boolean matches = true;
      for (Map.Entry<String, Object> e : filter.entrySet()) {
        // `jsonEq`, not `Objects.equals` -- found live
        // (27UpdatePlan.md M8's own fanout scenario):
        // `Schemas.MAPPER.convertValue`'s row storage
        // preserves a numeric field's original writer-side
        // `NumberType` through `TokenBuffer` (a stored `long`
        // field round-trips as `Long`), while a scenario
        // JSON's own `where` filter -- parsed straight off the
        // wire with no static field type to preserve -- always
        // decodes a small integer literal as `Integer`
        // (Jackson's own `UntypedObjectDeserializer` default).
        // `Long.equals(Integer)` is `false` even for equal
        // values, so a raw `Objects.equals` here silently
        // failed every `expect.row.where` filter on an integer
        // field -- the same `Integer`-vs-`Long`/`int64`-vs-
        // `float64` gap Go's own `JSONEq` (`World.jsonEq`
        // mirrors it exactly, added for `db.query`'s own
        // world-guard predicate) already exists to sidestep.
        if (!jsonEq(row.get(e.getKey()), e.getValue())) {
          matches = false;
          break;
        }
      }
      if (matches) {
        out.add(row);
      }
    }
    return out;
  }

  /** By-`id` lookup -- `null` if no row has that key, matching production `db.get`'s own shape. */
  public synchronized Map<String, Object> dbGet(String table, String pk) {
    for (Map<String, Object> row : tables.getOrDefault(table, List.of())) {
      if (Objects.equals(rowId(row), pk)) {
        return row;
      }
    }
    return null;
  }

  /**
   * Every row in table for which pred returns true (a `null` pred matches every row) -- the
   * world-guarded counterpart to a real `SELECT ... WHERE ...`.
   */
  public synchronized List<Map<String, Object>> dbQuery(
      String table, Predicate<Map<String, Object>> pred) {
    List<Map<String, Object>> out = new ArrayList<>();
    for (Map<String, Object> row : tables.getOrDefault(table, List.of())) {
      if (pred == null || pred.test(row)) {
        out.add(row);
      }
    }
    return out;
  }

  /** `dbQuery`'s own row count, without building the intermediate list. */
  public synchronized long dbCount(String table, Predicate<Map<String, Object>> pred) {
    return dbQuery(table, pred).size();
  }

  /**
   * The `id` field of every row in `table` for which `pred` returns `true` -- `db.delete_where`'s
   * own world branch resolves matching rows this way before deleting each individually through
   * `dbDeleteChecked` (real cascade/restrict handling, real failure-injection), a disclosed
   * divergence from production's single bulk `DELETE`, mirroring Rust's/TypeScript's/Go's own
   * `query_tail` world branch exactly.
   */
  public synchronized List<String> dbMatchingIds(
      String table, Predicate<Map<String, Object>> pred) {
    List<String> out = new ArrayList<>();
    for (Map<String, Object> row : dbQuery(table, pred)) {
      String id = rowId(row);
      if (id != null) {
        out.add(id);
      }
    }
    return out;
  }

  /**
   * Full-record replace by `id`, matching production `db.update`'s own shape -- `null` if no row
   * with that `id` exists, exactly like production's "0 rows affected" case, not an error.
   */
  public synchronized Map<String, Object> dbUpdateChecked(
      String table, String pk, Map<String, Object> record) {
    if (pendingBatch != null) {
      pendingBatch.add(new BatchOp("update", table, pk, record));
      // Optimistic, matching Rust's/TypeScript's/Go's own
      // batching branch: the actual "did a row with this id
      // exist" outcome isn't known until the batch commits.
      return record;
    }
    if (failures.shouldFail("db.commit", table)) {
      throw new RuntimeException("simulated db.commit failure (injected by FailureEngine)");
    }
    if (dbGet(table, pk) == null) {
      return null;
    }
    var overlay = snapshot(tables);
    validateWrite(overlay, table, record, pk);
    List<Map<String, Object>> rows = tables.get(table);
    for (int i = 0; i < rows.size(); i++) {
      if (Objects.equals(rowId(rows.get(i)), pk)) {
        rows.set(i, record);
        break;
      }
    }
    return record;
  }

  /**
   * Delete by `id`, resolving cascade/restrict references first via a plan-then-apply pass --
   * `false` if no row with that `id` exists; a restricted delete throws, since a real database
   * would refuse the same delete with a foreign-key violation.
   */
  public synchronized boolean dbDeleteChecked(String table, String pk) {
    if (pendingBatch != null) {
      pendingBatch.add(new BatchOp("delete", table, pk, null));
      // Optimistic, matching Rust's/TypeScript's/Go's own
      // batching branch.
      return true;
    }
    if (failures.shouldFail("db.commit", table)) {
      throw new RuntimeException("simulated db.commit failure (injected by FailureEngine)");
    }
    if (dbGet(table, pk) == null) {
      return false;
    }
    var overlay = snapshot(tables);
    List<DeletePlanStep> cascaded = planDelete(overlay, table, pk);
    tables.get(table).removeIf(r -> Objects.equals(rowId(r), pk));
    for (DeletePlanStep step : cascaded) {
      tables.get(step.table()).removeIf(r -> Objects.equals(rowId(r), step.pk()));
    }
    return true;
  }

  /**
   * Starts ambient batch mode -- every `dbInsertChecked`/ `dbUpdateChecked`/`dbDeleteChecked` call
   * until the matching `commitWorldBatch`/`rollbackWorldBatch` queues instead of applying. Called
   * by a generated `transaction {}` block's world branch.
   */
  public synchronized void beginWorldBatch() {
    pendingBatch = new ArrayList<>();
  }

  /**
   * Validates and applies every op queued since `beginWorldBatch` atomically -- same
   * overlay-then-apply discipline, just gathered ambiently instead of passed as an explicit list.
   * Throws (leaving the real store untouched) on the first violation found.
   */
  public synchronized void commitWorldBatch() {
    List<BatchOp> ops = pendingBatch != null ? pendingBatch : List.of();
    pendingBatch = null;
    commitBatchChecked(ops);
  }

  /**
   * Discards every op queued since `beginWorldBatch` without applying them -- called on a generated
   * transaction block's error path, mirroring a real `ROLLBACK`: nothing was ever written to the
   * real store while batching, so discarding the queue *is* the rollback.
   */
  public synchronized void rollbackWorldBatch() {
    pendingBatch = null;
  }

  /**
   * The `transaction {}` leaf's own accumulation point -- every insert/update/delete in `ops`
   * validates against one scratch overlay of the live store before any of it is applied for real,
   * so a violation partway through a batch leaves the store exactly as it was before the call.
   */
  private void commitBatchChecked(List<BatchOp> ops) {
    if (!ops.isEmpty() && failures.shouldFail("db.commit", ops.get(0).table())) {
      throw new RuntimeException("simulated db.commit failure (injected by FailureEngine)");
    }

    var overlay = snapshot(tables);
    List<DeletePlanStep> allDeletes = new ArrayList<>();

    for (BatchOp op : ops) {
      switch (op.kind()) {
        case "insert" -> {
          validateWrite(overlay, op.table(), op.row(), null);
          overlay.computeIfAbsent(op.table(), k -> new ArrayList<>()).add(op.row());
        }
        case "update" -> {
          validateWrite(overlay, op.table(), op.row(), op.pk());
          List<Map<String, Object>> rows = overlay.get(op.table());
          if (rows != null) {
            for (int i = 0; i < rows.size(); i++) {
              if (Objects.equals(rowId(rows.get(i)), op.pk())) {
                rows.set(i, op.row());
                break;
              }
            }
          }
        }
        default -> {
          List<DeletePlanStep> cascaded = planDelete(overlay, op.table(), op.pk());
          List<DeletePlanStep> steps = new ArrayList<>();
          steps.add(new DeletePlanStep(op.table(), op.pk()));
          steps.addAll(cascaded);
          for (DeletePlanStep step : steps) {
            List<Map<String, Object>> rows = overlay.get(step.table());
            if (rows != null) {
              rows.removeIf(r -> Objects.equals(rowId(r), step.pk()));
            }
          }
          allDeletes.addAll(steps);
        }
      }
    }

    // Every op above validated against the overlay without ever
    // touching the real store -- reaching here means the whole
    // batch is safe to apply for real, all at once.
    for (BatchOp op : ops) {
      if (op.kind().equals("insert")) {
        tables.computeIfAbsent(op.table(), k -> new ArrayList<>()).add(op.row());
      } else if (op.kind().equals("update")) {
        List<Map<String, Object>> rows = tables.get(op.table());
        for (int i = 0; i < rows.size(); i++) {
          if (Objects.equals(rowId(rows.get(i)), op.pk())) {
            rows.set(i, op.row());
            break;
          }
        }
      }
    }
    for (DeletePlanStep step : allDeletes) {
      tables.get(step.table()).removeIf(r -> Objects.equals(rowId(r), step.pk()));
    }
  }

  /**
   * broker.publish's failure check plus the actual (fake) publish -- into both `queue` (the
   * orphan-subject detection sweep still reads it) and `broker` (the group-aware log every worker
   * drains from).
   */
  public synchronized void publishChecked(String subject, byte[] payload) {
    if (failures.shouldFail("broker.publish", subject)) {
      throw new RuntimeException("simulated broker.publish failure (injected by FailureEngine)");
    }
    queue.add(new QueuedMessage(subject, payload));
    broker.publish(subject, payload);
  }

  /**
   * Returns every message published since the last drain, removing them -- SimRunner's own
   * orphan-subject detection sweep.
   */
  public synchronized List<QueuedMessage> drainQueue() {
    List<QueuedMessage> out = new ArrayList<>(queue);
    queue.clear();
    return out;
  }

  /**
   * Every unconsumed message for `(subject, group)`, in log order, each individually acked as it is
   * collected -- SimRunner's own per-worker drain step.
   */
  public synchronized List<byte[]> drainBroker(String subject, String group) {
    return broker.drain(subject, group);
  }

  /**
   * A non-destructive peek -- expect.quiescence needs to observe whether anything is still
   * undelivered without consuming it.
   */
  public synchronized boolean queueIsEmpty() {
    return queue.isEmpty();
  }

  /** Current virtual time, in epoch milliseconds. */
  public synchronized long nowMs() {
    return nowMsValue;
  }

  /**
   * Advances virtual time forward. Throws if `toMs` is before the current time -- virtual time
   * never moves backward.
   */
  public synchronized void advanceClockTo(long toMs) {
    if (toMs < nowMsValue) {
      throw new RuntimeException(
          "virtual clock cannot move backward: at " + nowMsValue + ", asked for " + toMs);
    }
    nowMsValue = toMs;
  }

  // -- Cache: keyed by the declared cache instance name. --

  /**
   * `cache.get` -- `null` if absent or expired (against this world's own virtual clock, never wall
   * time). No failure- injection check, matching Python's own `FakeCache`.
   */
  public synchronized String cacheGet(String instance, String key) {
    return caches.computeIfAbsent(instance, k -> new FakeCache()).get(key, nowMsValue);
  }

  /** `cache.set`. `ttlMs` is `null` for no expiry. */
  public synchronized void cacheSet(String instance, String key, String value, Long ttlMs) {
    caches.computeIfAbsent(instance, k -> new FakeCache()).set(key, value, ttlMs, nowMsValue);
  }

  /** `cache.delete`. */
  public synchronized void cacheDelete(String instance, String key) {
    caches.computeIfAbsent(instance, k -> new FakeCache()).delete(key);
  }

  private static final class FakeCache {
    private final Map<String, String> values = new HashMap<>();
    private final Map<String, Long> expireAt = new HashMap<>();

    String get(String key, long nowMs) {
      Long exp = expireAt.get(key);
      if (exp != null && nowMs >= exp) {
        values.remove(key);
        expireAt.remove(key);
        return null;
      }
      return values.get(key);
    }

    void set(String key, String value, Long ttlMs, long nowMs) {
      values.put(key, value);
      if (ttlMs != null) {
        expireAt.put(key, nowMs + ttlMs);
      } else {
        expireAt.remove(key);
      }
    }

    void delete(String key) {
      values.remove(key);
      expireAt.remove(key);
    }
  }

  // -- Object store: keyed by the declared object_store instance
  // name. `ObjectStore.java`'s own `put`/`get`/`delete`/`list`
  // delegate here when its own injected `world` is set -- see this
  // class's own doc for why this capability (and email/search/
  // http, unlike cache) embeds its world-awareness in its own
  // wrapper class instead of a `lower.rs` guard leaf. --

  /** `object_store.put`. */
  public synchronized void objectPut(String instance, String key, byte[] body) {
    objectStores.computeIfAbsent(instance, k -> new LinkedHashMap<>()).put(key, body);
  }

  /**
   * `object_store.get` -- `null` on a miss, matching this target's own production `ObjectStore.get`
   * (a `NoSuchKeyException` caught and converted to `null`, not an exception `object_store.get`'s
   * own callers ever see) -- the one target-specific divergence from Rust's/TypeScript's/Go's own
   * "throws on a miss" contract, already true in production before this milestone.
   */
  public synchronized byte[] objectGet(String instance, String key) {
    return objectStores.getOrDefault(instance, Map.of()).get(key);
  }

  /** `object_store.delete`. */
  public synchronized void objectDelete(String instance, String key) {
    Map<String, byte[]> store = objectStores.get(instance);
    if (store != null) {
      store.remove(key);
    }
  }

  /** `object_store.list` -- every key with the given prefix, sorted. */
  public synchronized List<String> objectList(String instance, String prefix) {
    List<String> out = new ArrayList<>();
    for (String key : objectStores.getOrDefault(instance, Map.of()).keySet()) {
      if (key.startsWith(prefix)) {
        out.add(key);
      }
    }
    Collections.sort(out);
    return out;
  }

  /**
   * `expect.object`'s own presence check -- distinct from `objectGet`'s "found or null" shape only
   * in that a presence assertion should never itself be treated as a scenario error (both are
   * equally safe here, but the separate method keeps the intent explicit, mirroring
   * Rust's/TypeScript's/Go's own `objectExists`).
   */
  public synchronized boolean objectExists(String instance, String key) {
    return objectStores.getOrDefault(instance, Map.of()).containsKey(key);
  }

  // -- Email: recorded, not scoped to one instance for
  // `expect.email`'s own count query (the scenario schema's
  // `expect.email` carries no `instance` field, matching Python's
  // own `_expect_email`). --

  private record SentEmail(String to, String subject, String body) {}

  /** `email.send`. */
  public synchronized void emailSend(String instance, String to, String subject, String body) {
    emails.computeIfAbsent(instance, k -> new ArrayList<>()).add(new SentEmail(to, subject, body));
  }

  /**
   * `expect.email`'s own count query -- counts across every `email` instance the world has seen.
   */
  public synchronized int emailSentCountAll(String to, String subjectContains) {
    int count = 0;
    for (List<SentEmail> sent : emails.values()) {
      for (SentEmail m : sent) {
        if (to != null && !to.equals(m.to())) {
          continue;
        }
        if (subjectContains != null && !m.subject().contains(subjectContains)) {
          continue;
        }
        count++;
      }
    }
    return count;
  }

  // -- Search: keyed by the declared search instance name -- the
  // same narrow, disclosed query evaluator Python's `FakeSearch`
  // uses: case-insensitive substring match over each document's
  // JSON, matching the shape `search.query` actually lowers to, not
  // a real query language. --

  private static final class FakeSearch {
    private final Map<String, String> docs = new LinkedHashMap<>();

    void index(String docId, String document) {
      docs.put(docId, document);
    }

    List<String> query(String text) {
      if (text.isEmpty()) {
        return new ArrayList<>(docs.values());
      }
      String needle = text.toLowerCase();
      List<String> out = new ArrayList<>();
      for (String doc : docs.values()) {
        if (doc.toLowerCase().contains(needle)) {
          out.add(doc);
        }
      }
      return out;
    }
  }

  /**
   * `search.index`. `document` is already-serialized JSON text (the same shape `Search.java`'s own
   * production `index` method receives).
   */
  public synchronized void searchIndex(String instance, String docId, String document) {
    searches.computeIfAbsent(instance, k -> new FakeSearch()).index(docId, document);
  }

  /**
   * `search.query` -- returns each hit re-parsed as `JsonNode`, matching `Search.java`'s own
   * production `search` return shape.
   */
  public synchronized List<JsonNode> searchQuery(String instance, String text) {
    List<JsonNode> out = new ArrayList<>();
    for (String doc : searches.computeIfAbsent(instance, k -> new FakeSearch()).query(text)) {
      try {
        out.add(MAPPER.readTree(doc));
      } catch (java.io.IOException e) {
        throw new RuntimeException("parsing indexed document", e);
      }
    }
    return out;
  }

  // -- External HTTP: a fixture-driven stand-in, consuming
  // `given.external_http` fixtures in order -- the same portable-
  // scenario fixtures a scenario already carries drive this fake
  // directly, not a second ad hoc format. --

  private static final class FakeHttpClient {
    private List<GivenHttpResponse> responses = List.of();
    private int next = 0;
    private int requestCount = 0;

    void setFixtures(List<GivenHttpResponse> responses) {
      this.responses = responses;
      this.next = 0;
    }

    JsonNode post(String url) {
      requestCount++;
      if (next >= responses.size()) {
        throw new RuntimeException(
            "no fixture response configured for external_http call #"
                + (next + 1)
                + " to \""
                + url
                + "\"");
      }
      GivenHttpResponse resp = responses.get(next);
      next++;
      if (resp.error() != null) {
        throw new RuntimeException("simulated external_http failure: " + resp.error());
      }
      return resp.json();
    }
  }

  /** Seeds `instance`'s fixture queue from a scenario's own `given.external_http` block. */
  public synchronized void seedHttpFixtures(String instance, List<GivenHttpResponse> responses) {
    httpClients.computeIfAbsent(instance, k -> new FakeHttpClient()).setFixtures(responses);
  }

  /**
   * `external_http.request`'s POST call -- consumes the next unconsumed fixture in order, throwing
   * if none remain or the fixture itself declares an error.
   */
  public synchronized JsonNode httpPost(String instance, String url) {
    return httpClients.computeIfAbsent(instance, k -> new FakeHttpClient()).post(url);
  }

  /** `expect.http_calls`'s own count query. */
  public synchronized int httpRequestCount(String instance) {
    FakeHttpClient client = httpClients.get(instance);
    return client != null ? client.requestCount : 0;
  }

  // -- Auth: claims-lookup, not real JWT/JWKS crypto -- the
  // disclosed simplification Python's own FakeAuth already uses.
  // Singular (unlike cache/store/email/search/http): one identity
  // provider per world, not per-instance. --

  private static final class FakeAuth {
    private final Map<String, Object[]> tokens = new HashMap<>();

    void issue(String token, Map<String, Object> claims, Long expireAtMs) {
      tokens.put(token, new Object[] {claims, expireAtMs});
    }

    Map<String, Object> verify(String token, long nowMs) {
      Object[] entry = tokens.get(token);
      if (entry == null) {
        throw new RuntimeException("no configured claims for bearer token \"" + token + "\"");
      }
      @SuppressWarnings("unchecked")
      Map<String, Object> claims = (Map<String, Object>) entry[0];
      Long expireAt = (Long) entry[1];
      if (expireAt != null && nowMs >= expireAt) {
        throw new RuntimeException("bearer token \"" + token + "\" has expired");
      }
      return claims;
    }
  }

  /**
   * Configures the claims (and optional expiry, against this world's own virtual clock) a bearer
   * token verifies to -- `SimRunner`'s own equivalent of Python's `FakeAuth.issue`, called from a
   * scenario's own auth setup, not from generated production code.
   */
  public synchronized void authIssue(String token, Map<String, Object> claims, Long expireAtMs) {
    auth.issue(token, claims, expireAtMs);
  }

  /**
   * The generated auth guard's own verification call -- claims- lookup, not real JWT/JWKS crypto,
   * matching Python's FakeAuth.
   */
  public synchronized Map<String, Object> authVerify(String token) {
    return auth.verify(token, nowMsValue);
  }

  /**
   * The failure rules a scenario declared that never matched a real occurrence -- surfaced to
   * SimRunner rather than silently ignored, matching SIM0007's disclosure discipline.
   */
  public List<String> unmatchedFailureRules() {
    return failures.unmatchedRules();
  }

  /**
   * Tracks occurrence-counted (effect, subject) failure rules against a live run's real occurrences
   * -- mirroring ciac_sim::failure::FailureEngine's record_occurrence, narrowed the same way
   * Go's/TS's own restatement narrows it (occurrence always required, first-match-only via a set
   * rather than an ordered rule list, since this checkpoint's scenarios need nothing more general).
   */
  private static final class FailureEngine {
    private final Set<String> rules = new HashSet<>();
    private final Set<String> matched = new HashSet<>();
    private final Map<String, Integer> counts = new HashMap<>();

    FailureEngine(List<FailureRule> failureRules) {
      for (FailureRule r : failureRules) {
        rules.add(ruleKey(r.effect(), r.subject(), r.occurrence()));
      }
    }

    private static String countKey(String effect, String subject) {
      return effect + " " + subject;
    }

    private static String ruleKey(String effect, String subject, int occurrence) {
      return countKey(effect, subject) + " " + occurrence;
    }

    synchronized boolean shouldFail(String effect, String subject) {
      String ck = countKey(effect, subject);
      int occurrence = counts.merge(ck, 1, Integer::sum);
      String key = ruleKey(effect, subject, occurrence);
      if (rules.contains(key)) {
        matched.add(key);
        return true;
      }
      return false;
    }

    synchronized List<String> unmatchedRules() {
      List<String> out = new ArrayList<>();
      for (String r : rules) {
        if (!matched.contains(r)) {
          out.add(r);
        }
      }
      Collections.sort(out);
      return out;
    }
  }

  /**
   * 27UpdatePlan.md M8 (Pillar 2): one ordered log per subject; every consumer *group* holds its
   * own independent cursor into that log -- two groups on one subject each see every message
   * (fan-out), two workers sharing one group share its cursor (queue-group semantics). Mirrors
   * ciac_sim::world::BrokerLog/ TypeScript's/Go's own BrokerLog exactly.
   */
  private static final class BrokerLog {
    private final Map<String, List<byte[]>> logs = new HashMap<>();
    private final Map<String, Integer> cursors = new HashMap<>();

    private static String cursorKey(String subject, String group) {
      return subject + " " + group;
    }

    synchronized void publish(String subject, byte[] payload) {
      logs.computeIfAbsent(subject, k -> new ArrayList<>()).add(payload);
    }

    /**
     * Every unconsumed message for `(subject, group)`, in log order, each individually acked as it
     * is collected.
     */
    synchronized List<byte[]> drain(String subject, String group) {
      List<byte[]> out = new ArrayList<>();
      String key = cursorKey(subject, group);
      List<byte[]> log = logs.getOrDefault(subject, List.of());
      int pos = cursors.getOrDefault(key, 0);
      while (pos < log.size()) {
        out.add(log.get(pos));
        pos++;
      }
      cursors.put(key, pos);
      return out;
    }
  }
}
