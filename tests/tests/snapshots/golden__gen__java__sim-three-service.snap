package com.ciac.intake.schemas;

import com.fasterxml.jackson.databind.JsonNode;

public record ChargeRecord(String id, String orderId, double amount) {
  /** Decode with absent/null/zero distinction (shared wire contract). */
  public static ChargeRecord decode(JsonNode body) {
    Schemas.requireKeys(body, "id", "order_id", "amount");
    ChargeRecord out = Schemas.MAPPER.convertValue(body, ChargeRecord.class);
    Schemas.requireUuid("id", out.id());
    Schemas.requireUuid("order_id", out.orderId());
    return out;
