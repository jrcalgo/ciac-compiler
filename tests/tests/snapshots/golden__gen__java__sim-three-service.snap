  "openapi": "3.0.3",
  "paths": {
    "/charge": {
      "post": {
        "operationId": "charge",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Order"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Order"
                    },
                    "status": {
                      "type": "string"
