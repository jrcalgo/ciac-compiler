// Order.java -- Generated by CIaC.
package com.ciac.payments.schemas;

import com.fasterxml.jackson.databind.JsonNode;

public record Order(String id, double total) {
  /** Decode with absent/null/zero distinction (shared wire contract). */
  public static Order decode(JsonNode body) {
    Schemas.requireKeys(body, "id", "total");
    Order out = Schemas.MAPPER.convertValue(body, Order.class);
    Schemas.requireUuid("id", out.id());
    return out;
  }
}
