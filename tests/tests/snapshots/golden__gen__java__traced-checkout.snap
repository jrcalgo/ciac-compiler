// SubmitController.java -- Generated by CIaC.
//
// Pipeline: Submit.
package com.ciac.checkout.routes;

import com.ciac.checkout.clients.PaymentsClient;
import com.ciac.checkout.schemas.Order;
import com.ciac.checkout.state.AppState;
import com.ciac.checkout.state.Queue;
import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class SubmitController {
  private final AppState state;
  private final Queue queue;
  private final PaymentsClient paymentsClient;

  public SubmitController(AppState state, Queue queue, PaymentsClient paymentsClient) {
    this.state = state;
    this.queue = queue;
    this.paymentsClient = paymentsClient;
  }

  @RequestMapping(method = RequestMethod.POST, path = "/submit")
  public Envelope submit(@RequestBody JsonNode body) throws Exception {
    Object result = Order.decode(body);

    result = paymentsClient.charge(result);

    queue.publishJson("traced_checkout.placed", result);

    return Envelope.accepted(result);
  }
}
