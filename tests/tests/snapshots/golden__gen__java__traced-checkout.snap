// ChargeController.java -- Generated by CIaC.
//
// Pipeline: Charge.
package com.ciac.payments.routes;

import com.ciac.payments.schemas.Order;
import com.ciac.payments.state.AppState;
import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class ChargeController {
  private final AppState state;

  public ChargeController(AppState state) {
    this.state = state;
  }

  @RequestMapping(method = RequestMethod.POST, path = "/charge")
  public Envelope charge(@RequestBody JsonNode body) throws Exception {
    Object result = Order.decode(body);

    return Envelope.accepted(result);
  }
}
