// SimRunner.java -- Generated by CIaC (v0.25 M9).
//
// Minimal scenario-driving simulation runner. Interprets the same
// closed request/publish/advance/drain/expect scenario vocabulary
// ciac-sim's Scenario JSON schema defines, against this service's own
// generated `@RestController`s (through Spring's standalone MockMvc,
// no live listener) and its worker `handleMessageOnce`/job
// `handleTickOnce` entry points -- line-for-line the same
// architecture as sim_runner.rs.j2/sim_runner.ts.j2/sim_runner.go.j2,
// generated (not a shared library) because this needs concrete
// per-program types, exactly like every other backend's own generated
// runner. Lives under `src/test/java` (not the packaged application)
// since `MockMvc`/`spring-test` only ever sit on the `test`
// classpath; run via `mvn -q test-compile exec:java` (see pom.xml's
// own `exec-maven-plugin` -- compile once, then one `exec:java`
// invocation per scenario, the same "compile once, run the driver
// once per scenario" shape every other target's own toolchain gives
// for free).
//
// Deliberately narrow, matching World.java's own disclosed scope:
// single-service only; `publish` steps (publishing directly to a
// stream, bypassing an API) are not wired; expect.quiescence and
// drain see one global undelivered-message buffer, not independent
// per-(subject, group) cursors. Any scenario step this runner cannot
// honor is a hard error, never a silently-skipped no-op. Structural
// scenario parsing only (simulation_version/non-empty steps) -- this
// is a hand-written restatement of ciac_sim::scenario::Scenario, not
// that vendored Rust source, the same position Python's/TypeScript's/
// Go's own hand-written scenario drivers occupy.
//
// A raw `AnnotationConfigApplicationContext` scanning only the
// non-`Application`-root packages below `com.ciac.checkout`
// is used deliberately instead of `SpringApplication`/
// `@SpringBootTest`: scanning the root package would sweep in
// `Application.class` itself, whose conditional `@EnableScheduling`/
// `@EnableWebSocket` would activate Spring's own background
// `@Scheduled` timer and WebSocket machinery -- exactly the real
// wall-clock/network side effects this runner exists to replace with
// explicit, scenario-driven calls. Skipping `SpringApplication`
// entirely also means no embedded servlet container ever binds a
// port, and no Spring Boot startup banner/logging ever reaches
// stdout -- the single JSON outcome line this process prints is
// always the last line of output, the same "parse the last stdout
// line" contract every other target's own driver already relies on.
package com.ciac.checkout.sim;

import com.ciac.checkout.schemas.Order;
import com.ciac.checkout.workers.ShipWorker;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.PropertyNamingStrategies;
import com.fasterxml.jackson.datatype.jsr310.JavaTimeModule;
import java.nio.file.Files;
import java.nio.file.Path;
import java.time.Instant;
import java.time.ZoneOffset;
import java.time.ZonedDateTime;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import org.springframework.context.annotation.AnnotationConfigApplicationContext;
import org.springframework.http.HttpMethod;
import org.springframework.http.MediaType;
import org.springframework.scheduling.support.CronExpression;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.MvcResult;
import org.springframework.test.web.servlet.request.MockMvcRequestBuilders;
import org.springframework.test.web.servlet.setup.MockMvcBuilders;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.bind.annotation.RestControllerAdvice;

public final class SimRunner {
  private SimRunner() {}

  private static final String SERVICE_NAME = "Checkout";

  // Own mapper, not `Schemas.MAPPER` -- this file is emitted
  // whenever `has_db || has_queue`, but `Schemas.java` only when the
  // program declares at least one record/resource; a `db`/`queue`-
  // capable program with only classic (untyped) handlers has no
  // `Schemas` class to import (`World.java`'s own doc explains the
  // same finding). Configured identically regardless (`SNAKE_CASE`
  // + `JavaTimeModule`), so a typed worker payload class decodes
  // exactly as it would through `Schemas.MAPPER`.
  private static final ObjectMapper MAPPER =
      new ObjectMapper()
          .registerModule(new JavaTimeModule())
          .setPropertyNamingStrategy(PropertyNamingStrategies.SNAKE_CASE);

  // -- Scenario JSON shape (structural restatement of ciac_sim::scenario) --
  // `MAPPER`'s `SNAKE_CASE` naming strategy maps every camelCase
  // component below to/from its wire snake_case key with no
  // `@JsonProperty` needed, the same discipline every generated
  // record already relies on.

  private record Principal(String sub, List<String> scopes) {}

  private record RequestStep(
      String service, String api, JsonNode json, Principal as, String saveAs) {}

  private record PublishStep(String stream, JsonNode json) {}

  private record AdvanceStep(String by) {}

  private record ResponseExpect(String of, Integer status, JsonNode json) {}

  private record RowExpect(
      String service, String table, Map<String, Object> where, boolean present) {}

  private record WorkerAttemptsExpect(String worker, int count) {}

  private record JobRunsExpect(String job, int count) {}

  private record ExpectStep(
      ResponseExpect response,
      RowExpect row,
      WorkerAttemptsExpect workerAttempts,
      JobRunsExpect jobRuns,
      JsonNode quiescence) {}

  private record ScenarioStep(
      RequestStep request,
      PublishStep publish,
      AdvanceStep advance,
      JsonNode drain,
      ExpectStep expect) {}

  private record GivenTableRows(String service, String table, List<Map<String, Object>> rows) {}

  private record FailureSelector(String effect, String subject, int occurrence, String phase) {}

  private record FailureAction(String kind) {}

  private record RawFailureRule(FailureSelector at, FailureAction action) {}

  private record Given(List<GivenTableRows> db, List<RawFailureRule> failures) {}

  private record Scenario(
      int simulationVersion, String name, String startAt, Given given, List<ScenarioStep> steps) {}

  private record SimScenarioOutcome(
      String scenario,
      boolean passed,
      String error,
      Map<String, Integer> workerAttempts,
      Map<String, Integer> jobRuns) {}

  private record SavedResponse(int status, JsonNode json) {}

  private record ApiRoute(String method, String path) {}

  private static final Map<String, ApiRoute> API_ROUTES = new HashMap<>();

  static {
    API_ROUTES.put("Submit", new ApiRoute("POST", "/submit"));
  }

  /**
   * Only the `error` action / `after` phase is implemented -- the same disclosed subset of the full
   * failure vocabulary Rust's own SimWorld::should_fail supports, for the same reason (it's the one
   * action this checkpoint's scenarios need). Refused up front rather than silently ignored if a
   * scenario asks for anything else.
   */
  private static List<World.FailureRule> toFailureRules(List<RawFailureRule> raw) {
    List<World.FailureRule> out = new ArrayList<>();
    for (RawFailureRule r : raw) {
      if (!"error".equals(r.action().kind())) {
        throw new RuntimeException(
            "failure rule for effect \""
                + r.at().effect()
                + "\" uses action \""
                + r.action().kind()
                + "\", which this Java world's FailureEngine integration does not support yet"
                + " (only `error` is implemented)");
      }
      if (!"after".equals(r.at().phase())) {
        throw new RuntimeException(
            "failure rule for effect \""
                + r.at().effect()
                + "\" uses phase \""
                + r.at().phase()
                + "\", which this Java world's FailureEngine integration does not support yet"
                + " (only `after` is implemented)");
      }
      String subject = r.at().subject() != null ? r.at().subject() : "";
      out.add(new World.FailureRule(r.at().effect(), subject, r.at().occurrence()));
    }
    return out;
  }

  private static final Pattern DURATION_RE = Pattern.compile("^(\\d+)(ms|s|m|h|d)$");
  private static final Map<String, Long> UNIT_MS =
      Map.of("ms", 1L, "s", 1_000L, "m", 60_000L, "h", 3_600_000L, "d", 86_400_000L);

  /**
   * Parses `advance.by` strings ("24h", "7d", "30m", ...) -- matches sim/pyrunner/cron.py's
   * parse_duration_ms and every other target's own generated `parseDurationMs`/`parse_duration_ms`
   * exactly.
   */
  private static long parseDurationMs(String text) {
    Matcher m = DURATION_RE.matcher(text);
    if (!m.matches()) {
      throw new RuntimeException("unrecognized duration: \"" + text + "\"");
    }
    return Long.parseLong(m.group(1)) * UNIT_MS.get(m.group(2));
  }

  /**
   * Every cron-due instant in (fromMs, toMs] for schedule -- Spring's own `CronExpression.next`
   * accepts the identical `spring_cron`- translated 6-field seconds-first expression
   * `@Scheduled(cron=..)` itself parses, so this needs no separate cron dialect of its own.
   */
  private static List<Long> dueInstants(CronExpression schedule, long fromMs, long toMs) {
    List<Long> out = new ArrayList<>();
    ZonedDateTime cursor = Instant.ofEpochMilli(fromMs).atZone(ZoneOffset.UTC);
    for (int i = 0; i < 100_000; i++) {
      ZonedDateTime next = schedule.next(cursor);
      if (next == null) {
        break;
      }
      long nextMs = next.toInstant().toEpochMilli();
      if (nextMs > toMs) {
        break;
      }
      out.add(nextMs);
      cursor = next;
    }
    return out;
  }

  private static SavedResponse doRequest(MockMvc mvc, RequestStep spec) throws Exception {
    if (!SERVICE_NAME.equals(spec.service())) {
      throw new RuntimeException(
          "sim_runner only drives service \""
              + SERVICE_NAME
              + "\" (single-service only); request named \""
              + spec.service()
              + "\"");
    }
    ApiRoute route = API_ROUTES.get(spec.api());
    if (route == null) {
      throw new RuntimeException("sim_runner: no api registered named \"" + spec.api() + "\"");
    }
    var reqBuilder =
        MockMvcRequestBuilders.request(HttpMethod.valueOf(route.method()), route.path());
    if (spec.json() != null) {
      reqBuilder =
          reqBuilder
              .contentType(MediaType.APPLICATION_JSON)
              .content(MAPPER.writeValueAsBytes(spec.json()));
    }
    MvcResult result = mvc.perform(reqBuilder).andReturn();
    String content = result.getResponse().getContentAsString();
    JsonNode json = content.isEmpty() ? null : MAPPER.readTree(content);
    return new SavedResponse(result.getResponse().getStatus(), json);
  }

  /**
   * Hands every message currently undelivered to its worker's `handleMessageOnce` exactly once
   * (with that worker's own retry budget) -- messages a handler publishes as a side effect of
   * processing are left for the *next* drain step. Dispatches by an if/else-if chain over the
   * subject string (never a `switch`, which would hard-error at compile time the moment two workers
   * share one subject, e.g. `sim-broker-slice.ciac`'s `ConsumerA`/ `ConsumerB` -- Go's own M9 found
   * this the hard way with its `switch`; this runner never risks it): the *first* worker registered
   * for a subject receives every drained message, any others sharing that subject receive none --
   * see World.java's own doc for why this runner has no independent per-(subject, group) cursors.
   */
  private static void drain(
      AnnotationConfigApplicationContext ctx, World world, Map<String, Integer> workerAttempts)
      throws Exception {
    for (World.QueuedMessage msg : world.drainQueue()) {
      boolean delivered = false;
      if (!delivered && ShipWorker.SUBJECT.equals(msg.subject())) {
        delivered = true;
        Object payload = MAPPER.readValue(msg.payload(), Order.class);
        ShipWorker worker = ctx.getBean(ShipWorker.class);
        int attempts = 0;
        Exception lastError = null;
        for (int attempt = 0; attempt <= ShipWorker.MAX_RETRIES; attempt++) {
          attempts++;
          try {
            worker.handleMessageOnce(payload);
            lastError = null;
            break;
          } catch (Exception e) {
            lastError = e;
          }
        }
        if (lastError != null) {
          System.err.println("sim_runner: Ship exhausted retries: " + lastError);
        }
        workerAttempts.merge("Ship", attempts, Integer::sum);
      }
      if (!delivered) {
        throw new RuntimeException(
            "sim_runner: no worker registered to consume subject \""
                + msg.subject()
                + "\" (disclosed scope)");
      }
    }
  }

  private static void advance(
      AnnotationConfigApplicationContext ctx, long fromMs, long toMs, Map<String, Integer> jobRuns)
      throws Exception {}

  private static void expect(
      ExpectStep spec,
      World world,
      Map<String, SavedResponse> saved,
      Map<String, Integer> workerAttempts,
      Map<String, Integer> jobRuns) {
    if (spec.response() != null) {
      SavedResponse got = saved.get(spec.response().of());
      if (got == null) {
        throw new RuntimeException(
            "expect.response.of references unknown save_as \"" + spec.response().of() + "\"");
      }
      if (spec.response().status() != null && got.status() != spec.response().status()) {
        throw new RuntimeException(
            "expect.response.of=\""
                + spec.response().of()
                + "\": expected status "
                + spec.response().status()
                + ", got "
                + got.status());
      }
      if (spec.response().json() != null && !spec.response().json().equals(got.json())) {
        throw new RuntimeException(
            "expect.response.of=\""
                + spec.response().of()
                + "\": expected json "
                + spec.response().json()
                + ", got "
                + got.json());
      }
    } else if (spec.row() != null) {
      if (!SERVICE_NAME.equals(spec.row().service())) {
        throw new RuntimeException(
            "sim_runner only drives service \""
                + SERVICE_NAME
                + "\" (single-service only); expect.row named \""
                + spec.row().service()
                + "\"");
      }
      Map<String, Object> where = spec.row().where() != null ? spec.row().where() : Map.of();
      boolean found = !world.findWhere(spec.row().table(), where).isEmpty();
      if (found != spec.row().present()) {
        throw new RuntimeException(
            "expect.row: table=\""
                + spec.row().table()
                + "\" where="
                + where
                + " present="
                + spec.row().present()
                + ", found="
                + found);
      }
    } else if (spec.workerAttempts() != null) {
      int actual = workerAttempts.getOrDefault(spec.workerAttempts().worker(), 0);
      if (actual != spec.workerAttempts().count()) {
        throw new RuntimeException(
            "expect.worker_attempts: worker=\""
                + spec.workerAttempts().worker()
                + "\" expected "
                + spec.workerAttempts().count()
                + ", got "
                + actual);
      }
    } else if (spec.jobRuns() != null) {
      int actual = jobRuns.getOrDefault(spec.jobRuns().job(), 0);
      if (actual != spec.jobRuns().count()) {
        throw new RuntimeException(
            "expect.job_runs: job=\""
                + spec.jobRuns().job()
                + "\" expected "
                + spec.jobRuns().count()
                + ", got "
                + actual);
      }
    } else if (spec.quiescence() != null) {
      if (!world.queueIsEmpty()) {
        throw new RuntimeException(
            "expect.quiescence: undelivered message(s) remain in the simulated broker");
      }
    } else {
      throw new RuntimeException("sim_runner: unrecognized expect step");
    }
  }

  public static void main(String[] args) throws Exception {
    if (args.length < 1) {
      System.err.println("usage: SimRunner <scenario.json>");
      System.exit(1);
    }
    Scenario sc = MAPPER.readValue(Files.readString(Path.of(args[0])), Scenario.class);
    if (sc.simulationVersion() != 1) {
      System.err.println(
          "scenario simulation_version "
              + sc.simulationVersion()
              + " is not supported (expected 1)");
      System.exit(1);
    }
    if (sc.steps() == null || sc.steps().isEmpty()) {
      System.err.println("scenario has no steps");
      System.exit(1);
    }

    Given given = sc.given() != null ? sc.given() : new Given(List.of(), List.of());
    List<World.FailureRule> failureRules =
        toFailureRules(given.failures() != null ? given.failures() : List.of());
    World world = new World(failureRules);
    for (GivenTableRows seed : given.db() != null ? given.db() : List.<GivenTableRows>of()) {
      if (!SERVICE_NAME.equals(seed.service())) {
        System.err.println(
            "sim_runner only drives service \""
                + SERVICE_NAME
                + "\" (single-service only); given.db named \""
                + seed.service()
                + "\"");
        System.exit(1);
      }
      for (Map<String, Object> row : seed.rows()) {
        world.seedDb(seed.table(), row);
      }
    }

    long nowMs;
    try {
      nowMs = Instant.parse(sc.startAt()).toEpochMilli();
    } catch (Exception e) {
      System.err.println("scenario start_at \"" + sc.startAt() + "\": not a valid date");
      System.exit(1);
      return;
    }

    // Scans everything below the root package EXCEPT `Application`
    // itself (see the class doc) plus manually registers the one
    // `World` bean instance every `ObjectProvider<World>`
    // injection point (Queue, and every `needs_db` typed handler)
    // resolves against -- the only difference from production
    // wiring.
    AnnotationConfigApplicationContext ctx = new AnnotationConfigApplicationContext();
    ctx.scan(
        "com.ciac.checkout.routes",
        "com.ciac.checkout.services",
        "com.ciac.checkout.logic",
        "com.ciac.checkout.state",
        "com.ciac.checkout.workers",
        "com.ciac.checkout.clients");
    ctx.registerBean("world", World.class, () -> world);
    ctx.refresh();

    MockMvc mvc =
        MockMvcBuilders.standaloneSetup(
                ctx.getBeansWithAnnotation(RestController.class).values().toArray())
            .setControllerAdvice(
                ctx.getBeansWithAnnotation(RestControllerAdvice.class).values().toArray())
            .build();

    Map<String, SavedResponse> saved = new HashMap<>();
    Map<String, Integer> workerAttempts = new HashMap<>();
    Map<String, Integer> jobRuns = new HashMap<>();

    Exception runErr = null;
    for (ScenarioStep step : sc.steps()) {
      try {
        if (step.request() != null) {
          SavedResponse resp = doRequest(mvc, step.request());
          if (step.request().saveAs() != null) {
            saved.put(step.request().saveAs(), resp);
          }
        } else if (step.publish() != null) {
          throw new RuntimeException(
              "sim_runner does not support `publish` steps (disclosed scope)");
        } else if (step.advance() != null) {
          long deltaMs = parseDurationMs(step.advance().by());
          long toMs = nowMs + deltaMs;
          advance(ctx, nowMs, toMs, jobRuns);
          nowMs = toMs;
        } else if (step.drain() != null) {
          drain(ctx, world, workerAttempts);
        } else if (step.expect() != null) {
          expect(step.expect(), world, saved, workerAttempts, jobRuns);
        } else {
          throw new RuntimeException("sim_runner: unrecognized step");
        }
      } catch (Exception e) {
        runErr = e;
      }
      if (runErr != null) {
        break;
      }
    }
    if (runErr == null) {
      List<String> unmatched = world.unmatchedFailureRules();
      if (!unmatched.isEmpty()) {
        runErr =
            new RuntimeException(
                unmatched.size()
                    + " failure rule(s) declared in `given.failures` never matched a real"
                    + " occurrence: "
                    + unmatched);
      }
    }

    SimScenarioOutcome outcome =
        new SimScenarioOutcome(
            sc.name(),
            runErr == null,
            runErr != null ? runErr.getMessage() : null,
            workerAttempts,
            jobRuns);
    ctx.close();
    System.out.println(MAPPER.writeValueAsString(outcome));
  }
}
