// ClipStore.java -- Generated by CIaC.
//
// Persistence for the Clip resource.
package com.ciac.media.services;

import com.ciac.media.schemas.Clip;
import com.ciac.media.schemas.ClipIn;
import com.ciac.media.schemas.RowMappers;
import java.util.List;
import java.util.Optional;
import java.util.UUID;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.jdbc.core.simple.JdbcClient;
import org.springframework.stereotype.Component;

@Component
public class ClipStore {
  private final JdbcClient jdbc;

  public ClipStore(@Qualifier("dbJdbc") JdbcClient jdbc) {
    this.jdbc = jdbc;
  }

  public Clip create(ClipIn payload) {
    String id = UUID.randomUUID().toString();
    jdbc.sql("INSERT INTO clips (id, title, duration_s, status) VALUES (?, ?, ?, ?)")
        .param(id)
        .param(payload.title())
        .param(payload.durationS())
        .param(payload.status())
        .update();
    return new Clip(id, payload.title(), payload.durationS(), payload.status());
  }

  public Optional<Clip> get(String id) {
    return jdbc.sql("SELECT id, title, duration_s, status FROM clips WHERE id = ?")
        .param(id)
        .query(RowMappers.CLIP)
        .optional();
  }

  public List<Clip> list(int limit, int offset) {
    return jdbc.sql("SELECT id, title, duration_s, status FROM clips ORDER BY id LIMIT ? OFFSET ?")
        .param(limit)
        .param(offset)
        .query(RowMappers.CLIP)
        .list();
  }

  public Optional<Clip> update(String id, ClipIn payload) {
    int n =
        jdbc.sql("UPDATE clips SET title = ?, duration_s = ?, status = ? WHERE id = ?")
            .param(payload.title())
            .param(payload.durationS())
            .param(payload.status())
            .param(id)
            .update();
    if (n == 0) {
      return Optional.empty();
    }
    return Optional.of(new Clip(id, payload.title(), payload.durationS(), payload.status()));
  }

  public boolean delete(String id) {
    int n = jdbc.sql("DELETE FROM clips WHERE id = ?").param(id).update();
    return n > 0;
  }
}
