// UploadController.java -- Generated by CIaC.
//
// Pipeline: Upload.
package com.ciac.media.routes;

import com.ciac.media.logic.StoreVideo;
import com.ciac.media.schemas.Video;
import com.ciac.media.state.AppState;
import com.ciac.media.state.Queue;
import com.fasterxml.jackson.databind.JsonNode;
import jakarta.servlet.http.HttpServletRequest;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.security.oauth2.jwt.JwtDecoder;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class UploadController {
  private final AppState state;
  private final Queue queue;
  private final JwtDecoder jwtDecoder;
  private final StoreVideo storeVideo;

  public UploadController(
      AppState state, Queue queue, JwtDecoder jwtDecoder, StoreVideo storeVideo) {
    this.state = state;
    this.queue = queue;
    this.jwtDecoder = jwtDecoder;
    this.storeVideo = storeVideo;
  }

  @RequestMapping(method = RequestMethod.POST, path = "/upload")
  public Envelope upload(HttpServletRequest request, @RequestBody JsonNode body) throws Exception {
    Jwt jwt = Auth.verifyToken(request, jwtDecoder);
    Object result = Video.decode(body);

    result = storeVideo.handle((Video) result);

    queue.publishJson("media.uploaded", result);

    return Envelope.accepted(result);
  }
}
