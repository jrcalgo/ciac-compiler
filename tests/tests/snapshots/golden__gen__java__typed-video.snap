// Video.java -- Generated by CIaC.
package com.ciac.media.schemas;

import com.fasterxml.jackson.databind.JsonNode;

public record Video(String id, String title, long durationS, VideoStatus status) {
  /** Decode with absent/null/zero distinction (shared wire contract). */
  public static Video decode(JsonNode body) {
    Schemas.requireKeys(body, "id", "title", "duration_s", "status");
    Video out = Schemas.MAPPER.convertValue(body, Video.class);
    Schemas.requireUuid("id", out.id());
    return out;
  }
}
