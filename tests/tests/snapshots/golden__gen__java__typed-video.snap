// ClipIn.java -- Generated by CIaC.
//
// Create/update payload for the `Clip` CRUD resource.
package com.ciac.media.schemas;

import com.fasterxml.jackson.databind.JsonNode;

public record ClipIn(String title, long durationS, VideoStatus status) {
  /** Decode with absent/null/zero distinction (shared wire contract). */
  public static ClipIn decode(JsonNode body) {
    Schemas.requireKeys(body, "title", "duration_s", "status");
    return Schemas.MAPPER.convertValue(body, ClipIn.class);
