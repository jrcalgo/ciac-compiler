docker-compose.yml
============================================================
services:

  catalog:
    build: ./catalog
    ports:
      - "8000:8000"
    environment:
      DATABASE_URL_MAIN: postgresql+asyncpg://postgres:postgres@catalog-db-main:5432/catalog_main
    depends_on:
      catalog-db-main:
        condition: service_healthy

  accounts:
    build: ./accounts
    ports:
      - "8001:8000"
    environment:
      DATABASE_URL_MAIN: postgresql+asyncpg://postgres:postgres@accounts-db-main:5432/accounts_main
    depends_on:
      accounts-db-main:
        condition: service_healthy

  catalog-db-main:
    image: postgres:16
    ports:
      - "5432:5432"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: catalog_main
    volumes:
      - catalog-db-main-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 2s
      timeout: 3s
      retries: 20

  accounts-db-main:
    image: postgres:16
    ports:
      - "5433:5432"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: accounts_main
    volumes:
      - accounts-db-main-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 2s
      timeout: 3s
      retries: 20

volumes:
  catalog-db-main-data:
  accounts-db-main-data:
