"""REST endpoints for the `ResourceVideo` resource. Generated by CIaC."""


from fastapi import APIRouter, Depends, HTTPException, Query, status
from sqlalchemy.ext.asyncio import AsyncSession

from app.db import get_session_main
from app.models import ResourceVideoIn, ResourceVideoOut
from app.services.resource_video_store import ResourceVideoStore

router = APIRouter(
    prefix="/resource_videos",
    tags=["resource_videos"],
)


def _store(
    session: AsyncSession = Depends(get_session_main),
) -> ResourceVideoStore:
    return ResourceVideoStore(
        session
    )


def _out(entity: object) -> ResourceVideoOut:
    return ResourceVideoOut.model_validate(entity, from_attributes=True)


@router.post("", status_code=status.HTTP_201_CREATED)
async def create_resource_video(
    payload: ResourceVideoIn,
    store: ResourceVideoStore = Depends(_store),
) -> ResourceVideoOut:
    entity = await store.create(payload)
    return _out(entity)


@router.get("")
async def list_resource_videos(
    limit: int = Query(100, ge=1),
    offset: int = Query(0, ge=0),
    store: ResourceVideoStore = Depends(_store),
) -> list[ResourceVideoOut]:
    entities = await store.list(limit=limit, offset=offset)
    return [_out(entity) for entity in entities]


@router.get("/{entity_id}")
async def get_resource_video(
    entity_id: str,
    store: ResourceVideoStore = Depends(_store),
) -> ResourceVideoOut:
    entity = await store.get(entity_id)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return _out(entity)


@router.put("/{entity_id}")
async def update_resource_video(
    entity_id: str,
    payload: ResourceVideoIn,
    store: ResourceVideoStore = Depends(_store),
) -> ResourceVideoOut:
    entity = await store.update(entity_id, payload)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return _out(entity)


@router.delete("/{entity_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_resource_video(
    entity_id: str,
    store: ResourceVideoStore = Depends(_store),
) -> None:
    deleted = await store.delete(entity_id)
    if not deleted:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
