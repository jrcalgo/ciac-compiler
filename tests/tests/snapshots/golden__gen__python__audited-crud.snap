    model_config = SettingsConfigDict(env_file=".env", extra="ignore")

    database_url_main: str = "postgresql+asyncpg://postgres:postgres@localhost:5432/catalog_main"


@lru_cache
def get_settings() -> Settings:
    return Settings()
