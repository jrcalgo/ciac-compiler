"""Persistence for the `ResourceUser` resource. Generated by CIaC."""

import uuid

from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from app.models import ResourceUser, ResourceUserIn


class ResourceUserStore:
    """CRUD operations for ResourceUser."""

    def __init__(
        self,
        session: AsyncSession,
    ) -> None:
        self.session = session

    async def create(self, payload: ResourceUserIn) -> ResourceUser:
        entity = ResourceUser(id=str(uuid.uuid4()), **payload.model_dump(mode="json"))
        self.session.add(entity)
        await self.session.commit()
        return entity

    async def get(self, entity_id: str) -> ResourceUser | None:
        return await self.session.get(ResourceUser, entity_id)

    async def list(self, limit: int = 100, offset: int = 0) -> list[ResourceUser]:
        result = await self.session.scalars(select(ResourceUser).limit(limit).offset(offset))
        return list(result)

    async def update(self, entity_id: str, payload: ResourceUserIn) -> ResourceUser | None:
        entity = await self.session.get(ResourceUser, entity_id)
        if entity is None:
            return None
        for field, value in payload.model_dump(mode="json").items():
            setattr(entity, field, value)
        await self.session.commit()
        return entity

    async def delete(self, entity_id: str) -> bool:
        entity = await self.session.get(ResourceUser, entity_id)
        if entity is None:
            return False
        await self.session.delete(entity)
        await self.session.commit()
        return True
