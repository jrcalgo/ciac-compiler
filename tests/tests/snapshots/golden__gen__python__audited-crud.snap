"""REST endpoints for the `ResourceUser` resource. Generated by CIaC."""


from fastapi import APIRouter, Depends, HTTPException, Query, status
from sqlalchemy.ext.asyncio import AsyncSession

from app.db import get_session_main
from app.models import ResourceUserIn, ResourceUserOut
from app.services.resource_user_store import ResourceUserStore

router = APIRouter(
    prefix="/resource_users",
    tags=["resource_users"],
)


def _store(
    session: AsyncSession = Depends(get_session_main),
) -> ResourceUserStore:
    return ResourceUserStore(
        session
    )


def _out(entity: object) -> ResourceUserOut:
    return ResourceUserOut.model_validate(entity, from_attributes=True)


@router.post("", status_code=status.HTTP_201_CREATED)
async def create_resource_user(
    payload: ResourceUserIn,
    store: ResourceUserStore = Depends(_store),
) -> ResourceUserOut:
    entity = await store.create(payload)
    return _out(entity)


@router.get("")
async def list_resource_users(
    limit: int = Query(100, ge=1),
    offset: int = Query(0, ge=0),
    store: ResourceUserStore = Depends(_store),
) -> list[ResourceUserOut]:
    entities = await store.list(limit=limit, offset=offset)
    return [_out(entity) for entity in entities]


@router.get("/{entity_id}")
async def get_resource_user(
    entity_id: str,
    store: ResourceUserStore = Depends(_store),
) -> ResourceUserOut:
    entity = await store.get(entity_id)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return _out(entity)


@router.put("/{entity_id}")
async def update_resource_user(
    entity_id: str,
    payload: ResourceUserIn,
    store: ResourceUserStore = Depends(_store),
) -> ResourceUserOut:
    entity = await store.update(entity_id, payload)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return _out(entity)


@router.delete("/{entity_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_resource_user(
    entity_id: str,
    store: ResourceUserStore = Depends(_store),
) -> None:
    deleted = await store.delete(entity_id)
    if not deleted:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
