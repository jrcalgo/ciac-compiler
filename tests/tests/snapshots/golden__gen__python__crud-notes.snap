"""Redis cache client. Generated by CIaC.

The client is created lazily and Redis only connects on first use, so
importing the app never requires a running cache.
"""

import redis.asyncio as redis

from app.config import get_settings

_client: redis.Redis | None = None


def get_cache() -> redis.Redis:
    global _client
    if _client is None:
        _client = redis.Redis.from_url(get_settings().redis_url, decode_responses=True)
    return _client
