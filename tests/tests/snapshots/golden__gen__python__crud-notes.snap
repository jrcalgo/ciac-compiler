"""JWT authentication. Generated by CIaC.

`Auth` pipeline steps become a FastAPI dependency that verifies the
bearer token and hands the verified claims to the route.
"""

from typing import Any

import jwt
from fastapi import Depends, HTTPException, status
from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer

from app.config import get_settings

_bearer = HTTPBearer()


async def require_auth(
    credentials: HTTPAuthorizationCredentials = Depends(_bearer),
) -> dict[str, Any]:
    """Verifies the request's bearer token and returns its claims."""
    settings = get_settings()
    try:
        return jwt.decode(
            credentials.credentials,
            settings.jwt_secret,
            algorithms=[settings.jwt_algorithm],
        )
    except jwt.InvalidTokenError as exc:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="invalid or expired token",
        ) from exc


def require_scope(scope: str):
    """Builds a dependency that verifies a JWT contains `scope`."""

    async def dependency(claims: dict[str, Any] = Depends(require_auth)) -> dict[str, Any]:
        scopes = claims.get("scope", claims.get("scp", ""))
        if isinstance(scopes, str):
            granted = set(scopes.split())
        elif isinstance(scopes, list):
            granted = {str(item) for item in scopes}
        else:
            granted = set()
        if scope not in granted:
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail="missing required scope",
            )
        return claims

    return dependency
