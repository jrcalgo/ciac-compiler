"""Persistence models and API schemas for CRUD resources and `table`
declarations. Generated by CIaC.

Typed resources (`crud X: Record;`) get real columns from their record;
untyped ones keep a generic keyed-document model (UUID key + JSON
payload). `table <Name>: <Record>;` declarations (v0.7) get the same
column treatment, named after the table so a record reused under several
table names doesn't collide. Enums are stored as text.
"""


from typing import Any

from pydantic import BaseModel, Field
from sqlalchemy import JSON, String
from sqlalchemy.orm import Mapped, mapped_column

from app.db import Base



class Note(Base):
    __tablename__ = "notes"

    id: Mapped[str] = mapped_column(String(36), primary_key=True)
    data: Mapped[dict[str, Any]] = mapped_column(JSON, default=dict)


class NoteIn(BaseModel):
    """Payload for creating or updating a Note."""

    data: dict[str, Any] = Field(default_factory=dict)


class NoteOut(BaseModel):
    id: str
    data: dict[str, Any]

