"""REST endpoints for the `Note` resource. Generated by CIaC."""

from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.ext.asyncio import AsyncSession

from app.auth import require_auth
from app.cache import get_cache
from app.db import get_session
from app.models import NoteIn, NoteOut
from app.services.note_store import NoteStore

router = APIRouter(
    prefix="/notes",
    tags=["notes"],
    dependencies=[Depends(require_auth)],
)


def _store(session: AsyncSession = Depends(get_session)) -> NoteStore:
    return NoteStore(
        session, cache=get_cache()
    )


@router.post("", status_code=status.HTTP_201_CREATED)
async def create_note(
    payload: NoteIn,
    store: NoteStore = Depends(_store),
) -> NoteOut:
    entity = await store.create(payload.data)
    return NoteOut(id=entity.id, data=entity.data)


@router.get("")
async def list_notes(
    store: NoteStore = Depends(_store),
) -> list[NoteOut]:
    entities = await store.list()
    return [NoteOut(id=e.id, data=e.data) for e in entities]


@router.get("/{entity_id}")
async def get_note(
    entity_id: str,
    store: NoteStore = Depends(_store),
) -> NoteOut:
    entity = await store.get(entity_id)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return NoteOut(id=entity.id, data=entity.data)


@router.put("/{entity_id}")
async def update_note(
    entity_id: str,
    payload: NoteIn,
    store: NoteStore = Depends(_store),
) -> NoteOut:
    entity = await store.update(entity_id, payload.data)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return NoteOut(id=entity.id, data=entity.data)


@router.delete("/{entity_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_note(
    entity_id: str,
    store: NoteStore = Depends(_store),
) -> None:
    deleted = await store.delete(entity_id)
    if not deleted:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
