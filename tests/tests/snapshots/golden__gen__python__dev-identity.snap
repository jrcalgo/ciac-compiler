"""OAuth2 (JWKS resource-server) authentication. Generated by CIaC.

`Auth` pipeline steps become a FastAPI dependency that verifies the
bearer token and hands the verified claims to the route.
"""

from typing import Any

import jwt
from fastapi import Depends, HTTPException, status
from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer

from app.config import get_settings
from app.state import current

_bearer = HTTPBearer()


def _jwks() -> jwt.PyJWKClient:
    """Lazily built, cached JWKS client for the configured issuer."""
    state = current()
    if state.jwks_client is None:
        issuer = get_settings().oauth_issuer.rstrip("/")
        state.jwks_client = jwt.PyJWKClient(f"{issuer}/.well-known/jwks.json")
    return state.jwks_client


async def require_auth(
    credentials: HTTPAuthorizationCredentials = Depends(_bearer),
) -> dict[str, Any]:
    """Verifies the bearer token against the issuer's JWKS (RS256)."""
    state = current()
    if state.world is not None:
        # v0.17 M8: the checkpoint's auth port -- bypasses real JWT/
        # JWKS verification entirely rather than faking the JWKS HTTP
        # round-trip; see `sim/pyrunner/world.py`'s `FakeAuth` docstring.
        try:
            return state.world.auth.verify(credentials.credentials)
        except Exception as exc:
            raise HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                detail="invalid or expired token",
            ) from exc
    settings = get_settings()
    try:
        key = _jwks().get_signing_key_from_jwt(credentials.credentials)
        return jwt.decode(
            credentials.credentials,
            key.key,
            algorithms=["RS256"],
            issuer=settings.oauth_issuer,
            audience=settings.oauth_audience or None,
            options={"verify_aud": bool(settings.oauth_audience)},
        )
    except jwt.exceptions.PyJWKClientError as exc:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="cannot resolve a signing key for this token",
        ) from exc
    except jwt.InvalidTokenError as exc:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="invalid or expired token",
        ) from exc


def require_scope(scope: str):
    """Builds a dependency that verifies a JWT contains `scope`."""

    async def dependency(claims: dict[str, Any] = Depends(require_auth)) -> dict[str, Any]:
        scopes = claims.get("scope", claims.get("scp", ""))
        if isinstance(scopes, str):
            granted = set(scopes.split())
        elif isinstance(scopes, list):
            granted = {str(item) for item in scopes}
        else:
            granted = set()
        if scope not in granted:
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail="missing required scope",
            )
        return claims

    return dependency
