"""Application assembly for Accounts. Generated by CIaC."""

from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

import json
from pathlib import Path
from typing import Any

from fastapi import FastAPI

from app.api.account import router as account_router


@asynccontextmanager
async def lifespan(_: FastAPI) -> AsyncIterator[None]:
    from app.db import create_schema
    await create_schema()
    yield


app = FastAPI(title="Accounts", lifespan=lifespan)

# The document `ciac build` emitted alongside this app (openapi.json,
# derived straight from the IR) is the single source of truth for the
# API spec; FastAPI's own auto-generated one would be a second,
# slightly-different opinion on the same routes.
_openapi_path = Path(__file__).resolve().parent.parent / "openapi.json"


def _openapi() -> dict[str, Any]:
    if app.openapi_schema is None:
        app.openapi_schema = json.loads(_openapi_path.read_text())
    return app.openapi_schema


app.openapi = _openapi


@app.get("/health")
async def health() -> dict[str, str]:
    return {"status": "ok"}


app.include_router(account_router)
