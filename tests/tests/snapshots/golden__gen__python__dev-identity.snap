app/state.py
============================================================
"""The explicit production/simulation dependency-injection boundary
(v0.17 M3). Generated by CIaC.

Every provider module's `get_*` accessor (`app/db.py`, `app/cache.py`,
`app/queue.py`, ...) reads and lazily populates its client(s) here
instead of keeping a private module-global cache -- `AppState` is the
one seam both a real server process and a future simulation run install
themselves through, never a second copy of provider state that could
drift from it.

Two constructors, always explicit -- simulation is never selected by an
environment variable in the normal server binary, and a failed
production connection never falls back to fake state:

    state = AppState.production(settings)   # real provider adapters
    state = AppState.simulation(world)       # in-process fakes (v0.17 M4+)

`AppState.production` builds nothing eagerly; provider clients stay as
lazy as they are today (see `app/db.py`'s own docstring) -- constructing
an `AppState` never requires a running database, cache, or broker.
"""

from __future__ import annotations

import contextvars
from dataclasses import dataclass, field
from typing import Any

from app.config import Settings


@dataclass
class AppState:
    """Every provider client this service's generated code can access,
    keyed by capability instance name where a capability supports more
    than one named instance. Fields are typed `Any` deliberately: the
    concrete client type (an `AsyncEngine`, a `redis.Redis`, ...) is
    each provider module's own concern, not this file's -- `AppState`
    is a storage seam, not a second place those types get declared.
    """

    settings: Settings
    engines: dict[str, Any] = field(default_factory=dict)
    sessionmakers: dict[str, Any] = field(default_factory=dict)
    caches: dict[str, Any] = field(default_factory=dict)
    queue_client: Any | None = None
    jwks_client: Any | None = None
    object_stores: dict[str, Any] = field(default_factory=dict)
    emails: dict[str, Any] = field(default_factory=dict)
    searches: dict[str, Any] = field(default_factory=dict)
    http_clients: dict[str, Any] = field(default_factory=dict)

    @classmethod
    def production(cls, settings: Settings) -> "AppState":
        """Real provider adapters, built lazily on first access by each
        provider module -- this constructor itself never opens a
        connection."""
        return cls(settings=settings)

    @classmethod
    def simulation(cls, world: Any) -> "AppState":
        """In-process fakes, installed by the `ciac-sim` runner. Not yet
        implemented -- no fake has been built (that starts v0.17 M4) --
        but the signature exists now so the explicit production()/
        simulation() boundary never needs to change shape once fakes
        land; calling this today is itself the honest failure."""
        raise NotImplementedError(
            "AppState.simulation() has no fakes to construct yet -- "
            "the deterministic simulator lands starting v0.17 M4"
        )


_current: contextvars.ContextVar[AppState] = contextvars.ContextVar("ciac_app_state")


def set_current(state: AppState) -> None:
    """Installs `state` as the active state for this process (or, once
    a multi-service simulation runner exists, this async context --
    `contextvars` propagate per-task, which is what lets a future
    single-process multi-service runner give each service's tasks their
    own `AppState` without a global mutable singleton)."""
    _current.set(state)


def current() -> AppState:
    """The active `AppState` -- set once by `create_app` before any
    request or generated task runs."""
    return _current.get()
