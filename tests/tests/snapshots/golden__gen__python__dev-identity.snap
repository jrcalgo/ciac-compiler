"""REST endpoints for the `Account` resource. Generated by CIaC."""


from typing import Any

from fastapi import APIRouter, Depends, HTTPException, Query, status
from sqlalchemy.ext.asyncio import AsyncSession

from app.auth import require_scope
from app.db import get_session
from app.models import AccountIn, AccountOut
from app.services.account_store import AccountStore

router = APIRouter(
    prefix="/accounts",
    tags=["accounts"],
)


def _store(
    session: AsyncSession = Depends(get_session),
) -> AccountStore:
    return AccountStore(
        session
    )


def _out(entity: object) -> AccountOut:
    return AccountOut.model_validate(entity, from_attributes=True)


@router.post("", status_code=status.HTTP_201_CREATED)
async def create_account(
    payload: AccountIn,
    _claims: dict[str, Any] = Depends(require_scope("accounts:write")),
    store: AccountStore = Depends(_store),
) -> AccountOut:
    entity = await store.create(payload)
    return _out(entity)


@router.get("")
async def list_accounts(
    limit: int = Query(100, ge=1),
    offset: int = Query(0, ge=0),
    _claims: dict[str, Any] = Depends(require_scope("accounts:read")),
    store: AccountStore = Depends(_store),
) -> list[AccountOut]:
    entities = await store.list(limit=limit, offset=offset)
    return [_out(entity) for entity in entities]


@router.get("/{entity_id}")
async def get_account(
    entity_id: str,
    _claims: dict[str, Any] = Depends(require_scope("accounts:read")),
    store: AccountStore = Depends(_store),
) -> AccountOut:
    entity = await store.get(entity_id)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return _out(entity)


@router.put("/{entity_id}")
async def update_account(
    entity_id: str,
    payload: AccountIn,
    _claims: dict[str, Any] = Depends(require_scope("accounts:write")),
    store: AccountStore = Depends(_store),
) -> AccountOut:
    entity = await store.update(entity_id, payload)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return _out(entity)


@router.delete("/{entity_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_account(
    entity_id: str,
    _claims: dict[str, Any] = Depends(require_scope("accounts:write")),
    store: AccountStore = Depends(_store),
) -> None:
    deleted = await store.delete(entity_id)
    if not deleted:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
