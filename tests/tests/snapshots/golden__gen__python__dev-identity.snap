pyproject.toml
============================================================
[project]
name = "accounts"
version = "0.1.0"
description = "Generated by CIaC from `service Accounts`"
requires-python = ">=3.11"
dependencies = [
    "fastapi>=0.115",
    "uvicorn[standard]>=0.30",
    "pydantic-settings>=2.4",
    "sqlalchemy[asyncio]>=2.0",
    "asyncpg>=0.29",
    "pyjwt[crypto]>=2.8",
]

[dependency-groups]
dev = [
    "pytest>=8.0",
    "anyio>=4.4",
    "httpx>=0.27",
    "ruff>=0.6",
]

[tool.uv]
package = false

[tool.pytest.ini_options]
# tests/system/ needs the compose stack up and is run only by
# `ciac verify --system` (from its own directory); plain `pytest`
# must never collect it.
norecursedirs = ["tests/system"]

[tool.ruff]
target-version = "py311"

[tool.ruff.lint]
# Pinned explicitly, not left to ruff's own default: `ruff>=0.6`
# above has no upper bound, and a newer ruff resolved at generation
# time silently expanded its defaults (bugbear, isort, pyupgrade
# style checks) past what these templates were written to satisfy,
# breaking `ciac verify` on every fresh project (v0.29 M1 finding
# F4). This is ruff's own long-documented default selection --
# pinning it here makes the templates immune to ruff's own default
# ever moving again.
select = ["E4", "E7", "E9", "F"]
============================================================
scripts/token.sh
============================================================
#!/usr/bin/env bash
# Mints a real OAuth2 access token from the dev Keycloak realm
# (v0.15 M6). Generated by CIaC.
#
# Usage: scripts/token.sh <dev-admin|dev-user> [scope ...]
#   scripts/token.sh dev-admin "accounts:read accounts:write"
#   scripts/token.sh dev-user
set -euo pipefail

KEYCLOAK_URL="${KEYCLOAK_URL:-http://localhost:8080}"
REALM="dev"
CLIENT_ID="ciac-dev"
PASSWORD="dev-password"

USER="${1:?usage: scripts/token.sh <dev-admin|dev-user> [scope ...]}"
shift || true
SCOPE="$*"

args=(-d "client_id=$CLIENT_ID" -d "grant_type=password" -d "username=$USER" -d "password=$PASSWORD")
if [ -n "$SCOPE" ]; then
  args+=(-d "scope=$SCOPE")
fi

response="$(curl -sf "${args[@]}" "$KEYCLOAK_URL/realms/$REALM/protocol/openid-connect/token")"
if command -v jq >/dev/null 2>&1; then
  printf '%s\n' "$response" | jq -r .access_token
else
  printf '%s\n' "$response" | sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p'
fi
============================================================
tests/test_oauth_rig.py
============================================================
"""The no-infra OAuth2 scope rig. Generated by CIaC (`26UpdatePlan.md`
M4). Real RS256 signing against a real (if tiny) in-process JWKS
server -- `conftest.py` starts the stub and points `OAUTH_ISSUER` at
it before this module (or `app.main`) is ever imported, so the
`require_auth`/`require_scope` dependencies under test run their exact
production code path: fetch JWKS, match `kid`, verify a real
signature, check `iss`/`aud`/`exp`. No live identity provider is
involved; the crypto is real, not the issuer.
"""

import time

import httpx
import jwt
import pytest

from app.config import get_settings
from app.main import app
from conftest import OAUTH_KID, OAUTH_PRIVATE_KEY_PEM, OAUTH_WRONG_KEY_PEM


def _client(*, raise_app_exceptions: bool = True) -> httpx.AsyncClient:
    transport = httpx.ASGITransport(app=app, raise_app_exceptions=raise_app_exceptions)
    return httpx.AsyncClient(transport=transport, base_url="http://test")


def _mint(
    scope: str,
    *,
    key_pem: str = OAUTH_PRIVATE_KEY_PEM,
    kid: str = OAUTH_KID,
    issuer: str | None = None,
    exp_delta: int = 3600,
) -> dict[str, str]:
    settings = get_settings()
    claims: dict[str, object] = {
        "sub": "test",
        "scope": scope,
        "iss": issuer if issuer is not None else settings.oauth_issuer,
        "exp": int(time.time()) + exp_delta,
    }
    if settings.oauth_audience:
        claims["aud"] = settings.oauth_audience
    token = jwt.encode(claims, key_pem, algorithm="RS256", headers={"kid": kid})
    return {"Authorization": f"Bearer {token}"}



@pytest.mark.anyio
async def test_accounts_read_wrong_scope() -> None:
    async with _client() as client:
        response = await client.get("/accounts", headers=_mint("not:accounts:read"))
    assert response.status_code == 403


@pytest.mark.anyio
async def test_accounts_read_correct_scope() -> None:
    async with _client(raise_app_exceptions=False) as client:
        response = await client.get("/accounts", headers=_mint("accounts:read"))
    assert response.status_code not in (401, 403)


@pytest.mark.anyio
async def test_accounts_read_expired_token() -> None:
    async with _client() as client:
        response = await client.get(
            "/accounts", headers=_mint("accounts:read", exp_delta=-3600)
        )
    assert response.status_code == 401


@pytest.mark.anyio
async def test_accounts_read_wrong_key() -> None:
    async with _client() as client:
        response = await client.get(
            "/accounts", headers=_mint("accounts:read", key_pem=OAUTH_WRONG_KEY_PEM)
        )
    assert response.status_code == 401


@pytest.mark.anyio
async def test_accounts_read_wrong_issuer() -> None:
    async with _client() as client:
        response = await client.get(
            "/accounts", headers=_mint("accounts:read", issuer="http://wrong-issuer.example")
        )
    assert response.status_code == 401


@pytest.mark.anyio
async def test_accounts_write_wrong_scope() -> None:
    async with _client() as client:
        response = await client.post(
            "/accounts", json={}, headers=_mint("not:accounts:write")
        )
    assert response.status_code == 403


@pytest.mark.anyio
async def test_accounts_write_correct_scope() -> None:
    async with _client(raise_app_exceptions=False) as client:
        response = await client.post(
            "/accounts", json={}, headers=_mint("accounts:write")
        )
    assert response.status_code not in (401, 403)


@pytest.mark.anyio
async def test_accounts_write_expired_token() -> None:
    async with _client() as client:
        response = await client.post(
            "/accounts", json={}, headers=_mint("accounts:write", exp_delta=-3600)
        )
    assert response.status_code == 401


@pytest.mark.anyio
async def test_accounts_write_wrong_key() -> None:
    async with _client() as client:
        response = await client.post(
            "/accounts", json={}, headers=_mint("accounts:write", key_pem=OAUTH_WRONG_KEY_PEM)
        )
    assert response.status_code == 401


@pytest.mark.anyio
async def test_accounts_write_wrong_issuer() -> None:
    async with _client() as client:
        response = await client.post(
            "/accounts",
            json={},
            headers=_mint("accounts:write", issuer="http://wrong-issuer.example"),
        )
    assert response.status_code == 401
