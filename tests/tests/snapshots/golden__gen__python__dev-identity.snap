pyproject.toml
============================================================
[project]
name = "accounts"
version = "0.1.0"
description = "Generated by CIaC from `service Accounts`"
requires-python = ">=3.11"
dependencies = [
    "fastapi>=0.115",
    "uvicorn[standard]>=0.30",
    "pydantic-settings>=2.4",
    "sqlalchemy[asyncio]>=2.0",
    "asyncpg>=0.29",
    "pyjwt[crypto]>=2.8",
]

[dependency-groups]
dev = [
    "pytest>=8.0",
    "anyio>=4.4",
    "httpx>=0.27",
    "ruff>=0.6",
]

[tool.uv]
package = false

[tool.pytest.ini_options]
# tests/system/ needs the compose stack up and is run only by
# `ciac verify --system` (from its own directory); plain `pytest`
# must never collect it.
norecursedirs = ["tests/system"]

[tool.ruff]
target-version = "py311"
============================================================
scripts/token.sh
============================================================
#!/usr/bin/env bash
# Mints a real OAuth2 access token from the dev Keycloak realm
# (v0.15 M6). Generated by CIaC.
#
# Usage: scripts/token.sh <dev-admin|dev-user> [scope ...]
#   scripts/token.sh dev-admin "accounts:read accounts:write"
#   scripts/token.sh dev-user
set -euo pipefail

KEYCLOAK_URL="${KEYCLOAK_URL:-http://localhost:8080}"
REALM="dev"
CLIENT_ID="ciac-dev"
PASSWORD="dev-password"

USER="${1:?usage: scripts/token.sh <dev-admin|dev-user> [scope ...]}"
shift || true
SCOPE="$*"

args=(-d "client_id=$CLIENT_ID" -d "grant_type=password" -d "username=$USER" -d "password=$PASSWORD")
if [ -n "$SCOPE" ]; then
  args+=(-d "scope=$SCOPE")
fi

response="$(curl -sf "${args[@]}" "$KEYCLOAK_URL/realms/$REALM/protocol/openid-connect/token")"
if command -v jq >/dev/null 2>&1; then
  printf '%s\n' "$response" | jq -r .access_token
else
  printf '%s\n' "$response" | sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p'
fi
