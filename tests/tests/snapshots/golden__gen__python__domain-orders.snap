"""Generated behavioral test for `AddLineItem`. Regenerated on every build.

Exercises the lowered handler body against mocked runtime dependencies;
real persistence round-trips are `ciac verify --live`'s job, not this test.
"""
from unittest.mock import AsyncMock, MagicMock
from uuid import uuid4

import pytest

from app.logic.add_line_item import AddLineItem
from app.schemas import LineItem


@pytest.mark.anyio
async def test_add_line_item_handle() -> None:
    session = AsyncMock()
    session.add = MagicMock()
    handler = AddLineItem(session=session)

    result = await handler.handle(LineItem(id=str(uuid4()), order_id=str(uuid4()), sku="test", quantity=0))

    assert isinstance(result, LineItem)
    session.add.assert_called_once()
    session.commit.assert_awaited_once()
