"""Handler for the `CountOrders` typed handler. Generated by CIaC.

Compiler-owned: lowered from the source `handler CountOrders(..) { .. }` body
on every build. Business logic lives in the `.ciac` source, not here.
"""
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, func
from app.models import Orders
from app.schemas import OrderCountFilter


class CountOrders:
    """Business logic for the `CountOrders` handler."""

    def __init__(
        self,
        session: AsyncSession | None = None,
    ) -> None:
        self.session = session

    async def handle(self, filter: OrderCountFilter) -> int:
        _stmt = select(func.count()).select_from(Orders).where(Orders.total >= filter.min_total)
        return (await self.session.execute(_stmt)).scalar_one()
