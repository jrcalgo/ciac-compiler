"""Request pipeline for `api Checkout`. Generated by CIaC.

Pipeline: PlaceOrder -> Return
"""

from typing import Any

from fastapi import APIRouter, Depends
from sqlalchemy.ext.asyncio import AsyncSession

from app.db import get_session
from app.schemas import Order
from app.logic.place_order import PlaceOrder

router = APIRouter()


@router.post("/orders")
async def checkout(
    payload: Order,
    session: AsyncSession = Depends(get_session),
) -> dict[str, Any]:
    result = payload

    result = await PlaceOrder(session=session).handle(result)
    if isinstance(result, list):
        return {"status": "accepted", "data": [r.model_dump(mode="json") if hasattr(r, "model_dump") else r for r in result]}
    return {
        "status": "accepted",
        "data": result.model_dump(mode="json") if hasattr(result, "model_dump") else result,
    }
