"""Handler for the `PlaceOrder` typed handler. Generated by CIaC.

Compiler-owned: lowered from the source `handler PlaceOrder(..) { .. }` body
on every build. Business logic lives in the `.ciac` source, not here.
"""

from uuid import uuid4
from sqlalchemy.ext.asyncio import AsyncSession
from app.models import OrderAudits, Orders
from app.schemas import InvalidOrder, Order, OrderAudit


class PlaceOrder:
    """Business logic for the `PlaceOrder` handler."""

    def __init__(
        self,
        session: AsyncSession | None = None,
    ) -> None:
        self.session = session

    async def handle(self, order: Order) -> Order:
        try:
            self.session.add(Orders(**order.model_dump()))
            if (order.total < 0):
                raise InvalidOrder("order total must not be negative")
            else:
                pass
            self.session.add(OrderAudits(**OrderAudit(id=str(uuid4()), note="order placed", total=order.total).model_dump()))
            await self.session.commit()
        except Exception:
            await self.session.rollback()
            raise
        return order
