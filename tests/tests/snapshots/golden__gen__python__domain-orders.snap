        super().__init__("InvalidOrder(" + ", ".join(f"{k}={v!r}" for k, v in self.__dict__.items()) + ")")


class IdOnly(BaseModel):
    id: str


class OrderCountFilter(BaseModel):
    min_total: float


class DeleteResult(BaseModel):
