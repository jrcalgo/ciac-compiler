"""Runs every worker in one process: `python -m app.workers`. Generated by CIaC."""

import asyncio

from app.workers import (
    processor,
    page_view_consumer,
)


async def main() -> None:
    await asyncio.gather(
        processor.run(),
        page_view_consumer.run(),
    )


if __name__ == "__main__":
    asyncio.run(main())
