"""Request pipeline for `api Submit`. Generated by CIaC.

Pipeline: Validate -> publish ingest.events -> Return
"""

from typing import Any

from fastapi import APIRouter, Depends
from sqlalchemy.ext.asyncio import AsyncSession

from app.db import get_session
from app.queue import publish
from app.services.validate import Validate

router = APIRouter()


@router.post("/submit")
async def submit(
    payload: dict[str, Any],
    session: AsyncSession = Depends(get_session),
) -> dict[str, Any]:
    result: dict[str, Any] = dict(payload)

    result = await Validate(session=session).handle(result)
    await publish("ingest.events", result)
    return {"status": "accepted", "data": result}
