"""Event consumer for `events PageViewConsumer`. Generated by CIaC.

Consumes `ingest.page_view` in queue group `page_view_consumer`.
"""

import json
from typing import Any
import nats

from app.config import get_settings
from app.db import get_sessionmaker

SUBJECT = "ingest.page_view"
QUEUE_GROUP = "page_view_consumer"


async def handle_event(payload: dict[str, Any]) -> None:
    async with get_sessionmaker()() as session:
        _ = session
        _ = payload  # TODO: persist or process the PageViewConsumer event.


async def run() -> None:
    """Subscribes and processes events forever."""
    client = await nats.connect(get_settings().nats_url)
    subscription = await client.subscribe(SUBJECT, queue=QUEUE_GROUP)
    async for message in subscription.messages:
        await handle_event(json.loads(message.data))
