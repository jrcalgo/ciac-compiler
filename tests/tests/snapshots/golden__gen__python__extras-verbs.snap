"""External HTTP clients. Generated by CIaC.

Each `external_http` instance gets a lazy httpx client with its
configured base URL, so handlers call third-party APIs through a single
managed client per upstream.
"""

import httpx

from app.config import get_settings
from app.state import current


def get_http_client(instance: str) -> httpx.AsyncClient:
    clients = current().http_clients
    if instance not in clients:
        settings = get_settings()
        base_urls = {
            "upstream": settings.http_base_url_upstream,
        }
        clients[instance] = httpx.AsyncClient(base_url=base_urls[instance])
    return clients[instance]
