gateway/app/clients/catalog.py
============================================================
"""Typed HTTP client for the `Catalog` service. Generated by CIaC.

`call Catalog.<Api>` pipeline steps invoke these methods. The
base URL comes from `CATALOG_URL`; the system docker-compose points
it at the `catalog` container.
"""

import httpx

from app.config import get_settings
from app.state import current
from app.schemas import Item


class CatalogClient:
    """Calls `Catalog` over HTTP and unwraps its response envelope
    -- or, under `ciac sim` (28UpdatePlan.md M3), routes through
    `SimWorld.call_checked` against `Catalog`'s own registered
    handler instead of real HTTP, the same `state.world is not None`
    guard `app/db.py`'s `get_sessionmaker` already uses for the database
    seam. `call_checked` invokes the target api route function directly
    (`world.register_api`'s own handler), so its return value carries
    the *same* `{"status": ..., "data": ...}` envelope every route
    function's own body already builds (see `api.py.j2`) -- this
    unwraps `["data"]` from it exactly the way the real-HTTP branch
    unwraps `response.json()["data"]`, same post-processing, different
    transport."""

    def __init__(self) -> None:
        self._base_url = get_settings().catalog_url

    async def price(self, payload: Item) -> Item:
        state = current()
        if state.world is not None:
            req = payload.model_dump(mode="json")
            result = await state.world.call_checked(
                "Gateway", "Catalog", "Price", req
            )
            return Item.model_validate(result["data"])
        async with httpx.AsyncClient(base_url=self._base_url) as client:
            response = await client.post(
                "/price", json=payload.model_dump(mode="json")
            )
        response.raise_for_status()
        return Item.model_validate(response.json()["data"])

