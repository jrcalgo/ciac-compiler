gateway/tests/test_smoke.py
============================================================
"""Smoke tests generated by CIaC.

These run without any infrastructure: clients are lazy and the ASGI
transport below does not trigger the startup lifespan.
"""

import time

import httpx
import jwt
import pytest

from app.config import get_settings
from app.main import app


def _client(*, raise_app_exceptions: bool = True) -> httpx.AsyncClient:
    transport = httpx.ASGITransport(app=app, raise_app_exceptions=raise_app_exceptions)
    return httpx.AsyncClient(transport=transport, base_url="http://test")


def _bearer(scope: str, *, exp_delta: int = 3600) -> dict[str, str]:
    """A locally-signed token carrying `scope` — the JWT scheme verifies
    against `jwt_secret`, which this process already has, so no live
    issuer is needed to prove the scope check itself works. `exp_delta`
    in the past mints an already-expired token (`26UpdatePlan.md` M4's
    `expired_token` case)."""
    settings = get_settings()
    claims = {"sub": "test", "scope": scope, "exp": int(time.time()) + exp_delta}
    token = jwt.encode(claims, settings.jwt_secret, algorithm=settings.jwt_algorithm)
    return {"Authorization": f"Bearer {token}"}


def test_routes_registered() -> None:
    paths = set(app.openapi()["paths"])
    assert "/quote" in paths
    assert "/health" in paths


@pytest.mark.anyio
async def test_health() -> None:
    async with _client() as client:
        response = await client.get("/health")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}


@pytest.mark.anyio
async def test_quote_no_token() -> None:
    async with _client() as client:
        response = await client.post("/quote", json={})
    assert response.status_code in (401, 403)


@pytest.mark.anyio
async def test_quote_malformed_token() -> None:
    # `26UpdatePlan.md` M4: a case matrix entry the JWT suite alone
    # never distinguished from `no_token` — both schemes' decoders
    # reject an unparseable bearer value the same way.
    async with _client() as client:
        response = await client.post(
            "/quote", json={}, headers={"Authorization": "Bearer not-a-jwt"}
        )
    assert response.status_code == 401


@pytest.mark.anyio
async def test_quote_wrong_scope() -> None:
    async with _client() as client:
        response = await client.post(
            "/quote", json={}, headers=_bearer("not:gateway:quote")
        )
    assert response.status_code == 403


@pytest.mark.anyio
async def test_quote_correct_scope() -> None:
    # `raise_app_exceptions=False`: a granted-scope request clears the
    # auth dependency and reaches the route body, which may then fail
    # on a real dependency this no-infra suite doesn't have (a live
    # db/cache/queue) — that failure becomes a 5xx, still proof the
    # auth layer itself let the request through.
    async with _client(raise_app_exceptions=False) as client:
        response = await client.post(
            "/quote", json={}, headers=_bearer("gateway:quote")
        )
    assert response.status_code not in (401, 403)


@pytest.mark.anyio
async def test_quote_expired_token() -> None:
    async with _client() as client:
        response = await client.post(
            "/quote", json={}, headers=_bearer("gateway:quote", exp_delta=-3600)
        )
    assert response.status_code == 401
