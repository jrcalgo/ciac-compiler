"""Request pipeline for `api Quote`. Generated by CIaC.

Pipeline: Auth -> call Catalog.Price -> Return
"""

from typing import Any

from fastapi import APIRouter, Depends

from app.auth import require_scope
from app.clients.catalog import CatalogClient
from app.schemas import Item

router = APIRouter()


@router.post("/quote")
async def quote(
    payload: Item,
    claims: dict[str, Any] = Depends(require_scope("gateway:quote")),
) -> dict[str, Any]:
    result = payload

    result = await CatalogClient().price(result)
    if isinstance(result, list):
        return {"status": "accepted", "data": [r.model_dump(mode="json") if hasattr(r, "model_dump") else r for r in result]}
    return {
        "status": "accepted",
        "data": result.model_dump(mode="json") if hasattr(result, "model_dump") else result,
    }
