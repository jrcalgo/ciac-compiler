"""Request pipeline for `api Quote`. Generated by CIaC.

Pipeline: call Catalog.Price -> Return
"""

from typing import Any

from fastapi import APIRouter

from app.clients.catalog import CatalogClient
from app.schemas import Item

router = APIRouter()


@router.post("/quote")
async def quote(
    payload: Item,
) -> dict[str, Any]:
    result = payload

    result = await CatalogClient().price(result)
    return {"status": "accepted", "data": result.model_dump(mode="json")}
