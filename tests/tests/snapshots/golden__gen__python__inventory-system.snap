"""REST endpoints for the `Item` resource. Generated by CIaC."""


from typing import Any

from fastapi import APIRouter, Depends, HTTPException, Query, status
from sqlalchemy.ext.asyncio import AsyncSession

from app.auth import require_auth
from app.cache import get_cache
from app.db import get_session
from app.models import ItemIn, ItemOut
from app.services.item_store import ItemStore

router = APIRouter(
    prefix="/items",
    tags=["items"],
)


def _store(
    session: AsyncSession = Depends(get_session),
) -> ItemStore:
    return ItemStore(
        session, cache=get_cache()
    )


def _out(entity: object) -> ItemOut:
    return ItemOut.model_validate(entity, from_attributes=True)


@router.post("", status_code=status.HTTP_201_CREATED)
async def create_item(
    payload: ItemIn,
    _claims: dict[str, Any] = Depends(require_auth),
    store: ItemStore = Depends(_store),
) -> ItemOut:
    entity = await store.create(payload)
    return _out(entity)


@router.get("")
async def list_items(
    limit: int = Query(100, ge=1),
    offset: int = Query(0, ge=0),
    _claims: dict[str, Any] = Depends(require_auth),
    store: ItemStore = Depends(_store),
) -> list[ItemOut]:
    entities = await store.list(limit=limit, offset=offset)
    return [_out(entity) for entity in entities]


@router.get("/{entity_id}")
async def get_item(
    entity_id: str,
    _claims: dict[str, Any] = Depends(require_auth),
    store: ItemStore = Depends(_store),
) -> ItemOut:
    entity = await store.get(entity_id)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return _out(entity)


@router.put("/{entity_id}")
async def update_item(
    entity_id: str,
    payload: ItemIn,
    _claims: dict[str, Any] = Depends(require_auth),
    store: ItemStore = Depends(_store),
) -> ItemOut:
    entity = await store.update(entity_id, payload)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return _out(entity)


@router.delete("/{entity_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_item(
    entity_id: str,
    _claims: dict[str, Any] = Depends(require_auth),
    store: ItemStore = Depends(_store),
) -> None:
    deleted = await store.delete(entity_id)
    if not deleted:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
