"""Request pipeline for `api Price`. Generated by CIaC.

Pipeline: ComputePrice -> Return
"""

from typing import Any

from fastapi import APIRouter, Depends
from sqlalchemy.ext.asyncio import AsyncSession

from app.cache import get_cache
from app.db import get_session
from app.schemas import Item
from app.services.compute_price import ComputePrice

router = APIRouter()


@router.post("/price")
async def price(
    payload: Item,
    session: AsyncSession = Depends(get_session),
) -> dict[str, Any]:
    result = payload

    result = await ComputePrice(session=session, cache=get_cache()).handle(result)
    return {"status": "accepted", "data": result.model_dump(mode="json")}
