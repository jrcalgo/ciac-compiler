"""Smoke tests generated by CIaC.

These run without any infrastructure: clients are lazy and the ASGI
transport below does not trigger the startup lifespan.
"""

import httpx
import pytest

from app.main import app


def _client() -> httpx.AsyncClient:
    transport = httpx.ASGITransport(app=app)
    return httpx.AsyncClient(transport=transport, base_url="http://test")


def test_routes_registered() -> None:
    paths = set(app.openapi()["paths"])
    assert "/price" in paths
    assert "/items" in paths
    assert "/health" in paths


@pytest.mark.anyio
async def test_health() -> None:
    async with _client() as client:
        response = await client.get("/health")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}

============================================================
docker-compose.yml
============================================================
services:

  catalog:
    build: ./catalog
    ports:
      - "8000:8000"
    environment:
      DATABASE_URL: postgresql+asyncpg://postgres:postgres@catalog-db:5432/catalog
      REDIS_URL: redis://catalog-cache:6379/0
    depends_on:
      - catalog-db
      - catalog-cache

  gateway:
    build: ./gateway
    ports:
      - "8001:8000"
    environment:
      CATALOG_URL: http://catalog:8000

  catalog-db:
    image: postgres:16
    ports:
      - "5432:5432"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: catalog
    volumes:
      - catalog-db-data:/var/lib/postgresql/data

  catalog-cache:
    image: redis:7
    ports:
      - "6379:6379"

volumes:
  catalog-db-data:
