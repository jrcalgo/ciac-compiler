app/workers/enrich.py
============================================================
"""Worker pipeline for `worker Enrich`. Generated by CIaC.

Consumes `clickstream.clicks` in queue group `enrich`
so replicas of this worker load-balance messages between them.
"""

import asyncio
import logging

from aiokafka import AIOKafkaConsumer

from app.config import get_settings
from app.schemas import Click
from app.services.enrich_click import EnrichClick

SUBJECT = "clickstream.clicks"
QUEUE_GROUP = "enrich"
CONCURRENCY = 1
MAX_RETRIES = 0
logger = logging.getLogger(__name__)



async def handle_message_once(payload: Click) -> None:
    result = payload

    result = await EnrichClick().handle(result)


async def handle_message(payload: Click) -> None:
    for attempt in range(MAX_RETRIES + 1):
        try:
            await handle_message_once(payload)
            return
        except Exception:
            if attempt >= MAX_RETRIES:
                logger.exception("message processing failed after retries")
                return
            logger.warning("message processing failed; retrying", exc_info=True)


async def _consume(worker_index: int) -> None:
    consumer = AIOKafkaConsumer(
        SUBJECT,
        group_id=QUEUE_GROUP,
        bootstrap_servers=get_settings().kafka_url,
    )
    await consumer.start()
    logger.info("worker Enrich consumer %s subscribed", worker_index)
    try:
        async for message in consumer:
            await handle_message(Click.model_validate_json(message.value))
    finally:
        await consumer.stop()


async def run() -> None:
    """Subscribes and processes messages forever."""
    await asyncio.gather(*(_consume(idx) for idx in range(CONCURRENCY)))
