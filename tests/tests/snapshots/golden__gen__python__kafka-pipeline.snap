"""Request pipeline for `api Ingest`. Generated by CIaC.

Pipeline: publish clickstream.clicks -> Return
"""

from typing import Any

from fastapi import APIRouter

from app.queue import publish
from app.schemas import Click

router = APIRouter()


@router.post("/clicks")
async def ingest(
    payload: Click,
) -> dict[str, Any]:
    result = payload

    await publish("clickstream.clicks", result.model_dump(mode="json"))
    return {"status": "accepted", "data": result.model_dump(mode="json")}
