"""Request pipeline for `api Upload`. Generated by CIaC.

Pipeline: StoreVideo -> Return
"""

from typing import Any

from fastapi import APIRouter

from app.schemas import Video
from app.logic.store_video import StoreVideo

router = APIRouter()


@router.post("/videos")
async def upload(
    payload: Video,
) -> dict[str, Any]:
    result = payload

    result = await StoreVideo().handle(result)
    if isinstance(result, list):
        return {"status": "accepted", "data": [r.model_dump(mode="json") if hasattr(r, "model_dump") else r for r in result]}
    return {
        "status": "accepted",
        "data": result.model_dump(mode="json") if hasattr(result, "model_dump") else result,
    }
