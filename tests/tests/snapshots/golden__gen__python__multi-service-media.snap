"""Request pipeline for `api Upload`. Generated by CIaC.

Pipeline: call Billing.Charge -> StoreVideo -> publish media_system.uploaded -> Return
"""

from typing import Any

from fastapi import APIRouter

from app.clients.billing import BillingClient
from app.queue import publish
from app.schemas import Video
from app.services.store_video import StoreVideo

router = APIRouter()


@router.put("/videos")
async def upload(
    payload: Video,
) -> dict[str, Any]:
    result = payload

    result = await BillingClient().charge(result)
    result = await StoreVideo().handle(result)
    await publish("media_system.uploaded", result.model_dump(mode="json"))
    return {"status": "accepted", "data": result.model_dump(mode="json")}
