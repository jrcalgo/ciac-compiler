notifier/app/email.py
============================================================
"""SMTP email senders. Generated by CIaC.

Both `SMTP` and `SES` providers send over SMTP; for SES, point the
`SMTP_*` variables at your SES SMTP endpoint and credentials. Defaults
target the Mailpit container from the generated docker-compose, so
sent mail is inspectable at http://localhost:8025.
"""

from email.message import EmailMessage

import aiosmtplib

from app.config import get_settings
from app.state import current


class Email:
    """Async sender bound to one SMTP endpoint."""

    def __init__(
        self,
        host: str,
        port: int,
        username: str,
        password: str,
        sender: str,
        use_tls: bool,
    ) -> None:
        self._host = host
        self._port = port
        self._username = username
        self._password = password
        self._use_tls = use_tls
        self.sender = sender

    async def send(self, to: str, subject: str, body: str) -> None:
        message = EmailMessage()
        message["From"] = self.sender
        message["To"] = to
        message["Subject"] = subject
        message.set_content(body)
        await aiosmtplib.send(
            message,
            hostname=self._host,
            port=self._port,
            username=self._username or None,
            password=self._password or None,
            use_tls=self._use_tls,
        )


def get_email(instance: str = "default") -> Email:
    senders = current().emails
    if instance not in senders:
        settings = get_settings()
        senders[instance] = {
            "transactional": lambda s=settings: Email(
                host=s.smtp_host_transactional,
                port=s.smtp_port_transactional,
                username=s.smtp_username_transactional,
                password=s.smtp_password_transactional,
                sender=s.smtp_from_transactional,
                use_tls=s.smtp_use_tls_transactional,
            ),
        }[instance]()
    return senders[instance]
