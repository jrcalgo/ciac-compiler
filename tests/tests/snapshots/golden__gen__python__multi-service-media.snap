[project]
name = "transcoder"
version = "0.1.0"
description = "Generated by CIaC from `service Transcoder`"
requires-python = ">=3.11"
dependencies = [
    "fastapi>=0.115",
    "uvicorn[standard]>=0.30",
    "pydantic-settings>=2.4",
    "nats-py>=2.7",
