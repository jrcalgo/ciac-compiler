"""Typed HTTP client for the `Billing` service. Generated by CIaC.

`call Billing.<Api>` pipeline steps invoke these methods. The
base URL comes from `BILLING_URL`; the system docker-compose points
it at the `billing` container.
"""

import httpx

from app.config import get_settings
from app.schemas import Video


class BillingClient:
    """Calls `Billing` over HTTP and unwraps its response envelope."""

    def __init__(self) -> None:
        self._base_url = get_settings().billing_url

    async def charge(self, payload: Video) -> Video:
        async with httpx.AsyncClient(base_url=self._base_url) as client:
            response = await client.post(
                "/charge", json=payload.model_dump(mode="json")
            )
        response.raise_for_status()
        return Video.model_validate(response.json()["data"])
