"""Runs every worker in one process: `python -m app.workers`. Generated by CIaC."""

import asyncio

from app.workers import (
    transcode,
    notify,
    dead_letter_sink,
)


async def main() -> None:
    await asyncio.gather(
        transcode.run(),
        notify.run(),
        dead_letter_sink.run(),
    )


if __name__ == "__main__":
    asyncio.run(main())
