"""Smoke tests generated by CIaC.

These run without any infrastructure: clients are lazy and the ASGI
transport below does not trigger the startup lifespan.
"""

import httpx
import pytest

from app.main import app


def _client() -> httpx.AsyncClient:
    transport = httpx.ASGITransport(app=app)
    return httpx.AsyncClient(transport=transport, base_url="http://test")


def test_routes_registered() -> None:
    paths = set(app.openapi()["paths"])
    assert "/charge" in paths
    assert "/health" in paths


@pytest.mark.anyio
async def test_health() -> None:
    async with _client() as client:
        response = await client.get("/health")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}

============================================================
docker-compose.yml
============================================================
services:

  billing:
    build: ./billing
    ports:
      - "8000:8000"

  upload-api:
    build: ./upload-api
    ports:
      - "8001:8000"
    environment:
      BILLING_URL: http://billing:8000
      NATS_URL: nats://queue:4222
    depends_on:
      - queue

  transcoder:
    build: ./transcoder
    ports:
      - "8002:8000"
    environment:
      S3_ENDPOINT_MEDIA: http://transcoder-minio-media:9000
      NATS_URL: nats://queue:4222
    depends_on:
      - transcoder-minio-media
      - queue

  transcoder-workers:
    build: ./transcoder
    command: ["python", "-m", "app.workers"]
    environment:
      S3_ENDPOINT_MEDIA: http://transcoder-minio-media:9000
      NATS_URL: nats://queue:4222
    depends_on:
      - transcoder-minio-media
      - queue

  notifier:
    build: ./notifier
    ports:
      - "8003:8000"
    environment:
      SMTP_HOST_TRANSACTIONAL: notifier-mailpit-transactional
      NATS_URL: nats://queue:4222
    depends_on:
      - notifier-mailpit-transactional
      - queue

  notifier-workers:
    build: ./notifier
    command: ["python", "-m", "app.workers"]
    environment:
      SMTP_HOST_TRANSACTIONAL: notifier-mailpit-transactional
      NATS_URL: nats://queue:4222
    depends_on:
      - notifier-mailpit-transactional
      - queue

  progress-feed:
    build: ./progress-feed
    ports:
      - "8004:8000"
    environment:
      NATS_URL: nats://queue:4222
    depends_on:
      - queue

  transcoder-minio-media:
    image: minio/minio
    command: ["server", "/data"]
    environment:
      MINIO_ROOT_USER: minioadmin
      MINIO_ROOT_PASSWORD: minioadmin
    volumes:
      - transcoder-minio-media-data:/data

  notifier-mailpit-transactional:
    image: axllent/mailpit
    ports:
      - "8025:8025"

  queue:
    image: nats:2

volumes:
  transcoder-minio-media-data:
