============================================================
docker-compose.yml
============================================================
services:
  app:
    build: .
    ports:
      - "8000:8000"
    environment:
      NATS_URL: nats://queue:4222
    depends_on:
      - queue

  workers:
    build: .
    command: ["python", "-m", "app.workers"]
    environment:
      NATS_URL: nats://queue:4222
    depends_on:
      - queue

  queue:
    image: nats:2
