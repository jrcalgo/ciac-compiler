"""Request pipeline for `api Charge`. Generated by CIaC.

Pipeline: CapturePayment -> Return
"""

from typing import Any

from fastapi import APIRouter

from app.schemas import Video
from app.services.capture_payment import CapturePayment

router = APIRouter()


@router.post("/charge")
async def charge(
    payload: Video,
) -> dict[str, Any]:
    result = payload

    result = await CapturePayment().handle(result)
    return {"status": "accepted", "data": result.model_dump(mode="json")}
