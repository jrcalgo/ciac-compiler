"""Persistence for the `Note` resource. Generated by CIaC."""

import json
import uuid

from redis.asyncio import Redis
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from app.models import Note, NoteIn


class NoteStore:
    """CRUD operations for Note with read-through caching."""

    def __init__(
        self,
        session: AsyncSession,
        cache: Redis | None = None,
    ) -> None:
        self.session = session
        self.cache = cache

    async def create(self, payload: NoteIn) -> Note:
        entity = Note(id=str(uuid.uuid4()), **payload.model_dump(mode="json"))
        self.session.add(entity)
        await self.session.commit()
        return entity

    async def get(self, entity_id: str) -> Note | None:
        if self.cache is not None:
            cached = await self.cache.get(self._key(entity_id))
            if cached is not None:
                return Note(id=entity_id, **json.loads(cached))
        entity = await self.session.get(Note, entity_id)
        if entity is not None and self.cache is not None:
            await self.cache.set(self._key(entity_id), json.dumps(self._payload(entity)), ex=300)
        return entity

    async def list(self, limit: int = 100, offset: int = 0) -> list[Note]:
        result = await self.session.scalars(select(Note).limit(limit).offset(offset))
        return list(result)

    async def update(self, entity_id: str, payload: NoteIn) -> Note | None:
        entity = await self.session.get(Note, entity_id)
        if entity is None:
            return None
        for field, value in payload.model_dump(mode="json").items():
            setattr(entity, field, value)
        await self.session.commit()
        if self.cache is not None:
            await self.cache.delete(self._key(entity_id))
        return entity

    async def delete(self, entity_id: str) -> bool:
        entity = await self.session.get(Note, entity_id)
        if entity is None:
            return False
        await self.session.delete(entity)
        await self.session.commit()
        if self.cache is not None:
            await self.cache.delete(self._key(entity_id))
        return True

    def _key(self, entity_id: str) -> str:
        return "notes:" + entity_id

    @staticmethod
    def _payload(entity: Note) -> dict:
        return {
            "title": entity.title,
        }
