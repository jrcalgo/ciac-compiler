"""Request pipeline for `api Echo`. Generated by CIaC.

Pipeline: Auth -> Return
"""

from typing import Any

from fastapi import APIRouter, Depends

from app.auth import require_auth
from app.schemas import Message

router = APIRouter()


@router.post("/echo")
async def echo(
    payload: Message,
    claims: dict[str, Any] = Depends(require_auth),
) -> dict[str, Any]:
    result = payload

    return {"status": "accepted", "data": result.model_dump(mode="json")}
