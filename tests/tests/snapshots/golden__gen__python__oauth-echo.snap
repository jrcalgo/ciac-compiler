"""Request pipeline for `api Echo`. Generated by CIaC.

Pipeline: Auth -> Return
"""

from typing import Any

from fastapi import APIRouter, Depends

from app.auth import require_scope
from app.schemas import Message

router = APIRouter()


@router.post("/echo")
async def echo(
    payload: Message,
    claims: dict[str, Any] = Depends(require_scope("echo:write")),
) -> dict[str, Any]:
    result = payload

    if isinstance(result, list):
        return {"status": "accepted", "data": [r.model_dump(mode="json") if hasattr(r, "model_dump") else r for r in result]}
    return {
        "status": "accepted",
        "data": result.model_dump(mode="json") if hasattr(result, "model_dump") else result,
    }
