"""Worker pipeline for `worker Indexer`. Generated by CIaC.

Consumes `media_ops.uploaded` in queue group `indexer`
so replicas of this worker load-balance messages between them.
"""

import asyncio
import logging

import nats

from app.config import get_settings
from app.search import get_search
from app.http_clients import get_http_client
from app.queue import publish
from app.schemas import Video
from app.services.index_video import IndexVideo

SUBJECT = "media_ops.uploaded"
QUEUE_GROUP = "indexer"
CONCURRENCY = 1
MAX_RETRIES = 0
logger = logging.getLogger(__name__)



async def handle_message_once(payload: Video) -> None:
    result = payload

    result = await IndexVideo(search=get_search("catalog"), http=get_http_client("billing")).handle(result)
    await publish("media_ops.indexed", result.model_dump(mode="json"))


async def handle_message(payload: Video) -> None:
    for attempt in range(MAX_RETRIES + 1):
        try:
            await handle_message_once(payload)
            return
        except Exception:
            if attempt >= MAX_RETRIES:
                logger.exception("message processing failed after retries")
                return
            logger.warning("message processing failed; retrying", exc_info=True)


async def _consume(worker_index: int) -> None:
    client = await nats.connect(get_settings().nats_url)
    subscription = await client.subscribe(SUBJECT, queue=QUEUE_GROUP)
    logger.info("worker Indexer consumer %s subscribed", worker_index)
    async for message in subscription.messages:
        await handle_message(Video.model_validate_json(message.data))


async def run() -> None:
    """Subscribes and processes messages forever."""
    await asyncio.gather(*(_consume(idx) for idx in range(CONCURRENCY)))
