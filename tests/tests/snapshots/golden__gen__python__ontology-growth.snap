docker-compose.yml
============================================================
services:
  app:
    build: .
    ports:
      - "8000:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      DATABASE_URL_MAIN: postgresql+asyncpg://postgres:postgres@db-main:5432/media_ops_main
      DATABASE_URL_ANALYTICS: postgresql+asyncpg://postgres:postgres@db-analytics:5432/media_ops_analytics
      REDIS_URL_HOT: redis://cache-hot:6379/0
      S3_ENDPOINT_MEDIA: http://minio-media:9000
      SMTP_HOST_TRANSACTIONAL: mailpit-transactional
      SEARCH_URL_CATALOG: http://search-catalog:9200
      NATS_URL: nats://queue:4222
    depends_on:
      db-main:
        condition: service_healthy
      db-analytics:
        condition: service_healthy
      cache-hot:
        condition: service_healthy
      minio-media:
        condition: service_started
      mailpit-transactional:
        condition: service_started
      search-catalog:
        condition: service_started
      queue:
        condition: service_started

  workers:
    build: .
    command: ["python", "-m", "app.workers"]
    environment:
      DATABASE_URL_MAIN: postgresql+asyncpg://postgres:postgres@db-main:5432/media_ops_main
      DATABASE_URL_ANALYTICS: postgresql+asyncpg://postgres:postgres@db-analytics:5432/media_ops_analytics
      REDIS_URL_HOT: redis://cache-hot:6379/0
      S3_ENDPOINT_MEDIA: http://minio-media:9000
      SMTP_HOST_TRANSACTIONAL: mailpit-transactional
      SEARCH_URL_CATALOG: http://search-catalog:9200
      NATS_URL: nats://queue:4222
    depends_on:
      db-main:
        condition: service_healthy
      db-analytics:
        condition: service_healthy
      cache-hot:
        condition: service_healthy
      minio-media:
        condition: service_started
      mailpit-transactional:
        condition: service_started
      search-catalog:
        condition: service_started
      queue:
        condition: service_started

  db-main:
    image: postgres:16
    ports:
      - "5432:5432"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: media_ops_main
    volumes:
      - db-main-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 2s
      timeout: 3s
      retries: 20

  db-analytics:
    image: postgres:16
    ports:
      - "5433:5432"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: media_ops_analytics
    volumes:
      - db-analytics-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 2s
      timeout: 3s
      retries: 20

  cache-hot:
    image: redis:7
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 2s
      timeout: 3s
      retries: 20

  minio-media:
    image: minio/minio
    command: ["server", "/data"]
    environment:
      MINIO_ROOT_USER: minioadmin
      MINIO_ROOT_PASSWORD: minioadmin
    volumes:
      - minio-media-data:/data

  mailpit-transactional:
    image: axllent/mailpit
    ports:
      - "8025:8025"

  search-catalog:
    image: opensearchproject/opensearch:2
    environment:
      discovery.type: single-node
      DISABLE_SECURITY_PLUGIN: "true"

  queue:
    image: nats:2
    # Host mapping (v0.13 M2): the generated tests/system delivery and
    # channel tests connect from the host at localhost:4222.
    ports:
      - "4222:4222"

volumes:
  db-main-data:
  db-analytics-data:
  minio-media-data:
