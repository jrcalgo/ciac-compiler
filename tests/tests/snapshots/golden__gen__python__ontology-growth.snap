"""

from functools import lru_cache

from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    """Environment-driven settings with development defaults."""

    model_config = SettingsConfigDict(env_file=".env", extra="ignore")

    database_url_main: str = "postgresql+asyncpg://postgres:postgres@localhost:5432/media_ops_main"
    database_url_analytics: str = "postgresql+asyncpg://postgres:postgres@localhost:5432/media_ops_analytics"

    redis_url_hot: str = "redis://localhost:6379/0"

    s3_endpoint_media: str = "http://localhost:9000"
    s3_access_key_media: str = "minioadmin"
    s3_secret_key_media: str = "minioadmin"
    s3_bucket_media: str = "videos"
    s3_region_media: str = "us-east-1"

    smtp_host_transactional: str = "localhost"
    smtp_port_transactional: int = 1025
    smtp_username_transactional: str = ""
    smtp_password_transactional: str = ""
    smtp_from_transactional: str = "noreply@example.com"
    smtp_use_tls_transactional: bool = False

    search_url_catalog: str = "http://localhost:9200"

    http_base_url_billing: str = "https://billing.internal"
    nats_url: str = "nats://localhost:4222"


@lru_cache
def get_settings() -> Settings:
    return Settings()
