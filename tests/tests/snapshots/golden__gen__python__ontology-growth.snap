============================================================
docker-compose.yml
============================================================
services:
  app:
    build: .
    ports:
      - "8000:8000"
    environment:
      DATABASE_URL_MAIN: postgresql+asyncpg://postgres:postgres@db-main:5432/media_ops_main
      DATABASE_URL_ANALYTICS: postgresql+asyncpg://postgres:postgres@db-analytics:5432/media_ops_analytics
      REDIS_URL_HOT: redis://cache-hot:6379/0
      NATS_URL: nats://queue:4222
    depends_on:
      - db-main
      - db-analytics
      - cache-hot
      - queue

  workers:
    build: .
    command: ["python", "-m", "app.workers"]
    environment:
      DATABASE_URL_MAIN: postgresql+asyncpg://postgres:postgres@db-main:5432/media_ops_main
      DATABASE_URL_ANALYTICS: postgresql+asyncpg://postgres:postgres@db-analytics:5432/media_ops_analytics
      REDIS_URL_HOT: redis://cache-hot:6379/0
      NATS_URL: nats://queue:4222
    depends_on:
      - db-main
      - db-analytics
      - cache-hot
      - queue

  db-main:
    image: postgres:16
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: media_ops_main
    volumes:
      - db-main-data:/var/lib/postgresql/data

  db-analytics:
    image: postgres:16
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: media_ops_analytics
    volumes:
      - db-analytics-data:/var/lib/postgresql/data

  cache-hot:
    image: redis:7

  queue:
    image: nats:2

volumes:
  db-main-data:
  db-analytics-data:
