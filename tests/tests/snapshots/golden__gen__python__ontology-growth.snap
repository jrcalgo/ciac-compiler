"""Request pipeline for `api Upload`. Generated by CIaC.

Pipeline: StoreVideo -> RecordAnalytics -> publish media_ops.uploaded -> Return
"""

from typing import Any

from fastapi import APIRouter, Depends
from sqlalchemy.ext.asyncio import AsyncSession

from app.cache import get_cache
from app.db import get_session_main, get_session_analytics
from app.queue import publish
from app.schemas import Video
from app.services.store_video import StoreVideo
from app.services.record_analytics import RecordAnalytics

router = APIRouter()


@router.put("/videos")
async def upload(
    payload: Video,
    session_main: AsyncSession = Depends(get_session_main),
    session_analytics: AsyncSession = Depends(get_session_analytics),
) -> dict[str, Any]:
    result = payload

    result = await StoreVideo(session=session_main, cache=get_cache("hot")).handle(result)
    result = await RecordAnalytics(session=session_analytics).handle(result)
    await publish("media_ops.uploaded", result.model_dump(mode="json"))
    return {"status": "accepted", "data": result.model_dump(mode="json")}
