"""Runs every worker in one process: `python -m app.workers`. Generated by CIaC."""

import asyncio

from app.config import get_settings
from app.state import AppState, set_current
from app.workers import (
    indexer,
    notifier,
)


async def main() -> None:
    set_current(AppState.production(get_settings()))
    await asyncio.gather(
        indexer.run(),
        notifier.run(),
    )


if __name__ == "__main__":
    asyncio.run(main())
