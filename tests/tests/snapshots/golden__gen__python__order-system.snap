"""Smoke tests generated by CIaC.

These run without any infrastructure: clients are lazy and the ASGI
transport below does not trigger the startup lifespan.
"""

import jwt
import httpx
import pytest

from app.main import app
from app.config import get_settings


def _client(*, raise_app_exceptions: bool = True) -> httpx.AsyncClient:
    transport = httpx.ASGITransport(app=app, raise_app_exceptions=raise_app_exceptions)
    return httpx.AsyncClient(transport=transport, base_url="http://test")


def _bearer(scope: str) -> dict[str, str]:
    """A locally-signed token carrying `scope` — the JWT scheme verifies
    against `jwt_secret`, which this process already has, so no live
    issuer is needed to prove the scope check itself works."""
    settings = get_settings()
    token = jwt.encode({"sub": "test", "scope": scope}, settings.jwt_secret, algorithm=settings.jwt_algorithm)
    return {"Authorization": f"Bearer {token}"}


def test_routes_registered() -> None:
    paths = set(app.openapi()["paths"])
    assert "/orders/summary/shipped" in paths
    assert "/orders/mark-shipped" in paths
    assert "/orders/webhook" in paths
    assert "/orders/submit" in paths
    assert "/customers" in paths
    assert "/health" in paths


@pytest.mark.anyio
async def test_health() -> None:
    async with _client() as client:
        response = await client.get("/health")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}


@pytest.mark.anyio
async def test_shipped_summary_api_requires_auth() -> None:
    async with _client() as client:
        response = await client.post("/orders/summary/shipped", json={})
    assert response.status_code in (401, 403)


@pytest.mark.anyio
async def test_shipped_summary_api_rejects_missing_scope() -> None:
    async with _client() as client:
        response = await client.post(
            "/orders/summary/shipped", json={}, headers=_bearer("not:orders:read")
        )
    assert response.status_code == 403


@pytest.mark.anyio
async def test_shipped_summary_api_accepts_granted_scope() -> None:
    # `raise_app_exceptions=False`: a granted-scope request clears the
    # auth dependency and reaches the route body, which may then fail
    # on a real dependency this no-infra suite doesn't have (a live
    # db/cache/queue) — that failure becomes a 5xx, still proof the
    # auth layer itself let the request through.
    async with _client(raise_app_exceptions=False) as client:
        response = await client.post(
            "/orders/summary/shipped", json={}, headers=_bearer("orders:read")
        )
    assert response.status_code not in (401, 403)

@pytest.mark.anyio
async def test_mark_shipped_api_requires_auth() -> None:
    async with _client() as client:
        response = await client.post("/orders/mark-shipped", json={})
    assert response.status_code in (401, 403)


@pytest.mark.anyio
async def test_mark_shipped_api_rejects_missing_scope() -> None:
    async with _client() as client:
        response = await client.post(
            "/orders/mark-shipped", json={}, headers=_bearer("not:orders:write")
        )
    assert response.status_code == 403


@pytest.mark.anyio
async def test_mark_shipped_api_accepts_granted_scope() -> None:
    # `raise_app_exceptions=False`: a granted-scope request clears the
    # auth dependency and reaches the route body, which may then fail
    # on a real dependency this no-infra suite doesn't have (a live
    # db/cache/queue) — that failure becomes a 5xx, still proof the
    # auth layer itself let the request through.
    async with _client(raise_app_exceptions=False) as client:
        response = await client.post(
            "/orders/mark-shipped", json={}, headers=_bearer("orders:write")
        )
    assert response.status_code not in (401, 403)

@pytest.mark.anyio
async def test_customers_require_auth() -> None:
    async with _client() as client:
        response = await client.get("/customers")
    assert response.status_code in (401, 403)


@pytest.mark.anyio
async def test_customers_read_rejects_missing_scope() -> None:
    async with _client() as client:
        response = await client.get("/customers", headers=_bearer("not:customers:read"))
    assert response.status_code == 403


@pytest.mark.anyio
async def test_customers_read_accepts_granted_scope() -> None:
