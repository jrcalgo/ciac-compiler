"""Handler for the `MarkShipped` typed handler. Generated by CIaC.

Compiler-owned: lowered from the source `handler MarkShipped(..) { .. }` body
on every build. Business logic lives in the `.ciac` source, not here.
"""
from redis.asyncio import Redis
from sqlalchemy.ext.asyncio import AsyncSession
from app.models import Orders
from app.schemas import Order, OrderUpdate


class MarkShipped:
    """Business logic for the `MarkShipped` handler."""

    def __init__(
        self,
        session: AsyncSession | None = None,
        cache: Redis | None = None,
    ) -> None:
        self.session = session
        self.cache = cache

    async def handle(self, payload: OrderUpdate) -> Order:
        v1 = Order(id=payload.id, customer_id=payload.customer_id, status="Shipped", total=payload.total)
        _row = await self.session.get(Orders, str(v1.id))
        if _row is not None:
            for _k, _v in v1.model_dump().items():
                setattr(_row, _k, _v)
            await self.session.commit()
            Order.model_validate(_row, from_attributes=True)
        else:
            None
        (await self.cache.delete("orders:shipped-count"))
        return v1
