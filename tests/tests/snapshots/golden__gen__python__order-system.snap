"""REST endpoints for the `Customer` resource. Generated by CIaC."""


from typing import Any

from fastapi import APIRouter, Depends, HTTPException, Query, status
from sqlalchemy.ext.asyncio import AsyncSession

from app.auth import require_scope
from app.cache import get_cache
from app.db import get_session
from app.models import CustomerIn, CustomerOut
from app.services.customer_store import CustomerStore

router = APIRouter(
    prefix="/customers",
    tags=["customers"],
)


def _store(
    session: AsyncSession = Depends(get_session),
) -> CustomerStore:
    return CustomerStore(
        session, cache=get_cache()
    )


def _out(entity: object) -> CustomerOut:
    return CustomerOut.model_validate(entity, from_attributes=True)


@router.post("", status_code=status.HTTP_201_CREATED)
async def create_customer(
    payload: CustomerIn,
    _claims: dict[str, Any] = Depends(require_scope("customers:write")),
    store: CustomerStore = Depends(_store),
) -> CustomerOut:
    entity = await store.create(payload)
    return _out(entity)


@router.get("")
async def list_customers(
    limit: int = Query(50, ge=1),
    offset: int = Query(0, ge=0),
    _claims: dict[str, Any] = Depends(require_scope("customers:read")),
    store: CustomerStore = Depends(_store),
) -> list[CustomerOut]:
    entities = await store.list(limit=limit, offset=offset)
    return [_out(entity) for entity in entities]


@router.get("/{entity_id}")
async def get_customer(
    entity_id: str,
    _claims: dict[str, Any] = Depends(require_scope("customers:read")),
    store: CustomerStore = Depends(_store),
) -> CustomerOut:
    entity = await store.get(entity_id)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return _out(entity)


@router.put("/{entity_id}")
async def update_customer(
    entity_id: str,
    payload: CustomerIn,
    _claims: dict[str, Any] = Depends(require_scope("customers:write")),
    store: CustomerStore = Depends(_store),
) -> CustomerOut:
    entity = await store.update(entity_id, payload)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return _out(entity)


@router.delete("/{entity_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_customer(
    entity_id: str,
    _claims: dict[str, Any] = Depends(require_scope("customers:write")),
    store: CustomerStore = Depends(_store),
) -> None:
    deleted = await store.delete(entity_id)
    if not deleted:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
