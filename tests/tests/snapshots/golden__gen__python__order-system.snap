import json
from redis.asyncio import Redis
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, func
from app.models import Orders
from app.schemas import SummaryFilter


class ShippedSummary:
    """Business logic for the `ShippedSummary` handler."""

    def __init__(
        self,
        session: AsyncSession | None = None,
        cache: Redis | None = None,
    ) -> None:
        self.session = session
        self.cache = cache

    async def handle(self, filter: SummaryFilter) -> int:
        _stmt = select(func.count()).select_from(Orders).where(Orders.status == "Shipped").where(Orders.total >= filter.min_total)
        v1 = (await self.session.execute(_stmt)).scalar_one()
        (await self.cache.set("orders:shipped-count", json.dumps(v1)))
        return v1
