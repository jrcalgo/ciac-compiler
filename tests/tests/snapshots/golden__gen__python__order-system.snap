"""Handler for the `CheckLimitOrder` typed handler. Generated by CIaC.

Compiler-owned: lowered from the source `handler CheckLimitOrder(..) { .. }` body
on every build. Business logic lives in the `.ciac` source, not here.
"""

from uuid import uuid4
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, func
from app.models import TicketsOrder
from app.schemas import Order, TicketOrder, TooManyRequestsOrder


class CheckLimitOrder:
    """Business logic for the `CheckLimitOrder` handler."""

    def __init__(
        self,
        session: AsyncSession | None = None,
    ) -> None:
        self.session = session

    async def handle(self, payload: Order) -> Order:
        _stmt = select(func.count()).select_from(TicketsOrder)
        v1 = (await self.session.execute(_stmt)).scalar_one()
        if (v1 >= 1000):
            raise TooManyRequestsOrder(1000)
        else:
            pass
        self.session.add(TicketsOrder(**TicketOrder(id=str(uuid4())).model_dump()))
        await self.session.commit()
        return payload
