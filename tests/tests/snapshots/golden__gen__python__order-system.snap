app/workers/order_event_sink.py
============================================================
"""Worker pipeline for `worker OrderEventSink`. Generated by CIaC.

Consumes `order_system.received_order_event` in queue group `order_event_sink`
so replicas of this worker load-balance messages between them.
"""

import asyncio
import logging

import nats

from app.config import get_settings
from app.cache import get_cache
from app.db import get_sessionmaker
from app.schemas import OrderEvent
from app.services.record_event import RecordEvent

SUBJECT = "order_system.received_order_event"
QUEUE_GROUP = "order_event_sink"
CONCURRENCY = 1
MAX_RETRIES = 0
logger = logging.getLogger(__name__)



async def handle_message_once(payload: OrderEvent) -> None:
    result = payload
    async with get_sessionmaker()() as session:

        result = await RecordEvent(session=session, cache=get_cache()).handle(result)


async def handle_message(payload: OrderEvent) -> None:
    for attempt in range(MAX_RETRIES + 1):
        try:
            await handle_message_once(payload)
            return
        except Exception:
            if attempt >= MAX_RETRIES:
                logger.exception("message processing failed after retries")
                return
            logger.warning("message processing failed; retrying", exc_info=True)


async def _consume(worker_index: int) -> None:
    client = await nats.connect(get_settings().nats_url)
    subscription = await client.subscribe(SUBJECT, queue=QUEUE_GROUP)
    logger.info("worker OrderEventSink consumer %s subscribed", worker_index)
    async for message in subscription.messages:
        await handle_message(OrderEvent.model_validate_json(message.data))


async def run() -> None:
    """Subscribes and processes messages forever."""
    await asyncio.gather(*(_consume(idx) for idx in range(CONCURRENCY)))
