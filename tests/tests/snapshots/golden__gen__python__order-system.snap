"""Generated behavioral test for `ReceiveOrderEvent`. Regenerated on every build.

Exercises the lowered handler body against mocked runtime dependencies;
real persistence round-trips are `ciac verify --live`'s job, not this test.
"""
import pytest
from unittest.mock import AsyncMock

from uuid import uuid4
from app.logic.receive_order_event import ReceiveOrderEvent
from app.schemas import OrderEvent


@pytest.mark.anyio
async def test_receive_order_event_handle(monkeypatch) -> None:
    mock_publish = AsyncMock()
    monkeypatch.setattr("app.logic.receive_order_event.publish", mock_publish)
    handler = ReceiveOrderEvent()

    result = await handler.handle(OrderEvent(id=str(uuid4()), kind="test"))

    assert isinstance(result, OrderEvent)
    mock_publish.assert_awaited_once()
