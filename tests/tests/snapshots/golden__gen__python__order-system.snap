"""Generated behavioral test for `CheckLimitOrder`. Regenerated on every build.

Exercises the lowered handler body against mocked runtime dependencies;
real persistence round-trips are `ciac verify --live`'s job, not this test.
"""
import pytest
from unittest.mock import AsyncMock, MagicMock

from uuid import uuid4
from app.logic.check_limit_order import CheckLimitOrder
from app.schemas import Order


@pytest.mark.anyio
async def test_check_limit_order_handle() -> None:
    session = AsyncMock()
    session.add = MagicMock()
    exec_result = MagicMock()
    exec_result.scalar_one.return_value = 0
    exec_result.rowcount = 0
    session.execute = AsyncMock(return_value=exec_result)
    handler = CheckLimitOrder(session=session)

    result = await handler.handle(Order(id=str(uuid4()), customer_id=str(uuid4()), status="Pending", total=0.0))

    assert isinstance(result, Order)
    session.add.assert_called_once()
    session.commit.assert_awaited_once()
    session.execute.assert_awaited_once()
