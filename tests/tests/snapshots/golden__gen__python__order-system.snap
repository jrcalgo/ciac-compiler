class TooManyRequestsOrder(Exception):
    """Raised by `fail TooManyRequestsOrder(..)` in a handler body."""

    def __init__(self, limit: int) -> None:
        self.limit = limit
        super().__init__("TooManyRequestsOrder(" + ", ".join(f"{k}={v!r}" for k, v in self.__dict__.items()) + ")")

