"""Generated behavioral test for `MarkShipped`. Regenerated on every build.

Exercises the lowered handler body against mocked runtime dependencies;
real persistence round-trips are `ciac verify --live`'s job, not this test.
"""
import pytest
from unittest.mock import AsyncMock, MagicMock

from uuid import uuid4
from app.logic.mark_shipped import MarkShipped
from app.schemas import Order
from app.schemas import OrderUpdate


@pytest.mark.anyio
async def test_mark_shipped_handle() -> None:
    session = AsyncMock()
    session.add = MagicMock()
    cache = AsyncMock()
    handler = MarkShipped(session=session, cache=cache)

    result = await handler.handle(OrderUpdate(id=str(uuid4()), customer_id=str(uuid4()), total=0.0))

    assert isinstance(result, Order)
