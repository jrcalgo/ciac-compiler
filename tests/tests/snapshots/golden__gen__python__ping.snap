"""Request pipeline for `api Echo`. Generated by CIaC.

Pipeline: Return
"""

from typing import Any

from fastapi import APIRouter

from app.schemas import Message

router = APIRouter()


@router.post("/echo")
async def echo(
    payload: Message,
) -> dict[str, Any]:
    result = payload

    return {"status": "accepted", "data": result.model_dump(mode="json")}
