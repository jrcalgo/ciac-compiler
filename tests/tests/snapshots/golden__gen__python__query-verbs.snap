from sqlalchemy.ext.asyncio import AsyncSession
from app.models import Notes
from app.schemas import Note, NoteUpdate


class Replace:
    """Business logic for the `Replace` handler."""

    def __init__(
        self,
        session: AsyncSession | None = None,
    ) -> None:
        self.session = session

    async def handle(self, payload: NoteUpdate) -> Note:
        v1 = Note(id=payload.id, title=payload.title, active=payload.active)
        _row = await self.session.get(Notes, str(v1.id))
        if _row is not None:
            for _k, _v in v1.model_dump().items():
                setattr(_row, _k, _v)
            await self.session.commit()
            Note.model_validate(_row, from_attributes=True)
        else:
            None
        return v1
