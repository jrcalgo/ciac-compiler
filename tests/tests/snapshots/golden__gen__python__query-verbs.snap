"""Handler for the `CountActive` typed handler. Generated by CIaC.

Compiler-owned: lowered from the source `handler CountActive(..) { .. }` body
on every build. Business logic lives in the `.ciac` source, not here.
"""
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select, func
from app.models import Notes
from app.schemas import ActiveFilter


class CountActive:
    """Business logic for the `CountActive` handler."""

    def __init__(
        self,
        session: AsyncSession | None = None,
    ) -> None:
        self.session = session

    async def handle(self, filter: ActiveFilter) -> int:
        _stmt = select(func.count()).select_from(Notes).where(Notes.active == filter.active)
        return (await self.session.execute(_stmt)).scalar_one()
