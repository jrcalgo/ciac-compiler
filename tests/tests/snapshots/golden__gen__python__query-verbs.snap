"""Handler for the `ListActive` typed handler. Generated by CIaC.

Compiler-owned: lowered from the source `handler ListActive(..) { .. }` body
on every build. Business logic lives in the `.ciac` source, not here.
"""
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select
from app.models import Notes
from app.schemas import ActiveFilter, Note


class ListActive:
    """Business logic for the `ListActive` handler."""

    def __init__(
        self,
        session: AsyncSession | None = None,
    ) -> None:
        self.session = session

    async def handle(self, filter: ActiveFilter) -> list[Note]:
        _stmt = select(Notes).where(Notes.active == filter.active)
        _rows = (await self.session.execute(_stmt)).scalars().all()
        return [Note.model_validate(_r, from_attributes=True) for _r in _rows]
