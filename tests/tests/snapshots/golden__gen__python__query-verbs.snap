"""Generated behavioral test for `CountActive`. Regenerated on every build.

Exercises the lowered handler body against mocked runtime dependencies;
real persistence round-trips are `ciac verify --live`'s job, not this test.
"""
import pytest
from unittest.mock import AsyncMock, MagicMock

from app.logic.count_active import CountActive
from app.schemas import ActiveFilter


@pytest.mark.anyio
async def test_count_active_handle() -> None:
    session = AsyncMock()
    session.add = MagicMock()
    exec_result = MagicMock()
    exec_result.scalar_one.return_value = 0
    exec_result.rowcount = 0
    session.execute = AsyncMock(return_value=exec_result)
    handler = CountActive(session=session)

    result = await handler.handle(ActiveFilter(active=True))

    assert isinstance(result, int)
    session.execute.assert_awaited_once()
