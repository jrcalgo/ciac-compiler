"""Request pipeline for `api CountActiveApi`. Generated by CIaC.

Pipeline: CountActive -> Return
"""

from typing import Any

from fastapi import APIRouter, Depends
from sqlalchemy.ext.asyncio import AsyncSession

from app.db import get_session
from app.schemas import ActiveFilter
from app.logic.count_active import CountActive

router = APIRouter()


@router.post("/count-active-api")
async def count_active_api(
    payload: ActiveFilter,
    session: AsyncSession = Depends(get_session),
) -> dict[str, Any]:
    result = payload

    result = await CountActive(session=session).handle(result)
    return {"status": "accepted", "data": result.model_dump(mode="json")}
