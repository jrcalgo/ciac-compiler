"""Handler for the `Remove` typed handler. Generated by CIaC.

Compiler-owned: lowered from the source `handler Remove(..) { .. }` body
on every build. Business logic lives in the `.ciac` source, not here.
"""
from sqlalchemy.ext.asyncio import AsyncSession
from app.models import Notes
from app.schemas import IdOnly


class Remove:
    """Business logic for the `Remove` handler."""

    def __init__(
        self,
        session: AsyncSession | None = None,
    ) -> None:
        self.session = session

    async def handle(self, payload: IdOnly) -> bool:
        _row = await self.session.get(Notes, str(payload.id))
        if _row is not None:
            await self.session.delete(_row)
            await self.session.commit()
            return True
        else:
            return False
