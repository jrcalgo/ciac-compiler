"""Handler for the `DeleteByActive` typed handler. Generated by CIaC.

Compiler-owned: lowered from the source `handler DeleteByActive(..) { .. }` body
on every build. Business logic lives in the `.ciac` source, not here.
"""
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import delete as sql_delete
from app.models import Notes
from app.schemas import ActiveFilter


class DeleteByActive:
    """Business logic for the `DeleteByActive` handler."""

    def __init__(
        self,
        session: AsyncSession | None = None,
    ) -> None:
        self.session = session

    async def handle(self, filter: ActiveFilter) -> int:
        _stmt = sql_delete(Notes).where(Notes.active == filter.active)
        _result = await self.session.execute(_stmt)
        await self.session.commit()
        return _result.rowcount
