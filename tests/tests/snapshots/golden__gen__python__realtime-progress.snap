"""Request pipeline for `api Complete`. Generated by CIaC.

Pipeline: publish progress_feed.transcoded -> Return
"""

from typing import Any

from fastapi import APIRouter

from app.queue import publish
from app.schemas import Video

router = APIRouter()


@router.post("/complete")
async def complete(
    payload: Video,
) -> dict[str, Any]:
    result = payload

    await publish("progress_feed.transcoded", result.model_dump(mode="json"))
    return {"status": "accepted", "data": result.model_dump(mode="json")}
