"""Realtime channel `Progress`. Generated by CIaC."""
from fastapi import APIRouter, WebSocket, WebSocketDisconnect

from app.queue import get_client
from app.schemas import Video

router = APIRouter()
SUBJECT = "progress_feed.transcoded"


def _decode(data: bytes) -> dict:
    return Video.model_validate_json(data).model_dump(mode="json")
@router.websocket("/channels/progress")
async def progress(socket: WebSocket) -> None:
    await socket.accept()
    client = await get_client()
    subscription = await client.subscribe(SUBJECT)
    try:
        async for message in subscription.messages:
            await socket.send_json(_decode(message.data))
    except WebSocketDisconnect:
        pass
    finally:
        await subscription.unsubscribe()
