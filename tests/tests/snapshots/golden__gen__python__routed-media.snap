"""Application assembly for RoutedMedia. Generated by CIaC."""

from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

import json
from pathlib import Path
from typing import Any

from fastapi import FastAPI

from app.api.upload import router as upload_router
from app.api.clip import router as clip_router
from app.config import get_settings
from app.state import AppState, set_current



def create_app(state: AppState) -> FastAPI:
    """Assembles this service's FastAPI app against an explicit
    `AppState` (v0.17 M3) -- `AppState.production(...)` for the real
    server (this file's bottom line), `AppState.simulation(...)` for a
    future in-process simulation run (v0.17 M4 onward). Installed
    before any route or lifespan code can run, so every generated
    dependency (`app/db.py`, `app/cache.py`, ...) resolves through this
    one state, never a module-global cache of its own.
    """
    set_current(state)

    @asynccontextmanager
    async def lifespan(_: FastAPI) -> AsyncIterator[None]:
        from app.db import create_schema
        await create_schema()
        yield

    app = FastAPI(title="RoutedMedia", lifespan=lifespan)

    # The document `ciac build` emitted alongside this app (openapi.json,
    # derived straight from the IR) is the single source of truth for the
    # API spec; FastAPI's own auto-generated one would be a second,
    # slightly-different opinion on the same routes.
    openapi_path = Path(__file__).resolve().parent.parent / "openapi.json"

    def _openapi() -> dict[str, Any]:
        if app.openapi_schema is None:
            app.openapi_schema = json.loads(openapi_path.read_text())
        return app.openapi_schema

    app.openapi = _openapi

    @app.get("/health")
    async def health() -> dict[str, str]:
        return {"status": "ok"}


    app.include_router(upload_router)
    app.include_router(clip_router)

    return app


app = create_app(AppState.production(get_settings()))
