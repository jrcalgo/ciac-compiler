"""Persistence for the `Clip` resource. Generated by CIaC."""

import json
import uuid

from redis.asyncio import Redis
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from app.models import Clip, ClipIn


class ClipStore:
    """CRUD operations for Clip with read-through caching."""

    def __init__(
        self,
        session: AsyncSession,
        cache: Redis | None = None,
    ) -> None:
        self.session = session
        self.cache = cache

    async def create(self, payload: ClipIn) -> Clip:
        entity = Clip(id=str(uuid.uuid4()), **payload.model_dump(mode="json"))
        self.session.add(entity)
        await self.session.commit()
        return entity

    async def get(self, entity_id: str) -> Clip | None:
        if self.cache is not None:
            cached = await self.cache.get(self._key(entity_id))
            if cached is not None:
                return Clip(id=entity_id, **json.loads(cached))
        entity = await self.session.get(Clip, entity_id)
        if entity is not None and self.cache is not None:
            await self.cache.set(self._key(entity_id), json.dumps(self._payload(entity)), ex=60)
        return entity

    async def list(self, limit: int = 50, offset: int = 0) -> list[Clip]:
        result = await self.session.scalars(select(Clip).limit(limit).offset(offset))
        return list(result)

    async def update(self, entity_id: str, payload: ClipIn) -> Clip | None:
        entity = await self.session.get(Clip, entity_id)
        if entity is None:
            return None
        for field, value in payload.model_dump(mode="json").items():
            setattr(entity, field, value)
        await self.session.commit()
        if self.cache is not None:
            await self.cache.delete(self._key(entity_id))
        return entity

    async def delete(self, entity_id: str) -> bool:
        entity = await self.session.get(Clip, entity_id)
        if entity is None:
            return False
        await self.session.delete(entity)
        await self.session.commit()
        if self.cache is not None:
            await self.cache.delete(self._key(entity_id))
        return True

    def _key(self, entity_id: str) -> str:
        return "clips:" + entity_id

    @staticmethod
    def _payload(entity: Clip) -> dict:
        return {
            "title": entity.title,
            "status": entity.status,
        }
