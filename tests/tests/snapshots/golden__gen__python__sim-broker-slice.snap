"""REST endpoints for the `Widget` resource. Generated by CIaC."""


from fastapi import APIRouter, Depends, HTTPException, Query, status
from sqlalchemy.ext.asyncio import AsyncSession

from app.cache import get_cache
from app.db import get_session
from app.models import WidgetIn, WidgetOut
from app.services.widget_store import WidgetStore

router = APIRouter(
    prefix="/widgets",
    tags=["widgets"],
)


def _store(
    session: AsyncSession = Depends(get_session),
) -> WidgetStore:
    return WidgetStore(
        session, cache=get_cache()
    )


def _out(entity: object) -> WidgetOut:
    return WidgetOut.model_validate(entity, from_attributes=True)


@router.post("", status_code=status.HTTP_201_CREATED)
async def create_widget(
    payload: WidgetIn,
    store: WidgetStore = Depends(_store),
) -> WidgetOut:
    entity = await store.create(payload)
    return _out(entity)


@router.get("")
async def list_widgets(
    limit: int = Query(100, ge=1),
    offset: int = Query(0, ge=0),
    store: WidgetStore = Depends(_store),
) -> list[WidgetOut]:
    entities = await store.list(limit=limit, offset=offset)
    return [_out(entity) for entity in entities]


@router.get("/{entity_id}")
async def get_widget(
    entity_id: str,
    store: WidgetStore = Depends(_store),
) -> WidgetOut:
    entity = await store.get(entity_id)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return _out(entity)


@router.put("/{entity_id}")
async def update_widget(
    entity_id: str,
    payload: WidgetIn,
    store: WidgetStore = Depends(_store),
) -> WidgetOut:
    entity = await store.update(entity_id, payload)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return _out(entity)


@router.delete("/{entity_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_widget(
    entity_id: str,
    store: WidgetStore = Depends(_store),
) -> None:
    deleted = await store.delete(entity_id)
    if not deleted:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
