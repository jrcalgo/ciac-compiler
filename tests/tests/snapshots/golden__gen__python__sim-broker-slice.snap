"""Generated behavioral test for `HandleA`. Regenerated on every build.

Exercises the lowered handler body against mocked runtime dependencies;
real persistence round-trips are `ciac verify --live`'s job, not this test.
"""
from unittest.mock import AsyncMock, MagicMock
from uuid import uuid4

import pytest

from app.logic.handle_a import HandleA
from app.schemas import Ping


@pytest.mark.anyio
async def test_handle_a_handle() -> None:
    session = AsyncMock()
    session.add = MagicMock()
    handler = HandleA(session=session)

    result = await handler.handle(Ping(id=str(uuid4()), seq=0))

    assert isinstance(result, Ping)
    session.add.assert_called_once()
    session.commit.assert_awaited_once()
