"""Request pipeline for `api EmitApi`. Generated by CIaC.

Pipeline: Emit -> publish sim_broker_slice.pings -> Return
"""

from typing import Any

from fastapi import APIRouter

from app.queue import publish
from app.schemas import Ping
from app.logic.emit import Emit

router = APIRouter()


@router.post("/pings")
async def emit_api(
    payload: Ping,
) -> dict[str, Any]:
    result = payload

    result = await Emit().handle(result)
    await publish("sim_broker_slice.pings", result.model_dump(mode="json"))
    if isinstance(result, list):
        return {"status": "accepted", "data": [r.model_dump(mode="json") if hasattr(r, "model_dump") else r for r in result]}
    return {
        "status": "accepted",
        "data": result.model_dump(mode="json") if hasattr(result, "model_dump") else result,
    }
