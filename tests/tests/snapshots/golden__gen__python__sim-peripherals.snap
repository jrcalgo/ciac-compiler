"""Request pipeline for `api CallUpstreamApi`. Generated by CIaC.

Pipeline: CallUpstream -> Return
"""

from typing import Any

from fastapi import APIRouter

from app.http_clients import get_http_client
from app.schemas import HttpRequest
from app.logic.call_upstream import CallUpstream

router = APIRouter()


@router.post("/call-upstream-api")
async def call_upstream_api(
    payload: HttpRequest,
) -> dict[str, Any]:
    result = payload

    result = await CallUpstream(http=get_http_client("upstream")).handle(result)
    return {"status": "accepted", "data": result.model_dump(mode="json")}
