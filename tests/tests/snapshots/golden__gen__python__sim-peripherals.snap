"""OpenSearch clients. Generated by CIaC.

Each named `search` instance gets a lazy async client. Defaults target
the single-node OpenSearch container from the generated docker-compose.
"""

from typing import Any

from opensearchpy import AsyncOpenSearch

from app.config import get_settings
from app.state import current


class Search:
    """Async wrapper over one OpenSearch endpoint."""

    def __init__(self, url: str) -> None:
        self._client = AsyncOpenSearch(hosts=[url], verify_certs=False)

    async def index(self, index: str, doc_id: str, document: dict[str, Any]) -> None:
        await self._client.index(index=index, id=doc_id, body=document, refresh=True)

    async def search(self, index: str, query: dict[str, Any]) -> list[dict[str, Any]]:
        response = await self._client.search(index=index, body=query)
        return [hit["_source"] for hit in response["hits"]["hits"]]

    async def delete(self, index: str, doc_id: str) -> None:
        await self._client.delete(index=index, id=doc_id)


def get_search(instance: str = "default") -> Search:
    state = current()
    if state.world is not None:
        # v0.17 M8: the checkpoint's search port.
        return state.world.fake_search(instance)
    clients = state.searches
    if instance not in clients:
        settings = get_settings()
        clients[instance] = {
            "default": lambda s=settings: Search(url=s.search_url),
        }[instance]()
    return clients[instance]
