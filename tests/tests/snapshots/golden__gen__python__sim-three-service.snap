"""Handler for the `RecordCharge` typed handler. Generated by CIaC.

Compiler-owned: lowered from the source `handler RecordCharge(..) { .. }` body
on every build. Business logic lives in the `.ciac` source, not here.
"""

from uuid import uuid4
from sqlalchemy.ext.asyncio import AsyncSession
from app.models import Charges
from app.schemas import ChargeRecord, Order


class RecordCharge:
    """Business logic for the `RecordCharge` handler."""

    def __init__(
        self,
        session: AsyncSession | None = None,
    ) -> None:
        self.session = session

    async def handle(self, order: Order) -> Order:
        self.session.add(Charges(**ChargeRecord(id=str(uuid4()), order_id=order.id, amount=order.total).model_dump()))
        await self.session.commit()
        return order
