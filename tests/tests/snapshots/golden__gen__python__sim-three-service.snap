"""Handler for the `RecordShipment` typed handler. Generated by CIaC.

Compiler-owned: lowered from the source `handler RecordShipment(..) { .. }` body
on every build. Business logic lives in the `.ciac` source, not here.
"""

from uuid import uuid4
from sqlalchemy.ext.asyncio import AsyncSession
from app.models import Shipments
from app.schemas import Order, Shipment


class RecordShipment:
    """Business logic for the `RecordShipment` handler."""

    def __init__(
        self,
        session: AsyncSession | None = None,
    ) -> None:
        self.session = session

    async def handle(self, order: Order) -> Order:
        self.session.add(Shipments(**Shipment(id=str(uuid4()), order_id=order.id).model_dump()))
        await self.session.commit()
        return order
