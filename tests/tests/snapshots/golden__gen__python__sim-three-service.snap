"""Request pipeline for `api Charge`. Generated by CIaC.

Pipeline: RecordCharge -> Return
"""

from typing import Any

from fastapi import APIRouter, Depends
from sqlalchemy.ext.asyncio import AsyncSession

from app.db import get_session
from app.schemas import Order
from app.logic.record_charge import RecordCharge

router = APIRouter()


@router.post("/charge")
async def charge(
    payload: Order,
    session: AsyncSession = Depends(get_session),
) -> dict[str, Any]:
    result = payload

    result = await RecordCharge(session=session).handle(result)
    if isinstance(result, list):
        return {"status": "accepted", "data": [r.model_dump(mode="json") if hasattr(r, "model_dump") else r for r in result]}
    return {
        "status": "accepted",
        "data": result.model_dump(mode="json") if hasattr(result, "model_dump") else result,
    }
