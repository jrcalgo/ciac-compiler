============================================================
"""Request pipeline for `api SubmitOrder`. Generated by CIaC.

Pipeline: call Billing.Charge -> publish three_service.order_accepted -> Return
"""

from typing import Any

from fastapi import APIRouter

from app.clients.billing import BillingClient
from app.queue import publish
from app.schemas import Order

router = APIRouter()


@router.post("/orders")
async def submit_order(
    payload: Order,
) -> dict[str, Any]:
    result = payload

    result = await BillingClient().charge(result)
    await publish("three_service.order_accepted", result.model_dump(mode="json"))
    if isinstance(result, list):
        return {"status": "accepted", "data": [r.model_dump(mode="json") if hasattr(r, "model_dump") else r for r in result]}
    return {
        "status": "accepted",
        "data": result.model_dump(mode="json") if hasattr(result, "model_dump") else result,
    }
