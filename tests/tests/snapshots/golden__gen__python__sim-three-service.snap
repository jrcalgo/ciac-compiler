"""Generated behavioral test for `RecordShipment`. Regenerated on every build.

Exercises the lowered handler body against mocked runtime dependencies;
real persistence round-trips are `ciac verify --live`'s job, not this test.
"""
from unittest.mock import AsyncMock, MagicMock
from uuid import uuid4

import pytest

from app.logic.record_shipment import RecordShipment
from app.schemas import Order


@pytest.mark.anyio
async def test_record_shipment_handle() -> None:
    session = AsyncMock()
    session.add = MagicMock()
    handler = RecordShipment(session=session)

    result = await handler.handle(Order(id=str(uuid4()), total=0.0))

    assert isinstance(result, Order)
    session.add.assert_called_once()
    session.commit.assert_awaited_once()
