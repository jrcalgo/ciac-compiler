"""Handler for the `HandleOrderCreated` typed handler. Generated by CIaC.

Compiler-owned: lowered from the source `handler HandleOrderCreated(..) { .. }` body
on every build. Business logic lives in the `.ciac` source, not here.
"""

from uuid import uuid4
from sqlalchemy.ext.asyncio import AsyncSession
from app.models import ProcessedOrders
from app.schemas import Order, ProcessedOrder


class HandleOrderCreated:
    """Business logic for the `HandleOrderCreated` handler."""

    def __init__(
        self,
        session: AsyncSession | None = None,
    ) -> None:
        self.session = session

    async def handle(self, order: Order) -> Order:
        try:
            self.session.add(ProcessedOrders(**ProcessedOrder(id=str(uuid4()), order_id=order.id).model_dump()))
            await self.session.commit()
        except Exception:
            await self.session.rollback()
            raise
        return order
