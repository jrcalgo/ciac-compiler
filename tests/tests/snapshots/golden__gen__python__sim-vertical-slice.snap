"""Worker pipeline for `worker ProcessOrder`. Generated by CIaC.

Consumes `sim_vertical_slice.order_created` in queue group `process_order`
so replicas of this worker load-balance messages between them.
"""

import asyncio
import logging

import nats

from app.config import get_settings
from app.db import get_sessionmaker
from app.schemas import Order
from app.logic.handle_order_created import HandleOrderCreated

SUBJECT = "sim_vertical_slice.order_created"
QUEUE_GROUP = "process_order"
CONCURRENCY = 1
MAX_RETRIES = 2
logger = logging.getLogger(__name__)



async def handle_message_once(payload: Order) -> None:
    result = payload
    async with get_sessionmaker()() as session:

        result = await HandleOrderCreated(session=session).handle(result)


async def handle_message(payload: Order) -> None:
    for attempt in range(MAX_RETRIES + 1):
        try:
            await handle_message_once(payload)
            return
        except Exception:
            if attempt >= MAX_RETRIES:
                logger.exception("message processing failed after retries")
                return
            logger.warning("message processing failed; retrying", exc_info=True)


async def _consume(worker_index: int) -> None:
    client = await nats.connect(get_settings().nats_url)
    subscription = await client.subscribe(SUBJECT, queue=QUEUE_GROUP)
    logger.info("worker ProcessOrder consumer %s subscribed", worker_index)
    async for message in subscription.messages:
        await handle_message(Order.model_validate_json(message.data))


async def run() -> None:
    """Subscribes and processes messages forever."""
    await asyncio.gather(*(_consume(idx) for idx in range(CONCURRENCY)))
