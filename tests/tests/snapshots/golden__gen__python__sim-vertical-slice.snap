"""Request pipeline for `api PlaceOrderApi`. Generated by CIaC.

Pipeline: PlaceOrder -> RecordAudit -> publish sim_vertical_slice.order_created -> Return
"""

from typing import Any

from fastapi import APIRouter, Depends
from sqlalchemy.ext.asyncio import AsyncSession

from app.db import get_session
from app.queue import publish
from app.schemas import Order
from app.logic.place_order import PlaceOrder
from app.logic.record_audit import RecordAudit

router = APIRouter()


@router.post("/orders")
async def place_order_api(
    payload: Order,
    session: AsyncSession = Depends(get_session),
) -> dict[str, Any]:
    result = payload

    result = await PlaceOrder(session=session).handle(result)
    result = await RecordAudit(session=session).handle(result)
    await publish("sim_vertical_slice.order_created", result.model_dump(mode="json"))
    if isinstance(result, list):
        return {"status": "accepted", "data": [r.model_dump(mode="json") if hasattr(r, "model_dump") else r for r in result]}
    return {
        "status": "accepted",
        "data": result.model_dump(mode="json") if hasattr(result, "model_dump") else result,
    }
