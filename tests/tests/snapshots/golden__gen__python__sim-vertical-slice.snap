"""Scheduled job pipeline for `job Reconcile`. Generated by CIaC."""

import asyncio
from datetime import datetime, timezone
import logging
from typing import Any

from croniter import croniter
from app.db import get_sessionmaker
from app.services.run_reconcile import RunReconcile

SCHEDULE = "0 3 * * *"
CATCH_UP = False
logger = logging.getLogger(__name__)


async def handle_tick_once() -> None:
    result: dict[str, Any] = {}
    async with get_sessionmaker()() as session:

        result = await RunReconcile(session=session).handle(result)


async def _sleep_until_next() -> None:
    now = datetime.now(timezone.utc)
    next_fire = croniter(SCHEDULE, now).get_next(datetime)
    if next_fire.tzinfo is None:
        next_fire = next_fire.replace(tzinfo=timezone.utc)
    await asyncio.sleep(max(0.0, (next_fire - now).total_seconds()))


async def run() -> None:
    """Runs this scheduled job forever."""
    while True:
        await _sleep_until_next()
        try:
            await handle_tick_once()
        except Exception:
            logger.exception("scheduled job Reconcile failed")
