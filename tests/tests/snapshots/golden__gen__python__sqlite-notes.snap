services:
  app:
    build: .
    ports:
      - "8000:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      DATABASE_URL: sqlite+aiosqlite:///data/sqlite_notes.db
    depends_on:
    volumes:
      - app-data:/app/data

volumes:
  app-data:
