"""Typed HTTP client for the `Payments` service. Generated by CIaC.

`call Payments.<Api>` pipeline steps invoke these methods. The
base URL comes from `PAYMENTS_URL`; the system docker-compose points
it at the `payments` container.
"""

import httpx

from app.config import get_settings
from app.schemas import Order


class PaymentsClient:
    """Calls `Payments` over HTTP and unwraps its response envelope."""

    def __init__(self) -> None:
        self._base_url = get_settings().payments_url

    async def charge(self, payload: Order) -> Order:
        async with httpx.AsyncClient(base_url=self._base_url) as client:
            response = await client.post(
                "/charge", json=payload.model_dump(mode="json")
            )
        response.raise_for_status()
        return Order.model_validate(response.json()["data"])
