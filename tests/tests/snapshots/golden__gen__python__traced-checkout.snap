"""Request pipeline for `api Submit`. Generated by CIaC.

Pipeline: call Payments.Charge -> publish traced_checkout.placed -> Return
"""

from typing import Any

from fastapi import APIRouter

from app.clients.payments import PaymentsClient
from app.queue import publish
from app.schemas import Order

router = APIRouter()


@router.post("/submit")
async def submit(
    payload: Order,
) -> dict[str, Any]:
    result = payload

    result = await PaymentsClient().charge(result)
    await publish("traced_checkout.placed", result.model_dump(mode="json"))
    return {"status": "accepted", "data": result.model_dump(mode="json")}
