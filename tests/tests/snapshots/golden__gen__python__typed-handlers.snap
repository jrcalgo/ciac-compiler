"""Generated behavioral test for `StoreVideo`. Regenerated on every build.

Exercises the lowered handler body against mocked runtime dependencies;
real persistence round-trips are `ciac verify --live`'s job, not this test.
"""
from unittest.mock import AsyncMock, MagicMock
from uuid import uuid4

import pytest

from app.logic.store_video import StoreVideo
from app.schemas import Video


@pytest.mark.anyio
async def test_store_video_handle() -> None:
    session = AsyncMock()
    session.add = MagicMock()
    object_store = AsyncMock()
    handler = StoreVideo(session=session, object_store=object_store)

    result = await handler.handle(Video(id=str(uuid4()), title="test", status="Pending"))

    assert isinstance(result, Video)
    session.add.assert_called_once()
    session.commit.assert_awaited_once()
    object_store.put.assert_awaited_once()
