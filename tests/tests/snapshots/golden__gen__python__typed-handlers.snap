"""Handler for the `StoreVideo` typed handler. Generated by CIaC.

Compiler-owned: lowered from the source `handler StoreVideo(..) { .. }` body
on every build. Business logic lives in the `.ciac` source, not here.
"""
from sqlalchemy.ext.asyncio import AsyncSession
from app.object_store import ObjectStore
from app.models import Videos
from app.schemas import Video


class StoreVideo:
    """Business logic for the `StoreVideo` handler."""

    def __init__(
        self,
        session: AsyncSession | None = None,
        object_store: ObjectStore | None = None,
    ) -> None:
        self.session = session
        self.object_store = object_store

    async def handle(self, v: Video) -> Video:
        (await self.object_store.put(("videos/" + str(v.id)), v.model_dump_json().encode()))
        self.session.add(Videos(**v.model_dump()))
        await self.session.commit()
        v1 = v
        if (v1.status == "Pending"):
            v2 = v1.model_copy(update={"status": "Ready"})
        else:
            v2 = v1
        return v2
