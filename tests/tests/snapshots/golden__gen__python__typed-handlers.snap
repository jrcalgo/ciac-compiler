"""Request pipeline for `api Upload`. Generated by CIaC.

Pipeline: StoreVideo -> Notify -> Return
"""

from typing import Any

from fastapi import APIRouter, Depends
from sqlalchemy.ext.asyncio import AsyncSession

from app.db import get_session
from app.object_store import get_object_store
from app.schemas import Video
from app.logic.store_video import StoreVideo
from app.services.notify import Notify

router = APIRouter()


@router.post("/videos")
async def upload(
    payload: Video,
    session: AsyncSession = Depends(get_session),
) -> dict[str, Any]:
    result = payload

    result = await StoreVideo(session=session, object_store=get_object_store()).handle(result)
    result = await Notify().handle(result)
    return {"status": "accepted", "data": result.model_dump(mode="json")}
