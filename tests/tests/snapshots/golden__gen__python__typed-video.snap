============================================================
docker-compose.yml
============================================================
services:
  app:
    build: .
    ports:
      - "8000:8000"
    environment:
      DATABASE_URL: postgresql+asyncpg://postgres:postgres@db:5432/media
      REDIS_URL: redis://cache:6379/0
      NATS_URL: nats://queue:4222
      JWT_SECRET: ${JWT_SECRET:-change-me}
    depends_on:
      - db
      - cache
      - queue

  workers:
    build: .
    command: ["python", "-m", "app.workers"]
    environment:
      DATABASE_URL: postgresql+asyncpg://postgres:postgres@db:5432/media
      REDIS_URL: redis://cache:6379/0
      NATS_URL: nats://queue:4222
    depends_on:
      - db
      - cache
      - queue

  db:
    image: postgres:16
    ports:
      - "5432:5432"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: media
    volumes:
      - db-data:/var/lib/postgresql/data

  cache:
    image: redis:7
    ports:
      - "6379:6379"

  queue:
    image: nats:2

volumes:
  db-data:
