"""Persistence models and API schemas. Generated by CIaC.

Each `crud` resource gets a generic keyed-document model: a UUID primary
key plus a JSON payload. Tighten these into real columns as your domain
model settles.
"""

from typing import Any

from pydantic import BaseModel, Field
from sqlalchemy import JSON, String
from sqlalchemy.orm import Mapped, mapped_column

from app.db import Base



class Clip(Base):
    __tablename__ = "clips"

    id: Mapped[str] = mapped_column(String(36), primary_key=True)
    data: Mapped[dict[str, Any]] = mapped_column(JSON, default=dict)


class ClipIn(BaseModel):
    """Payload for creating or updating a Clip."""

    data: dict[str, Any] = Field(default_factory=dict)


class ClipOut(BaseModel):
    id: str
    data: dict[str, Any]

