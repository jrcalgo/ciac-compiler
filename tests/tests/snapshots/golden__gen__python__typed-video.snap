"""Request pipeline for `api Upload`. Generated by CIaC.

Pipeline: Auth -> StoreVideo -> publish media.uploaded -> Return
"""

from typing import Any

from fastapi import APIRouter, Depends
from sqlalchemy.ext.asyncio import AsyncSession

from app.auth import require_auth
from app.cache import get_cache
from app.db import get_session
from app.queue import publish
from app.schemas import Video
from app.services.store_video import StoreVideo

router = APIRouter()


@router.post("/upload")
async def upload(
    payload: Video,
    claims: dict[str, Any] = Depends(require_auth),
    session: AsyncSession = Depends(get_session),
) -> dict[str, Any]:
    result = payload
    result = await StoreVideo(session=session, cache=get_cache()).handle(result)
    await publish("media.uploaded", result.model_dump(mode="json"))
    return {"status": "accepted", "data": result.model_dump(mode="json")}
