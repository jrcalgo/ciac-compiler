"""REST endpoints for the `Clip` resource. Generated by CIaC."""

from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.ext.asyncio import AsyncSession

from app.auth import require_auth
from app.cache import get_cache
from app.db import get_session
from app.models import ClipIn, ClipOut
from app.services.clip_store import ClipStore

router = APIRouter(
    prefix="/clips",
    tags=["clips"],
    dependencies=[Depends(require_auth)],
)


def _store(session: AsyncSession = Depends(get_session)) -> ClipStore:
    return ClipStore(
        session, cache=get_cache()
    )


@router.post("", status_code=status.HTTP_201_CREATED)
async def create_clip(
    payload: ClipIn,
    store: ClipStore = Depends(_store),
) -> ClipOut:
    entity = await store.create(payload.data)
    return ClipOut(id=entity.id, data=entity.data)


@router.get("")
async def list_clips(
    store: ClipStore = Depends(_store),
) -> list[ClipOut]:
    entities = await store.list()
    return [ClipOut(id=e.id, data=e.data) for e in entities]


@router.get("/{entity_id}")
async def get_clip(
    entity_id: str,
    store: ClipStore = Depends(_store),
) -> ClipOut:
    entity = await store.get(entity_id)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return ClipOut(id=entity.id, data=entity.data)


@router.put("/{entity_id}")
async def update_clip(
    entity_id: str,
    payload: ClipIn,
    store: ClipStore = Depends(_store),
) -> ClipOut:
    entity = await store.update(entity_id, payload.data)
    if entity is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
    return ClipOut(id=entity.id, data=entity.data)


@router.delete("/{entity_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_clip(
    entity_id: str,
    store: ClipStore = Depends(_store),
) -> None:
    deleted = await store.delete(entity_id)
    if not deleted:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
