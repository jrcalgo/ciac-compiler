app/workers/transcoder.py
============================================================
"""Worker pipeline for `worker Transcoder`. Generated by CIaC.

Consumes `video_platform.events` in queue group `transcoder`
so replicas of this worker load-balance messages between them.
"""

import asyncio
import logging
import json
from typing import Any

import nats

from app.config import get_settings
from app.cache import get_cache
from app.db import get_sessionmaker
from app.services.transcode import Transcode
from app.services.save_result import SaveResult

SUBJECT = "video_platform.events"
QUEUE_GROUP = "transcoder"
CONCURRENCY = 1
MAX_RETRIES = 0
logger = logging.getLogger(__name__)



async def handle_message_once(payload: dict[str, Any]) -> None:
    result = dict(payload)
    async with get_sessionmaker()() as session:

        result = await Transcode(session=session, cache=get_cache()).handle(result)
        result = await SaveResult(session=session, cache=get_cache()).handle(result)


async def handle_message(payload: dict[str, Any]) -> None:
    for attempt in range(MAX_RETRIES + 1):
        try:
            await handle_message_once(payload)
            return
        except Exception:
            if attempt >= MAX_RETRIES:
                logger.exception("message processing failed after retries")
                return
            logger.warning("message processing failed; retrying", exc_info=True)


async def _consume(worker_index: int) -> None:
    client = await nats.connect(get_settings().nats_url)
    subscription = await client.subscribe(SUBJECT, queue=QUEUE_GROUP)
    logger.info("worker Transcoder consumer %s subscribed", worker_index)
    async for message in subscription.messages:
        await handle_message(json.loads(message.data))


async def run() -> None:
    """Subscribes and processes messages forever."""
    await asyncio.gather(*(_consume(idx) for idx in range(CONCURRENCY)))
