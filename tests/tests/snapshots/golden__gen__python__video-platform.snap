package = false

[tool.pytest.ini_options]
# tests/system/ needs the compose stack up and is run only by
# `ciac verify --system` (from its own directory); plain `pytest`
# must never collect it.
norecursedirs = ["tests/system"]

[tool.ruff]
target-version = "py311"

[tool.ruff.lint]
# Pinned explicitly, not left to ruff's own default: `ruff>=0.6`
# above has no upper bound, and a newer ruff resolved at generation
# time silently expanded its defaults (bugbear, isort, pyupgrade
# style checks) past what these templates were written to satisfy,
# breaking `ciac verify` on every fresh project (v0.29 M1 finding
# F4). This is ruff's own long-documented default selection --
# pinning it here makes the templates immune to ruff's own default
# ever moving again.
select = ["E4", "E7", "E9", "F"]
============================================================
tests/test_smoke.py
============================================================
"""Smoke tests generated by CIaC.

These run without any infrastructure: clients are lazy and the ASGI
transport below does not trigger the startup lifespan.
"""

import httpx
import pytest

from app.main import app


def _client(*, raise_app_exceptions: bool = True) -> httpx.AsyncClient:
    transport = httpx.ASGITransport(app=app, raise_app_exceptions=raise_app_exceptions)
    return httpx.AsyncClient(transport=transport, base_url="http://test")


def test_routes_registered() -> None:
    paths = set(app.openapi()["paths"])
    assert "/upload" in paths
    assert "/health" in paths


@pytest.mark.anyio
async def test_health() -> None:
    async with _client() as client:
        response = await client.get("/health")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}


@pytest.mark.anyio
async def test_upload_no_token() -> None:
    async with _client() as client:
        response = await client.post("/upload", json={})
    assert response.status_code in (401, 403)


@pytest.mark.anyio
async def test_upload_malformed_token() -> None:
    # `26UpdatePlan.md` M4: a case matrix entry the JWT suite alone
    # never distinguished from `no_token` — both schemes' decoders
    # reject an unparseable bearer value the same way.
    async with _client() as client:
        response = await client.post(
            "/upload", json={}, headers={"Authorization": "Bearer not-a-jwt"}
        )
    assert response.status_code == 401
