"""Redis cache clients. Generated by CIaC.

Clients are created lazily and Redis only connects on first use, so
importing the app never requires a running cache. Each named `cache`
instance gets its own client.
"""

import redis.asyncio as redis

from app.config import get_settings
from app.state import current


def _urls() -> dict[str, str]:
    settings = get_settings()
    return {
        "default": settings.redis_url,
    }


def get_cache(instance: str = "default") -> redis.Redis:
    state = current()
    if state.world is not None:
        # v0.17 M7: the checkpoint's cache port.
        return state.world.fake_cache(instance)
    caches = state.caches
    if instance not in caches:
        caches[instance] = redis.Redis.from_url(
            _urls()[instance], decode_responses=True
        )
    return caches[instance]
