accounts/Dockerfile
============================================================
FROM rust:1-slim AS build

WORKDIR /src
COPY . .
RUN cargo build --release

FROM debian:stable-slim

COPY --from=build /src/target/release/accounts /usr/local/bin/app

EXPOSE 8000
CMD ["app"]
