//! Persistence for the `ResourceVideo` resource. Generated by CIaC.

use crate::models::{ResourceVideo, ResourceVideoIn};
use crate::state::AppState;
/// CRUD operations for ResourceVideo.
#[derive(Debug)]
pub struct ResourceVideoStore<'a> {
    pub db: &'a sqlx::PgPool,
}

impl<'a> ResourceVideoStore<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            db: &state.db_main,
        }
    }


    pub async fn create(&self, payload: ResourceVideoIn) -> anyhow::Result<ResourceVideo> {
        let entity = ResourceVideo {
            id: uuid::Uuid::new_v4().to_string(),
            title: payload.title,
        };
        sqlx::query(
            "INSERT INTO resource_videos (id, title) VALUES ($1, $2)",
        )
        .bind(&entity.id)
        .bind(&entity.title)
        .execute(self.db)
        .await?;
        Ok(entity)
    }

    pub async fn get(&self, id: &str) -> anyhow::Result<Option<ResourceVideo>> {
        let entity: Option<ResourceVideo> =
            sqlx::query_as("SELECT id, title FROM resource_videos WHERE id = $1")
                .bind(id)
                .fetch_optional(self.db)
                .await?;
        Ok(entity)
    }

    pub async fn list(&self, limit: i64, offset: i64) -> anyhow::Result<Vec<ResourceVideo>> {
        let entities =
            sqlx::query_as("SELECT id, title FROM resource_videos ORDER BY id LIMIT $1 OFFSET $2")
                .bind(limit)
                .bind(offset)
                .fetch_all(self.db)
                .await?;
        Ok(entities)
    }

    pub async fn update(
        &self,
        id: &str,
        payload: ResourceVideoIn,
    ) -> anyhow::Result<Option<ResourceVideo>> {
        let entity = ResourceVideo {
            id: id.to_owned(),
            title: payload.title,
        };
        let updated = sqlx::query(
            "UPDATE resource_videos SET title = $1 WHERE id = $2",
        )
        .bind(&entity.title)
        .bind(id)
        .execute(self.db)
        .await?;
        if updated.rows_affected() == 0 {
            return Ok(None);
        }
        Ok(Some(entity))
    }

    pub async fn delete(&self, id: &str) -> anyhow::Result<bool> {
        let deleted = sqlx::query("DELETE FROM resource_videos WHERE id = $1")
            .bind(id)
            .execute(self.db)
            .await?;
        Ok(deleted.rows_affected() > 0)
    }
}

