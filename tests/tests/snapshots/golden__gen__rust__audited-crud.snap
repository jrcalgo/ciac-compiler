//! REST endpoints for the `ResourceUser` resource. Generated by CIaC.

use axum::extract::{Path, Query, State};
use axum::http::StatusCode;
use axum::routing::{delete, get, post, put};
use axum::{Json, Router};

use crate::error::AppError;
use crate::models::{ResourceUser, ResourceUserIn};
use crate::services::resource_user_store::ResourceUserStore;
use crate::state::AppState;

#[derive(Debug, serde::Deserialize)]
struct ListQuery {
    limit: Option<i64>,
    offset: Option<i64>,
}

pub fn router() -> Router<AppState> {
    Router::new()
        .route("/resource_users", post(create_resource_user))
        .route("/resource_users", get(list_resource_users))
        .route("/resource_users/{id}", get(get_resource_user))
        .route("/resource_users/{id}", put(update_resource_user))
        .route("/resource_users/{id}", delete(delete_resource_user))
}

async fn create_resource_user(
    State(state): State<AppState>,
    Json(payload): Json<ResourceUserIn>,
) -> Result<(StatusCode, Json<ResourceUser>), AppError> {
    let entity = ResourceUserStore::new(&state).create(payload).await?;
    Ok((StatusCode::CREATED, Json(entity)))
}

async fn list_resource_users(
    State(state): State<AppState>,
    Query(query): Query<ListQuery>,
) -> Result<Json<Vec<ResourceUser>>, AppError> {
    let entities = ResourceUserStore::new(&state)
        .list(query.limit.unwrap_or(100), query.offset.unwrap_or(0))
        .await?;
    Ok(Json(entities))
}

async fn get_resource_user(
    State(state): State<AppState>,
    Path(id): Path<String>,
) -> Result<Json<ResourceUser>, AppError> {
    match ResourceUserStore::new(&state).get(&id).await? {
        Some(entity) => Ok(Json(entity)),
        None => Err(AppError::not_found()),
    }
}

async fn update_resource_user(
    State(state): State<AppState>,
    Path(id): Path<String>,
    Json(payload): Json<ResourceUserIn>,
) -> Result<Json<ResourceUser>, AppError> {
    match ResourceUserStore::new(&state).update(&id, payload).await? {
        Some(entity) => Ok(Json(entity)),
        None => Err(AppError::not_found()),
    }
}

async fn delete_resource_user(
    State(state): State<AppState>,
    Path(id): Path<String>,
) -> Result<StatusCode, AppError> {
    if ResourceUserStore::new(&state).delete(&id).await? {
        Ok(StatusCode::NO_CONTENT)
    } else {
        Err(AppError::not_found())
    }
}
