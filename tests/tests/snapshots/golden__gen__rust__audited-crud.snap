//! Database schema management. Generated by CIaC.


/// Creates CRUD-resource tables on startup (postgres). `table`
/// declarations (v0.7) are provisioned by the `migrations/` directory
/// instead, applied via `sqlx::migrate!` at startup (see `main.rs`).
/// The id key is `VARCHAR(36)` (a stringified UUID) rather than
/// `TEXT`: portable to engines that require sized index keys.
pub async fn ensure_schema_postgres(db: &sqlx::PgPool) -> anyhow::Result<()> {
    sqlx::query(
        "CREATE TABLE IF NOT EXISTS resource_users (
            id VARCHAR(36) PRIMARY KEY,
            title TEXT NOT NULL
        )",
    )
    .execute(db)
    .await?;
    Ok(())
}
