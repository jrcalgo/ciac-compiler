//! Shared application state. Generated by CIaC.

use crate::config::Config;

#[derive(Debug, Clone)]
pub struct AppState {
    pub config: Config,
    /// Lazy pool: connections are established on first use, so the server
    /// starts (and compiles) without a running database.
    pub db_main: sqlx::PgPool,
}

impl AppState {
    pub async fn new(config: Config) -> anyhow::Result<Self> {
        let db_main =
            sqlx::postgres::PgPoolOptions::new().connect_lazy(&config.database_url_main)?;
        Ok(Self {
            config,
            db_main,
        })
    }
}
============================================================
docker-compose.yml
============================================================
services:

  catalog:
    build: ./catalog
    ports:
      - "8000:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      DATABASE_URL_MAIN: postgres://postgres:postgres@catalog-db-main:5432/catalog_main
    depends_on:
      catalog-db-main:
        condition: service_healthy

  accounts:
    build: ./accounts
    ports:
      - "8001:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      DATABASE_URL_MAIN: postgres://postgres:postgres@accounts-db-main:5432/accounts_main
    depends_on:
      accounts-db-main:
        condition: service_healthy

  catalog-db-main:
    image: postgres:16
    ports:
      - "5432:5432"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: catalog_main
    volumes:
      - catalog-db-main-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 2s
      timeout: 3s
      retries: 20

  accounts-db-main:
    image: postgres:16
    ports:
      - "5433:5432"
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: accounts_main
    volumes:
      - accounts-db-main-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 2s
      timeout: 3s
      retries: 20

volumes:
  catalog-db-main-data:
  accounts-db-main-data:
