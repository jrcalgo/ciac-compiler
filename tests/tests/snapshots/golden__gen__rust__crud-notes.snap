//! Persistence for the `Note` resource. Generated by CIaC.

use redis::AsyncCommands;

use crate::models::{Note, NoteIn};
use crate::state::AppState;
/// CRUD operations for Note with read-through caching.
#[derive(Debug)]
pub struct NoteStore<'a> {
    pub db: &'a sqlx::PgPool,
    pub cache: &'a redis::Client,
}

impl<'a> NoteStore<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            db: &state.db,
            cache: &state.cache,
        }
    }


    pub async fn create(&self, payload: NoteIn) -> anyhow::Result<Note> {
        let entity = Note {
            id: uuid::Uuid::new_v4().to_string(),
            data: payload.data,
        };
        sqlx::query("INSERT INTO notes (id, data) VALUES ($1, $2)")
            .bind(&entity.id)
            .bind(&entity.data)
            .execute(self.db)
            .await?;
        Ok(entity)
    }

    pub async fn get(&self, id: &str) -> anyhow::Result<Option<Note>> {
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        if let Some(cached) = cache.get::<_, Option<String>>(cache_key(id)).await? {
            return Ok(Some(Note {
                id: id.to_owned(),
                data: serde_json::from_str(&cached)?,
            }));
        }
        let entity: Option<Note> =
            sqlx::query_as("SELECT id, data FROM notes WHERE id = $1")
                .bind(id)
                .fetch_optional(self.db)
                .await?;
        if let Some(entity) = &entity {
            let _: () = cache
                .set_ex(cache_key(id), serde_json::to_string(&entity.data)?, 300)
                .await?;
        }
        Ok(entity)
    }

    pub async fn list(&self, limit: i64, offset: i64) -> anyhow::Result<Vec<Note>> {
        let entities = sqlx::query_as("SELECT id, data FROM notes ORDER BY id LIMIT $1 OFFSET $2")
            .bind(limit)
            .bind(offset)
            .fetch_all(self.db)
            .await?;
        Ok(entities)
    }

    pub async fn update(
        &self,
        id: &str,
        payload: NoteIn,
    ) -> anyhow::Result<Option<Note>> {
        let updated = sqlx::query("UPDATE notes SET data = $1 WHERE id = $2")
            .bind(&payload.data)
            .bind(id)
            .execute(self.db)
            .await?;
        if updated.rows_affected() == 0 {
            return Ok(None);
        }
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        let _: () = cache.del(cache_key(id)).await?;
        Ok(Some(Note {
            id: id.to_owned(),
            data: payload.data,
        }))
    }

    pub async fn delete(&self, id: &str) -> anyhow::Result<bool> {
        let deleted = sqlx::query("DELETE FROM notes WHERE id = $1")
            .bind(id)
            .execute(self.db)
            .await?;
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        let _: () = cache.del(cache_key(id)).await?;
        Ok(deleted.rows_affected() > 0)
    }
}

fn cache_key(id: &str) -> String {
    format!("notes:{id}")
}

