src/config.rs
============================================================
//! Runtime configuration for Accounts. Generated by CIaC.
//!
//! Every value can be overridden through the environment, e.g.
//! `DATABASE_URL`; defaults target local development.

#[derive(Debug, Clone)]
pub struct Config {
    pub database_url: String,
    pub oauth_issuer: String,
    pub oauth_audience: String,
}

impl Config {
    pub fn from_env() -> Self {
        Self {
            database_url: env_or(
                "DATABASE_URL",
                "postgres://postgres:postgres@localhost:5432/accounts",
            ),
            oauth_issuer: env_or("OAUTH_ISSUER", "http://keycloak:8080/realms/dev"),
            oauth_audience: env_or("OAUTH_AUDIENCE", ""),
        }
    }
}

fn env_or(key: &str, default: &str) -> String {
    std::env::var(key).unwrap_or_else(|_| default.to_owned())
}
