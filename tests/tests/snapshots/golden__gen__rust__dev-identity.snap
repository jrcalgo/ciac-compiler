//! Persistence for the `Account` resource. Generated by CIaC.

use crate::models::{Account, AccountIn};
use crate::state::AppState;
/// CRUD operations for Account.
#[derive(Debug)]
pub struct AccountStore<'a> {
    pub db: &'a sqlx::PgPool,
}

impl<'a> AccountStore<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            db: &state.db,
        }
    }


    pub async fn create(&self, payload: AccountIn) -> anyhow::Result<Account> {
        let entity = Account {
            id: uuid::Uuid::new_v4().to_string(),
            email: payload.email,
        };
        sqlx::query(
            "INSERT INTO accounts (id, email) VALUES ($1, $2)",
        )
        .bind(&entity.id)
        .bind(&entity.email)
        .execute(self.db)
        .await?;
        Ok(entity)
    }

    pub async fn get(&self, id: &str) -> anyhow::Result<Option<Account>> {
        let entity: Option<Account> =
            sqlx::query_as("SELECT id, email FROM accounts WHERE id = $1")
                .bind(id)
                .fetch_optional(self.db)
                .await?;
        Ok(entity)
    }

    pub async fn list(&self, limit: i64, offset: i64) -> anyhow::Result<Vec<Account>> {
        let entities =
            sqlx::query_as("SELECT id, email FROM accounts ORDER BY id LIMIT $1 OFFSET $2")
                .bind(limit)
                .bind(offset)
                .fetch_all(self.db)
                .await?;
        Ok(entities)
    }

    pub async fn update(
        &self,
        id: &str,
        payload: AccountIn,
    ) -> anyhow::Result<Option<Account>> {
        let entity = Account {
            id: id.to_owned(),
            email: payload.email,
        };
        let updated = sqlx::query(
            "UPDATE accounts SET email = $1 WHERE id = $2",
        )
        .bind(&entity.email)
        .bind(id)
        .execute(self.db)
        .await?;
        if updated.rows_affected() == 0 {
            return Ok(None);
        }
        Ok(Some(entity))
    }

    pub async fn delete(&self, id: &str) -> anyhow::Result<bool> {
        let deleted = sqlx::query("DELETE FROM accounts WHERE id = $1")
            .bind(id)
            .execute(self.db)
            .await?;
        Ok(deleted.rows_affected() > 0)
    }
}

