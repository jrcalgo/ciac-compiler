//! Shared application state. Generated by CIaC.

use crate::config::Config;

#[derive(Debug, Clone)]
pub struct AppState {
    pub config: Config,
    /// Lazy pool: connections are established on first use, so the server
    /// starts (and compiles) without a running database.
    pub db: sqlx::PgPool,
    /// Lazy, cached JWKS lookup; `Claims` selects the key matching
    /// each token's `kid`.
    pub jwks: crate::auth::Jwks,
}

impl AppState {
    pub async fn new(config: Config) -> anyhow::Result<Self> {
        let db =
            sqlx::postgres::PgPoolOptions::new().connect_lazy(&config.database_url)?;
        // Lazy: no network call happens here (v0.17 M11) -- the first
        // request bearing a token triggers the fetch, cached after.
        let jwks = crate::auth::Jwks::new(config.oauth_issuer.clone());
        Ok(Self {
            config,
            db,
            jwks,
        })
    }
}
