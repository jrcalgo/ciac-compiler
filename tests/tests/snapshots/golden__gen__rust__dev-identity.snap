scripts/token.sh
============================================================
#!/usr/bin/env bash
# Mints a real OAuth2 access token from the dev Keycloak realm
# (v0.15 M6). Generated by CIaC.
#
# Usage: scripts/token.sh <dev-admin|dev-user> [scope ...]
#   scripts/token.sh dev-admin "accounts:read accounts:write"
#   scripts/token.sh dev-user
set -euo pipefail

KEYCLOAK_URL="${KEYCLOAK_URL:-http://localhost:8080}"
REALM="dev"
CLIENT_ID="ciac-dev"
PASSWORD="dev-password"

USER="${1:?usage: scripts/token.sh <dev-admin|dev-user> [scope ...]}"
shift || true
SCOPE="$*"

args=(-d "client_id=$CLIENT_ID" -d "grant_type=password" -d "username=$USER" -d "password=$PASSWORD")
if [ -n "$SCOPE" ]; then
  args+=(-d "scope=$SCOPE")
fi

response="$(curl -sf "${args[@]}" "$KEYCLOAK_URL/realms/$REALM/protocol/openid-connect/token")"
if command -v jq >/dev/null 2>&1; then
  printf '%s\n' "$response" | jq -r .access_token
else
  printf '%s\n' "$response" | sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p'
fi
