        }
        __row
    };
    if order.total < 0.0 {
        return Err(InvalidOrder { reason: "order total must not be negative".to_owned() }.into());
    } else {
        ()
    };
    {
        let __row = OrderAudit { id: uuid::Uuid::new_v4().to_string(), note: "order placed".to_owned(), total: order.total.clone() }.clone();
        if let Some(world) = self.world {
            world.db_insert_checked("order_audits", serde_json::to_value(&__row)?)?;
        } else {
            sqlx::query("INSERT INTO order_audits (id, note, total) VALUES ($1, $2, $3)")
            .bind(&__row.id)
            .bind(&__row.note)
            .bind(&__row.total)
                .execute(self.db)
                .await?;
        }
        __row
    };
} else {
    let mut __tx = self.db.begin().await?;
    {
        let __row = order.clone();
        if let Some(world) = self.world {
            world.db_insert_checked("orders", serde_json::to_value(&__row)?)?;
        } else {
            sqlx::query("INSERT INTO orders (id, customer_id, total) VALUES ($1, $2, $3)")
            .bind(&__row.id)
            .bind(&__row.customer_id)
            .bind(&__row.total)
                .execute(&mut *__tx)
                .await?;
        }
        __row
    };
    if order.total < 0.0 {
        return Err(InvalidOrder { reason: "order total must not be negative".to_owned() }.into());
    } else {
        ()
    };
    {
        let __row = OrderAudit { id: uuid::Uuid::new_v4().to_string(), note: "order placed".to_owned(), total: order.total.clone() }.clone();
        if let Some(world) = self.world {
            world.db_insert_checked("order_audits", serde_json::to_value(&__row)?)?;
