//! Request pipeline for `api Checkout`. Generated by CIaC.
//!
//! Pipeline: PlaceOrder -> Return


use axum::extract::State;
use axum::routing::post;
use axum::{Json, Router};

use crate::error::AppError;
use crate::schemas::Order;
use crate::logic::place_order::PlaceOrder;
use crate::state::AppState;

pub fn router() -> Router<AppState> {
    Router::new().route("/orders", post(checkout))
}

async fn checkout(
    State(state): State<AppState>,
    Json(payload): Json<Order>,
) -> Result<Json<serde_json::Value>, AppError> {
    let result = payload;

    let result = PlaceOrder::new(&state).handle(result).await?;
    Ok(Json(serde_json::json!({"status": "accepted", "data": result})))
}
