//! Persistence models and API schemas for CRUD resources and `table`
//! declarations. Generated by CIaC.
//!
//! Typed resources (`crud X: Record;`) get real columns from their record;
//! untyped ones keep a generic keyed-document model (UUID key + JSON
//! payload). `table <Name>: <Record>;` declarations (v0.7) get the same
//! column treatment, named after the table so a record reused under
//! several table names doesn't collide. Enums are stored as text.

use serde::{Deserialize, Serialize};

use crate::schemas::Customer;

use crate::schemas::Order;

use crate::schemas::OrderAudit;

use crate::schemas::LineItem;


#[derive(Debug, Clone, Serialize, Deserialize, sqlx::FromRow)]
pub struct Customers {
    pub id: String,
    pub name: String,
    pub email: String,
}

impl TryFrom<Customers> for Customer {
    type Error = anyhow::Error;

    fn try_from(row: Customers) -> anyhow::Result<Self> {
        Ok(Customer {
            id: row.id,
            name: row.name,
            email: row.email,
        })
    }
}


#[derive(Debug, Clone, Serialize, Deserialize, sqlx::FromRow)]
pub struct Orders {
    pub id: String,
    pub customer_id: String,
    pub total: f64,
}

impl TryFrom<Orders> for Order {
    type Error = anyhow::Error;

    fn try_from(row: Orders) -> anyhow::Result<Self> {
        Ok(Order {
            id: row.id,
            customer_id: row.customer_id,
            total: row.total,
        })
    }
}


#[derive(Debug, Clone, Serialize, Deserialize, sqlx::FromRow)]
pub struct OrderAudits {
    pub id: String,
    pub note: String,
    pub total: f64,
}

impl TryFrom<OrderAudits> for OrderAudit {
    type Error = anyhow::Error;

    fn try_from(row: OrderAudits) -> anyhow::Result<Self> {
        Ok(OrderAudit {
            id: row.id,
            note: row.note,
            total: row.total,
        })
    }
}


#[derive(Debug, Clone, Serialize, Deserialize, sqlx::FromRow)]
pub struct LineItems {
    pub id: String,
    pub order_id: String,
    pub sku: String,
    pub quantity: i64,
}

impl TryFrom<LineItems> for LineItem {
    type Error = anyhow::Error;

    fn try_from(row: LineItems) -> anyhow::Result<Self> {
        Ok(LineItem {
            id: row.id,
            order_id: row.order_id,
            sku: row.sku,
            quantity: row.quantity,
        })
    }
}

