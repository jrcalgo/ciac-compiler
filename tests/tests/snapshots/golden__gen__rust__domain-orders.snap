//! Handler for the `PlaceOrder` typed handler. Generated by CIaC.
//!
//! Compiler-owned: lowered from the source `handler PlaceOrder(..) { .. }` body
//! on every build. Business logic lives in the `.ciac` source, not here.
use crate::state::AppState;
use crate::schemas::{ InvalidOrder, Order, OrderAudit };
#[derive(Debug)]
pub struct PlaceOrder<'a> {
    pub db: &'a sqlx::PgPool,
}

impl<'a> PlaceOrder<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            db: &state.db,
        }
    }

    // An unused `let` is a warning in the source language (`CIAC0045`),
    // not an error — a well-typed handler body can bind a value it
    // never reads. Rust's own `unused_variables` lint disagrees, so it's
    // allowed here rather than promoted to a hard failure by `-D warnings`.
    #[allow(unused_variables)]
    pub async fn handle(&self, order: Order) -> anyhow::Result<Order> {
// NOTE: this block is not yet atomic on the Rust backend (see docs/language.md)
{
    let __row = order.clone();
    sqlx::query("INSERT INTO orders (id, customer_id, total) VALUES ($1, $2, $3)")
        .bind(&__row.id)
        .bind(&__row.customer_id)
        .bind(&__row.total)
        .execute(self.db)
        .await?;
    __row
};
if order.total < 0.0 {
    return Err(InvalidOrder { reason: "order total must not be negative".to_owned() }.into());
} else {
    ()
};
{
    let __row = OrderAudit { id: uuid::Uuid::new_v4().to_string(), note: "order placed".to_owned(), total: order.total }.clone();
    sqlx::query("INSERT INTO order_audits (id, note, total) VALUES ($1, $2, $3)")
        .bind(&__row.id)
        .bind(&__row.note)
        .bind(&__row.total)
        .execute(self.db)
        .await?;
    __row
};
return Ok(order);
    }
}
