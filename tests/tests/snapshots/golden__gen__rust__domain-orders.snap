//! Handler for the `AddLineItem` typed handler. Generated by CIaC.
//!
//! Compiler-owned: lowered from the source `handler AddLineItem(..) { .. }` body
//! on every build. Business logic lives in the `.ciac` source, not here.
use crate::state::AppState;
use crate::schemas::{ LineItem };
#[derive(Debug)]
pub struct AddLineItem<'a> {
    pub db: &'a sqlx::PgPool,
}

impl<'a> AddLineItem<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            db: &state.db,
        }
    }

    // An unused `let` is a warning in the source language (`CIAC0045`),
    // not an error — a well-typed handler body can bind a value it
    // never reads. Rust's own `unused_variables` lint disagrees, so it's
    // allowed here rather than promoted to a hard failure by `-D warnings`.
    #[allow(unused_variables)]
    pub async fn handle(&self, item: LineItem) -> anyhow::Result<LineItem> {
{
    let __row = item.clone();
    sqlx::query("INSERT INTO line_items (id, order_id, sku, quantity) VALUES ($1, $2, $3, $4)")
        .bind(&__row.id)
        .bind(&__row.order_id)
        .bind(&__row.sku)
        .bind(&__row.quantity)
        .execute(self.db)
        .await?;
    __row
};
return Ok(item);
    }
}
