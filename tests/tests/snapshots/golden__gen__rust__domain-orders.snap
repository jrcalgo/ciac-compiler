    } else {
        sqlx::query("INSERT INTO line_items (id, order_id, sku, quantity) VALUES ($1, $2, $3, $4)")
        .bind(&__row.id)
        .bind(&__row.order_id)
        .bind(&__row.sku)
        .bind(&__row.quantity)
            .execute(self.db)
            .await?;
    }
