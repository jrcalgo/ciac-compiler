//! Request pipeline for `api Submit`. Generated by CIaC.
//!
//! Pipeline: Validate -> publish ingest.events -> Return


use axum::extract::State;
use axum::routing::post;
use axum::{Json, Router};

use crate::error::AppError;
use crate::services::validate::Validate;
use crate::state::AppState;

pub fn router() -> Router<AppState> {
    Router::new().route("/submit", post(submit))
}

async fn submit(
    State(state): State<AppState>,
    Json(payload): Json<serde_json::Value>,
) -> Result<Json<serde_json::Value>, AppError> {
    let result = payload;

    let result = Validate::new(&state).handle(result).await?;
    state
        .queue
        .publish("ingest.events", serde_json::to_vec(&result)?.into())
        .await?;
    Ok(Json(serde_json::json!({"status": "accepted", "data": result})))
}
