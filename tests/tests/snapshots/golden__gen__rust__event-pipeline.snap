//! Runs every worker in one process. Generated by CIaC.

use ingest::{config::Config, state::AppState, workers};

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    ingest::observability::init();
    let config = Config::from_env();
    let state = AppState::new(config).await?;
    tokio::try_join!(
        workers::processor::run(state.clone()),
        workers::page_view_consumer::run(state.clone()),
    )?;
    Ok(())
}
