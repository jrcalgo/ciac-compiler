//! HTTP routing. Generated by CIaC.

pub mod evict_cache_api;
pub mod remove_doc_api;
pub mod list_docs_api;
pub mod notify_user_api;
pub mod index_doc_api;
pub mod search_docs_api;
pub mod call_upstream_api;

use axum::routing::get;
use axum::{Json, Router};

use crate::state::AppState;

pub fn router() -> Router<AppState> {
    Router::new()
        .route("/health", get(health))
        .merge(evict_cache_api::router())
        .merge(remove_doc_api::router())
        .merge(list_docs_api::router())
        .merge(notify_user_api::router())
        .merge(index_doc_api::router())
        .merge(search_docs_api::router())
        .merge(call_upstream_api::router())
}

async fn health() -> Json<serde_json::Value> {
    Json(serde_json::json!({"status": "ok"}))
}

