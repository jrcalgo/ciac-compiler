src/bin/sim_runner.rs
============================================================
//! Minimal scenario-driving simulation runner. Generated by CIaC (v0.17 M11).
//!
//! Interprets `ciac_sim::scenario::Scenario` JSON (the closed
//! `request`/`publish`/`advance`/`drain`/`expect` step vocabulary)
//! against this service's own generated routes (through
//! `tower::ServiceExt::oneshot`, no live listener) and its worker
//! `handle_message_once`/job `handle_tick_once` entry points --
//! mirroring `sim/pyrunner/scenario_runner.py`'s architecture, generated
//! rather than hand-registered because Rust needs concrete per-program
//! types at compile time.
//!
//! Deliberately narrow, matching `src/world.rs`'s own disclosed scope:
//! single-service only; `publish` steps (publishing directly to a
//! stream, bypassing an API) are not wired; `expect.quiescence` and
//! `drain` see one global undelivered-message buffer, not independent
//! per-`(subject, group)` cursors. Any scenario step this runner cannot
//! honor is a hard error on stdout/exit code, never a silently-skipped
//! no-op.

use std::collections::BTreeMap;
use std::sync::Arc;
use axum::body::Body;
use axum::http::Request;
use tower::ServiceExt;

use extras_verbs::config::Config;
use extras_verbs::routes;
use extras_verbs::scenario::{ExpectStep, Scenario, ScenarioStep};
use extras_verbs::state::AppState;
use extras_verbs::world::SimWorld;

/// Matches `crate::json_out::SimScenarioOutcome` field-for-field
/// (`crates/ciac/src/json_out.rs`) -- the one-line JSON reply on stdout
/// `ciac sim`'s Rust path reads, same bounded child protocol as the
/// Python runner's `auto_driver.py`.
#[derive(Debug, serde::Serialize)]
struct SimScenarioOutcome {
    scenario: String,
    passed: bool,
    error: Option<String>,
    worker_attempts: BTreeMap<String, u32>,
    job_runs: BTreeMap<String, u32>,
}

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    let scenario_path = std::env::args().nth(1).ok_or_else(|| {
        anyhow::anyhow!("usage: sim_runner <scenario.json>")
    })?;
    let json = std::fs::read_to_string(&scenario_path)
        .map_err(|e| anyhow::anyhow!("reading {scenario_path}: {e}"))?;
    let scenario = Scenario::parse(&json).map_err(|e| anyhow::anyhow!("{e}"))?;
    scenario.validate().map_err(|e| anyhow::anyhow!("{e}"))?;
    let name = scenario.name.clone();

    let mut runner = Runner::new(&scenario).await?;
    let outcome = match runner.run(&scenario).await {
        Ok(()) => SimScenarioOutcome {
            scenario: name,
            passed: true,
            error: None,
            worker_attempts: runner.worker_attempts,
            job_runs: runner.job_runs,
        },
        Err(err) => SimScenarioOutcome {
            scenario: name,
            passed: false,
            error: Some(format!("{err:#}")),
            worker_attempts: runner.worker_attempts,
            job_runs: runner.job_runs,
        },
    };
    println!("{}", serde_json::to_string(&outcome)?);
    Ok(())
}

struct Runner {
    // Read only by `request`/`drain` -- unused when this service
    // declares neither `api` pipelines nor workers/jobs (there's
    // nothing left for a scenario to drive besides `given.db`/`expect`).
    #[allow(dead_code)]
    state: AppState,
    world: Arc<SimWorld>,
    now_ms: i64,
    saved: BTreeMap<String, (u16, serde_json::Value)>,
    worker_attempts: BTreeMap<String, u32>,
    job_runs: BTreeMap<String, u32>,
}

impl Runner {
    async fn new(scenario: &Scenario) -> anyhow::Result<Self> {
        // 27UpdatePlan.md M4: schema facts computed once at codegen time
        // from the same source `snapshot_schema` builds the migration
        // DDL from, so `db_delete_checked`'s cascade/restrict and
        // `db_insert_checked`/`db_update_checked`'s reference/unique
        // checks can never drift from what the real schema enforces.
        let world = Arc::new(SimWorld::with_schema(
            scenario.given.failures.clone(),
            vec![
            ],
        ));
        let now_ms = chrono::DateTime::parse_from_rfc3339(&scenario.start_at)
            .map_err(|e| anyhow::anyhow!("scenario start_at {:?}: {e}", scenario.start_at))?
            .timestamp_millis();
        // `SimWorld::new` always starts its own virtual clock at epoch 0
        // (disclosed in `world.rs`'s own doc comment -- not yet
        // scenario-customizable); synced to `start_at` here, before any
        // TTL-bearing seed below reads `world.now_ms()`, and kept in
        // lockstep by every `advance()` step thereafter.
        world.advance_clock_to(now_ms);
        for seed in &scenario.given.db {
            if seed.service != "ExtrasVerbs" {
                anyhow::bail!(
                    "sim_runner only drives service {:?} (v0.17 M11, single-service only); \
                     given.db named {:?}",
                    "ExtrasVerbs",
                    seed.service
                );
            }
            for row in &seed.rows {
                world.db.insert(&seed.table, row.clone());
            }
        }
        // 27UpdatePlan.md M4: `given.cache`/`given.store`/`given.search`/
        // `given.external_http` -- mirrors `sim/pyrunner/auto_driver.py`'s
        // `apply_given` (the same four lists that driver discloses were
        // silently dropped before that fix).
        for entry in &scenario.given.cache {
            let ttl_ms = entry.ttl.as_deref().map(parse_duration_ms).transpose()?;
            world.cache_set(
                &entry.instance,
                &entry.key,
                serde_json::to_string(&entry.value)?,
                ttl_ms,
            );
        }
        for obj in &scenario.given.store {
            use base64::Engine;
            let body = base64::engine::general_purpose::STANDARD
                .decode(&obj.value_base64)
                .map_err(|e| anyhow::anyhow!("given.store {:?}: {e}", obj.key))?;
            world.object_put(&obj.instance, &obj.key, body);
        }
        for doc in &scenario.given.search {
            world.search_index(&doc.instance, &doc.id, doc.doc.clone());
        }
        for fixture in &scenario.given.external_http {
            world.seed_http_fixtures(&fixture.instance, fixture.responses.clone());
        }
        let config = Config::from_env();
        let state = AppState::simulation(config, world.clone()).await?;
        Ok(Self {
            state,
            world,
            now_ms,
            saved: BTreeMap::new(),
            worker_attempts: BTreeMap::new(),
            job_runs: BTreeMap::new(),
        })
    }

    async fn run(&mut self, scenario: &Scenario) -> anyhow::Result<()> {
        for step in &scenario.steps {
            match step {
                ScenarioStep::Request(spec) => self.request(spec).await?,
                ScenarioStep::Publish(_) => anyhow::bail!(
                    "sim_runner does not yet support `publish` steps (v0.17 M11 disclosed scope)"
                ),
                ScenarioStep::Advance(spec) => self.advance(&spec.by).await?,
                ScenarioStep::Drain(_) => self.drain().await?,
                ScenarioStep::Expect(spec) => self.expect(spec)?,
            }
        }
        let unmatched = self.world.unmatched_failure_rules();
        if !unmatched.is_empty() {
            anyhow::bail!(
                "{} failure rule(s) declared in `given.failures` never matched a real \
                 occurrence: {unmatched:?}",
                unmatched.len()
            );
        }
        Ok(())
    }
    async fn request(&mut self, spec: &extras_verbs::scenario::RequestStep) -> anyhow::Result<()> {
        if spec.service != "ExtrasVerbs" {
            anyhow::bail!(
                "sim_runner only drives service {:?} (v0.17 M11, single-service only); \
                 request named {:?}",
                "ExtrasVerbs",
                spec.service
            );
        }
        let app = routes::router().with_state(self.state.clone());
        let (method, path): (axum::http::Method, &str) = match spec.api.as_str() {
            "EvictCacheApi" => (axum::http::Method::POST, "/evict-cache-api"),
            "RemoveDocApi" => (axum::http::Method::POST, "/remove-doc-api"),
            "ListDocsApi" => (axum::http::Method::POST, "/list-docs-api"),
            "NotifyUserApi" => (axum::http::Method::POST, "/notify-user-api"),
            "IndexDocApi" => (axum::http::Method::POST, "/index-doc-api"),
            "SearchDocsApi" => (axum::http::Method::POST, "/search-docs-api"),
            "CallUpstreamApi" => (axum::http::Method::POST, "/call-upstream-api"),
            other => anyhow::bail!("sim_runner: no api registered named {other:?}"),
        };
        let mut request_builder = Request::builder()
            .method(method)
            .uri(path)
            .header(axum::http::header::CONTENT_TYPE, "application/json");
        // 27UpdatePlan.md M4: synthesizes a bearer token from the step's
        // own `as` principal exactly like `sim/pyrunner/auto_driver.py`'s
        // `_request` (`f"sim:{sub}:{','.join(scopes)}"`, claims
        // `{"sub": sub, "scope": " ".join(scopes)}`) -- Rust's own
        // `Claims::require_scope` reads either a space-joined `scope`
        // string or a `scp` array (`auth.rs.j2`), so the space-joined
        // form is what this world-issued token must carry.
        if let Some(principal) = &spec.principal {
            let token = format!("sim:{}:{}", principal.sub, principal.scopes.join(","));
            self.world.auth_issue(
                &token,
                serde_json::json!({"sub": principal.sub, "scope": principal.scopes.join(" ")}),
                None,
            );
            request_builder = request_builder
                .header(axum::http::header::AUTHORIZATION, format!("Bearer {token}"));
        }
        let request = request_builder.body(Body::from(serde_json::to_vec(&spec.json)?))?;
        let response = app
            .oneshot(request)
            .await
            .map_err(|err| anyhow::anyhow!("{err}"))?;
        let status = response.status().as_u16();
        let body = axum::body::to_bytes(response.into_body(), usize::MAX).await?;
        // A non-2xx response's body is plain text, not JSON (see
        // `error.rs.j2`'s `AppError::into_response`) -- parsed as a
        // JSON string rather than treated as a hard parse error, so
        // `expect.response`'s `status`-only checks (the common case for
        // an error path) never fail on the body shape they never asked
        // about.
        let json = if body.is_empty() {
            serde_json::Value::Null
        } else {
            serde_json::from_slice(&body)
                .unwrap_or_else(|_| serde_json::Value::String(String::from_utf8_lossy(&body).into_owned()))
        };
        if let Some(save_as) = &spec.save_as {
            self.saved.insert(save_as.clone(), (status, json));
        }
        Ok(())
    }

    async fn advance(&mut self, by: &str) -> anyhow::Result<()> {
        let delta_ms = parse_duration_ms(by)?;
        let from_ms = self.now_ms;
        let to_ms = from_ms + delta_ms;
        self.now_ms = to_ms;
        self.world.advance_clock_to(to_ms);
        Ok(())
    }

    /// One pass: every worker drains its *own* `(subject, group)` cursor
    /// on `world.broker` (27UpdatePlan.md M4 -- see `src/world.rs`'s
    /// `BrokerLog` doc comment for why this replaces the old shared-
    /// queue dispatch) into its `handle_message_once` (with that
    /// worker's own retry budget) -- messages a handler publishes as a
    /// side effect of processing are left for the *next* `drain` step,
    /// same as `sim/pyrunner/scenario_runner.py`'s own
    /// `deliver_counting_attempts` (one pass per worker per step, not a
    /// fixed-point loop). Two independent workers on the same subject
    /// now each see every message (true fan-out), where the old shared-
    /// queue dispatch delivered only to whichever worker's `if`/`else
    /// if` branch matched first.
    async fn drain(&mut self) -> anyhow::Result<()> {
        // `world.queue` is dual-written alongside `world.broker`
        // (`publish_checked`'s own doc comment) for exactly this sweep:
        // a message published to a subject no registered worker drains
        // above is refused here, not left to sit undelivered forever --
        // the same "refused, not guessed" contract this runner has
        // always held for capabilities it doesn't cover.
        for (subject, _raw) in self.world.queue.take_all() {
            anyhow::bail!(
                "sim_runner: no worker registered to consume subject {subject:?} \
                 (v0.17 M11 disclosed scope)"
            );
        }
        Ok(())
    }

    fn expect(&self, spec: &ExpectStep) -> anyhow::Result<()> {
        match spec {
            ExpectStep::Response { of, status, json } => {
                let of = of
                    .as_deref()
                    .ok_or_else(|| anyhow::anyhow!("expect.response requires \"of\""))?;
                let (got_status, got_json) = self.saved.get(of).ok_or_else(|| {
                    anyhow::anyhow!("expect.response.of references unknown save_as {of:?}")
                })?;
                if let Some(want_status) = status {
                    if got_status != want_status {
                        anyhow::bail!(
                            "expect.response.of={of:?}: expected status {want_status}, got \
                             {got_status}"
                        );
                    }
                }
                if let Some(want_json) = json {
                    if got_json != want_json {
                        anyhow::bail!(
                            "expect.response.of={of:?}: expected json {want_json}, got {got_json}"
                        );
                    }
                }
                Ok(())
            }
            ExpectStep::Row {
                service,
                table,
                matches,
                present,
            } => {
                if service != "ExtrasVerbs" {
                    anyhow::bail!(
                        "sim_runner only drives service {:?} (v0.17 M11, single-service only); \
                         expect.row named {service:?}",
                        "ExtrasVerbs"
                    );
                }
                let found = !self.world.db.find_where(table, matches).is_empty();
                if found != *present {
                    anyhow::bail!(
                        "expect.row: table={table:?} where={matches:?} present={present}, found={found}"
                    );
                }
                Ok(())
            }
            ExpectStep::WorkerAttempts { worker, count } => {
                let actual = self.worker_attempts.get(worker).copied().unwrap_or(0);
                if actual != *count {
                    anyhow::bail!(
                        "expect.worker_attempts: worker={worker:?} expected {count}, got {actual}"
                    );
                }
                Ok(())
            }
            ExpectStep::JobRuns { job, count } => {
                let actual = self.job_runs.get(job).copied().unwrap_or(0);
                if actual != *count {
                    anyhow::bail!("expect.job_runs: job={job:?} expected {count}, got {actual}");
                }
                Ok(())
            }
            ExpectStep::Quiescence {} => {
                if !self.world.queue.is_empty() {
                    anyhow::bail!(
                        "expect.quiescence: undelivered message(s) remain in the simulated broker"
                    );
                }
                Ok(())
            }
            // 27UpdatePlan.md M4: mirrors
            // `sim/pyrunner/scenario_runner.py`'s `_expect_email`/
            // `_expect_cache`/`_expect_object`/`_expect_search_hits`/
            // `_expect_http_calls` exactly, now that M3 built the
            // matching fakes into `SimWorld`.
            ExpectStep::Email {
                to,
                subject_contains,
                count,
            } => {
                let actual = self
                    .world
                    .email_sent_count_all(to.as_deref(), subject_contains.as_deref());
                if actual != *count as usize {
                    anyhow::bail!(
                        "expect.email: to={to:?} subject_contains={subject_contains:?} \
                         expected {count}, got {actual}"
                    );
                }
                Ok(())
            }
            ExpectStep::Cache {
                instance,
                key,
                present,
                value,
            } => {
                let cached = self.world.cache_get(instance, key);
                let found = cached.is_some();
                if found != *present {
                    anyhow::bail!(
                        "expect.cache: instance={instance:?} key={key:?} expected \
                         present={present}, found present={found}"
                    );
                }
                if let Some(want) = value {
                    let actual: Option<serde_json::Value> =
                        cached.map(|s| serde_json::from_str(&s)).transpose()?;
                    if actual.as_ref() != Some(want) {
                        anyhow::bail!(
                            "expect.cache: instance={instance:?} key={key:?} expected \
                             value={want:?}, got {actual:?}"
                        );
                    }
                }
                Ok(())
            }
            ExpectStep::Object {
                store,
                key,
                present,
            } => {
                let found = self.world.object_exists(store, key);
                if found != *present {
                    anyhow::bail!(
                        "expect.object: store={store:?} key={key:?} expected \
                         present={present}, found present={found}"
                    );
                }
                Ok(())
            }
            ExpectStep::SearchHits {
                instance,
                query,
                count,
            } => {
                let actual = self.world.search_query(instance, query).len();
                if actual != *count as usize {
                    anyhow::bail!(
                        "expect.search_hits: instance={instance:?} query={query:?} \
                         expected {count}, got {actual}"
                    );
                }
                Ok(())
            }
            ExpectStep::HttpCalls { instance, count } => {
                let actual = self.world.http_request_count(instance);
                if actual != *count as usize {
                    anyhow::bail!(
                        "expect.http_calls: instance={instance:?} expected {count}, got {actual}"
                    );
                }
                Ok(())
            }
        }
    }
}

/// Parses `advance.by` strings (`"24h"`, `"7d"`, `"30m"`, ...) -- the
/// same small duration grammar the plan's own worked examples use,
/// matching `sim/pyrunner/cron.py`'s `parse_duration_ms` exactly.
fn parse_duration_ms(text: &str) -> anyhow::Result<i64> {
    let split_at = text
        .find(|c: char| !c.is_ascii_digit())
        .ok_or_else(|| anyhow::anyhow!("unrecognized duration: {text:?}"))?;
    let (value, unit) = text.split_at(split_at);
    let value: i64 = value
        .parse()
        .map_err(|_| anyhow::anyhow!("unrecognized duration: {text:?}"))?;
    let unit_ms: i64 = match unit {
        "ms" => 1,
        "s" => 1_000,
        "m" => 60_000,
        "h" => 3_600_000,
        "d" => 86_400_000,
        other => anyhow::bail!("unrecognized duration unit {other:?} in {text:?}"),
    };
    Ok(value * unit_ms)
}
