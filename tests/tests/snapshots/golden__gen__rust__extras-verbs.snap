//! Request pipeline for `api CallUpstreamApi`. Generated by CIaC.
//!
//! Pipeline: CallUpstream -> Return


use axum::extract::State;
use axum::routing::post;
use axum::{Json, Router};

use crate::error::AppError;
use crate::schemas::HttpRequest;
use crate::logic::call_upstream::CallUpstream;
use crate::state::AppState;

pub fn router() -> Router<AppState> {
    Router::new().route("/call-upstream-api", post(call_upstream_api))
}

async fn call_upstream_api(
    State(state): State<AppState>,
    Json(payload): Json<HttpRequest>,
) -> Result<Json<serde_json::Value>, AppError> {
    let result = payload;

    let result = CallUpstream::new(&state).handle(result).await?;
    Ok(Json(serde_json::json!({"status": "accepted", "data": result})))
}
