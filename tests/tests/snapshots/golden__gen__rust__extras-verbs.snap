//! External HTTP clients. Generated by CIaC.
//!
//! Each `external_http` instance gets a reqwest client bound to its
//! configured base URL, so handlers call third-party APIs through a
//! single managed client per upstream.

/// One upstream HTTP API, addressed relative to its base URL.
#[derive(Debug, Clone)]
pub struct ExternalHttp {
    pub base_url: String,
    client: reqwest::Client,
}

impl ExternalHttp {
    pub fn new(base_url: String) -> Self {
        Self {
            base_url,
            client: reqwest::Client::new(),
        }
    }

    /// Builds a request for `path` relative to the instance base URL.
    pub fn request(&self, method: reqwest::Method, path: &str) -> reqwest::RequestBuilder {
        let url = format!(
            "{}/{}",
            self.base_url.trim_end_matches('/'),
            path.trim_start_matches('/')
        );
        self.client.request(method, url)
    }

    pub fn get(&self, path: &str) -> reqwest::RequestBuilder {
        self.request(reqwest::Method::GET, path)
    }

    pub fn post(&self, path: &str) -> reqwest::RequestBuilder {
        self.request(reqwest::Method::POST, path)
    }
}
