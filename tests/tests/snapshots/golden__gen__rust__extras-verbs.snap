[package]
name = "extras-verbs"
version = "0.1.0"
edition = "2021"
description = "Generated by CIaC from `service ExtrasVerbs`"

# 32UpdatePlan.md follow-up: `debug` defaults to full (`opt-level`-independent
# DWARF) under `[profile.dev]`'s own Cargo default, which this project never
# declared -- generating and linking that debug info is real, measured cost
# `cargo test` pays on every run. `"line-tables-only"` (the same value the
# compiler's own workspace `[profile.dev]` uses, `32UpdatePlan.md` M8 item 8)
# keeps file/line resolution in `RUST_BACKTRACE`/panic output -- the one
# piece of debug info a generated service's own test failures actually
# read -- while dropping the full variable/type DWARF a step debugger
# would need, which nothing in this generated project's own workflow uses.
[profile.dev]
debug = "line-tables-only"

[dependencies]
anyhow = "1"
axum = "0.8"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["full"] }
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
chrono = { version = "0.4", features = ["serde"] }
# 27UpdatePlan.md M4: `src/bin/sim_runner.rs` decodes `given.store`'s
# `value_base64` (the scenario schema's own binary-payload encoding)
# regardless of which capabilities this particular service declares --
# the runner is generic over the whole scenario schema.
base64 = "0.22"
redis = { version = "0.27", features = ["tokio-comp"] }
rust-s3 = "0.35"
lettre = { version = "0.11", default-features = false, features = ["builder", "hostname", "pool", "smtp-transport", "tokio1", "tokio1-rustls-tls"] }
opensearch = "2"
reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls"] }
# v0.17 M11: `src/bin/sim_runner.rs` drives `routes::router()` through
# `tower::ServiceExt::oneshot` (no live listener), so this needs to be a
# real dependency, not the dev-only one below (which folds into this
# condition rather than duplicating the crate when both apply).
tower = { version = "0.5", features = ["util"] }
