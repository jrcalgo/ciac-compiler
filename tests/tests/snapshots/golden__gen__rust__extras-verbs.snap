//! S3 object storage client. Generated by CIaC.
//!
//! Each named `object_store` instance gets a client on `AppState`.
//! Defaults target a local MinIO from the generated docker-compose; point
//! the `S3_*` environment variables at real S3 in production.

use s3::creds::Credentials;
use s3::{Bucket, Region};

/// One S3 bucket, addressed path-style so MinIO works out of the box.
///
/// Holds configuration only; the underlying client is built per call, so
/// the server starts (and compiles) without a running object store.
#[derive(Debug, Clone)]
pub struct ObjectStore {
    pub endpoint: String,
    pub access_key: String,
    pub secret_key: String,
    pub bucket: String,
    pub region: String,
}

impl ObjectStore {
    fn bucket(&self) -> anyhow::Result<Box<Bucket>> {
        let credentials = Credentials::new(
            Some(&self.access_key),
            Some(&self.secret_key),
            None,
            None,
            None,
        )?;
        let region = Region::Custom {
            region: self.region.clone(),
            endpoint: self.endpoint.clone(),
        };
        Ok(Bucket::new(&self.bucket, region, credentials)?.with_path_style())
    }

    pub async fn put(&self, key: &str, body: &[u8]) -> anyhow::Result<()> {
        self.bucket()?.put_object(key, body).await?;
        Ok(())
    }

    pub async fn get(&self, key: &str) -> anyhow::Result<Vec<u8>> {
        let response = self.bucket()?.get_object(key).await?;
        Ok(response.to_vec())
    }

    pub async fn delete(&self, key: &str) -> anyhow::Result<()> {
        self.bucket()?.delete_object(key).await?;
        Ok(())
    }

    pub async fn list(&self, prefix: &str) -> anyhow::Result<Vec<String>> {
        let pages = self.bucket()?.list(prefix.to_owned(), None).await?;
        Ok(pages
            .into_iter()
            .flat_map(|page| page.contents.into_iter().map(|obj| obj.key))
            .collect())
    }

    pub async fn presign_get(&self, key: &str, expires_s: u32) -> anyhow::Result<String> {
        Ok(self.bucket()?.presign_get(key, expires_s, None).await?)
    }
}
