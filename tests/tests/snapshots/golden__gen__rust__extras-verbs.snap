//! OpenSearch client. Generated by CIaC.
//!
//! Each named `search` instance gets a client on `AppState`. Defaults
//! target the single-node OpenSearch container from the generated
//! docker-compose.

use opensearch::http::transport::Transport;
use opensearch::{DeleteParts, IndexParts, OpenSearch, SearchParts};

/// Async wrapper over one OpenSearch endpoint.
///
/// Holds configuration only; the underlying client is built per call, so
/// the server starts (and compiles) without a running search cluster.
#[derive(Debug, Clone)]
pub struct Search {
    pub url: String,
}

impl Search {
    fn client(&self) -> anyhow::Result<OpenSearch> {
        Ok(OpenSearch::new(Transport::single_node(&self.url)?))
    }

    pub async fn index(
        &self,
        index: &str,
        doc_id: &str,
        document: &serde_json::Value,
    ) -> anyhow::Result<()> {
        self.client()?
            .index(IndexParts::IndexId(index, doc_id))
            .body(document)
            .send()
            .await?
            .error_for_status_code()?;
        Ok(())
    }

    pub async fn search(
        &self,
        index: &str,
        query: &serde_json::Value,
    ) -> anyhow::Result<Vec<serde_json::Value>> {
        let response = self
            .client()?
            .search(SearchParts::Index(&[index]))
            .body(query)
            .send()
            .await?
            .error_for_status_code()?;
        let body: serde_json::Value = response.json().await?;
        let hits = body["hits"]["hits"]
            .as_array()
            .map(|hits| hits.iter().map(|hit| hit["_source"].clone()).collect())
            .unwrap_or_default();
        Ok(hits)
    }

    pub async fn delete(&self, index: &str, doc_id: &str) -> anyhow::Result<()> {
        self.client()?
            .delete(DeleteParts::IndexId(index, doc_id))
            .send()
            .await?
            .error_for_status_code()?;
        Ok(())
    }
}
