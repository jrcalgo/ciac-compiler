//! Request pipeline for `api SearchDocsApi`. Generated by CIaC.
//!
//! Pipeline: SearchDocs -> Return


use axum::extract::State;
use axum::routing::post;
use axum::{Json, Router};

use crate::error::AppError;
use crate::schemas::SearchRequest;
use crate::logic::search_docs::SearchDocs;
use crate::state::AppState;

pub fn router() -> Router<AppState> {
    Router::new().route("/search-docs-api", post(search_docs_api))
}

async fn search_docs_api(
    State(state): State<AppState>,
    Json(payload): Json<SearchRequest>,
) -> Result<Json<serde_json::Value>, AppError> {
    let result = payload;

    let result = SearchDocs::new(&state).handle(result).await?;
    Ok(Json(serde_json::json!({"status": "accepted", "data": result})))
}
