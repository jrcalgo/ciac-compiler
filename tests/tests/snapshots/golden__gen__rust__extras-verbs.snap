//! Shared application state. Generated by CIaC.

use crate::config::Config;

#[derive(Debug, Clone)]
pub struct AppState {
    pub config: Config,
    pub cache: redis::Client,
    pub object_store: crate::object_store::ObjectStore,
    pub email: crate::email::Email,
    pub search: crate::search::Search,
    pub http_upstream: crate::http_clients::ExternalHttp,
    /// `None` in production; `Some` only when constructed via
    /// [`AppState::simulation`] (v0.17 M11) -- every world-guarded
    /// call site (`db.insert`, broker `publish`, and every peripheral
    /// verb faked as of 27UpdatePlan.md M4) checks this first,
    /// reading/writing the in-memory `SimWorld` instead of the real
    /// pool/broker/peripheral client fields above, which still exist
    /// (so this struct's shape doesn't fork between production and
    /// simulation builds) but are never touched while `world` is `Some`.
    pub world: Option<std::sync::Arc<crate::world::SimWorld>>,
}

impl AppState {
    pub async fn new(config: Config) -> anyhow::Result<Self> {
        let cache = redis::Client::open(config.redis_url.as_str())?;
        let object_store = crate::object_store::ObjectStore {
            endpoint: config.s3_endpoint.clone(),
            access_key: config.s3_access_key.clone(),
            secret_key: config.s3_secret_key.clone(),
            bucket: config.s3_bucket.clone(),
            region: config.s3_region.clone(),
        };
        let email = crate::email::Email {
            host: config.smtp_host.clone(),
            port: config.smtp_port.clone(),
            username: config.smtp_username.clone(),
            password: config.smtp_password.clone(),
            sender: config.smtp_from.clone(),
            use_tls: config.smtp_use_tls.clone(),
        };
        let search = crate::search::Search {
            url: config.search_url.clone(),
        };
        let http_upstream =
            crate::http_clients::ExternalHttp::new(config.http_base_url_upstream.clone());
        Ok(Self {
            config,
            cache,
            object_store,
            email,
            search,
            http_upstream,
            world: None,
        })
    }

    /// Constructs `AppState` against an in-memory [`crate::world::
    /// SimWorld`] instead of real infrastructure (v0.17 M11). Delegates
    /// to [`AppState::new`] for every other field -- safe because every
    /// one of them is already lazy (`connect_lazy` pools, the lazy
    /// broker client, the lazy JWKS lookup all added earlier this same
    /// milestone specifically so this could be true): constructing them
    /// never touches the network, and the world-guarded call sites
    /// never fall through to them once `world` is `Some`. `config` is
    /// still required, not defaulted: a still-unguarded field (e.g. an
    /// OAuth2 issuer) may be read even under simulation, a gap this
    /// constructor discloses by requiring real config rather than
    /// inventing placeholder values.
    pub async fn simulation(
        config: Config,
        world: std::sync::Arc<crate::world::SimWorld>,
    ) -> anyhow::Result<Self> {
        let mut state = Self::new(config).await?;
        state.world = Some(world);
        Ok(state)
    }
}
