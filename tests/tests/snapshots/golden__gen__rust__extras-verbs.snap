pub fn router() -> Router<AppState> {
    Router::new().route("/remove-doc-api", post(remove_doc_api))
}

async fn remove_doc_api(
    State(state): State<AppState>,
    Json(payload): Json<KeyOnly>,
) -> Result<Json<serde_json::Value>, AppError> {
    let result = payload;

    let result = RemoveDoc::new(&state).handle(result).await?;
    Ok(Json(serde_json::json!({"status": "accepted", "data": result})))
}
