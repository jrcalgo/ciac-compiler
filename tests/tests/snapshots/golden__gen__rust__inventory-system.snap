//! Request pipeline for `api Price`. Generated by CIaC.
//!
//! Pipeline: ComputePrice -> Return


use axum::extract::State;
use axum::routing::post;
use axum::{Json, Router};

use crate::error::AppError;
use crate::schemas::Item;
use crate::services::compute_price::ComputePrice;
use crate::state::AppState;

pub fn router() -> Router<AppState> {
    Router::new().route("/price", post(price))
}

async fn price(
    State(state): State<AppState>,
    Json(payload): Json<Item>,
) -> Result<Json<serde_json::Value>, AppError> {
    let result = payload;

    let result = ComputePrice::new(&state).handle(result).await?;
    Ok(Json(serde_json::json!({"status": "accepted", "data": result})))
}
