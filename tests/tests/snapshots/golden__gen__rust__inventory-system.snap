//! Persistence for the `Item` resource. Generated by CIaC.

use redis::AsyncCommands;

use crate::models::{Item, ItemIn};
use crate::state::AppState;
/// CRUD operations for Item with read-through caching.
#[derive(Debug)]
pub struct ItemStore<'a> {
    pub db: &'a sqlx::PgPool,
    pub cache: &'a redis::Client,
}

impl<'a> ItemStore<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            db: &state.db,
            cache: &state.cache,
        }
    }


    pub async fn create(&self, payload: ItemIn) -> anyhow::Result<Item> {
        let entity = Item {
            id: uuid::Uuid::new_v4().to_string(),
            name: payload.name,
        };
        sqlx::query(
            "INSERT INTO items (id, name) VALUES ($1, $2)",
        )
        .bind(&entity.id)
        .bind(&entity.name)
        .execute(self.db)
        .await?;
        Ok(entity)
    }

    pub async fn get(&self, id: &str) -> anyhow::Result<Option<Item>> {
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        if let Some(cached) = cache.get::<_, Option<String>>(cache_key(id)).await? {
            return Ok(Some(serde_json::from_str(&cached)?));
        }
        let entity: Option<Item> =
            sqlx::query_as("SELECT id, name FROM items WHERE id = $1")
                .bind(id)
                .fetch_optional(self.db)
                .await?;
        if let Some(entity) = &entity {
            let _: () = cache
                .set_ex(cache_key(id), serde_json::to_string(entity)?, 300)
                .await?;
        }
        Ok(entity)
    }

    pub async fn list(&self, limit: i64, offset: i64) -> anyhow::Result<Vec<Item>> {
        let entities =
            sqlx::query_as("SELECT id, name FROM items ORDER BY id LIMIT $1 OFFSET $2")
                .bind(limit)
                .bind(offset)
                .fetch_all(self.db)
                .await?;
        Ok(entities)
    }

    pub async fn update(
        &self,
        id: &str,
        payload: ItemIn,
    ) -> anyhow::Result<Option<Item>> {
        let entity = Item {
            id: id.to_owned(),
            name: payload.name,
        };
        let updated = sqlx::query(
            "UPDATE items SET name = $1 WHERE id = $2",
        )
        .bind(&entity.name)
        .bind(id)
        .execute(self.db)
        .await?;
        if updated.rows_affected() == 0 {
            return Ok(None);
        }
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        let _: () = cache.del(cache_key(id)).await?;
        Ok(Some(entity))
    }

    pub async fn delete(&self, id: &str) -> anyhow::Result<bool> {
        let deleted = sqlx::query("DELETE FROM items WHERE id = $1")
            .bind(id)
            .execute(self.db)
            .await?;
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        let _: () = cache.del(cache_key(id)).await?;
        Ok(deleted.rows_affected() > 0)
    }
}

fn cache_key(id: &str) -> String {
    format!("items:{id}")
}

