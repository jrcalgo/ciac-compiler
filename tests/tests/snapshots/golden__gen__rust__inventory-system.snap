//! Shared application state. Generated by CIaC.

use crate::config::Config;

#[derive(Debug, Clone)]
pub struct AppState {
    pub config: Config,
    /// Lazy pool: connections are established on first use, so the server
    /// starts (and compiles) without a running database.
    pub db: sqlx::PgPool,
    pub cache: redis::Client,
    /// `None` in production; `Some` only when constructed via
    /// [`AppState::simulation`] (v0.17 M11) -- every world-guarded
    /// call site (`db.insert`, broker `publish`) checks this first,
    /// reading/writing the in-memory `SimWorld` instead of the real
    /// pool/broker client fields above, which still exist (so this
    /// struct's shape doesn't fork between production and simulation
    /// builds) but are never touched while `world` is `Some`.
    pub world: Option<std::sync::Arc<crate::world::SimWorld>>,
}

impl AppState {
    pub async fn new(config: Config) -> anyhow::Result<Self> {
        let db =
            sqlx::postgres::PgPoolOptions::new().connect_lazy(&config.database_url)?;
        let cache = redis::Client::open(config.redis_url.as_str())?;
        Ok(Self {
            config,
            db,
            cache,
            world: None,
        })
    }

    /// Constructs `AppState` against an in-memory [`crate::world::
    /// SimWorld`] instead of real infrastructure (v0.17 M11). Delegates
    /// to [`AppState::new`] for every other field -- safe because every
    /// one of them is already lazy (`connect_lazy` pools, the lazy
    /// broker client, the lazy JWKS lookup all added earlier this same
    /// milestone specifically so this could be true): constructing them
    /// never touches the network, and the world-guarded call sites
    /// never fall through to them once `world` is `Some`. `config` is
    /// still required, not defaulted: a still-unguarded field (e.g. an
    /// OAuth2 issuer) may be read even under simulation, a gap this
    /// constructor discloses by requiring real config rather than
    /// inventing placeholder values.
    pub async fn simulation(
        config: Config,
        world: std::sync::Arc<crate::world::SimWorld>,
    ) -> anyhow::Result<Self> {
        let mut state = Self::new(config).await?;
        state.world = Some(world);
        Ok(state)
    }
}
