//! Typed HTTP client for the `Catalog` service. Generated by CIaC.
//!
//! `call Catalog.<Api>` pipeline steps invoke these methods. The
//! base URL comes from `CATALOG_URL`; the system docker-compose
//! points it at the `catalog` container.

use crate::schemas::{Item};
use crate::state::AppState;

/// Calls `Catalog` over HTTP and unwraps its response envelope.
pub struct CatalogClient<'a> {
    base_url: &'a str,
}

impl<'a> CatalogClient<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            base_url: &state.config.catalog_url,
        }
    }

    pub async fn price(&self, payload: Item) -> anyhow::Result<Item> {
        let response = reqwest::Client::new()
            .post(format!("{}/price", self.base_url))
            .json(&payload)
            .send()
            .await?
            .error_for_status()?;
        let body: serde_json::Value = response.json().await?;
        Ok(serde_json::from_value(body["data"].clone())?)
    }
}
