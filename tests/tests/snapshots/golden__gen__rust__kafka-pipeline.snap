//! Request pipeline for `api Ingest`. Generated by CIaC.
//!
//! Pipeline: publish clickstream.clicks -> Return


use axum::extract::State;
use axum::routing::post;
use axum::{Json, Router};

use crate::error::AppError;
use crate::schemas::Click;
use crate::state::AppState;

pub fn router() -> Router<AppState> {
    Router::new().route("/clicks", post(ingest))
}

async fn ingest(
    State(state): State<AppState>,
    Json(payload): Json<Click>,
) -> Result<Json<serde_json::Value>, AppError> {
    let result = payload;

    state
        .queue
        .publish("clickstream.clicks", serde_json::to_vec(&result)?)
        .await?;
    Ok(Json(serde_json::json!({"status": "accepted", "data": result})))
}
