Cargo.toml
============================================================
[package]
name = "clickstream"
version = "0.1.0"
edition = "2021"
description = "Generated by CIaC from `service Clickstream`"

[dependencies]
anyhow = "1"
axum = "0.8"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["full"] }
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
# Vendored librdkafka (cmake-build): full consumer-group semantics at
# the cost of a native build chain — cmake is required (the generated
# Dockerfile installs it; see its build stage). rdkafka-sys is pinned
# to =4.7.0 (librdkafka 2.3.0): newer vendored librdkafkas (2.12.x)
# demand libcurl dev headers even with WITH_CURL=0.
rdkafka = { version = "0.36", features = ["cmake-build", "tokio", "libz-static"] }
rdkafka-sys = { version = "=4.7.0", features = ["cmake-build", "libz-static"] }
futures = "0.3"
============================================================
Dockerfile
============================================================
FROM rust:1-slim AS build

# rdkafka's vendored librdkafka builds with cmake (statically linked,
# so the runtime stage needs nothing extra).
RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .
RUN cargo build --release

FROM debian:stable-slim

COPY --from=build /src/target/release/clickstream /usr/local/bin/app
COPY --from=build /src/target/release/workers /usr/local/bin/workers

EXPOSE 8000
CMD ["app"]
