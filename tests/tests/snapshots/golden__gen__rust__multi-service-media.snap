//! Runs every worker in one process. Generated by CIaC.

use notifier::{config::Config, state::AppState, workers};

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    notifier::observability::init();
    let config = Config::from_env();
    let state = AppState::new(config).await?;
    tokio::try_join!(
        workers::notify::run(state.clone()),
        workers::dead_letter_sink::run(state.clone()),
    )?;
    Ok(())
}
