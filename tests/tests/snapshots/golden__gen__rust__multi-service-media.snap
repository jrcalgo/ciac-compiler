//! Data schemas from the program's `record` declarations. Generated by CIaC.

use serde::{Deserialize, Serialize};


#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
pub enum VideoStatus {
    Ready,
    Failed,
}

impl VideoStatus {
    /// The wire/storage form of the variant.
    pub fn as_str(&self) -> &'static str {
        match self {
            VideoStatus::Ready => "Ready",
            VideoStatus::Failed => "Failed",
        }
    }

    /// The reverse of `as_str` — reconstructs the variant from a
    /// database/wire string, e.g. after `db.get` reads a `table`'s
    /// enum column back as plain text.
    pub fn from_str(s: &str) -> anyhow::Result<Self> {
        match s {
            "Ready" => Ok(VideoStatus::Ready),
            "Failed" => Ok(VideoStatus::Failed),
            other => Err(anyhow::anyhow!("invalid VideoStatus: {other}")),
        }
    }
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Video {
    pub id: String,
    pub title: String,
    pub status: VideoStatus,
}

