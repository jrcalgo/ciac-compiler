//! Realtime channel `Progress`. Generated by CIaC.

use futures::StreamExt;

use crate::schemas::Video;
use crate::state::AppState;

pub const SUBJECT: &str = "media_system.transcoded";

fn payload_text(bytes: &[u8]) -> Option<String> {
    let payload: Video = serde_json::from_slice(bytes).ok()?;
    serde_json::to_string(&payload).ok()
}
use axum::extract::ws::{Message, WebSocket, WebSocketUpgrade};
use axum::extract::State;
use axum::response::IntoResponse;
use axum::routing::get;
use axum::Router;

pub fn router() -> Router<AppState> {
    Router::new().route("/channels/progress", get(progress))
}

async fn progress(
    State(state): State<AppState>,
    ws: WebSocketUpgrade,
) -> impl IntoResponse {
    ws.on_upgrade(move |socket| stream(socket, state))
}

async fn stream(mut socket: WebSocket, state: AppState) {
    let Ok(mut subscription) = state.queue.client().subscribe(SUBJECT.to_owned()).await else {
        return;
    };
    while let Some(message) = subscription.next().await {
        let Some(data) = payload_text(&message.payload) else {
            continue;
        };
        if socket.send(Message::Text(data.into())).await.is_err() {
            break;
        }
    }
}
