docker-compose.yml
============================================================
services:

  billing:
    build: ./billing
    ports:
      - "8000:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30

  upload-api:
    build: ./upload-api
    ports:
      - "8001:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      BILLING_URL: http://billing:8000
      NATS_URL: nats://queue:4222
    depends_on:
      queue:
        condition: service_started

  transcoder:
    build: ./transcoder
    ports:
      - "8002:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      S3_ENDPOINT_MEDIA: http://transcoder-minio-media:9000
      NATS_URL: nats://queue:4222
    depends_on:
      transcoder-minio-media:
        condition: service_started
      queue:
        condition: service_started

  transcoder-workers:
    build: ./transcoder
    command: ["workers"]
    environment:
      S3_ENDPOINT_MEDIA: http://transcoder-minio-media:9000
      NATS_URL: nats://queue:4222
    depends_on:
      transcoder-minio-media:
        condition: service_started
      queue:
        condition: service_started

  notifier:
    build: ./notifier
    ports:
      - "8003:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      SMTP_HOST_TRANSACTIONAL: notifier-mailpit-transactional
      NATS_URL: nats://queue:4222
    depends_on:
      notifier-mailpit-transactional:
        condition: service_started
      queue:
        condition: service_started

  notifier-workers:
    build: ./notifier
    command: ["workers"]
    environment:
      SMTP_HOST_TRANSACTIONAL: notifier-mailpit-transactional
      NATS_URL: nats://queue:4222
    depends_on:
      notifier-mailpit-transactional:
        condition: service_started
      queue:
        condition: service_started

  progress-feed:
    build: ./progress-feed
    ports:
      - "8004:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      NATS_URL: nats://queue:4222
    depends_on:
      queue:
        condition: service_started

  transcoder-minio-media:
    image: minio/minio
    command: ["server", "/data"]
    environment:
      MINIO_ROOT_USER: minioadmin
      MINIO_ROOT_PASSWORD: minioadmin
    volumes:
      - transcoder-minio-media-data:/data

  notifier-mailpit-transactional:
    image: axllent/mailpit
    ports:
      - "8025:8025"

  queue:
    image: nats:2
    # Host mapping (v0.13 M2): the generated tests/system delivery and
    # channel tests connect from the host at localhost:4222.
    ports:
      - "4222:4222"

volumes:
  transcoder-minio-media-data:
