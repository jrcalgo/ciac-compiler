============================================================
//! Worker pipeline for `worker Transcode`. Generated by CIaC.
//!
//! Consumes `media_system.uploaded` in queue group `transcode`
//! so replicas of this worker load-balance messages between them.

use futures::StreamExt;
use futures::future::try_join_all;

use crate::schemas::Video;
use crate::services::transcode_video::TranscodeVideo;
use crate::state::AppState;

pub const SUBJECT: &str = "media_system.uploaded";
pub const QUEUE_GROUP: &str = "transcode";
pub const CONCURRENCY: usize = 1;
pub const MAX_RETRIES: u32 = 0;

pub async fn run(state: AppState) -> anyhow::Result<()> {
    let tasks = (0..CONCURRENCY).map(|worker_index| {
        let state = state.clone();
        tokio::spawn(async move { consume(state, worker_index).await })
    });
    for result in try_join_all(tasks).await? {
        result?;
    }
    Ok(())
}

async fn consume(state: AppState, worker_index: usize) -> anyhow::Result<()> {
    let mut subscription = state.queue.queue_subscribe(SUBJECT, QUEUE_GROUP).await?;
    tracing::info!(subject = SUBJECT, worker_index, "worker Transcode consuming");
    while let Some(message) = subscription.next().await {
        let payload: Video = match serde_json::from_slice(&message.payload) {
            Ok(payload) => payload,
            Err(err) => {
                tracing::warn!(?err, "discarding malformed message");
                continue;
            }
        };
        if let Err(err) = handle_message(&state, payload).await {
            tracing::error!(?err, "message processing failed after retries");
        }
    }
    Ok(())
}



async fn handle_message(state: &AppState, payload: Video) -> anyhow::Result<()> {
    for attempt in 0..=MAX_RETRIES {
        match handle_message_once(state, payload.clone()).await {
            Ok(()) => return Ok(()),
            Err(err) if attempt < MAX_RETRIES => {
                tracing::warn!(?err, attempt, "message processing failed; retrying");
            }
            Err(err) => return Err(err),
        }
    }
    Ok(())
}

async fn handle_message_once(state: &AppState, payload: Video) -> anyhow::Result<()> {
    let result = payload;

    let result = TranscodeVideo::new(state).handle(result).await?;
    let result = match result.status {
        crate::schemas::VideoStatus::Ready => {

            state
                .publish("media_system.transcoded", serde_json::to_vec(&result)?)
                .await?;
            result
        }
        crate::schemas::VideoStatus::Failed => {

            state
                .publish("media_system.dead_letters", serde_json::to_vec(&result)?)
                .await?;
            result
        }
    };
    let _ = result;
    Ok(())
}
