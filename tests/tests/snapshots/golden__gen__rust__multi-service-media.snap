//! Runs every worker in one process. Generated by CIaC.

use transcoder::{config::Config, state::AppState, workers};

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    transcoder::observability::init();
    let config = Config::from_env();
    let state = AppState::new(config).await?;
    tokio::try_join!(
        workers::transcode::run(state.clone()),
    )?;
    Ok(())
}
