//! Request pipeline for `api Upload`. Generated by CIaC.
//!
//! Pipeline: call Billing.Charge -> StoreVideo -> publish media_system.uploaded -> Return


use axum::extract::State;
use axum::routing::put;
use axum::{Json, Router};

use crate::error::AppError;
use crate::schemas::Video;
use crate::services::store_video::StoreVideo;
use crate::state::AppState;

pub fn router() -> Router<AppState> {
    Router::new().route("/videos", put(upload))
}

async fn upload(
    State(state): State<AppState>,
    Json(payload): Json<Video>,
) -> Result<Json<serde_json::Value>, AppError> {
    let result = payload;

    // TODO: call Billing.Charge with result.
    let result = StoreVideo::new(&state).handle(result).await?;
    state
        .queue
        .publish("media_system.uploaded", serde_json::to_vec(&result)?.into())
        .await?;
    Ok(Json(serde_json::json!({"status": "accepted", "data": result})))
}
