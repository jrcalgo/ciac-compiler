//! Typed HTTP client for the `Billing` service. Generated by CIaC.
//!
//! `call Billing.<Api>` pipeline steps invoke these methods. The
//! base URL comes from `BILLING_URL`; the system docker-compose
//! points it at the `billing` container.

use crate::schemas::{Video};
use crate::state::AppState;

/// Calls `Billing` over HTTP and unwraps its response envelope.
pub struct BillingClient<'a> {
    base_url: &'a str,
}

impl<'a> BillingClient<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            base_url: &state.config.billing_url,
        }
    }

    pub async fn charge(&self, payload: Video) -> anyhow::Result<Video> {
        let response = reqwest::Client::new()
            .post(format!("{}/charge", self.base_url))
            .json(&payload)
            .send()
            .await?
            .error_for_status()?;
        let body: serde_json::Value = response.json().await?;
        Ok(serde_json::from_value(body["data"].clone())?)
    }
}
