src/email.rs
============================================================
//! SMTP email sender. Generated by CIaC.
//!
//! Both `SMTP` and `SES` providers send over SMTP; for SES, point the
//! `SMTP_*` variables at your SES SMTP endpoint and credentials. Defaults
//! target the Mailpit container from the generated docker-compose, so
//! sent mail is inspectable at http://localhost:8025.

use lettre::message::Mailbox;
use lettre::transport::smtp::authentication::Credentials;
use lettre::{AsyncSmtpTransport, AsyncTransport, Message, Tokio1Executor};

/// Async sender bound to one SMTP endpoint.
///
/// Holds configuration only; the transport is built per send, so the
/// server starts (and compiles) without a running mail server.
#[derive(Debug, Clone)]
pub struct Email {
    pub host: String,
    pub port: String,
    pub username: String,
    pub password: String,
    pub sender: String,
    pub use_tls: String,
}

impl Email {
    fn transport(&self) -> anyhow::Result<AsyncSmtpTransport<Tokio1Executor>> {
        let mut builder = if self.use_tls == "true" {
            AsyncSmtpTransport::<Tokio1Executor>::relay(&self.host)?
        } else {
            AsyncSmtpTransport::<Tokio1Executor>::builder_dangerous(&self.host)
        };
        builder = builder.port(self.port.parse()?);
        if !self.username.is_empty() {
            builder = builder.credentials(Credentials::new(
                self.username.clone(),
                self.password.clone(),
            ));
        }
        Ok(builder.build())
    }

    pub async fn send(&self, to: &str, subject: &str, body: &str) -> anyhow::Result<()> {
        let message = Message::builder()
            .from(self.sender.parse::<Mailbox>()?)
            .to(to.parse::<Mailbox>()?)
            .subject(subject)
            .body(body.to_owned())?;
        self.transport()?.send(message).await?;
        Ok(())
    }
}
