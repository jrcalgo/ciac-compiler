//! Runtime configuration for Transcoder. Generated by CIaC.
//!
//! Every value can be overridden through the environment, e.g.
//! `DATABASE_URL`; defaults target local development.

#[derive(Debug, Clone)]
pub struct Config {
    pub s3_endpoint_media: String,
    pub s3_access_key_media: String,
    pub s3_secret_key_media: String,
    pub s3_bucket_media: String,
    pub s3_region_media: String,
    pub nats_url: String,
}

impl Config {
    pub fn from_env() -> Self {
        Self {
            s3_endpoint_media: env_or("S3_ENDPOINT_MEDIA", "http://localhost:9000"),
            s3_access_key_media: env_or("S3_ACCESS_KEY_MEDIA", "minioadmin"),
            s3_secret_key_media: env_or("S3_SECRET_KEY_MEDIA", "minioadmin"),
            s3_bucket_media: env_or("S3_BUCKET_MEDIA", "videos"),
            s3_region_media: env_or("S3_REGION_MEDIA", "us-east-1"),
            nats_url: env_or("NATS_URL", "nats://localhost:4222"),
        }
    }
}

fn env_or(key: &str, default: &str) -> String {
    std::env::var(key).unwrap_or_else(|_| default.to_owned())
}
