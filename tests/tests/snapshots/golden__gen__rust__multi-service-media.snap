docker-compose.yml
============================================================
services:
  app:
    build: .
    ports:
      - "8000:8000"
    environment:
      S3_ENDPOINT_MEDIA: http://minio-media:9000
      SMTP_HOST_TRANSACTIONAL: mailpit-transactional
      NATS_URL: nats://queue:4222
    depends_on:
      - minio-media
      - mailpit-transactional
      - queue

  workers:
    build: .
    command: ["workers"]
    environment:
      S3_ENDPOINT_MEDIA: http://minio-media:9000
      SMTP_HOST_TRANSACTIONAL: mailpit-transactional
      NATS_URL: nats://queue:4222
    depends_on:
      - minio-media
      - mailpit-transactional
      - queue

  minio-media:
    image: minio/minio
    command: ["server", "/data"]
    environment:
      MINIO_ROOT_USER: minioadmin
      MINIO_ROOT_PASSWORD: minioadmin
    volumes:
      - minio-media-data:/data

  mailpit-transactional:
    image: axllent/mailpit
    ports:
      - "8025:8025"

  queue:
    image: nats:2

volumes:
  minio-media-data:
