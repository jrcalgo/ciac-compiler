//! Shared application state. Generated by CIaC.

use crate::config::Config;

#[derive(Debug, Clone)]
pub struct AppState {
    pub config: Config,
    /// JWKS fetched from the issuer at startup; `Claims` selects the
    /// key matching each token's `kid`.
    pub jwks: jsonwebtoken::jwk::JwkSet,
}

impl AppState {
    pub async fn new(config: Config) -> anyhow::Result<Self> {
        let jwks: jsonwebtoken::jwk::JwkSet = reqwest::get(format!(
            "{}/.well-known/jwks.json",
            config.oauth_issuer.trim_end_matches('/')
        ))
        .await?
        .json()
        .await?;
        Ok(Self {
            config,
            jwks,
        })
    }
}
