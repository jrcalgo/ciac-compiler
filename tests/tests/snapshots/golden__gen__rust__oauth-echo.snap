xmTRuTT0qkAdhLkHLGzOOwXBlKYaqSMwPZZDnTQZO2bVeINMaJpTB5J6vv7NPQfX
O0ps90P6BUiBP/F6UJp7ma7EkYo1z3vmkvO2ZAeKJ7GVgh0de29vvQaZLYXQnv2o
ptcYx2jaTZ0TS/+yu11reNM=
-----END PRIVATE KEY-----
"#;

static ENV_GUARD: std::sync::Mutex<()> = std::sync::Mutex::new(());

async fn jwks_json() -> axum::Json<serde_json::Value> {
    axum::Json(serde_json::json!({
        "keys": [{
            "kty": "RSA",
            "kid": TEST_KID,
            "use": "sig",
            "alg": "RS256",
            "n": TEST_JWK_N,
            "e": TEST_JWK_E,
        }]
    }))
}

/// Starts a fresh JWKS stub on an ephemeral port and returns its base
/// URL. One stub per test (matching this file's own per-test `app()`
/// pattern below) -- cheap, and it keeps each test's issuer/port
/// combination unambiguous.
async fn start_jwks_stub() -> String {
    let router = axum::Router::new().route("/.well-known/jwks.json", get(jwks_json));
    let listener = tokio::net::TcpListener::bind("127.0.0.1:0")
        .await
        .expect("bind ephemeral port");
    let addr = listener.local_addr().expect("local addr");
    tokio::spawn(async move {
        let _ = axum::serve(listener, router).await;
    });
    format!("http://{addr}")
}

/// Builds a fresh app pointed at a fresh JWKS stub, returning the
/// router *and* the issuer it was actually built with -- callers mint
/// tokens against this returned issuer, not the example's statically
/// declared one, which `OAUTH_ISSUER` below overrides.
///
/// `OAUTH_ISSUER` is a process-global env var, and `cargo test` runs
/// this file's `#[tokio::test]` functions concurrently on shared
/// threads -- so the set-env-var/read-config pair is held under
/// `ENV_GUARD` and the lock is dropped *before* `AppState::new` runs.
/// `Config::from_env` already copies `oauth_issuer` into an owned
/// `String`, and `AppState::new` copies it again into `Jwks`'s own
/// owned field, so once this function returns, this app's issuer is
/// fixed regardless of what any other concurrently-running test does
/// to the env var next.
async fn app() -> (axum::Router, String) {
    let issuer = start_jwks_stub().await;
    let config = {
        let _guard = ENV_GUARD.lock().expect("env guard poisoned");
        std::env::set_var("OAUTH_ISSUER", &issuer);
        Config::from_env()
    };
    let state = AppState::new(config)
        .await
        .expect("lazy state construction needs no live infra");
    (routes::router().with_state(state), issuer)
}

fn unix_time(delta_secs: i64) -> i64 {
    let now = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .expect("system clock")
        .as_secs() as i64;
    now + delta_secs
}

struct MintOpts<'a> {
    scope: &'a str,
    key_pem: &'a str,
    kid: &'a str,
    issuer: &'a str,
    exp_delta: i64,
}

fn mint(opts: MintOpts<'_>) -> String {
    let claims = serde_json::json!({
        "sub": "test",
        "scope": opts.scope,
        "iss": opts.issuer,
        "exp": unix_time(opts.exp_delta),
    });
    let key = jsonwebtoken::EncodingKey::from_rsa_pem(opts.key_pem.as_bytes())
        .expect("parse embedded test key");
    let header = jsonwebtoken::Header {
        kid: Some(opts.kid.to_string()),
        alg: jsonwebtoken::Algorithm::RS256,
        ..Default::default()
    };
    jsonwebtoken::encode(&header, &claims, &key).expect("token encodes")
}

fn bearer(issuer: &str, scope: &str) -> String {
    format!(
        "Bearer {}",
        mint(MintOpts {
            scope,
            key_pem: TEST_PRIVATE_KEY_PEM,
            kid: TEST_KID,
            issuer,
            exp_delta: 3600,
        })
    )
}

#[tokio::test]
async fn echo_wrong_scope() {
    let (router, issuer) = app().await;
    let response = router
        .oneshot(
            Request::builder()
                .method("POST")
                .uri("/echo")
                .header("Authorization", bearer(&issuer, "not:echo:write"))
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{
"id":"00000000-0000-0000-0000-000000000000",
"text":"x"
}"#))
                .unwrap(),
        )
        .await
        .unwrap();
    assert_eq!(response.status(), StatusCode::FORBIDDEN);
}

#[tokio::test]
async fn echo_correct_scope() {
    let (router, issuer) = app().await;
    let response = router
        .oneshot(
            Request::builder()
                .method("POST")
                .uri("/echo")
                .header("Authorization", bearer(&issuer, "echo:write"))
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{
"id":"00000000-0000-0000-0000-000000000000",
"text":"x"
}"#))
                .unwrap(),
        )
        .await
        .unwrap();
    assert_ne!(response.status(), StatusCode::UNAUTHORIZED);
    assert_ne!(response.status(), StatusCode::FORBIDDEN);
}

#[tokio::test]
async fn echo_expired_token() {
    let (router, issuer) = app().await;
    let token = mint(MintOpts {
        scope: "echo:write",
        key_pem: TEST_PRIVATE_KEY_PEM,
        kid: TEST_KID,
        issuer: &issuer,
        exp_delta: -3600,
    });
    let response = router
        .oneshot(
            Request::builder()
                .method("POST")
                .uri("/echo")
                .header("Authorization", format!("Bearer {token}"))
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{
"id":"00000000-0000-0000-0000-000000000000",
"text":"x"
}"#))
                .unwrap(),
        )
        .await
        .unwrap();
    assert_eq!(response.status(), StatusCode::UNAUTHORIZED);
}

#[tokio::test]
async fn echo_wrong_key() {
    // The crypto-boundary case the JWT suite cannot express as sharply:
    // a correctly-shaped, correctly-`kid`'d token signed by a key the
    // stub JWKS never served -- proof the signature check itself gates
    // the door.
    let (router, issuer) = app().await;
    let token = mint(MintOpts {
        scope: "echo:write",
        key_pem: WRONG_PRIVATE_KEY_PEM,
        kid: TEST_KID,
        issuer: &issuer,
        exp_delta: 3600,
    });
    let response = router
        .oneshot(
            Request::builder()
                .method("POST")
                .uri("/echo")
                .header("Authorization", format!("Bearer {token}"))
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{
"id":"00000000-0000-0000-0000-000000000000",
"text":"x"
}"#))
                .unwrap(),
        )
        .await
        .unwrap();
    assert_eq!(response.status(), StatusCode::UNAUTHORIZED);
}

#[tokio::test]
async fn echo_wrong_issuer() {
    let (router, _issuer) = app().await;
    let token = mint(MintOpts {
        scope: "echo:write",
        key_pem: TEST_PRIVATE_KEY_PEM,
        kid: TEST_KID,
        issuer: "http://wrong-issuer.example",
        exp_delta: 3600,
    });
    let response = router
        .oneshot(
            Request::builder()
                .method("POST")
                .uri("/echo")
                .header("Authorization", format!("Bearer {token}"))
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{
"id":"00000000-0000-0000-0000-000000000000",
"text":"x"
}"#))
                .unwrap(),
        )
        .await
        .unwrap();
    assert_eq!(response.status(), StatusCode::UNAUTHORIZED);
}

