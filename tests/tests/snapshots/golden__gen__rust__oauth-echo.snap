//! JWT authentication. Generated by CIaC.
//!
//! `Auth` pipeline steps become the [`Claims`] extractor: routes that take
//! a `Claims` argument reject requests without a valid bearer token.

use axum::extract::FromRequestParts;
use axum::http::header::AUTHORIZATION;
use axum::http::{request::Parts, StatusCode};
use jsonwebtoken::{Algorithm, DecodingKey, Validation};

use crate::error::AppError;
use crate::state::AppState;
/// The issuer's JWKS, fetched lazily on first use and cached --
/// mirroring the lazy db pools and broker client (v0.17 M11):
/// constructing `AppState` never makes a network call, so a route
/// that never checks a token never needs the issuer reachable.
#[derive(Clone)]
pub struct Jwks {
    issuer: String,
    set: std::sync::Arc<tokio::sync::OnceCell<jsonwebtoken::jwk::JwkSet>>,
}

impl std::fmt::Debug for Jwks {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("Jwks")
            .field("issuer", &self.issuer)
            .finish_non_exhaustive()
    }
}

impl Jwks {
    pub fn new(issuer: impl Into<String>) -> Self {
        Self {
            issuer: issuer.into(),
            set: Default::default(),
        }
    }

    async fn fetch(&self) -> anyhow::Result<jsonwebtoken::jwk::JwkSet> {
        let url = format!("{}/.well-known/jwks.json", self.issuer.trim_end_matches('/'));
        Ok(reqwest::get(url).await?.json().await?)
    }

    async fn get(&self) -> anyhow::Result<&jsonwebtoken::jwk::JwkSet> {
        self.set.get_or_try_init(|| self.fetch()).await
    }
}

/// Verified JWT claims of the current request.
#[derive(Debug, Clone)]
pub struct Claims(pub serde_json::Value);

impl Claims {
    /// The `sub` claim, if present.
    pub fn subject(&self) -> Option<&str> {
        self.0.get("sub").and_then(|v| v.as_str())
    }

    pub fn require_scope(&self, scope: &str) -> Result<(), AppError> {
        let has_scope = self
            .0
            .get("scope")
            .and_then(|value| value.as_str())
            .is_some_and(|scopes| scopes.split_whitespace().any(|item| item == scope))
            || self
                .0
                .get("scp")
                .and_then(|value| value.as_array())
                .is_some_and(|scopes| scopes.iter().any(|item| item.as_str() == Some(scope)));
        if has_scope {
            Ok(())
        } else {
            Err(AppError::forbidden())
        }
    }
}

impl FromRequestParts<AppState> for Claims {
    type Rejection = (StatusCode, &'static str);

    async fn from_request_parts(
        parts: &mut Parts,
        state: &AppState,
    ) -> Result<Self, Self::Rejection> {
        let token = parts
            .headers
            .get(AUTHORIZATION)
            .and_then(|value| value.to_str().ok())
            .and_then(|value| value.strip_prefix("Bearer "))
            .ok_or((StatusCode::UNAUTHORIZED, "missing bearer token"))?;
        let header = jsonwebtoken::decode_header(token)
            .map_err(|_| (StatusCode::UNAUTHORIZED, "malformed token"))?;
        let jwks = state
            .jwks
            .get()
            .await
            .map_err(|_| (StatusCode::UNAUTHORIZED, "jwks unavailable"))?;
        let jwk = header
            .kid
            .as_deref()
            .and_then(|kid| jwks.find(kid))
            .or_else(|| jwks.keys.first())
            .ok_or((StatusCode::UNAUTHORIZED, "no signing key for this token"))?;
        let key = DecodingKey::from_jwk(jwk)
            .map_err(|_| (StatusCode::UNAUTHORIZED, "unusable signing key"))?;
        let mut validation = Validation::new(Algorithm::RS256);
        validation.set_issuer(&[state.config.oauth_issuer.as_str()]);
        if state.config.oauth_audience.is_empty() {
            validation.validate_aud = false;
        } else {
            validation.set_audience(&[state.config.oauth_audience.as_str()]);
        }
        let data = jsonwebtoken::decode::<serde_json::Value>(token, &key, &validation)
            .map_err(|_| (StatusCode::UNAUTHORIZED, "invalid or expired token"))?;
        Ok(Claims(data.claims))
    }
}
