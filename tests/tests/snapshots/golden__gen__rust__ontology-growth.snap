docker-compose.yml
============================================================
services:
  app:
    build: .
    ports:
      - "8000:8000"
    environment:
      DATABASE_URL: postgres://postgres:postgres@db:5432/media_ops
      REDIS_URL: redis://cache:6379/0
      NATS_URL: nats://queue:4222
    depends_on:
      - db
      - cache
      - queue

  workers:
    build: .
    command: ["workers"]
    environment:
      DATABASE_URL: postgres://postgres:postgres@db:5432/media_ops
      REDIS_URL: redis://cache:6379/0
      NATS_URL: nats://queue:4222
    depends_on:
      - db
      - cache
      - queue

  db:
    image: postgres:16
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: media_ops
    volumes:
      - db-data:/var/lib/postgresql/data

  cache:
    image: redis:7

  queue:
    image: nats:2

volumes:
  db-data:
