//! Shared application state. Generated by CIaC.

use crate::config::Config;

#[derive(Debug, Clone)]
pub struct AppState {
    pub config: Config,
    /// Lazy pool: connections are established on first use, so the server
    /// starts (and compiles) without a running database.
    pub db_main: sqlx::PgPool,
    /// Lazy pool: connections are established on first use, so the server
    /// starts (and compiles) without a running database.
    pub db_analytics: sqlx::PgPool,
    pub cache_hot: redis::Client,
    pub object_store_media: crate::object_store::ObjectStore,
    pub email_transactional: crate::email::Email,
    pub search_catalog: crate::search::Search,
    pub http_billing: crate::http_clients::ExternalHttp,
    pub queue: crate::queue::Queue,
}

impl AppState {
    pub async fn new(config: Config) -> anyhow::Result<Self> {
        let db_main =
            sqlx::postgres::PgPoolOptions::new().connect_lazy(&config.database_url_main)?;
        let db_analytics =
            sqlx::postgres::PgPoolOptions::new().connect_lazy(&config.database_url_analytics)?;
        let cache_hot = redis::Client::open(config.redis_url_hot.as_str())?;
        let object_store_media = crate::object_store::ObjectStore {
            endpoint: config.s3_endpoint_media.clone(),
            access_key: config.s3_access_key_media.clone(),
            secret_key: config.s3_secret_key_media.clone(),
            bucket: config.s3_bucket_media.clone(),
            region: config.s3_region_media.clone(),
        };
        let email_transactional = crate::email::Email {
            host: config.smtp_host_transactional.clone(),
            port: config.smtp_port_transactional.clone(),
            username: config.smtp_username_transactional.clone(),
            password: config.smtp_password_transactional.clone(),
            sender: config.smtp_from_transactional.clone(),
            use_tls: config.smtp_use_tls_transactional.clone(),
        };
        let search_catalog = crate::search::Search {
            url: config.search_url_catalog.clone(),
        };
        let http_billing =
            crate::http_clients::ExternalHttp::new(config.http_base_url_billing.clone());
        // Lazy: no broker connection happens here (v0.17 M11) -- the
        // first publish/subscribe call connects and caches the client.
        let queue = crate::queue::Queue::new(&config.nats_url);
        Ok(Self {
            config,
            db_main,
            db_analytics,
            cache_hot,
            object_store_media,
            email_transactional,
            search_catalog,
            http_billing,
            queue,
        })
    }
}
