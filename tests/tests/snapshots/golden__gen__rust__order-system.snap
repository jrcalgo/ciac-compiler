src/bin/workers.rs
============================================================
//! Runs every worker in one process. Generated by CIaC.

use order_system::{config::Config, state::AppState, workers};

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    order_system::observability::init();
    let config = Config::from_env();
    let state = AppState::new(config).await?;
    tokio::try_join!(
        workers::order_event_sink::run(state.clone()),
    )?;
    Ok(())
}
