//! Handler for the `CheckLimitOrder` typed handler. Generated by CIaC.
//!
//! Compiler-owned: lowered from the source `handler CheckLimitOrder(..) { .. }` body
//! on every build. Business logic lives in the `.ciac` source, not here.
use crate::state::AppState;
use crate::schemas::{ Order, TicketOrder, TooManyRequestsOrder };
#[derive(Debug)]
pub struct CheckLimitOrder<'a> {
    pub db: &'a sqlx::PgPool,
}

impl<'a> CheckLimitOrder<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            db: &state.db,
        }
    }

    // An unused `let` is a warning in the source language (`CIAC0045`),
    // not an error — a well-typed handler body can bind a value it
    // never reads. Rust's own `unused_variables` lint disagrees, so it's
    // allowed here rather than promoted to a hard failure by `-D warnings`.
    #[allow(unused_variables)]
    pub async fn handle(&self, payload: Order) -> anyhow::Result<Order> {
let v1 = {
    let __count: i64 = sqlx::query_scalar("SELECT COUNT(*) FROM tickets_order")
        .fetch_one(self.db)
        .await?;
    __count
};
if v1 >= 1000 {
    return Err(TooManyRequestsOrder { limit: 1000 }.into());
} else {
    ()
};
{
    let __row = TicketOrder { id: uuid::Uuid::new_v4().to_string() }.clone();
    sqlx::query("INSERT INTO tickets_order (id) VALUES ($1)")
        .bind(&__row.id)
        .execute(self.db)
        .await?;
    __row
};
return Ok(payload);
    }
}
