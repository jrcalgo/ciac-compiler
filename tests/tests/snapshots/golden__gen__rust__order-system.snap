//! REST endpoints for the `Customer` resource. Generated by CIaC.

use axum::extract::{Path, Query, State};
use axum::http::StatusCode;
use axum::routing::{delete, get, post, put};
use axum::{Json, Router};

use crate::auth::Claims;
use crate::error::AppError;
use crate::models::{Customer, CustomerIn};
use crate::services::customer_store::CustomerStore;
use crate::state::AppState;

#[derive(Debug, serde::Deserialize)]
struct ListQuery {
    limit: Option<i64>,
    offset: Option<i64>,
}

pub fn router() -> Router<AppState> {
    Router::new()
        .route("/customers", post(create_customer))
        .route("/customers", get(list_customers))
        .route("/customers/{id}", get(get_customer))
        .route("/customers/{id}", put(update_customer))
        .route("/customers/{id}", delete(delete_customer))
}

async fn create_customer(
    State(state): State<AppState>,
    claims: Claims,
    Json(payload): Json<CustomerIn>,
) -> Result<(StatusCode, Json<Customer>), AppError> {
    claims.require_scope("customers:write")?;
    let entity = CustomerStore::new(&state).create(payload).await?;
    Ok((StatusCode::CREATED, Json(entity)))
}

async fn list_customers(
    State(state): State<AppState>,
    claims: Claims,
    Query(query): Query<ListQuery>,
) -> Result<Json<Vec<Customer>>, AppError> {
    claims.require_scope("customers:read")?;
    let entities = CustomerStore::new(&state)
        .list(query.limit.unwrap_or(50), query.offset.unwrap_or(0))
        .await?;
    Ok(Json(entities))
}

async fn get_customer(
    State(state): State<AppState>,
    claims: Claims,
    Path(id): Path<String>,
) -> Result<Json<Customer>, AppError> {
    claims.require_scope("customers:read")?;
    match CustomerStore::new(&state).get(&id).await? {
        Some(entity) => Ok(Json(entity)),
        None => Err(AppError::not_found()),
    }
}

async fn update_customer(
    State(state): State<AppState>,
    claims: Claims,
    Path(id): Path<String>,
    Json(payload): Json<CustomerIn>,
) -> Result<Json<Customer>, AppError> {
    claims.require_scope("customers:write")?;
    match CustomerStore::new(&state).update(&id, payload).await? {
        Some(entity) => Ok(Json(entity)),
        None => Err(AppError::not_found()),
    }
}

async fn delete_customer(
    State(state): State<AppState>,
    claims: Claims,
    Path(id): Path<String>,
) -> Result<StatusCode, AppError> {
    claims.require_scope("customers:write")?;
    if CustomerStore::new(&state).delete(&id).await? {
        Ok(StatusCode::NO_CONTENT)
    } else {
        Err(AppError::not_found())
    }
}
