//! Persistence for the `Customer` resource. Generated by CIaC.

use redis::AsyncCommands;

use crate::models::{Customer, CustomerIn};
use crate::state::AppState;
/// CRUD operations for Customer with read-through caching.
#[derive(Debug)]
pub struct CustomerStore<'a> {
    pub db: &'a sqlx::PgPool,
    pub cache: &'a redis::Client,
}

impl<'a> CustomerStore<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            db: &state.db,
            cache: &state.cache,
        }
    }


    pub async fn create(&self, payload: CustomerIn) -> anyhow::Result<Customer> {
        let entity = Customer {
            id: uuid::Uuid::new_v4().to_string(),
            name: payload.name,
            email: payload.email,
        };
        sqlx::query(
            "INSERT INTO customers (id, name, email) VALUES ($1, $2, $3)",
        )
        .bind(&entity.id)
        .bind(&entity.name)
        .bind(&entity.email)
        .execute(self.db)
        .await?;
        Ok(entity)
    }

    pub async fn get(&self, id: &str) -> anyhow::Result<Option<Customer>> {
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        if let Some(cached) = cache.get::<_, Option<String>>(cache_key(id)).await? {
            return Ok(Some(serde_json::from_str(&cached)?));
        }
        let entity: Option<Customer> =
            sqlx::query_as("SELECT id, name, email FROM customers WHERE id = $1")
                .bind(id)
                .fetch_optional(self.db)
                .await?;
        if let Some(entity) = &entity {
            let _: () = cache
                .set_ex(cache_key(id), serde_json::to_string(entity)?, 30)
                .await?;
        }
        Ok(entity)
    }

    pub async fn list(&self, limit: i64, offset: i64) -> anyhow::Result<Vec<Customer>> {
        let entities =
            sqlx::query_as("SELECT id, name, email FROM customers ORDER BY id LIMIT $1 OFFSET $2")
                .bind(limit)
                .bind(offset)
                .fetch_all(self.db)
                .await?;
        Ok(entities)
    }

    pub async fn update(
        &self,
        id: &str,
        payload: CustomerIn,
    ) -> anyhow::Result<Option<Customer>> {
        let entity = Customer {
            id: id.to_owned(),
            name: payload.name,
            email: payload.email,
        };
        let updated = sqlx::query(
            "UPDATE customers SET name = $1, email = $2 WHERE id = $3",
        )
        .bind(&entity.name)
        .bind(&entity.email)
        .bind(id)
        .execute(self.db)
        .await?;
        if updated.rows_affected() == 0 {
            return Ok(None);
        }
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        let _: () = cache.del(cache_key(id)).await?;
        Ok(Some(entity))
    }

    pub async fn delete(&self, id: &str) -> anyhow::Result<bool> {
        let deleted = sqlx::query("DELETE FROM customers WHERE id = $1")
            .bind(id)
            .execute(self.db)
            .await?;
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        let _: () = cache.del(cache_key(id)).await?;
        Ok(deleted.rows_affected() > 0)
    }
}

fn cache_key(id: &str) -> String {
    format!("customers:{id}")
}

