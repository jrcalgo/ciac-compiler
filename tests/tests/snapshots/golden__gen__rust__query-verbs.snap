}

async fn replace_api(
    State(state): State<AppState>,
    Json(payload): Json<NoteUpdate>,
) -> Result<Json<serde_json::Value>, AppError> {
    let result = payload;

    let result = Replace::new(&state).handle(result).await?;
    Ok(Json(serde_json::json!({"status": "accepted", "data": result})))
}
