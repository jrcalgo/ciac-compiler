//! Shared application state. Generated by CIaC.

use crate::config::Config;

#[derive(Debug, Clone)]
pub struct AppState {
    pub config: Config,
    /// Lazy pool: connections are established on first use, so the server
    /// starts (and compiles) without a running database.
    pub db: sqlx::SqlitePool,
}

impl AppState {
    pub async fn new(config: Config) -> anyhow::Result<Self> {
        // The database is a local file; make sure its directory
        // exists before the pool touches it (`?mode=rwc` creates the
        // file itself).
        std::fs::create_dir_all("data")?;
        let db =
            sqlx::sqlite::SqlitePoolOptions::new().connect_lazy(&config.database_url)?;
        Ok(Self {
            config,
            db,
        })
    }
}
