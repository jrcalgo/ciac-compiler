services:
  app:
    build: .
    ports:
      - "8000:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      DATABASE_URL: sqlite://data/query_verbs.db?mode=rwc
    depends_on:
    volumes:
      - app-data:/data

volumes:
  app-data:
