//! Request pipeline for `api Complete`. Generated by CIaC.
//!
//! Pipeline: publish progress_feed.transcoded -> Return


use axum::extract::State;
use axum::routing::post;
use axum::{Json, Router};

use crate::error::AppError;
use crate::schemas::Video;
use crate::state::AppState;

pub fn router() -> Router<AppState> {
    Router::new().route("/complete", post(complete))
}

async fn complete(
    State(state): State<AppState>,
    Json(payload): Json<Video>,
) -> Result<Json<serde_json::Value>, AppError> {
    let result = payload;

    state
        .queue
        .publish("progress_feed.transcoded", serde_json::to_vec(&result)?)
        .await?;
    Ok(Json(serde_json::json!({"status": "accepted", "data": result})))
}
