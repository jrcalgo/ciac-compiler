//! Persistence for the `Clip` resource. Generated by CIaC.

use redis::AsyncCommands;

use crate::models::{Clip, ClipIn};
use crate::state::AppState;
/// CRUD operations for Clip with read-through caching.
#[derive(Debug)]
pub struct ClipStore<'a> {
    pub db: &'a sqlx::PgPool,
    pub cache: &'a redis::Client,
}

impl<'a> ClipStore<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            db: &state.db,
            cache: &state.cache,
        }
    }


    pub async fn create(&self, payload: ClipIn) -> anyhow::Result<Clip> {
        let entity = Clip {
            id: uuid::Uuid::new_v4().to_string(),
            title: payload.title,
            status: payload.status.as_str().to_owned(),
        };
        sqlx::query(
            "INSERT INTO clips (id, title, status) VALUES ($1, $2, $3)",
        )
        .bind(&entity.id)
        .bind(&entity.title)
        .bind(&entity.status)
        .execute(self.db)
        .await?;
        Ok(entity)
    }

    pub async fn get(&self, id: &str) -> anyhow::Result<Option<Clip>> {
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        if let Some(cached) = cache.get::<_, Option<String>>(cache_key(id)).await? {
            return Ok(Some(serde_json::from_str(&cached)?));
        }
        let entity: Option<Clip> =
            sqlx::query_as("SELECT id, title, status FROM clips WHERE id = $1")
                .bind(id)
                .fetch_optional(self.db)
                .await?;
        if let Some(entity) = &entity {
            let _: () = cache
                .set_ex(cache_key(id), serde_json::to_string(entity)?, 60)
                .await?;
        }
        Ok(entity)
    }

    pub async fn list(&self, limit: i64, offset: i64) -> anyhow::Result<Vec<Clip>> {
        let entities =
            sqlx::query_as("SELECT id, title, status FROM clips ORDER BY id LIMIT $1 OFFSET $2")
                .bind(limit)
                .bind(offset)
                .fetch_all(self.db)
                .await?;
        Ok(entities)
    }

    pub async fn update(
        &self,
        id: &str,
        payload: ClipIn,
    ) -> anyhow::Result<Option<Clip>> {
        let entity = Clip {
            id: id.to_owned(),
            title: payload.title,
            status: payload.status.as_str().to_owned(),
        };
        let updated = sqlx::query(
            "UPDATE clips SET title = $1, status = $2 WHERE id = $3",
        )
        .bind(&entity.title)
        .bind(&entity.status)
        .bind(id)
        .execute(self.db)
        .await?;
        if updated.rows_affected() == 0 {
            return Ok(None);
        }
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        let _: () = cache.del(cache_key(id)).await?;
        Ok(Some(entity))
    }

    pub async fn delete(&self, id: &str) -> anyhow::Result<bool> {
        let deleted = sqlx::query("DELETE FROM clips WHERE id = $1")
            .bind(id)
            .execute(self.db)
            .await?;
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        let _: () = cache.del(cache_key(id)).await?;
        Ok(deleted.rows_affected() > 0)
    }
}

fn cache_key(id: &str) -> String {
    format!("clips:{id}")
}

