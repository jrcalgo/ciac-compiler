//! REST endpoints for the `Clip` resource. Generated by CIaC.

use axum::extract::{Path, Query, State};
use axum::http::StatusCode;
use axum::routing::{delete, get, post, put};
use axum::{Json, Router};

use crate::auth::Claims;
use crate::error::AppError;
use crate::models::{Clip, ClipIn};
use crate::services::clip_store::ClipStore;
use crate::state::AppState;

#[derive(Debug, serde::Deserialize)]
struct ListQuery {
    limit: Option<i64>,
    offset: Option<i64>,
}

pub fn router() -> Router<AppState> {
    Router::new()
        .route("/clips", post(create_clip))
        .route("/clips", get(list_clips))
        .route("/clips/{id}", get(get_clip))
        .route("/clips/{id}", put(update_clip))
        .route("/clips/{id}", delete(delete_clip))
}

async fn create_clip(
    State(state): State<AppState>,
    _claims: Claims,
    Json(payload): Json<ClipIn>,
) -> Result<(StatusCode, Json<Clip>), AppError> {
    let entity = ClipStore::new(&state).create(payload).await?;
    Ok((StatusCode::CREATED, Json(entity)))
}

async fn list_clips(
    State(state): State<AppState>,
    _claims: Claims,
    Query(query): Query<ListQuery>,
) -> Result<Json<Vec<Clip>>, AppError> {
    let entities = ClipStore::new(&state)
        .list(query.limit.unwrap_or(50), query.offset.unwrap_or(0))
        .await?;
    Ok(Json(entities))
}

async fn get_clip(
    State(state): State<AppState>,
    _claims: Claims,
    Path(id): Path<String>,
) -> Result<Json<Clip>, AppError> {
    match ClipStore::new(&state).get(&id).await? {
        Some(entity) => Ok(Json(entity)),
        None => Err(AppError::not_found()),
    }
}

async fn update_clip(
    State(state): State<AppState>,
    _claims: Claims,
    Path(id): Path<String>,
    Json(payload): Json<ClipIn>,
) -> Result<Json<Clip>, AppError> {
    match ClipStore::new(&state).update(&id, payload).await? {
        Some(entity) => Ok(Json(entity)),
        None => Err(AppError::not_found()),
    }
}

async fn delete_clip(
    State(state): State<AppState>,
    _claims: Claims,
    Path(id): Path<String>,
) -> Result<StatusCode, AppError> {
    if ClipStore::new(&state).delete(&id).await? {
        Ok(StatusCode::NO_CONTENT)
    } else {
        Err(AppError::not_found())
    }
}
