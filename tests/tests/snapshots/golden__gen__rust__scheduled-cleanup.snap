//! Runs every worker in one process. Generated by CIaC.

use maintenance::{config::Config, state::AppState, workers};

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    maintenance::observability::init();
    let config = Config::from_env();
    let state = AppState::new(config).await?;
    tokio::try_join!(
        workers::cleanup::run(state.clone()),
    )?;
    Ok(())
}
