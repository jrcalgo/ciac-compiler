//! Request pipeline for `api EmitApi`. Generated by CIaC.
//!
//! Pipeline: Emit -> publish sim_broker_slice.pings -> Return


use axum::extract::State;
use axum::routing::post;
use axum::{Json, Router};

use crate::error::AppError;
use crate::schemas::Ping;
use crate::logic::emit::Emit;
use crate::state::AppState;

pub fn router() -> Router<AppState> {
    Router::new().route("/pings", post(emit_api))
}

async fn emit_api(
    State(state): State<AppState>,
    Json(payload): Json<Ping>,
) -> Result<Json<serde_json::Value>, AppError> {
    let result = payload;

    let result = Emit::new(&state).handle(result).await?;
    state
        .queue
        .publish("sim_broker_slice.pings", serde_json::to_vec(&result)?)
        .await?;
    Ok(Json(serde_json::json!({"status": "accepted", "data": result})))
}
