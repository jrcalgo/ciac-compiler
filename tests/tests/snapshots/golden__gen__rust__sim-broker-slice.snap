src/bin/workers.rs
============================================================
//! Runs every worker in one process. Generated by CIaC.

use sim_broker_slice::{config::Config, state::AppState, workers};

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    sim_broker_slice::observability::init();
    let config = Config::from_env();
    let state = AppState::new(config).await?;
    tokio::try_join!(
        workers::consumer_a::run(state.clone()),
        workers::consumer_b::run(state.clone()),
    )?;
    Ok(())
}
