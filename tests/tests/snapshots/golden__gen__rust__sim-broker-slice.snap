//! REST endpoints for the `Widget` resource. Generated by CIaC.

use axum::extract::{Path, Query, State};
use axum::http::StatusCode;
use axum::routing::{delete, get, post, put};
use axum::{Json, Router};

use crate::error::AppError;
use crate::models::{Widget, WidgetIn};
use crate::services::widget_store::WidgetStore;
use crate::state::AppState;

#[derive(Debug, serde::Deserialize)]
struct ListQuery {
    limit: Option<i64>,
    offset: Option<i64>,
}

pub fn router() -> Router<AppState> {
    Router::new()
        .route("/widgets", post(create_widget))
        .route("/widgets", get(list_widgets))
        .route("/widgets/{id}", get(get_widget))
        .route("/widgets/{id}", put(update_widget))
        .route("/widgets/{id}", delete(delete_widget))
}

async fn create_widget(
    State(state): State<AppState>,
    Json(payload): Json<WidgetIn>,
) -> Result<(StatusCode, Json<Widget>), AppError> {
    let entity = WidgetStore::new(&state).create(payload).await?;
    Ok((StatusCode::CREATED, Json(entity)))
}

async fn list_widgets(
    State(state): State<AppState>,
    Query(query): Query<ListQuery>,
) -> Result<Json<Vec<Widget>>, AppError> {
    let entities = WidgetStore::new(&state)
        .list(query.limit.unwrap_or(100), query.offset.unwrap_or(0))
        .await?;
    Ok(Json(entities))
}

async fn get_widget(
    State(state): State<AppState>,
    Path(id): Path<String>,
) -> Result<Json<Widget>, AppError> {
    match WidgetStore::new(&state).get(&id).await? {
        Some(entity) => Ok(Json(entity)),
        None => Err(AppError::not_found()),
    }
}

async fn update_widget(
    State(state): State<AppState>,
    Path(id): Path<String>,
    Json(payload): Json<WidgetIn>,
) -> Result<Json<Widget>, AppError> {
    match WidgetStore::new(&state).update(&id, payload).await? {
        Some(entity) => Ok(Json(entity)),
        None => Err(AppError::not_found()),
    }
}

async fn delete_widget(
    State(state): State<AppState>,
    Path(id): Path<String>,
) -> Result<StatusCode, AppError> {
    if WidgetStore::new(&state).delete(&id).await? {
        Ok(StatusCode::NO_CONTENT)
    } else {
        Err(AppError::not_found())
    }
}
