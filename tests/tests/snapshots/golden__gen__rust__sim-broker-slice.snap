//! Persistence models and API schemas for CRUD resources and `table`
//! declarations. Generated by CIaC.
//!
//! Typed resources (`crud X: Record;`) get real columns from their record;
//! untyped ones keep a generic keyed-document model (UUID key + JSON
//! payload). `table <Name>: <Record>;` declarations (v0.7) get the same
//! column treatment, named after the table so a record reused under
//! several table names doesn't collide. Enums are stored as text.

use serde::{Deserialize, Serialize};

use crate::schemas::ProcessedByA;

use crate::schemas::ProcessedByB;

#[derive(Debug, Clone, Serialize, Deserialize, sqlx::FromRow)]
pub struct Widget {
    pub id: String,
    pub name: String,
}

/// Payload for creating or updating a Widget; the `id` is
/// server-generated.
#[derive(Debug, Clone, Deserialize)]
pub struct WidgetIn {
    pub name: String,
}


#[derive(Debug, Clone, Serialize, Deserialize, sqlx::FromRow)]
pub struct ProcessedByATable {
    pub id: String,
    pub ping_id: String,
    pub seq: i64,
}

impl TryFrom<ProcessedByATable> for ProcessedByA {
    type Error = anyhow::Error;

    fn try_from(row: ProcessedByATable) -> anyhow::Result<Self> {
        Ok(ProcessedByA {
            id: row.id,
            ping_id: row.ping_id,
            seq: row.seq,
        })
    }
}


#[derive(Debug, Clone, Serialize, Deserialize, sqlx::FromRow)]
pub struct ProcessedByBTable {
    pub id: String,
    pub ping_id: String,
    pub seq: i64,
}

impl TryFrom<ProcessedByBTable> for ProcessedByB {
    type Error = anyhow::Error;

    fn try_from(row: ProcessedByBTable) -> anyhow::Result<Self> {
        Ok(ProcessedByB {
            id: row.id,
            ping_id: row.ping_id,
            seq: row.seq,
        })
    }
}

