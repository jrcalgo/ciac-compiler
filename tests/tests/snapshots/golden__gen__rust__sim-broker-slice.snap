//! Persistence for the `Widget` resource. Generated by CIaC.

use redis::AsyncCommands;

use crate::models::{Widget, WidgetIn};
use crate::state::AppState;
/// CRUD operations for Widget with read-through caching.
#[derive(Debug)]
pub struct WidgetStore<'a> {
    pub db: &'a sqlx::PgPool,
    pub cache: &'a redis::Client,
}

impl<'a> WidgetStore<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            db: &state.db,
            cache: &state.cache,
        }
    }


    pub async fn create(&self, payload: WidgetIn) -> anyhow::Result<Widget> {
        let entity = Widget {
            id: uuid::Uuid::new_v4().to_string(),
            name: payload.name,
        };
        sqlx::query(
            "INSERT INTO widgets (id, name) VALUES ($1, $2)",
        )
        .bind(&entity.id)
        .bind(&entity.name)
        .execute(self.db)
        .await?;
        Ok(entity)
    }

    pub async fn get(&self, id: &str) -> anyhow::Result<Option<Widget>> {
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        if let Some(cached) = cache.get::<_, Option<String>>(cache_key(id)).await? {
            return Ok(Some(serde_json::from_str(&cached)?));
        }
        let entity: Option<Widget> =
            sqlx::query_as("SELECT id, name FROM widgets WHERE id = $1")
                .bind(id)
                .fetch_optional(self.db)
                .await?;
        if let Some(entity) = &entity {
            let _: () = cache
                .set_ex(cache_key(id), serde_json::to_string(entity)?, 30)
                .await?;
        }
        Ok(entity)
    }

    pub async fn list(&self, limit: i64, offset: i64) -> anyhow::Result<Vec<Widget>> {
        let entities =
            sqlx::query_as("SELECT id, name FROM widgets ORDER BY id LIMIT $1 OFFSET $2")
                .bind(limit)
                .bind(offset)
                .fetch_all(self.db)
                .await?;
        Ok(entities)
    }

    pub async fn update(
        &self,
        id: &str,
        payload: WidgetIn,
    ) -> anyhow::Result<Option<Widget>> {
        let entity = Widget {
            id: id.to_owned(),
            name: payload.name,
        };
        let updated = sqlx::query(
            "UPDATE widgets SET name = $1 WHERE id = $2",
        )
        .bind(&entity.name)
        .bind(id)
        .execute(self.db)
        .await?;
        if updated.rows_affected() == 0 {
            return Ok(None);
        }
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        let _: () = cache.del(cache_key(id)).await?;
        Ok(Some(entity))
    }

    pub async fn delete(&self, id: &str) -> anyhow::Result<bool> {
        let deleted = sqlx::query("DELETE FROM widgets WHERE id = $1")
            .bind(id)
            .execute(self.db)
            .await?;
        let mut cache = self.cache.get_multiplexed_async_connection().await?;
        let _: () = cache.del(cache_key(id)).await?;
        Ok(deleted.rows_affected() > 0)
    }
}

fn cache_key(id: &str) -> String {
    format!("widgets:{id}")
}

