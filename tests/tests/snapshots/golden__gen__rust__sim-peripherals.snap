Dockerfile
============================================================
FROM rust:1-slim AS build

WORKDIR /src
COPY . .
RUN cargo build --release

FROM debian:stable-slim

COPY --from=build /src/target/release/sim-peripherals /usr/local/bin/app

EXPOSE 8000
CMD ["app"]
