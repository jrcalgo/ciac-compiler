//! Shared application state. Generated by CIaC.

use crate::config::Config;

#[derive(Debug, Clone)]
pub struct AppState {
    pub config: Config,
    pub cache: redis::Client,
    pub object_store: crate::object_store::ObjectStore,
    pub email: crate::email::Email,
    pub search: crate::search::Search,
    pub http_upstream: crate::http_clients::ExternalHttp,
}

impl AppState {
    pub async fn new(config: Config) -> anyhow::Result<Self> {
        let cache = redis::Client::open(config.redis_url.as_str())?;
        let object_store = crate::object_store::ObjectStore {
            endpoint: config.s3_endpoint.clone(),
            access_key: config.s3_access_key.clone(),
            secret_key: config.s3_secret_key.clone(),
            bucket: config.s3_bucket.clone(),
            region: config.s3_region.clone(),
        };
        let email = crate::email::Email {
            host: config.smtp_host.clone(),
            port: config.smtp_port.clone(),
            username: config.smtp_username.clone(),
            password: config.smtp_password.clone(),
            sender: config.smtp_from.clone(),
            use_tls: config.smtp_use_tls.clone(),
        };
        let search = crate::search::Search {
            url: config.search_url.clone(),
        };
        let http_upstream =
            crate::http_clients::ExternalHttp::new(config.http_base_url_upstream.clone());
        Ok(Self {
            config,
            cache,
            object_store,
            email,
            search,
            http_upstream,
        })
    }
}
