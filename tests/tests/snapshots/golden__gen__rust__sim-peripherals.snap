tests/scope_tests.rs
============================================================
//! Generated behavioral test for scope enforcement. Regenerated on
//! every build. Drives the real router directly via
//! `tower::ServiceExt::oneshot` — no live server needed. Db pools are
//! lazy (`connect_lazy`), so a request that clears the auth layer but
//! then touches one may still come back as a 5xx; that's still proof
//! the auth layer itself let it through, which is all these assert.

use axum::body::Body;
use axum::http::{Request, StatusCode};
use tower::ServiceExt;

use sim_peripherals::{config::Config, routes, state::AppState};

async fn app() -> axum::Router {
    let state = AppState::new(Config::from_env())
        .await
        .expect("lazy state construction needs no live infra");
    routes::router().with_state(state)
}

fn bearer(scope: &str) -> String {
    bearer_exp(scope, 3600)
}

/// `exp_delta` in the past mints an already-expired token
/// (`26UpdatePlan.md` M4's `expired_token` case).
fn bearer_exp(scope: &str, exp_delta: i64) -> String {
    let exp = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .expect("system clock")
        .as_secs() as i64
        + exp_delta;
    let claims = serde_json::json!({"sub": "test", "scope": scope, "exp": exp});
    let secret = Config::from_env().jwt_secret;
    let token = jsonwebtoken::encode(
        &jsonwebtoken::Header::default(),
        &claims,
        &jsonwebtoken::EncodingKey::from_secret(secret.as_bytes()),
    )
    .expect("token encodes");
    format!("Bearer {token}")
}

#[tokio::test]
async fn echo_api_no_token() {
    let response = app()
        .await
        .oneshot(
            Request::builder()
                .method("POST")
                .uri("/echo-api")
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{
"key":"x"
}"#))
                .unwrap(),
        )
        .await
        .unwrap();
    assert_eq!(response.status(), StatusCode::UNAUTHORIZED);
}

#[tokio::test]
async fn echo_api_malformed_token() {
    let response = app()
        .await
        .oneshot(
            Request::builder()
                .method("POST")
                .uri("/echo-api")
                .header("Authorization", "Bearer not-a-jwt")
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{
"key":"x"
}"#))
                .unwrap(),
        )
        .await
        .unwrap();
    assert_eq!(response.status(), StatusCode::UNAUTHORIZED);
}

#[tokio::test]
async fn echo_api_wrong_scope() {
    // A well-formed body: axum extracts parameters in declaration
    // order, so `Json<..>` extraction (and its own validation) still
    // runs before the handler body's `require_scope` check — an
    // ill-formed body would 422 there first, masking the 403 this
    // test means to prove.
    let response = app()
        .await
        .oneshot(
            Request::builder()
                .method("POST")
                .uri("/echo-api")
                .header("Authorization", bearer("not:peripherals:admin"))
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{
"key":"x"
}"#))
                .unwrap(),
        )
        .await
        .unwrap();
    assert_eq!(response.status(), StatusCode::FORBIDDEN);
}

#[tokio::test]
async fn echo_api_correct_scope() {
    let response = app()
        .await
        .oneshot(
            Request::builder()
                .method("POST")
                .uri("/echo-api")
                .header("Authorization", bearer("peripherals:admin"))
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{
"key":"x"
}"#))
                .unwrap(),
        )
        .await
        .unwrap();
    assert_ne!(response.status(), StatusCode::UNAUTHORIZED);
    assert_ne!(response.status(), StatusCode::FORBIDDEN);
}

#[tokio::test]
async fn echo_api_expired_token() {
    let response = app()
        .await
        .oneshot(
            Request::builder()
                .method("POST")
                .uri("/echo-api")
                .header("Authorization", bearer_exp("peripherals:admin", -3600))
                .header("Content-Type", "application/json")
                .body(Body::from(r#"{
"key":"x"
}"#))
                .unwrap(),
        )
        .await
        .unwrap();
    assert_eq!(response.status(), StatusCode::UNAUTHORIZED);
}
