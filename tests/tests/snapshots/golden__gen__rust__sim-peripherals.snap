//! Handler for the `CallUpstream` typed handler. Generated by CIaC.
//!
//! Compiler-owned: lowered from the source `handler CallUpstream(..) { .. }` body
//! on every build. Business logic lives in the `.ciac` source, not here.
use crate::state::AppState;
use crate::schemas::{ Ack, HttpRequest };
#[derive(Debug)]
pub struct CallUpstream<'a> {
    pub http: &'a crate::http_clients::ExternalHttp,
}

impl<'a> CallUpstream<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            http: &state.http_upstream,
        }
    }

    // An unused `let` is a warning in the source language (`CIAC0045`),
    // not an error — a well-typed handler body can bind a value it
    // never reads. Rust's own `unused_variables` lint disagrees, so it's
    // allowed here rather than promoted to a hard failure by `-D warnings`.
    #[allow(unused_variables)]
    pub async fn handle(&self, payload: HttpRequest) -> anyhow::Result<Ack> {
self.http.post(&payload.path).json(&serde_json::json!({"value": payload.payload})).send().await?.json::<serde_json::Value>().await?;
return Ok(Ack { ok: true });
    }
}
