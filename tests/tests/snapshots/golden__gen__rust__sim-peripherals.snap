//! Handler for the `EvictCache` typed handler. Generated by CIaC.
//!
//! Compiler-owned: lowered from the source `handler EvictCache(..) { .. }` body
//! on every build. Business logic lives in the `.ciac` source, not here.
use redis::AsyncCommands;
use crate::state::AppState;
use crate::schemas::{ Ack, KeyOnly };
#[derive(Debug)]
pub struct EvictCache<'a> {
    pub cache: &'a redis::Client,
}

impl<'a> EvictCache<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            cache: &state.cache,
        }
    }

    // An unused `let` is a warning in the source language (`CIAC0045`),
    // not an error — a well-typed handler body can bind a value it
    // never reads. Rust's own `unused_variables` lint disagrees, so it's
    // allowed here rather than promoted to a hard failure by `-D warnings`.
    #[allow(unused_variables)]
    pub async fn handle(&self, payload: KeyOnly) -> anyhow::Result<Ack> {
{
    let mut conn = self.cache.get_multiplexed_async_connection().await?;
    let _: () = conn.del(&payload.key).await?;
};
return Ok(Ack { ok: true });
    }
}
