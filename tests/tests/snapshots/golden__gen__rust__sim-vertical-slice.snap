src/workers/reconcile.rs
============================================================
//! Scheduled job pipeline for `job Reconcile`. Generated by CIaC.

use chrono::Utc;
use cron::Schedule;
use std::str::FromStr;
use std::time::Duration;

use crate::services::run_reconcile::RunReconcile;
use crate::state::AppState;

/// The source-level five-field cron expression (minute hour day month
/// weekday), as written in the `.ciac` file.
pub const SCHEDULE: &str = "0 3 * * *";
/// `SCHEDULE` translated for the `cron` crate: a leading seconds field, and
/// weekday `0` rewritten as `7` (the crate accepts weekdays 1-7, not 0-7).
const CRON_CRATE_SCHEDULE: &str = "0 0 3 * * *";
pub const CATCH_UP: bool = false;

pub fn schedule() -> anyhow::Result<Schedule> {
    Ok(Schedule::from_str(CRON_CRATE_SCHEDULE)?)
}

pub async fn run(state: AppState) -> anyhow::Result<()> {
    let schedule = schedule()?;
    loop {
        sleep_until_next(&schedule).await?;
        if let Err(err) = handle_tick_once(&state).await {
            tracing::error!(?err, "scheduled job Reconcile failed");
        }
    }
}

async fn sleep_until_next(schedule: &Schedule) -> anyhow::Result<()> {
    let next = schedule
        .upcoming(Utc)
        .next()
        .ok_or_else(|| anyhow::anyhow!("schedule produced no future instant"))?;
    let delay = (next - Utc::now()).to_std().unwrap_or(Duration::ZERO);
    tokio::time::sleep(delay).await;
    Ok(())
}



/// `pub` (v0.17 M11): `src/bin/sim_runner.rs` calls this directly on
/// each cron-schedule due-instant an `advance` step's virtual-time
/// window covers, instead of the real `sleep_until_next`/`run` loop.
pub async fn handle_tick_once(state: &AppState) -> anyhow::Result<()> {
    let result = serde_json::json!({});

    let result = RunReconcile::new(state).handle(result).await?;
    let _ = result;
    Ok(())
}

#[cfg(test)]
mod tests {
    #[test]
    fn schedule_parses() {
        super::schedule().expect("generated SCHEDULE must parse as a cron expression");
    }
}
