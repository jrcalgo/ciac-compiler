    // not an error — a well-typed handler body can bind a value it
    // never reads. Rust's own `unused_variables` lint disagrees, so it's
    // allowed here rather than promoted to a hard failure by `-D warnings`.
    #[allow(unused_variables)]
    pub async fn handle(&self, order: Order) -> anyhow::Result<Order> {
{
    let __row = AuditEntry { id: uuid::Uuid::new_v4().to_string(), note: "order placed".to_owned() }.clone();
    if let Some(world) = self.world {
        world.db_insert_checked("audit_entries", serde_json::to_value(&__row)?)?;
    } else {
        sqlx::query("INSERT INTO audit_entries (id, note) VALUES ($1, $2)")
        .bind(&__row.id)
        .bind(&__row.note)
            .execute(self.db)
            .await?;
    }
    __row
};
return Ok(order);
    }
}
