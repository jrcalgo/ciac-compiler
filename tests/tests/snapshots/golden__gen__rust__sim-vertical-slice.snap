src/routes/place_order_api.rs
============================================================
//! Request pipeline for `api PlaceOrderApi`. Generated by CIaC.
//!
//! Pipeline: PlaceOrder -> RecordAudit -> publish sim_vertical_slice.order_created -> Return


use axum::extract::State;
use axum::routing::post;
use axum::{Json, Router};

use crate::error::AppError;
use crate::schemas::Order;
use crate::logic::place_order::PlaceOrder;
use crate::logic::record_audit::RecordAudit;
use crate::state::AppState;

pub fn router() -> Router<AppState> {
    Router::new().route("/orders", post(place_order_api))
}

async fn place_order_api(
    State(state): State<AppState>,
    Json(payload): Json<Order>,
) -> Result<Json<serde_json::Value>, AppError> {
    let result = payload;

    let result = PlaceOrder::new(&state).handle(result).await?;
    let result = RecordAudit::new(&state).handle(result).await?;
    state
        .queue
        .publish("sim_vertical_slice.order_created", serde_json::to_vec(&result)?)
        .await?;
    Ok(Json(serde_json::json!({"status": "accepted", "data": result})))
}
