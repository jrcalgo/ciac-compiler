//! Runs every worker in one process. Generated by CIaC.

use sim_vertical_slice::{config::Config, state::AppState, workers};

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    sim_vertical_slice::observability::init();
    let config = Config::from_env();
    let state = AppState::new(config).await?;
    tokio::try_join!(
        workers::process_order::run(state.clone()),
        workers::reconcile::run(state.clone()),
    )?;
    Ok(())
}
