//! REST endpoints for the `Note` resource. Generated by CIaC.

use axum::extract::{Path, Query, State};
use axum::http::StatusCode;
use axum::routing::{delete, get, post, put};
use axum::{Json, Router};

use crate::error::AppError;
use crate::models::{Note, NoteIn};
use crate::services::note_store::NoteStore;
use crate::state::AppState;

#[derive(Debug, serde::Deserialize)]
struct ListQuery {
    limit: Option<i64>,
    offset: Option<i64>,
}

pub fn router() -> Router<AppState> {
    Router::new()
        .route("/notes", post(create_note))
        .route("/notes", get(list_notes))
        .route("/notes/{id}", get(get_note))
        .route("/notes/{id}", put(update_note))
        .route("/notes/{id}", delete(delete_note))
}

async fn create_note(
    State(state): State<AppState>,
    Json(payload): Json<NoteIn>,
) -> Result<(StatusCode, Json<Note>), AppError> {
    let entity = NoteStore::new(&state).create(payload).await?;
    Ok((StatusCode::CREATED, Json(entity)))
}

async fn list_notes(
    State(state): State<AppState>,
    Query(query): Query<ListQuery>,
) -> Result<Json<Vec<Note>>, AppError> {
    let entities = NoteStore::new(&state)
        .list(query.limit.unwrap_or(100), query.offset.unwrap_or(0))
        .await?;
    Ok(Json(entities))
}

async fn get_note(
    State(state): State<AppState>,
    Path(id): Path<String>,
) -> Result<Json<Note>, AppError> {
    match NoteStore::new(&state).get(&id).await? {
        Some(entity) => Ok(Json(entity)),
        None => Err(AppError::not_found()),
    }
}

async fn update_note(
    State(state): State<AppState>,
    Path(id): Path<String>,
    Json(payload): Json<NoteIn>,
) -> Result<Json<Note>, AppError> {
    match NoteStore::new(&state).update(&id, payload).await? {
        Some(entity) => Ok(Json(entity)),
        None => Err(AppError::not_found()),
    }
}

async fn delete_note(
    State(state): State<AppState>,
    Path(id): Path<String>,
) -> Result<StatusCode, AppError> {
    if NoteStore::new(&state).delete(&id).await? {
        Ok(StatusCode::NO_CONTENT)
    } else {
        Err(AppError::not_found())
    }
}
