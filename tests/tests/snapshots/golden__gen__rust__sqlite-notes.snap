//! Persistence for the `Note` resource. Generated by CIaC.

use crate::models::{Note, NoteIn};
use crate::state::AppState;
/// CRUD operations for Note.
#[derive(Debug)]
pub struct NoteStore<'a> {
    pub db: &'a sqlx::SqlitePool,
}

impl<'a> NoteStore<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            db: &state.db,
        }
    }


    pub async fn create(&self, payload: NoteIn) -> anyhow::Result<Note> {
        let entity = Note {
            id: uuid::Uuid::new_v4().to_string(),
            title: payload.title,
        };
        sqlx::query(
            "INSERT INTO notes (id, title) VALUES (?, ?)",
        )
        .bind(&entity.id)
        .bind(&entity.title)
        .execute(self.db)
        .await?;
        Ok(entity)
    }

    pub async fn get(&self, id: &str) -> anyhow::Result<Option<Note>> {
        let entity: Option<Note> =
            sqlx::query_as("SELECT id, title FROM notes WHERE id = ?")
                .bind(id)
                .fetch_optional(self.db)
                .await?;
        Ok(entity)
    }

    pub async fn list(&self, limit: i64, offset: i64) -> anyhow::Result<Vec<Note>> {
        let entities =
            sqlx::query_as("SELECT id, title FROM notes ORDER BY id LIMIT ? OFFSET ?")
                .bind(limit)
                .bind(offset)
                .fetch_all(self.db)
                .await?;
        Ok(entities)
    }

    pub async fn update(
        &self,
        id: &str,
        payload: NoteIn,
    ) -> anyhow::Result<Option<Note>> {
        let entity = Note {
            id: id.to_owned(),
            title: payload.title,
        };
        let updated = sqlx::query(
            "UPDATE notes SET title = ? WHERE id = ?",
        )
        .bind(&entity.title)
        .bind(id)
        .execute(self.db)
        .await?;
        if updated.rows_affected() == 0 {
            return Ok(None);
        }
        Ok(Some(entity))
    }

    pub async fn delete(&self, id: &str) -> anyhow::Result<bool> {
        let deleted = sqlx::query("DELETE FROM notes WHERE id = ?")
            .bind(id)
            .execute(self.db)
            .await?;
        Ok(deleted.rows_affected() > 0)
    }
}

