============================================================
//! Worker pipeline for `worker Ship`. Generated by CIaC.
//!
//! Consumes `traced_checkout.placed` in queue group `ship`
//! so replicas of this worker load-balance messages between them.

use futures::StreamExt;
use futures::future::try_join_all;
use tracing::Instrument;
use tracing_opentelemetry::OpenTelemetrySpanExt;

use crate::schemas::Order;
use crate::services::ship_order::ShipOrder;
use crate::state::AppState;

pub const SUBJECT: &str = "traced_checkout.placed";
pub const QUEUE_GROUP: &str = "ship";
pub const CONCURRENCY: usize = 1;
pub const MAX_RETRIES: u32 = 0;

pub async fn run(state: AppState) -> anyhow::Result<()> {
    let tasks = (0..CONCURRENCY).map(|worker_index| {
        let state = state.clone();
        tokio::spawn(async move { consume(state, worker_index).await })
    });
    for result in try_join_all(tasks).await? {
        result?;
    }
    Ok(())
}

async fn consume(state: AppState, worker_index: usize) -> anyhow::Result<()> {
    let mut subscription = state.queue.queue_subscribe(SUBJECT, QUEUE_GROUP).await?;
    tracing::info!(subject = SUBJECT, worker_index, "worker Ship consuming");
    while let Some(message) = subscription.next().await {
        let payload: Order = match serde_json::from_slice(&message.payload) {
            Ok(payload) => payload,
            Err(err) => {
                tracing::warn!(?err, "discarding malformed message");
                continue;
            }
        };
        let mut carrier = crate::queue::TraceCarrier(std::collections::HashMap::new());
        if let Some(headers) = &message.headers {
            for (key, values) in headers.iter() {
                if let Some(value) = values.first() {
                    carrier.0.insert(key.to_string(), value.to_string());
                }
            }
        }
        let parent_ctx =
            opentelemetry::global::get_text_map_propagator(|propagator| propagator.extract(&carrier));
        let span = tracing::info_span!("worker.Ship");
        let _ = span.set_parent(parent_ctx);
        if let Err(err) = handle_message(&state, payload).instrument(span).await {
            tracing::error!(?err, "message processing failed after retries");
        }
    }
    Ok(())
}



async fn handle_message(state: &AppState, payload: Order) -> anyhow::Result<()> {
    for attempt in 0..=MAX_RETRIES {
        match handle_message_once(state, payload.clone()).await {
            Ok(()) => return Ok(()),
            Err(err) if attempt < MAX_RETRIES => {
                tracing::warn!(?err, attempt, "message processing failed; retrying");
            }
            Err(err) => return Err(err),
        }
    }
    Ok(())
}

/// `pub` (v0.17 M11): `src/bin/sim_runner.rs` calls this directly to
/// drive its own retry loop with real attempt counting, the same
/// "the runner pumps delivery, there is no running subscription loop"
/// architecture `sim/pyrunner/world.py`'s `deliver_counting_attempts`
/// uses -- see that module's docstring for why `handle_message_once`,
/// not `handle_message`, is the entry point a runner needs.
pub async fn handle_message_once(state: &AppState, payload: Order) -> anyhow::Result<()> {
    let result = payload;

    let result = ShipOrder::new(state).handle(result).await?;
    let _ = result;
    Ok(())
}
