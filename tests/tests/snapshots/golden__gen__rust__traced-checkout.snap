//! Runtime configuration for Checkout. Generated by CIaC.
//!
//! Every value can be overridden through the environment, e.g.
//! `DATABASE_URL`; defaults target local development.

#[derive(Debug, Clone)]
pub struct Config {
    pub payments_url: String,
    pub nats_url: String,
}

impl Config {
    pub fn from_env() -> Self {
        Self {
            payments_url: env_or("PAYMENTS_URL", "http://localhost:8000"),
            nats_url: env_or("NATS_URL", "nats://localhost:4222"),
        }
    }
}

fn env_or(key: &str, default: &str) -> String {
    std::env::var(key).unwrap_or_else(|_| default.to_owned())
}
