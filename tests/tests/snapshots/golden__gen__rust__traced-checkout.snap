//! Typed HTTP client for the `Payments` service. Generated by CIaC.
//!
//! `call Payments.<Api>` pipeline steps invoke these methods. The
//! base URL comes from `PAYMENTS_URL`; the system docker-compose
//! points it at the `payments` container.

use crate::schemas::{Order};

use tracing_opentelemetry::OpenTelemetrySpanExt;
use crate::state::AppState;

/// Calls `Payments` over HTTP and unwraps its response envelope.
pub struct PaymentsClient<'a> {
    base_url: &'a str,
}

impl<'a> PaymentsClient<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            base_url: &state.config.payments_url,
        }
    }

    pub async fn charge(&self, payload: Order) -> anyhow::Result<Order> {
        let mut headers = reqwest::header::HeaderMap::new();
        opentelemetry::global::get_text_map_propagator(|propagator| {
            propagator.inject_context(
                &tracing::Span::current().context(),
                &mut opentelemetry_http::HeaderInjector(&mut headers),
            )
        });
        let response = reqwest::Client::new()
            .post(format!("{}/charge", self.base_url))
            .headers(headers)
            .json(&payload)
            .send()
            .await?
            .error_for_status()?;
        let body: serde_json::Value = response.json().await?;
        Ok(serde_json::from_value(body["data"].clone())?)
    }
}
