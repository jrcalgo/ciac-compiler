//! Persistence models and API schemas for CRUD resources and `table`
//! declarations. Generated by CIaC.
//!
//! Typed resources (`crud X: Record;`) get real columns from their record;
//! untyped ones keep a generic keyed-document model (UUID key + JSON
//! payload). `table <Name>: <Record>;` declarations (v0.7) get the same
//! column treatment, named after the table so a record reused under
//! several table names doesn't collide. Enums are stored as text.

use serde::{Deserialize, Serialize};

use crate::schemas::Video;


#[derive(Debug, Clone, Serialize, Deserialize, sqlx::FromRow)]
pub struct Videos {
    pub id: String,
    pub title: String,
    pub status: String,
}

impl TryFrom<Videos> for Video {
    type Error = anyhow::Error;

    fn try_from(row: Videos) -> anyhow::Result<Self> {
        Ok(Video {
            id: row.id,
            title: row.title,
            status: crate::schemas::VideoStatus::from_str(&row.status)?,
        })
    }
}

