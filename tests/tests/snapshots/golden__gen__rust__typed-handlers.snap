//! Handler for the `StoreVideo` typed handler. Generated by CIaC.
//!
//! Compiler-owned: lowered from the source `handler StoreVideo(..) { .. }` body
//! on every build. Business logic lives in the `.ciac` source, not here.
use crate::state::AppState;
use crate::schemas::{ Video, VideoStatus };
#[derive(Debug)]
pub struct StoreVideo<'a> {
    pub db: &'a sqlx::PgPool,
    pub object_store: &'a crate::object_store::ObjectStore,
}

impl<'a> StoreVideo<'a> {
    pub fn new(state: &'a AppState) -> Self {
        Self {
            db: &state.db,
            object_store: &state.object_store,
        }
    }

    // An unused `let` is a warning in the source language (`CIAC0045`),
    // not an error — a well-typed handler body can bind a value it
    // never reads. Rust's own `unused_variables` lint disagrees, so it's
    // allowed here rather than promoted to a hard failure by `-D warnings`.
    #[allow(unused_variables)]
    pub async fn handle(&self, v: Video) -> anyhow::Result<Video> {
self.object_store.put(&format!("{}{}", "videos/".to_owned(), v.id), &serde_json::to_vec(&v)?).await?;
let v1 = {
    let __row = v.clone();
    sqlx::query("INSERT INTO videos (id, title, status) VALUES ($1, $2, $3)")
        .bind(&__row.id)
        .bind(&__row.title)
        .bind(__row.status.as_str())
        .execute(self.db)
        .await?;
    __row
};
let v2 = if v1.status == VideoStatus::Pending {
    Video { status: VideoStatus::Ready, ..v1 }
} else {
    v1
};
return Ok(v2);
    }
}
