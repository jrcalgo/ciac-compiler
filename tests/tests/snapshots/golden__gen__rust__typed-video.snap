//! Database schema management. Generated by CIaC.

/// Creates all tables on startup.
///
/// Replace with real migrations (e.g. `sqlx migrate`) once the schema
/// needs to evolve in production.
pub async fn ensure_schema(db: &sqlx::PgPool) -> anyhow::Result<()> {
    sqlx::query(
        "CREATE TABLE IF NOT EXISTS clips (
            id TEXT PRIMARY KEY,
            title TEXT NOT NULL,
            duration_s BIGINT NOT NULL,
            status TEXT NOT NULL
        )",
    )
    .execute(db)
    .await?;
    Ok(())
}
