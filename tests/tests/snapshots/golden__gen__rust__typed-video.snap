//! Runs every worker in one process. Generated by CIaC.

use media::{config::Config, state::AppState, workers};

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    media::observability::init();
    let config = Config::from_env();
    let state = AppState::new(config).await?;
    tokio::try_join!(
        workers::transcoder::run(state.clone()),
        workers::notifier::run(state.clone()),
    )?;
    Ok(())
}
