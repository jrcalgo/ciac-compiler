src/workers/transcoder.rs
============================================================
//! Worker pipeline for `worker Transcoder`. Generated by CIaC.
//!
//! Consumes `video_platform.events` in queue group `transcoder`
//! so replicas of this worker load-balance messages between them.

use futures::StreamExt;
use futures::future::try_join_all;

use crate::services::transcode::Transcode;
use crate::services::save_result::SaveResult;
use crate::state::AppState;

pub const SUBJECT: &str = "video_platform.events";
pub const QUEUE_GROUP: &str = "transcoder";
pub const CONCURRENCY: usize = 1;
pub const MAX_RETRIES: u32 = 0;

pub async fn run(state: AppState) -> anyhow::Result<()> {
    let tasks = (0..CONCURRENCY).map(|worker_index| {
        let state = state.clone();
        tokio::spawn(async move { consume(state, worker_index).await })
    });
    for result in try_join_all(tasks).await? {
        result?;
    }
    Ok(())
}

async fn consume(state: AppState, worker_index: usize) -> anyhow::Result<()> {
    let mut subscription = state
        .queue
        .client()
        .queue_subscribe(SUBJECT, QUEUE_GROUP.to_owned())
        .await?;
    tracing::info!(subject = SUBJECT, worker_index, "worker Transcoder consuming");
    while let Some(message) = subscription.next().await {
        let payload: serde_json::Value = match serde_json::from_slice(&message.payload) {
            Ok(payload) => payload,
            Err(err) => {
                tracing::warn!(?err, "discarding malformed message");
                continue;
            }
        };
        if let Err(err) = handle_message(&state, payload).await {
            tracing::error!(?err, "message processing failed after retries");
        }
    }
    Ok(())
}



async fn handle_message(state: &AppState, payload: serde_json::Value) -> anyhow::Result<()> {
    for attempt in 0..=MAX_RETRIES {
        match handle_message_once(state, payload.clone()).await {
            Ok(()) => return Ok(()),
            Err(err) if attempt < MAX_RETRIES => {
                tracing::warn!(?err, attempt, "message processing failed; retrying");
            }
            Err(err) => return Err(err),
        }
    }
    Ok(())
}

async fn handle_message_once(state: &AppState, payload: serde_json::Value) -> anyhow::Result<()> {
    let result = payload;

    let result = Transcode::new(state).handle(result).await?;
    let result = SaveResult::new(state).handle(result).await?;
    let _ = result;
    Ok(())
}
