src/routes/upload.rs
============================================================
//! Request pipeline for `api Upload`. Generated by CIaC.
//!
//! Pipeline: Auth -> StoreVideo -> publish video_platform.events -> Return


use axum::extract::State;
use axum::routing::post;
use axum::{Json, Router};

use crate::auth::Claims;
use crate::error::AppError;
use crate::services::store_video::StoreVideo;
use crate::state::AppState;

pub fn router() -> Router<AppState> {
    Router::new().route("/upload", post(upload))
}

async fn upload(
    State(state): State<AppState>,
    claims: Claims,
    Json(payload): Json<serde_json::Value>,
) -> Result<Json<serde_json::Value>, AppError> {
    let mut result = payload;
    if let Some(object) = result.as_object_mut() {
        object.insert(
            "subject".to_owned(),
            claims
                .subject()
                .map(Into::into)
                .unwrap_or(serde_json::Value::Null),
        );
    }

    let result = StoreVideo::new(&state).handle(result).await?;
    state
        .publish("video_platform.events", serde_json::to_vec(&result)?)
        .await?;
    Ok(Json(serde_json::json!({"status": "accepted", "data": result})))
}
