openapi.json
============================================================
{
  "components": {
    "schemas": {
      "Click": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "page": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "page"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Clickstream",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/clicks": {
      "post": {
        "operationId": "ingest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Click"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Click"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success."
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Liveness check."
          }
        }
      }
    }
  }
}
