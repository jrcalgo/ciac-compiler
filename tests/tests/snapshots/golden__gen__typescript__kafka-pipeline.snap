// Observability wiring. Generated by CIaC.

import type { FastifyServerOptions } from "fastify";
import pino from "pino";

export function loggerOptions(): FastifyServerOptions["logger"] {
  return true;
}

/** Standalone logger for the workers entrypoint (`dist/workers.js`), which never touches Fastify. */
export function logger() {
  return pino({ level: process.env.LOG_LEVEL ?? "info" });
}
