// Workers/jobs/consumers entrypoint (`node dist/workers.js`). Generated by CIaC.

import { loadConfig } from "./config.js";
import { createState } from "./state.js";
import { run as runEnrich } from "./workers/enrich.js";

async function main(): Promise<void> {
  const config = loadConfig();
  const state = createState(config);
  await Promise.all([
    runEnrich(state),
  ]);
}

main().catch((err: unknown) => {
  console.error(err);
  process.exit(1);
});
