============================================================
Dockerfile
============================================================
FROM node:22-slim AS build

WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN npm run build

FROM node:22-slim

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /src/dist ./dist
COPY openapi.json ./

EXPOSE 8000
CMD ["node", "dist/main.js"]
============================================================
README.md
============================================================
# Clickstream

Generated by [CIaC](https://github.com/jrcalgo/ciac) — do not edit the
compiler-owned wiring by hand; regenerate it from the `.ciac` source
instead. Business logic lives in `src/services/`, which is yours.

## Run

```sh
npm ci
npm run build
npm start
```

Or bring up the full stack:

```sh
docker compose up --build
```

## Test & lint

```sh
npx tsc --noEmit
npx eslint .
npx vitest run
```

## Layout

| Path | Purpose | Owner |
|------|---------|-------|
| `src/main.ts` | Application assembly | compiler |
| `src/routes/` | HTTP routes (one per api) | compiler |
| `src/config.ts` | Environment-driven settings | compiler |
| `src/state.ts` | Shared application state | compiler |
============================================================
docker-compose.yml
============================================================
services:
  app:
    build: .
    ports:
      - "8000:8000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000"]
      interval: 1s
      timeout: 3s
      retries: 30
    environment:
      KAFKA_URL: queue:9092
    depends_on:
      queue:
        condition: service_started

  workers:
    build: .
    command: ["node", "dist/workers.js"]
    environment:
      KAFKA_URL: queue:9092
    depends_on:
      queue:
        condition: service_started

  queue:
    image: apache/kafka:3.8.0
    # Dual listeners (v0.13 M2): in-network clients use queue:9092;
    # host clients (the generated tests/system suite) use
    # localhost:29092 -- a host client on 9092 would be redirected to
    # the unresolvable advertised name `queue`.
    ports:
      - "29092:29092"
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@queue:9093
      KAFKA_LISTENERS: PLAINTEXT://:9092,CONTROLLER://:9093,EXTERNAL://:29092
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://queue:9092,EXTERNAL://localhost:29092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,EXTERNAL:PLAINTEXT
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "true"
