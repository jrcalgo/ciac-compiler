// The v0.17 M11 bar, restated for this target (v0.23 M1): constructing
// `AppState` touches zero infrastructure. Generated by CIaC.

import { describe, expect, it } from "vitest";
import { loadConfig } from "../src/config.js";
import { createState } from "../src/state.js";

describe("AppState construction", () => {
  it("never touches the network, even against unreachable config", () => {
    const state = createState(loadConfig());
    expect(state.config).toBeDefined();
  });
});
