tests/scope.test.ts
============================================================
// Generated behavioral test for scope enforcement. Regenerated on
// every build. Drives the real app directly via `app.inject()` — no
// live server needed (db/cache/queue pools stay lazy; a request that
// clears the auth layer but then touches one may still come back as a
// 5xx, which is still proof the auth layer itself let it through —
// the same claim boundary `scope_tests.rs.j2` documents).
//
// `no_token`/`malformed_token` are scheme-agnostic (gated below on
// `has_auth_step`/`has_auth`, not on scheme) — an oauth2 project gets
// them here too; the real-RS256 rig in `oauth-rig.test.ts` covers the
// oauth2-only cases (`26UpdatePlan.md` M5).

import { describe, expect, it } from "vitest";
import { loadConfig } from "../src/config.js";
import { createState } from "../src/state.js";
import { buildApp } from "../src/main.js";

async function app() {
  const state = createState(loadConfig());
  return buildApp(state);
}


describe("echo auth enforcement", () => {
  it("rejects a request with no token", async () => {
    const response = await (await app()).inject({
      method: "POST",
      url: "/echo",
      payload: {"id": "00000000-0000-0000-0000-000000000000", "text": "x"},
    });
    expect(response.statusCode).toBe(401);
  });

  it("rejects a malformed bearer token", async () => {
    const response = await (await app()).inject({
      method: "POST",
      url: "/echo",
      headers: { authorization: "Bearer not-a-jwt" },
      payload: {"id": "00000000-0000-0000-0000-000000000000", "text": "x"},
    });
    expect(response.statusCode).toBe(401);
  });
});

