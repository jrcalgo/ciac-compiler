src/routes/echo.ts
============================================================
// Request pipeline for `api Echo`. Generated by CIaC.
import type { FastifyPluginAsync } from "fastify";
import { requireScope, verifyToken } from "../auth.js";
import type { AppState } from "../state.js";

export const echoRoute: FastifyPluginAsync<{ state: AppState }> = async (
  app,
  { state },
) => {
  // A no-op read: `state` may go unused (a pipeline with no db/cache/
  // handler/publish/call step, e.g. `Return`-only) or genuinely used
  // below, depending on the pipeline's steps — computing which
  // per-route isn't worth it when a harmless `void` covers both, kept
  // in the plugin signature so route registration doesn't change shape
  // as this api's pipeline grows.
  void state;
  app.post("/echo", async (request) => {
    const claims = await verifyToken(request, state);
    requireScope(claims, "echo:write");
    const result: unknown = request.body;


    return { status: "accepted", data: result };
  });
};
