src/main.ts
============================================================
// Application assembly for OauthEcho. Generated by CIaC.

import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import Fastify from "fastify";
import { loadConfig } from "./config.js";
import {
  loggerOptions,
} from "./observability.js";
import { createState, type AppState } from "./state.js";
import { echoRoute } from "./routes/echo.js";

// Emitted by `ciac build` alongside this file (openapi.json, derived
// straight from the IR) — the single source of truth for the API
// spec, not a hand-maintained second opinion on the same routes.
const openapiPath = fileURLToPath(new URL("../openapi.json", import.meta.url));
const openapiDocument: unknown = JSON.parse(readFileSync(openapiPath, "utf8"));

// `opts.logger` (v0.23 M9) lets `sim_runner.ts` build a silent app:
// pino's structured request logs otherwise share stdout with the
// runner's own one-line `SimScenarioOutcome` JSON protocol, and pino's
// writer flushes asynchronously, so a log line can still land *after*
// that final line -- exactly the "last line on stdout" contract
// `ciac sim`'s parent process depends on. Every other caller
// (production startup, `scope.test.ts`) omits `opts` and keeps today's
// logging behavior unchanged.
export function buildApp(state: AppState, opts?: { logger?: boolean }) {
  const app = Fastify({ logger: opts?.logger === false ? false : loggerOptions() });

  app.get("/health", async () => ({ status: "ok" }));
  app.get("/openapi.json", async () => openapiDocument);
  app.register(echoRoute, { state });

  return app;
}

if (import.meta.url === `file://${process.argv[1]}`) {
  const config = loadConfig();
  const state = createState(config);
  const app = buildApp(state);
  app.listen({ host: "0.0.0.0", port: 8000 }).catch((err: unknown) => {
    app.log.error(err);
    process.exit(1);
  });
}
