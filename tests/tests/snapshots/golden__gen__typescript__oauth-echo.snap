src/world.ts
============================================================
// 27UpdatePlan.md M6: a full TypeScript restatement of `ciac-sim`'s
// simulation world (`crates/ciac-sim/src/world.rs`) -- TypeScript
// cannot vendor Rust source the way the Rust backend does via
// `include_str!`, so this is a from-scratch, self-contained port
// (Pillar 4's rule: a world template may depend on its language's
// standard library and the target's already-present runtime deps, and
// nothing else). Node is single-threaded, so every `Mutex<..>` in the
// Rust source is just a plain field here -- no lock needed for the
// same reason Python's `world.py` never needed one either.
//
// v0.23 M9's narrow scope (only `db.insert` and broker `publish`) is
// retired here: schema-aware relational writes (reference/unique/
// cascade checking), the group-aware broker log, the virtual clock,
// and every peripheral fake (cache/object store/email/search/http/
// auth) are ported, matching Python's own coverage. Generated by CIaC
// for any program with something this world can fake (`db`, `queue`,
// `cache`, `object_store`, `email`, `search`, `external_http`, or
// `auth`), mirroring the Rust backend's own `world.rs` emission gate.

/** `on_delete`'s two shapes -- the TypeScript counterpart to
 * `ciac_sim::world::WorldRefAction`. */
export type WorldRefAction = "restrict" | "cascade";

/** One outgoing reference field, as a schema-aware store needs it.
 * `sim_runner.ts`'s own `main()` builds these as literal object
 * literals at codegen time, since this module has no `SimPlan` JSON to
 * load at runtime -- mirroring `ciac_sim::world::WorldReference`. */
export interface WorldReference {
  fieldName: string;
  targetTable: string | null;
  onDelete: WorldRefAction;
  unique: boolean;
}

/** One table's worth of schema facts a schema-aware store needs --
 * just its own outgoing references. */
export interface WorldTable {
  name: string;
  references: WorldReference[];
}

/** table name -> its own outgoing reference fields, plus the reverse
 * index `dbDeleteChecked`'s plan-then-apply needs to find restrict/
 * cascade candidates -- the TypeScript counterpart to
 * `ciac_sim::world::RelationalSchema`. */
class RelationalSchema {
  private readonly outgoing = new Map<string, WorldReference[]>();

  constructor(tables: WorldTable[]) {
    for (const table of tables) {
      this.outgoing.set(table.name, table.references);
    }
  }

  outgoingOf(table: string): WorldReference[] {
    return this.outgoing.get(table) ?? [];
  }

  /** Every `[referencingTable, reference]` whose reference targets
   * `targetTable`. */
  incomingOf(targetTable: string): Array<[string, WorldReference]> {
    const out: Array<[string, WorldReference]> = [];
    for (const [table, refs] of this.outgoing) {
      for (const ref of refs) {
        if (ref.targetTable === targetTable) {
          out.push([table, ref]);
        }
      }
    }
    return out;
  }
}

type Row = Record<string, unknown>;

function rowId(row: Row): string | undefined {
  return typeof row.id === "string" ? row.id : undefined;
}

/** The `error` action only -- the same disclosed subset of the full
 * failure vocabulary Python's own restatement supports, for the same
 * reason (it's the one action a checked-in scenario needs). */
export interface FailureRule {
  effect: string;
  subject: string | null;
  occurrence: number;
}

/**
 * Occurrence-counted `(effect, subject)` failure rules. `occurrence`
 * is 1-based, matching `ciac_sim::failure`'s own convention exactly,
 * so this restatement stays comparable to the canonical Rust engine.
 */
class FailureEngine {
  private readonly rules: Set<string>;
  private readonly matched = new Set<string>();
  private readonly counts = new Map<string, number>();

  constructor(rules: FailureRule[]) {
    this.rules = new Set(rules.map((r) => FailureEngine.ruleKey(r.effect, r.subject, r.occurrence)));
  }

  private static countKey(effect: string, subject: string | null): string {
    return `${effect} ${subject ?? ""}`;
  }

  private static ruleKey(effect: string, subject: string | null, occurrence: number): string {
    return `${FailureEngine.countKey(effect, subject)} ${occurrence}`;
  }

  shouldFail(effect: string, subject: string | null): boolean {
    const countKey = FailureEngine.countKey(effect, subject);
    const occurrence = (this.counts.get(countKey) ?? 0) + 1;
    this.counts.set(countKey, occurrence);
    const key = FailureEngine.ruleKey(effect, subject, occurrence);
    if (this.rules.has(key)) {
      this.matched.add(key);
      return true;
    }
    return false;
  }

  /** Failure rules the scenario declared that never matched a real
   * occurrence -- surfaced to the runner rather than silently ignored. */
  unmatchedRules(): string[] {
    return [...this.rules].filter((key) => !this.matched.has(key)).sort();
  }
}

/** An in-memory table store keyed by table name, rows as plain
 * objects. No constraints, no cascades, no indexes on its own --
 * `SimWorld`'s own checked operations layer that on top via
 * `RelationalSchema`, the same split `ciac_sim::world::FakeDatabase`/
 * `SimWorld` hold. */
class FakeDatabase {
  private readonly tables = new Map<string, Row[]>();

  insert(table: string, row: Row): void {
    const rows = this.tables.get(table) ?? [];
    rows.push(row);
    this.tables.set(table, rows);
  }

  /** Rows in `table` matching every key/value pair in `filter` (an
   * empty filter matches every row) -- `sim_runner.ts`'s own
   * `expect.row` check, not something generated handler code calls. */
  findWhere(table: string, filter: Record<string, unknown>): Row[] {
    const rows = this.tables.get(table) ?? [];
    const keys = Object.keys(filter);
    return rows.filter((row) => keys.every((k) => row[k] === filter[k]));
  }

  count(table: string): number {
    return (this.tables.get(table) ?? []).length;
  }

  /** By-`id` lookup -- `null` (absent vs. present) if no row has that
   * key, matching production `db.get`'s own shape. */
  get(table: string, pk: string): Row | null {
    return (this.tables.get(table) ?? []).find((row) => rowId(row) === pk) ?? null;
  }

  /** Unconditional removal by `id` -- `true` if a row was actually
   * removed. No reference/cascade checking here; that is `SimWorld`'s
   * own `dbDeleteChecked`'s job, one layer up, since it needs the
   * schema this plain store doesn't carry. */
  delete(table: string, pk: string): boolean {
    const rows = this.tables.get(table);
    if (!rows) return false;
    const before = rows.length;
    const kept = rows.filter((row) => rowId(row) !== pk);
    this.tables.set(table, kept);
    return kept.length !== before;
  }

  /** Full-record replace by `id` -- matching production `db.update`'s
   * real shape (`UPDATE <table> SET <every column> WHERE id = <pk>`,
   * not an attribute patch). `true` if a row with that `id` existed to
   * replace. */
  replace(table: string, pk: string, record: Row): boolean {
    const rows = this.tables.get(table);
    if (!rows) return false;
    const idx = rows.findIndex((row) => rowId(row) === pk);
    if (idx === -1) return false;
    rows[idx] = record;
    return true;
  }

  /** A full clone of every table -- the scratch overlay `SimWorld`'s
   * schema-aware checked operations validate a prospective write
   * against before touching the real store, mirroring Python's own
   * `commit_batch`'s overlay-of-tables approach. */
  snapshot(): Map<string, Row[]> {
    const out = new Map<string, Row[]>();
    for (const [table, rows] of this.tables) {
      out.set(table, [...rows]);
    }
    return out;
  }
}

/** Every publish, in arrival order -- the runner drains these
 * directly into a worker's own `handleMessageOnce`; there is no
 * running subscription loop. Transitional alongside `BrokerLog`
 * (`publishChecked` writes into both): `world.queue` stays the
 * orphan-subject detection sweep `drain()` uses. */
class FakeQueue {
  private published: Array<[string, Buffer]> = [];

  publish(subject: string, payload: Buffer): void {
    this.published.push([subject, payload]);
  }

  /** Every message published since the last drain, removing them. */
  takeAll(): Array<[string, Buffer]> {
    const out = this.published;
    this.published = [];
    return out;
  }

  /** Non-destructive peek -- `expect.quiescence` needs to observe
   * whether anything is still undelivered without consuming it. */
  isEmpty(): boolean {
    return this.published.length === 0;
  }
}

/**
 * 27UpdatePlan.md M6 (Pillar 2): one ordered log per subject; every
 * consumer *group* holds its own independent cursor into that log --
 * two groups on one subject each see every message (fan-out), two
 * workers sharing one group share its cursor (queue-group semantics).
 * `takeNext` peeks without consuming; only `ack` advances the cursor,
 * and `nack` is an explicit no-op -- the message is redelivered on the
 * next `takeNext` of that same `(subject, group)` iff it was never
 * acked. Mirrors `ciac_sim::world::BrokerLog` exactly.
 */
class BrokerLog {
  private readonly logs = new Map<string, Buffer[]>();
  private readonly cursors = new Map<string, number>();

  private static cursorKey(subject: string, group: string): string {
    return `${subject} ${group}`;
  }

  publish(subject: string, payload: Buffer): void {
    const log = this.logs.get(subject) ?? [];
    log.push(payload);
    this.logs.set(subject, log);
  }

  /** The next unconsumed message for `(subject, group)` -- `undefined`
   * at log head. Does not advance the cursor; call `ack` to consume it. */
  takeNext(subject: string, group: string): Buffer | undefined {
    const log = this.logs.get(subject);
    if (!log) return undefined;
    const pos = this.cursors.get(BrokerLog.cursorKey(subject, group)) ?? 0;
    return log[pos];
  }

  /** Advances `(subject, group)`'s cursor past the message it is
   * currently pointed at -- the successful-delivery acknowledgement. */
  ack(subject: string, group: string): void {
    const key = BrokerLog.cursorKey(subject, group);
    this.cursors.set(key, (this.cursors.get(key) ?? 0) + 1);
  }

  /** Explicit no-op: the cursor is left exactly where it was, so the
   * same message comes back on the next `takeNext` -- this *is* the
   * redelivery model, not a missing feature. */
  nack(_subject: string, _group: string): void {
    void _subject;
    void _group;
  }

  /** Every unconsumed message for `(subject, group)`, in log order,
   * each individually acked as it is collected. */
  drain(subject: string, group: string): Buffer[] {
    const out: Buffer[] = [];
    let msg: Buffer | undefined;
    while ((msg = this.takeNext(subject, group)) !== undefined) {
      out.push(msg);
      this.ack(subject, group);
    }
    return out;
  }

  /** True iff every cursor this broker has ever been asked about is
   * caught up to its subject's current log head. */
  queuesEmpty(): boolean {
    for (const [key, pos] of this.cursors) {
      const subject = key.slice(0, key.indexOf(" "));
      const len = this.logs.get(subject)?.length ?? 0;
      if (pos < len) return false;
    }
    return true;
  }
}

/** Cache-aside `cache.get`/`cache.set`/`cache.delete`, TTL measured
 * against `SimWorld`'s own virtual clock (never wall time). One per
 * declared `cache <Provider>` instance name, lazily created on first
 * access, exactly like Python's own `fake_cache(instance)`. */
class FakeCache {
  private readonly values = new Map<string, string>();
  private readonly expireAtMs = new Map<string, number>();

  get(key: string, nowMs: number): string | null {
    const expireAt = this.expireAtMs.get(key);
    if (expireAt !== undefined && nowMs >= expireAt) {
      this.values.delete(key);
      this.expireAtMs.delete(key);
      return null;
    }
    return this.values.get(key) ?? null;
  }

  set(key: string, value: string, ttlMs: number | null, nowMs: number): void {
    this.values.set(key, value);
    if (ttlMs !== null) {
      this.expireAtMs.set(key, nowMs + ttlMs);
    } else {
      this.expireAtMs.delete(key);
    }
  }

  delete(key: string): void {
    this.values.delete(key);
    this.expireAtMs.delete(key);
  }
}

/** Enough of an S3/MinIO-shaped object store's interface
 * (`put`/`get`/`delete`/`list`) for `object_store.*` verbs -- an
 * in-memory key/bytes map. */
class FakeObjectStore {
  readonly objects = new Map<string, Buffer>();

  put(key: string, body: Buffer): void {
    this.objects.set(key, body);
  }

  get(key: string): Buffer | undefined {
    return this.objects.get(key);
  }

  delete(key: string): void {
    this.objects.delete(key);
  }

  /** Every key with the given prefix, sorted. */
  list(prefix: string): string[] {
    return [...this.objects.keys()].filter((k) => k.startsWith(prefix)).sort();
  }
}

interface SentEmail {
  to: string;
  subject: string;
  body: string;
}

/** `email.send`, recording sent messages instead of talking SMTP.
 * `body` is recorded (matching Python's own `sent: list[dict]`) even
 * though `expect.email` only ever asserts `to`/`subject_contains`/
 * `count` today -- ported for parity, not for a hypothetical future
 * assertion. */
class FakeEmail {
  readonly sent: SentEmail[] = [];

  send(to: string, subject: string, body: string): void {
    this.sent.push({ to, subject, body });
  }
}

/** `search.index`/`search.query`/`search.delete` -- an in-memory
 * index/docId/document map with the same narrow, disclosed query
 * evaluator Python's `FakeSearch` uses: case-insensitive substring
 * match over each document's JSON, matching the shape `search.query`
 * actually lowers to, not a real query language. */
class FakeSearch {
  private readonly docs = new Map<string, unknown>();

  index(docId: string, document: unknown): void {
    this.docs.set(docId, document);
  }

  query(text: string): unknown[] {
    if (text === "") {
      return [...this.docs.values()];
    }
    const needle = text.toLowerCase();
    return [...this.docs.values()].filter((doc) => JSON.stringify(doc).toLowerCase().includes(needle));
  }

  delete(docId: string): void {
    this.docs.delete(docId);
  }
}

/** A fixture-driven stand-in for an external HTTP client, consuming
 * `given.external_http` fixtures in order -- the same portable-
 * scenario fixtures a scenario already carries drive this fake
 * directly, not a second ad hoc format. */
export type GivenHttpResponse = { error: string } | { status: number; json: unknown };

class FakeHttpClient {
  private responses: GivenHttpResponse[] = [];
  private next = 0;
  readonly requests: Array<[string, unknown]> = [];

  setFixtures(responses: GivenHttpResponse[]): void {
    this.responses = responses;
  }

  post(url: string, json: unknown): unknown {
    this.requests.push([url, json]);
    const response = this.responses[this.next];
    if (response === undefined) {
      throw new Error(`no fixture response configured for external_http call #${this.next + 1} to ${JSON.stringify(url)}`);
    }
    this.next += 1;
    if ("error" in response) {
      throw new Error(`simulated external_http failure: ${response.error}`);
    }
    return response.json;
  }
}

/** Verifies a bearer token by direct lookup against claims the runner
 * configured ahead of time, instead of real JWT/JWKS crypto -- the
 * disclosed simplification Python's own `FakeAuth` already uses:
 * rather than faking the JWKS HTTP round-trip, this bypasses JWT/JWKS
 * verification entirely while keeping scope enforcement real.
 * Singular (unlike cache/store/email/search/http): one identity
 * provider per world, not per-instance. */
class FakeAuth {
  private readonly tokens = new Map<string, [unknown, number | null]>();

  issue(token: string, claims: unknown, expireAtMs: number | null): void {
    this.tokens.set(token, [claims, expireAtMs]);
  }

  verify(token: string, nowMs: number): unknown {
    const entry = this.tokens.get(token);
    if (!entry) {
      throw new Error(`no configured claims for bearer token ${JSON.stringify(token)}`);
    }
    const [claims, expireAt] = entry;
    if (expireAt !== null && nowMs >= expireAt) {
      throw new Error(`bearer token ${JSON.stringify(token)} has expired`);
    }
    return claims;
  }
}

/** A prospective write's reference/uniqueness check against `overlay`
 * (the live store, or a batch's in-progress scratch copy) rather than
 * the real store directly, so a multi-op batch sees its own earlier
 * ops' effects. `selfPk` is the row's own `id` for an update (excluded
 * from both the primary-key collision check and the unique-reference
 * check), `null` for an insert. Throws on the first violation found --
 * the TypeScript counterpart to `SimWorld::validate_write`. */
function validateWrite(
  schema: RelationalSchema,
  overlay: Map<string, Row[]>,
  table: string,
  row: Row,
  selfPk: string | null,
): void {
  if (selfPk === null) {
    const pk = rowId(row);
    if (pk !== undefined) {
      const collides = (overlay.get(table) ?? []).some((r) => rowId(r) === pk);
      if (collides) {
        throw new Error(`${table}.id = ${JSON.stringify(pk)} is not unique`);
      }
    }
  }
  for (const field of schema.outgoingOf(table)) {
    const targetId = row[field.fieldName];
    if (typeof targetId !== "string") continue;
    if (field.targetTable === null) continue;
    const targetTable = field.targetTable;
    const targetExists = (overlay.get(targetTable) ?? []).some((r) => rowId(r) === targetId);
    if (!targetExists) {
      throw new Error(
        `${table}.${field.fieldName} references ${targetTable}/${targetId}, which does not exist`,
      );
    }
    if (field.unique) {
      const conflict = (overlay.get(table) ?? []).some(
        (r) => r[field.fieldName] === targetId && rowId(r) !== (selfPk ?? undefined),
      );
      if (conflict) {
        throw new Error(`${table}.${field.fieldName} = ${JSON.stringify(targetId)} is not unique`);
      }
    }
  }
}

/** Every `[referencingTable, pk]` a delete of `table`/`pk` would
 * cascade into, recursively -- throws if a `restrict` reference blocks
 * it. Read-only against `overlay`; the caller applies the result. The
 * TypeScript counterpart to `SimWorld::plan_delete`. */
function planDelete(
  schema: RelationalSchema,
  overlay: Map<string, Row[]>,
  table: string,
  pk: string,
): Array<[string, string]> {
  const planned: Array<[string, string]> = [];
  for (const [referencingTable, field] of schema.incomingOf(table)) {
    const dependents = (overlay.get(referencingTable) ?? [])
      .filter((row) => row[field.fieldName] === pk)
      .map((row) => rowId(row))
      .filter((id): id is string => id !== undefined);
    if (dependents.length === 0) continue;
    if (field.onDelete === "restrict") {
      throw new Error(`cannot delete ${table}/${pk}: restricted by ${referencingTable}.${field.fieldName}`);
    }
    for (const depPk of dependents) {
      planned.push([referencingTable, depPk]);
      planned.push(...planDelete(schema, overlay, referencingTable, depPk));
    }
  }
  return planned;
}

/** One operation in an atomic `commitBatchChecked` call -- the
 * transaction leaf's own accumulation shape: inner db verbs inside a
 * `transaction {}` block accumulate into a batch rather than hitting
 * their own world calls individually. Deliberately does not
 * auto-expand cascades on `delete` -- that is `dbDeleteChecked`'s own
 * job as a single, immediate, plan-then-apply call. */
export type BatchOp =
  | { kind: "insert"; table: string; row: Row }
  | { kind: "delete"; table: string; pk: string }
  | { kind: "update"; table: string; pk: string; row: Row };

/**
 * The simulation adapter `createSimulationState` stores on `AppState`
 * -- one instance per running scenario. `state.ts.j2`'s
 * `AppState.world` field and every world-guarded `HostSyntax` leaf are
 * the only places generated code reaches into this.
 */
export class SimWorld {
  readonly db = new FakeDatabase();
  readonly queue = new FakeQueue();
  readonly broker = new BrokerLog();
  private readonly schema: RelationalSchema;
  private readonly failures: FailureEngine;
  private nowMsValue: number;
  private readonly caches = new Map<string, FakeCache>();
  private readonly objectStores = new Map<string, FakeObjectStore>();
  private readonly emails = new Map<string, FakeEmail>();
  private readonly searches = new Map<string, FakeSearch>();
  private readonly httpClients = new Map<string, FakeHttpClient>();
  private readonly auth = new FakeAuth();
  /** 27UpdatePlan.md M6: the `transaction {}` leaf's own atomicity
   * seam. Unlike Rust (which renders a `transaction {}` block's world
   * branch twice -- once calling `dbXChecked` directly, once pushing
   * onto an explicit `BatchOp` accumulator -- TypeScript's statement-
   * orientation renders a handler body's statements once; each verb's
   * own `if (this.state.world) { this.state.world.dbXChecked(..) }`
   * guard is already baked in regardless of whether it's inside a
   * `transaction {}` block. Ambient batch mode gets the same atomicity
   * without a second render pass: while `pendingBatch` is non-null,
   * `dbInsertChecked`/`dbUpdateChecked`/`dbDeleteChecked` queue an op
   * instead of validating and applying immediately; `commitWorldBatch`
   * (called by `sim_runner`'s/the generated transaction wrapper's own
   * `this.state.world?.commitWorldBatch()`) validates and applies the
   * whole queue atomically via `commitBatchChecked`, same as Rust's
   * explicit accumulator. */
  private pendingBatch: BatchOp[] | null = null;

  constructor(failureRules: FailureRule[], tables: WorldTable[] = []) {
    this.schema = new RelationalSchema(tables);
    this.failures = new FailureEngine(failureRules);
    // Start-at-zero clock: not yet customizable per scenario (no
    // `given.clock` field exists), so every world starts from the same
    // deterministic point until a later milestone wires one through --
    // disclosed here rather than left implicit. `sim_runner.ts`
    // immediately syncs this to `scenario.start_at` before any
    // TTL-bearing seed reads `nowMs()`.
    this.nowMsValue = 0;
  }

  private mapOf<T>(store: Map<string, T>, instance: string, factory: () => T): T {
    let entry = store.get(instance);
    if (entry === undefined) {
      entry = factory();
      store.set(instance, entry);
    }
    return entry;
  }

  private shouldFail(effect: string, subject: string | null): boolean {
    return this.failures.shouldFail(effect, subject);
  }

  /** `db.commit`'s failure check, schema-aware reference/uniqueness
   * validation, then the actual (fake) write -- mirroring Python's
   * `_FakeSession.commit()`. */
  dbInsertChecked(table: string, row: Row): void {
    if (this.pendingBatch) {
      this.pendingBatch.push({ kind: "insert", table, row });
      return;
    }
    if (this.shouldFail("db.commit", table)) {
      throw new Error("simulated db.commit failure (injected by FailureEngine)");
    }
    const overlay = this.db.snapshot();
    validateWrite(this.schema, overlay, table, row, null);
    this.db.insert(table, row);
  }

  /** Full-record replace by `id`, matching production `db.update`'s
   * own shape -- `null` if no row with that `id` exists, exactly like
   * production's "0 rows affected" case, not an error. */
  dbUpdateChecked(table: string, pk: string, record: Row): Row | null {
    if (this.pendingBatch) {
      this.pendingBatch.push({ kind: "update", table, pk, row: record });
      // Optimistic, matching Rust's own batching branch: the actual
      // "did a row with this id exist" outcome isn't known until the
      // batch commits.
      return record;
    }
    if (this.shouldFail("db.commit", table)) {
      throw new Error("simulated db.commit failure (injected by FailureEngine)");
    }
    if (this.db.get(table, pk) === null) {
      return null;
    }
    const overlay = this.db.snapshot();
    validateWrite(this.schema, overlay, table, record, pk);
    this.db.replace(table, pk, record);
    return record;
  }

  /** Delete by `id`, resolving cascade/restrict references first via a
   * plan-then-apply pass -- `false` if no row with that `id` exists;
   * a restricted delete throws, since a real database would refuse the
   * same delete with a foreign-key violation. */
  dbDeleteChecked(table: string, pk: string): boolean {
    if (this.pendingBatch) {
      this.pendingBatch.push({ kind: "delete", table, pk });
      // Optimistic, matching Rust's own batching branch.
      return true;
    }
    if (this.shouldFail("db.commit", table)) {
      throw new Error("simulated db.commit failure (injected by FailureEngine)");
    }
    if (this.db.get(table, pk) === null) {
      return false;
    }
    const overlay = this.db.snapshot();
    const cascaded = planDelete(this.schema, overlay, table, pk);
    this.db.delete(table, pk);
    for (const [depTable, depPk] of cascaded) {
      this.db.delete(depTable, depPk);
    }
    return true;
  }

  /** Starts ambient batch mode -- every `dbInsertChecked`/
   * `dbUpdateChecked`/`dbDeleteChecked` call until the matching
   * `commitWorldBatch`/`rollbackWorldBatch` queues instead of applying.
   * Called by a generated `transaction {}` block's world branch. */
  beginWorldBatch(): void {
    this.pendingBatch = [];
  }

  /** Validates and applies every op queued since `beginWorldBatch()`
   * atomically, via `commitBatchChecked` -- same overlay-then-apply
   * discipline, just gathered ambiently instead of passed as an
   * explicit list. Throws (leaving the real store untouched) on the
   * first violation found, exactly like `commitBatchChecked` itself. */
  commitWorldBatch(): void {
    const ops = this.pendingBatch ?? [];
    this.pendingBatch = null;
    this.commitBatchChecked(ops);
  }

  /** Discards every op queued since `beginWorldBatch()` without
   * applying them -- called on a generated transaction block's error
   * path, mirroring a real `ROLLBACK`: nothing was ever written to the
   * real store while batching, so discarding the queue *is* the
   * rollback. */
  rollbackWorldBatch(): void {
    this.pendingBatch = null;
  }

  /** The `transaction {}` leaf's own accumulation point -- every
   * insert/update/delete in `ops` validates against one scratch
   * overlay of the live store before any of it is applied for real, so
   * a violation partway through a batch leaves the store exactly as it
   * was before the call. Returns every `[table, pk]` actually deleted,
   * including cascades. */
  commitBatchChecked(ops: BatchOp[]): Array<[string, string]> {
    const subject = ops[0]?.table;
    if (subject !== undefined && this.shouldFail("db.commit", subject)) {
      throw new Error("simulated db.commit failure (injected by FailureEngine)");
    }

    const overlay = this.db.snapshot();
    const allDeletes: Array<[string, string]> = [];

    for (const op of ops) {
      if (op.kind === "insert") {
        validateWrite(this.schema, overlay, op.table, op.row, null);
        const rows = overlay.get(op.table) ?? [];
        rows.push(op.row);
        overlay.set(op.table, rows);
      } else if (op.kind === "update") {
        validateWrite(this.schema, overlay, op.table, op.row, op.pk);
        const rows = overlay.get(op.table);
        if (rows) {
          const idx = rows.findIndex((r) => rowId(r) === op.pk);
          if (idx !== -1) rows[idx] = op.row;
        }
      } else {
        const cascaded = planDelete(this.schema, overlay, op.table, op.pk);
        for (const [depTable, depPk] of [[op.table, op.pk] as [string, string], ...cascaded]) {
          const rows = overlay.get(depTable);
          if (rows) {
            overlay.set(depTable, rows.filter((row) => rowId(row) !== depPk));
          }
        }
        allDeletes.push([op.table, op.pk]);
        allDeletes.push(...cascaded);
      }
    }

    // Every op above validated against the overlay without ever
    // touching the real store -- reaching here means the whole batch
    // is safe to apply for real, all at once.
    for (const op of ops) {
      if (op.kind === "insert") {
        this.db.insert(op.table, op.row);
      } else if (op.kind === "update") {
        this.db.replace(op.table, op.pk, op.row);
      }
    }
    for (const [table, pk] of allDeletes) {
      this.db.delete(table, pk);
    }
    return allDeletes;
  }

  /** `broker.publish`'s failure check plus the actual (fake) publish
   * -- into both `queue` (the orphan-subject detection sweep still
   * reads it) and `broker` (the group-aware log every worker drains
   * from). */
  publishChecked(subject: string, payload: Buffer): void {
    if (this.shouldFail("broker.publish", subject)) {
      throw new Error("simulated broker.publish failure (injected by FailureEngine)");
    }
    this.queue.publish(subject, payload);
    this.broker.publish(subject, payload);
  }

  /** Current virtual time, in epoch milliseconds. */
  nowMs(): number {
    return this.nowMsValue;
  }

  /** Advances virtual time forward. Throws if `toMs` is before the
   * current time -- virtual time never moves backward. */
  advanceClockTo(toMs: number): void {
    if (toMs < this.nowMsValue) {
      throw new Error(`virtual clock cannot move backward: at ${this.nowMsValue}, asked for ${toMs}`);
    }
    this.nowMsValue = toMs;
  }

  /** `cache.get` -- `null` if absent or expired (against this world's
   * own virtual clock, never wall time). No failure-injection check,
   * matching Python's own `FakeCache`. */
  cacheGet(instance: string, key: string): string | null {
    return this.mapOf(this.caches, instance, () => new FakeCache()).get(key, this.nowMs());
  }

  /** `cache.set`. `ttlMs` is `null` for no expiry. */
  cacheSet(instance: string, key: string, value: string, ttlMs: number | null): void {
    this.mapOf(this.caches, instance, () => new FakeCache()).set(key, value, ttlMs, this.nowMs());
  }

  /** `cache.delete`. */
  cacheDelete(instance: string, key: string): void {
    this.mapOf(this.caches, instance, () => new FakeCache()).delete(key);
  }

  /** `object_store.put`. */
  objectPut(instance: string, key: string, body: Buffer): void {
    this.mapOf(this.objectStores, instance, () => new FakeObjectStore()).put(key, body);
  }

  /** `object_store.get` -- throws if no object exists at `key`,
   * matching Python's `FakeObjectStore.get` (a `KeyError` on a miss
   * rather than returning `None`). */
  objectGet(instance: string, key: string): Buffer {
    const body = this.mapOf(this.objectStores, instance, () => new FakeObjectStore()).get(key);
    if (body === undefined) {
      throw new Error(`object_store: no object at key ${JSON.stringify(key)} in instance ${JSON.stringify(instance)}`);
    }
    return body;
  }

  /** `object_store.delete`. */
  objectDelete(instance: string, key: string): void {
    this.mapOf(this.objectStores, instance, () => new FakeObjectStore()).delete(key);
  }

  /** `object_store.list` -- every key with the given prefix, sorted. */
  objectList(instance: string, prefix: string): string[] {
    return this.mapOf(this.objectStores, instance, () => new FakeObjectStore()).list(prefix);
  }

  /** `expect.object`'s own presence check -- distinct from `objectGet`'s
   * "found or throw" shape, since a presence assertion should never
   * itself be treated as a scenario error. */
  objectExists(instance: string, key: string): boolean {
    return this.objectStores.get(instance)?.objects.has(key) ?? false;
  }

  /** `email.send`. */
  emailSend(instance: string, to: string, subject: string, body: string): void {
    this.mapOf(this.emails, instance, () => new FakeEmail()).send(to, subject, body);
  }

  /** `expect.email`'s own count query -- deliberately not scoped to
   * one instance: the scenario schema's `expect.email` carries no
   * `instance` field, matching Python's own `_expect_email`, which
   * counts sends across every `email` instance the world has seen. */
  emailSentCountAll(to: string | null, subjectContains: string | null): number {
    let count = 0;
    for (const email of this.emails.values()) {
      for (const m of email.sent) {
        if (to !== null && m.to !== to) continue;
        if (subjectContains !== null && !m.subject.includes(subjectContains)) continue;
        count += 1;
      }
    }
    return count;
  }

  /** `search.index`. */
  searchIndex(instance: string, docId: string, document: unknown): void {
    this.mapOf(this.searches, instance, () => new FakeSearch()).index(docId, document);
  }

  /** `search.query` -- case-insensitive substring match over each
   * document's JSON, matching Python's own disclosed evaluator (not a
   * real query language). */
  searchQuery(instance: string, text: string): unknown[] {
    return this.mapOf(this.searches, instance, () => new FakeSearch()).query(text);
  }

  /** `search.delete`. */
  searchDelete(instance: string, docId: string): void {
    this.mapOf(this.searches, instance, () => new FakeSearch()).delete(docId);
  }

  /** Seeds `instance`'s fixture queue from a scenario's own
   * `given.external_http` block -- the exact fixture shape a checked-in
   * scenario already carries, consumed directly rather than translated
   * into a second ad hoc format. */
  seedHttpFixtures(instance: string, responses: GivenHttpResponse[]): void {
    this.mapOf(this.httpClients, instance, () => new FakeHttpClient()).setFixtures(responses);
  }

  /** `external_http.request`'s POST call -- consumes the next
   * unconsumed fixture in order, throwing if none remain or the
   * fixture itself declares `{"error": ..}`. */
  httpPost(instance: string, url: string, json: unknown): unknown {
    return this.mapOf(this.httpClients, instance, () => new FakeHttpClient()).post(url, json);
  }

  /** `expect.http_calls`'s own count query. */
  httpRequestCount(instance: string): number {
    return this.httpClients.get(instance)?.requests.length ?? 0;
  }

  /** Configures the claims (and optional expiry, against this world's
   * own virtual clock) a bearer token verifies to -- the runner's own
   * equivalent of Python's `FakeAuth.issue`, called from a scenario's
   * own auth setup, not from generated production code. */
  authIssue(token: string, claims: unknown, expireAtMs: number | null): void {
    this.auth.issue(token, claims, expireAtMs);
  }

  /** The generated auth guard's own verification call -- claims-
   * lookup, not real JWT/JWKS crypto, matching Python's `FakeAuth`. */
  authVerify(token: string): unknown {
    return this.auth.verify(token, this.nowMs());
  }

  unmatchedFailureRules(): string[] {
    return this.failures.unmatchedRules();
  }
}
