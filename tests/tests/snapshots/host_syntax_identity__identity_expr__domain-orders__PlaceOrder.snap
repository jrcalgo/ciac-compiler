(transaction (expr-stmt (db-insert Orders order))
(expr-stmt (if (< (field-access order total) 0) (then (fail InvalidOrder "order total must not be negative")) (else (unit))))
(expr-stmt (db-insert OrderAudits (record-cons OrderAudit (id (uuid-new)) (note "order placed") (total (field-access order total))))))
(return order)
