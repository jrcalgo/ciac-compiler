// Generated by CIaC. Record and CRUD schemas from the program's IR.

/** Every `api` route wraps its pipeline's result in this envelope. */
export interface Envelope<T> {
  status: string;
  data: T;
}

export interface Customer {
  id: string;
  name: string;
  email: string;
}

export interface InvalidOrder {
  reason: string;
}

export interface LineItem {
  id: string;
  /** References `Order` by id. */
  order_id: string;
  sku: string;
  quantity: number;
}

export interface Order {
  id: string;
  /** References `Customer` by id. */
  customer_id: string;
  total: number;
}

export interface OrderAudit {
  id: string;
  note: string;
  total: number;
}

