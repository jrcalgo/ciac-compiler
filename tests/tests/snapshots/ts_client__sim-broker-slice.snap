// Generated by CIaC. One function per route; scope-bearing routes
// require `AuthenticatedClientOptions` so a missing token is a
// compile error, not a 401 at runtime.
import type * as Types from "./types";

export interface ClientOptions {
  baseUrl: string;
}

export interface AuthenticatedClientOptions extends ClientOptions {
  token: string;
}

function authHeader(opts: ClientOptions): Record<string, string> {
  const token = (opts as Partial<AuthenticatedClientOptions>).token;
  return token ? { Authorization: `Bearer ${token}` } : {};
}

async function request<T>(
  opts: ClientOptions,
  path: string,
  method: string,
  body?: unknown,
): Promise<T> {
  const headers: Record<string, string> = { ...authHeader(opts) };
  if (body !== undefined) {
    headers["Content-Type"] = "application/json";
  }
  const res = await fetch(`${opts.baseUrl}${path}`, {
    method,
    headers,
    body: body === undefined ? undefined : JSON.stringify(body),
  });
  if (!res.ok) {
    throw new Error(`${method} ${path} failed: ${res.status}`);
  }
  if (res.status === 204) {
    return undefined as T;
  }
  return (await res.json()) as T;
}

export async function emitApi(opts: ClientOptions, payload: Types.Ping): Promise<Types.Envelope<Types.Ping>> {
  return request(opts, "/pings", "POST", payload);
}

export async function createWidget(opts: ClientOptions, payload: Types.WidgetIn): Promise<Types.WidgetOut> {
  return request(opts, "/widgets", "POST", payload);
}

export async function listWidgets(opts: ClientOptions, params?: { limit?: number; offset?: number }): Promise<Types.WidgetOut[]> {
  const q = new URLSearchParams();
  if (params?.limit !== undefined) q.set("limit", String(params.limit));
  if (params?.offset !== undefined) q.set("offset", String(params.offset));
  const qs = q.toString();
  return request(opts, qs ? `/widgets?${qs}` : "/widgets", "GET");
}

export async function getWidget(opts: ClientOptions, id: string): Promise<Types.WidgetOut> {
  return request(opts, `/widgets/{}`.replace("{}", encodeURIComponent(id)), "GET");
}

export async function updateWidget(opts: ClientOptions, id: string, payload: Types.WidgetIn): Promise<Types.WidgetOut> {
  return request(opts, `/widgets/{}`.replace("{}", encodeURIComponent(id)), "PUT", payload);
}

export async function deleteWidget(opts: ClientOptions, id: string): Promise<void> {
  return request(opts, `/widgets/{}`.replace("{}", encodeURIComponent(id)), "DELETE");
}

