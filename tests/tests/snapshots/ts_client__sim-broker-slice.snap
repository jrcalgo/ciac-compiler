// Generated by CIaC. Record and CRUD schemas from the program's IR.

/** Every `api` route wraps its pipeline's result in this envelope. */
export interface Envelope<T> {
  status: string;
  data: T;
}

export interface Ping {
  id: string;
  seq: number;
}

export interface ProcessedByA {
  id: string;
  ping_id: string;
  seq: number;
}

export interface ProcessedByB {
  id: string;
  ping_id: string;
  seq: number;
}

export interface Widget {
  id: string;
  name: string;
}

export interface WidgetIn {
  name: string;
}

export interface WidgetOut {
  id: string;
  name: string;
}

