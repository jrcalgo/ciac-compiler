// Generated by CIaC. Record and CRUD schemas from the program's IR.

/** Every `api` route wraps its pipeline's result in this envelope. */
export interface Envelope<T> {
  status: string;
  data: T;
}

export interface Ack {
  ok: boolean;
}

export interface HttpRequest {
  path: string;
  payload: string;
}

export interface IndexRequest {
  id: string;
  title: string;
}

export interface KeyOnly {
  key: string;
}

export interface Notification {
  to: string;
  subject: string;
  body: string;
}

export interface SearchRequest {
  query: string;
}

