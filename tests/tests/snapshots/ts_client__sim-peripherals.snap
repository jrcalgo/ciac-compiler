// Generated by CIaC. One function per route; scope-bearing routes
// require `AuthenticatedClientOptions` so a missing token is a
// compile error, not a 401 at runtime.
import type * as Types from "./types";

export interface ClientOptions {
  baseUrl: string;
}

export interface AuthenticatedClientOptions extends ClientOptions {
  token: string;
}

function authHeader(opts: ClientOptions): Record<string, string> {
  const token = (opts as Partial<AuthenticatedClientOptions>).token;
  return token ? { Authorization: `Bearer ${token}` } : {};
}

async function request<T>(
  opts: ClientOptions,
  path: string,
  method: string,
  body?: unknown,
): Promise<T> {
  const headers: Record<string, string> = { ...authHeader(opts) };
  if (body !== undefined) {
    headers["Content-Type"] = "application/json";
  }
  const res = await fetch(`${opts.baseUrl}${path}`, {
    method,
    headers,
    body: body === undefined ? undefined : JSON.stringify(body),
  });
  if (!res.ok) {
    throw new Error(`${method} ${path} failed: ${res.status}`);
  }
  if (res.status === 204) {
    return undefined as T;
  }
  return (await res.json()) as T;
}

export async function evictCacheApi(opts: ClientOptions, payload: Types.KeyOnly): Promise<Types.Envelope<Types.KeyOnly>> {
  return request(opts, "/evict-cache-api", "POST", payload);
}

export async function removeDocApi(opts: ClientOptions, payload: Types.KeyOnly): Promise<Types.Envelope<Types.KeyOnly>> {
  return request(opts, "/remove-doc-api", "POST", payload);
}

export async function notifyUserApi(opts: ClientOptions, payload: Types.Notification): Promise<Types.Envelope<Types.Notification>> {
  return request(opts, "/notify-user-api", "POST", payload);
}

export async function indexDocApi(opts: ClientOptions, payload: Types.IndexRequest): Promise<Types.Envelope<Types.IndexRequest>> {
  return request(opts, "/index-doc-api", "POST", payload);
}

export async function searchDocsApi(opts: ClientOptions, payload: Types.SearchRequest): Promise<Types.Envelope<Types.SearchRequest>> {
  return request(opts, "/search-docs-api", "POST", payload);
}

export async function callUpstreamApi(opts: ClientOptions, payload: Types.HttpRequest): Promise<Types.Envelope<Types.HttpRequest>> {
  return request(opts, "/call-upstream-api", "POST", payload);
}

export async function echoApi(opts: AuthenticatedClientOptions, payload: Types.KeyOnly): Promise<Types.Envelope<Types.KeyOnly>> {
  return request(opts, "/echo-api", "POST", payload);
}

